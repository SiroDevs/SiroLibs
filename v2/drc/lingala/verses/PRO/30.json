  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PRO 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloba ya Aguri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tala maloba ya Aguri, mwana mobali ya Yake. Ezali ye nde alobaki yango epai ya Itieli, epai ya Itieli mpe Ukali :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.1",
            "verseOrgIds": [
              "PRO.30.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solo, nazali zoba koleka bato nyonso,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:2"
      },
      "items": [
        {
          "text": "nazali ata na mayele ya bomoto te ;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.2",
            "verseOrgIds": [
              "PRO.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nayekolaki bwanya te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:3"
      },
      "items": [
        {
          "text": "mpe nazali na boyebi ya Mosantu te.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.3",
            "verseOrgIds": [
              "PRO.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nani amata na Lola to mpe akita wuta kuna ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Nani asangisa mopepe kati na maboko na ye ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Nani akanga mayi na kazaka na ye ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Nani akata bandelo nyonso ya mabele ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Kombo na ye nani ? Mpe kombo ya mwana na ye ezali nani ?",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:4"
      },
      "items": [
        {
          "text": "Yebisa ngai soki oyebi !",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.4",
            "verseOrgIds": [
              "PRO.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liloba nyonso ya Nzambe ezalaka na libunga te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:5"
      },
      "items": [
        {
          "text": "ezali nguba mpo na bato oyo bazwaka yango",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:5"
      },
      "items": [
        {
          "text": "lokola ebombamelo na bango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.5",
            "verseOrgIds": [
              "PRO.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kobakisa eloko moko te na maloba na Ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:6"
      },
      "items": [
        {
          "text": "noki te apamela yo mpe abimisa yo mokosi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.6",
            "verseOrgIds": [
              "PRO.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oh Yawe, nasengi Yo biloko mibale,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:7"
      },
      "items": [
        {
          "text": "kopimela ngai yango te liboso ete nakufa :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.7",
            "verseOrgIds": [
              "PRO.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "longola mosika na ngai makambo ya pamba mpe ya lokuta,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "kopesa ngai te bobola to bozwi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:8"
      },
      "items": [
        {
          "text": "kasi pesa ngai kaka, mokolo na mokolo, lipa oyo ekoki na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.8",
            "verseOrgIds": [
              "PRO.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamba te soki natondi makasi,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "nakoki kowangana Yo mpe koloba :",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "« Yawe nde nani ? »",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "To soki nazali na bobola, nakoki koyiba",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:9"
      },
      "items": [
        {
          "text": "mpe koyokisa Kombo ya Nzambe na ngai soni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.9",
            "verseOrgIds": [
              "PRO.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotonga mowumbu te liboso ya nkolo na ye,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:10"
      },
      "items": [
        {
          "text": "noki te alakela yo mabe, mpe omona pasi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.10",
            "verseOrgIds": [
              "PRO.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali na bato oyo balakelaka batata na bango mabe",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:11"
      },
      "items": [
        {
          "text": "mpe bapambolaka te bamama na bango.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.11",
            "verseOrgIds": [
              "PRO.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali na bato oyo bamimonaka peto na miso na bango moko,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:12"
      },
      "items": [
        {
          "text": "nzokande bamipetoli na mbindo na bango te.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.12",
            "verseOrgIds": [
              "PRO.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali na bato oyo batonda na lolendo",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:13"
      },
      "items": [
        {
          "text": "mpe bamonaka bato mosusu pamba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.13",
            "verseOrgIds": [
              "PRO.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ezali na bato oyo minu na bango ezali lokola mipanga,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "lokola mbeli mpo na koboma babola kati na mokili",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:14"
      },
      "items": [
        {
          "text": "mpe bato bakelela kati na bato.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.14",
            "verseOrgIds": [
              "PRO.30.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sonzo ezalaka na bana basi mibale,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "text": "egangaka kaka : « Pesa ! Pesa ! »",
