      "attrs": {
        "style": "li1",
        "vid": "PRO 30:15"
      },
      "items": [
        {
          "text": "Ezali na biloko misato oyo etondaka te,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.15",
            "verseOrgIds": [
              "PRO.30.15"
            ]
          }
        }
      ]
    },
    {
