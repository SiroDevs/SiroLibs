    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li3",
        "vid": "PRO 30:23"
      },
      "items": [
        {
          "text": "mpe mwasi mosali oyo azwi bomengo ya nkolo na ye ya mwasi.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
