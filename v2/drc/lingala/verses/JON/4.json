{
  "id": "JON.4",
  "number": "4",
  "bookId": "JON",
  "reference": "Yona 4",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JON 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yona atombokeli Yawe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JON 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona asepelaki na yango ata moke te, asilikaki makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asambelaki Yawe :",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "— Oh Yawe ! Ezali te makambo ya boye",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "nde nazalaki komilobela tango nazalaki epai na ngai ?",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "Yango wana nasalaki na ngai mobembo na Tarsisi",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "mpo na koluka kokima,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "pamba te nayebaki malamu ete ozali",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "Nzambe ya ngolu mpe ya mawa,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "osilikaka noki te mpe otonda na bolingo,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 4:2"
      },
      "items": [
        {
          "text": "obongolaka makanisi na Yo ya kosala bato mabe.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.2",
            "verseOrgIds": [
              "JON.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sik'oyo, oh Yawe, kamata na Yo bomoi na ngai ;",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 4:3"
      },
      "items": [
        {
          "text": "pamba te eleki malamu ete nakufa na ngai,",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JON 4:3"
      },
      "items": [
        {
          "text": "kasi nazala na bomoi te !",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.3",
            "verseOrgIds": [
              "JON.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi Yawe azongiselaki ye :",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.4",
            "verseOrgIds": [
              "JON.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JON 4:4"
      },
      "items": [
        {
          "text": "— Boni, okanisi ete ozali kosala malamu ndenge ozali kosilika ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona abimaki na libanda ya engumba mpe akendeki kovanda na este na yango. Kuna, amitongelaki ndako moko ya matiti mpe avandaki na se ya pio na yango mpo na kozela makambo oyo ekokweyela engumba Ninive.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.5",
            "verseOrgIds": [
              "JON.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JON 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe Nzambe abimisaki nzete moko mpe akolisaki yango mpo na kopesa pio na moto ya Yona mpe kokitisa ye motema. Nzete yango esepelisaki Yona makasi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.6",
            "verseOrgIds": [
              "JON.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JON 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi na tongo-tongo ya mokolo oyo elandaki, Nzambe abimisaki mwa nyama moko oyo eliaka banzete ; bongo eliaki nzete yango, mpe nzete yango ekawukaki.",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.7",
            "verseOrgIds": [
              "JON.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JON 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango moyi ebimaki makasi, Nzambe atindaki mopepe ya este oyo epesaki molunge makasi. Moyi ebetaki moto ya Yona makasi. Yona alembaki nzoto, asengaki kokufa ; alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.8",
            "verseOrgIds": [
              "JON.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JON 4:8"
      },
      "items": [
        {
          "text": "— Eleki malamu ete nakufa na ngai, kasi nazala na bomoi te !",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe alobaki na Yona :",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JON 4:9"
      },
      "items": [
        {
          "text": "— Okanisi ete ozali kosala malamu ndenge ozali kosilika mpo na nzete oyo ?",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JON 4:9"
      },
      "items": [
        {
          "text": "Yona azongisaki :",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JON 4:9"
      },
      "items": [
        {
          "text": "— Ezali se bongo. Nazali kosala malamu ndenge nazali kosilika kino kosenga kufa na ngai.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawe alobaki :",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pi1",
        "vid": "JON 4:10"
      },
      "items": [
        {
          "text": "— Oyoki pasi na motema mpo na nzete oyo omoneli ata pasi te mpe okolisi te, oyo ekoli kaka na butu moko mpe ekawuki na butu oyo elandi ! Oyokeli yango mpe mawa !",
          "type": "text"
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongo ndenge nini Ngai nayoka motema pasi te mpo na Ninive, engumba monene, oyo ezali na bato koleka nkoto nkama moko na tuku mibale oyo bayebi te kokesenisa makambo mabe mpe makambo malamu, mpe ezali na ebele ya bibwele ?",
          "type": "text"
        }
      ]
    }
  ],
  "next": {
    "id": "MIC.intro",
    "number": "intro",
    "bookId": "MIC"
  },
  "previous": {
    "id": "JON.3",
    "number": "3",
