{
  "id": "GEN.8",
  "number": "8",
  "bookId": "GEN",
  "reference": "Ebandeli 8",
  "copyright": "Biblica® Salela na bonsomi Mokanda na Bomoi™ Makomi na se ya bokonzi © 2002, 2020 Biblica, Inc. Biblica® Open Lingala Contemporary Bible™ Copyright © 2002, 2020 by Biblica, Inc.",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "GEN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mpela esili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzambe akanisaki Noa mpe banyama nyonso oyo ezalaki elongo na ye kati na masuwa, atindaki mopepe na mokili mpe mayi ekitaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bitima ya se mpe maninisa ya likolo ekangamaki mpe mvula etikaki konoka.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.2",
            "verseOrgIds": [
              "GEN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayi ekomaki kolongwa moke-moke likolo ya mabele, mpe sima na mikolo nkama moko na tuku mitano, mayi ekitaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.3",
            "verseOrgIds": [
              "GEN.8.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya zomi na sambo ya sanza ya sambo, masuwa esemaki likolo ya bangomba Ararati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.4",
            "verseOrgIds": [
              "GEN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayi ezalaki kokoba kokita kino na sanza ya zomi. Na mokolo ya liboso ya sanza yango, basonge ya bangomba emonanaki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sima na mikolo tuku minei, Noa afungolaki lininisa ya masuwa oyo asalaki",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.6",
            "verseOrgIds": [
              "GEN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpe abimisaki yanganga. Yanganga yango ezalaki kokende mpe kozonga kino tango mayi ekawukaki na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.7",
            "verseOrgIds": [
              "GEN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpe lisusu, Noa abimisaki ebenga mpo na kotala soki mayi ekawuki na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.8",
            "verseOrgIds": [
              "GEN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kasi ebenga ezwaki esika ya kotia matambe na yango te, pamba te mayi ezalaki na etando nyonso ya mokili. Boye, ezongaki na masuwa epai ya Noa. Noa abimisaki loboko, azwaki ebenga mpe akotisaki yango kati na masuwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.9",
            "verseOrgIds": [
              "GEN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azelaki mikolo sambo mpe abimisaki lisusu ebenga libanda ya masuwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.10",
            "verseOrgIds": [
              "GEN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tango ebenga ezongaki epai na ye na pokwa, ememaki lokasa ya olive ya mobesu na monoko na yango. Boye, Noa asosolaki ete mayi ekiti na mokili.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.11",
            "verseOrgIds": [
              "GEN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azelaki lisusu mikolo sambo mosusu, mpe abimisaki ebenga. Kasi ebenga ezongaki lisusu te.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya liboso na sanza ya liboso, tango Noa akokisaki mibu nkama motoba na moko ya mbotama, mayi ekawukaki na mokili ; Noa afungolaki masuwa na likolo na yango mpe amonaki ete mabele ekawuki.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.13",
            "verseOrgIds": [
              "GEN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mokolo ya tuku mibale na sambo ya sanza ya mibale, mabele ekawukaki penza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.14",
            "verseOrgIds": [
              "GEN.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Nzambe alobaki na Noa :",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.15",
            "verseOrgIds": [
              "GEN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "« Bima na masuwa elongo na mwasi na yo, mpe bana na yo ya mibali elongo na basi na bango.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.16",
            "verseOrgIds": [
              "GEN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bimisa mpe bikelamu oyo ezali elongo na yo : bandeke, banyama mpe bikelamu nyonso oyo etambolaka na libumu, mpo ete ebotana mpe ekoma ebele kati na mokili. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.17",
            "verseOrgIds": [
              "GEN.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Noa abimaki libanda elongo na bana na ye ya mibali, mwasi na ye mpe basi ya bana na ye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.18",
            "verseOrgIds": [
              "GEN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyama nyonso, bikelamu nyonso oyo etambolaka na libumu mpe bandeke nyonso, bikelamu nyonso oyo etambolaka na mokili, ebimaki na masuwa na molongo kolanda lolenge na yango.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noa atongaki etumbelo mpo na Yawe mpe azwaki ndambo ya banyama mpe bandeke ezanga mbindo, abonzelaki yango Yawe lokola mbeka ya kotumba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.20",
            "verseOrgIds": [
              "GEN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boye, Yawe ayokaki solo kitoko mpe amilobelaki : « Nakolakela lisusu mabele mabe te likolo ya moto, pamba te wuta bomwana ya moto, motema ya moto elukaka kaka makambo mabe ; nakoboma lisusu te bikelamu nyonso ya bomoi ndenge nawuti kosala.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.21",
            "verseOrgIds": [
              "GEN.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na tango nyonso oyo mokili ekozala,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "tango ya kolona mpe tango ya kobuka,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "tango ya malili mpe tango ya molunge,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "tango ya mvula mpe tango ya elanga,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "tango ya moyi mpe tango ya butu,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "ekozanga te. »",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    }
  ],
