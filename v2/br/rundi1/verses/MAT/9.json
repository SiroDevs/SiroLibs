          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa ba Yohana Umubatizi baraza baramubaza bati: “Ni kuki twe n’Abafarisayo twisonzesha kenshi, ariko abigishwa bawe ntibisonzeshe?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.14",
