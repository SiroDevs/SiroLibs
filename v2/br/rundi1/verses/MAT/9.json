          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiriko aravuga ivyo, haza umukuru w’isinagogi",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:18",
              "type": "text"
            },
            {
              "text": "isinagogi",
              "type": "text"
            },
            {
              "text": "yari inyubakwa canke ikibanza co gusengeramwo, kwigishirizamwo, n’ibindi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " apfukama imbere yiwe amubwira ati: “Umwana wanje w’umukobwa ahejeje gupfa, ariko woza ukamurambikako ibiganza, yosubira kuba muzima.” ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.18",
            "verseOrgIds": [
              "MAT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aca arahaguruka ajana na we n’abigishwa biwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.9.19",
            "verseOrgIds": [
              "MAT.9.19"
            ]
          }
        }
      ]
    },
