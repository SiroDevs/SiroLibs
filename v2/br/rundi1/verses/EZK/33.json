            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babwire uti: ‘Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.27",
            "verseOrgIds": [
              "EZK.33.27"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze: Ni ukuri nk’ukubaho kwanje, abasigaye mu bihomoke bazomarwa n’inkota, abari mu gihugu nzobaterera inyamaswa zibatabagure, abari mu mazu azitiriwe cane n’abari mu mazu yo mu kuzimu bazokwicwa n’icago. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.27",
            "verseOrgIds": [
              "EZK.33.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzosiga igihugu ari agahinga, nkureho ivyizigiro vy’inkomezi zabo, kandi imisozi y’i Yerusalemu izosigara igaragara, nta n’uwuzosubira kuyicako. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.28",
            "verseOrgIds": [
              "EZK.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ho bazomenya ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.29",
            "verseOrgIds": [
              "EZK.33.29"
            ]
          }
        },
        {
          "text": ", ninamara gusiga igihugu kigaragara kubera ibizira bakoze.’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.29",
            "verseOrgIds": [
              "EZK.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
