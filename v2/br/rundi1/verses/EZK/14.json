          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.12",
            "verseOrgIds": [
              "EZK.14.12"
            ]
          }
        },
        {
          "text": " rimbwira riti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.12",
            "verseOrgIds": [
              "EZK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w’umuntu, hagize igihugu kincumurako, kigata ubwizigirwa, nkakiramvurirako ukuboko kwanje, ngasibanganya ahava ivyokurya vyaco, nkakirungikamwo inzara ikica abantu baco n’ibitungwa vyaco, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.13",
            "verseOrgIds": [
              "EZK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "naho abagabo batatu ari bo Nowa, Daniyeli na Yobu bobaye ari yo bari, bokijije amagara yabo gusa kubera ukugororoka kwabo, ni jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.14",
            "verseOrgIds": [
              "EZK.14.14"
            ]
          }
        },
        {
          "text": " Nyeninganji ndabivuze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.14",
            "verseOrgIds": [
              "EZK.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
