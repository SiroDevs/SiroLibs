          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke nzanye inkota kuri ico gihugu, nkavuga nti: Reka iyi nkota ice mu gihugu cose, nkica abantu bose n’ibitungwa vyabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.17",
            "verseOrgIds": [
              "EZK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ukuri nk’ukubaho kwanje, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        },
        {
          "text": " Nyeninganji, naho abo bagabo bobaye bari muri co, ntibokijije abahungu n’abakobwa babo, bokwikijije bonyene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.18",
            "verseOrgIds": [
              "EZK.14.18"
            ]
          }
        }
      ]
    },
