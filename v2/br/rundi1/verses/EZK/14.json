          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke na ho ndungitse ibikoko vy’inkazi muri ico gihugu, bigahonya abantu bose bigasiga igihugu ari agahinga, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.15",
            "verseOrgIds": [
              "EZK.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ukuri nk’ukubaho kwanje, ni jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        },
        {
          "text": " Nyeninganji, naho abo bagabo batatu bobaye ari yo bari, ntibokijije abahungu n’abakobwa babo. Bokwikijije bonyene, ariko igihugu cosigaye ari agahinga.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.16",
            "verseOrgIds": [
              "EZK.14.16"
            ]
          }
        }
      ]
    },
    {
