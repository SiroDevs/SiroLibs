        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.14",
            "verseOrgIds": [
              "EZK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
