            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.12",
            "verseOrgIds": [
              "EZK.25.12"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze: “Ko Abanyedomu bihoye Abayuda, vyababereye icaha gikomeye, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.12",
            "verseOrgIds": [
              "EZK.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.13",
            "verseOrgIds": [
              "EZK.25.13"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze: Nzoramvurira ukuboko kwanje kuri Edomu, nice abantu baho n’ibitungwa vyabo. Nzohasiga ari agahinga, kandi kuva i Temani gushika i Dedani, abaho bose bazomarwa n’inkota. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.13",
            "verseOrgIds": [
              "EZK.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokwihora Edomu nkoresheje ukuboko kw’abantu banje b’Abisirayeli, maze bazosubiriza mu nkoko Abanyedomu ibihwanye n’uburake bwanje; ni ho bazobona ukwihora kwanje, ni jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.14",
            "verseOrgIds": [
              "EZK.25.14"
            ]
          }
        },
        {
          "text": " Nyeninganji ndabivuze.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.14",
            "verseOrgIds": [
              "EZK.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
