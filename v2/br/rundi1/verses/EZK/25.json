          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.15",
            "verseOrgIds": [
              "EZK.25.15"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze: “Ko Abafilisitiya bihoye Abayuda bafise umutima w’ubugunge, ngo babaranduze urwanko rwabo rwa kera, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.15",
            "verseOrgIds": [
              "EZK.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.16",
            "verseOrgIds": [
              "EZK.25.16"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze: ‘Ngira ndamvurire ukuboko ku Bafilisitiya, mperengeteze Abakereti, ndandure n’abasigaye ku nkengera z’ikiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.16",
            "verseOrgIds": [
              "EZK.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobashitsako ukwihora gukomeye, ndabahanishe uburake bwanje. Ni ho bazomenyera ko jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.17",
            "verseOrgIds": [
              "EZK.25.17"
            ]
          }
        },
        {
          "text": " ari jewe nabihoye.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.17",
            "verseOrgIds": [
              "EZK.25.17"
            ]
          }
        }
      ]
