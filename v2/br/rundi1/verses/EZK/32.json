          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "None, na wewe nyene Farawo, uzovunagurwa, urambikwe mu batakebwe, hamwe n’abarigiswe n’inkota.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.32.28",
            "verseOrgIds": [
              "EZK.32.28"
            ]
          }
        }
      ]
