        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
