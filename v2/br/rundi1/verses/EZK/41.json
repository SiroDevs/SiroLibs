      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma wa muntu anjana mu cumba gikuru c’Ingoro, apima impome zari ku mpande zompi z’inzira yaja muri ico cumba: zapima ingero z’igice c’ukuboko zitandatu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:1",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 3,2.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.1",
            "verseOrgIds": [
              "EZK.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ingero z’igice c’ukuboko cumi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:2",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 5,3.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure bw’amakika, hamwe n’ingero z’igice c’ukuboko zitanu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:2",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,7.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuva ku ruhome rumwe gushika ku rundi. Iyo Ngoro yari ifise ingero z’igice c’ukuboko mirongo ine z’uburebure bw’amakika, n’ubwaguke bw’ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:2",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 21 z’uburebure n’imetero 11 z’ubwaguke.",
              "type": "text"
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        }
      ]
    },
    {
