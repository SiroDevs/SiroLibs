              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera apima uruhome rw’Ingoro, asanga rupima ingero z’igice c’ukuboko zitandatu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:5",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 3,2.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke, utwumba tw’ububiko twari dufise ingero z’igice c’ukuboko zine",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:5",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,1.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke, dukikuje urusengero impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi utwo twumba two ku ruhande twari tugerekeranye ku buryo tuba amagorofa atatu, umurongo wose uriko utwumba mirongo itatu. Impome zatwo zari zegeranye n’uruhome rw’inyuma rw’Ingoro ariko zikikuje impande zose z’Ingoro, kugira ngo ntitwegamire kuri rwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.6",
            "verseOrgIds": [
              "EZK.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utwo twumba twari dukikuje Ingoro, uko twari tugerekeranye ni ko twarutana. Inyubako ikikuje urusengero yari yubatswe mu buryo igenda iraduga, ku buryo utwo twumba twagenda twaguka uko umuntu aduga. Hariho ingazi iyo uriko uraduga ujana igenda iduga kandi izunguruka ikikuje urusengero, mu kuja mu twumba two hejuru ugaca mu two hagati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.7",
            "verseOrgIds": [
              "EZK.41.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
