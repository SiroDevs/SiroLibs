        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzu yari imbere y’ahatubatse haherereye mu burengero bw’urusengero, yari ifise ingero z’igice c’ukuboko indwi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:12",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 37.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke. Impome zayo zari zifise intimba ingana y’ingero z’igice c’ukuboko zitanu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:12",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,7.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", uburebure bw’iyo nzu na bwo bwangana n’ingero z’igice c’ukuboko mirongo icenda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
