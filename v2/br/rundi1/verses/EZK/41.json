              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.7",
            "verseOrgIds": [
              "EZK.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma mbona ko iyo ngoro ifise urufatiro rurenze gatoya ku ruhome, rukaba n’urufatiro rwo ku ruhande rw’utwo twumba. Uburebure bw’igihagararo bw’urwo rufatiro rwari ingero z’igice c’ukuboko zitandatu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.8",
            "verseOrgIds": [
              "EZK.41.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:8",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 3,2.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.8",
            "verseOrgIds": [
              "EZK.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwaguke bw’urwo ruhome rw’inyuma rwariko utwo twumba bwari ingero z’igice c’ukuboko zitanu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.9",
            "verseOrgIds": [
              "EZK.41.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:9",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,7.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke. Umwanya wasigara hagati y’utwo twumba two ku ruhande ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.9",
            "verseOrgIds": [
              "EZK.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’utwumba tw’abaherezi wari ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.10",
            "verseOrgIds": [
              "EZK.41.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:10",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 11.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke uzungurutse urusengero. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.10",
            "verseOrgIds": [
              "EZK.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imiryango y’utwo twumba yari iraba ku mbuga, umuryango umwe uraba mu buraruko, uwundi uraba mu bumanuko. Ahari hatubatse hagati y’amazu hari ingero z’igice c’ukuboko zitanu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:11",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,7.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        }
      ]
    },
