              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.2",
            "verseOrgIds": [
              "EZK.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze yinjira mu cumba co haruguru, apima inkingi z’umuryango; imwimwe yose yari ifise ingero z’igice c’ukuboko zibiri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:3",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 1,1.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke, n’ingero z’igice c’ukuboko zitandatu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:3",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 3,2.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure bw’amakika, kandi uburebure bwo kuva ku muryango gushika ku zindi mpome bwari ingero z’igice c’ukuboko indwi",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:3",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 3,7.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.3",
            "verseOrgIds": [
              "EZK.41.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apima ubwaguke bw’ico cumba c’imbere, asanga kingana n’ingero z’igice c’ukuboko mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:4",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 11.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku ruhande rwose kandi impande zose zarangana. Maze aca ambarira ati: “Aha ni Ahera Cane.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.4",
            "verseOrgIds": [
              "EZK.41.4"
            ]
          }
        }
      ]
    },
    {
