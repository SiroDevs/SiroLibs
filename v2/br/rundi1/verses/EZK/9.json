              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkiriko ndumviriza, numva abwiye abandi ati: “Nimumukurikire mu gisagara, mwice ata mbabazi n’impuhwe uwo wese musanga atariko ikimenyetso. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.5",
            "verseOrgIds": [
              "EZK.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwice abatama, imisore, inkumi, abagore n’abana. Ariko ntimukore ku muntu n’umwe ariko ikimenyetso. Muhere mu Ngoro yanje.” Nuko baca bahera ku batama bari imbere y’Ingoro.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.6",
            "verseOrgIds": [
              "EZK.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.6",
            "verseOrgIds": [
              "EZK.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera ababwira ati: “Nimuhumanye Ingoro, urugo rwayo murwuzuze imivyimba. Nimugende!” Nuko barasohoka baca mu gisagara bagenda barica nk’uko bari babwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.7",
            "verseOrgIds": [
              "EZK.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bariko barica, nari nsigaye ndi jenyene, nca nikubita hasi nubamye, ndatakamba n’ijwi rirenga nti: “Ewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.8",
            "verseOrgIds": [
              "EZK.9.8"
            ]
          }
        },
        {
          "text": " Nyeninganji, mbega ugira utikize amasigarira ya Isirayeli, mu gusuka uburake bwawe kuri Yerusalemu?”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.8",
            "verseOrgIds": [
              "EZK.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.8",
            "verseOrgIds": [
              "EZK.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aranyishura ati: “Ivyaha vy’inzu ya Isirayeli n’ivya Yuda vyabaye umurengera; igihugu cuzuye amaraso, umugwa na wo wuzuye akarenganyo. Bibwira bati: ‘",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "text": " yarataye kino gihugu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "text": " ntatubona.’ ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.9",
            "verseOrgIds": [
              "EZK.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero sinzobarabisha ijisho ry’impuhwe, kandi nta n’umwe nzosigaza, ahubwo nzomanurira ku mitwe yabo ivyo bakoze vyose.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        }
      ]
    },
