          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze numva ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.1",
            "verseOrgIds": [
              "EZK.9.1"
            ]
          }
        },
        {
          "text": " ahamagara n’ijwi rirenga, avuga ati: “Nzanira hano abagabo bateguwe ngo bahane ico gisagara, bazanane n’ibigwanisho vyabo mu minwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.1",
            "verseOrgIds": [
              "EZK.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nca mbona abagabo batandatu bazananye mw’irembo ryo haruguru rirabana no mu buraruko, umwe wese afise ikigwanisho cica mu minwe. Muri bo harimwo umugabo yari yambaye impuzu zera derere, afise mu rukenyerero ibikoresho vyo kwandika. Baraza bahagarara i ruhande ya ca gicaniro c’umwakaka.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.2",
            "verseOrgIds": [
              "EZK.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
