          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze wa muntu yari yambaye impuzu zera derere afise mu rukenyerero ibikoresho vyo kwandika agaruka kuvuga inkuru ati: “Nakoze ivyo wantumye.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
            "verseOrgIds": [
              "EZK.9.11"
            ]
          }
        }
