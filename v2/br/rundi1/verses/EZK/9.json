            "number": "3",
            "style": "v",
            "sid": "EZK 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ubwiza bw’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.3",
            "verseOrgIds": [
              "EZK.9.3"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli buraduga buvuye ku bakerubi aho bwari buri, buja mu rwinjiriro rw’Ingoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.3",
            "verseOrgIds": [
              "EZK.9.3"
            ]
          }
        },
        {
          "text": " ahamagara wa mugabo yari yambaye impuzu zera derere, yari afise mu rukenyerero ibikoresho vyo kwandika, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.3",
            "verseOrgIds": [
              "EZK.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "amubwira ati: “Nyuragira hagati mu gisagara ca Yerusalemu, ushire ikimenyetso mu ruhanga rw’abo bose bababara, bagacura intimba kubera ibizira bikorerwa muri iki gisagara.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.4",
            "verseOrgIds": [
              "EZK.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
