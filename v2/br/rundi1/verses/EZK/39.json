            "verseOrgIds": [
              "EZK.39.28"
            ]
          }
        },
        {
          "text": " Imana yabo, kuko n’aho nabarungitse mu kinyago mu yandi mahanga, nzobegeraniriza mu gihugu cabo, ata n’umwe nsize inyuma. ",
          "type": "text",
          "attrs": {
