          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokwibagira ibimaramare n’isoni, no kubura ubwizigirwa mu vyo bankoreye, igihe baba ata nkomanzi mu gihugu cabo ata wubatera ubwoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.26",
