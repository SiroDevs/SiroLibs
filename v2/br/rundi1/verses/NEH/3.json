        },
        {
          "text": "Hejuru y’Irembo ry’Amafarasi, abaherezi barahasanura, umwe wese asanura imbere y’inzu yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.28",
            "verseOrgIds": [
