          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irembo ry’Umwavu risanurwa na Malikiya mwene Rekabu, uwaganza intara y’i Beti-Hakeremu. Araryubaka ashirako n’inzugi zaho, ashiraho n’ibihindizo vyo kugumya urugi iyo rwugaye.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irembo ry’Iriba ryasanuwe na Shaluni mwene Koli-Hoze, uwaganza intara ya Misipa. Araryubaka, ararisakara ashirako n’inzugi, ashiraho n’ibihindizo vyo kugumya urugi iyo rwugaye. Yongera asanura uruzitiro rwo ku kidengeri c’i Silowamu, i ruhande y’umurima w’umwami, gushika ku ngazi zimanuka ziva mu Gisagara ca Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakurikira Nehemiya mwene Azibuki, uwaganza igice c’intara ya Beti-Zuri, arasanura ageza aharabana no ku mva ya Dawidi, gushika ku kidengeri kibika amazi kiri hafi y’inzu y’abahizi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.16",
            "verseOrgIds": [
              "NEH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
