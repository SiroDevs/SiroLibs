          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu b’i Tekowa barakurikira, basanura ikindi gice, kuva ku munara w’abararira urusengero gushika ku ruzitiro rwa Ofeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.27",
