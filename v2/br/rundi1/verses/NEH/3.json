              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’abakozi bo mu Ngoro baba ku musozi wa Ofeli, basanura kugeza aharabana n’Irembo ry’Amazi werekeje mu buseruko n’umunara ku ruhome. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        },
