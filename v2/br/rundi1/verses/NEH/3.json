            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irembo ryo mu Kiyaya ryasanuwe na Hanuni n’ababa i Zanowa. Bararyubaka bashirako n’inzugi zaho, bashiraho n’ibihindizo vyo kugumya urugi iyo rwugaye. Barongera basanura uruzitiro ahantu hangana n’ingero z’igice c’ukuboko igihumbi",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:13",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 450.",
              "type": "text"
            }
          ]
        },
        {
          "text": " gushika kw’Irembo ry’Umwavu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
