            "sid": "ROM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntahirize Pirisila na Akwilasi, abakoranye nanje igikorwa ca Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.3",
            "verseOrgIds": [
              "ROM.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kenshi bahatswe gupfa bagomba gukiza ubuzima bwanje. Ivyo, si jewe jenyene ndabibashimira, ariko ni amashengero yose y’Abanyamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.4",
            "verseOrgIds": [
              "ROM.16.4"
            ]
          }
        }
      ]
    },
    {
