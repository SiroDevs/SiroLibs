          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timoteyo, uwo dukorana, arabaramutsa, co kimwe na Lukiyo, Yasoni na Sosipateri Abayuda bagenzanje.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.21",
            "verseOrgIds": [
              "ROM.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ROM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje Terutiyo, nafashije Pawulo kwandika iri kete, ndabaramukije mw’izina rya Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.22",
            "verseOrgIds": [
              "ROM.16.22"
            ]
          }
        }
      ]
    },
    {
