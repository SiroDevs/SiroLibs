              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.24",
            "verseOrgIds": [
              "ROM.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ROM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana, yo ishobora kubakomeza mu kwizera, nk’uko Ubutumwa nahawe buvuga ihabwe icubahiro. Ubwo Butumwa buvuga Yesu Kristo kandi bwerekana umugambi Imana ifise kuri mwebwe abanyamahanga, wari waragizwe ibanga kuva kera. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nk’uko abavugishwa n’Imana bari barabivuze kandi nk’uko Imana Ihoraho yari yarabitegetse kuva kera, ubwo butumwa bwarahishuwe kugira ngo abanyamahanga aho bari hose, na bo bashobore kuyizera no kuyumvira. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.26",
            "verseOrgIds": [
              "ROM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ROM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icubahiro cose kibe ic’Imana yo nyene ubwenge bwose, ibihe vyose mw’izina rya Yesu Kristo! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.27",
            "verseOrgIds": [
              "ROM.16.27"
            ]
          }
        }
      ]
