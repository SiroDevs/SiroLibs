          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndafise ivyiza mvuga kuri mwene Data Foyibe, umudiyakonikazi mu rusengero rw’i Kenkireya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabasavye muze mumwakire mw’izina ry’Umwami wacu nk’uko bibereye abera b’Imana. Muze mumufashe mu vyo azokenera vyose, kuko yagiriye ikimazi benshi na canecane jewe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
    {
