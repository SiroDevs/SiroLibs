          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muntahirize umukunzi wanje Epayineto, uwabaye uwa mbere mu bizeye Yesu Kristo mu ntara ya Aziya.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.5",
