          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umuntu niyakora icaha ibigirankana, ari imvukira canke umunyamahanga, azoba atutse k’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "text": ", kandi uwo muntu aze akurwe mu bantu biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.30",
            "verseOrgIds": [
              "NUM.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko azoba yakengereye ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        },
        {
          "text": " agacumura ku vyo yategetswe, uwo muntu ntaze abure gukurwaho; icaha ciwe kizomwomako.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.31",
            "verseOrgIds": [
              "NUM.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
