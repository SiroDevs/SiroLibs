          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mpfizi y’intama yose muze mutegure ishikanwa ry’ifu ringana na bibiri vya cumi vy’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:6",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 3,2.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu inoze neza ivanze n’ica gatatu c’ingero hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:6",
              "type": "text"
            },
            {
              "text": "Ni nk’ilitiro n’ibice bitatu",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’amavuta, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.6",
            "verseOrgIds": [
              "NUM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe n’ica gatatu c’ingero hini y’umuvinyu ngo bibe ishikanwa ry’ibinyobwa. Mubitange bibe ubumote bwiza bunezereza ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.7",
            "verseOrgIds": [
              "NUM.15.7"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
