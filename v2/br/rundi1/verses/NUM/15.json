          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vugana n’Abisirayeli ubabwire uti: ‘Nimwinjira mu gihugu ngiye kubaha ngo mucegukire ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.2",
            "verseOrgIds": [
              "NUM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "nimwashikanira ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "text": " ikimazi co guturirwa, kivuye mu masho canke mu mikuku, nk’ubumote bwiza buhawe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "text": ", yaba ari amashikanwa yo guturirwa canke ibimazi, vyaba ari ivyo gushitsa isezerano canke ivyo gushikana bitanzwe n’uwuvyishakiye canke amashikanwa y’imisi mikuru; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.3",
            "verseOrgIds": [
              "NUM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwuzozana ishikanwa ryiwe aze ashikanire ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "text": " ishikanwa ry’ifu ringana n’ic’icumi c’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:4",
              "type": "text"
            },
            {
              "text": "Ni nk’ikilo 1,6.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu inoze neza ivanze n’ica kane c’ingero hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:4",
              "type": "text"
            },
            {
              "text": "Ni nk’ilitiro 1",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’amavuta. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.4",
            "verseOrgIds": [
              "NUM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mwagazi w’intama wose utanzwe nk’ikimazi co guturirwa canke ikindi kimazi, muze mutegure ica kane c’ingero hini y’umuvinyu bibe ikimazi c’ibinyobwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.5",
            "verseOrgIds": [
              "NUM.15.5"
            ]
          }
        }
      ]
    },
    {
