            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese w’imvukira yo muri mwebwe aze akore ivyo bintu muri ubwo buryo igihe cose azotanga ikimazi co guturirwa ngo kizane ubumote bwiza bunezereza ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.13",
            "verseOrgIds": [
              "NUM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko urunganwe ruzogenda rukuranwa n’urundi, umunyamahanga aba muri mwebwe canke umuntu wese wo muri mwebwe azotanga ikimazi co guturirwa ngo kibe ubumote bwiza bunezereza ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "text": ", aze abikore nk’uko namwe mubikora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.14",
            "verseOrgIds": [
              "NUM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwese muze mwisunge amategeko amwe, yaba mwebwe imvukira canke umunyamahanga aba muri mwebwe. Iryo rize ribe itegeko rizokwamaho uko urunganwe ruzogenda rukurakuranwa n’urundi. Mwebwe n’umunyamahanga aba muri mwebwe muri co kimwe imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "text": ": ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.15",
            "verseOrgIds": [
              "NUM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Itegeko rimwe n’icagezwe kimwe ni vyo bizogenga mwebwe n’abanyamahanga baba muri mwebwe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.15.16",
            "verseOrgIds": [
              "NUM.15.16"
            ]
          }
        }
      ]
