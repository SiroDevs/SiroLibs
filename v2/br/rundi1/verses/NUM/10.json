            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.1",
            "verseOrgIds": [
              "NUM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Cura inzamba zibiri mw’ifeza ihondaguye, uze uzikoreshe mu guhamagara ikoraniro no mu kumenyesha umwanya wo kuzinga amahema ngo babandanye urugendo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.2",
            "verseOrgIds": [
              "NUM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe izo nzamba zivugirijwe rimwe, ikoraniro ryose rize rikoranire imbere yawe, imbere y’Ihema ry’Ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.3",
            "verseOrgIds": [
              "NUM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo havugijwe imwe gusa, abarongoye abandi, abakuru b’amazu y’Abisirayeli, baze bakoranire imbere yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.4",
            "verseOrgIds": [
              "NUM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzamba niyavuga n’ijwi rirengera rimwe, imiryango iherereye mu buseruko baze bahaguruke bagende. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.5",
            "verseOrgIds": [
              "NUM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzamba niyavuga ubwa kabiri mw’ijwi rirengera, imiryango iri mu bumanuko baze bahaguruke bagende. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.6",
            "verseOrgIds": [
              "NUM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gukoranya ikoraniro, muze muvuze izo nzamba, ariko ntimukoreshe ijwi rimwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.7",
            "verseOrgIds": [
              "NUM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahungu ba Aroni, ari bo baherezi, baze bavuze izo nzamba; iri ni ryo tegeko ry’intahava uko urunganwe ruzogenda rukurikirana n’urundi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.8",
            "verseOrgIds": [
              "NUM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwaja mu ntambara mu gihugu canyu bwite muriko muragwanya umwansi abasugereje, muze muvuze izo nzamba mw’ijwi rirengera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "text": " Imana yanyu azoca abibuka kandi muzotabarwa mukire abansi banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.9",
            "verseOrgIds": [
              "NUM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mu bihe vyanyu vy’umunezero, haba mu misi mikuru yashinzwe canke imboneko z’ukwezi, muze muvuze izo nzamba mwongere mutange n’ibimazi vyo guturirwa n’ivy’impongano, na vyo bizoba icibutso canyu imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        },
        {
          "text": ". Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        },
        {
          "text": " Imana yanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.10",
            "verseOrgIds": [
              "NUM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi wa mirongo ibiri w’ukwezi kwa kabiri kw’umwaka wa kabiri, ca gicu kiraduga kiva kw’Ihema ry’ibishingantahe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.11",
            "verseOrgIds": [
              "NUM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli bava hasi bava mu bugaragwa bw’i Sinayi bagenda barunguruza gushika aho ca gicu cahagarariye mu bugaragwa bw’i Parani. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.12",
            "verseOrgIds": [
              "NUM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo ni bwo bwa mbere Abisirayeli bavuye aho bari bacumbitse nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "text": " yari yabibategetse abicishije kuri Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.13",
            "verseOrgIds": [
              "NUM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigwi yo mu ba Yuda ni bo babanje guhaguruka, bari musi y’ibendera ryabo. Nahashoni mwene Aminadabu ni we yari abarongoye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.14",
            "verseOrgIds": [
              "NUM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netaneli mwene Zuwari ni we yari arongoye umugwi wo mu muryango wa Isakari, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.15",
            "verseOrgIds": [
              "NUM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyabu mwene Heloni na we ni we yari arongoye umugwi wo mu muryango wa Zebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.16",
            "verseOrgIds": [
              "NUM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma rya hema rica rirazingwa, Abagerishoni n’Abamerari, ari bo bari bariteruye, baca baragenda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.17",
            "verseOrgIds": [
              "NUM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigwi yari musi y’ibendera rya Reyubeni barakurikira, bari musi y’ibendera ryabo. Elisuri mwene Shedewuri ni we yari abarongoye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.18",
            "verseOrgIds": [
              "NUM.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelumiyeli mwene Zurishadayi yari arongoye umugwi w’umuryango wa Simeyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.19",
            "verseOrgIds": [
              "NUM.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyasafu na we, mwene Dewuyeli yari arongoye umugwi w’umuryango wa Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.20",
            "verseOrgIds": [
              "NUM.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Abakohati bava hasi, bateruye vya bikoresho vyera. Ihema ryategerezwa gushingwa aho ryategerezwa kuba imbere y’uko bashika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.21",
            "verseOrgIds": [
              "NUM.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imigwi yari musi y’ibendera rya Efurayimu barakurikira, bari musi y’ibendera ryabo. Elishama mwene Amihudi ni we yari abarongoye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.22",
            "verseOrgIds": [
              "NUM.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gamaliyeli mwene Pedasuri ni we yari arongoye umugwi w’umuryango wa Manase, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.23",
            "verseOrgIds": [
              "NUM.10.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abidani mwene Gidiyoni na we yari arongoye umugwi w’umuryango wa Benyamini.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 10:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.24",
            "verseOrgIds": [
              "NUM.10.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 10:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwa nyuma, imigwi irongowe n’ibendera rya Dani, nk’umugwi ujejwe umutekano w’inyuma, bava hasi barongowe n’ibendera ryabo. Ahiyezeri mwene Amishadayi ni we yari abarongoye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.25",
            "verseOrgIds": [
              "NUM.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pagiyeli mwene Okurani ni we yari arongoye umugwi w’umuryango wa Asheri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.26",
            "verseOrgIds": [
              "NUM.10.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 10:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahira mwene Enani na we yari arongoye umugwi w’umuryango wa Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.10.27",
            "verseOrgIds": [
              "NUM.10.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 10:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo rwari urutonde rwo kugenda rw’imigwi y’Abisirayeli uko bakurikirana mu kuva hasi.",
