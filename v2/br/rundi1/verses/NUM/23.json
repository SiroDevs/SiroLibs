          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        },
        {
          "text": " hari ico yombwira. Ico ampishurira cose ndakikubwira.” Nuko Balamu aca araduga aja ku gatwe k’umusozi ata co kamerako.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.3",
            "verseOrgIds": [
              "NUM.23.3"
            ]
          }
        }
      ]
