        },
        {
          "text": "Balamu aravuga ati: “Nyubakira ibicaniro indwi ngaha, munzanire n’impfizi indwi z’inka n’izindi indwi z’intama” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.23.1",
            "verseOrgIds": [
