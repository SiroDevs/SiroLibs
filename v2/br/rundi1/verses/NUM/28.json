        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 28:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi wo gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "text": " ivyatanguye kwera imbere y’ibindi mu misi mikuru y’amayinga, muze mugire ikoraniro ryera kandi ntimuze mugire igikorwa na kimwe mukora. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.26",
            "verseOrgIds": [
              "NUM.28.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 28:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mutange ikimazi co guturirwa c’amashuri abiri akiri mato, impfizi y’intama ikuze imwe n’impfizi z’intama indwi zimaze umwaka, bibe ubumote bwiza buhimbara ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.27",
            "verseOrgIds": [
              "NUM.28.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 28:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impfizi yose ize iherekezwe n’ishikanwa ringana na bitatu vya cumi vy’ingero efa y’ifu inoze neza ikaranze mu mavuta; impfizi y’intama imwe na yo iherekezwe na bibiri vya cumi vy’ingero efa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.28",
            "verseOrgIds": [
              "NUM.28.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 28:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "umwagazi wose muri iyo myagazi indwi, uzoherekezwa n’ica cumi c’ingero efa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.29",
            "verseOrgIds": [
              "NUM.28.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 28:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uze ushiremwo n’isuguru y’impene imwe yo gutanga nk’ikimazi gikurako ivyaha vyanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.30",
            "verseOrgIds": [
              "NUM.28.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 28:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mutegure ibi vyose hamwe n’ishikanwa ry’ibinyobwa bijanye, bizokwiyongera kuri ca kimazi co guturirwa co ku musi ku musi n’ishikanwa ry’ifu bijanye. Muze mwiyubare ivyo bitungwa ntibize bibe bifise agasembwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.31",
            "verseOrgIds": [
              "NUM.28.31"
            ]
          }
        }
      ]
