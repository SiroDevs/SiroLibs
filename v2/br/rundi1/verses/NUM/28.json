      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.1",
            "verseOrgIds": [
              "NUM.28.1"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.1",
            "verseOrgIds": [
              "NUM.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tegeka Abisirayeli ubabwire uti: ‘Mwiyubare kugira ngo mu gihe cashinzwe muze mushikanire imfungurwa zanje ari vyo vya bimazi vyo kwoswa nk’umubabwe umota neza unezera.’ ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.2",
            "verseOrgIds": [
              "NUM.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubabwire uti: ‘Iri ni ryo shikanwa ryo guturirwa mukwiye gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "text": ": imyagazi y’intama ibiri imaze umwaka itagira agasembwa, nk’ikimazi co guturirwa cama gitangwa ku musi ku musi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mushikane umwe mu gitondo, uwundi ku mugoroba, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.4",
            "verseOrgIds": [
              "NUM.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe n’ishikanwa ry’ifu ringana n’ic’icumi c’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:5",
              "type": "text"
            },
            {
              "text": "Ni nk’ikilo 1,9.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu inoze neza n’ica kane c’ingero hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:5",
              "type": "text"
            },
            {
              "text": "Ni nk’ilitiro 1.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’amavuta ya elayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico ni ikimazi co guturirwa cama gitangwa nk’uko vyashinzwe ku Musozi Sinayi ngo kibe ubumote bwiza bushikaniwe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishikanwa ry’ibinyobwa riherekeza iryo rize ribe ica gatatu c’ingero hini, hamwe n’uwo mwagazi. Muze musuke iryo shikanwa ry’ibinyobwa ahera imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mushikane umwagazi wa kabiri ku mugoroba, hamwe n’ishikanwa ry’ifu n’iry’ibinyobwa risa n’irya mbere ryo mu gitondo. Ico ni ikimazi giturirwa, ishikanwa rimota neza rihimbara ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi w’Isabato, muze mutange imyagazi y’intama ibiri imaze umwaka umwe kandi itagira agasembwa, hamwe n’ishikanwa ry’ibinyobwa n’ishikanwa bijanye rigizwe na bibiri vya cumi vy’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:9",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 3,2.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu ikaranzwe mu mavuta ya elayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co kimazi co guturirwa kizotangwa uko Isabato ishitse, ciyongera kuri ca kimazi co ku musi ku musi n’ishikanwa bijana ry’ibinyobwa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
              "NUM.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
              "NUM.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kw’igenekerezo rya mbere ry’ukwezi kwose, muze mushikanire ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.11",
            "verseOrgIds": [
              "NUM.28.11"
            ]
          }
        },
        {
          "text": " ikimazi giturirwa kigizwe n’impfizi zibiri z’inka, impfizi y’intama ikuze imwe, n’impfizi z’intama indwi zimaze umwaka umwe, zitagira agasembwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.11",
            "verseOrgIds": [
              "NUM.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impfizi yose y’inka muze muyishikane hamwe n’ishikanwa ry’ifu rigizwe na bitatu vya cumi vy’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:12",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu inoze neza ikaranze mu mavuta, hanyuma impfizi yose y’intama ize ijane n’ishikanwa ry’ifu rigizwe na bibiri vya cumi vy’ingero efa y’ifu inoze neza ikaranzwe mu mavuta; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi umwagazi w’intama wose, uze ujane n’ica cumi c’ingero efa y’ifu inoze neza ikaranzwe mu mavuta. Ico ni co kimazi co guturirwa, ubumote bwiza bushikaniwe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impfizi yose ize iherekezwe n’ishikanwa ry’ibinyobwa ringana n’igice c’ingero hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:14",
              "type": "text"
            },
            {
              "text": "Ni nk’ilitiro n’ibice icenda",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’umuvinyu; hanyuma impfizi yose y’intama na yo iherekezwe n’ica gatatu c’ingero hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:14",
              "type": "text"
            },
            {
              "text": "Ni nk’ilitiro n’ibice bitatu",
              "type": "text"
            }
          ]
        },
        {
          "text": "; umwagazi w’intama na wo, uherekezwe n’ica kane c’ingero hini",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:14",
              "type": "text"
            },
            {
              "text": "Ni nk’ilitiro imwe",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Ico ni ikimazi gitangwa uko ukwezi kwose mu mezi agize umwaka gutanguye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I ruhande y’ibimazi vyo guturirwa vyama bitangwa n’ishikanwa ribiherekeza, haze hatangwe n’isuguru y’impene y’ikimazi c’ivyaha gishikaniwe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 28:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira icumi na kane w’ukwezi kwa mbere muze muhimbaze Pasika y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
            "verseOrgIds": [
              "NUM.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira icumi na gatanu w’ukwo kwezi nyene muze mugire umusi mukuru; muze mumare imisi indwi murya imikate itarimwo umwambiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi wa mbere muzogire ikoraniro ryera kandi ntimuze mugire igikorwa muwukorako. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.18",
            "verseOrgIds": [
              "NUM.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mushikanire ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.19",
            "verseOrgIds": [
              "NUM.28.19"
            ]
          }
        },
        {
          "text": " ibimazi vyo guturirwa n’umuriro, bigizwe n’impfizi zibiri z’inka, impfizi y’intama imwe n’imyagazi y’intama indwi imaze umwaka, kandi itagira agasembwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.19",
            "verseOrgIds": [
              "NUM.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishuri yose izojana n’ishikanwa ry’ifu rigizwe na bitatu vya cumi vy’ingero efa y’ifu inoze neza ikaranze mu mavuta; impfizi y’intama na yo ijane n’ibilo bitandatu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.20",
            "verseOrgIds": [
              "NUM.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi umwagazi w’intama wose muri iyo ndwi, uzojana n’ibilo bitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.21",
            "verseOrgIds": [
              "NUM.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mwongereko isuguru y’impene imwe y’ikimazi c’ivyaha co kubabera igikuraho icaha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.22",
            "verseOrgIds": [
              "NUM.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bizokwiyongera ku bimazi biturirwa muzokwama mutanga imisi yose mu gatondo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
            "verseOrgIds": [
              "NUM.28.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 28:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko muzokwama mushikana ivyo bimazi ku musi ku musi muri iyo misi yose uko ari indwi, imfungurwa z’amashikanwa y’ubumote bwiza bunezera ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.24",
            "verseOrgIds": [
              "NUM.28.24"
            ]
          }
        },
        {
          "text": "; bize vyame bitegurwa vyiyongera ku bimazi vyo guturirwa muhora mutanga ku musi hamwe n’ishikanwa rijana na vyo ry’umuvinyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.24",
            "verseOrgIds": [
              "NUM.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira indwi muze mugire ikoraniro ryera kandi ntimuze mugire igikorwa muwukorako.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
            "verseOrgIds": [
              "NUM.28.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
