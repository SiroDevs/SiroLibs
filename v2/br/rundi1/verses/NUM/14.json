          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko banka kwumva, mu bwibone bwabo baraduga baja muri iyo misozi, naho Mose na ya sandugu y’isezerano batigeze bava aho bari bacumbitse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.44",
            "verseOrgIds": [
              "NUM.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abamaleki n’Abanyakanani baba muri iyo misozi baramanuka barabatera bagenda barabica gushika i Horuma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.14.45",
            "verseOrgIds": [
              "NUM.14.45"
            ]
          }
        }
      ]
    }
