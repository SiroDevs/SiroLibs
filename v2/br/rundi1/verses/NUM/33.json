            "style": "v",
            "sid": "NUM 33:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.54",
            "verseOrgIds": [
              "NUM.33.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "NUM 33:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nimutirukana ababa muri ico gihugu, abo muzosigaza bazoba nk’amahwa mu maso yanyu no mu mbavu zanyu. Bazobateza amagorwa mu gihugu mugiye kubamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.55",
            "verseOrgIds": [
              "NUM.33.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "NUM 33:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje nzokorera mwebwe ivyo niteguye gukorera abo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.33.56",
            "verseOrgIds": [
              "NUM.33.56"
            ]
          }
        }
      ]
