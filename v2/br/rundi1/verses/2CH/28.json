          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahazi yegeranya ibikoresho vyose vyari mu Ngoro y’Imana arabimenagura. Araheza yugara inzugi z’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "text": " aca yubaka ibicaniro ku mayirabiri yose y’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gisagara cose c’i Buyuda, ashinga ku misozi miremire ibibanza vyo gutuririramwo ibimota neza, no gushikaniramwo ibimazi izindi mana, ivyo vyongera kuvyura uburake bw’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        },
        {
          "text": " Imana ya ba sekuruza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        }
      ]
