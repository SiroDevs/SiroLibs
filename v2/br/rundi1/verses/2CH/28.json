            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashikanira ibimazi ibigirwamana vy’i Damasiko, kuko abantu baho bamunesheje; akiyumvira ati: “Ko imana z’abami b’i Siriya zabafashije, ndazishikaniye ibimazi nanje zontabara.” Ariko zamubereye umutego we hamwe n’Abisirayeli bose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.23",
            "verseOrgIds": [
              "2CH.28.23"
            ]
          }
        }
      ]
