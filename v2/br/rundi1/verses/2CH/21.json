        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.19",
            "verseOrgIds": [
              "2CH.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu yari afise imyaka mirongo itatu n’ibiri igihe yimikwa ngo abe umwami, maze aganza imyaka umunani ari i Yerusalemu. Apfuye nta n’umwe yababajwe n’urupfu rwiwe. Nuko ahambwa mu Gisagara ca Dawidi, ariko ntiyashirwa mu mva z’abami.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.21.20",
            "verseOrgIds": [
