          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yehoshafati arabaza ati: “Mbega ngaha nta muvugishwa w’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        },
        {
          "text": " n’umwe akihari twobaza?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        }
      ]
    },
    {
