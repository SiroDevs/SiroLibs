          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umwami w’Abisirayeli ahamagara umwe mu batware biwe amubwira ati: “Nyaruka uzane Mikaya mwene Imula.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.8",
            "verseOrgIds": [
              "2CH.18.8"
            ]
          }
        }
