          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami w’Abisirayeli yishura Yehoshafati ati: “Haracariho uwundi muvugishwa umwe yotubariza ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        },
        {
          "text": ", ariko ndamwanka kuko atigera avugishwa ivyiza kuri jewe, atari ibibi. Ni Mikaya mwene Imula.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati aramwishura ati: “Umwami ntakwiye kuvuga atyo.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
