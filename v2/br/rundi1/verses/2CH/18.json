              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bavugishwa bose na bo nyene bavugishwa ukwo nyene, bati: “Genda utere i Ramoti Gileyadi, uzohatsinda, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        },
        {
