          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo yongera akora ibikoresho vyose vyari mu Ngoro y’Imana:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.4.19",
            "verseOrgIds": [
              "2CH.4.19"
