            "sid": "2CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo mwene Dawidi aba agakomeye mu bwami bwiwe, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        },
        {
          "text": " Imana yiwe yari kumwe na we kandi amugira uwuhambaye cane.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.1",
            "verseOrgIds": [
              "2CH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo avugana n’Abisirayeli bose, abatwara ingabo ibihumbi n’abatwara ingabo amajana, abacamanza, abarongozi, b’Abisirayeli bose n’abakuru b’amazu ya ba sekuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.2",
            "verseOrgIds": [
              "2CH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo n’abantu bose baja kw’itaba ry’umusozi i Gibeyoni, kuko Ihema ry’Ibonaniro ry’Imana ari ho ryari rishinzwe, iryo Mose umusavyi w’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "text": " yari yarakoze bakiri mu bugaragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.3",
            "verseOrgIds": [
              "2CH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Dawidi yari yaramaze kuzana Isandugu y’Imana ayikura i Kiriyati-Yeyarimu ayijana mu kibanza yari yayiteguriye, kuko yari yarayishingiye ihema i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.4",
            "verseOrgIds": [
              "2CH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ca gicaniro gikozwe mu butare bw’umwakaka ico Bezaleli mwene Uri, Uri mwene Huri, yari yarakoze cari kikiri i Gibeyoni imbere y’Ihema ry’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "text": ". Aho ni ho Salomo n’ikoraniro ryose bambariza ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.5",
            "verseOrgIds": [
              "2CH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo araduga aja kuri ca gicaniro c’ubutare bw’umwakaka cari imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "text": " mw’Ihema ry’Ibonaniro aca agitangirako ibimazi igihumbi vyo guturirwa n’umuriro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.6",
            "verseOrgIds": [
              "2CH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri iryo joro Imana yiyereka Salomo iramubwira iti: “Nsaba ico ushaka cose ndakiguha.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.7",
            "verseOrgIds": [
              "2CH.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo yishura Imana ati: “Wagiriye neza cane data Dawidi maze ungira umwami mu kibanza ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.8",
            "verseOrgIds": [
              "2CH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "text": " Mana, nushitse isezerano wasezeraniye data Dawidi, kuko wanyimitse ngo mbe umwami w’ihanga ry’abantu benshi bangana nk’umukungugu wo kw’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.9",
            "verseOrgIds": [
              "2CH.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numpe ubwenge n’ubumenyi, kugira ngo nshobore kurongora ubu bwoko. Mbega none ni nde yoshobora kuganza ubu bwoko bwawe bwinshi bungana gutya?”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.10",
            "verseOrgIds": [
              "2CH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ibwira Salomo iti: “Ko ico ari co umutima wawe wipfuza ukaba utansavye ubutunzi, ibintu canke icubahiro, canke ngo unsabe ko abansi bawe bapfa; kandi ko utansavye kuramba ariko ukansaba ubwenge n’ubumenyi kugira ngo ushobore kuganza neza abantu banje, abo naguhaye ngo ubabere umwami; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.11",
            "verseOrgIds": [
              "2CH.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko ubwenge n’ubumenyi ndabiguhaye. Kandi nzoguha ubutunzi n’ibintu vyinshi, icubahiro no kuba rurangiranwa, ku buryo ata mwami n’umwe mu bakwitangiye imbere bose yigeze kuronka nk’ivyo, canke ngo habe n’umwe azobironka mu bazoza inyuma yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.12",
            "verseOrgIds": [
              "2CH.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo aja i Yerusalemu avuye imbere y’ihema ry’ibonaniro ryari kw’itaba ry’umusozi Gibeyoni. Maze akomeza ivy’ubwami bwiwe mu Bisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.13",
            "verseOrgIds": [
              "2CH.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo yegeranya imikogote y’intambara n’amafarasi menshi. Yari afise imikogote igihumbi n’amajana ane, n’amafarasi ibihumbi cumi na bibiri. Bimwe abibika mu bisagara vy’imikogote, ibindi abigumiza hafi yiwe i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.14",
            "verseOrgIds": [
              "2CH.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami agwiza ifeza n’inzahabu i Yerusalemu bisigara bimeze nk’amabuye, imbaho z’agaciro z’amasederi na zo ziragwira zimera nk’ibiti vy’imisukomora vyo mu biyaya vy’i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.15",
            "verseOrgIds": [
              "2CH.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amafarasi ya Salomo yari yayakuye muri Egiputa n’i Kilikiya; abadandaza b’umwami bari bayaguriye muri Kilikiya ku giciro gisanzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.16",
            "verseOrgIds": [
              "2CH.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukogote umwe bawugura muri Egiputa shekeli amajana atandatu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:17",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 6,9.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza, ifarasi imwe na yo bakayigura shekeli ijana na mirongo itanu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:17",
              "type": "text"
            },
            {
              "text": "Ni nk’ikilo 1,7.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Kandi abo badandaza ni bo banabigurisha no ku bami bose b’Abaheti n’ab’Abarameya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.1.17",
            "verseOrgIds": [
              "2CH.1.17"
            ]
          }
        }
      ]
    }
