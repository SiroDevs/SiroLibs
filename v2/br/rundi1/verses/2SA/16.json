          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bubakira ihema Abusalomu hejuru ku kirimba, aca aryamana na za ncoreke za se Abisirayeli bose babibona.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.22",
            "verseOrgIds": [
              "2SA.16.22"
            ]
          }
        }
