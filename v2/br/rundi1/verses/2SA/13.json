  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2SA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo, Amunoni mwene Dawidi akunda cane Tamari, umukobwa mwiza bavukana kandi akaba mushiki wa Abusalomu uwundi muhungu wa Dawidi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.1",
            "verseOrgIds": [
              "2SA.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amunoni agira ivyipfuzo vyinshi bimurengeye gushika aho amera nk’uwugwaye kubera ivyo vyipfuzo. Kubera yuko Tamari atari bwigere aryamana n’umugabo, Amunoni abona ko ata kuntu ashobora kumuronka.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.2",
            "verseOrgIds": [
              "2SA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.2",
            "verseOrgIds": [
              "2SA.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Amunoni yari afise umugenzi yitwa Yonadabu mwene Shimeya, umuvukanyi wa Dawidi. Yonadabu yari umuntu aciye akenge. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.3",
            "verseOrgIds": [
              "2SA.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe, abaza Amunoni ati: “Ni igiki gituma, wewe umwana w’umwami, uboneka wacitse intege uko imisi ihera? Ntiwobimbwira?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amunoni aramubwira ati: “Nkunda cane Tamari, mushiki wa Abusalomu umuvukanyi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.4",
            "verseOrgIds": [
              "2SA.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonadabu aca amubwira ati: “Reka ndakubwire uko ubigenza: genda uryame wigire nk’uwugwaye. Maze so niyaza kukuraba, uce umubwira uti: ‘Nshaka ko mushikanje Tamari yoza anzaniye ivyokurya. Abitegurire aho mbona hanyuma aheze abinyihere.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.5",
            "verseOrgIds": [
              "2SA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.5",
            "verseOrgIds": [
              "2SA.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Amunoni araryama yigira uwugwaye. Maze umwami aje kumuraba, Amunoni amubwira ati: “Nashaka ko mushikanje Tamari yoza agategurira udukate imbere yanje aho mbona, kugira ngo nshobore kuturya antamitse.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.6",
            "verseOrgIds": [
              "2SA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.6",
            "verseOrgIds": [
              "2SA.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi atumako Tamari ku kirimba ati: “Genda ku nzu ya musazawe Amunoni umutegurire ico arya.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.7",
            "verseOrgIds": [
              "2SA.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Tamari aja kwa musazawe Amunoni, na we akaba yari aryamye. Atwara ifu, arayicumba, akora udukate mu maso yiwe aratwotsa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.8",
            "verseOrgIds": [
              "2SA.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko afata isahani maze amuzanira twa dukate, ariko yanka kurya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amunoni avuga ati: “Sohora abari hano bose.” Maze bose barasohoka. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.9",
            "verseOrgIds": [
              "2SA.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Amunoni abwira Tamari ati: “Nzanira ivyo vyokurya ku buriri ubinyihere.” Maze Tamari yakira twa dukate yari yateguye atuzanira musazawe Amunoni mu cumba yaryamamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.10",
            "verseOrgIds": [
              "2SA.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko amuhereje ngo yakire arye, aca aramusumira aramufata amubwira ati: “Mushikanje Tamari, emera turyamane.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.11",
            "verseOrgIds": [
              "2SA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.11",
            "verseOrgIds": [
              "2SA.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwishura ati: “Oya, mwana wa data. Kandi ntumfate ku nguvu! Ikintu nk’ico ntigikwiye gukorwa mu Bisirayeli! Ntukore ikibi nk’ico. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.12",
            "verseOrgIds": [
              "2SA.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega noheza ivyo biteterwe nkabijana hehe? Mbere na wewe woba ubaye nk’umwe mu bipfamutima vyo muri Isirayeli. Ndakwinginze vugana n’umwami; kuko atokunyima ngo undongore.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.13",
            "verseOrgIds": [
              "2SA.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntiyamwumviriza, kandi kuko yamurusha inkomezi, amufata ku nguvu asambana na we.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.14",
            "verseOrgIds": [
              "2SA.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Amunoni aca amwanka urunuka. Ndetse urwanko yamwanse rusumba urukundo yari yamukunze. Amunoni aca amubwira ati: “Va ngaha, sohoka!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.15",
            "verseOrgIds": [
              "2SA.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.15",
            "verseOrgIds": [
              "2SA.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari amwishura ati: “Oya reka kunyirukana, kuko woba ukoze ikindi kibi kiruta n’ico umaze kunkorera.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntiyamwumviriza. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.16",
            "verseOrgIds": [
              "2SA.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamagara umukozi wiwe ati: “Sohora uwu mukobwa ave hano uce wugara urugi.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.17",
            "verseOrgIds": [
              "2SA.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko wa mukozi wiwe aca aramusohora, maze yugara urugi. Yari yambaye ikanzu nziza y’igiciro isharijwe amabara menshi, kuko ari ko abakobwa b’umwami batarigera baryamana n’abagabo bambara. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.18",
            "verseOrgIds": [
              "2SA.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamari aca yisiga iminyota ku mutwe atabagura na ya kanzu y’amabara y’igiciro yari yambaye. Aca yikorera amaboko agenda araboroga inzira yose.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.19",
            "verseOrgIds": [
              "2SA.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musazawe Abusalomu aca amubwira ati: “Mbega Amunoni, musazawe yari kumwe nawe? Ihorere, mushikanje; ni musazawe. Ntubishireko umutima.” Maze Tamari aca aja kuba mu nzu kwa musazawe Abusalomu, amera nk’umugore yahebwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.20",
            "verseOrgIds": [
              "2SA.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Dawidi avyumvise, arashavura cane. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.21",
            "verseOrgIds": [
              "2SA.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu ntiyigera asubira kuvugisha ikintu na kimwe Amunoni, caba ciza canke kibi; yaramwanka cane kuko yononye mushikiwe Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.22",
            "verseOrgIds": [
              "2SA.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imyaka ibiri iheze, mu gihe abamwa ubwoya bw’intama za Abusalomu bari i Bayali-Hazori hafi y’urugabano rwa Efurayimu, Abusalomu aca atumira abahungu b’umwami bose ngo baze mu musi mukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.23",
            "verseOrgIds": [
              "2SA.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu ashikira umwami amubwira ati: “Umusavyi wawe naramutse nkoresha abamwa ubwoya bw’intama. Mbega umwami n’abanyacubahiro biwe bontera iteka ryo kuza kwifatanya nanje?”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.24",
            "verseOrgIds": [
              "2SA.13.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.24",
            "verseOrgIds": [
              "2SA.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramwishura ati: “Oya mwana. Twese ntitwoza; twohava tukubera umuzigo.” Naho Abusalomu yagumye amwinginga cane, ntiyamwemerera kugenda, ariko aramuhezagira.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.25",
            "verseOrgIds": [
              "2SA.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.25",
            "verseOrgIds": [
              "2SA.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abusalomu aca avuga ati: “Ko bidashobotse, ndakwinginze undungikire umuvukanyi wanje Amunoni wewe aze tujane.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramubaza ati: “Ni kuki ugomba ko ajana nawe?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.26",
            "verseOrgIds": [
              "2SA.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Abusalomu aramugobera cane, maze arateba aremera ko bajana na Amunoni n’abandi bahungu b’umwami bose.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.27",
            "verseOrgIds": [
              "2SA.13.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.27",
            "verseOrgIds": [
              "2SA.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu aca atanga itegeko ku bantu biwe ati: “Umviriza! Murindire kugeza igihe Amunoni azoba amaze kunywa umuvinyu akaborerwa nca ndababwira nti: ‘Mwice,’ muce mumwica. Ntimutinye. Si jewe ndabibabwiye? Mukomere ntimutinye.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.28",
            "verseOrgIds": [
              "2SA.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero abantu ba Abusalomu baronse ikimenyetso baca bica Amunoni nk’uko Abusalomu yari yabategetse. Nuko abahungu b’umwami bose bava hasi, burira indogoba zabo bariruka barahunga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.29",
            "verseOrgIds": [
              "2SA.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakiri mu nzira, inkuru ishikira Dawidi ivuga iti: “Abusalomu yishe abahungu b’umwami bose; nta n’umwe muri bo yasigaye.” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.30",
            "verseOrgIds": [
              "2SA.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami arahaguruka, yitabagurirako impuzu yicara hasi; maze abagendanyi biwe bahagarara i ruhande yiwe bitabaguriyeko impuzu zabo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.31",
            "verseOrgIds": [
              "2SA.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yonadabu mwene Shimeya, uwo bavukana na Dawidi avuga ati: “Umwami wanje ntiyibwire ko bishe abaganwa bose; Amunoni wenyene ni we yapfuye. Ivyo ni ivyo Abusalomu yari yaragize umugambi kuva umusi Amunoni yonona mushikiwe Tamari. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.32",
            "verseOrgIds": [
              "2SA.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyakwubahwa mwami ntushire umutima kuri iyo nkuru ivuga ko abahungu b’umwami bose bapfuye. Ni Amunoni wenyene yapfuye.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.33",
            "verseOrgIds": [
              "2SA.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Abusalomu we, yari yahunze.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma umuteramyi ari ku rugo rw’i Yerusalemu agize gutya, abona abantu benshi bariko baraza bamanuka umusozi mw’ibarabara riva mu burengero. Uwo muteramyi ariruka abibwira umwami ati: “Ndabonye abantu baje bava i Horonayimu, bari mu mbavu z’umusozi.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonadabu aca abwira umwami ati: “Ehe, abahungu b’umwami barashitse; bibaye nk’uko umusavyi wawe yabivuze.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agiheza kuvuga, abahungu b’umwami binjira baboroga cane. Umwami na we nyene, n’abakozi biwe, barirana na bo cane.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu na we arahunga aja kwa sekuru Talumayi mwene Amihudi, umwami w’i Geshuri. Maze Dawidi agandarira umuhungu wiwe Amunoni imisi myinshi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.37",
            "verseOrgIds": [
              "2SA.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusalomu na we arahunga aja i Geshuri, amarayo imyaka itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.38",
            "verseOrgIds": [
              "2SA.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umwami Dawidi amaze kwirurwa umubabaro wa Amunoni atangura kwiyumvira ingene yosubiza hamwe na Abusalomu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
            "verseOrgIds": [
              "2SA.13.39"
            ]
          }
        }
      ]
    }
  ],
