          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamubonye nca nikubita imbere y’ibirenge vyiwe nk’uwupfuye. Ariko aca anshirako ikiganza c’i buryo ambarira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
