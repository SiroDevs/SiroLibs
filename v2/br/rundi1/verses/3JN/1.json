              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "3JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugenzi nkunda, ndakwipfuriza kugira amagara meza no kuroranirwa mu mubiri, nk’uko umushaha wawe umerewe. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.2",
            "verseOrgIds": [
              "3JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "3JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naranezerewe cane igihe bamwe muri bene Data baza bakambwira ingene uri umwizigirwa kandi ugendera mu kuri. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.3",
            "verseOrgIds": [
              "3JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "3JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta munezero woza undutira kwumva ko abana banje bagendera mu kuri.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "3JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.4",
            "verseOrgIds": [
              "3JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "3JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugenzi nkunda, werekana ubwizigirwa mu vyo uriko urakorera bene Data, naho ari abanyamahanga kuri wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.5",
            "verseOrgIds": [
              "3JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "3JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bashingiye intahe urukundo rwawe imbere y’ishengero. Ndakwinginze ubandanye ubashigikira mu vyo bakeneye mu buryo bunezereza Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.6",
            "verseOrgIds": [
              "3JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "3JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bafashe urugendo bakorera izina rya Kristo, kandi ntibemeye gufashwa n’abatizera. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.7",
            "verseOrgIds": [
              "3JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "3JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dutegerezwa kwakira n’umutima mwiza abantu nk’abo kugira ngo dufatanye na bo gukorera ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "3JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "3JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narandikiye ishengero; ariko Diyotirefe, akunda kwishira imbere, ntiyemera ikibanza cacu nk’abarongozi. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.9",
            "verseOrgIds": [
              "3JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninaza, nzoshira ahabona ivyo ariko arakora, ibibi n’ibinyoma akwiragiriza atuvuga nabi. Uretse ko we ubwiwe yanka kwakira bene Data, ahubwo abuza n’abashaka kubakira, akanabataramura mw’ishengero.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "3JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.10",
            "verseOrgIds": [
              "3JN.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "3JN 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugenzi nkunda, ntukigane ibibi, ariko wigane ivyiza. Umuntu wese akora ivyiza ava ku Mana. Umuntu wese akora ibibi ntarabona Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.11",
            "verseOrgIds": [
              "3JN.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "3JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Demetiriyusi avugwa neza na bose, nk’uko ukuri na kwo kumushingira intahe. Natwe tumuvuga neza kandi urazi ko intahe yacu ari iy’ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "3JN 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "3JN 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfise vyinshi nshaka kukubwira, ariko sinshaka kubikwandikira. ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.13",
            "verseOrgIds": [
              "3JN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nizeye ko tuzobonana vuba, tukavugana amaso mu yandi.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "3JN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahoro abane na we.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.15",
            "verseOrgIds": [
              "3JN.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "3JN 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakunzi turi kumwe barakuramutsa. Undamukirize abakunzi muri kumwe, umwe wese ku giti ciwe.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.15",
            "verseOrgIds": [
              "3JN.1.15"
            ]
          }
        }
      ]
