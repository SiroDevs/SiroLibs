          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ushire ku ruhande ibice vy’iyo mpfizi yo kurobanura Aroni n’abahungu biwe ari vyo vy’ibi: ca gikiriza na rya tako vyadugirizwa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "text": ", hamwe n’ishikanwa ryejejwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.27",
            "verseOrgIds": [
              "EXO.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwu uzokwame ari wo mugabane wa Aroni n’abahungu biwe. Ivyo bizova ku mashikanwa y’Abisirayeli, ayo bazoshikanira ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        },
        {
          "text": " nk’amashikanwa y’ishimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.28",
            "verseOrgIds": [
              "EXO.29.28"
            ]
          }
        }
      ]
    },
    {
