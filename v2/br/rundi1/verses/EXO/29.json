          },
          "items": [
            {
              "text": "29:40",
              "type": "text"
            },
            {
              "text": "Ni nk’ilitiro 1.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’amavuta meza yakanywe muri elayo, wongereko igice c’ilitiro ry’umuvinyu nk’ishikanwa ry’ibinyobwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 29:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwagazi wa kabiri uzowushikane ku mugoroba, hamwe n’ishikanwa ry’ifu, amavuta, n’umuvinyu bingana n’ivyo mu gitondo. Bizoba ari ishikanwa rimota neza rihimbaye, ikimazi gishikaniwe ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.41",
            "verseOrgIds": [
              "EXO.29.41"
            ]
          }
        },
        {
          "text": " giturirwa n’umuriro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.41",
            "verseOrgIds": [
              "EXO.29.41"
            ]
          }
        }
      ]
