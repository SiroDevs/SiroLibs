          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ho kandi nzobonanira n’Abisirayeli, kandi ico kibanza kize cezwe ku bw’icubahiro canje.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.43",
            "verseOrgIds": [
              "EXO.29.43"
            ]
          }
        }
      ]
