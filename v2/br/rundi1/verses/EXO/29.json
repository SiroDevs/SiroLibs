          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ng’ibi ivyo uzokwama ushikana ku gicaniro imisi yose: imyagazi y’intama ibiri imaze umwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.38",
            "verseOrgIds": [
              "EXO.29.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 29:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mushikane umwe mu gitondo, uwundi ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.39",
            "verseOrgIds": [
              "EXO.29.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 29:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwagazi wa mbere uzowutangane n’ic’icumi c’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "29:40",
              "type": "text"
            },
            {
              "text": "Ni nk’ikilo 1,6.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu inoze neza hamwe n’ica kane c’ingero hini",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.40",
            "verseOrgIds": [
              "EXO.29.40"
            ]
          }
        },
        {
