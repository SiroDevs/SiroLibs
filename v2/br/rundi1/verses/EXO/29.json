          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzofate ya mpfizi yo kurobanura, inyama zayo uzitekere mu kibanza catoranijwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.31",
            "verseOrgIds": [
              "EXO.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni n’abahungu biwe bazozirire imbere y’ihema ry’ibonaniro, bazikoze imikate iri muri ca giseke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.32",
            "verseOrgIds": [
              "EXO.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazorye ivyo vyatanzwe ngo bibabere ikimazi c’ivyaha co kurobanurwa n’ukwezwa kwabo. Ariko ntihazogire uwundi abiryako kuko ari ivyejejwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.33",
            "verseOrgIds": [
              "EXO.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyama z’iyo mpfizi n’imikate nivyarara bigashika mu gitondo, bizoturirwe. Ntibizoribwe kuko ari ivyera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.34",
            "verseOrgIds": [
              "EXO.29.34"
            ]
          }
        }
      ]
    },
    {
