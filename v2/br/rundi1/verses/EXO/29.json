              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokweza ihema ry’ibonaniro n’igicaniro, nongere neze Aroni n’abahungu biwe kugira ngo bambere abaherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.44",
            "verseOrgIds": [
