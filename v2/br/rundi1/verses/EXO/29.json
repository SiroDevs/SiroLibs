          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyambarwa vyejejwe vya Aroni bizokwame bihabwa abana n’abuzukuru uko bazogenda bamusubirira kugira ngo bazirobanurirwemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.29",
            "verseOrgIds": [
              "EXO.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwuzomusubirira nk’umuherezi akaza mw’ihema ry’ibonaniro gukora igikorwa c’ubuherezi Ahera, azomare imisi indwi azambara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.30",
            "verseOrgIds": [
              "EXO.29.30"
            ]
          }
        }
      ]
