            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bimazi biturirwa n’umuriro bizokwame bitangwa imisi yose uko urunganwe ruzogenda rukurikirana. Bazobishikane imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.42",
            "verseOrgIds": [
              "EXO.29.42"
            ]
          }
        },
        {
          "text": " mu rwinjiriro rw’ihema ry’ibonaniro. Nanje nzoza mbonane namwe, mvugane namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.29.42",
            "verseOrgIds": [
              "EXO.29.42"
            ]
          }
        },
        {
          "name": "verse",
