          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.13",
            "verseOrgIds": [
              "EXO.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mwaka muze mugire imisi mikuru itatu ku bwanje.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        }
      ]
