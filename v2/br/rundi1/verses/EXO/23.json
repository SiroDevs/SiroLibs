        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.14",
            "verseOrgIds": [
              "EXO.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwa mbere muzongirira umusi mukuru w’imikate itarimwo umwambiro. Muzomara imisi indwi murya imikate itarimwo umwambiro, nk’uko nabibategetse. Uwo musi muze mwame muwugira ibihe vyose mu kwezi kwa Abibu, kuko ari kwo mwaviriyemwo muri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
