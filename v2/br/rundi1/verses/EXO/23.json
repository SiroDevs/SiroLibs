        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.11",
            "verseOrgIds": [
              "EXO.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzokore mu misi itandatu, ariko ku musi ugira indwi ntimuzokore, kugira ngo inka zanyu n’indogoba ziruhuke, n’abagurano bavukiye muri mwebwe, ndetse n’abanyamahanga basubire kuronka inkomezi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.12",
            "verseOrgIds": [
              "EXO.23.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
