          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze munshikanire amaraso y’ibimazi ari kumwe n’ikindi kintu ico ari co cose kirimwo umwambiro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.18",
            "verseOrgIds": [
              "EXO.23.18"
            ]
          }
        }
      ]
