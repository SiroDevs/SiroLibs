        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.15",
            "verseOrgIds": [
              "EXO.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwa kabiri, muzohimbaze umusi mukuru w’ivyimburwa vya mbere mukuye mu mirima yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma muzohimbaze n’umusi w’umwimbu wa vyose mu mpera y’umwaka, mwegeranije ivyimburwa vyo mu mirima yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.16",
            "verseOrgIds": [
              "EXO.23.16"
            ]
          }
        }
      ]
    },
    {
