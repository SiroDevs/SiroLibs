            "sid": "EXO 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntugakwiragize ibinyoma. Ntukifatanye n’abanyakibi mu kubabera icabona c’ibinyoma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.1",
            "verseOrgIds": [
              "EXO.23.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
