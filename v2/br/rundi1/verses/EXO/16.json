              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " yategetse ati: “Umuntu wese yegeranye ibimuhagije, ajane ingero omeru",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
