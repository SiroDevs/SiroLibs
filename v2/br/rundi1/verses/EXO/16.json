          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bamaze imyaka mirongo ine barya manu kugeza bashitse mu gihugu bari bagiye kubamwo. Bariye manu gushika bashitse ku rubibe rw’i Kanani.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.35",
            "verseOrgIds": [
              "EXO.16.35"
            ]
