          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli babikora uko babibwiwe, bamwe begeranya vyinshi, abandi bike. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.17",
            "verseOrgIds": [
              "EXO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
