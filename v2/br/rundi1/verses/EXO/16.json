          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bita uwo mukate manu. Uwo mukate wera nk’utubuto tw’igiterwa citwa koriyanderi ugasosa nk’uwurimwo ubuki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.31",
            "verseOrgIds": [
              "EXO.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aravuga ati: “Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        },
        {
          "text": " ategetse: ‘Mufate ingero omeru imwe ya manu, muyibike kugira ngo n’abuzukuruza banyu bazobone umukate nabahereye mu bugaragwa igihe nabakura muri Egiputa.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.32",
            "verseOrgIds": [
              "EXO.16.32"
            ]
          }
        }
      ]
