          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Numvise ukwidodomba kw’Abisirayeli. Babwire uti: ‘Ku mugoroba w’ijoro, muraja kurya inyama, ejo mu gitondo na ho muzorya imikate muhage. Ni ho muzomenya ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        },
        {
          "text": " Imana yanyu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.12",
            "verseOrgIds": [
              "EXO.16.12"
            ]
          }
        }
