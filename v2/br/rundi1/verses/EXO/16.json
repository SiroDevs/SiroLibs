          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni akiriko aravugana n’imiryango yose ya Isirayeli, batereza amaso mu bugaragwa, babona ubwiza bw’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
              "EXO.16.10"
            ]
          }
        },
        {
          "text": " bugaragariye mu bicu.",
