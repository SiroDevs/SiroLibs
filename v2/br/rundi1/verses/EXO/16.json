          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose abarira Aroni ati: “Barira imiryango yose y’Abisirayeli uti: ‘Nimuze imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        },
        {
          "text": ", kuko yumvise ukwidodomba kwanyu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        }
      ]
    },
    {
