          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kubigera ku ngero yitwa omeru, abegeranije vyinshi basanga ntibirenze na gato ivyo bakeneye, abegeranije bike na bo nyene basanga ntaco bakeheje ku vyo bari bakeneye. Umuntu wese yegeranije, yasanga afise ibihwanye n’ivyo yari akeneye.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.18",
            "verseOrgIds": [
              "EXO.16.18"
            ]
          }
        }
