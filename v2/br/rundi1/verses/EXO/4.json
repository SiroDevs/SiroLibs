        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "text": " aramubwira ati: “Nibatakwemera canke ngo bemezwe n’ikimenyetso ca mbere, bazokwemezwa n’ica kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.8",
            "verseOrgIds": [
              "EXO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nibatemezwa n’ibi bimenyetso vyompi canke ngo bakwumvirize, uzodahe amazi y’uruzi Nili uyasese i musozi. Amazi uzoba wadashe muri urwo ruzi niwayasuka hasi, azoca ahinduka amaraso.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.9",
            "verseOrgIds": [
              "EXO.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
