            "number": "19",
            "style": "v",
            "sid": "EXO 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere y’uko Mose ava i Midiyani, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "text": " yari yamubwiye ati: “Subira muri Egiputa, kuko abagomba kukwica bose bapfuye.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.19",
            "verseOrgIds": [
              "EXO.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose afata umugore n’abana biwe, aburiza indogoba, afata urugendo ruja muri Egiputa, kandi agenda yitwaje na ya nkoni y’Imana mu minwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.20",
            "verseOrgIds": [
              "EXO.4.20"
            ]
          }
        }
      ]
    },
