              "EXO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
