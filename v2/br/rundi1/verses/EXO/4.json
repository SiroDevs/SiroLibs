          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        },
        {
          "text": " yongera kumubwira ati: “Gusubize mu gikiriza cawe.” Mose agusubizayo, agukuyeyo asanga kwakize, kumeze neza co kimwe n’ahandi hose ku mubiri wiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.7",
            "verseOrgIds": [
              "EXO.4.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
