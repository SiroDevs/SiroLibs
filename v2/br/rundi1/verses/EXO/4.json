        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        },
        {
          "text": " aca amubaza ati: “Ico ufise mu minwe ni igiki?” Na we arishura ati: “Ni inkoni.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.2",
            "verseOrgIds": [
              "EXO.4.2"
            ]
          }
        }
