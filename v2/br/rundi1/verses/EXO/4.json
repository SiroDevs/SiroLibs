          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiri ku rugendo aja muri Egiputa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "text": " asanga Mose aho yari yasavye indaro n’umuryango wiwe, agomba kumwica. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.24",
            "verseOrgIds": [
              "EXO.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umugore wiwe Zipora aca afata ibuye rikarishe, akeba umubiri upfutse kw’isonga ry’igitsina c’umuhungu wiwe, aca agikoza ku maguru ya Mose, avuga ati: “Ni ivy’ukuri uri umugabo wanje w’amaraso.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.25",
            "verseOrgIds": [
              "EXO.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " aca aramureka. (Aho yavuga ngo: “Uri umugabo wanje w’amaraso,” yari afatiye ku gukebwa.)",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.26",
            "verseOrgIds": [
              "EXO.4.26"
            ]
          }
        }
