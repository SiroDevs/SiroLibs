        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        },
        {
          "text": " aramubwira ati: “Yiterere hasi.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.3",
            "verseOrgIds": [
              "EXO.4.3"
            ]
          }
        }
