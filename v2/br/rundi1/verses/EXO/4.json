              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni ababwira ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.30",
            "verseOrgIds": [
              "EXO.4.30"
            ]
          }
        },
