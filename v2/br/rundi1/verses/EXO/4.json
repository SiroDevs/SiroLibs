          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aca asubira kwa sebukwe Yetiro, aramubarira ati: “Ndekura ngende kuraba ab’ubwoko bwacu muri Egiputa, ndabe ko boba bakiriho.” Yetiro aramwishura ati: “Genda amahoro.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.4.18",
            "verseOrgIds": [
              "EXO.4.18"
            ]
          }
        }
