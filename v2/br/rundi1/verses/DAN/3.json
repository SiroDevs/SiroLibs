              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma umwami aha icubahiro gikomeye mu kazi kabo Shadarake, Meshake, na Abedinego, mu ntara ya Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.30",
