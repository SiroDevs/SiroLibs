          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.23",
            "verseOrgIds": [
              "DAN.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Daniyeli aca aja kuraba Ariyoki, uwo umwami yari yatumye kwica ba kamenyi b’i Babiloni. Aramubwira ati: “Ntiwice ba kamenyi b’i Babiloni, njana iyo umwami ari ndamumenyeshe ico indoto yiwe isigura.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.24",
            "verseOrgIds": [
              "DAN.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.24",
            "verseOrgIds": [
              "DAN.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariyoki aca ajana Daniyeli iyo umwami ari yihuta, abwira umwami ati: “Naronse umwe mu banyagano b’Abayuda ashobora kukumenyesha ico indoto warose isigura.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.2.25",
            "verseOrgIds": [
              "DAN.2.25"
            ]
          }
        }
      ]
    },
