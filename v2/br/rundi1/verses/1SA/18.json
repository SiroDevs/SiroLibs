              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli aca arushaho gutinya Dawidi, hanyuma aca amugira umwansi wiwe mu misi yose yari ashigaje kubaho.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.29",
