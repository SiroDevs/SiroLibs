              "1SA.18.28"
            ]
          }
        },
        {
          "text": " ari kumwe na Dawidi, kandi ko umukobwa wiwe Mikali amukunda, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.28",
            "verseOrgIds": [
              "1SA.18.28"
            ]
          }
        },
