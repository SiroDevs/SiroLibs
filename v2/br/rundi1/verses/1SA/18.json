              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bakozi bamaze kubwira Dawidi ivyo vyose, aca aremera kuba umukwe w’umwami. Nuko imbere y’uko igihe yahawe gihera, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.26",
            "verseOrgIds": [
              "1SA.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi n’abantu biwe baragenda bica Abafilisitiya amajana abiri. Aca azana igitigiri gikwiye ca twa dukoba tw’Abafilisitiya abiha umwami kugira ngo ashobore kuba umukwe w’umwami. Maze Sawuli aca amushingira umukobwa wiwe Mikali.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.27",
            "verseOrgIds": [
              "1SA.18.27"
            ]
          }
        }
