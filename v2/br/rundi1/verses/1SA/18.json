          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli arishura ati: “Mubwire Dawidi muti: ‘Umwami ntashaka inkwano n’imwe yindi atari udukoba tw’ibitsina gabo vy’Abafilisitiya ijana, kugira ngo yihore abansi biwe.’ ” Mu mugambi wa Sawuli kwari ukugira ngo Dawidi ahitanwe n’Abafilisitiya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.25",
            "verseOrgIds": [
              "1SA.18.25"
            ]
          }
        }
