        },
        {
          "text": "Ba bishikira ba Sawuli bamubwiye ivyo Dawidi yavuze, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.18.24",
            "verseOrgIds": [
              "1SA.18.24"
