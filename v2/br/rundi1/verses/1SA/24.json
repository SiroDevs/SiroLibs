  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "1SA 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli avuye kugwanya Abafilisitiya, bamubwira bati: “Dawidi ari mu bugaragwa bw’i Eni-Gedi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.1",
            "verseOrgIds": [
              "1SA.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko atoranya abasoda b’indobanurwa ibihumbi bitatu bavuye mu Bisirayeli baja kurondera Dawidi n’abantu biwe i ruhande y’ibitandara vy’impene z’inyeshamba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.2",
            "verseOrgIds": [
              "1SA.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.2",
            "verseOrgIds": [
              "1SA.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashitse ku mpongore z’intama zari i ruhande y’inzira; hari isenga, Sawuli aja kwihagarika muri ryo. Kandi Dawidi n’abantu biwe bari muri ryo imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.3",
            "verseOrgIds": [
              "1SA.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bantu baravuga bati: “Uwu ni wa musi ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.4",
            "verseOrgIds": [
              "1SA.24.4"
            ]
          }
        },
        {
          "text": " yavuga, igihe yakubwira ngo: ‘Nzogabura umwansi wawe mu maboko yawe ngo umugenze uko ushaka.’ ” Nuko Dawidi arasoboka aca ipfundo ry’ikanzu ya Sawuli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.4",
            "verseOrgIds": [
              "1SA.24.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.4",
            "verseOrgIds": [
              "1SA.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Dawidi yumva umutima umurega kuko yacacuye ipfundo ry’ikanzu yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.5",
            "verseOrgIds": [
              "1SA.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwira abantu biwe ati: “",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "text": " andinde gukora ikintu nk’ico kuri databuja, uwo ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "text": " yimikishije amavuta, canke ngo ndamuramvurireko ukuboko; kuko ari uwasizwe amavuta n’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "text": ".” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.6",
            "verseOrgIds": [
              "1SA.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuze ivyo aca abuza abantu biwe kugirira nabi Sawuli. Maze Sawuli ava muri rya senga aragenda.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.7",
            "verseOrgIds": [
              "1SA.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi arasohoka ava muri rya senga ahamagara Sawuli ati: “Nyakwubahwa mwami wanje!” Sawuli akebutse, Dawidi arunama ashikana umutwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.8",
            "verseOrgIds": [
              "1SA.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwira Sawuli ati: “Ni kuki wumva ivyo abantu bakubwira ngo: ‘Dawidi arondera kukugirira nabi’? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.9",
            "verseOrgIds": [
              "1SA.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwawe uriboneye uwu musi ko ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.10",
            "verseOrgIds": [
              "1SA.24.10"
            ]
          }
        },
        {
          "text": " yari yakugabuye mu maboko yanje muri rirya senga. Hari abampanuye kukwica, ariko nakwirekeye; navuze nti: ‘sinzobangurira ukuboko databuja, kuko yasizwe amavuta n’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.10",
            "verseOrgIds": [
              "1SA.24.10"
            ]
          }
        },
        {
          "text": ".’ ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.10",
            "verseOrgIds": [
              "1SA.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raba, muvyeyi wanje, ehe iri pfundo ry’ikanzu yawe mu kuboko kwanje! Nacacuye ipfundo ry’impuzu yawe ariko sinakwishe. Ubu rero tahura kandi umenye ko ata kimenyetso c’uko noba narakugiriye nabi canke nkakugarariza. Nta kibi nagukoreye, ariko uriko urampiga ngo unyice. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.11",
            "verseOrgIds": [
              "1SA.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " naducire urubanza. Kandi ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.12",
            "verseOrgIds": [
              "1SA.24.12"
            ]
          }
        },
        {
          "text": " ampore ku bibi vyose wankoreye, ariko jewe sinzogukozako ukuboko kwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.12",
            "verseOrgIds": [
              "1SA.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uko baca umugani ngo: ‘Mu munyakibi havamwo ibikorwa bibi,’ ni co gituma ntazogukozako ukuboko kwanje.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.13",
            "verseOrgIds": [
              "1SA.24.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.13",
            "verseOrgIds": [
              "1SA.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega umwami w’Abisirayeli yasohotse guhiga nde? Uriko urakurikira nde? Imbwa ipfuye? Imbaragasa? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.14",
            "verseOrgIds": [
              "1SA.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " naducire urubanza. Arabe iconkiza akinkorere; amburanire mu kunkura mu kuboko kwawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi ahejeje kuvuga ivyo Sawuli arabaza ati: “Ni wewe, ga mwana wanje Dawidi?” Araboroga cane. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.16",
            "verseOrgIds": [
              "1SA.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravuga ati: “Urandushije kugororoka. Wangiriye neza, jewe nakugiriye nabi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.17",
            "verseOrgIds": [
              "1SA.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhejeje kumbwira ivyiza wankoreye; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
        {
          "text": " yari yangabuye mu maboko yawe, ariko ntiwanyishe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega umuntu afashe umwansi wiwe yomurekura atamugiriye nabi? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
        {
          "text": " aguhembere ivyo ungiriye uwu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndazi ko utazogenda utabaye umwami kandi ko ubwami bw’Abisirayeli buzokomezwa n’amaboko yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu rero ndahira mw’izina ry’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        },
        {
          "text": " ko utazohonya uruvyaro rwanje canke ngo ufute izina ryanje mu muryango wa data.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.21",
            "verseOrgIds": [
              "1SA.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi arahira Sawuli. Maze Sawuli asubira iwe, ariko Dawidi n’abantu biwe baduga kwinyegeza mu misozi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.22",
            "verseOrgIds": [
              "1SA.24.22"
            ]
          }
        }
      ]
    }
  ],
