            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Yosuwa yari yagumye adugije icumu ryiwe gushika ababa i Hayi bose baranduwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.26",
            "verseOrgIds": [
              "JOS.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli basahura ibintu vyo muri ico gisagara, barabitwara nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.27",
            "verseOrgIds": [
              "JOS.8.27"
            ]
          }
        },
        {
          "text": " yari yabibariye Yosuwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.27",
            "verseOrgIds": [
              "JOS.8.27"
            ]
          }
        }
