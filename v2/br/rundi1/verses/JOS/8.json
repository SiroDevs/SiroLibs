              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo, Yosuwa asoma amajambo yose yanditswe mu gitabu c’ivyagezwe, asoma imigisha n’imivumo yose nk’uko yanditswe muri ico gitabu c’ivyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta jambo na rimwe Mose yategetse Yosuwa atasomeye ishengero ryose ry’Abisirayeli, harimwo n’abagore n’abana, n’abanyamahanga baba muri bo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
        }
