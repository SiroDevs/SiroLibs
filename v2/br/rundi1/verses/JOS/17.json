          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruvyaro rwa Yosefu rubwira Yosuwa ruti: “Ni kubera iki waduhaye intara imwe nk’iragi turi benshi, kandi ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "text": " yaraduhezagiye cane?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa arabishura ati: “Nimba muri benshi, kandi intara y’imisozi miremire ya Efurayimu ikaba itabakwiye, nimuduge mu kibira mwiyagurire amatongo mu gihugu c’Abaperizi n’Abarefayimu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruvyaro rwa Yosefu rumwishura ruti: “Igihugu c’imisozi ntikidukwiye kandi Abanyakanani baba mu kiyaya bafise imikogote y’ivyuma, co kimwe n’ababa i Beti-Shani n’abahakikuje hamwe n’abo mu kiyaya c’i Yezireyeli.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
