          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.16",
            "verseOrgIds": [
              "JOS.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yosuwa abwira imiryango ya Yosefu ari bo Manase na Efurayimu ati: “Muri benshi kandi murakomeye. Ntimuzoronka intara imwe gusa ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.17",
            "verseOrgIds": [
              "JOS.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo muzohabwa n’ikibira kiri mu misozi miremire na co nyene. Genda mugitunganye imbibe muzishikane kure aho mushaka, hazoba ahanyu. Naho Abanyakanani bafise imikogote y’ivyuma kandi bakaba bakomeye, muzobirukana.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.18",
            "verseOrgIds": [
              "JOS.17.18"
            ]
          }
        }
      ]
