              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uruvyaro rwa Manase ntirwashoboye gufata ivyo bisagara, kuko Abanyakanani bagumye bahaba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Abisirayeli bamaze kugwira bagakomera, baciye bagira Abanyakanani abagurano babo, ariko ntibabirukana bose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
