              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baca babikurayo babizanira Yosuwa n’Abisirayeli bose, na bo babisanza imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
