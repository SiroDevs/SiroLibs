              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abisirayeli bose baca bamwicisha amabuye, bamwicana n’umuryango wiwe wose, ibiziga vyabo baca barabiturira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
