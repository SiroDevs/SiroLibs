          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.15",
            "verseOrgIds": [
              "JOS.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye, hakiri kare mu gatondo, Yosuwa akoranya imiryango y’Abisirayeli, uwa Yuda uba ari wo ufatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.16",
            "verseOrgIds": [
              "JOS.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bwoko bwa Yuda hafatwa Abakomoka kuri Zera. Abakomoka kuri Zera bakoranye hafatwa abo mu muryango wa Zabudi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.17",
            "verseOrgIds": [
              "JOS.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa ahamagaza umugabo ku mugabo, hanyuma hafatwa Akani mwene Karumi, Karumi mwene Zabudi, Zabudi mwene Zera, Zera wo mu muryango wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.18",
            "verseOrgIds": [
              "JOS.7.18"
            ]
          }
        }
      ]
    },
