            },
            {
              "text": "Ni nk’ibilo 2,3.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza, mbona n’ikigegene c’inzahabu gipima shekeli mirongo itanu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
            "verseOrgIds": [
