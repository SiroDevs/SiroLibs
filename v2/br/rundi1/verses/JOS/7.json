          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa abwira Akani ati: “Mwana wanje, nuhe ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        },
        {
          "text": " icubahiro, Imana ya Isirayeli, uyishire hejuru. Mbwira ico wakoze kandi ntumpishe.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.19",
            "verseOrgIds": [
              "JOS.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akani yishura Yosuwa ati: “Ni ivy’ukuri naracumuye k’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.20",
            "verseOrgIds": [
              "JOS.7.20"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli. ",
          "type": "text",
          "attrs": {
