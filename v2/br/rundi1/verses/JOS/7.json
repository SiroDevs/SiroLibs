          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akani baca bamurundako ikirundo kinini c’amabuye, kandi kiracariho gushika n’ubu. Ni co gituma ico kiyaya baciye bacita Akabande ka Akori [bisigura akabande k’ivyago] kandi ni ko kacitwa gushika n’ubu. Maze uburake bw’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
          }
        },
        {
          "text": " buca burahwama. Gushika n’uno musi aho hantu hitwa Akabande ka Akori.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.26",
            "verseOrgIds": [
              "JOS.7.26"
            ]
