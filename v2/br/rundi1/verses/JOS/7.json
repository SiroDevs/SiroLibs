            }
          ]
        },
        {
          "text": "Mu vyo twari twanyaze nabonyemwo ikanzu nziza iva i Babiloni, na shekeli amajana abiri",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.21",
