              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosuwa n’Abisirayeli bose bafata Akani mwene Zera, bafata za feza, ya kanzu, za nzahabu, abahungu biwe n’abakobwa biwe, inka, indogoba n’intama ziwe, ihema ryiwe, babajana mu kiyaya ca Akori. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.24",
            "verseOrgIds": [
              "JOS.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa amubwira ati: “Ni iki catumye udukwegera aya magorwa? Uyu musi ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        },
        {
          "text": " arayaguteye nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.25",
            "verseOrgIds": [
              "JOS.7.25"
            ]
          }
        }
      ]
    },
