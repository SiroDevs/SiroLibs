          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yegereje i Betifage n’i Betaniya ku Musozi wa Elayono, atuma babiri mu bigishwa biwe, ababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.29",
