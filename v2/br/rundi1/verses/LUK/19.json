          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakiriko barayizitura, nyeneyo arababaza ati: “Ni kuki muzitura iyo ndogoba?”",
          "type": "text",
          "attrs": {
