              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baravugana hagati yabo bati: “Nitwavuga tuti: ‘Wavuye mw’ijuru,’ aca atubaza ati: ‘None ni kuki mutizeye ivyo Yohana yavuze?’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.5",
            "verseOrgIds": [
              "LUK.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitwavuga tuti: ‘Ni ku bantu,’ abantu bose baradutera amabuye kuko bemera ata gukekeranya ko Yohana yari uwuvugishwa n’Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.6",
            "verseOrgIds": [
              "LUK.20.6"
            ]
          }
        }
      ]
    },
