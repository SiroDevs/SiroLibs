            "sid": "LUK 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe Yesu yariko arigisha abantu mu rusengero, ababwira Ubutumwa Bwiza. Maze abaherezi bakurubakuru, abigisha b’ivyagezwe n’abakuru b’Abayuda baza aho ari. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.1",
            "verseOrgIds": [
              "LUK.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramubaza bati: “Ni ubuhe bubasha butuma ukora ivyo? Ni nde yabuguhaye?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.2",
            "verseOrgIds": [
              "LUK.20.2"
            ]
          }
        }
      ]
    },
