              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bavyumvise, baca bavuga bati: “Ikintu kibi nk’ico ntikikabe!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.16",
