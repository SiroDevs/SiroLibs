              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe Yesu yirukanye umudayimoni yari yateye umuntu kuba ikiragi. Amuvuyemwo, wa muntu aca aravuga, maze abantu baratangara cane. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.14",
            "verseOrgIds": [
              "LUK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bamwe muri bo bavuga bati: “Ni Beyelizebuli, umukuru w’abadayimoni amushoboza kwirukana abadayimoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.15",
            "verseOrgIds": [
              "LUK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi na bo bagerageza kugeza Yesu mu kumusaba ikimenyetso kivuye mw’ijuru.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.11.16",
            "verseOrgIds": [
              "LUK.11.16"
            ]
          }
        }
