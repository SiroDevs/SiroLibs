          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.20",
            "verseOrgIds": [
              "DEU.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira ico musezeranira ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "text": " Imana yanyu, ntimuzotevye kugishitsa, kuko mwobiharurwako nk’icaha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.21",
            "verseOrgIds": [
              "DEU.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 23:22"
          },
          "items": [
