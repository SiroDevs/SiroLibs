          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba bagabo uko ari batatu bahagarika kwishura Yobu, kuko we ubwiwe yabona ko ari umugororotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.1",
            "verseOrgIds": [
              "JOB.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Elihu mwene Barakeli w’i Buzi mu muryango w’Abaramu akarira Yobu cane kuko yari yanse kwemera ko yakoze ivyaha, kandi ntiyemera ko Imana itamurenganije mu kumuhana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.2",
            "verseOrgIds": [
              "JOB.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera akarira bagenziwe batatu kuko bananiwe no gutsinda Yobu ariko bakagiriza ikibi Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.3",
            "verseOrgIds": [
              "JOB.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elihu yari yabanje kureka bagenziwe baravuga, kuko bamusumba mu myaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.4",
            "verseOrgIds": [
              "JOB.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abonye amajambo yabaheranye, uburake bwiwe buraziriringa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.32.5",
            "verseOrgIds": [
              "JOB.32.5"
            ]
          }
        }
      ]
    },
