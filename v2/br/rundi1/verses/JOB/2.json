          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwundi musi abana b’Imana baje gukoranira imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "text": ", na Satani na we azanana na bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " abaza Satani ati: “Uvuye hehe?” Satani yishura ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        },
        {
          "text": " ati: “Mvuye kugendagenda kw’isi nihweza ibihabera.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        },
        {
          "text": " aramubaza ati: “Wabonye umusavyi wanje Yobu? Nta muntu n’umwe ameze nka we kw’isi. Ntagira umugayo kandi ni umugororotsi; ni umuntu yubaha Imana akanka ikibi cose. Yagumanye ubwizigirwa, naho watumye ndamumarirako ivyiwe vyose ata mvo.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
