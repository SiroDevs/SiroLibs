              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aca atanga itegeko ati: “Fata uwo mwana muzima mumucemwo ibihimba bibiri, kimwe mugihe umwe, ikindi mugihe uwundi.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
