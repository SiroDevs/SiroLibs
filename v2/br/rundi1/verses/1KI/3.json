              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aca abandanya avuga ati: “Nimunzanira inkota.” Nuko barayimuzanira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
