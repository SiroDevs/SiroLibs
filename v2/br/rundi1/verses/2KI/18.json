          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Eliyakimu mwene Hilukiya uwari ajejwe ikirimba, na Shebuna umunyamabanga, hamwe na Yowa mwene Asafu umwanditsi, basubira kwa Hezekiya, bitaburiyeko impuzu, bamubwira ivyo wa mukuru w’ingabo yavuze vyose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
