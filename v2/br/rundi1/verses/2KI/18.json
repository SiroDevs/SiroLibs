          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Umukuru w’ingabo za Ashuri ababwira ati: “Mubwire Hezekiya muti:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Eliyakimu mwene Hilukiya na Shebuna na Yowa babwira uwo mukuru bati: “Turakwinginze twebwe abasavyi bawe utubwire mu Carameya, kuko tucumva. Ntubandanye uvuga mu Giheburayo abantu bose bari ku ruzitiro bavyumva.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        }
      ]
    },
