          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya yongera yomorora inzahabu zari ku miryango no ku bishimaryango vy’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        },
        {
          "text": ", aziha umwami wa Ashuri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho vyabaye gutyo, umwami w’i Ashuri aca arungika kizigenza mu ntwaramiheto, umukuru w’ingabo, n’umukuru w’ikambi, bava i Lakishi bajana n’ingabo nyinshi cane, bagiye gusugereza umwami Hezekiya i Yerusalemu. Bashitseyo, bahagarara ku mugende utwara amazi ku rugomero rwo haruguru, kw’ibarabara rija kw’Itongo ry’Umumesuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baca batumako umwami, ariko umwami arungika Eliyakimu mwene Hilukiya umukuru w’ikirimba, na Shebuna umunyamabanga w’umwami, na Yowa mwene Asafu umwanditsi, baba ari bo baja guhura na bo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
