  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "21",
        "style": "c",
        "sid": "2KI 21"
      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase yabaye umwami afise imyaka cumi n’ibiri, aganza imyaka mirongo itanu n’itanu ari i Yerusalemu. Nyina wiwe yitwa Hefiziba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe, agendera mu bizira vy’ubuyobe vyakorwa n’amahanga ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "text": " yari yarirukanye imbere y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asubira kwubaka ibibanza vyo gusengeramwo vyo ku misozi, ivyo se Hezekiya yari yarasanganguye; yongera kwubaka ibicaniro vya Bayali n’inkingi ya Ashera, nk’uko Ahabu umwami wa Isirayeli yari yarakoze. Yunamira ibinyenyeri vyose vyo kw’ijuru, arabisenga. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yubaka ibicaniro mu Ngoro y’Uhoraho, iyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "text": " yari yaravuzeko ati: “I Yerusalemu nzohashira izina ryanje.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu rugo rwose rw’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "text": " ahubaka ibicaniro vy’ibinyenyeri vyose vyo kw’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agera n’aho atanga umuhungu wiwe kw’ikimazi co guturirwa, agendera mu bupfumu n’amareba, ahanuza abahamagara imizimu hamwe na ba kamenyi. Akora ibibi vyinshi mu nyonga z’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        },
        {
          "text": ", bituma amuratsa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afata inkingi ya Ashera yabazishije, ayishira mu Ngoro, imwe ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "text": " yari yabwiye Dawidi n’umuhungu wiwe Salomo ati: “Muri iyi Ngoro, n’i Yerusalemu, ni ho natoranije mu yindi miryango yose ya Isirayeli, ngo hitirirwe izina ryanje ibihe vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sinzosubira gutuma Abisirayeli bayerera ngo bave mu gihugu nahaye ba sekuruza babo nibagendera mu vyo nabategetse vyose, bagakurikiza Ivyagezwe vyose umusavyi wanje Mose yabahaye.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abantu ntibayumviye. Manase yarabazimije, atuma bava mu nzira z’Uhoraho, bakora ibibi birengeye ivy’amahanga ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        },
        {
          "text": " yari yarahonereje imbere y’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "text": " avugisha abasavyi biwe b’abavugishwa, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati: “Manase, umwami w’i Buyuda, yakoze ivyaha birenze urugero. Yakoze ibibi bisumba ivy’Abamori baba mu gihugu imbere y’Abisirayeli, akwegera Abayuda mu vyaha vyo gusenga ibigirwamana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli, avuze ati: Nzotera amakuba Yerusalemu n’i Buyuda hose, gushika aho abazovyumva bose bazojorerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Yerusalemu nzohacira urubanza nk’urwo naciriye Samariya, ndahagerere no ku ngero nagereyeko umuryango wa Ahabu. Nzohanagura ababa i Yerusalemu nk’uwuhanagura isahani hanyuma akayubika. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.13",
            "verseOrgIds": [
              "2KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokwanka amasigarira y’ubwoko bwanje, ndabarekurire mu maboko y’abansi babo. Bazotwarwa ari inyagano ku bansi babo, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
              "2KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bakoze ibizira mu nyonga zanje, bantera kubarakarira uhereye igihe nabakura muri Egiputa gushika n’uwu musi.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigeretseko, Manase yasheshe amaraso y’abantu benshi ata co bazira, yuzura igisagara ca Yerusalemu uhereye iyo kiva kikagera. Ivyo vyiyongera ku vyaha yakwegeyemwo Abayuda, bakora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Manase n’ivyo yakoze vyose, harimwo n’ivyaha vyiwe, mbega ntivyanditswe mu gitabu c’ivyabaye ku ngoma z’abami b’i Buyuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haheze igihe, Manase ahamvya ba sekuruza, ahambwa mw’itongo ryo ku kirimba iwe, mw’itongo ryitwa irya Uza. Umuhungu wiwe yitwa Amoni aca aba ari we amusubirira ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni yari afise imyaka mirongo ibiri n’ibiri igihe yimikwa ngo abe umwami, aca aganza imyaka ibiri ari i Yerusalemu. Nyina wiwe yitwa Meshulemeti umukobwa wa Haruzi w’i Yotiba. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe, nk’uko se Manase yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yagendeye mu ngeso zose za se; yasenze ibigirwamana se yasenga, akama yikubita imbere yavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
              "2KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ava k’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        },
        {
          "text": " Imana ya ba sekuruza, ntiyigera agendera mu nzira z’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        },
        {
          "text": " na gatoya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abaganwa ba Amoni baja inama yo kumwica, bamutsinda mu ngoro iwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
