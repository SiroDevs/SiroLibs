          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami wa Isirayeli ajana n’umwami w’i Buyuda hamwe n’uwa Edomu, maze bose bafata inzira izunguruka ubugaragwa, bamara imisi indwi bagenda, amazi batekeye arabaherana, babura ayo banywa n’ayo baha ibitungwa biri kumwe na bo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        }
      ]
