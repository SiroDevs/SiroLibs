          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe mu bakuru b’ingabo z’Umwami wa Isirayeli amwishura ati: “Elisa mwene Shafati ari ngaha. Yahora ari umukozi wa Eliya.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
