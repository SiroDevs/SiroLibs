            }
          ]
        },
        {
          "text": "Yehoshafati aravuga ati: “Uwo rero arafise ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        },
        {
          "text": ".” Nuko umwami wa Isirayeli na Yehoshafati n’umwami wa Edomu baca bamanuka kumurondera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
