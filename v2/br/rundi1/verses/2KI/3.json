            }
          ]
        },
        {
          "text": "Elisa aramubwira ati: “Ndakurahiye ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
        {
          "text": " Mushoboravyose, Imana nkorera, iyo ntasonera Yehoshafati umwami w’i Buyuda, sinari no kwirirwa ndakuraba canke ngo ndanakwiyumvire. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
