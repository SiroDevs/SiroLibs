            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami wa Isirayeli aravuga ati: “Karabaye! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        },
        {
          "text": " yadukoranije turi abami batatu kugira ngo aturekurire mu maboko y’umwami wa Mowabu!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        }
      ]
