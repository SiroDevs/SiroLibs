            }
          ]
        },
        {
          "text": "Elisa aca abaza umwami wa Isirayeli ati: “Mbega twe nawe hari ico duhuriyeko? Genda ubaze ba bavugishwa ba so n’aba nyoko.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.13",
            "verseOrgIds": [
