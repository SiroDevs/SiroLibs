              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yehoshafati arabaza ati: “Hano nta muvugishwa w’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "text": " n’umwe ahari kugira ngo atubarize ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "text": " ico twokora?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        }
      ]
