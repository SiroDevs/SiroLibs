          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.25",
            "verseOrgIds": [
              "2KI.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami wa Mowabu abonye ko agiye kuneshwa ku rugamba, aca ahitana abasoda amajana indwi bagwanisha inkota ngo arabe uko boca mu ngabo z’umwami wa Edomu, ariko birabananira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.26",
            "verseOrgIds": [
              "2KI.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aca afata umuhungu wiwe yomusubiriye ku ngoma, amutangako ikimazi co guturira, amuherereza ku ruzitiro hejuru. Abisirayeli baca basesemwa n’ico kintu kibi gutyo bavayo basubira mu gihugu cabo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.27",
            "verseOrgIds": [
              "2KI.3.27"
            ]
          }
        }
      ]
