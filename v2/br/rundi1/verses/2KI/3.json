        },
        {
          "text": "Umwami wa Isirayeli aramwishura ati: “Oya, ni kubera ko ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.13",
            "verseOrgIds": [
              "2KI.3.13"
            ]
          }
        },
        {
