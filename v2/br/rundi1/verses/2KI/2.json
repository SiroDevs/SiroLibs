          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya amwishura ati: “Unsavye ikintu kigoye, ariko niwabona ingene ntandukanywa nawe, uwo mugabane uraza kuwuronka. Ariko nutambona, nta wo uronka.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.10",
            "verseOrgIds": [
              "2KI.2.10"
            ]
          }
        }
      ]
