          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mirongo itanu bo muri wa mugwi w’abavugishwa barabakurikira, bihweza Eliya na Elisa bahagaze kure, babaraba aho bari bahagaze i ruhande y’uruzi Yorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.7",
            "verseOrgIds": [
              "2KI.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya yambura umutamana wiwe, arawuzingazinga, awukubita amazi y’urwo ruzi. Ubwo nyene ruca rwicamwo kabiri, amazi amwe ahagarara i buryo ayandi i bubamfu, abo bagabo baca bajabuka nk’abagendera kw’isi yumutse.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.8",
            "verseOrgIds": [
              "2KI.2.8"
            ]
          }
        }
