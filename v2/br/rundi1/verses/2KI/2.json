              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kujabuka, Eliya abarira Elisa ati: “Mbwira ico wipfuza ko ndagukorera imbere y’uko ntandukanywa nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
              "2KI.2.9"
            ]
          }
        }
      ]
