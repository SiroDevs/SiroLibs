          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa na we ati: “Mpa incuro zibiri umugabane w’impwemu yawe.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.2.9",
            "verseOrgIds": [
