          "attrs": {
            "verseId": "2KI.19.17",
            "verseOrgIds": [
              "2KI.19.17"
            ]
          }
        },
        {
          "text": " we, ni ivy’ukuri ko abami b’i Ashuri batikije ayo mahanga yose n’ibihugu vyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.17",
            "verseOrgIds": [
              "2KI.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bataye imana zabo mu muriro barazitikiza, kuko zitari Imana, vyari ibiti n’amabuye, vyakozwe n’amaboko y’abana b’abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.18",
            "verseOrgIds": [
              "2KI.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.19",
            "verseOrgIds": [
              "2KI.19.19"
            ]
          }
        },
        {
          "text": " Mana yacu, dukize udukure mu maboko yiwe, kugira ngo ubwami bwose bwo kw’isi buzomenye ko wewe wenyene, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.19",
            "verseOrgIds": [
              "2KI.19.19"
            ]
          }
        },
        {
          "text": ", ari wewe Mana.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.19",
            "verseOrgIds": [
              "2KI.19.19"
            ]
          }
        }
      ]
    },
