          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.13",
            "verseOrgIds": [
              "2KI.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya yakira ikete ahawe n’intumwa ararisoma, aca aduga mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.14",
            "verseOrgIds": [
              "2KI.19.14"
            ]
          }
        },
        {
          "text": ", arizingururira imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.14",
            "verseOrgIds": [
              "2KI.19.14"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.14",
            "verseOrgIds": [
              "2KI.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asenga ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.15",
            "verseOrgIds": [
              "2KI.19.15"
            ]
          }
        },
        {
          "text": " avuga ati: “",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.15",
            "verseOrgIds": [
              "2KI.19.15"
            ]
          }
        },
        {
          "text": " Mana ya Isirayeli, wewe wicaye ku ntebe y’inganji hagati y’abakerubi, ni wewe Mana wenyene mu bwami bwose bwo kw’isi. Ni wewe waremye ijuru n’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.15",
            "verseOrgIds": [
              "2KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tega ugutwi Mana yanje, wumve. Utereze inyonga zawe urabe, ewe ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.16",
            "verseOrgIds": [
              "2KI.19.16"
            ]
          }
        },
        {
          "text": "; wumve amajambo Senakeribu yarungitse yo gucokora Imana nzima.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.16",
            "verseOrgIds": [
              "2KI.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
