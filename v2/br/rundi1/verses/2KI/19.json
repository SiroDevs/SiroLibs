          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya mwene Amozi arungikira ubutumwa Hezekiya avuga ati: “Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.20",
            "verseOrgIds": [
              "2KI.19.20"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli avuze: Numvise ugusenga kwawe ku vyerekeye Senakeribu umwami w’i Ashuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.20",
            "verseOrgIds": [
              "2KI.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni yo majambo Uhoraho amurungikiye:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.21",
            "verseOrgIds": [
              "2KI.19.21"
            ]
          }
        }
      ]
    },
