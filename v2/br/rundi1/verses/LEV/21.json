          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.16",
            "verseOrgIds": [
              "LEV.21.16"
            ]
          }
        },
        {
          "text": " abwira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.16",
            "verseOrgIds": [
              "LEV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Aroni uti: ‘Uko urunganwe ruzokurikirana n’urundi, ntihaze hagire uwo mu ruvyaro rwawe afise agasembwa azokwegera ngo ahereze imfungurwa z’Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.17",
            "verseOrgIds": [
              "LEV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire uwufise agasembwa yegera ngo abikore, ari impumyi canke ikimuga, afise agasembwa mu maso, canke afise ubumuga bundi; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.18",
            "verseOrgIds": [
              "LEV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "amugaye ikirenge canke ikiganza, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.19",
            "verseOrgIds": [
              "LEV.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwufise inyonzo canke ari impfunya, uwupfuye ijisho, uwugwaye uruhere, canke ibisebe biva amazi, canke uwamenetse amatengatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.20",
            "verseOrgIds": [
              "LEV.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire uwukomoka kuri Aroni umuherezi afise agasembwa azokwegera kugira ngo ashikane ishikanwa rituririrwa ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
          "text": ". Uwufise agasembwa ntaze yegere guhereza imfungurwa z’Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.21",
            "verseOrgIds": [
              "LEV.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashobora kurya kuri za mfungurwa zera z’Imana yiwe, no ku zera zose; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.22",
            "verseOrgIds": [
              "LEV.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko kubera ubumuga bwiwe, ntaze yegere ca gihuzu gikingira ahera cane canke ngo yegere igicaniro, kuko yohava ahumanya ahera hanje. Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        },
        {
          "text": " kandi ni jewe ndabeza.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.23",
            "verseOrgIds": [
              "LEV.21.23"
            ]
          }
        }
      ]
    },
