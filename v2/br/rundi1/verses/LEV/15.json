          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze murinde Abisirayeli ibintu vyose vyobahumanya, kugira ngo ntibapfe bazize ubwo buhumane kuko bohava bahumanya inzu yanje yera iri hagati muri bo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        }
      ]
