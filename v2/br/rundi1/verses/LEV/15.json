          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo vyagezwe bigenga ibiva mu bihimba vy’irondoka, yaba umugabo yahumanijwe n’uko yasohoye imbuto ziwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "yaba umugore ari mu kwezi kwiwe, yaba umugabo canke umugore bagwaye mu bihimba vy’irondoka, bigatuma bava ibintu bibahumanya, canke umugabo yaryamanye n’umugore asanzwe ahumanye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.33",
            "verseOrgIds": [
              "LEV.15.33"
            ]
