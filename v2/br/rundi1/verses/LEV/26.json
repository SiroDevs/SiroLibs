          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo vyashinzwe, vyagezwe n’amabwirizwa, ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        },
        {
          "text": " yashingiye ku musozi Sinayi, hagati yiwe n’Abisirayeli abicishije kuri Mose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
      ]
