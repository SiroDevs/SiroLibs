        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mukore ibigirwamana canke ngo mwishingire ibishushanyo canke inkingi z’amabuye, kandi ntimuze mushinge ivyabajwe mu mabuye mu gihugu ngo muvyunamire. Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "text": " Imana yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mwitondere amasabato yanje kandi mwubahe ahera hanje. Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.2",
            "verseOrgIds": [
              "LEV.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwitondera ivyo nashinze, mugashira umutima ku kwitondera amabwirizwa yanje, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.3",
            "verseOrgIds": [
              "LEV.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nzobarungikira imvura mu gihe cayo, kandi isi izokwera ivyimburwa vyayo n’ibiti vyame ivyamwa vyavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.4",
            "verseOrgIds": [
              "LEV.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyimbura ryanyu ry’ingano rizogeza kw’iyimbura ry’inzabibu, n’iyimbura ry’inzabibu rishike mw’ibiba, kandi muzorya ivyo mugomba mube amahoro mu gihugu canyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.5",
            "verseOrgIds": [
              "LEV.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobaha amahoro mu gihugu, kandi muzokwiryamira ata kintu kibaca ivutu. Nzokura ibikoko vyo mw’ishamba mu gihugu, kandi nta nkota izoca mu gihugu canyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.6",
            "verseOrgIds": [
              "LEV.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzokinagiza abansi banyu, kandi bazokwicwa n’inkota imbere yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.7",
            "verseOrgIds": [
              "LEV.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batanu bo muri mwebwe bazokinagiza ijana, n’ijana bo muri mwebwe bakinagize ibihumbi icumi, kandi abansi banyu muzobamarisha inkota.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.8",
            "verseOrgIds": [
              "LEV.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobarabisha ijisho ry’urukundo kandi nzobaha kurondoka mugwire, ngumizeho isezerano nasezeranye namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.9",
            "verseOrgIds": [
              "LEV.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzoba mukirya ivyo mwimbuye umwaka uheze, hanyuma murondere ingene mubisohora kugira ngo muronke aho mwimburira ivyeze. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.10",
            "verseOrgIds": [
              "LEV.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoshinga ihema ryanje hagati muri mwebwe, kandi sinzobaheba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.11",
            "verseOrgIds": [
              "LEV.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzogendera hagati yanyu, mbe Imana yanyu namwe mube abantu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.12",
            "verseOrgIds": [
              "LEV.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "text": " Imana yanyu, nabakuye muri Egiputa kugira ngo muve mu buja bw’Abanyegiputa. Navunaguye ivyuma vy’ingogo vyanyu ndabaha kugenda mwemye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.13",
            "verseOrgIds": [
              "LEV.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nimutanyumvira ngo mwitondere aya mabwirizwa yose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.14",
            "verseOrgIds": [
              "LEV.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze mugashiburira kure ivyo nashinze vyose mugakengera ivyagezwe vyanje mukananirwa no kwitondera amabwirizwa yanje yose, mukongera mukava mw’isezerano ryanje, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.15",
            "verseOrgIds": [
              "LEV.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanje uku ni ko nzobagirira: nzobateza ibibaca ivutu, ingwara zidakira n’akaranda bitume muba impumyi bibamare inkomezi. Muzobibira ubusa, kuko abansi banyu ari bo bazobirya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.16",
            "verseOrgIds": [
              "LEV.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitsure canje kizoguma kuri mwebwe bitume mutsindwa n’abansi banyu; ababanka ni bo bazobaganza, kandi muzohunga ata wubirukanye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.17",
            "verseOrgIds": [
              "LEV.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo nibitatuma munyumvira, nzobahanira ivyaha vyanyu incuro indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.18",
            "verseOrgIds": [
              "LEV.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzovunagura ubwibone bwanyu ntume ijuru ribabera nk’icuma isi na yo ibabere nk’umuringa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.19",
            "verseOrgIds": [
              "LEV.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzoruhira ubusa, kuko igihugu kitazokwera ivyimburwa vyaco, canke ngo ibiti vyo mu gihugu canyu vyame ivyamwa vyavyo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.20",
            "verseOrgIds": [
              "LEV.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwashishikara kuba abansi banje mukanka kunyumvira, nzogwiza ivyago vyanyu incuro indwi ndabahora ivyaha vyanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.21",
            "verseOrgIds": [
              "LEV.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobarungikira ibikoko vyo mw’ishamba bibatere, bibatware abana banyu, bihonye n’amasho yanyu bitume muba inkehwa maze amayira yanyu asigare agaragara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.22",
            "verseOrgIds": [
              "LEV.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho nyene nimwanka kwemera ngo muhanurwe mugashishikara kuba abansi banje, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.23",
            "verseOrgIds": [
              "LEV.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanje nzohinduka umwansi wanyu ndabateze ivyago birushirije incuro indwi kubera ivyaha vyanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.24",
            "verseOrgIds": [
              "LEV.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoca ndabateza inkota ndabahoye ko mwavuye mw’isezerano ryanje. Nimwahungira mu bisagara vyanyu nzobateza ikiza kandi muzogwa mu maboko y’abansi banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.25",
            "verseOrgIds": [
              "LEV.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ninazibira aho mukura ivyokurya, abagore icumi bazoshobora gukarangira mu nkono imwe, kandi bazobagaburira ibipimwe, kandi naho muzobirya ntimuzohaga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.26",
            "verseOrgIds": [
              "LEV.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho nzoba nabagiriye gutyo, nimwashishikara kuja kure yanje, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.27",
            "verseOrgIds": [
              "LEV.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanje nzobarakira ndabaje kure, kandi jewe ubwanje nzobahanira ivyaha vyanyu incuro indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.28",
            "verseOrgIds": [
              "LEV.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzorya inyama z’abahungu banyu n’abakobwa banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.29",
            "verseOrgIds": [
              "LEV.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzosambura ibibanza vyanyu vyo gusengeramwo ku misozi, n’ibicaniro vy’ibimota neza vyanyu nzobisenyurira hasi, ngerekeranye imivyimba yanyu ku bigirwamana vyanyu bitagira ubugingo, ndabanke urunuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.30",
            "verseOrgIds": [
              "LEV.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisagara vyanyu nzobihindura imisaka, nsambure ingoro musengeramwo, kandi n’ibimota neza vy’amashikanwa yanyu bizoba igisesema kuri jewe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.31",
            "verseOrgIds": [
              "LEV.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe ubwanje nzosambura igihugu canyu, gushika aho abansi banyu bazokigereramwo bazotangara cane. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.32",
            "verseOrgIds": [
              "LEV.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobasanzariza mu mahanga nsokorore inkota yanje ndabakinagize. Igihugu canyu kizoba amatongo, kandi ibisagara vyanyu bizosigara ari imisaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.33",
            "verseOrgIds": [
              "LEV.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu kizonezererwa imyaka y’amasabato yaco igihe cose kizoba ari amatongo namwe muri mu gihugu c’abansi banyu; igihugu na co kizoruhuka amasabato yaco. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.34",
            "verseOrgIds": [
              "LEV.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gihe cose kizoba ari amatongo, kizoruhuka akaruhuko k’amasabato kitaruhutse igihe mwari mukiri muri co.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.35",
            "verseOrgIds": [
              "LEV.26.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 26:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzotuma abasigaye ari amasigarira baranduka imitima bari mu bihugu vy’abansi babo, ku buryo n’akababi kaguruwe n’umuyaga gatuma bahunga. Bazokwiruka nk’abahunga inkota, maze bagwe hasi, naho ata n’umwe azoba ariko arabakinagiza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.36",
            "verseOrgIds": [
              "LEV.26.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 26:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu azotsitara kuri mugenziwe nk’aho boba bariko barahunga inkota, naho ata n’umwe azoba ariko arabakinagiza. Uko ni ko mutazoshobora guhagarara imbere y’abansi banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.37",
            "verseOrgIds": [
              "LEV.26.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 26:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzohonera mu mahanga; igihugu c’abansi banyu kizobatsontsomera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.38",
            "verseOrgIds": [
              "LEV.26.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazosigara bazohonera mu gihugu c’abansi banyu ku bw’ivyaha vyabo n’ivya ba sekuruza babo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 26:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.39",
            "verseOrgIds": [
              "LEV.26.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 26:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nibatura ivyaha vyabo n’ivya ba sekuruza babo, ubuhemu bwabo n’urwanko banyanka jewe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.40",
            "verseOrgIds": [
              "LEV.26.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 26:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "rwatumye nanje ndabazinukwa bigatuma ndabirukanira mu gihugu c’abansi babo, maze imitima yabo y’intakebwa igacishwa bugufi bakishura ivyaha bakoze, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.41",
            "verseOrgIds": [
              "LEV.26.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 26:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "nzokwibuka isezerano nasezeranye na Yakobo n’iryo nasezeranye na Isaka n’iryo nasezeranye na Aburahamu, bitume nibuka igihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.42",
            "verseOrgIds": [
              "LEV.26.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 26:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko igihugu bazokivamwo na co kikanezererwa amasabato yaco igihe kizoba ari amatongo batakikibamwo. Bazokwishura ivyaha bakoze kuko bataye ivyagezwe vyanje bagatera ibitugu ivyo nihanikirije. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.43",
            "verseOrgIds": [
              "LEV.26.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 26:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko naho biri uko, igihe bazoba bari mu gihugu c’abansi babo, sinzobata canke ngo ndabahebe ngo bitume ndabaherengeteza rwose, ngo mve mw’isezerano nasezeranye na bo. Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "text": " Imana yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.44",
            "verseOrgIds": [
              "LEV.26.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 26:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ku bwabo nzokwibuka isezerano nasezeranye na ba sekuruza babo, abo nakuye mu gihugu ca Egiputa amahanga yose abibona, ngo mbe Imana yabo. Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        },
        {
          "text": ".’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.45",
            "verseOrgIds": [
              "LEV.26.45"
            ]
          }
        }
      ]
    },
