            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntihaze hagire n’umwe azotanga igikoko c’uburiza, kuko ivy’uburiza vyose bisanzwe ari ivy’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "text": "; yaba inka, canke intama, ni ivy’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nicaba ari kimwe mu bikoko bihumanye, ashobora kugitangira ikiguzi cashinzwe, akongerako ica gatanu caco. Natagicungura, kize kigurishwe ku giciro cashinzwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
    {
