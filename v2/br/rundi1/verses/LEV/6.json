        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "text": " yongera kubwira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iri rize ribe ishikanwa Aroni n’abahungu biwe bazoshikanira ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "text": " ku musi bazoba barobanujwe amavuta: ic’icumi c’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:20",
              "type": "text"
            },
            {
              "text": "Ni nk’ikilo 1,6.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu inoze neza itangwa nk’ishikanwa ry’ifu ryama ritangwa ku musi, igice caryo aze agitange mu gitondo ikindi gice ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uze uyivange n’amavuta ya elayo hanyuma uyikarange kw’ipano, hanyuma ubizane bivanze neza bishikanwe nk’ishikanwa ry’ifu riri mu tumanyu dutoduto, ribe ubumote bwiza bunezera ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhungu wiwe azomusubirira nk’umuherezi asizwe amavuta azobe ari we aritegura. Iryo ni ishikanwa rizokwamaho kandi ritegerezwa guturirwa ryose ntihagire igisigara. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishikanwa ry’ifu ritanzwe n’umuherezi rize riturirwe rihere; ntirize riribweko na gatoya.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
