        {
          "text": "‘Kuri uwo musi,’ ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze, ‘nzogutwara, wewe Zerubabeli umusavyi wanje mwene Sheyalutiyeli,’ ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.23",
            "verseOrgIds": [
              "HAG.2.23"
            ]
          }
        },
        {
          "text": " avuze, ‘maze ndakugire nk’impeta yo ku rutoke rwanje, kuko nagutoranije,’ ni ko ",
          "type": "text",
