          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "text": " riraza riciye kuri Hagayi ubugira kabiri ku musi ugira mirongo ibiri na kane w’uko kwezi nyene, riti: ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.20",
            "verseOrgIds": [
              "HAG.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "HAG 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Zerubabeli umukuru w’intara y’i Buyuda ko ngiye kunyiganyiza amajuru n’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.21",
            "verseOrgIds": [
              "HAG.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "HAG 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzotembagaza intebe z’ubwami nsangangure ubushobozi bw’amahanga. Nzotembagaza imikogote n’abayigenderako; amafarasi n’abayagenderako bizotemba, umwe wese yicwe n’inkota y’umuvukanyi wiwe.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.22",
            "verseOrgIds": [
              "HAG.2.22"
            ]
          }
        }
