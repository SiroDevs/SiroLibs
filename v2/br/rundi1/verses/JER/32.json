        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.12",
            "verseOrgIds": [
              "JER.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbwirira Baruki mu maso yabo nti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.13",
            "verseOrgIds": [
              "JER.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.14",
            "verseOrgIds": [
              "JER.32.14"
            ]
          }
        },
        {
          "text": " Mushoboravyose, Imana y’Abisirayeli, avuze: Akira aya makopi yompi, y’urwandiko rw’ubuguzi, iyiriko ikidodo n’iyitariko ikidodo, maze ubishire mu mubindi w’ibumba kugira ngo aze amare igihe kirekire.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.14",
            "verseOrgIds": [
              "JER.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko uku ari ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        },
        {
          "text": " Mushoboravyose, Imana y’Abisirayeli, avuze: ‘Amazu, amatongo n’imizabibu bizosubira kugurwa muri iki gihugu.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.15",
            "verseOrgIds": [
              "JER.32.15"
            ]
          }
        }
      ]
    },
    {
