            "verseId": "JER.32.16",
            "verseOrgIds": [
              "JER.32.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.25",
            "verseOrgIds": [
              "JER.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ijambo ry’Uhoraho ritumwa kuri Yeremiya riti: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.26",
            "verseOrgIds": [
              "JER.32.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.27",
            "verseOrgIds": [
              "JER.32.27"
            ]
          }
        },
        {
          "text": ", Imana y’abafise umubiri bose. Hari ikintu conanira jewe?” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.27",
            "verseOrgIds": [
              "JER.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko, uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.28",
            "verseOrgIds": [
              "JER.32.28"
            ]
          }
        },
        {
          "text": " avuze ati: “Ngira nshire iki gisagara mu maboko y’Abanyababiloni na Nebukadineza umwami w’i Babiloni, na bo bazogifata. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.28",
            "verseOrgIds": [
              "JER.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyababiloni bariko batera iki gisagara bazocinjira bagiturire; bazogitongoza umuriro, harimwo n’amazu yose abantu bantereyemwo ishavu mu kwurira hejuru kuri yo no gucanira ibimota neza Bayali no mu kumijagira amashikanwa y’ibinyobwa imbere y’izindi mana.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.29",
            "verseOrgIds": [
              "JER.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.29",
            "verseOrgIds": [
              "JER.32.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bo muri Isirayeli mu Buyuda nta kindi bakoze atari ibibi gusa mu nyonga zanje uhereye mu buto bwabo; ni ukuri, Abisirayeli nta kindi atari ukuntera ishavu kubera ivyo intoke zabo zakoze,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.30",
            "verseOrgIds": [
              "JER.32.30"
            ]
          }
        },
        {
          "text": " avuze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.30",
            "verseOrgIds": [
              "JER.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuva igihe cubakiwe gushika uwu musi, iki gisagara cavyuye uburake n’ubushangashirwe bwanje ku buryo ntegerezwa kukirandura mu nyonga zanje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.31",
            "verseOrgIds": [
              "JER.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli n’Abayuda n’abantu bose baranshavuje kubera ibibi bakoze, bo ubwabo, abami babo n’abaganwa babo, abaherezi babo n’abavugishwa, abantu b’i Buyuda n’ab’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.32",
            "verseOrgIds": [
              "JER.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banteye ibitugu, ntibantumbera; naho nabigishije kenshi, ntibanyumviye canke ngo bemere guhanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.33",
            "verseOrgIds": [
              "JER.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashinze ibigirwamana vyabo vy’ubuyobe mu Ngoro yitirirwa izina ryanje maze barayihumanya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bubatse ibibanza vya Bayali mu kiyaya ca Beni-Hinomu ngo bahashikanire ibimazi vy’abahungu babo n’abakobwa babo babiha Moleki, naho ntigeze ndabibategeka, canke ngo vyinjire no mu bwenge bwanje, ko bokora ikizira kingana gutyo gituma Yuda acumura.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvuga kuri iki gisagara muti: ‘Iki gisagara kizoshirwa mu maboko y’umwami w’i Babiloni biciye mu nkota, ikigoyi n’ikiza,’ ariko uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "text": " avuze: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.36",
            "verseOrgIds": [
              "JER.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Ni ukuri nzobegeranya bavuye mu bihugu vyose ivyo nzobirukaniramwo mu bushangashirwe no mu burake bwanje; nzobagarukana aha hantu bahabe mu mahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.37",
            "verseOrgIds": [
              "JER.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazoba abantu banje, nanje nzoba Imana yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.38",
            "verseOrgIds": [
              "JER.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobaha kugira umutima umwe wo kunyumvira, kugira ngo bame banyubaha imisi yose kandi kugira ngo bibabere vyiza bo ubwabo n’abana babo bazovuka hanyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.39",
            "verseOrgIds": [
              "JER.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JER 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzogiriranira na bo isezerano ritazoshira: Sinzokwigera mpeba kubagirira neza, kandi nzobashiramwo umutima wo kunyubaha, kugira ngo ntibaze bantere ibitugu na mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.40",
            "verseOrgIds": [
              "JER.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzonezerwa no kubagirira neza kandi vy’ukuri nzobateragira muri iki gihugu n’umutima wanje wose n’umushaha wanje wose.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JER 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.41",
            "verseOrgIds": [
              "JER.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JER 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "text": " avuze: “Nk’uko narekuriye ubu bugesera bungana butya kuri aba bantu, ni ko nzobaha ukugubwa neza nabasezeraniye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.42",
            "verseOrgIds": [
              "JER.32.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JER 32:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazosubira kugura amatongo muri iki gihugu ico muvuga muti: ‘Ni umusaka, nta bantu canke ibikoko bikirimwo, kuko cahawe Abanyababiloni.’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.43",
            "verseOrgIds": [
              "JER.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JER 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatongo azogurwa ifeza, impapuro z’ubuguzi zizokwandikwa zishizweko umukono, zishirweko ikidodo n’ivyabona bijeko mu ntara ya Benyamini, mu mihana ikikije Yerusalemu, mu bisagara vy’i Buyuda no mu bisagara vyo mu ntara y’imisozi, iri mu kiyaya n’iy’i Negebu, kuko nzosubira kuhubaka, ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        },
        {
          "text": " avuze.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.44",
            "verseOrgIds": [
              "JER.32.44"
            ]
          }
        }
      ]
    }
  ],
