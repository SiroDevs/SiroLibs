          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze gutanga ya makete y’ubuguzi nkayaha Baruki mwene Neriya, nsenga ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.16",
            "verseOrgIds": [
              "JER.32.16"
            ]
          }
        },
