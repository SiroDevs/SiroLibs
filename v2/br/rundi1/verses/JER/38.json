              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Zedekiya abwira Yeremiya ati: “Ntubwire umuntu n’umwe ivyo tuvuganye, kuko ubikoze wopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.24",
            "verseOrgIds": [
              "JER.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatware nibumva ko navuganye nawe, maze bakaza kukubaza bati: ‘Tubwire ivyo wabwiye umwami n’ivyo umwami yakubwiye; kandi ntuduhishe canke na ho tukwice,’ ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "uze ubabwire uti: ‘Nariko ndinginga umwami ngo ntansubize mu nzu kwa Yonatani gupfirayo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        }
      ]
    },
