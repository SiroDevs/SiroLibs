        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
