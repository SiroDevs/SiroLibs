            "sid": "JER 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya amwishura ati: “Ntibazogutanga. Niwumvire ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "text": " ku vyo ndakubwiye, ni ho ivyawe bizogenda neza, ugakiza ubuzima bwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niwanka kwishikana, ibi ni vyo ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "text": " yampishuriye: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagore bose basigaye mu kirimba c’umwami w’i Buyuda bazosohorwa bahabwe abatware b’umwami w’i Babiloni. Maze abo bagore bazokubwira bati:",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagore bawe bose n’abana bawe bazosohorwa bahabwe Abanyababiloni. Nawe ubwawe ntuzokira amaboko yabo ariko uzofatwa n’umwami w’i Babiloni; kandi iki gisagara kizotongorwa n’umuriro.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 38:23"
          },
          "items": [
