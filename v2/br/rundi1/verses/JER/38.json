          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yeremiya aguma mu rugo rw’abarinzi gushika ku musi Yerusalemu hafatiweko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
        }
      ]
    },
    {
