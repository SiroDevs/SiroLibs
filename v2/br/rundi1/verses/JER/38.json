        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaganwa bose baca baja kuraba Yeremiya baramubazagiza, na we ababwira ivyo umwami yari yamutegetse vyose kuvuga. Nuko ntibasubira kugira ico bamubaza, kuko ata n’umwe yari yumvise ivyo bavuganye n’umwami.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        }
      ]
    },
