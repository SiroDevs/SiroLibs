        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Zedekiya abwira Yeremiya ati: “Ndatinya Abayuda bamaze kwishikana ku Banyababiloni, kuko abo Banyababiloni bohava bandekurira mu maboko yabo na bo bakangirira nabi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        }
      ]
    },
