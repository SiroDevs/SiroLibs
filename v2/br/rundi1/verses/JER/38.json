              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yeremiya abwira Zedekiya ati: “Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        },
        {
          "text": " Imana Mushoboravyose, Imana ya Isirayeli, avuze: ‘Niwishikana ku bakuru b’ingabo z’umwami w’i Babiloni, ubuzima bwawe buzorokoka kandi iki gisagara ntikizotongozwa umuriro; wewe n’umuryango wawe muzobaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nutishikana ku bakuru b’ingabo z’umwami w’i Babiloni, iki gisagara kizotangwa mu maboko y’Abanyababiloni kandi bazogitongoza umuriro; kandi nawe ubwawe ntuzocika ariko uzogwa mu maboko yabo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
