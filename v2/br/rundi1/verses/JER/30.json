            }
          ]
        },
        {
          "text": "Iri ni ryo jambo ryatumwe kuri Yeremiya rivuye k’Uhoraho: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.1",
            "verseOrgIds": [
              "JER.30.1"
            ]
          }
        },
