        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abubatsi bamaze gushiraho itanguriro ry’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "text": ", abaherezi bambaye ya myambaro yabo bafise n’inzamba, n’Abalewi, bene Asafu bafise n’ivyuma bisama, bafata ibibanza vyabo ngo bahimbaze ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "text": ", nk’uko vyashinzwe na Dawidi umwami w’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baririmbira ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "text": " indirimbo zo gutazira no gushima bati:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    }
