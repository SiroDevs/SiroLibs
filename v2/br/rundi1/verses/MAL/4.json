          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwibuke Ivyagezwe vy’umusavyi wanje Mose, amabwirizwa n’ivyagezwe namugereye i Horebu kubw’Abisirayeli bose.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.4",
            "verseOrgIds": [
              "MAL.4.4"
            ]
          }
        }
      ]
    },
