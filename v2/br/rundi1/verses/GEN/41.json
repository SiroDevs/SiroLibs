          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amapfa arushirije gukomera, Yosefu yugurura bwa bubiko, aha Abanyegiputa ingano, kuko igihugu cose cari cishwe n’inzara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.56",
            "verseOrgIds": [
              "GEN.41.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "GEN 41:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bo mu bihugu vyegereye Egiputa baraza kugura ingano kwa Yosefu, kuko amapfa yari yugarije isi yose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.57",
