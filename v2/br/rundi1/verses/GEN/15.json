            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aburamu yizera ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        },
        {
