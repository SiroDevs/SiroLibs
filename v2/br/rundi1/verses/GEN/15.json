            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
          }
        },
        {
          "text": " amwemera nk’umugororotsi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.6",
            "verseOrgIds": [
              "GEN.15.6"
            ]
