          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        },
        {
          "text": " aramwishura ati: “Nzanira ishashi y’inka, ishashi y’impene n’impfizi y’intama; vyose bimaze imyaka itatu; uzane n’intunguru hamwe n’inuma ikiri nto.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.9",
            "verseOrgIds": [
              "GEN.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
