          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 40:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.22",
            "verseOrgIds": [
              "GEN.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 40:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko wa mukuru ajejwe ivyo kunywa vy’umwami ntiyasubira kwibuka Yosefu; aramwibagira rwose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.40.23",
            "verseOrgIds": [
              "GEN.40.23"
            ]
          }
        }
      ]
    }
