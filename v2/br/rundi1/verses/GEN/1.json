            }
          ]
        },
        {
          "text": "Maze Imana iravuga iti: “Ndabahaye ibiterwa vyose bifise imbuto hamwe n’ibiti vyama ivyamwa bifise imbuto muri vyo biri kw’isi yose. Bizobabera ivyokurya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.29",
            "verseOrgIds": [
              "GEN.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
