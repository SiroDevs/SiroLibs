  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "GEN 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu amaze imyaka mirongo icenda n’icenda, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "text": " aramwiyereka amubwira ati: “Ndi Imana Mushoboravyose; gendera imbere yanje mu bwizigirwa kandi ubeho ubuzima butagira umugayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.1",
            "verseOrgIds": [
              "GEN.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzogirana isezerano nawe kandi nzoguha uruvyaro runini.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.2",
            "verseOrgIds": [
              "GEN.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu avyumvise yikubita hasi yubamye. Maze Imana aramubwira iti: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.3",
            "verseOrgIds": [
              "GEN.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Iri ni ryo sezerano ngiranye nawe: nzokugira sekuruza w’amahanga menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.4",
            "verseOrgIds": [
              "GEN.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kuva ubu ntuzosubira kwitwa Aburamu, uzokwitwa Aburahamu, kuko ndakugize sekuruza w’amahanga menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoguha kurondoka cane. Uruvyaro rwawe ruzovamwo amahanga menshi, kandi muri bo hazovamwo abami. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.6",
            "verseOrgIds": [
              "GEN.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokomeza isezerano hagati yawe nanje no hagati yanje n’uruvyaro rwawe ribe isezerano ridahera, uko urunganwe ruzokurikirana n’urundi. Nzoba Imana yawe n’Imana y’uruvyaro rwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu cose c’i Kanani, ico ubamwo ubu nk’umunyamahanga, nzokiguha wewe n’uruvyaro rwawe kibe icanyu bwegu ibihe vyose, kandi nzobabera Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.8",
            "verseOrgIds": [
              "GEN.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana yongera ibwira Aburahamu iti: “Wewe n’uruvyaro rwawe mubwirizwa kwubahiriza iri sezerano, uko urunganwe ruzokurikirana n’urundi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.9",
            "verseOrgIds": [
              "GEN.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri ni ryo sezerano ryanje wewe n’uruvyaro rwawe mubwirizwa kwubahiriza: umuhungu wese ategerezwa gukebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.10",
            "verseOrgIds": [
              "GEN.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutegerezwa gukebwa, kandi ico kizoba ikimenyetso c’isezerano ngiranye namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.11",
            "verseOrgIds": [
              "GEN.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko urunganwe ruzogenda rukurikira urundi, umuhungu wese atagerezwa gukebwa amaze imisi umunani avutse, utibagiye n’abagurano bazovukira mu rugo rwawe canke abo uzogura amahera mu banyamahanga, abazoba batari abo mu ruvyaro rwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baba abavukiye mu rugo rwawe canke abo waguze amahera, bose bategerezwa gukebwa. Imibiri yanyu izogaragarako icerekana isezerano ryanje ridahera. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhungu wese atazokebwa, azocibwa mu bwoko bwiwe, kuko azoba atubahirije isezerano ryanje.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Imana ibwira Aburahamu iti: “Sarayi umugore wawe ntuzosubire kumwita Sarayi, kuva ubu uzomwite Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzomuhezagira kandi nzoguha umuhungu nciye kuri we. Nzomuhezagira kandi azoba nyina w’amahanga; abami n’amahanga menshi bazokomoka kuri we.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
            "verseOrgIds": [
              "GEN.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aburahamu yikubita hasi yubamye, aratwenga yivugana mu mutima ati: “Mbe umuntu w’imyaka ijana nkanje yoba akivyara umwana? Mbe Sara yoba akivyara umwana amaze imyaka mirongo icenda?” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.17",
            "verseOrgIds": [
              "GEN.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Aburahamu abwira Imana ati: “Icompa Ishimayeli akagira umuhezagiro wawe!”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.18",
            "verseOrgIds": [
              "GEN.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana iravuga iti: “Oya, Sara umugore wawe azokuvyarira umwana w’umuhungu, uze umwite Isaka. Nzokomeza isezerano ryanje na we n’uruvyaro rwiwe, ribe isezerano ridahera. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bijanye na Ishimayeli, numvise ico wasavye: nzomuhezagira, nzomuha kurondoka cane, ntume uruvyaro rwiwe rugwira cane. Azoba sekuruza w’abakuru b’imiryango icumi na babiri, kandi uruvyaro rwiwe ruzoba ihanga rikomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko isezerano ryanje nzorikomeza kuri Isaka, uwo Sara azokuvyarira igihe nk’iki mu mwaka uza.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ihejeje kuvugana na Aburahamu ica ivana na we iragenda.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.22",
            "verseOrgIds": [
              "GEN.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi nyene Aburahamu afata umuhungu wiwe Ishimayeli n’umugabo wese yaba mu rugo rwiwe, harimwo abahavukiye n’abo yaguze amahera, arabakeba nk’uko Imana yari yamubwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.23",
            "verseOrgIds": [
              "GEN.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yari amaze imyaka mirongo icenda n’icenda igihe yakebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.24",
            "verseOrgIds": [
              "GEN.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishimayeli, umuhungu wiwe, yari amaze imyaka icumi n’itatu igihe yakebwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.25",
            "verseOrgIds": [
              "GEN.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu n’umuhungu wiwe Ishimayeli, uko ari babiri, bakebwe uwo umusi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.26",
            "verseOrgIds": [
              "GEN.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese w’igitsina gabo yaba mu rugo rwa Aburahamu, yaba uwahavukiye canke uwaguzwe amahera mu banyamahanga, na we yakebwe uwo musi hamwe na we.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.27",
            "verseOrgIds": [
              "GEN.17.27"
            ]
          }
        }
      ]
    }
  ],
