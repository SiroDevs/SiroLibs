              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.32",
            "verseOrgIds": [
              "GEN.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahejeje kubwira abana biwe ayo majambo, Yakobo yuriza amaguru yiwe ku buriri, aracikana, ahamvya ba sekuruza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.33",
            "verseOrgIds": [
              "GEN.49.33"
            ]
          }
        }
