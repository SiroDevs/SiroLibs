          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Kuri uwo musi, umwe wese muri mwebwe azotumira umubanyi wiwe ngo bicarane musi y’umuzabibu n’umusukoni wiwe,’ ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        }
