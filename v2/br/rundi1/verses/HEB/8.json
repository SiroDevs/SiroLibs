              "HEB.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ivuze ko iri sezerano ari “rishasha”, bisigura ko yatse agaciro irya mbere; kandi ikimaze gutakaza agaciro kiba kigira kizimangane.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.8.13",
            "verseOrgIds": [
              "HEB.8.13"
            ]
          }
