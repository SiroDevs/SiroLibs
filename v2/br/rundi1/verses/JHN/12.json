          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi vyabaye kugira ngo ijambo ry’uwavugishwa n’Imana Yesaya rishike, aho yanditse avuga ati:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.38",
            "verseOrgIds": [
              "JHN.12.38"
            ]
          }
        }
