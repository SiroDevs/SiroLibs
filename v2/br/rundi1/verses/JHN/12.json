              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko rero benshi baramwizeye, harimwo na bamwe mu bakuru b’Abayuda. Mugabo ntibavyemanga ku mugaragaro kubera batinya ko Abafarisayo bobirukana mw’isinagogi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.42",
            "verseOrgIds": [
              "JHN.12.42"
            ]
          }
        },
