          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyaterwa n’uko bakunda gushimwa n’abantu kurusha gushimwa n’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.43",
            "verseOrgIds": [
              "JHN.12.43"
            ]
          }
