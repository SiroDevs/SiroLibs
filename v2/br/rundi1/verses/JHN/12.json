              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho Yesu yakoreye ibitangaza vyinshi imbere y’abantu, benshi ntibamwizeye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.37",
            "verseOrgIds": [
              "JHN.12.37"
            ]
          }
        },
