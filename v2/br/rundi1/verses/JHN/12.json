            "sid": "JHN 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ijwi ryumvikana rivuye mw’ijuru riti: “Nararihesheje icubahiro, kandi nzosubira ndariheshe icubahiro.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.28",
            "verseOrgIds": [
              "JHN.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu benshi bari ngaho bumvise iryo jwi, bavuga ko ari umuturagaro, abandi na bo ngo ni umumarayika avuganye na we.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.29",
            "verseOrgIds": [
              "JHN.12.29"
            ]
          }
        }
      ]
