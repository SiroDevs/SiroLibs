              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu isinzi bari ngaho baramwishura bati: “Ivyagezwe bitubwira ko Kristo azokwamaho. None uvuze uti: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.34",
            "verseOrgIds": [
              "JHN.12.34"
            ]
          }
        },
        {
          "text": "? Uwo ‘Mwana w’Umuntu’ ni nde?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.34",
            "verseOrgIds": [
              "JHN.12.34"
            ]
          }
        }
      ]
    },
