        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bantu bari baje i Yerusalemu mu misi mikuru ya Pasika gusenga, harimwo Abagiriki. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.20",
            "verseOrgIds": [
              "JHN.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko begera Filipo yava i Betesayida mu ntara ya Galilaya baramubwira bati: “Nyakwubahwa, twipfuza kubona Yesu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.21",
            "verseOrgIds": [
              "JHN.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo aca aragenda abibwira Andereya, maze uko ari babiri baca baja kubibwira Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.12.22",
            "verseOrgIds": [
              "JHN.12.22"
            ]
          }
        }
      ]
    },
