              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.22",
            "verseOrgIds": [
              "JHN.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahejeje kubamba Yesu, abasoda bafata impuzu ziwe bazigaburamwo kune, umusoda wese atwara umuce, basigaza ikanzu yiwe. Iyo kanzu ntiyagira umubaririro, yari igizwe n’igitambara kimwe kuva hejuru gushika hasi.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.23",
            "verseOrgIds": [
              "JHN.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.23",
            "verseOrgIds": [
              "JHN.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baravugana bati: “Ntidukwiye kuyitabura. Reka tuyipfindire kugira ngo tumenye uwuyegukira.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:24",
              "type": "text"
            },
            {
              "text": "Zaburi 22:18",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi vyabaye kugira ngo bishitse Ivyanditswe bivuga ngo:",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.24",
            "verseOrgIds": [
              "JHN.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafi y’umusaraba wa Yesu, hari hahagaze nyina, nyinabo, Mariya muka Kilopa na Mariya Magadalena. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.25",
            "verseOrgIds": [
              "JHN.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abonye nyina ahagaze aho, na wa mwigishwa Yesu yakunda amwegereye, abwira nyina ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.26",
            "verseOrgIds": [
              "JHN.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "abwira wa mwigishwa ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        },
        {
          "text": " Kuva ico gihe, wa mwigishwa aca ajana Mariya iwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.27",
            "verseOrgIds": [
              "JHN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo, Yesu amenye ko vyose birangiye, kandi kugira ngo Ivyanditswe bishike, aravuga ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafi yaho hari umubindi urimwo inkarisha, maze abasoda bafata sipongo bayijobeka muri ya nkarisha, bayidugisha ishami rya ezobu ku munwa wa Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amaze kwumviriza kuri ya nkarisha, aravuga ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        },
        {
          "text": " Nuko ajondamika umutwe aracikana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubera ko wari umusi wo kwitegurira Isabato idasanzwe, kuko bwaca ari Pasika; abakuru b’Abayuda ntibashaka ko abantu baguma bamanitse ku misaraba ku musi w’Isabato. Ni co catumye basaba Pilato ko babavuna amaguru, bakururutsa ibiziga vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.31",
            "verseOrgIds": [
              "JHN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abasoda baraza bavuna amaguru ya bamwe babiri bari babambanywe na Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.32",
            "verseOrgIds": [
              "JHN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bashikiriye Yesu basanga yamaze gucikana, ntibaba bakimuvuna amaguru. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.33",
            "verseOrgIds": [
              "JHN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe mu basoda acumita Yesu icumu mu rubavu, haseseka amaraso n’amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.34",
            "verseOrgIds": [
              "JHN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwabibonye ni we yabishingiye intahe, kandi intahe yiwe ni iy’ukuri, kandi ashinga iyo ntahe kugira ngo mwizere. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.35",
            "verseOrgIds": [
              "JHN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi vyabaye kugira ngo hashitswe Ivyanditswe bivuga ngo: “Nta na rimwe mu magufa yiwe rizovunika.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:36",
              "type": "text"
            },
            {
              "text": "Kuvayo 12:46; Guharura 9:12; Zaburi 34:20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahandi Ivyanditswe bivuga ngo: “Bazobona uwo bacumise.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:37",
              "type": "text"
            },
            {
              "text": "Zakariya 12:10",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo, Yosefu w’i Arimataya asaba Pilato uruhusha rwo kumanura ikiziga ca Yesu. Uwo Yosefu yari umwigishwa wa Yesu, ariko mu mpisho, kuko yatinya abakuru b’Abayuda. Pilato amwemereye, Yosefu araza ajana ikiziga ca Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yari kumwe na Nikodemu, umwe yagendera Yesu mw’ijoro. Nikodemu yari yaje azanye nk’ibiro mirongo itatu vy’ibimota neza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
              "JHN.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bafata ikiziga ca Yesu bakizingira mu bitambara vyera, bashiramwo na vya bimota neza, nk’uko Abayuda babigenza mu guhamba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.40",
            "verseOrgIds": [
              "JHN.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hafi y’aho Yesu yabambwe hari itongo, kandi muri iryo tongo hari imva nshasha, itari bwigere ihambwamwo umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.41",
            "verseOrgIds": [
              "JHN.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubera wari umusi wo kwitegurira Isabato y’Abayuda, kandi iyo mva ikaba yari hafi, Yosefu na Nikodemu baciye baryamika ikiziga ca Yesu muri iyo mva.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.42",
            "verseOrgIds": [
              "JHN.19.42"
            ]
          }
        }
      ]
    }
