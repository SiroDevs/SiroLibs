              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikodemu aramubaza ati: “Mbega umuntu ashaje yoshobora kuvuka ubwa kabiri gute? Yoshobora gusubira mu nda ya nyina, akongera akavuka?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.4",
            "verseOrgIds": [
              "JHN.3.4"
            ]
          }
        }
