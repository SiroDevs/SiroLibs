            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.30",
            "verseOrgIds": [
              "JHN.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwamanutse ava mw’ijuru aruta bose, uwaje ava kw’isi ni uw’isi kandi avuga nk’uw’isi nyene, ariko uwaje ava mw’ijuru aruta bose. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.31",
            "verseOrgIds": [
              "JHN.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo ashingira intahe ivyo yabonye n’ivyo yumvise, yamara nta n’umwe yemera intahe yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.32",
            "verseOrgIds": [
              "JHN.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uwemera intahe yiwe wese aba yemeje ko Imana ivuga ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.33",
            "verseOrgIds": [
              "JHN.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo Imana yatumye avuga amajambo y’Imana, kuko Imana imuha Mpwemu itamupimiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.34",
            "verseOrgIds": [
              "JHN.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se arakunda Umwana kandi yamuhaye kuganza vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.35",
            "verseOrgIds": [
              "JHN.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwizera Umwana afise ubugingo budashira, ariko uwutamwizera ntazoronka ubugingo budashira, ahubwo uburake bw’Imana buguma kuri we.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.36",
            "verseOrgIds": [
              "JHN.3.36"
            ]
          }
        }
      ]
    }
