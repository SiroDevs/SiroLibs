            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hari umuntu yitwa Nikodemu, yari Umufarisayo akaba n’umwe mu bagize inama nkuru y’idini ry’Abayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.1",
            "verseOrgIds": [
              "JHN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe aza kuraba Yesu mw’ijoro aramubwira ati: “Mwigisha, turazi ko uri umwigisha yavuye ku Mana, kuko nta muntu yoshobora gukora ibitangaza ukora, Imana itari kumwe na we.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.3.2",
            "verseOrgIds": [
              "JHN.3.2"
            ]
          }
        }
      ]
    },
    {
