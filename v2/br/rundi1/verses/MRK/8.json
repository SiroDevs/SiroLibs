            }
          ]
        },
        {
          "text": "Wa muntu areraguza, maze avuga ati: “Egome, ndabona abantu, ariko bameze nk’ibiti bigendagenda.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
