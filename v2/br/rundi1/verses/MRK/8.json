          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yongera kurambika ibiganza ku maso y’uwo muntu, maze amaso yiwe aca urahumuka. Aca arakira rwose, abona neza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
