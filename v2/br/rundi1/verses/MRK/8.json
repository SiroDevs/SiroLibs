          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo yabivuga mu majambo atomoye. Hanyuma Petero aramwihereranya, atangura kumwamira ku vyo yari avuze.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
