        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo bumvise ko Yesu yashitse, baraza batangura kumuhaririza. Mu ntumbero yo kumugeza, bamusaba ngo akore ikimenyetso kivuye mw’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.11",
            "verseOrgIds": [
              "MRK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yesu ariruhutsa cane, hanyuma ababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.12",
            "verseOrgIds": [
              "MRK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko aca abasiga ngaho, atambukira mu bwato aja ku rundi ruhande rw’ikiyaga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.13",
            "verseOrgIds": [
              "MRK.8.13"
            ]
          }
        }
      ]
    },
    {
