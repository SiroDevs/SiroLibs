              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo, Yesu n’abigishwa biwe bava i Galilaya baja mu mihana yegereye i Kayisariya mu ntara yatwarwa na Filipo. Bakigenda arababaza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        }
