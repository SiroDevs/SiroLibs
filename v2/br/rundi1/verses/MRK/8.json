              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura bati: “Bamwe bavuga ko uri Yohana Umubatizi; abandi ngo uri Eliya; abandi na bo ngo uri umwe mu bavugishwa n’Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
