              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse i Betesayida, bamuzanira impumyi baramwinginga ngo amukoreko, amukize. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
