            "style": "v",
            "sid": "MRK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.5",
            "verseOrgIds": [
              "MRK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yesu abwira ba bantu ngo bicare hasi. Afata ya mikate, ayishimira Imana, arayimanyagura, ayiha abigishwa ngo bayihe abantu, na bo babikora uko nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.6",
            "verseOrgIds": [
              "MRK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bari bafise kandi n’udufi duke. Na two adushimira Imana, abwira abigishwa ngo baduhe abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.7",
            "verseOrgIds": [
              "MRK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bantu bararya barahaga. Abigishwa begeranya ibiseke indwi vyuzuye utumanyu twasigaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.8",
            "verseOrgIds": [
              "MRK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abari aho bashika ibihumbi bine. Bahejeje kurya, Yesu aca arabarungika barataha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.9",
            "verseOrgIds": [
              "MRK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo nyene aca aja mu bwato n’abigishwa biwe baja mu karere k’i Dalamanuta.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.10",
            "verseOrgIds": [
              "MRK.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
