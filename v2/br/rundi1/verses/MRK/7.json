          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we aramwishura ati: “Mwami, n’utubwa na two turarya utwo abana bakororeye musi y’imeza.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.28",
            "verseOrgIds": [
              "MRK.7.28"
            ]
          }
        }
      ]
