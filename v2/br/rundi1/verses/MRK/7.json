          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramwishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.29",
            "verseOrgIds": [
              "MRK.7.29"
            ]
