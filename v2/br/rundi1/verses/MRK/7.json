              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo na bamwe mu bigisha b’ivyagezwe bari bavuye i Yerusalemu baragenda bakoranira aho Yesu ari, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.1",
            "verseOrgIds": [
              "MRK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze babona bamwe mu bigishwa biwe bafungura kandi amaboko yabo ahumanye, ni ukuvuga batakaravye nk’uko umugenzo wabitegeka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.2",
            "verseOrgIds": [
              "MRK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bisanzwe, Abafarisayo n’abandi Bayuda ntibashobora gufungura batabanje gukaraba nk’uko umugenzo wa ba sekuru wabitegeka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.3",
            "verseOrgIds": [
              "MRK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’iyo bavuye kw’isoko, ntibashobora gufungura batabanje gukaraba. Barakurikiza n’iyindi migenzo, nko kwoza ibikombe, amasafuriya, amasahani n’imeza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.4",
            "verseOrgIds": [
              "MRK.7.4"
            ]
          }
        }
      ]
    },
    {
