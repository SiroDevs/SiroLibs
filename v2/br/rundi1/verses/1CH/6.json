          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi Balewi bagenzi babo bari bashinzwe ibindi bikorwa vyo mw’ihema, inzu y’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.48",
            "verseOrgIds": [
              "1CH.6.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "1CH 6:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Aroni n’abo mu ruvyaro rwiwe ni bo bari bashinzwe gutanga ibimazi ku gicaniro co guturirirako ibimazi n’ico guturirirako ibimota neza hamwe n’ibikorwa vyose bijanye n’ivyakorerwa Ahera Cane, harimwo gutanga impongano z’Abisirayeli, nk’uko Mose umusavyi w’Imana yari yarabitegetse.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.49",
            "verseOrgIds": [
              "1CH.6.49"
            ]
          }
        }
      ]
