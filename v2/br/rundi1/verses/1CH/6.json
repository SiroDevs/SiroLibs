              "type": "text"
            }
          ]
        },
        {
          "text": "Aba ni bo Dawidi yashizeho ngo bazezwe gucuraranga mu ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.31",
            "verseOrgIds": [
              "1CH.6.31"
            ]
          }
        },
        {
          "text": " isandugu imaze kuhashika. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.31",
            "verseOrgIds": [
              "1CH.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakorera Imana mu gucurarangira imbere y’Ihema ry’Ibonaniro, gushika Salomo yubatse Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.32",
            "verseOrgIds": [
              "1CH.6.32"
            ]
          }
        },
        {
          "text": " i Yerusalemu. Bakora igikorwa cabo bakurikije amategeko bahawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.6.32",
            "verseOrgIds": [
              "1CH.6.32"
            ]
          }
        }
      ]
    },
