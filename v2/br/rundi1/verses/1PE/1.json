            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.2",
            "verseOrgIds": [
              "1PE.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amashimwe yose abe ay’Imana Se w’Umwami wacu Yesu Kristo, kuko ku bw’imbabazi zayo nyinshi, yaduhaye kuvuka ubwa kabiri, mu kuzura Yesu Kristo mu bapfuye. Ubu dufise ivyizigiro bizima ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.3",
            "verseOrgIds": [
              "1PE.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "vyo kuzoronka umugabane udashobora guhera, kwononekara canke gusaza. Uwo mugabane uzigamiwe mw’ijuru ku bwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.4",
            "verseOrgIds": [
              "1PE.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi biciye muri ukwo kwizera, murakingiwe n’ubushobozi bw’Imana, kugeza mushikiriye ako gakiza kateguwe kuzohishurwa mu gihe c’iherezo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.5",
            "verseOrgIds": [
              "1PE.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1PE 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma mukwiye kunezerwa, kuko naho ubu mutegerezwa kwihanganira imibabaro y’uburyo bwinshi ariko y’akanya gato, mu nyuma hari umunezero mwinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.6",
            "verseOrgIds": [
              "1PE.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1PE 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo mibabaro iriho kugira ngo ipime ukwizera kwanyu yerekane ko ari ukw’ukuri. Kurya inzahabu ishira igeragereshwa umuriro kugira ngo igaragare ko ari iy’ukuri, ni ko biri no ku kwizera kwanyu. Gufise agaciro kanini cane kurusha ak’inzahabu, ni co gituma gupimwa kugira ngo nikwamara kurama, kuze kubazanire ubwiza, gushimwa n’icubahiro ku musi Yesu Kristo azohishurirwa isi yose. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.7",
            "verseOrgIds": [
              "1PE.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1PE 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo Yesu muramukunda naho mutigeze mumubona, kandi muramwizera naho mutamubona. Ni co gituma mwuzuye umunezero amajambo adashobora gusobanura, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.8",
            "verseOrgIds": [
              "1PE.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ku bw’ukwizera kwanyu, muzoronka agakiza k’ubugingo bwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1PE 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.9",
            "verseOrgIds": [
              "1PE.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1PE 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivy’ako gakiza, abavugishwa n’Imana ba kera, ari bo bavugishijwe ivyerekeye ubwo buntu mwagira muhabwe, baragerageje kubirondera no kubimenya. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.10",
            "verseOrgIds": [
              "1PE.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpwemu wa Kristo yari muri bo yaguma avuga ivyerekeye imibabaro ya Kristo n’ubwiza buzoyiherukira bitaraba; na bo bagashaka kumenya igihe ivyo bizoshikira n’uko bizogenda. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.11",
            "verseOrgIds": [
              "1PE.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana yabahishuriye ko ivyo bavugishwa bitari biberekeye, ahubwo ko vyari vyerekeye mwebwe. Ubwo butumwa namwe mwarabubwiwe n’ababuvuga basunitswe na Mpwemu Yera yarungitswe avuye mw’ijuru. Ivyo ni igitangaza kuko n’abamarayika baripfuza kubibona bishika.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.12",
            "verseOrgIds": [
              "1PE.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1PE 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero mwame mugavye kandi mwirinde. Ivyizigiro vyanyu vyose mubishire ku buntu muzohabwa igihe Yesu Kristo azohishurirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.13",
            "verseOrgIds": [
              "1PE.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1PE 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubeho mwumvira Imana nk’abana bagamburuka. Ntimugasubire kubaho muhaza ivyipfuzo bibi vyabaganza mu gihe mwari mu butamenya. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.14",
            "verseOrgIds": [
              "1PE.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1PE 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubwo, nk’uko Imana yabahamagaye ari iyera, namwe mube abera mu ngeso zanyu zose, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.15",
            "verseOrgIds": [
              "1PE.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko n’Ivyanditswe bivuga ngo: “Mube abera nk’uko nanje ndi uwera.”",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:16",
              "type": "text"
            },
            {
              "text": "Abalewi 11:44,45; 19:2",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.16",
            "verseOrgIds": [
              "1PE.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1PE 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwibuke ko Data wo mw’ijuru, uwo musenga, adaca urwa nkunzi, hanyuma bitume mubaho muyitinya kandi muyubaha mu gihe musigaje kuba kuri ino si mubako nk’ingenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.17",
            "verseOrgIds": [
              "1PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murazi ko mwacunguwe mukava mu buzima butagira ikimazi, ubwo mwarazwe na ba sogokuruza. Iyo ncungu si ibintu bishira nk’ifeza canke inzahabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.18",
            "verseOrgIds": [
              "1PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahubwo ni amaraso y’igiciro kinini ya Kristo, Umwagazi w’intama w’Imana utagira icaha canke umugayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.19",
            "verseOrgIds": [
              "1PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana yari yaramutoranije imbere y’uko isi iremwa, ariko yamuhishuye ubu muri ino misi ya nyuma ku bwanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.20",
            "verseOrgIds": [
              "1PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biciye muri Kristo, mwahawe kwizera Imana. Kandi ukwizera kwanyu n’ivyizigiro vyanyu mwabishize mu Mana kuko yamuzuye imukuye mu bapfuye, ikamuha ubwiza.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.21",
            "verseOrgIds": [
              "1PE.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1PE 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu rero ko mwiyejeje mu kwumvira ukuri, bigatuma mugiriranira urukundo ruva ku mutima vy’ukuri, nimukundane cane nk’abavukana kandi n’imitima yanyu yose. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.22",
            "verseOrgIds": [
              "1PE.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1PE 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu mwaravutse ubwa kabiri, ntimwavukiye ubuzima bw’akanya gato. Ubuzima bwanyu bushasha ni ubw’ibihe bidashira kuko buva ku mbuto itabora, ari ryo jambo rizima ry’Imana rihoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.23",
            "verseOrgIds": [
              "1PE.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1PE 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uko Ivyanditswe bivuga ngo:",
          "type": "text",
          "attrs": {
            "verseId": "1PE.1.24",
            "verseOrgIds": [
              "1PE.1.24"
            ]
          }
        }
      ]
    }
  ],
