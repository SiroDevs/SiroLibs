            "number": "27",
            "style": "v",
            "sid": "JDG 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gitondo, wa mugabo avyutse, yugurura umuryango, arasohoka ngo abandanye urugendo, asanga aho wa mugore yaguye imbere y’umuryango, afashe igishimaryango. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.27",
            "verseOrgIds": [
              "JDG.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubwira ati: “Haguruka tugende.” Ariko wa mugore ntiyamwishura. Wa mugabo aca amushira ku ndogoba, aramutahana.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        }
      ]
    },
