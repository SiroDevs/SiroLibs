          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse i muhira, wa mugabo aca afata imbugita, amucagaguramwo ibihimba icumi na bibiri, abirungika mu miryango icumi n’ibiri y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose babibonye baravuga bati: “Ububi nk’ubu ntibwari bwakaboneke kuva Abisirayeli bavuye muri Egiputa. Nimuvyiyumvireko, muheze mutubwire ico twokora.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.30",
            "verseOrgIds": [
              "JDG.19.30"
            ]
          }
        }
