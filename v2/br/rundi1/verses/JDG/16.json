          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abo bavukana hamwe n’umuryango wiwe wose baca baramanuka gutora ikiziga ciwe. Bamutahana iwabo, bamuhamba hagati y’i Zora n’i Eshitayoli, aho se wiwe Manowa yahambwe. Samusoni yatwaye Abisirayeli imyaka mirongo ibiri.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
      ]
    }
