              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abefurayimu babikora nk’uko babwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.24",
            "verseOrgIds": [
              "JDG.7.24"
            ]
          }
        },
        {
