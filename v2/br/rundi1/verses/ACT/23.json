          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mukuru w’abasoda aca ahamagara abakuru babiri b’abasoda ijana-jana, ababwira ati: “Nimutegure abasoda amajana abiri, abagendera ku mafarasi mirongo indwi, hamwe n’abandi amajana abiri bagwanisha amacumu, mwitegurire kuja i Kayisariya isaha zitatu z’ijoro. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.23",
            "verseOrgIds": [
              "ACT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutegurire Pawulo amafarasi kugira ngo ashikirizwe Felisi, umukuru w’intara, ata nkomanzi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.24",
            "verseOrgIds": [
              "ACT.23.24"
            ]
          }
        }
      ]
