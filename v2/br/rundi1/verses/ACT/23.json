              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mukuru w’abasoda aca arungika wa musore, amwihanikirije ati: “Ntihagire n’umwe ubwira ko ibi wabimbwiye.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.22",
            "verseOrgIds": [
              "ACT.23.22"
            ]
          }
