          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "ACT 13:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ijambo ry’Imana ryamamara muri iyo ntara yose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.49",
            "verseOrgIds": [
              "ACT.13.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "ACT 13:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Abayuda bosha abagore b’icubahiro bubaha Imana, hamwe n’abagabo baganza igisagara, batangura guhama Pawulo na Baranaba, babirukana muri iyo ntara. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.50",
            "verseOrgIds": [
              "ACT.13.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "ACT 13:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pawulo na Baranaba na bo bakunkumura umukungugu wo mu birenge vyabo, baca baja muri Ikoniyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.51",
            "verseOrgIds": [
              "ACT.13.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "ACT 13:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abigishwa bo muri Antiyokiya bari bafise umunezero mwinshi, buzuye Mpwemu Yera.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.52",
            "verseOrgIds": [
              "ACT.13.52"
            ]
          }
        }
