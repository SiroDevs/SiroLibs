          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi amaze gukora ivyo Imana igomba mu gihe ciwe, yarasinziriye, ahambwa hamwe na ba sekuruza, umubiri wiwe urabora. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.36",
            "verseOrgIds": [
              "ACT.13.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 13:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uwo Imana yazuye mu bapfuye ntiyigeze abora.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.37",
            "verseOrgIds": [
              "ACT.13.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
