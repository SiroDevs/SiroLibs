          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.35",
            "verseOrgIds": [
              "ACT.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
