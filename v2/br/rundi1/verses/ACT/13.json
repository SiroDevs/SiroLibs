        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.37",
            "verseOrgIds": [
              "ACT.13.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 13:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero bene Data, turabamenyesha ko ari muri Yesu mumenyesherezwa inkuru yo guharirwa ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.38",
            "verseOrgIds": [
              "ACT.13.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 13:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri we, uwizera wese aba abohowe icaha ciwe cose, ari kwo kwemerwa n’Imana nk’abagororotsi, ukwo mutashobora guhabwa n’Ivyagezwe vya Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.39",
            "verseOrgIds": [
              "ACT.13.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 13:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiyubare rero kugira ngo ivyo abavugishwa bavuze ntibibashikeko, aho bavuga ngo:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.13.40",
            "verseOrgIds": [
              "ACT.13.40"
            ]
          }
        }
      ]
    },
    {
