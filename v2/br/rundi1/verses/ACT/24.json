              "ACT.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
