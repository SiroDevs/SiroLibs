        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Damasiko hariho umwigishwa wa Yesu yitwa Ananiya. Maze Umwami Yesu aramwiyereka mu nzozi, aramuhamagara ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arishura ati: “Sabwe Mwami!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
