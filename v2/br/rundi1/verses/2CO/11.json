          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bene Data banshira mu giseke banyururutsa bancishije mw’idirisha ry’uruzitiro, ndamukira gutyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.33",
