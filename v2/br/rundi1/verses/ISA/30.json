          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma Uwera wa Isirayeli avuze ati:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.12",
            "verseOrgIds": [
              "ISA.30.12"
            ]
          }
        }
