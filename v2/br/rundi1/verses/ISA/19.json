      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.15",
            "verseOrgIds": [
              "ISA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo musi Abanyegiputa bazomera nk’abagore b’abanyantegenke. Bazohindishwa agashitsi n’uko ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "text": " Mushoboravyose ababanguriye ukuboko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.16",
            "verseOrgIds": [
              "ISA.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi igihugu c’i Buyuda kizotera ubwoba Abanyegiputa; uwuzobwirwa izina rya Yuda azohinda agashitsi, kubera ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "text": " Mushoboravyose ateguye kugirira Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.17",
            "verseOrgIds": [
              "ISA.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo musi, ibisagara bitanu vyo muri Egiputa bizovuga ururimi rw’Igiheburayo, biyegurira ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "text": " Mushoboravyose. Kimwe muri vyo kizokwitwa Igisagara c’Izuba.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.18",
            "verseOrgIds": [
              "ISA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi hazokwubakwa igicaniro c’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "text": " hagati muri Egiputa, hamwe n’icibutso ku rubibe rwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.19",
            "verseOrgIds": [
              "ISA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bizoba ibimenyetso bishingira intahe ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "text": " Mushoboravyose muri Egiputa. Nibaborogera ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "text": " kubera agacinyizo, azobarungikira umukiza abarinda, abarokore. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.20",
            "verseOrgIds": [
              "ISA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze uwo musi ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "text": " azokwimenyekanisha ku Banyegiputa, kandi bazomwemera nk’umwami. Bazomusenga bongere bamushikanire ibimazi n’amashikanwa y’ifu. Bazosezeranira ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "text": " kandi isezerano barishitse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.21",
            "verseOrgIds": [
              "ISA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " azoteza Egiputa icago; azobakubita yongere abavure. Bazogaruka k’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "text": ", na we azobumviriza, abakize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.22",
            "verseOrgIds": [
              "ISA.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo musi hazoba inzira yagutse iva muri Egiputa, ija muri Ashuri. Kandi abo muri Ashuri bazogendera abo muri Egiputa n’abo muri Egiputa bazogendera abo muri Ashuri. Abo muri Ashuri n’abo muri Egiputa bazotazirira hamwe Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.23",
            "verseOrgIds": [
              "ISA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri ico gihe, Isirayeli bazoba bagira gatatu inyuma ya Egiputa na Ashuri, bose bazobera umugisha isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.24",
            "verseOrgIds": [
              "ISA.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " Mushoboravyose azobahezagira, avuga ati: “Hahiriwe Egiputa, ubwoko bwanje, na Ashuri igikorwa c’amaboko yanje, hamwe na Isirayeli iragi ryanje!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.19.25",
            "verseOrgIds": [
              "ISA.19.25"
            ]
          }
        }
      ]
    }
