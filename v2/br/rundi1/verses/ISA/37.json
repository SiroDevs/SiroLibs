          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni yo majambo ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.22",
            "verseOrgIds": [
              "ISA.37.22"
            ]
          }
        },
        {
          "text": " amurungikiye:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.22",
