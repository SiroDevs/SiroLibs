          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya yakira ikete ahawe n’intumwa ararisoma, aca aduga mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.14",
            "verseOrgIds": [
              "ISA.37.14"
            ]
          }
        },
        {
          "text": ", arizingururira imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.14",
            "verseOrgIds": [
              "ISA.37.14"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.14",
            "verseOrgIds": [
              "ISA.37.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asenga ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.15",
            "verseOrgIds": [
              "ISA.37.15"
            ]
          }
        },
        {
          "text": " avuga ati: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.15",
            "verseOrgIds": [
              "ISA.37.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.16",
            "verseOrgIds": [
              "ISA.37.16"
            ]
          }
        },
        {
          "text": " Mushoboravyose, Mana ya Isirayeli, wewe wicaye ku ntebe y’inganji hagati y’abakerubi, ni wewe Mana wenyene mu bwami bwose bwo kw’isi. Ni wewe waremye ijuru n’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.16",
            "verseOrgIds": [
              "ISA.37.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tega ugutwi Mana yanje, wumve. Utereze inyonga zawe urabe, ewe ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.17",
            "verseOrgIds": [
              "ISA.37.17"
            ]
          }
        },
        {
          "text": "; wumve amajambo Senakeribu yarungitse yo gucokora Imana nzima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.17",
            "verseOrgIds": [
              "ISA.37.17"
            ]
          }
        }
      ]
    },
