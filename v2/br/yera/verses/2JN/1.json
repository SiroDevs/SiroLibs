        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "3JN.1.13"
              },
              "items": [
                {
                  "text": "3 Yoh 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho nari mfise vyinshi vyo kubandikira, singomvye kuvyandikisha wino ku rupapuro: ariko nizigiye kuzoza i wanyu ngo tuvugane imbonankubone kugira ng’umunezero wanyu ube uwuzuye.",
          "type": "text",
          "attrs": {
            "verseId": "2JN.1.12",
            "verseOrgIds": [
              "2JN.1.12"
            ]
          }
        }
      ]
    },
