              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi w’isabato ushize, ku wa mbere w’imisi ndwi, umutwenzi ugomba gutambika, Mariya Magadalene na Mariya wundi baja kurāba imva. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.1",
            "verseOrgIds": [
              "MAT.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Habaho kunyiganyiga kw’isi gukomeye, kuk’ umumarayika w’Umwami Imana yar’ amanutse ava mw ijuru, araza akūra ca kibuye agitembagaje, acicarako. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.2",
            "verseOrgIds": [
              "MAT.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.17.2"
              },
              "items": [
                {
                  "text": "Mat 17:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.10"
              },
              "items": [
                {
                  "text": "Ivyak 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishusho yiwe yasa n’umuravyo, impuzu ziwe zera nka shelegi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.3",
            "verseOrgIds": [
              "MAT.28.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:3",
              "type": "text"
            },
            {
              "text": "shelegi n’ikintu coroshe cera, gikoroka hasi nk’imvura, gikanye cane.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.3",
            "verseOrgIds": [
              "MAT.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgoba yateye abarāririzi bubashira mu gatengo, bamera nk’abapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.4",
            "verseOrgIds": [
              "MAT.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umumarayika abgira ba bagore, ati Mweho ntimutinye, kuko nzi ko murondera Yesu, umwe yabambga; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.5",
            "verseOrgIds": [
              "MAT.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.40"
              },
              "items": [
                {
                  "text": "Mat 12:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.21"
              },
              "items": [
                {
                  "text": "16:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
