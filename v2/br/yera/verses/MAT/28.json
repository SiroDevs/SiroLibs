            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabēgēra, arababgira, ati Jewe nahawe ububasha bgose mw ijuru no mw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.28.18",
