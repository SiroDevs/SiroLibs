            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw igiti ciza cose cama ivyiza, arikw igiti kibi cama ibibi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.17",
            "verseOrgIds": [
              "MAT.7.17"
            ]
