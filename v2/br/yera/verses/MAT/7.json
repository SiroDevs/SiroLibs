            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musabe, muzohabga; murondere, muzoronka; muramutse, muzokwugururirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.7",
            "verseOrgIds": [
              "MAT.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ūsaba wese ahabga; ūrondera aronka; ūramutsa yugururirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.8",
            "verseOrgIds": [
              "MAT.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Har’ umuntu muri mwebge, umwana wiwe yomusaba umutsima, akamuha ibuye? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.9",
            "verseOrgIds": [
              "MAT.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke yomusaba ifi, akamuha inzoka? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.10",
            "verseOrgIds": [
              "MAT.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.17"
              },
              "items": [
                {
                  "text": "Yak 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None mwebge, ko muzi guha abana banyu ingabire nziza muri babi, mbega So wo mw ijuru ntazorushiriza rwose guha ivyiza abamusavye? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.11",
            "verseOrgIds": [
              "MAT.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 7:12"
