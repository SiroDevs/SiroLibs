                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyera vy’Imana ntimukabihe imbga, kand’ imaragarita",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.6",
            "verseOrgIds": [
              "MAT.7.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:6",
              "type": "text"
            },
            {
              "text": "imaragarita imeze nk’akabuyenge keza cane; ifise igiciro kinini.",
              "type": "text"
            }
          ]
        },
        {
          "text": " zanyu ntimuziterere ingurube, kugira ngo ntizizihonyange n’inzāra zazo, maze zikabahindukirira, zikabatabagura.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.6",
            "verseOrgIds": [
              "MAT.7.6"
            ]
          }
        }
      ]
