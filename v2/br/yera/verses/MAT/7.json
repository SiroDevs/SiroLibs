          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igiti ciza ntigishobora kwama ibibi, kand’ igiti kibi ntigishobora kwama ivyiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.18",
            "verseOrgIds": [
