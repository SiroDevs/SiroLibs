        },
        {
          "text": "Muce mw irembo ripfunganye; kukw irembo ryagutse, n’inzira y’igihamo, ari vyo bijana abantu mu mahonero, kand’ abahaca ni benshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.13",
            "verseOrgIds": [
              "MAT.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
