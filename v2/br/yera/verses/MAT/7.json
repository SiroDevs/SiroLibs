                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ivyo mugomba kw abantu babagirira vyose mube ari ko mubagirira namwe; kukw ivyo ar’ ivyagezwe n’ivy’ abavugishijwe n’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.12",
            "verseOrgIds": [
              "MAT.7.12"
            ]
          }
        }
