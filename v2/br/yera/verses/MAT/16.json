          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahindukirira Petero, ati Herēra inyuma yanje, Satani; ur’ ikintsitaza, kukw ivy’ Imana atari vyo ubabaye, ubabaye ivy’ abantu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.23",
            "verseOrgIds": [
              "MAT.16.23"
            ]
          }
        }
