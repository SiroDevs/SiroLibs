            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:18",
              "type": "text"
            },
            {
              "text": "Mu Kigiriki Petero risobanurwa ngw Ibuye.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi kur’ urwo rutare nzorwubakakw ishengero ryanje, kand’ amarembo y’i kuzimu ntazorishobora. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "verse",
