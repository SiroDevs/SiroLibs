              "type": "text"
            }
          ]
        },
        {
          "text": "Buno Yesu abgira abigishwa biwe, at’ Umuntu ni yagomba kunkurikira, ni yiyanke, yikorere umusaraba wiwe, ankurikire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
