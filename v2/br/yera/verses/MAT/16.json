              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umuntu vyomumarira iki kwunguka ivyo mw isi vyose ni yākwa ubugingo bgiwe kw icīru? Cank’ umuntu yotanga iki ngw acungure ubugingo bgiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.26",
            "verseOrgIds": [
              "MAT.16.26"
            ]
