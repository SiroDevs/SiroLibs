              },
              "items": [
                {
                  "text": "Mat 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoguha impfunguzo z’ubgami bgo mw ijuru: kand’ ico uzohambira mw isi kizoba gihambiriwe mw ijuru; n’ico uzohamburura mw isi kizoba gihamburuwe mw ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.19",
            "verseOrgIds": [
              "MAT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
