            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje ndakubgira yuk’ uri Petero,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.18",
            "verseOrgIds": [
              "MAT.16.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
