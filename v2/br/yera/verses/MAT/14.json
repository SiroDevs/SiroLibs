            }
          ]
        },
        {
          "text": "Mur’ ico gihe umwami Herode yumva inkuru za Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
