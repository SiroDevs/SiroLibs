              "items": [
                {
                  "text": "Mat 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.19"
              },
              "items": [
                {
                  "text": "Luk 6:19",
                  "type": "text"
                }
              ]
