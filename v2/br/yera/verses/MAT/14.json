          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kujabuka hakurya, bafata i musozi mu ntāra y’i Genesareti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu b’aho hantu baramumenya, batumatumanako mur’ ico gihugu cose, bamuzanira abarwaye bose, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
