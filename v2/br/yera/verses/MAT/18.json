          ]
        },
        {
          "text": "Kand’ ūzokwākīra akana kamwe nk’aka mw izina ryanje azoba anyakiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.5",
            "verseOrgIds": [
              "MAT.18.5"
            ]
          }
        },
        {
