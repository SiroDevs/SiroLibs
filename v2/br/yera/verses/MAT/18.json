              },
              "items": [
                {
                  "text": "Luk 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.17.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ūzotsitaza n’umwe mur’ abo bato banyizera, icoroshe n’uko yohambirirwa urusyo ruremereye kw izosi, akadobezwa i bgina mu kiyaga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.6",
            "verseOrgIds": [
              "MAT.18.6"
            ]
          }
        }
