                {
                  "text": "Mat 19:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.3+JHN.3.4+JHN.3.5"
              },
              "items": [
                {
                  "text": "Yoh 3:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababgira, ati Ndababgire ukuri: Ni mutirimbura ngo mucike nk’abana bato, ntimuzoruha mwinjira mu bgami bgo mw ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.3",
            "verseOrgIds": [
              "MAT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ ūzokwicisha bugufi nk’aka kana ni we mukuru mu bgami bgo mw ijuru.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.4",
            "verseOrgIds": [
              "MAT.18.4"
            ]
          }
        }
      ]
    },
