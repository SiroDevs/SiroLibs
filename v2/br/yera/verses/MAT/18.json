              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ uwo mwanya abigishwa baza kuri Yesu, baramubaza, bat’ Umukuru mu bgami bgo mw ijuru ni nde? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.1",
            "verseOrgIds": [
              "MAT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamagara akana, agahagarika hagati yabo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.18.2",
            "verseOrgIds": [
              "MAT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 18:3"
          },
          "items": [
