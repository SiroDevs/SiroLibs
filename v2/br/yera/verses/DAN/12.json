            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe abaza wa muntu yambaye impuzu zera, yari hejuru y’amazi y’urwo ruzi, at’ Ivyo bitangaza bizoshitsa ryari? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.6",
