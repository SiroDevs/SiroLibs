            "number": "9",
            "style": "v",
            "sid": "DAN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aranyishura, at’ Igīre, Daniyeli; kukw ayo majambo ar’ akabanga, amatanishijwe ishashara idomyemw’ ikimenyetso, gushitsa igihe c’iherezo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.9",
            "verseOrgIds": [
              "DAN.12.9"
            ]
          }
        },
