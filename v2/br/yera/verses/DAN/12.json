          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndavyumva, ariko sinabitahura; nca ndabaza, nti Databuja, ikizoherukira ibindi mur’ ivyo n’ikihe? ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.8",
            "verseOrgIds": [
              "DAN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
