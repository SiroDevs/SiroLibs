            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abāgize ubgenge bazokayangana nk’ugukayangana kwo mw itāzānure ry’ijuru, n’abashikanye benshi ku bugororotsi bazokwaka nk’inyenyeri ibihe bitazoshira. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.3",
            "verseOrgIds": [
              "DAN.12.3"
            ]
          }
