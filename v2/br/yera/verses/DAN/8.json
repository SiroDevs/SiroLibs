              "type": "text"
            }
          ]
        },
        {
          "text": "Impfizi y’impene y’ibisambi ni we mwami w’i Bugiriki; kand’ ihembe rinini ryari hagati y’amaso yayo ni we mwami wabo wa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.21",
            "verseOrgIds": [
              "DAN.8.21"
            ]
          }
        },
        {
          "name": "verse",
