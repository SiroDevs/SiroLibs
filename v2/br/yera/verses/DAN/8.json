                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambgira, at’ Umve ngira nkumenyeshe ibizoba mu gihe c’uburake bgo kw iherezo; kukw ar’ ivy’ igihe c’iherezo cashinzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.19",
            "verseOrgIds": [
              "DAN.8.19"
            ]
          }
        },
        {
          "name": "verse",
