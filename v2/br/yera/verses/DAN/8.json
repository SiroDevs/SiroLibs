              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko jewe ubganje Daniyeli mmaze kubona ivyo neretswe, ndondera uko nobitahura; mbona ikimpagaze imbere gifise ishusho nk’iy’ umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.15",
            "verseOrgIds": [
              "DAN.8.15"
            ]
          }
        },
