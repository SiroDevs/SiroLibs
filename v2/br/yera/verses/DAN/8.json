          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe ingoma yabo igira ihere, abanyabicumuro bamaze kugwira, hazovyuka umwami w’umujinya, azi guhirikana. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.23",
            "verseOrgIds": [
              "DAN.8.23"
            ]
          }
