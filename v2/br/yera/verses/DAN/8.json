            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze numva ijwi ry’umuntu riturutse hagati mu ruzi Ulayi, rihamagara, riti Yewe Gaburiyeli, tahuza uwo muntu ivyo yeretswe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.16",
            "verseOrgIds": [
              "DAN.8.16"
            ]
          }
        },
