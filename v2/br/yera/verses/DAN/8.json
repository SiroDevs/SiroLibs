            "number": "20",
            "style": "v",
            "sid": "DAN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impfizi y’intama y’amahembe abiri wabonye ni bo bami b’Abamedi n’Abaperesi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.20",
            "verseOrgIds": [
              "DAN.8.20"
            ]
          }
        },
