              "type": "text"
            }
          ]
        },
        {
          "text": "Akirikw aravugana nanje, nzimira ubgenge, ncurika umutwe hasi; maz’ ankorako, aramvyura. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.18",
