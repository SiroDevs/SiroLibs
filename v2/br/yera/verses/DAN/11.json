              "items": [
                {
                  "text": "Dan 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nanje, mu mwaka wa mbere Dariyo w’Umumedi ari ku ngoma, nakūwe hasi no kumufasha no kumuremēsha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.1",
            "verseOrgIds": [
              "DAN.11.1"
            ]
          }
        }
