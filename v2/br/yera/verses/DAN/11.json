                "loc": "REV.13.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo mwami azokora uko yigombeye, yishire hejuru, yīgire agahambaye gasumba icitwa imana cose, kand’ azovuga ibitangaza vyo kurogota ku Mana nya mana, azororanirwa gushitsa ah’ uburake buzoshikira; kukw icashinzwe kitazobura gushika. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.36",
            "verseOrgIds": [
              "DAN.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntazobabara imana za ba sekuruza, cank’ imana isengwa n’abagore, cank’ iyindi mana yose; kukw azokwishira hejuru gusumba zose. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.37",
            "verseOrgIds": [
              "DAN.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "DAN 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu gishingo cazo azokwubaha imana y’amaboma; mber’ imana ba sekuruza batigeze kumenya azoyubahisha kuyishikanira izahabu n’ifeza n’utubuyenge tw’igiciro kinini n’ibintu vy’igikundiro. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.38",
            "verseOrgIds": [
              "DAN.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "DAN 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ azonesha amaboma arusha ayandi gukomera, afashijwe n’iyo mana y’akavantara; abazomuninahaza bose azobongeraniriza icubahiro, abahe gutwara abantu benshi, kand’ azobasaturira ibihugu kw ingabire. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.39",
            "verseOrgIds": [
              "DAN.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "DAN 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.27"
              },
              "items": [
                {
                  "text": "Dan 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu gihe c’ iherezo umwami w’i bumanuko azomutera, kand’ umwami w’i burārūko azoja kumutega ameze nk’ agashururu, azanye imikogote n’abagendera ku mafarasi n’amāto menshi; azotera ibihugu, asendanishe, abihitane. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.40",
            "verseOrgIds": [
              "DAN.11.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "DAN 11:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.9"
              },
              "items": [
                {
                  "text": "Dan 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoshika no mu gihugu c’ubgiza; henshi hazotikizwa, arikw abazokira amaboko yiwe n’Abanyedomu n’Abanyamowabu n’igihimba gikomeye c’ Abamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.41",
            "verseOrgIds": [
              "DAN.11.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "DAN 11:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw azoshingiriza ukuboko ibihugu bitari bimwe, kandi n’igihugu ca Egiputa ntikizokira. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.42",
            "verseOrgIds": [
              "DAN.11.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "DAN 11:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoganza itunga ry’izahabu n’ifeza n’ibintu vyose vy’igiciro vyo muri Egiputa; Abalibuwa n’Abanyetiyopiya bazomukakako. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.43",
            "verseOrgIds": [
              "DAN.11.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DAN 11:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw inkuru zivuye i burasirazuba n’i burārūko zizomuhagarika umutima, azovayo afise uburake bginshi, ajanywe no kugeseza no gutikiza benshi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.44",
            "verseOrgIds": [
              "DAN.11.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DAN 11:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoshinga amahema yiwe y’ ubgami hagati y’ikiyaga n’umusozi wera w’ubgiza; yamar’ ageze ku musi w’iherezo ryiwe nta wuzomutabara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.45",
            "verseOrgIds": [
              "DAN.11.45"
