              "DAN.11.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.21"
              },
              "items": [
                {
                  "text": "Dan 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.10.21"
              },
              "items": [
                {
                  "text": "10:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko none ngira nkwereke ivy’ ukuri. Haracasigaye abandi bami batatu bazokwima i Buperesi; arik’ uwa kane azorusha abandi bose ubutunzi bginshi: uwo ni yamara kuba umunyabushobozi kubg’ ubutunzi bgiwe, azogomora ingabo zose ngw atere ubgami bg’i Bugiriki. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.2",
            "verseOrgIds": [
              "DAN.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami ahambaye azohaguruka, azoganzisha ububasha bginshi, akore uko yigombeye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.3",
            "verseOrgIds": [
              "DAN.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yamara guhaguruka, ubgami bgiwe buzosatagurwa, bugabanywemwo bune nk’uko butumbereye ibirēre bine vy’ijuru, kandi ntibuzosubirwamwo n’uruvyaro rwiwe, canke ngo buganzishwe ububasha nk’uko yabuganzisha; kuk’ ubgami bgiwe buzoshingurwa, buhabge abandi atari mur’ abo. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.4",
            "verseOrgIds": [
              "DAN.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’i bumanuko azoba ūkomeye; arik’ umwe wo mu baganwa biwe azomurusha ububasha, agire inganji; kand’ inganji yiwe izoba ihambaye cane. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.5",
            "verseOrgIds": [
              "DAN.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashize imyaka bazokwuzura, kuk’ umukobga w’umwami w’i bumanuko azoja kwābīrwa ku mwami w’i burārūko, ngo bibuzuze; arik’ ubushobozi bg’uwo mukobga buzoyongayonga, kand’ uwo mwami na we ntazohangama, cank’ ububasha bgiwe; arik’ uwo mukobga azotanganwa n’abamuzanye n’umuvyeyi wiwe, n’uwamushigikira ico gihe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.6",
            "verseOrgIds": [
              "DAN.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu ngundu zo ku gishitsi c’i wabo hazovyuka ūzosubira ku ngoma ya se, azoja mu ngabo, atere amaboma y’ umwami w’i burārūko ayinjire, abaho abagire ukw agomba, agire intsinzi; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.7",
            "verseOrgIds": [
              "DAN.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ibigirwamana vyabo na vyo, n’ibishushanyo vyavugutiwe, n’ibintu vyabo vyiza‐vyiza vy’imbombovu vy’ifeza n’ivy’ izahabu, azobinyaga abijane muri Egiputa; maz’ azomara imyaka aretse umwami w’i burārūko. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.8",
            "verseOrgIds": [
              "DAN.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma uwo mwami na we azotera igihugu c’umwami w’i bumanuko, maz’ asubire mu gihugu ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.9",
            "verseOrgIds": [
              "DAN.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.8"
              },
              "items": [
                {
                  "text": "Yes 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.40"
              },
              "items": [
                {
                  "text": "Dan 11:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abana biwe bazovyura intambara, bakoranye isinzi ry’ingabo nyinshi; zizotera zisendanishe, zidwēbēre mu gihugu, maze zizokebanuka zirwana, kugeza no kw iboma y’umwami w’i bumanuko.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.10",
            "verseOrgIds": [
              "DAN.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.10",
            "verseOrgIds": [
              "DAN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami w’i bumanuko azoshungumirwa, azorekuka arwane n’umwami w’i burārūko; azogomora ingabo nyinshi, maz’ ingabo z’umwami w’i burārūko zizogwa mu maboko y’umwami w’i bumanuko. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.11",
            "verseOrgIds": [
              "DAN.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kujana izo ngabo kw inyagano, azokwikakisha mu mutima; ariko nah’ azoba ahindikiranije ingabo ibihumbi n’ibihumbi, ntazoba anesheje rwose; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.12",
            "verseOrgIds": [
              "DAN.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ umwami w’i burārūko azogaruka, akagomora ingabo ziruta iza mbere; hashize imyaka azozana ingabo nyinshi n’isanduruma y’intekera.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.13",
            "verseOrgIds": [
              "DAN.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.13",
            "verseOrgIds": [
              "DAN.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe benshi bazokūrira hasi umwami w’i bumanuko, kand’ abantu b’ibirara bo mu bgoko bganyu bazogumuka bashitse ivyerekanywe mu nzozi, ariko bazohenuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.14",
            "verseOrgIds": [
              "DAN.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’i burārūko azoza, atere ibisagara bikikijwe n’inzitiro z’amabuye zikomeye, abirundire ibigunguzi vyo kwūririrako, abineshe; arikw ingabo z’uw’ i bumanuko, bo n’intōre ziwe, ntizizomushobora; ntihazoboneka inkomezi zo kumushobora. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.15",
            "verseOrgIds": [
              "DAN.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.9"
              },
              "items": [
                {
                  "text": "Dan 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ūzoba amuteye azogira nk’uko yigombeye, kandi nta wuzomuhagarara mu ruhanga; nukw azohagarara mu gihugu c’ubgiza, ukuboko kwiwe kurimwo kugeseza. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.16",
            "verseOrgIds": [
              "DAN.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma azoja imigabo yo gusidukana n’ingabo z’igihugu ciwe cose; arikw azokwihanura, yiyuzuze n’uwo mwami w’i bumanuko, amushingire umukobga wiwe kugira ngw amuhondobereze: arikw iyo migabo ntizohagarara, ntizomubera ko. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.17",
            "verseOrgIds": [
              "DAN.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo azohindukiza amaso, atere ibizinga vyo mu kiyaga, aneshe vyinshi; arik’ umugabisha umwe azozibiza agakēngērwe yateye, mber’ azokamusubiza ku mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.18",
            "verseOrgIds": [
              "DAN.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ azohindukiza amaso yerekeze mu maboma yo mu gihugu ciwe bgite; arikw azotsitara, ahenuke, ntaboneke ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.19",
            "verseOrgIds": [
              "DAN.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye hazovyuka uwundi mu gishingo ciwe, azorungika umutozakori mu gihugu kirushirije kuba ciza co mu bgami bgiwe; ariko mu misi mike azokenyurwa, ata mitongano cank’ intambara. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.20",
            "verseOrgIds": [
              "DAN.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye mu gishingo ciwe hazovyuka umuntu w’inkēngērwa, atāhawe icubahiro c’ubgami; arikw azoza mu gihe c’impore, yironkeshereze ubgami ubuhemanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.21",
            "verseOrgIds": [
              "DAN.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ingabo zizoba zisebereye nk’uruzi zizotembanwa n’umuvo imbere yiwe, zihomvagurike; mbere n’ umukuru w’isezerano na we n’ uko. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.22",
            "verseOrgIds": [
              "DAN.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hagize umuntu yifatanya na we, azoca mu bugunge, kukw azodūga akaba ūhambaye, nah’ azoba afise abantu bake. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.23",
            "verseOrgIds": [
              "DAN.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gihe c’impore azotera intambara aharusha ahandi kumera mu gihugu; azokora ivyo ba sekuru na ba sekuruza batigeze gukora; azogabanganya abantu amasahu n’iminyago n’itunga; mber’ azomara igihe gitoya yīgīriye imigabo yo gutera amaboma akomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.24",
            "verseOrgIds": [
              "DAN.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ azokwiyungunganya mu bubasha bgiwe n’ ubugabo, azogomora ingabo nyinshi atere umwami w’i bumanuko; kand’ umwami w’i bumanuko azokwitabara mu ntambara, afise ingabo nyinshi cane z’ubuhizi; ariko ntazomuhagarara mu mutwe, kuko bazomuryaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.25",
            "verseOrgIds": [
              "DAN.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mber’ abazoba barya ku binōbōye vyiwe ni bo bazomufyonyora; ingabo ziwe zizotembanwa n’umuvo, benshi muri bo bahindikirane. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.26",
            "verseOrgIds": [
              "DAN.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.11.40"
              },
              "items": [
                {
                  "text": "Dan 11:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bami bompi imitima yabo izoba iyo gukora ikibi; bazovugana ibinyoma bari ku meza amwe: arikw ivyabo ntibizororana, kukw iherezo rizoza mu gihe cashinzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.27",
            "verseOrgIds": [
              "DAN.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw azosubirana mu gihugu ciwe ibintu vyinshi; kand’ umutima wiwe uzoba wanse isezerano ryera, azokora nk’uko yigombeye, maz’ asubire mu gihugu ciwe.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.28",
            "verseOrgIds": [
              "DAN.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.28",
            "verseOrgIds": [
              "DAN.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mu gihe cashinzwe azosubira kuja gutera i bumanuko; arikw ico gihe co hanyuma ntikizomera nk’ica mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.29",
            "verseOrgIds": [
              "DAN.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw amāto y’i Kitimu azomutera, azotuma atinyirira amagara, asubire inyuma; azoshungumirirwa isezerano ryera, akore nk’uko yigombeye; mber’ azosubirayo, ashire umutima ku bātaye isezerano ryera. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.11.30",
            "verseOrgIds": [
              "DAN.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.8.13"
              },
              "items": [
                {
                  "text": "Dan 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.11"
              },
              "items": [
                {
