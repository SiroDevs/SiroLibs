              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ico gihimba c’igikonjo kirarungikwa, kivuye kuri yo, iyo nyandiko irandikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.24",
