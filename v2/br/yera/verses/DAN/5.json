              "items": [
                {
                  "text": "2 Abam 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daniyeli yishura umwami, at’ Ingabire zawe n’uzigumirize, kand’ impēra zawe uzihe uwundi. Ariko ndasomera umwami iyo nyandiko, ndamumenyeshe ukw isobanurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.17",
            "verseOrgIds": [
              "DAN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
