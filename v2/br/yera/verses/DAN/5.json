              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nawe, Belushaza, umwana wiwe, ntiwicishije bugufi mu mutima wawe, naho war’ uzi ivyo vyose; ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.22",
            "verseOrgIds": [
