        },
        {
          "text": "Zirikana mugenzi, Imana isumba vyose yahaye so Nebukadineza ubgami n’ubukuru n’ubgiza n’igitinyiro. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.18",
