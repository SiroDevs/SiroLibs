          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ukw ivyo bisobanurwa n’uku: ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.5.26",
            "verseOrgIds": [
              "DAN.5.26"
            ]
          }
        },
        {
          "text": ", risobanurwa ngw Imana iharūye imyaka umaze uri ku ngoma, iyishizekw iherezo. ",
