            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira, at’ Erega ndabona abantu bane babohoye, bagendagenda mu muriro hagati, kandi nta co babaye; kand’ ishusho y’uwa kane isa n’iy’ umwana w’imana. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.25",
            "verseOrgIds": [
