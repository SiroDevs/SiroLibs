          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami ashira hejuru Shaduraka na Meshaki na Abedunego mu gihugu c’i Babuloni.",
          "type": "text",
