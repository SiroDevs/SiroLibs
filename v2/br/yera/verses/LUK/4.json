                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamuha igitabo c’uwavugishwa n’Imana Yesaya, arakizingurura, abona ahantu handitswe,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.17",
