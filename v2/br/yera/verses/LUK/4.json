            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yesu asubira i Galilaya, ari n’ubushobozi bga Mpwemu, inkuru yiwe ikwira mu gihugu cose kihakikije. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.14",
            "verseOrgIds": [
              "LUK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
