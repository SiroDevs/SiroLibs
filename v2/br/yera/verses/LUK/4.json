        },
        {
          "text": "ati Yō! Duhūriye hehe ga Yesu Munyanazareti? Uje kuduhonnya? Ndakuzi uw’ uri we, ur’ Uwera w’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.34",
            "verseOrgIds": [
              "LUK.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramuzibiza, ati Hora, muvemwo. Dayimoni amutūye hasi hagati yabo, amuvamwo, atagize ico amugira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.35",
            "verseOrgIds": [
              "LUK.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose baratangara, barabazanya, bat’ Iryo n’ijambo ki? N’ububasha n’ubushobozi agera impwemu zihumanye zigasohoka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.36",
            "verseOrgIds": [
              "LUK.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkuru yiwe ikwira hose mu ntāra ihakikije.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.4.37",
            "verseOrgIds": [
              "LUK.4.37"
            ]
          }
        }
