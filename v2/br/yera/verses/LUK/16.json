            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababgira, ati Mwebge mugomba kwiyerekana nk’abagororotse mu maso y’abantu, arikw Imana irazi imitima yanyu: kukw igishizwe hejuru mu bantu ar’ igisesema mu nyonga z’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.15",
            "verseOrgIds": [
              "LUK.16.15"
            ]
          }
        }
      ]
