            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyagezwe, bo n’amajambo y’abāvugishwa n’Imana, vyabayeho gushitsa igihe ca Yohana: uhereye ico gihe ubutumwa bgiza bg’ubgami bg’Imana ni ho bgavugiwe, umuntu wese akabubandanira. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.16",
            "verseOrgIds": [
              "LUK.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.18"
              },
              "items": [
                {
                  "text": "Mat 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icoroshe n’ukw ijuru n’isi vyovaho, hakw akazatsa na kamwe kova ku nyuguti imwe yo mu vyagezwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.17",
            "verseOrgIds": [
              "LUK.16.17"
            ]
          }
        }
      ]
