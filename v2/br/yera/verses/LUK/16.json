                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo, bār’ abakunzi b’ubutunzi, bumvise ivyo vyose, baramutwenga cane. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.14",
            "verseOrgIds": [
              "LUK.16.14"
            ]
          }
        },
