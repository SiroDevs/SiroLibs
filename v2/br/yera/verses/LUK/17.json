              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo bamubajije igihe ubgami bg’Imana buzozira, arabishura, at’ Ubgami bg’Imana ntibuzoza bgerekanwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
