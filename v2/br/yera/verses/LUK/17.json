                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ntibazovuga, bat’ Ehe ngubu: canke bati Nguburiya; kuk’ ubgami bg’Imana buri muri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.21",
            "verseOrgIds": [
              "LUK.17.21"
            ]
          }
        }
