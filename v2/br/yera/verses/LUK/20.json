            }
          ]
        },
        {
          "text": "Abasadukayo bamwe baza kuri we, ni bo bahakana yukw ata kuzuka kuriho, baramubaza, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.27",
