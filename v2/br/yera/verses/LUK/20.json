          "type": "text",
          "attrs": {
            "verseId": "LUK.20.9",
            "verseOrgIds": [
              "LUK.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 20:10"
          },
          "items": [
            {
