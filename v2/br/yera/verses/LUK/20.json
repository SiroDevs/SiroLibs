            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ntibaba bagishobora gupfa, kuko baringaniye n’abamarayika, kand’ ar’ abana b’Imana, kukw ar’ abana b’ukuzuka. ",
          "type": "text",
          "attrs": {
