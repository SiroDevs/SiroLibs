                "loc": "ISA.5.1"
              },
              "items": [
                {
                  "text": "Yes 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atangura gucira abantu uyu mugani, ati Hābaye umuntu yateye uruzabibu, arusigarana abarimyi, aja mu mahanga, amaray’ igihe kirekire.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.9",
            "verseOrgIds": [
              "LUK.20.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.33+MAT.21.34+MAT.21.35+MAT.21.36+MAT.21.37+MAT.21.38+MAT.21.39+MAT.21.40+MAT.21.41+MAT.21.42+MAT.21.43+MAT.21.44+MAT.21.45+MAT.21.46"
              },
              "items": [
                {
                  "text": "Mat 21:33-46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.12.1+MRK.12.2+MRK.12.3+MRK.12.4+MRK.12.5+MRK.12.6+MRK.12.7+MRK.12.8+MRK.12.9+MRK.12.10+MRK.12.11+MRK.12.12"
