              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amenya ubugunge bgabo, arababgira, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.23",
            "verseOrgIds": [
              "LUK.20.23"
            ]
