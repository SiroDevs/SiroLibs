                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.27+MRK.11.28+MRK.11.29+MRK.11.30+MRK.11.31+MRK.11.32+MRK.11.33"
              },
              "items": [
                {
                  "text": "Mrk 11:27-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi ur’ izina, yigishiriza abantu mu rusengero, avuga ubutumwa bgiza, abaherezi bakuru n’abanyabgenge b’ivyanditswe bazanana kuri we n’abashingantahe: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.1",
            "verseOrgIds": [
              "LUK.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "baramubaza, bati Tubgire, n’ububasha ki bugutera gukora ivyo, canke ni nde yaguhaye ubgo bubasha? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.2",
            "verseOrgIds": [
              "LUK.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Nanje hinge ndababaze ijambo, mumbgire: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.3",
            "verseOrgIds": [
              "LUK.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "non’ ukubatiza kwa Yohana kwāturutse mw ijuru, canke se mu bantu? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.4",
            "verseOrgIds": [
              "LUK.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bībūranya muri bo, bati Ni twavuga tuti Ni mw ijuru; ahava atubaza, ati N’iki cababujije kumwemera? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.5",
            "verseOrgIds": [
              "LUK.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni twavuga tuti Ni mu bantu, abantu bose baradutera amabuye, kuko bemeye badakekeranya yuko Yohana yavugishwa n’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.6",
            "verseOrgIds": [
              "LUK.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwishura yuko batazi aho kwavuye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.7",
            "verseOrgIds": [
              "LUK.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arababgira, ati Nuko rero nanje simbabgira ububasha bunkoresha ivyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.8",
            "verseOrgIds": [
              "LUK.20.8"
            ]
          }
        }
      ]
    },
    {
