              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abāpfuye ko bazuka na Mose yabimenyekanishije hamwe havuga ivy’ Igisaka c’amahwa, aho yita Uhoraho Imana ya Aburahamu n’Imana ya Isaka n’Imana ya Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.37",
            "verseOrgIds": [
              "LUK.20.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 20:38"
          },
          "items": [
