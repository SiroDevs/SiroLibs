              },
              "items": [
                {
                  "text": "Rom 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ Imana s’iy’ abāpfuye, ariko n’iy’ abariho: kuko kuri yo bose bariho. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.38",
            "verseOrgIds": [
              "LUK.20.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 20:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamwe mu banyabgenge b’ivyanditswe baramwishura, bati Mwigisha, uvuze neza. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.39",
            "verseOrgIds": [
              "LUK.20.39"
            ]
          }
        },
