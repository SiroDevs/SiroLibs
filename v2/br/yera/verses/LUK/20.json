                "loc": "LUK.19.48"
              },
              "items": [
                {
                  "text": "Luk 19:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyabgenge b’ivyanditswe bo n’abaherezi bakuru ako kanya barondera ingene bomushōrerakw amaboko, ariko batinya abantu: kuko bamenye yukw ari bo yaciyek’ uwo mugani.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.20.19",
            "verseOrgIds": [
              "LUK.20.19"
            ]
          }
        }
      ]
    },
    {
