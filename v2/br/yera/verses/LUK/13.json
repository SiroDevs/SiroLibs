                  "text": "Mat 23:37-39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Yerusalemu, ewe Yerusalemu, wica abavugishwa n’Imana, ugatera amabuye abagutumweko! Ni kangahe nagomvye gukoranya abana bawe, nk’ukw inkoko ikoranya imiswi yayo iyibundikira mu vyubi vyayo, ntimwakunda. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.34",
            "verseOrgIds": [
              "LUK.13.34"
            ]
          }
        },
        {
