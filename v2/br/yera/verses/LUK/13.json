                  "text": "Zab 6:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azobabgira, ati Ndababgire, sinzi iyo muvuye; mviraho, mwa bakora ibizira mwese mwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.27",
            "verseOrgIds": [
              "LUK.13.27"
            ]
          }
        },
