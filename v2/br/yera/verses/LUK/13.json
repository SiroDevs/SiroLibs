                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ho muzotangura kuvuga, mut’ Erega twarīra, twanywera imbere yawe, kandi wigishiriza mu nzira z’i wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.26",
            "verseOrgIds": [
