            "number": "22",
            "style": "v",
            "sid": "LUK 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ari mu nzira, ahita mu bisagara no mu mihana, yigisha, ari ku rugendo aja i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.22",
            "verseOrgIds": [
              "LUK.13.22"
            ]
