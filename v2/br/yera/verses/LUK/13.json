              "type": "text"
            }
          ]
        },
        {
          "text": "Nyen’ inzu ni yaheza guhaguruka, akugara urugi, mugatangura gukomanga muhagaze hanze, mukavuga, muti Mupfasoni, n’utwugururire: ni ho azobishura, ati Simbazi, sinzi n’iyo muvuye. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.25",
            "verseOrgIds": [
              "LUK.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
