          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera kuvuga, at’ Ubgami bg’Imana ndabushushanye n’iki? ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.20",
            "verseOrgIds": [
              "LUK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Busa n’umwambiro umugore yābiriye akawuvanga n’ingero zitatu z’ifu, gushitsa ah’ iribututumbire yose.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.21",
            "verseOrgIds": [
