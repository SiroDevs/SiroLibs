                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi har’ ab’ inyuma bazoba ab’ imbere, n’ab’ imbere bazoba ab’ inyuma.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
