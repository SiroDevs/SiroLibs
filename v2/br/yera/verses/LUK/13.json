            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazoza abava i burasirazuba n’i burengerazuba n’i burārūko n’i bumanuko, bazokwicara mu bgami bg’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
