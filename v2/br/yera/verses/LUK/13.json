                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ni ho hazoba amarira no kuryanya insya z’amenyo, aho muzobonera Aburahamu na Isaka na Yakobo n’abāvugishwa n’Imana bose bari mu bgami bg’Imana, namwe muhindiwe hanze. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
