                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Mushishikare guca mw irembo ripfunganye: ndababgira yuko benshi bazogomba kuricamwo, ntibabishobore. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.24",
