                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.5"
              },
              "items": [
                {
                  "text": "Nah 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe nzohigūra nawe, ni k’Uhoraho Nyen’ ingabo agize, kandi nzoturira imikogote yawe y’intambara, itūmūke, kand’ inkota izoririka imigunza yawe y’intambge; nzokūrah’ ugusahura kwawe kw isi, kand’ ijwi ry’ intumwa zawe ntirizokwongera kwumvikana ukundi.",
          "type": "text",
          "attrs": {
            "verseId": "NAM.2.13",
            "verseOrgIds": [
              "NAM.2.13"
            ]
          }
        }
      ]
    }
