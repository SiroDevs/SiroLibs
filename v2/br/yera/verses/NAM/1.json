            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisozi ishizwe mu gatengo na we, n’uturambi turashonze; isi isebagizwa imbere yiwe, isi n’abayibako bose. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.5",
