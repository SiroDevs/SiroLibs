            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho ni mwiza, n’ubuhungiro bgo ku musi w’amagorwa; kand’ arazi abamwizigira. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.7",
            "verseOrgIds": [
              "NAM.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
