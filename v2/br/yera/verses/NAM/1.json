            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akankamira ikiyaga akagikamya, agakamya n’ inzūzi zose; Bashani na Karumeli harahondobereye, n’amashurwe y’i Lebanoni arahondobereye. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.1.4",
            "verseOrgIds": [
