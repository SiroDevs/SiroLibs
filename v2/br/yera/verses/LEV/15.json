              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose na Aroni, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.1",
            "verseOrgIds": [
              "LEV.15.1"
            ]
          }
        },
        {
