          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo vyagezwe vy’ umunyagisokoro, n’ivy’ ūvubgamwo n’intanga ziwe, bikamuhumanya; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ivy’ umukobga cank’ umugore arwaye ubutinyanka, n’ ivy’ ūvubgamwo n’ibimuhumanya wese, ar’ umugabo ar’ umugore, n’ivy’ umugabo arāranye n’umugore ahumanye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.33",
