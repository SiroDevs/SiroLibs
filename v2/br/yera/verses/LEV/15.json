                {
                  "text": "Mat 9:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukobga cank’ umugore ni yamara imisi myinshi ari mu mihango yiwe mu gihe kitari co, canke ni yarenza imisi yiwe, imisi yose azomara mu miziro, az’ abe nk’uko yahora ari mu miziro yiwe; azoba ahumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburiri bgose azoryamako mu misi yose yo guhumana kwiwe, buze bumubere nk’ubgo yaryamyeko mu misi y’imiziro yiwe; n’ikintu cose azokwicarako kizoba gihumanye nk’icari gisanzwe gihumanywa n’ iy’ ari mu miziro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūkoze kuri vyo wese azoba ahumanye; az’ amesure impuzu ziwe, yiyuhagire, akomeze kuba ūhumanye gushitsa ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.15.13+LEV.15.14+LEV.15.15"
              },
              "items": [
                {
                  "text": "Lew 15:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni yaramuka ageze guhumanurwa ubgo buhumane bgamuvuyemwo, az’ aharūre imisi ndwi, hanyuma abone guhumanuka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira umunani, yijanire intunguru zibiri cank’ ivyana vy’inuma bibiri, abishīre umuherezi ku muryango w’ihema ry’ibonaniro; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo muherezi abitange kw ibimazi, kimwe co gutangirwa ivyaha, ikindi co kwoswa; nuk’ uwo muherezi amuhongerere imbere yanje, kubg’ ubuhumane bgiwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        }
      ]
