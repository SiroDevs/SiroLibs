            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.10"
              },
              "items": [
                {
                  "text": "Gus 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
