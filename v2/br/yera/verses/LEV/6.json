                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baze bayivangire n’amavuta ya elayo ku cuma gikaranga; ni yamara guhwana, bayizane;",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:21",
              "type": "text"
            },
            {
              "text": "bayizane; baze batange",
              "type": "text"
            },
            {
              "text": ": mu Giheburayo handitswe ng’ uyizane; uz’ utange.",
              "type": "text"
            }
          ]
        },
        {
          "text": " baze batange",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "text": " iryo shikanwa ry’ivyakozwe mw ifu ar’ utumanyagu dukaranze, ngo ribe umubabge ummotera neza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
