                  "text": "Kuv 29:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi wo mu bana biwe azorobanuzwa amavuta, amusubiriye mu gishingo, aze yame anshikanira iryo shikanwa, bibe icagezwe c’intahava: ryose rize rishe ritōngōke. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishikanwa ry’ivyakozwe mw ifu umuherezi azotanga, rize rishe ryose, ritōngōke: ntirize riribge na mba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
