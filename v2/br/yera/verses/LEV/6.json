          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Iri ni ryo shikanwa rya Aroni n’abana biwe, bakwiye kuzokwama banshikanira, uhereye ku musi Aroni azorobanuzwa amavuta: ikigiracumi c’ingero yitwa efa y’ifu igogōretse, ngo kize kibe ishikanwa ry’ifu ry’ubudasība; igice cayo kize gishikanwe mu gitondo, ikindi ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
