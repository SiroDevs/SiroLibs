            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire ishikanwa ryakozwe mw ifu munshikanira ryacumbanywe n’umwambiro: kuko mudakwiye kugira umwambiro cank’ ubūki mwosa ngo bibe ishikanwa ritōngōrwa n’umuriro munshikaniye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.11",
            "verseOrgIds": [
              "LEV.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
