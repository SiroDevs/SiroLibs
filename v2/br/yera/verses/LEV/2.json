                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisigaye kur’ iryo shikanwa ry’ifu bize bibe ivya Aroni n’abana biwe: kizoba ar’ ikintu cera cane mu mashikanwa atōngōrwa n’umuriro nshikanirwa, jewe Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.3",
            "verseOrgIds": [
              "LEV.2.3"
            ]
          }
        }
      ]
