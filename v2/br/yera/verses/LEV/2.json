              "items": [
                {
                  "text": "Kuv 29:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni mwashikana ishikanwa ry’ivyokejwe mu ziko vyakozwe mw ifu, bize bibe udutsima tutambiwe twacumbge mw ifu igogōretse, twacumbanywe n’amavuta ya elayo, cank’ udutsima tutambiwe nyene, tubēhūye, twasutswekw amavuta ya elayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.4",
            "verseOrgIds": [
              "LEV.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ishikanwa ryanyu ni ryaba iry’ ivyakaranzwe ku cuma vyakozwe mw ifu, bize bibe ivyakozwe mw īgogōretse, ata mwambiro, vyacumbanywe n’amavuta ya elayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.5",
            "verseOrgIds": [
              "LEV.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubicemw’ utumanyu, mudusukekw amavuta ya elayo: iryo rizoba ribaye ishikanwa ryo mw ifu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.6",
            "verseOrgIds": [
              "LEV.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ishikanwa ryanyu ni ryaba iry’ ivyakaranganywe n’amavuta, vyakozwe mw ifu, bize bibe ivyakozwe mw īgogōretse, vyacumbanywe n’amavuta ya elayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.7",
            "verseOrgIds": [
              "LEV.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze munzanire ishikanwa ry’ivyakozwe mw ifu, ryakozwe mur’ ubgo buryo; rishīrwe umuherezi, na we arizane ku gicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.8",
            "verseOrgIds": [
              "LEV.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.2.2"
              },
              "items": [
                {
                  "text": "Lew 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi aheze akamate kur’ iryo shikanwa ry’ ivyakozwe mw ifu, ikizoba icibutso caryo, acosereze ku gicaniro, kibe ishikanwa ritōngōrwa n’umuriro, umubabge ummotera neza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.9",
            "verseOrgIds": [
              "LEV.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisigaye kur’ iryo shikanwa ry’ivyakozwe mw ifu bize bibe ivya Aroni n’abana biwe: kizoba ar’ umugabane wera cane mu mashikanwa atōngōrwa n’umuriro nshikanirwa jewe Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.10",
            "verseOrgIds": [
              "LEV.2.10"
            ]
          }
        }
      ]
    },
