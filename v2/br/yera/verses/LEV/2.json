                "loc": "DEU.26.10"
              },
              "items": [
                {
                  "text": "Gus 26:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo mushobora kubinshikanira nk’ishikanwa ry’umushuzo, ariko ntibize bishirwe ku gicaniro kuba nk’umubabge umota neza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.12",
            "verseOrgIds": [
              "LEV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.19"
              },
              "items": [
                {
                  "text": "Guh 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.49"
              },
              "items": [
                {
                  "text": "Mrk 9:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ishikanwa ryose ry’ivyakozwe mw ifu muzoshikana muze mubirunge umunyu; ntimuze mugire ishikanwa ry’ivyakozwe mw ifu mushikana ritarimw’ umunyu, kand’ ari wo kimenyetso c’isezerano ryanje, Imana yanyu: ivyo muzotanga vyose muze mubitangane n’umunyu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.2.13",
            "verseOrgIds": [
              "LEV.2.13"
            ]
          }
        }
      ]
