                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.13"
              },
              "items": [
                {
                  "text": "Guh 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe ubarire Abisirayeli, yuk’ umuntu wese azontuka, jewe Imana yiwe, azogībgako n’icaha ciwe. ",
          "type": "text",
          "attrs": {
