                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukw isabato itashe, Aroni az’ ayitereke imbere yanje na ntaryo kubg’ Abisirayeli, bibe isezerano ritazoshira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.8",
            "verseOrgIds": [
