                {
                  "text": "Mrk 2:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo mitsima iz’ ibe iya Aroni n’abana biwe; baze bahore bayirīra ahantu hera, kukw ar’ umugabane wiwe wera cane w’intahava agerewe mu mashikanwa atōngōrwa n’umuriro nshikanirwa, jewe Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.9",
