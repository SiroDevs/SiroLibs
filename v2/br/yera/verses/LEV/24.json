            }
          ]
        },
        {
          "text": "Uyigire ibirundo bibiri kuri ya meza y’izahabu iramuye ar’ imbere yanje, mu kirundo kimwe habemw’ itandatu, mu kindi kuno. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.6",
            "verseOrgIds": [
              "LEV.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku kirundo kimwe ugerekekw imibavu itunganye, ku kindi kuno, ibe icibutso kur’ iyo mitsima, ishikanwa nshikaniwe ryo gutōngōrwa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.7",
            "verseOrgIds": [
              "LEV.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
