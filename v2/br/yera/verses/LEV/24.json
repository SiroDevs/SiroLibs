            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Jana uwatukanye inyuma y’aho mushagaje, abamwumvise bose aho yatukana bashire ibiganza vyabo ku mutwe wiwe: ikoraniro ryose rimwicishe amabuye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.24.14",
            "verseOrgIds": [
              "LEV.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
