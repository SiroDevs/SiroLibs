          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ubabarire, ut’ Umuntu wese wo mu nzu ya Isirayeli, canke wo mu banyamahanga baba muri bo, azotanga ikimazi co kwoswa cank’ ikimazi kindi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "atakizanye ku muryango w’ihema ry’ibonaniro kukinshikanira, uwo muntu az’ acibge mu bgoko bgabo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
            "verseOrgIds": [
              "LEV.17.9"
            ]
          }
        }
