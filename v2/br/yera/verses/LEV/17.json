        },
        {
          "text": "Kand’ umuntu wese wo mu nzu ya Isirayeli, canke wo mu banyamahanga baba muri bo, azokwigera ageza ubuseri",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:10",
              "type": "text"
            },
            {
              "text": "ubuseri",
              "type": "text"
            },
            {
              "text": ": rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.26"
              },
              "items": [
                {
                  "text": "Lew 7:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " mu kanwa, nzohoza igitsūre canje kur’ uwo muntu yariye ubuseri, ndamurandure mu bgoko bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.10",
            "verseOrgIds": [
              "LEV.17.10"
            ]
          }
