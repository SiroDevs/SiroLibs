                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’impfizi y’inka n’impfizi y’intama kw ikimazi c’ishimwe, vyo gukererera imbere y’Uhoraho; bo n’ishikanwa ry’ifu ivanze n’ amavuta ya elayo; kuk’ uyu musi Uhoraho agira abiyereke.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.4",
            "verseOrgIds": [
              "LEV.9.4"
            ]
          }
        }
