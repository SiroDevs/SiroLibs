              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aroni yegera igicaniro, akerera iyo shuri yitangiriye kw ikimazi c’ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.8",
            "verseOrgIds": [
