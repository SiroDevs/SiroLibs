                  "text": "8:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana biwe bamuhēreza amaraso, ayajōbekamw’ urutoke, ayasīga ku mahembe y’igicaniro, ayandi ayavyagiza hasi hambavu y’igicaniro: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.9",
            "verseOrgIds": [
              "LEV.9.9"
            ]
          }
        },
        {
          "name": "verse",
