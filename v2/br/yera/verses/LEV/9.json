              "items": [
                {
                  "text": "Lew 4:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.16"
              },
              "items": [
                {
                  "text": "8:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw ibinure, n’amafyigo, n’agashami gatoya k’igitigu vy’ico kimazi gitangiwe ivyaha, avyosereza ku gicaniro, nk’uk’ Uhoraho yari yarageze Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.10",
            "verseOrgIds": [
              "LEV.9.10"
            ]
          }
        },
