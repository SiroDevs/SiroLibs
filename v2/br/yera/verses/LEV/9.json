          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bazana ivyo Mose yageze imbere y’ihema ry’ibonaniro; ikoraniro ryose ryīgira hafi, rihagarara imbere yo Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.5",
            "verseOrgIds": [
              "LEV.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aravuga, at’ Ibi ni vyo Uhoraho yageze ko mukora, maz’ ubgiza bg’ Uhoraho burababonekera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.6",
            "verseOrgIds": [
              "LEV.9.6"
            ]
          }
        },
        {
          "name": "verse",
