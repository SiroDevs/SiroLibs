              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.8.20"
              },
              "items": [
                {
                  "text": "8:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bamuhēreza ivy’ ico kimazi, bamuha ibice vyaco kimwe‐kimwe bo n’ umutwe waco, avyosereza ku gicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.13",
            "verseOrgIds": [
              "LEV.9.13"
            ]
          }
        },
        {
