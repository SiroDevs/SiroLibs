                  "text": "Heb 5:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose abarira Aroni, at’ Egera igicaniro, witangire ikimazi c’ ivyaha, n’ico kwoswa, wihongere, uhongere n’abantu; utange n’ibimazi vy’abantu, ubahongere, nk’uk’ Uhoraho yageze.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.7",
            "verseOrgIds": [
              "LEV.9.7"
            ]
          }
        }
      ]
