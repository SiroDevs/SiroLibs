              },
              "items": [
                {
                  "text": "4:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi barira Abisirayeli, uti Ni mujane isuguru y’impene kw ikimazi co gutangirwa ivyaha, bo n’imasa n’umwana w’intama, vyompi bimaze umwaka, kandi bitagira agasembga, kw ikimazi co kwoswa; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.3",
            "verseOrgIds": [
              "LEV.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 9:4"
