            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araheza akerera ikimazi co kwoswa; abana biwe bamuhēreza amaraso, ayamijagira ku gicaniro impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.12",
            "verseOrgIds": [
              "LEV.9.12"
            ]
