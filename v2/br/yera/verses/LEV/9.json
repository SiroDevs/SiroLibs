            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aronga amara yaco, n’ibikenye vy’amaguru, aravyosa, abigeretse ku vy’ico kimazi coshejwe kiri ku gicaniro.",
          "type": "text",
          "attrs": {
