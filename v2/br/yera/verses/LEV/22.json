            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "az’ atange ishuri cank’ isuguru y’intama cank’ iy’ impene, kugira ngw abone kwemerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
