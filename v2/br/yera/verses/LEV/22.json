            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Barira Aroni n’abana biwe baze bitonde mu kwēgēra ivyejejwe Abisirayeli banshikanira, boye gutukisha izina ryanje ryera: nd’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
