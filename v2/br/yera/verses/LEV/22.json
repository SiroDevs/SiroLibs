              },
              "items": [
                {
                  "text": "Lew 7:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubabarire yuk’ umuntu wese wo mu ruvyaro rwabo azokwēgēra ivyejejwe Abisirayeli banshikaniye, ahumanye, uk’ urunganwe rwabo ruzogenda rukurikirana, uwo muntu az’ arandurwe, akūrwe imbere yanje: nd’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
