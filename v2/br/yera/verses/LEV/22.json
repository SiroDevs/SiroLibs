                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese azotanga ikimazi c’ishimwe, akakimpa jewe Uhoraho ngw ashitse isezerano ryiwe, canke kikaba ico atanze avyigombeye, ar’ ico akūye mu busho canke mu mukuku, kize kibe ciza kugira ngo cemerwe: ntihaze hagire agasembga kibonekako. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
