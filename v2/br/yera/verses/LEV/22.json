              "items": [
                {
                  "text": "Lew 21:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire impumyi, cank’ ikivunitse, cank’ icakomerekejwe, cank’ igifise igisebe, cank’ ikirwaye umwirye, cank’ ubushita, muzonshikanira muri ben’ ivyo, canke ngo mugitange kw ishikanwa munshikaniye jewe Uhoraho, ngo gitōngōrwe n’umuriro ku gicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishuri cank’ umwana w’intama, hagize igifise urugingo rutareha n’izindi, umuntu aremererwa kugitanga kw ishikanwa ashikanye avyigombeye; ariko nticokwemerwa kuba ishikanwa ryo gushitsa isezerano yasezeranye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igifise amavya yahomberanye canke yamenetse canke yajanjaguritse canke yashahuwe, ntimuze mukinshikanire, jewe Uhoraho; ntimuze mugenze murtyo mu gihugu canyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
