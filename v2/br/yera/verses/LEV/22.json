                  "text": "Mal 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’iyo coba kizanywe n’umunyamahanga, ntimuze mwemere ikimeze girtyo na kimwe, ngo mukinshikanire kw imfungurwa, jewe Imana yanyu; ntikizokwemerwa ko mushikanye, kuko gitosekaye, kikabakw agasembga.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
