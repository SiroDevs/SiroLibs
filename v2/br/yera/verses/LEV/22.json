            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "cank’ ūzokora ku kanyonyera ak’ ari ko kose, ar’ akomuhumanya, canke ku muntu, ar’ uwomuhumanisha ubuhumane ubg’ ari bgo bgose; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
