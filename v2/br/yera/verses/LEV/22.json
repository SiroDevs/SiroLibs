                  "text": "Lew 15:5-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ūzokora ku bimeze birtyo azoba ahumanye arinde ashitsa ku mugoroba; ntaz’ arye kur’ ivyo vyejejwe, shit’ abanje kwiyuhagira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
