            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw igifise agasembga cose ntimuze mugitange, kuko kitazokwemerwa ko mushikanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
