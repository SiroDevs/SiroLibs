        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.11"
              },
              "items": [
                {
                  "text": "Guh 18:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izuba ni ryamara kurenga azoba ahumanutse; ni h’azobona kurya ku vyejejwe, kukw ivyo ari vyo vyar’ indya ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.17.15"
              },
              "items": [
                {
                  "text": "Lew 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icipfiriye cank’ ikirangara, ntaz’ agire ico arya muri vyo ngw acihumanishe: nd’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.43"
              },
              "items": [
                {
                  "text": "Kuv 28:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma bakwiye kwitondera ibgirizwa ryanje, boye kwikwēgera icaha kubgaryo, rikabicisha, kuko bazoba bahumanije ivyejejwe: kukw ari jewe Uhoraho ndabeza.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
