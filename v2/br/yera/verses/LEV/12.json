              "items": [
                {
                  "text": "Luk 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Barira Abisirayeli, ut’ Umugore ni yasama inda, akavyara umwana w’umuhungu, az’ amare imisi ndwi ahumanye: nk’uko bimubera iy’ari mu muhango w’imiziro yiwe, ni kw azoba ahumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.2",
            "verseOrgIds": [
              "LEV.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
