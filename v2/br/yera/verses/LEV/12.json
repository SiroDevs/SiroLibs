                "loc": "GEN.17.12"
              },
              "items": [
                {
                  "text": "Ita 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.59"
              },
              "items": [
                {
                  "text": "Luk 1:59",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.21"
              },
              "items": [
                {
                  "text": "2:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira umunani uwo mwana az’ akebge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.3",
            "verseOrgIds": [
              "LEV.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyina az’ amare imisi mirongwitatu n’itatu abone guhumanurwa, avuye mu maraso yiwe; ntaz’ akore ku kintu cera na kimwe, canke ngw ashike ahantu hēra, gushitsa ah’ imisi y’uguhumanurwa kwiwe izoshirira. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.4",
            "verseOrgIds": [
              "LEV.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ho ni yavyara umwana w’umukobga, az’ amare amayinga abiri ahumanye, nk’uko bimubera iy’ ari mu miziro yiwe; az’ aheze amare imisi mirongwitandatu n’ itandatu abone guhumanurwa, avuye mu maraso yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.12.5",
            "verseOrgIds": [
              "LEV.12.5"
            ]
          }
        }
      ]
    },
