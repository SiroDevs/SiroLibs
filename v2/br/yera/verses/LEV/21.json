              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi abaye mukuru muri bagenzi biwe, yasutswe amavuta mu mutwe yo kumurobanura, akaba yashikirijwe ibango ngo yambare ya myambaro, ntaz’ ahamburure umushatsi wiwe, canke ngo yitantamurirekw impuzu ziwe agandaye; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.10",
            "verseOrgIds": [
              "LEV.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
