            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ati Barira abaherezi bene Aroni, uti Ntihaze hagire umuherezi yiyandurisha ūpfuye wo mu bgoko bgabo; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.1",
            "verseOrgIds": [
              "LEV.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "shit’ uwo mu muryango wo hafi, nyina, canke se, cank’ umuhungu wiwe, cank’ umukobga wiwe, canke mukuru we, canke murumuna we, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.2",
            "verseOrgIds": [
              "LEV.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "canke mushiki we akir’ imvyiruke, akimuzeyeko vyose, kukw atararongorwa: uwo we biremerwa ko yomwanduza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.3",
            "verseOrgIds": [
              "LEV.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kw ar’ umukuru mw ihanga ryabo, ntaze yiyanduze ngo yiyonone. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.4",
            "verseOrgIds": [
              "LEV.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
