              "items": [
                {
                  "text": "Ezk 44:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uwo azokwābīra az’ abe inkumi yirongoreye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.13",
            "verseOrgIds": [
              "LEV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umupfakazi, cank’ uwirukanywe, cank’ uwamaze kwononekara, canke maraya, ntaz’ agire uwo yābīra muri bo, atar’ inkumi yirongoreye yo mu bgoko bgabo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.14",
            "verseOrgIds": [
              "LEV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
