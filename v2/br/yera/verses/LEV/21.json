            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntaze yinjirire ku muvyimba n’umwe, canke ngw awiyandurishe, n’iyo woba uwa se cank’ uwa nyina; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.11",
            "verseOrgIds": [
              "LEV.21.11"
            ]
