              },
              "items": [
                {
                  "text": "19:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baze bambere abera, jewe Imana yabo, ntibatukishe izina ryanje, Imana yabo; kukw ari bo bampēreza ibimazi, jewe Uhoraho, bitōngōrwa n’umuriro, ari zo mfungurwa zanje, Imana yabo: ni co gituma bakwiye kuba abera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.6",
            "verseOrgIds": [
              "LEV.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.14"
              },
              "items": [
                {
                  "text": "Lew 21:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.44.22"
              },
              "items": [
                {
                  "text": "Ezk 44:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire uwābira maraya muri bo, cank’ uwamaze kwononekara, kandi ntihagire uwābīra uwirukanywe n’umugabo wiwe: kuk’ umuherezi ar’ uwera kuri jewe, Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.7",
            "verseOrgIds": [
              "LEV.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 21:8"
          },
          "items": [
