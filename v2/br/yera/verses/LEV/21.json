            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "canke ngo binamusohokane ngw ave Ahēra, canke ngw ahumanye Ahēra hanje Imana yiwe; kukw ibango yaheshejwe no kurobanuzwa amavuta yanje Imana yiwe riri kuri we: ni jewe Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.12",
            "verseOrgIds": [
              "LEV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
