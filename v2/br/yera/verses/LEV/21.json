            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Barira Aroni, ut’ Umuntu wese azoba afise agasembga wo mu ruvyaro rwawe, ukw ibihe vy’ urunganwe rwanyu bizogenda bikurikirana, ntaze yēgēre ngw ampēreze imfungurwa, jewe Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.21.17",
            "verseOrgIds": [
              "LEV.21.17"
            ]
          }
        },
        {
