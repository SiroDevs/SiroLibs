              },
              "items": [
                {
                  "text": "Lew 21:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo ntaz’ atume uruvyaro rwiwe ruhinduka uruhumanye mu bgoko bgabo: kukw ari jewe Uhoraho ndamweza.",
          "type": "text",
          "attrs": {
