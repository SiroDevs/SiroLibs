            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.1+ACT.16.2+ACT.16.3"
              },
              "items": [
                {
                  "text": "Ivyak 16:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "dutuma Timoteyo, mwene Data, umukozi w’Imana agabura ubutumwa bgiza bga Kristo, ngw abakomeze abaremeshe ku vy’ ukwizera kwanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.2",
            "verseOrgIds": [
              "1TH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
