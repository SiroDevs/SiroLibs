              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko tutagishoboye kwihangana, dushima gusigara twenyene muri Atenayi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.3.1",
            "verseOrgIds": [
              "1TH.3.1"
            ]
          }
        },
