              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bituma muba icitegererezo c’abizera bose bar’ i Makedoniya no muri Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.7",
            "verseOrgIds": [
              "1TH.1.7"
            ]
