              "type": "text"
            }
          ]
        },
        {
          "text": "Mwese tubashimira Imana imisi yose, tubahoza mu kanwa uko dusenze, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.2",
            "verseOrgIds": [
              "1TH.1.2"
