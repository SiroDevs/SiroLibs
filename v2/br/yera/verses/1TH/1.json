                "loc": "1CO.2.5"
              },
              "items": [
                {
                  "text": "1 Kor 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ ubutumwa bgacu butābashitseko ar’ amajambo yonyene ariko bgarimwo n’ubushobozi na Mpwemu Yera, no kumara amazinda rwose; namwe murazi ubugene twari tumeze hagati muri mwebge kubganyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.5",
            "verseOrgIds": [
              "1TH.1.5"
            ]
          }
        },
