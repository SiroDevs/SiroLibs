            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe mwaratwīgānye, mwīgāna n’Umwami wacu, mumaze kwakīrira ijambo ry’Imana mu marushwa menshi, munezerejwe na Mpwemu Yera, ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.1.6",
            "verseOrgIds": [
              "1TH.1.6"
            ]
          }
        },
