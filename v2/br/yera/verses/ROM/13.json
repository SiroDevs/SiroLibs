          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.13+EXO.20.14+EXO.20.15+EXO.20.16+EXO.20.17"
              },
              "items": [
                {
                  "text": "Kuv 20:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.18"
