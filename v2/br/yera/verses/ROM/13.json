              "attrs": {
                "loc": "GAL.3.27"
              },
              "items": [
                {
                  "text": "Gal 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwambare Umwami Yesu Kristo, kandi ntimubabare ivy’ umubiri, ngo mukore ivyo wifuza.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.14",
            "verseOrgIds": [
              "ROM.13.14"
            ]
          }
