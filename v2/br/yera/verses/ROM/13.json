                "loc": "DEU.5.17"
              },
              "items": [
                {
                  "text": "Gus 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ibi, ngo Ntugasambane, ntukice, ntukibe, ntukifuze, n’ikindi cagezwe cose, bipoperanirijwe mur’ iri jambo, ng’ Ukunde mugenzawe nk’uko wikunda. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.9",
            "verseOrgIds": [
              "ROM.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.4"
              },
              "items": [
                {
                  "text": "1 Kor 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.40"
              },
              "items": [
                {
                  "text": "Mat 22:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūfise urukundo ntagirira mugenzi we nabi: ni co gituma urukundo ari rwo rushitsa ivyagezwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.10",
            "verseOrgIds": [
              "ROM.13.10"
            ]
          }
        }
      ]
