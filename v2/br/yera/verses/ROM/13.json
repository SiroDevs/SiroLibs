              "attrs": {
                "loc": "LUK.21.34"
              },
              "items": [
                {
                  "text": "Luk 21:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.18"
              },
              "items": [
                {
                  "text": "Ef 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tugendane ingeso nziza, nk’abagenda ku murango, tutadandahirwa, tutaborerwa, tudasambana, tudakora ivy’ isoni nke, tudatongana, tutagira ishari. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.13",
            "verseOrgIds": [
              "ROM.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
