            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwame mugenza murtyo, kuko muzi imisi, yukw igihe gishitse co kwikangura. Non’ agakiza kacu karatwēgereye, kurusha igihe twizereye. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.11",
            "verseOrgIds": [
              "ROM.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
