              "items": [
                {
                  "text": "2 Tim 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoro rirakuze, bugira buce. Nuko twiyambure ibikorwa vy’umwiza, twambare ibirwanishwa vy’umuco. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.13.12",
            "verseOrgIds": [
              "ROM.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
