          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbashimiye Foyibe mwene Data, ni we mukozi w’ishengero ry’i Kenkireya, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.1",
            "verseOrgIds": [
              "ROM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo mumwākīre kubg’ Umwami wacu, nk’uko bibereye abera, kandi mumufashe ku c’azogomba cose, kuko na we yafashije benshi, barimwo jewe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.2",
            "verseOrgIds": [
              "ROM.16.2"
            ]
          }
        }
      ]
    },
    {
