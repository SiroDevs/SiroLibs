            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu bg’Umwami wacu Yesu Kristo bubane namwe.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.20",
            "verseOrgIds": [
              "ROM.16.20"
            ]
          }
        },
