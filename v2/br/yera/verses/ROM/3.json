                  "text": "Ef 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "batsindanishirizwa n’ubuntu bgayo, ibibahereye ubusa, kubgo gucungurwa kubonerwa muri Kristo Yesu: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.24",
            "verseOrgIds": [
              "ROM.3.24"
            ]
