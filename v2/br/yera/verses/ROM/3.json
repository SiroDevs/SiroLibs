            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma twiyumvira yuk’ umuntu atsindanishirizwa n’ukwizera, ibikorwa bibgirijwe n’ivyagezwe bitarinze kwiyumvirwa. ",
          "type": "text",
