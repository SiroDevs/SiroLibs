                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo Imana yashizeho kuba impongano y’uwizera, ayigirwa n’amaraso yiwe, kugira ngw Imana yerekane ukugororoka kwayo, kuko yirengagije ivyaha vyakozwe kera kubg’ imbabazi zayo; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.25",
            "verseOrgIds": [
              "ROM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
