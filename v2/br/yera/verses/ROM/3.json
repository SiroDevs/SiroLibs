          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kugira ngo yerekane ukugororoka kwayo mur’ iki gihe, ngw ibe Īgororoka n’Ītsindanishiriza uwizeye Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.26",
            "verseOrgIds": [
