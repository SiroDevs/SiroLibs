          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ukugororoka kuva ku Mana, kuzanwa no kwizera Yesu Kristo, kugira ngw abizeye bose baguhabge. Kukw ata tandukaniro; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.22",
            "verseOrgIds": [
              "ROM.3.22"
            ]
          }
        },
        {
