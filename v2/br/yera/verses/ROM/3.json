              "items": [
                {
                  "text": "2 Tim 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuvuge iki? Naho bamwe batizeye, mbega kutizera kwabo kuzohindura ubusa ivy’ Imana yizigiweko? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.3",
            "verseOrgIds": [
              "ROM.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biragahera: arikw Imana iboneke kw ar’ inyakuri, n’iy’umuntu wese yoba ar’ umubeshi: nk’uko handitswe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.4",
            "verseOrgIds": [
              "ROM.3.4"
            ]
          }
        }
      ]
    },
