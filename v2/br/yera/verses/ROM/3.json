          "items": [
            {
              "text": "\n        Rom 1:18—2:24.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko tuvuge iki? Mbega turuta abandi? Oya, ntitubaruta na gatoya, kuko tumaze kwagiriza Abayuda n’Abagiriki bose ko baganzwa n’icaha: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.9",
            "verseOrgIds": [
              "ROM.3.9"
            ]
          }
        },
