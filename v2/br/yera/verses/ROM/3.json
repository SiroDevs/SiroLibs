        },
        {
          "text": "Arabibarusha vyose. Ica mbere, n’ukw Abayuda bābikijwe ivyavuzwe n’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.2",
            "verseOrgIds": [
