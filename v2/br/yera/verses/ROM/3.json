            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw imbere yayo ata muntu azotsindanishirizwa n’ibikorwa bibgirijwe n’ivyagezwe, kukw ivyagezwe ari vyo bimenyekanisha icaha.",
          "type": "text",
