        },
        {
          "text": "Ariko noneh’ ivyagezwe bitariho, ukugororoka kuva ku Mana kurahishuwe, gushingirwa intahe n’ivyagezwe n’ivy’ abāvugishwa n’Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.3.21",
            "verseOrgIds": [
              "ROM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
