              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Imana ishimwe yuko naho mwar’ abagurano b’icaha, mwumviye mu mitima uburyo bgo kwigishwa mwahawe: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.17",
            "verseOrgIds": [
              "ROM.6.17"
            ]
          }
        },
