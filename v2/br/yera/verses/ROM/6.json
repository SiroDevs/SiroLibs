                "loc": "ROM.3.5+ROM.3.6+ROM.3.7+ROM.3.8"
              },
              "items": [
                {
                  "text": "Rom 3:5-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko tuvuge iki? Mbega twame dukora ivyaha kugira ng’ubuntu bg’Imana bugwire? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.1",
            "verseOrgIds": [
              "ROM.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.4.1"
              },
              "items": [
                {
                  "text": "1 Pet 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biragahera. Twebge twapfuye ku caha, twoba tukikibamwo dute? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.2",
            "verseOrgIds": [
              "ROM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.27"
              },
              "items": [
                {
                  "text": "Gal 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke ntimuzi yuko twese abābatirijwe kuba muri Kristo Yesu, twabatirijwe kuba mu rupfu rwiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.3",
            "verseOrgIds": [
              "ROM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.3.21"
              },
              "items": [
                {
                  "text": "1 Pet 3:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.12"
              },
              "items": [
                {
                  "text": "Kol 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero kubatizwa kwatumye duhambanwa na we tuba mu rupfu rwiwe, kugira ngo, nk’uko Kristo yazuwe mu bapfuye n’ubgiza bga Data wa twese, abe ari ko natwe tugendana ubugingo busha.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.4",
            "verseOrgIds": [
              "ROM.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
