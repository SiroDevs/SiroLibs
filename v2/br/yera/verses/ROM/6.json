        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.1"
              },
              "items": [
                {
                  "text": "Rom 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.5"
              },
              "items": [
                {
                  "text": "Ef 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.14"
              },
              "items": [
                {
                  "text": "5:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntimugahe icaha imibiri yanyu ngw ikoreshwe n’ukugabitanya; ariko mwishikanire Imana nk’abazuke bavuye mu bapfuye, n’imibiri yanyu muyihe Imana kugira ngw ikoreshwe no kugororoka. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.13",
            "verseOrgIds": [
              "ROM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.6"
              },
              "items": [
                {
                  "text": "1 Yoh 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icaha ntikizobaganza, kuko mutaganzwa n’ivyagezwe, ariko muganzwa n’ubuntu.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.14",
            "verseOrgIds": [
              "ROM.6.14"
            ]
          }
        }
      ]
