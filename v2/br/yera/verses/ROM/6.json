                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rer’ icaha ntikikabe ku ngoma mu mibiri yanyu izopfa, ngo mwumvire ivyo yifuza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.12",
            "verseOrgIds": [
              "ROM.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
