            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko tugire dute? Mbega dukore ivyaha, kuko tutaganzwa n’ivyagezwe, ariko tuganzwa n’ubuntu? Biragahera. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.6.15",
            "verseOrgIds": [
              "ROM.6.15"
            ]
          }
        },
