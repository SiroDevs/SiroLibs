          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni naheraheza ivyo, mmaze kubashikiriza neza izo mbuto z’ubuntu, nzovayo, nce i wanyu, nje i Sipaniya. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.28",
            "verseOrgIds": [
