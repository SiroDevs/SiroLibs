      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twebge abakomeye dukwiye kwihanganira intege nke z’abadakomeye, no kutinezereza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.1",
            "verseOrgIds": [
              "ROM.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.19"
              },
              "items": [
                {
                  "text": "1 Kor 9:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.24"
              },
              "items": [
                {
                  "text": "10:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese muri twebge anezereze mugenzi we, kugira ngw abone ivyiza, akomezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.2",
            "verseOrgIds": [
              "ROM.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Zab 69:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko na Kristo atinejereje, nk’uko handitswe, ngw Ibitutsi vy’abāgutuka vyaguye kuri jewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.3",
            "verseOrgIds": [
              "ROM.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.23"
              },
              "items": [
                {
                  "text": "Rom 4:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.11"
              },
              "items": [
                {
                  "text": "1 Kor 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyanditswe kera vyose vyandikiwe kutwigisha, kugira ngo kwihangana no guhumurizwa guheshwa n’ivyanditswe biduhe kwizigira ibizoba. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.4",
            "verseOrgIds": [
              "ROM.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.16"
              },
              "items": [
                {
                  "text": "Flp 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Imana itanga ukwihangana n’uguhumurizwa ibahe guhūza imitima yanyu, nk’uko Kristo Yesu agomba, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.5",
            "verseOrgIds": [
              "ROM.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo muhimbaze n’umutima umwe n’akanwa kamwe Imana y’Umwami wacu Yesu Kristo, ni yo Se.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.6",
            "verseOrgIds": [
              "ROM.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwemerane, nk’uko Kristo na we yabemeye, kugira ngw Imana ishimishwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.7",
            "verseOrgIds": [
              "ROM.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.24"
              },
              "items": [
                {
                  "text": "Mat 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.25"
              },
              "items": [
                {
                  "text": "Ivyak 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico mvuga n’uko Kristo yacitse umukozi w’abākebge wo kubagaburira ivy’ Imana, kubg’ ukuri kwayo, kugira ngw ashitse ivyo ba sogokuruza bāsezeraniwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.8",
            "verseOrgIds": [
              "ROM.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngw abanyamahanga bahimbarize Imana imbabazi zayo, nk’uko handitswe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.9",
            "verseOrgIds": [
              "ROM.15.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.13",
            "verseOrgIds": [
              "ROM.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, nanje nyene ndazi ivyanyu ntakekeranya, yuko mwuzuye ineza, mwuzuye ubgenge bgose, mushobora no guhanūrana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.14",
            "verseOrgIds": [
              "ROM.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.5"
              },
              "items": [
                {
                  "text": "Rom 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mbandikiye hamwe-hamwe ndushirije gushira amanga, nk’ūbibutsa, kubg’ ubuntu nahawe n’Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.15",
            "verseOrgIds": [
              "ROM.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.13"
              },
              "items": [
                {
                  "text": "Rom 11:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.17"
              },
              "items": [
                {
                  "text": "Flp 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo mbe umusuku wa Kristo Yesu ku banyamahanga, nsukūrira ubutumwa bgiza bg’Imana nk’umuherezi, kugira ngw abanyamahanga babe ikimazi gishimwa, cejejwe na Mpwemu Yera. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.16",
            "verseOrgIds": [
              "ROM.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mfise ukwirata mu vy’Imana muri Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.17",
            "verseOrgIds": [
              "ROM.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.5"
              },
              "items": [
                {
                  "text": "2 Kor 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sinzotinyuka kuvuga ikintu na kimwe atar’ ico nakoreshejwe na Kristo, kugira ngw abanyamahanga baganduke, ampaye amajambo n’ibikorwa, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.18",
            "verseOrgIds": [
              "ROM.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ROM 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.16.17"
              },
              "items": [
                {
                  "text": "Mrk 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ubushobozi bg’ibimenyetso bikomeye, n’ibitangaza, n’ubushobozi bga Mpwemu Yera. Ivyo vyatumye nshitsa ubutumwa bga Kristo, utanguriye i Yerusalemu, ugakikuza, ugashika no muri Iluriko, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.19",
            "verseOrgIds": [
              "ROM.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ROM 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.15"
              },
              "items": [
                {
                  "text": "2 Kor 10:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "namanye imigabo yo kuvuga ubutumwa bgiza, ah’ izina rya Kristo ritaribgamenyekane, ngo sinubake kw itanguriro ryubatswe n’uwundi: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.20",
            "verseOrgIds": [
              "ROM.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ROM 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "yamara ngo bimere nk’uko handitswe,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.15.21",
            "verseOrgIds": [
              "ROM.15.21"
            ]
          }
        }
      ]
    },
