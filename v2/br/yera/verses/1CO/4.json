          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo simvyandikiye kubatetereza, ariko ni nko kubahanūra, nk’abana banje nkunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.14",
            "verseOrgIds": [
              "1CO.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CO 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.19"
              },
              "items": [
                {
                  "text": "Gal 4:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko naho mufise muri Kristo ababarera ibihumbi cumi, ntimufise ba so benshi, kukw ari jewe nabavyaje ubutumwa bgiza muri Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.15",
            "verseOrgIds": [
              "1CO.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CO 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.11.1"
              },
              "items": [
                {
                  "text": "1 Kor 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndabinginga, munyigāne. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.16",
            "verseOrgIds": [
              "1CO.4.16"
            ]
          }
        },
        {
