            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "dukoresha amaboko yacu tugatama: iyo badutuka turabahezagira, iyo baduhama turihangana, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.12",
            "verseOrgIds": [
              "1CO.4.12"
            ]
          }
        },
        {
