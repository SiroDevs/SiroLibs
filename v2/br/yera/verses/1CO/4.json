          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo batwambika ibara turabahōyahōya. Twahindutse umwavu w’isi, n’udukokorwa kuri bose gushitsa n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.13",
