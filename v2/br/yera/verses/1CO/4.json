                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "Rom 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, bene Data, ivyo mvyigereranijeko, jewe na Apolo, kubganyu, nk’igishushanyo: kugira ngw ivyo mvuze kuri twebge bibigishe kutarenga ivyanditswe; ntihagire umuntu yikakisha arwana ishaka ry’umwe akagaya uwundi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.6",
            "verseOrgIds": [
              "1CO.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.6"
              },
              "items": [
                {
                  "text": "Rom 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde aguteye kwitandukanya n’abandi? Kand’ ic’ ufise utāhawe n’igiki? Ariko namba waragihawe, n’iki gituma wirata, nk’ūtāgihawe?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.7",
            "verseOrgIds": [
              "1CO.4.7"
            ]
          }
        }
      ]
    },
    {
