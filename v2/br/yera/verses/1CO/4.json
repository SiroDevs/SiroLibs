                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumaze guhāga; mumaze gutunga; mwimye nk’abami, tutarimwo: ereg’ icompa mukaba mwārīmye, kugira ngo natwe twimane namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.8",
            "verseOrgIds": [
              "1CO.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.36"
              },
              "items": [
                {
                  "text": "Rom 8:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.33"
              },
              "items": [
                {
                  "text": "Heb 10:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko niyumvira yuko twebge intumwa, Imana yatwerekanye nk’abari hasi inyuma ya bose, nk’abagerewe kwicwa, kuko twacitse akābarore mw isi, mu bamarayika no mu bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.9",
            "verseOrgIds": [
              "1CO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.18"
              },
              "items": [
                {
                  "text": "1 Kor 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twebge tur’ ibipfu kubga Kristo; mweho mur’ abanyabgenge muri Kristo: tur’ abanyantege nke, mur’ abanyabushobozi: mur’ abanyacubahiro, tur’ inkēngērwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.10",
            "verseOrgIds": [
              "1CO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.23+2CO.11.24+2CO.11.25+2CO.11.26+2CO.11.27"
              },
              "items": [
                {
                  "text": "2 Kor 11:23-27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gushitsa n’ubu twishwe n’inzara n’inyota, twambaye ubusa, dukubitwa ibipfunsi, tubura uburagamo, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.11",
            "verseOrgIds": [
              "1CO.4.11"
            ]
          }
        },
        {
