            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.7"
              },
              "items": [
                {
                  "text": "Tit 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu n’atwiyumvire yuko tur’ abasuku ba Kristo, n’ababgiriza b’amabanga y’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.1",
            "verseOrgIds": [
              "1CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.42"
              },
              "items": [
                {
                  "text": "Luk 12:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ababgiriza babagomba ko baboneka ar’ abizigirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.2",
            "verseOrgIds": [
              "1CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko kubganje ni nk’ubusa rwose gucirwa urubanza namwe, canke n’urukinja rw’abantu; kandi nanje nyene sinicira urubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.3",
            "verseOrgIds": [
              "1CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.143.2"
              },
              "items": [
                {
                  "text": "Zab 143:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ata co niyiziko, ariko si co kintsindishiriza; arik’ ūncira urubanza n’Umwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.4",
            "verseOrgIds": [
              "1CO.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.3.8"
              },
              "items": [
                {
                  "text": "1 Kor 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma mudakwiye guca urubanza rw’ikintu na kimwe igihe carwo kitarashika, ni co kuza kw’Umwami wacu, azomurika ivyari vyanyegejwe mu mwiza, kand’ azogaragaza inama zo mu mitima: ni ho umuntu wese azohabga n’Imana ishimwe rimukwiye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.5",
            "verseOrgIds": [
              "1CO.4.5"
            ]
          }
        }
      ]
    },
    {
