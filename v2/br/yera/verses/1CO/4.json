              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bamwe bīkakīsha, biyumvira yuko ntazoza i wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.4.18",
            "verseOrgIds": [
