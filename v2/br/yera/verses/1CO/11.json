                {
                  "text": "1 Tes 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma muri mwebge benshi bagira intege nke, abandi bakarwaragurika, kand’ abatari bake bakaba bārapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.30",
            "verseOrgIds": [
              "1CO.11.30"
            ]
          }
        },
