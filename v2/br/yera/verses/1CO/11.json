                  "text": "Mat 26:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko murya uwo mutsima kand’ uko munywera kur’ ico gikombe, muba mumenyekanisha urupfu rw’Umwami wacu, kugeza ah’ azozira.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.26",
