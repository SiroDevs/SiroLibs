              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko, bene Data, uko mukoraniye kurya, murorērane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.33",
            "verseOrgIds": [
              "1CO.11.33"
