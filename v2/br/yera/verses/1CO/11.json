                  "text": "Zek 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’igikombe akigenza artyo, bahejeje kurya, arababgira, at’ Iki gikombe n’isezerano risha ryo mu maraso yanje; murahora mugira murtya uko muzonywako, kugira ngo kibe icibutso canje. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.25",
            "verseOrgIds": [
              "1CO.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
