              },
              "items": [
                {
                  "text": "Flp 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munyigāne, nk’uko nanje nīgāna Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.11.1",
            "verseOrgIds": [
              "1CO.11.1"
            ]
          }
