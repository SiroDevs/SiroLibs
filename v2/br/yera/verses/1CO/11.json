              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw iyo dutsinzwe n’urubanza duhanwa n’Umwami, kugira ngo ntituze dutsindwe n’urubanza rudashira hamwe n’ab’ isi.",
          "type": "text",
          "attrs": {
