              "items": [
                {
                  "text": "Ivyah 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nugururiwe urugi runini ruja mu bikorwa bikomeye, kand’ abarwanizi bakaba benshi.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.9",
            "verseOrgIds": [
