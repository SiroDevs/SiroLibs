                "loc": "ACT.19.1"
              },
              "items": [
                {
                  "text": "Ivyak 19:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
