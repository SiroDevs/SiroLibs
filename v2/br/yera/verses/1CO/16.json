                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko namwe mugāmburukire abameze bartyo, n’uwundi wese afatanije n’abandi mur’ ico gikorwa, agatama. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.16.16",
            "verseOrgIds": [
