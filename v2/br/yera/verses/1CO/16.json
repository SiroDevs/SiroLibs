                {
                  "text": "1 Tim 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ntihaze hagire ūmukēngēra, ariko muze mumuherekeze mumusezere amahoro, az’ ansange ino, kuko niteze kw azozanana na bene Data.",
          "type": "text",
          "attrs": {
