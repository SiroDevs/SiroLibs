          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.3"
              },
              "items": [
                {
                  "text": "2 Kor 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.16"
              },
              "items": [
                {
                  "text": "Rom 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ijambo ry’umusaraba ku bahona ar’ ubupfu, ariko kuri twebge abakizwa n’ubushobozi bg’Imana. ",
          "type": "text",
