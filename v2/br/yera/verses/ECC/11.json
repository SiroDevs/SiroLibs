                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.12.14"
              },
              "items": [
                {
                  "text": "12:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe wa musore, nezererwa ubusore bgawe, kand’ umutima wawe ukunezereze mu misi y’ubusore bgawe, kand’ ugendere mu nzira z’umutima wawe, no mu kurāba kw’amaso yawe: ariko wame ubizi yukw Imana izogushira mu rubanza rw’ivyo vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.7.1"
              },
              "items": [
                {
                  "text": "2 Kor 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko kūra amaganya mu mutima wawe, kand’ ushire ikibi kure y’umubiri wawe: kuk’ ubuto n’ubusore ar’ ubusa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
