              "items": [
                {
                  "text": "Yob 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.22"
              },
              "items": [
                {
                  "text": "Umus 3:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.13"
              },
              "items": [
                {
                  "text": "8:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ni nde yomenya ico umuntu akwiye mu kubaho kwiwe, imisi yose y’ ukubaho kwiwe kw’ubusa, amara ari nk’igitūtu? None ni nde yobarira umuntu ibizoba inyuma yiwe musi y’izuba?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
