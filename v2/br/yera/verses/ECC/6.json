                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubutame bgose bg’umuntu buterwa n’inda yiwe, yamara ntashira umuryarya. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.2.15"
              },
              "items": [
                {
                  "text": "Umus 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Non’ umunyabgenge arusha iki igipfu? Cank’ impahazwa izi kwitunganya imbere y’abariho biyimariye iki? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubonesha amaso biruta kwangaza umutima: ivyo na vyo nyene n’ubusa, no guhahamira umuyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
