              "type": "text"
            }
          ]
        },
        {
          "text": "Har’ ikibi nabonye musi y’izuba kiremereye abantu: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
