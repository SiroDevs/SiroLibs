          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.7.23"
              },
              "items": [
                {
                  "text": "Imig 7:23",
                  "type": "text"
