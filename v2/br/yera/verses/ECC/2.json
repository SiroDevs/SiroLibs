            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.7"
              },
              "items": [
                {
                  "text": "Yob 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.13"
              },
              "items": [
                {
                  "text": "Umus 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw imisi yiwe yose ar’ imibabaro, kand’ umuruho wiwe ar’ intuntu; mbere no mw ijoro na ho umutima wiwe nturonka akaruhuko. Ivyo na vyo nyene n’ubusa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        }
