              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ni nde ashobora kurya, canke ni nde ashobora kugira umunezero kurusha jewe? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
