                "loc": "1KI.12.13"
              },
              "items": [
                {
                  "text": "1 Abam 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
