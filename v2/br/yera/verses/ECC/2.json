              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi naciye nanka ubutame bganje bgose, ubgo natamiye musi y’izuba: kuko nzoba nkwiye kubisigarana ūzonkurikira. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 2:19"
          },
          "items": [
