              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni nde yomenya yuk’ uyo azoba umunyabgenge cank’ igipfu? Yamar’ azoganza ivyavuye mu butame bganje bgose ivyo natamiye, nkerekaniramw’ ubgenge musi y’ izuba. Ivyo na vyo nyene n’ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bituma nisubiramwo mpebuza umutima wanje ku vy’ubutame bganje bgose, ivyo natamiye musi y’izuba. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.20",
            "verseOrgIds": [
              "ECC.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umuntu mu butame bgiwe ari n’ubgenge n’ukumenya n’uburyo; yamar’ azobisigarana uwundi atābitamiye, bibe umugabane wiwe. Ivyo na vyo nyene n’ubusa, kandi n’ibara. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.21",
            "verseOrgIds": [
              "ECC.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.3"
              },
              "items": [
                {
                  "text": "Umus 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None se, umuntu akūra iki mu butame bgiwe bgose, no mu mwitwaririko w’umutima wiwe, mu vyo yaruhiyemwo musi y’izuba? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
