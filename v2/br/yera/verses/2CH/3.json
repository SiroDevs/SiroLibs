            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.15+1KI.7.16+1KI.7.17+1KI.7.18+1KI.7.19+1KI.7.20"
              },
              "items": [
                {
                  "text": "1 Abam 7:15-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.17"
              },
              "items": [
                {
                  "text": "2 Abam 25:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arondera inkingi zibiri zo gushinga imbere y’iyo ngoro; uburebure bgazo bgar’ amatambge mirongwitatu n’atanu y’ ukuboko uciriye mu nkokora; imyashi yazo, uburebure bg’ umwe‐umwe bgar’ amatambge atanu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.15",
            "verseOrgIds": [
              "2CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acura n’imigufu nk’ iyashizwe Ahēra Cane, ayishira mu mitwe y’izo nkingi; acura n’ ibisa n’amakomamanga, abidombagiza kur’ iyo migufu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.16",
            "verseOrgIds": [
              "2CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.21"
              },
              "items": [
                {
                  "text": "1 Abam 7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ashinga izo nkingi imbere y’ urusengero, imwe i buryo n’ iyindi i bumoso; iy’ i buryo ayita Yakini, iy’ i bumoso ayita Bowazi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.3.17",
            "verseOrgIds": [
              "2CH.3.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:17",
              "type": "text"
            },
            {
              "text": "Yakini risobanurwa ngw Azobikomeza; Bowazi risobanurwa ngo Ni we arimw’ inkomezi.",
              "type": "text"
            }
          ]
        }
      ]
    }
