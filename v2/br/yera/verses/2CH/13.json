                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yerobowamu mwene Nebati, umushumba wa Salomo mwene Dawidi, yarahagurutse agarariza shebuja. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.6",
            "verseOrgIds": [
              "2CH.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.20.1"
              },
              "items": [
                {
                  "text": "2 Sam 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.13"
              },
              "items": [
                {
                  "text": "2 Ngo 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu b’imburakimazi kandi b’inshirukanya bakoranira kuri we, baraheza binantaza kuri Rehobowamu mwene Salomo, igihe Rehobowamu yar’ akiri muto, akiri seniryo, adashobora kubahagarara imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.7",
            "verseOrgIds": [
              "2CH.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Abam 12:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Non’ ehe muriyumvira ko muzotsinda ubgami bg’Uhoraho buri mu maboko ya bene Dawidi, kuko mur’ amasinzi n’amasinzi, mukaba mufise n’ibishushanyo vy’amamasa vy’izahabu, ivyo Yerobowamu yabacurishirije ngo bibe imana zanyu! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.8",
            "verseOrgIds": [
              "2CH.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.11.14"
              },
              "items": [
                {
                  "text": "2 Ngo 11:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
