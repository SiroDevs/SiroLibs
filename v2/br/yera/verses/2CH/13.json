          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yerobowamu yari yarekuye abaja kubaca igico, ngo babaturuke inyuma; nuko bamwe basigara bahanganye n’Abayuda, ababaciye igico babaturuka inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.13",
