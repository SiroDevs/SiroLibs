                "loc": "HOS.8.6"
              },
              "items": [
                {
                  "text": "Hos 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntimwirukanye abaherezi b’Uhoraho bo mu ba Aroni, n’Abalewi, mukīronderera abandi baherezi nk’ ukw imigenzo y’amahanga yo mu bindi bihugu imeze? Ereg’ ūpfuye kwihitanira imasa y’umukangara n’amasuguru ndwi y’intama ngw arobanurwe, muca mumwemerera ubuherezi bg’imana zitar’ Imana! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.9",
            "verseOrgIds": [
              "2CH.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko tweho, Uhoraho ni we Mana yacu, kandi ntitwamuvuyeko; kand’ abaherezi b’ Uhoraho dufise n’abo kuri Aroni, n’Abalewi baracari ku mabango yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.10",
            "verseOrgIds": [
              "2CH.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39"
              },
              "items": [
                {
                  "text": "Kuv 25:31-39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.4"
              },
              "items": [
                {
                  "text": "2 Ngo 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bama bosereza Uhoraho ibimazi uko bukeye uko bgije, bakamwosereza n’imibavu itāmirana, bagatondesha n’imitsima y’ ibiterekērwa ku meza yacuzwe mw izahabu iramuye, kand’ uko bgije bakadomeka n’amatara ari ku gitereko cayo c’izahabu; kuko tweho twitondera ivyagezwe vy’ Uhoraho Imana yacu, ariko mweho mwaramuvuyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.11",
            "verseOrgIds": [
              "2CH.13.11"
            ]
          }
        },
        {
