              "items": [
                {
                  "text": "Ivyak 5:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ehe rāba, Imana iri kumwe natwe itugiye imbere, kandi n’abaherezi bayo bafise inzumbete z’intabaza, biteguye kuzivuza ngo turwane namwe. Yemwe Bisirayeli, ntimurwanye Uhoraho Imana ya ba sogokuruza, kuko mutazotsinda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.12",
            "verseOrgIds": [
              "2CH.13.12"
            ]
          }
        }
      ]
