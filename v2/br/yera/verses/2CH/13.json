              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbega ntimwari mukwiye kumenya yuk’ Uhoraho Imana y’Abisirayeli yahaye Dawidi n’abahungu biwe ubgami, ngo baze baganze Abisirayeli kuzoshitsa ibihe bidashira, abisezeranishije isezerano ritazohinduka?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:5",
              "type": "text"
            },
            {
              "text": "isezerano ritazohinduka",
              "type": "text"
            },
            {
              "text": ": mu Giheburayo handitswe, ngw Isezerano ry’umunyu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.13.5",
            "verseOrgIds": [
              "2CH.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
