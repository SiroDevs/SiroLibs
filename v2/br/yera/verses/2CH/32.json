                "loc": "ISA.39.1"
              },
              "items": [
                {
                  "text": "Yes 39:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ku vy’intumwa abaganwa b’i Babuloni bamutumyeko, ngo bamubaze igitangaza cabayeho mu gihugu ciwe, Imana iramureka ngw imugerageze, kugira ngw imenye ivyari mu mutima wiwe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        }
