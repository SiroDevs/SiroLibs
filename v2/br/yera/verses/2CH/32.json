                  "text": "Yes 38:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ iyo misi Hezekiya ararwara agera hafi yo gupfa. Asenga Uhoraho, na we aramwishura, amuha n’ikimenyamenya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.24",
            "verseOrgIds": [
              "2CH.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
