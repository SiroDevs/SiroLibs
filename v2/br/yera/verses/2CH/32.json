            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Hezekiya uwo agomera isōko yo haruguru y’amazi y’i Gihoni, akwega umūzi wayo, ayamanukana ku ruhande rw’igisagara ca Dawidi ruhera i burengerazuba. Nuko Hezekiya ivyo yakora vyose bimubera ko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.30",
            "verseOrgIds": [
              "2CH.32.30"
            ]
          }
        },
