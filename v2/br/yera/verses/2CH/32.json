          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.26.16"
              },
              "items": [
                {
                  "text": "2 Ngo 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Hezekiya, ubuntu yagiriwe ntiyabumwishura, kuko yaciye yishira hejuru mu mutima; kubg’ ivyo uburake bg’Uhoraho buza kuri we no ku Bayuda no kuri Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.25",
            "verseOrgIds": [
              "2CH.32.25"
            ]
          }
        },
        {
          "name": "verse",
