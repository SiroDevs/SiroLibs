            {
              "text": "36:1—39:8.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ibindi vyose vyadonzwe kuri Hezekiya, n’ivyiza yakoze, vyanditswe mu vyo uwavugishwa n’Imana Yesaya mwene Amosi yeretswe, no mu gitabo c’abami b’Abayuda n’ab’ Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
