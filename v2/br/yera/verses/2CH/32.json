            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Hezekiya yicisha bugufi, yihana ubgo bgibone bgo mu mutima wiwe, ubgiwe n’ababa i Yerusalemu, bituma uburake bg’Uhoraho butabashikīra ku ngoma ya Hezekiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.26",
            "verseOrgIds": [
              "2CH.32.26"
            ]
          }
        }
