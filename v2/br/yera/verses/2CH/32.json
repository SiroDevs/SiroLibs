                {
                  "text": "Gus 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.12"
              },
              "items": [
                {
                  "text": "2 Abam 20:12",
