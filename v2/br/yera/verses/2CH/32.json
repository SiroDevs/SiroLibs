              },
              "items": [
                {
                  "text": "2 Abam 20:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya ahamvya ba sekuruza, bamuhamba ahadūga haja mu mva z’abuzukuruza ba Dawidi; aho yatanga, Abayuda bose n’ab’i Yerusalemu baza kumuha icubahiro. Maz’ umuhungu wiwe Manase asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.33",
            "verseOrgIds": [
              "2CH.32.33"
            ]
          }
        }
