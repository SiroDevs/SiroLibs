            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abiya ahamvya ba sekuruza, ahambga ku murwa wa Dawidi; maz’ umuhungu wiwe Asa asubira ku ngoma yiwe. Ku ngoma yiwe igihugu kimara imyaka cumi gifise impore. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.1",
            "verseOrgIds": [
              "2CH.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 14:2"
          },
          "items": [
