                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho arwaniriza Abanyetiyopiya imbere ya Asa n’ Abayuda; abo Banyetiyopiya baca barahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.12",
            "verseOrgIds": [
              "2CH.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Asa n’ ingabo ziri kuri we barabakinagiza, babashitsa i Gerari; mu Banyetiyopiya hapfa benshi cane, ntibāba bagishobora kwigarukira, kuko bātikiriye imbere y’Uhoraho n’imbere y’ingabo ziwe. Abayuda bīronkera amasahu menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.13",
            "verseOrgIds": [
              "2CH.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.10"
              },
              "items": [
                {
                  "text": "2 Ngo 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.29"
              },
              "items": [
                {
                  "text": "20:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze batera ibisagara vyose bihereranye n’i Gerari, kukw abaho Uhoraho yari yābaciye umuhongo. Basahura ivyo bisagara vyose, baharonka amasahu menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.14",
            "verseOrgIds": [
              "2CH.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batera amahema y’abanyabitungwa, banyaga intama z’ ibitayega n’ingamiya, baraheza basubira i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.15",
            "verseOrgIds": [
              "2CH.14.15"
            ]
          }
        }
      ]
