            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Asa yar’ afise ingabo z’ Abayuda ibihumbi amajana atatu zitwaje inkinzo n’amacumu, n’iz’ Ababenyamini ibihumbi amajana abiri na mirongumunani zitwaje inkinzo kandi b’abarashi; abo bose bār’ abantu b’abahizi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.8",
            "verseOrgIds": [
              "2CH.14.8"
            ]
          }
        }
