              },
              "items": [
                {
                  "text": "1 Abam 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asa akora ivyo Uhoraho Imana yiwe abona kw ari vyiza kandi bibereye, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.2",
            "verseOrgIds": [
              "2CH.14.2"
            ]
          }
        },
