                  "text": "2 Ngo 15:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko yakūyeh’ ibicaniro vyubakiwe ibigirwamana vy’abanyamahanga bo n’ibitabo vyo ku mpinga z’imisozi, amenagura amabuye bāshinze, atemagura inkingi bāshingiye Ashera; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.3",
            "verseOrgIds": [
              "2CH.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ agera Abayuda ko barondera Uhoraho Imana ya ba sekuruza, no kwitondera ivyagezwe vyiwe n’amabgirizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.4",
            "verseOrgIds": [
              "2CH.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
