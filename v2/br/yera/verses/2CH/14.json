                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ akūra mu bisagara vyose vy’i Buyuda ibitabo bātavye n’ ibishushanyo vy’izuba. Nuko ku ngoma yiwe igihugu kigira impore. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.5",
            "verseOrgIds": [
              "2CH.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.15.15"
              },
              "items": [
                {
                  "text": "2 Ngo 15:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yubaka i Buyuda ibisagara bizitijwe inzitiro z’amabuye, kuko hār’ impore mu gihugu, kandi mur’ iyo myaka nta ntambara yarwanye, kuk’ Uhoraho yar’ amuhaye umutēkāno. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.6",
            "verseOrgIds": [
              "2CH.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yari yarabariye Abayuda, ati Ni muze twubake ibi bisagara, tuvyubakire inzitiro n’iminara, dushireh’ inzugi mu marembo n’ibihindizo; igihugu kiracar’ icacu, kuko twarondeye Uhoraho Imana yacu; twamurondeye, na we aduhaye kugira umutēkāno impande zose. Nuko barubaka, bigenda neza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.14.7",
            "verseOrgIds": [
              "2CH.14.7"
            ]
          }
        }
      ]
    },
