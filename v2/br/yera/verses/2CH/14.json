                "loc": "LEV.26.30"
              },
              "items": [
                {
                  "text": "Lew 26:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.4"
