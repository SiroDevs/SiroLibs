                "loc": "2CH.21.6"
              },
              "items": [
                {
                  "text": "21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yehoshafati yar’ afise ubutunzi bginshi n’icubahiro gihambaye. Bukeye bashingirana na Ahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.1",
            "verseOrgIds": [
              "2CH.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.2+1KI.22.3+1KI.22.4+1KI.22.5+1KI.22.6+1KI.22.7+1KI.22.8+1KI.22.9+1KI.22.10+1KI.22.11+1KI.22.12+1KI.22.13+1KI.22.14+1KI.22.15+1KI.22.16+1KI.22.17+1KI.22.18+1KI.22.19+1KI.22.20+1KI.22.21+1KI.22.22+1KI.22.23+1KI.22.24+1KI.22.25+1KI.22.26+1KI.22.27+1KI.22.28+1KI.22.29+1KI.22.30+1KI.22.31+1KI.22.32+1KI.22.33+1KI.22.34+1KI.22.35"
              },
              "items": [
                {
                  "text": "1 Abam 22:2-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashize imyaka aramanuka aja kuramutsa Ahabu i Samariya. Maze Ahabu abāgira Yehoshafati n’abari kumwe na we intama n’inka nyinshi cane; araheza aramukubakuba ngo batabarane gutera i Ramoti‐gileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.2",
            "verseOrgIds": [
              "2CH.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ahabu umwami w’Abisirayeli abaza Yehoshafati umwami w’Abayuda, ati Mbega wokwemera kuntabara, ukajana natwe i Ramoti‐gileyadi? Aramwishura, at’ Ego cane, jewe nd’ umwe nawe, n’abantu banje ni bo b’iwawe: nzogutabara mur’ iyo ntambara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.3",
            "verseOrgIds": [
              "2CH.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yehoshafati abarira umwami w’Abisirayeli, at’ Enda se banza usiguze ijambo ry’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.4",
            "verseOrgIds": [
              "2CH.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’ Abisirayeli akoranya ba kamenyi, bār’ abantu amajana ane; arababaza, ati Mbega tuje gutera i Ramoti‐gileyadi, canke dusigeho? Baramwishura, bati Dūga uhatere, kuk’ Uhoraho azohagabura mu maboko yawe, mugenzi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.5",
            "verseOrgIds": [
              "2CH.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yehoshafati arabaza, ati Mbeg’ uretse aba, nta muntu avugishwa n’Uhoraho yobaho ngo tumusiguze? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.6",
            "verseOrgIds": [
              "2CH.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami w’Abisirayeli yishura Yehoshafati, ati Haracasigaye umuntu umwe twoshobora kubaza, akadusiguriza Uhoraho; ariko ndamwanka, kukw ata ho avugishwa ivyiza kuri jewe, atar’ ivyago; yitwa Mikaya mwene Imula. Yehoshafati aramubarira, ati Sigaho mugenzi, nta co uvuga urtyo! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.7",
            "verseOrgIds": [
              "2CH.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’Abisirayeli ahamagara umuntu w’inkone, aramubarira, ati Genda unyaruka uzane Mikaya mwene Imula. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.8",
            "verseOrgIds": [
              "2CH.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umwami w’Abisirayeli na Yehoshafati umwami w’Abayuda bari bavyagiye ku ntebe zabo z’ ubgami, bambaye imyambaro yabo y’ubgami, bari ku nama kw ishikiro ry’ikirimba c’i Samariya; ba kamenyi bose bavugishirizwa imbere yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.9",
            "verseOrgIds": [
              "2CH.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Zedekiya mwene Kenayana yicurishiriza amahembe y’ivyuma, aravuga, at’ Uku ni k’Uhoraho agize, ngw Aya mahembe ni yo uzokwirukanisha Abasiriya gushitsa baherengeteye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.10",
            "verseOrgIds": [
              "2CH.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’abandi ba kamenyi bose bavugishwa bartyo, bati Dūga utere i Ramoti‐gileyadi, bizokubera ko, kuk’ Uhoraho azohagabura mu maboko yawe, mugenzi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.11",
            "verseOrgIds": [
              "2CH.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ intumwa yari yagiye guhamagara Mikaya iramubarira, it’ Abavugishwa bose bahūrije hamwe gusigurira umwami ivyiza; none rero nawe amajambo yawe n’abe nk’ayabo, uvuge ivyiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.12",
            "verseOrgIds": [
              "2CH.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.13"
              },
              "items": [
                {
                  "text": "Guh 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya aramwishura, ati Ndakurahiye uguhoraho kw’Uhoraho, ico Imana imbarira cose ni co nja kuvuga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.13",
            "verseOrgIds": [
              "2CH.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw arengutse imbere y’umwami, umwami aramubaza, ati Mikaya, tuje gutera i Ramoti‐gileyadi, canke dusigeho? Aramwishura, ati Ni mudūge mutere, bizobabera ko, kandi bazogaburwa mu maboko yanyu! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.14",
            "verseOrgIds": [
              "2CH.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramubarira, at’ Aho nakurahirije nzogeza ryari, kugira ngo ntugire ico umbarira kitar’ ic’ ukuri mw izina ry’ Uhoraho? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.15",
            "verseOrgIds": [
              "2CH.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwishura, ati Mbonye Abisirayeli bose basābagiye ku misozi nk’intama zitagira umwungere; kand’ Uhoraho agize ngo Bariya n’abatagira shebuja; ni basubire i wabo, umuntu wese yīgīre amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.16",
            "verseOrgIds": [
              "2CH.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami w’Abisirayeli abarira Yehoshafati, ati Sinakubariye kw atogira ivyiza avugishwa kuri jewe, atar’ ibibi? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.17",
            "verseOrgIds": [
              "2CH.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya arongera, ati None rero ni mwumve ijambo ry’Uhoraho: mbonye Uhoraho avyagiye ku ntebe yiwe, ingabo zose zo mw ijuru zimuhagaze i buryo n’i bumoso. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.18",
            "verseOrgIds": [
              "2CH.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho arabaza, ati Ni nde yogenda kwosha Ahabu umwami w’Abisirayeli, ngw adūge i Ramoti‐gileyadi, agweyo? Nuk’ umwe aravuga, ashira ukwiwe, uwundi ukwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.19",
            "verseOrgIds": [
              "2CH.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma haza impwemu, ihagarara imbere y’ Uhoraho, iravuga, iti Jewe ndamwosha. Uhoraho arayibaza, at’ Uja kumwosha ute? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.20",
            "verseOrgIds": [
              "2CH.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na yo iti Ndagenda nihindure impwemu y’ibinyoma mu kanwa ka ba kamenyi biwe bose. Na we arayishura, ati Nuk’ uramwosha, kand’ uzobishobora; genda ugire urtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.21",
            "verseOrgIds": [
              "2CH.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko non’ ehe rāba, Uhoraho ashize impwemu y’ibinyoma mu kanwa k’aba ba kamenyi bawe bose; kand’ akugeneye ivyago.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.22",
            "verseOrgIds": [
              "2CH.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Zedekiya mwene Kenayana yēgēra Mikaya amukubita urushi, aramubaza, at’ Iyo mpwemu y’Uhoraho yaciye hehe mu kuva muri jewe iza kuvugana nawe? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.23",
            "verseOrgIds": [
              "2CH.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya aramwishura, at’ Uzoba urabimenya ku musi uzokwitera haruguru mu mpete winyegeza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.24",
            "verseOrgIds": [
              "2CH.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami w’ Abisirayeli aravuga, ati Ni mufate Mikaya, mumushīre Amoni umukuru w’umurwa, na Yowasi umwana wanje, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.25",
            "verseOrgIds": [
              "2CH.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mut’ Umwami agize ng’ Uru rugabo murushire mw ibohero, murugaburire ivyo kurya n’amazi vy’intica ntīkize, uti Kugeza ah’ azotabarukira amahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.26",
            "verseOrgIds": [
              "2CH.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikaya aravuga, ati Ni waramuka utabarutse amahoro, Uhoraho azoba atamvugishije. Arongera ati Mwa bantu mwese, muraba muvyumvise!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.27",
            "verseOrgIds": [
              "2CH.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’Abisirayeli na Yehoshafati umwami w’Abayuda baradūga, baja gutera i Ramoti‐gileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.28",
            "verseOrgIds": [
              "2CH.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami w’Abisirayeli abarira Yehoshafati, ati Ngiye kwiyoberanya, nje mu rugamba; ariko weho ni wambare imyambaro yawe y’ubgami. Nuk’ umwami w’Abisirayeli ariyoberanya; baraheza baja mu rugamba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.29",
            "verseOrgIds": [
              "2CH.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umwami w’i Siriya yari yabariye abagabisha b’ imikogote yiwe y’intambara, ati Ntimutumbere kurasa abandi, ar’ aboroshe cank’ abahambaye, atar’ umwami w’Abisirayeli wenyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.30",
            "verseOrgIds": [
              "2CH.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bagabisha b’imikogote y’intambara babonye Yehoshafati, baravuga, bati Nguriya umwami w’Abisirayeli! Nuko barakebānuka, batumbera we; ariko Yehoshafati atura ubuku, maz’ Uhoraho Imana aramutabara, abatera kumuvako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.31",
            "verseOrgIds": [
              "2CH.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abo bagabisha b’imikogote babonye kw atar’ umwami w’Abisirayeli, barahindukira bareka kumwirukana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.32",
            "verseOrgIds": [
              "2CH.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umuntu umwe wo mu rugamba apfa kurasa, agema umwami w’Abisirayeli ah’ ivyuma bimukingīra bihūrira; aca abarira ūtumbereza umukogote wiwe, ati Hindukiza, unkūre mu rugamba, kuko nkomeretse bibi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.33",
            "verseOrgIds": [
              "2CH.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi intambara irushiriza kuba ihambaye; umwami apfa kwinanata akomeza guhagarara mu mukogote wiwe, ahangana n’Abasiriya gushitsa ku mugoroba; maze nko ku karengazuba aratanga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.18.34",
            "verseOrgIds": [
              "2CH.18.34"
            ]
          }
        }
      ]
    }
