            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ikoraniro ryose baja inama yo kwongera kumara iyindi misi mikuru ndwi; nuko bayimara banezerewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.23",
            "verseOrgIds": [
