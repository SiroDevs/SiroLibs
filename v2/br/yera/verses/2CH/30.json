              "items": [
                {
                  "text": "2 Ngo 29:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Hezekiya umwami w’Abayuda yari yahaye iryo koraniro amamasa igihumbi n’intama ibihumbi ndwi vyo gutanga kw ibimazi, abaganwa na bo bariha amamasa igihumbi nyene, n’intama ibihumbi cumi; nukw abaherezi benshi bariyeza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.24",
            "verseOrgIds": [
              "2CH.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw iryo koraniro ryose ry’Abayuda riranezerwa, bo n’abaherezi n’ Abalewi, n’ikoraniro ryose ryavuye i Bgisirayeli, n’abari baravuye mu gihugu c’i Bgisirayeli bakaza kuba i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.25",
            "verseOrgIds": [
              "2CH.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
