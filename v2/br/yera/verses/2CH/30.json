                  "text": "2 Ngo 7:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw i Yerusalemu haba akanyamuneza kenshi, kuk’ uhereye ku ngoma ya Salomo mwene Dawidi umwami w’Abisirayeli, hatāri harīgeze kuba ibihwanye n’ivyo i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.26",
            "verseOrgIds": [
              "2CH.30.26"
            ]
          }
