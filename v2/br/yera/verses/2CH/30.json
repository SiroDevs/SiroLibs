              "items": [
                {
                  "text": "2 Ngo 36:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw izo ntumwa ziragenda, zihetura ibisagara vyose vyo mu gihugu c’Abefurayimu n’ic’ Abamanase, zirinda zishika no mu c’ Abazebuloni; ariko barazitwenga cane, barazishinyagurira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.10",
            "verseOrgIds": [
              "2CH.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo bamwe bo mu Basheri no mu Bamanase no mu Bazebuloni barīhanūra, baja i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.11",
            "verseOrgIds": [
              "2CH.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’i Buyuda ukuboko kw’ Imana kubaha guhūza umutima, bumvira ico cagezwe c’umwami n’ abaganwa kivuye kw ijambo ry’ Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.12",
            "verseOrgIds": [
              "2CH.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
