        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.6"
              },
              "items": [
                {
                  "text": "Kuv 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.50"
              },
              "items": [
                {
                  "text": "1 Abam 8:50",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.46"
              },
              "items": [
                {
                  "text": "Zab 106:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.1"
              },
              "items": [
                {
                  "text": "Yer 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo Kuko ni mwahindukirira Uhoraho, ab’ i wanyu n’abana banyu bazotera akagongwe abābajanye ar’ inyagano, babarekure bagaruke mur’ iki gihugu; ngo Kuk’ Uhoraho Imana yanyu ar’ umunyabuntu kandi n’umunyembabazi, ntazobakūrakw inyonga ziwe ni mwamugarukako.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.9",
            "verseOrgIds": [
              "2CH.30.9"
            ]
          }
        }
      ]
    },
