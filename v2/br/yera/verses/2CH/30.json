                  "text": "Yoh 11:55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mur’ iryo koraniro hāri benshi batiyejeje, bituma Abalewi ari bo bagerwa kubāgira umwagazi wa Pasika umuntu wese ahumanye, kugira ngo babēreze Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.17",
            "verseOrgIds": [
              "2CH.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw abantu benshi cane batāri biyejeje, cane‐cane bār’ abo mu Befurayimu no mu Bamanase no mu Bisakari no mu Bazebuloni, bagapfa kurya ivya Pasika uburyo butemewe n’ivyanditswe. Kandi Hezekiya yari yābasengeye, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.18",
            "verseOrgIds": [
              "2CH.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Uhoraho, ari we munyabuntu, n’aharire umuntu wese ashize umutima ku kurondera Imana, ari we Uhoraho Imana ya ba sekuruza, nah’ atejejwe nk’ukw ivyagezwe vy’urusengero rwera biri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 30:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Uhoraho yumvira Hezekiya, atunga abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.20",
            "verseOrgIds": [
              "2CH.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.15"
              },
              "items": [
                {
                  "text": "Kuv 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.6"
              },
              "items": [
                {
                  "text": "13:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.22"
              },
              "items": [
                {
                  "text": "Ezr 6:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Abisirayeli bāri bakoraniye i Yerusalemu bamara imisi ndwi bari mu misi mikuru y’imitsima itambiwe bafise umunezero mwinshi; kand’ Abalewi n’abaherezi bāhimbaza Uhoraho uko bukeye, bamuririmbira n’amajwi arenga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.21",
            "verseOrgIds": [
              "2CH.30.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 30:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.5"
              },
              "items": [
                {
                  "text": "Lew 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya aremēsha imitima y’Abalewi bose bāgira umwete wo gukorera Uhoraho. Nukw abantu bamara iyo misi ndwi barya ivy’ iyo misi mikuru, batanga ibimazi vy’ishimwe, bakengurukira Uhoraho Imana ya ba sekuruza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.22",
            "verseOrgIds": [
              "2CH.30.22"
            ]
          }
        }
