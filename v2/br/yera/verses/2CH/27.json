              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.4",
            "verseOrgIds": [
              "2CH.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arwana n’umwami w’Abamoni; abo Bamoni arabanesha. Nuko mur’ uwo mwaka Abamoni bamugororera italanto z’ifeza ijana, n’ingero zitwa koro ibihumbi cumi z’ingano, n’ingero ibihumbi cumi nyene za sayiri. No mu mwaka wa kabiri n’uwa gatatu bāmuzaniye nk’ivyo nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.5",
            "verseOrgIds": [
              "2CH.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yotamu aba ūhambaye, kuko yagenda atunganya ingeso ziwe imbere y’ Uhoraho Imana yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.6",
            "verseOrgIds": [
              "2CH.27.6"
            ]
          }
        }
      ]
    },
    {
