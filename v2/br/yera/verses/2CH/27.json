              "items": [
                {
                  "text": "2 Abam 15:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ibindi vyose vyadōnzwe kuri Yotamu, n’intambara zose yarwanye, n’ivy’ ingeso ziwe, vyanditswe mu gitabo c’abami b’ Abisirayeli n’ab’ Abayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.7",
            "verseOrgIds": [
              "2CH.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yar’ amaze imyaka mirongwibiri n’ itanu aho yaja ku ngoma; ayimarakw imyaka cumi n’itandatu i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.8",
            "verseOrgIds": [
              "2CH.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.38"
              },
              "items": [
                {
                  "text": "2 Abam 15:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yotamu ahamvya ba sekuruza, bamuhamba ku murwa wa Dawidi; maz’ umuhungu wiwe Ahazi asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.27.9",
            "verseOrgIds": [
              "2CH.27.9"
            ]
          }
        }
