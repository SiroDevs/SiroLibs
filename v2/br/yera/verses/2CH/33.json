                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ibindi vyose vyadonzwe kuri Manase, n’ivy’ isengesho yasenze Imana yiwe, n’amajambo ba kamenyi bāmubariye mw izina ry’Uhoraho Imana y’Abisirayeli, vyanditswe mu bitabo bidonda ivy’ abami b’Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "33:18",
              "type": "text"
            },
            {
              "text": "Abayuda",
              "type": "text"
            },
            {
              "text": ": mu Giheburayo handitswe ngw Abisirayeli, ariko n’ukuvuga ubgoko s’ukuvuga igihugu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 33:19"
          },
          "items": [
