            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.27.3"
              },
              "items": [
                {
                  "text": "2 Ngo 27:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo yubaka uruzitiro rw’amabuye, ruciye inyuma y’igisagara ca Dawidi, ruca ku ruhande rw’i Gihoni ruhera i burengerazuba mu mwonga, rukarinda rushika kw irembo ryitwa iry’ Amafi; arukīkūza i Ofeli, ararukuza, arugira rurerure cane; kand’ ashira abagabisha b’ingabo mu bisagara vyose vy’i Buyuda bizitiriwe inzitiro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ akūrah’ ibigirwamana vy’amahanga, akūra na ca gishushanyo mu ngoro y’Uhoraho, n’ibicaniro vyose yari yarubatse ku musozi urikw ingoro y’Uhoraho n’i Yerusalemu, abishiburira inyuma y’igisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ asana igicaniro c’Uhoraho, agitangirakw ibimazi vy’ishimwe n’ivyo gukenguruka, kand’ agera kw Abayuda basaba Uhoraho Imana y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.12"
              },
              "items": [
                {
                  "text": "2 Ngo 32:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo abantu bakomeza gutangira ibimazi mu bitabo vyo ku mpinga z’imisozi, ariko bakabiha Uhoraho Imana yabo wenyene gusa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        }
      ]
    },
