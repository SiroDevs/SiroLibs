                  "text": "Ezk 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye Uhoraho abatēza abagabisha b’ingabo z’umwami w’i Ashuri, bagafata Manase, bakamubohesha ivyuma, bakamushira mu minyororo, bakamujana i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.26"
              },
              "items": [
                {
                  "text": "2 Ngo 32:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.16+LUK.15.17+LUK.15.18"
              },
              "items": [
                {
                  "text": "Luk 15:16-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abonye kw ashitse mu magorwa, yinginga Uhoraho Imana yiwe, yicisha bugufi ashika hasi imbere y’Imana ya ba sekuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.36+2CH.6.37+2CH.6.38+2CH.6.39"
              },
              "items": [
                {
                  "text": "2 Ngo 6:36-39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ayisenze, iramwemerera, yumva ukwinginga kwiwe, imusubiza i Yerusalemu mu bgami bgiwe. Nuko Manase aca amenya yuk’ Uhoraho ari we Mana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        }
      ]
    },
