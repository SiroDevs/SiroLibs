              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Ngo 33:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’ivy’ isengesho ryiwe, n’ ingene yemerewe, n’ivy’ ivyaha vyiwe vyose n’ugucumura kwiwe, n’ivy’ ahantu hose yatavye ibitabo, akahashinga inkingi za Ashera n’ibishushanyo bibājwe, ataricisha bugufi, ivyo vyanditswe mu majambo ya Hozayi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.18"
              },
              "items": [
                {
                  "text": "2 Abam 21:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Manase ahamvya ba sekuruza, ahambga mu rugo rwiwe; maz’ umuhungu wiwe Amoni asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        }
      ]
    },
