              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Hezekiya yakoze mu Buyuda hose; yagenda akora ivyiza n’ibiroranye n’ivy’ ukuri imbere y’Uhoraho Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.20",
            "verseOrgIds": [
