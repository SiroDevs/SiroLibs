                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya ashinga imbu z’abaherezi n’Abalewi, nk’uko zari zisanzwe, nk’uk’ umuntu wese muri bo yar’ asanzwe akora, ar’ abo gutanga ibimazi vyoswa, ar’ abo gutanga ibimazi vy’ishimwe, ar’ abo guhēreza, ar’ abo gushima, ar’ abo guhimbaza, bahagaze ku birimba vy’urugo rw’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.2",
            "verseOrgIds": [
              "2CH.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Guh 28:3—29:40",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.7"
              },
              "items": [
                {
                  "text": "2 Ngo 35:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.17"
              },
              "items": [
                {
                  "text": "Ezk 45:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami agera n’umugabane w’ivyo azotanga ku vyo atunze, ku vy’ ibimazi vyo kwoswa bizotangwa mu gitondo no ku mugoroba, n’ibimazi vyo kwoswa ku masabato, n’ivyo mu mboneko z’ukwezi, n’ivy’ imisi mikuru yashinzwe, nk’uko vyanditswe mu vyagezwe vy’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.3",
            "verseOrgIds": [
              "2CH.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.8+NUM.18.9+NUM.18.10+NUM.18.11+NUM.18.12+NUM.18.13+NUM.18.14+NUM.18.15+NUM.18.16+NUM.18.17+NUM.18.18+NUM.18.19+NUM.18.20+NUM.18.21+NUM.18.22+NUM.18.23+NUM.18.24"
              },
              "items": [
                {
                  "text": "Guh 18:8-24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.10"
              },
              "items": [
                {
                  "text": "Neh 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ agera kw abantu bose baba i Yerusalemu batanga ivyashinzwe guhabga abaherezi n’Abalewi, kugira ngo babone kwitwaririka ivyagezwe vy’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.4",
            "verseOrgIds": [
              "2CH.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.12"
              },
              "items": [
                {
                  "text": "Neh 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ico cagezwe kimaze gutāngāzwa, Abisirayeli bazana vyinshi cane vy’ umushuzo w’ingano na vino n’ amavuta ya elayo n’ubūki n’ ivyeze vyose vyo mu mirima; kandi n’ikigiracumi ca vyose babizana ari vyinshi cane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.5",
            "verseOrgIds": [
              "2CH.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.27.32"
              },
              "items": [
                {
                  "text": "Lew 27:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.28"
              },
              "items": [
                {
                  "text": "Gus 14:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abisirayeli n’Abayuda, bāba mu bisagara vy’i Buyuda, na bo bazana ikigiracumi c’inka n’intama, n’ ikigiracumi c’ibintu vyejejwe bigashikanirwa Uhoraho Imana yabo, ivyo bintu babigira ibirundo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.6",
            "verseOrgIds": [
              "2CH.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kwezi kwa gatatu ni ho batanguye kurunda ivyo birundo, babirangiza mu kwezi kw’indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.7",
            "verseOrgIds": [
              "2CH.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya n’abaganwa baje, bakabona ivyo birundo, baciye bashima Uhoraho n’abantu biwe b’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.8",
            "verseOrgIds": [
              "2CH.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya abaza abaherezi n’Abalewi ivy’ ivyo birundo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.9",
            "verseOrgIds": [
              "2CH.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.10"
              },
              "items": [
                {
                  "text": "Mal 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azariya umuherezi mukuru, umuntu wo mu nzu ya Sadoki, aramwishura, at’ Uhereye igihe abantu batanguriye kuzana amashikanwa mu ngoro y’Uhoraho, twagiye tubona ivyo kurya, tugahāga, tugasigaza vyinshi; kuk’ Uhoraho yahaye abantu biwe umugisha, kand’ ibisāgutse ni vyo ibi bingana birtyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.10",
            "verseOrgIds": [
              "2CH.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya araheza ababarira ko batunganya ivyumba vyo mu ngoro y’Uhoraho; nuko barabitunganya; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.11",
            "verseOrgIds": [
              "2CH.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "babishiramw’ ayo mashikanwa n’ivyo bigiracumi, n’ivyo bintu vyagizwe inyegu, babikoze nk’uko bizigiwe; umukuru yabijejwe yari Konaniya Umulewi, agakurikirwa na murumuna we Shimeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.12",
            "verseOrgIds": [
              "2CH.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehiyeli na Azaziya na Nahati, na Asaheli na Yerimoti na Yozabadi, na Eliyeli na Isimakiya na Mahati na Benaya, ni bo bār’ ababgiriza bāgabga na Konaniya na murumuna we Shimeyi, nk’uk’ umwami Hezekiya yabishinze, bo na Azariya umubgiriza w’ingoro y’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.13",
            "verseOrgIds": [
              "2CH.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Kore, mwene Imuna Umulewi, umukumirizi w’irembo ry’i burasirazuba, ni we yar’ ajejwe amashikanwa bashikaniye Imana bavyigombeye, agatanga imigabane ku mashikanwa y’Uhoraho no ku bintu vyera cane. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.14",
            "verseOrgIds": [
              "2CH.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.21.9+JOS.21.10+JOS.21.11+JOS.21.12+JOS.21.13+JOS.21.14+JOS.21.15+JOS.21.16+JOS.21.17+JOS.21.18+JOS.21.19"
              },
              "items": [
                {
                  "text": "Yos 21:9-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bisagara vy’abaherezi yar’ afise abizigirwa yagaba, ni bo aba: Edeni na Minyamini na Yeshuwa na Shemaya na Amariya na Shekaniya; yabagaba mu gikorwa cabo co guha imigabane bagenzi babo, uhereye ku bakuru n’abatoya, ukw imbu zabo zagenda zikurikirana; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.15",
            "verseOrgIds": [
              "2CH.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.59"
              },
              "items": [
                {
                  "text": "1 Abam 8:59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mugabo ntibayiha abaramukiwe gukora mu ngoro y’Uhoraho ku rubu rwabo, nk’ukw ibikorwa bāgerewe biri uko bukeye, ari bo nyene banditswe mu gitabo kidondora amavuka y’izinamuhungu wese, uhereye ku bamaze imyaka itatu no kuja hejuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.16",
            "verseOrgIds": [
              "2CH.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
