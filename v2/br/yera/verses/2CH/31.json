              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.34"
              },
              "items": [
                {
                  "text": "Lew 25:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kubg’ abaherezi bo mu ba Aroni bāba mu matongo aho bafise amaragiro inyuma y’ibisagara vyabo, mu gisagara cose hār’ abantu bazwi amazina bāshiriweho guha umugabane umuntu wese w’izinamuhungu mur’ abo baherezi n’ abanditswe bose mu Balewi mu gitabo kidondora amavuka yabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.31.19",
            "verseOrgIds": [
              "2CH.31.19"
            ]
          }
        }
      ]
