        },
        {
          "text": "Bukeye Yosiya agira umusi mukuru wa Pasika y’Uhoraho i Yerusalemu. Babāga imyagazi ya Pasika ku musi ugira icumi na kane wo mu kwezi kwa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.1",
            "verseOrgIds": [
              "2CH.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashira abaherezi mu mbu zabo, abatera umwete wo gukora igikorwa co mu ngoro y’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.2",
            "verseOrgIds": [
              "2CH.35.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
