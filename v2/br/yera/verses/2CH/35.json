              "items": [
                {
                  "text": "Ezr 6:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko biteguye ivy’ ico gikorwa; abaherezi bahagarara mu myanya yabo, n’Abalewi bahagarara nk’ukw imbu zabo zikurikirana, nk’uk’ umwami yabishinze. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.10",
            "verseOrgIds": [
              "2CH.35.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 35:11"
          },
          "items": [
