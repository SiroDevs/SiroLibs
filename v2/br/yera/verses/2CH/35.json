                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muheze mubabāgire ivya Pasika, mwiyeze, abo bagenzi banyu mubibategurire, nk’ukw ijambo ry’Uhoraho riri, iryo yatumye Mose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.6",
            "verseOrgIds": [
              "2CH.35.6"
            ]
          }
        }
