                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.7"
              },
              "items": [
                {
                  "text": "Gus 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraheza batara inyama z’ivyo bimazi vya Pasika, nk’uko vyashinzwe; bateka n’iz’ ibimazi vyera mu nkono no mu masafuriya no mu tuzīhebe; zihiye bakazijana vuba bakaziha abantu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.13",
            "verseOrgIds": [
              "2CH.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 35:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma bakitegura ivyabo ubgabo bo n’ivy’ abaherezi, kukw abo baherezi bo mu ba Aroni batātirimuka kubgo kwosa ibimazi n’ibinure, bukarinda bgira; ni co catumye Abalewi bitegura ivyabo ubgabo, bakitegura n’ivy’ abo baherezi bo mu ba Aroni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.14",
            "verseOrgIds": [
              "2CH.35.14"
            ]
          }
        },
