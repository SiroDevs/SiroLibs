                  "text": "Yes 26:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mugabo azobaganza, kugira ngo bamenye amasabo yanje n’amasabo y’abandi bami bo mw isi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.12.8",
            "verseOrgIds": [
              "2CH.12.8"
            ]
          }
        }
