              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.47"
              },
              "items": [
                {
                  "text": "Gus 28:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.48"
