              },
              "items": [
                {
                  "text": "Heb 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ inyonga z’Uhoraho zinyuranganya mw isi yose hirya no hino, kugira ngo yerekane ububasha bgiwe bgo gutabara abafise imitima imutunganiye. Mu vyo wakoze ivyo, wakoze ivy’ ubupfu; nuk’ uhereye ubu uzohora ubona intambara. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.9",
            "verseOrgIds": [
              "2CH.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.18.26"
              },
              "items": [
                {
                  "text": "2 Ngo 18:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Asa ashavurira kamenyi uwo, amushira mw ibohero mu mpatane z’ibiti, kukw iryo jambo ryamuteye kumugirira ubushangashirwe. Ico gihe Asa yagenda acuranguza abantu bamwe‐bamwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.10",
            "verseOrgIds": [
              "2CH.16.10"
            ]
          }
        }
      ]
