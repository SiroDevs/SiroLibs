        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.3"
              },
              "items": [
                {
                  "text": "2 Ngo 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.14.9"
              },
              "items": [
                {
                  "text": "14:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ Abanyetiyopiya n’Abalubimu ntibār’ ingabo nyinshi z’isinzi, zifise imikogote y’intambara n’abagendera ku mafarasi vyinshi cane? Ariko kuko wari wizigiye Uhoraho abagabura mu maboko yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.8",
            "verseOrgIds": [
              "2CH.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
