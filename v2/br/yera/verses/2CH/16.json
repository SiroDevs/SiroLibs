              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Hanani kamenyi aza iyo Asa ari, umwami w’i Buyuda, aramubarira, ati Kuko wizigiye umwami w’i Siriya, ntiwizigire Uhoraho Imana yawe, ni co catumye ingabo z’umwami w’i Siriya zigukira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.16.7",
            "verseOrgIds": [
              "2CH.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
