            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Uhoraho yiyereka Salomo mw ijoro, aramubarira, ati Numvise ugusenga kwawe, kandi nitoranirije aha hantu ngo habe inzu yo gutangiramw’ ibimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
