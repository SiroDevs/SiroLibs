            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Salomo yarangije kwubaka ingoro y’Uhoraho n’ ingoro y’ubgami; kand’ ivyo Salomo yari yaragabiye mu mutima wiwe kuzokora ku vy’ingoro y’Uhoraho no ku vy’ingoro yiwe ubgiwe, arabisohoza neza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        }
