              "items": [
                {
                  "text": "1 Abam 8:64-66",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo ashinga umwanya wo hagati mu nyubakwa imbere y’ingoro y’Uhoraho, arahēza; aho ni ho yoshereje ibimazi vyo kwoswa, n’ibinure vy’ibimazi vy’ ishimwe, kukw igicaniro c’umuringa yari yaracurishije cari gito, kitokwiwekw ivyo bimazi vyo kwoswa n’ayo mashikanwa y’amafu n’ivyo binure. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Salomo yagize imisi mikuru ico gihe, hamwe n’Abisirayeli bose, kumara imisi ndwi; bār’ ikoraniro rinini cane bavuye mu gihugu cose, uhereye ahafata i Hamati ugashitsa ku mugezi wa Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.36"
              },
              "items": [
                {
                  "text": "Lew 23:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira umunani bagira ikoraniro ry’agahebuza, kuko bari bamaze imisi ndwi mu vyo gushikiriza Imana igicaniro, baraheza basubira kugira iyindi misi mikuru ndwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ku musi ugira mirongwibiri na gatatu wo mu kwezi kw’indwi asēzera abantu, abarungika i wabo; nuko bataha banezerewe, bahimbawe mu mitima yabo kubg’ ivyiza Uhoraho yagiriye Dawidi na Salomo n’abantu biwe b’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
