            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo arangije gusenga, umuriro utibuka uvuye mw ijuru, utōngōra ibimazi vy’ ukwoswa n’ibindi bimazi; ubgiza bg’Uhoraho bguzura iyo ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi ntibāba bagishobora kwinjira muri yo, kuk’ ubgiza bg’ Uhoraho buyuzuye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bose babonye ingen’ umuriro utibutse, n’ubgiza bg’Uhoraho ingene bgari kur’ iyo ngoro, bunamika amaso, barūnama bashika hasi ku mabuye ahashashe, barasenga, bakengurukira Uhoraho, bat’ Uhoraho ni mwiza, kukw imbabazi ziwe zamah’ ibihe bidashira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
