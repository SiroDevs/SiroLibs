                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami n’abantu bose bafataniriza hamwe gutangira ibimazi imbere y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Salomo atanga inka ibihumbi mirongwibiri na bibiri n’intama ibihumbi ijana na mirongwibiri kw ibimazi. Uko ni k’umwami n’abantu bose bāshikirije Imana ingoro yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.10"
              },
              "items": [
                {
                  "text": "Guh 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.15.16"
              },
              "items": [
                {
                  "text": "1 Ngo 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.5.12"
              },
              "items": [
                {
                  "text": "2 Ngo 5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abaherezi bari bahagaze mu myanya yabo, n’Abalewi na bo bafise ibintu vyo kuvugiriza Uhoraho, ivyo umwami Dawidi yari yarakoresheje vyo gushima Uhoraho, akababgira kubivuza igihe yamuhimbaza, ati Kukw imbabazi ziwe zamah’ ibihe bidashira; nukw abaherezi bavugiriza inzumbete imbere yabo; Abisirayeli bose na bo barahagarara.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
