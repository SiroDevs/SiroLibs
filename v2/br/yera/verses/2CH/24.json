            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamugīra inama, bamwicisha amabuye bivuye ku cagezwe c’umwami, bamutsinda mu nyubakwa yo ku ngoro y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
