                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Dawidi n’ingabo ziwe baradūga, batera Abageshuri n’ Abagiruzi n’Abamaleki; abo ni bo bār’ inyamo z’ico gihugu uhereye kera, kurinda ushika i Shura n’ igihugu ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.8",
            "verseOrgIds": [
              "1SA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.3"
              },
              "items": [
                {
                  "text": "1 Sam 15:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi ageseza ico gihugu, ntiyagira umugabo cank’ umugore asiga atishe; anyaga intama n’inka n’ indogoba n’ingamiya, asahura n’ impuzu; maze yatabāruka akaja kwa Akishi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.9",
            "verseOrgIds": [
              "1SA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.16"
              },
              "items": [
                {
                  "text": "Abac 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.6"
              },
              "items": [
                {
                  "text": "1 Sam 15:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.27"
              },
              "items": [
                {
                  "text": "23:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.29"
              },
              "items": [
                {
                  "text": "30:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akishi ngw amubaze, at’ Uyu musi wateye hehe? Dawidi akamwishura, ati Nateye i bumanuko mu Buyuda; cank’ ati Nateye i bumanuko mu ba Yerameyeli; cank’ ati Nateye i bumanuko mu Banyakeni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.10",
            "verseOrgIds": [
              "1SA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Dawidi ntiyagira umugabo cank’ umugore asiga atishe, kugira ngo ntabajane i Gati, ati Boye kuturega, ngo Dawidi yakoze artya n’ artya. Uko ni ko yahora agenza igihe cose yamaze aba mu gihugu c’Abafilisitiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.11",
            "verseOrgIds": [
              "1SA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Akishi aca yizigira Dawidi, akavuga, ati Yatumye Abisirayeli bagenzi biwe bamuzinukwa rwose; noneh’ abaye umuntu wanje gushitsa ibihe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.12",
            "verseOrgIds": [
              "1SA.27.12"
            ]
          }
        }
      ]
    }
