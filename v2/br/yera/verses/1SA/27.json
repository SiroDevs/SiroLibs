            "sid": "1SA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.4",
            "verseOrgIds": [
              "1SA.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi abarira Akishi, ati Ni naba ngutonnyeko, ntabaza ikibanza mu gisagara kimwe co mu vyo mu gihugu, abe ari ho nja kuba; har’ icotuma jewe umusavyi wawe ndinda kubana nawe ku murwa wawe? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.5",
            "verseOrgIds": [
              "1SA.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.1"
              },
              "items": [
                {
                  "text": "1 Sam 30:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo musi Akishi amugabira i Sikulagi; ni co catumye i Sikulagi haba ah’ abami b’Abayuda bīzīziye na bugingo n’ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.6",
            "verseOrgIds": [
              "1SA.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.29.3"
              },
              "items": [
                {
                  "text": "1 Sam 29:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe Dawidi yamaze mu gihugu c’Abafilisitiya n’ umwaka n’amezi ane.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.27.7",
            "verseOrgIds": [
              "1SA.27.7"
            ]
          }
        }
      ]
    },
