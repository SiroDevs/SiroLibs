              "1SA.23.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.20"
              },
              "items": [
                {
                  "text": "1 Sam 22:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.7"
              },
              "items": [
                {
                  "text": "30:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igihe Abiyatari mwene Ahimeleki yahungira iyo Dawidi ari, yamanukanye efodi i Keyila.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.6",
            "verseOrgIds": [
              "1SA.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye babarira Sauli yuko Dawidi yagiye i Keyila; Sauli aravuga, at’ Imana imugabuye mu maboko yanje, yitaye mu mutego, ko yagiye mu gisagara cugazwa inzugi n’ibihindizo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.7",
            "verseOrgIds": [
              "1SA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sauli ahamagaza ingabo zose ngo zitabare, zije gutera i Keyila, zūgarize Dawidi n’ingabo ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.8",
            "verseOrgIds": [
              "1SA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi amenye ko Sauli yamugīriye inama mbi, abarira Abiyatari umuherezi, ati Zana hano efodi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.9",
            "verseOrgIds": [
              "1SA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi arasenga, at’ Uhoraho, Mana y’Abisirayeli, jewe umusavyi wawe numvise inkuru y’imvāho yuko Sauli agomba gutera i Keyila, ngw arandure iki gisagara agihōra jewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.10",
            "verseOrgIds": [
              "1SA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ abantu b’i Keyila bazontanga mu maboko yiwe? Kandi Sauli azomanuka koko, nk’uko jewe umusavyi wawe navyumvise? Ewe Uhoraho, Mana y’Abisirayeli, ndakwinginze barira umusavyi wawe. Uhoraho aramwishura, at’ Azomanuka. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.11",
            "verseOrgIds": [
              "1SA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi arongera arabaza, ati Non’ abantu b’i Keyila bazontanga twe n’ingabo zanje mu maboko ya Sauli? Uhoraho aramwishura, ati Bazogutanga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.12",
            "verseOrgIds": [
              "1SA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.2"
              },
              "items": [
                {
                  "text": "1 Sam 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.13"
              },
              "items": [
                {
                  "text": "25:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi ahagurukana n’ingabo ziwe, zari nk’ amajana atandatu, bava i Keyila, bagenda bayerēra hirya no hino. Hanyuma babarira Sauli ko Dawidi yahunze akava i Keyila; aca asigaho ntiyaja gutera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.13",
            "verseOrgIds": [
              "1SA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.24"
              },
              "items": [
                {
                  "text": "Yos 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.23.4"
              },
              "items": [
                {
                  "text": "1 Sam 23:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi aba mu masenga yo mu bugaragwa, aguma mu mugamba wo mu bugaragwa bg’i Zifu. Sauli akāma amurondera uko bukeye, arikw Imana ntiyamugabura mu maboko yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.14",
            "verseOrgIds": [
              "1SA.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
