                "loc": "JOS.15.62"
              },
              "items": [
                {
                  "text": "Yos 15:62",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.2"
              },
              "items": [
                {
                  "text": "2 Ngo 20:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.47.10"
              },
              "items": [
                {
                  "text": "Ezk 47:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi avayo, aradūga, aja kuba mu masenga y’i Eni‐gedi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.23.29",
            "verseOrgIds": [
              "1SA.23.29"
            ]
          }
        }
