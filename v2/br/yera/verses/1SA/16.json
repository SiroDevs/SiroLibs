                  "text": "18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhungu umwe w’umusore aramwishura, ati Nabonye umuhungu wa Isayi w’i Betelehemu, n’umucuraranzi w’umuhinga, n’ umuhizi w’inkomezi kand’ arazi kurwana, aritonda mu vyo avuga, n’umuntu w’igikundiro, kand’ Uhoraho ari kumwe na we. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.18",
            "verseOrgIds": [
              "1SA.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
