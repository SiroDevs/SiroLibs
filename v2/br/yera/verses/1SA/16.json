                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sauli atuma intumwa kuri Isayi, uti Murungikire umuhungu wawe Dawidi, umwe aragira intama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
