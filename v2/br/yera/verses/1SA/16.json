            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw atuma ūja kumuzana. Kandi yar’ umuhungu w’inzobe, w’amaso meza, w’umunyakaranga. Maz’ Uhoraho aravuga, ati Va hasi, umusukekw amavuta, kuko wa wundi ar’ uyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.12",
            "verseOrgIds": [
              "1SA.16.12"
            ]
          }
        },
