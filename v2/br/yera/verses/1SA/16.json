              "items": [
                {
                  "text": "Yos 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "At’ Ego me n’amahoro; nzanywe no gushikanira Uhoraho ikimazi. Nuko ni mwiyeze, muze tujane kur’ ico kimazi. Kandi yeza Isayi n’abahungu biwe, abahamagara kuza kur’ ico kimazi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.5",
            "verseOrgIds": [
              "1SA.16.5"
            ]
          }
        }
