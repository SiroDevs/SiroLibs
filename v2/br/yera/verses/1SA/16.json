              },
              "items": [
                {
                  "text": "1 Sam 18:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.3.15"
              },
              "items": [
                {
                  "text": "2 Abam 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda se databuja, n’udutume twebge abasavyi bawe duhagaze hano, tuje kukuronderera umuntu w’ umuhinga azi gucuraranga inanga; maz’ iyo mpwemu mbi irungitswe n’Imana iy’ igufashe, az’ agucurarangire, ukire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.16",
            "verseOrgIds": [
              "1SA.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sauli yishura abo bantu biwe, ati Nuko ni mundonderere umuntu azi gucuraranga neza, mumunzanire. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.17",
            "verseOrgIds": [
              "1SA.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
