              "items": [
                {
                  "text": "1 Sam 17:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Isayi yābīra indogoba, ayishirakw imitsima n’umukuza w’urusāto wuzuye vino, n’umwagazi w’impene, abirungikana umuhungu wiwe Dawidi ngw abishikanire Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi ashitse kwa Sauli arenguka imbere yiwe; Sauli aramukunda cane, amugira ūmutwaza ibirwanishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.21",
            "verseOrgIds": [
              "1SA.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sauli atuma kuri Isayi, ut’ Aragusavye Dawidi ngw amugendanire, kukw amushimye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.22",
            "verseOrgIds": [
              "1SA.16.22"
            ]
          }
        },
