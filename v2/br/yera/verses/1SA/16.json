        },
        {
          "text": "Mpwemu w’Uhoraho amaze kuva kuri Sauli, impwemu mbi irungitswe n’Uhoraho yama igenda imufata bga gikange. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu ba Sauli baramubarira, bat’ Ereg’ impwemu mbi irungitswe n’ Uhoraho ni yo igukanga! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.15",
            "verseOrgIds": [
              "1SA.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
