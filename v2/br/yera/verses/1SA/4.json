            "number": "19",
            "style": "v",
            "sid": "1SA 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukazana wiwe, muka Finehasi, yar’ afise inda, ari hafi yo kuvyara. Nuko yumvise izo nkuru yukw isandugu y’Imana yafashwe mpiri, kandi ko sebukwe n’ umugabo wiwe bapfuye, aca apfukama, aravyara, kukw ibise vyaciye bimufata. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.17"
              },
              "items": [
                {
                  "text": "Ita 35:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ari hafi yo gucīkāna, abagore bāri bamuhagaze i ruhande baramubarira, bati Rema, kuk’ uvyaye umuhungu! Ariko nta co yabishura, canke ngw anabibabare. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.20",
            "verseOrgIds": [
              "1SA.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
