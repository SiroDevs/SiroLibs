              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ isandugu y’ Imana ifatwa mpiri; na bene Eli bompi, Hofuni na Finehasi baricwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
