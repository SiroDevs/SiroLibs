              "items": [
                {
                  "text": "99:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu batuma i Shilo, bakūray’ isandugu y’isezerano ry’Uhoraho Nyen’ ingabo yama avyagiye ku bakerubi, barayizana. Kandi bene Eli bompi, Hofuni na Finehasi, bazanana n’iyo sandugu y’isezerano ry’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        }
