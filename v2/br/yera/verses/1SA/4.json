            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yita uwo mwana Ikabodi; at’ Icubahiro kirashize mu Bisirayeli. Icatumye avuga artyo n’ukw isandugu y’ Imana yafashwe mpiri, kandi n’ uko sebukwe n’umugabo wiwe bāpfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.21",
            "verseOrgIds": [
              "1SA.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravuga, at’ Icubahiro kirashize mu Bisirayeli, kukw isandugu y’Imana ifashwe mpiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.22",
