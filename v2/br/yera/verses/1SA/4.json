              "items": [
                {
                  "text": "1 Kor 16:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mushikame, murwane magabo, yemwe Bafilisitiya, mwoye kuba abaja b’Abaheburayo, nk’uko bo ar’ abacu: nuko murwane magabo! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        },
