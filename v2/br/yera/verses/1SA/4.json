                  "text": "2 Sam 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umuntu wo mu ba Benyamini ava mu rugamba, agenda yiruka, ashika i Shilo uwo musi, yitantamuriyekw impuzu ziwe, yiyoreye ivu mu mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.12",
            "verseOrgIds": [
              "1SA.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.9"
              },
              "items": [
                {
                  "text": "1 Sam 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ aho yaza, Eli yari yicaye ku ntebe yiwe i ruhande y’inzira, ategereye agakuru, kuko yar’ ahagaritswe umutima n’isandugu y’Imana. Nuk’ uwo muntu ashitse mu gisagara, avuga inkuru z’ivyabaye; abo mu gisagara bose bacura umuborogo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.13",
            "verseOrgIds": [
              "1SA.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Eli yumvise ijwi ry’amaborogo, arabaza, at’ Urwo rwamo n’urw’ iki? Nuk’ uwo muntu aza yirukanga, abibikira Eli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        },
        {
