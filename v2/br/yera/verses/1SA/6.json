                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ni murondere umukogote musha, bo n’ inka zibiri z’imvyeyi, zitigeze gukoreshwa igikorwa na kimwe; muheze muziboherek’ uwo mukogote, muzāke izazo muzisubize i muhira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.7",
            "verseOrgIds": [
              "1SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 6:8"
          },
          "items": [
