              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.9",
            "verseOrgIds": [
              "1SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bantu babigenza bartyo; bābīra inka zibiri z’imvyeyi, baziboherak’ umukogote, izazo bazugaririra i muhira; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.10",
            "verseOrgIds": [
              "1SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "baraheza bashira iyo sandugu y’Uhoraho kur’ uwo mukogote, bashirako na ka gasandugu karimw’ izo mbeba zacuzwe mw izahabu na vya bishushanyo vy’ibihute vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.11",
            "verseOrgIds": [
              "1SA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo nka zigenda zitumbereye i Beti‐shemeshi, zijana inzira y’iroro, zigenda zirābira inzira yose, ntizakebereza i buryo cank’ i bumoso; abaganwa b’Abafilisitiya baraziherekeza, bazishikana ku rubibe rw’i Beti‐shemeshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.12",
            "verseOrgIds": [
              "1SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ab’i Beti‐shemeshi bāriko baragenya ingano mu kiyaya; bunamuye amaso babona isandugu iserutse: bayibonye baranezerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.13",
            "verseOrgIds": [
              "1SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.22"
              },
              "items": [
                {
                  "text": "2 Sam 24:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo mukogote uraza, ushikira mu murima wa Yosuwa w’i Beti‐shemeshi, uhagararaho. Kand’ aho hantu hār’ ikibuye kinini. Baraheza basatagura uwo mukogote mw inkwi, bazitangirakw izo nka kw ikimazi co kwosereza Uhoraho. ",
          "type": "text",
          "attrs": {
