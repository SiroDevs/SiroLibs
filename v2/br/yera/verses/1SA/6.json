            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Har’ icotuma mukomantaza imitima nk’ukw Abanyegiputa na Farawo bagize? Mbeg’ imaze kwerekana ububasha muri bo, ntibāhavuye bakarekura abo bantu, bakīgīra? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.6",
            "verseOrgIds": [
              "1SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
