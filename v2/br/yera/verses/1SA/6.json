            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabishura, bati Ni mwarungika iyo sandugu y’Imana y’Abisirayeli, ntimuze muyirungike yonyene, ariko muyisubizanyeyo n’impongano muhongeye Imana: ni ho muzobona gukira, mumenye n’icatumye ukuboko kwayo kutabatenzukira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.3",
            "verseOrgIds": [
              "1SA.6.3"
            ]
          }
        },
