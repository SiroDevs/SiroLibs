          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba baganwa batanu b’Abafilisitiya babibonye, basubira i Ekuroni kur’ uwo musi nyene.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.6.16",
            "verseOrgIds": [
              "1SA.6.16"
            ]
          }
