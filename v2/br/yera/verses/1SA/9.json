              "items": [
                {
                  "text": "1 Ngo 8:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hār’ umuntu w’Umubenyamini yitwa Kishi; yari mwene Abiyeli, Abiyeli wa Serori, Serori wa Bekorati, Bekorati wa Afiya w’ Umubenyamini; yar’ umuntu w’umutunzi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.1",
            "verseOrgIds": [
              "1SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.23"
              },
              "items": [
                {
                  "text": "1 Sam 10:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.12"
              },
              "items": [
                {
                  "text": "16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yar’ afise umuhungu mwiza w’umusore yitwa Sauli. Nta n’umwe mu Bisirayeli yamurusha ubgiza, kandi yasumba abantu bose, bamugera ku bitugu gusa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.2",
            "verseOrgIds": [
              "1SA.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye indogoba za Kishi se wiwe ziratakara. Kishi abarira Sauli umuhungu wiwe, ati Hitana umwe mu banyarugo, muje kurondera izo ndogoba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.3",
            "verseOrgIds": [
              "1SA.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baca mu mugamba w’Abefurayimu no mu ntāra y’i Shalisha, ntibāzibona. Maze baca mu ntāra y’i Shalimu barazibura, baca no mu ntāra y’ Ababenyamini, na ho nyene ntibāzibona. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.4",
            "verseOrgIds": [
              "1SA.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.2"
              },
              "items": [
                {
                  "text": "1 Sam 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma bashitse mu ntāra y’i Sufi, Sauli abarira uno muntu bari kumwe, at’ Ingo dutahe, data ntahave ahagarikira umutima twebge kuruta indogoba. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.5",
            "verseOrgIds": [
              "1SA.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.33.1"
              },
              "items": [
                {
                  "text": "Gus 33:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.19"
              },
              "items": [
                {
                  "text": "1 Sam 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.1"
              },
              "items": [
                {
                  "text": "1 Abam 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we aramwishura, at’ Erega mur’ iki gisagara harih’ umuntu w’Imana, kandi n’umunyacubahiro; ivyo avuga vyose bihora bishika; enda se tujeyo, kumbure yoturangira inzira tujana. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.6",
            "verseOrgIds": [
              "1SA.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.22.7"
              },
              "items": [
                {
                  "text": "Guh 22:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.3"
              },
              "items": [
                {
                  "text": "1 Abam 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.42"
              },
              "items": [
                {
                  "text": "2 Abam 4:42",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.5.15"
              },
              "items": [
                {
                  "text": "5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.8"
              },
              "items": [
                {
                  "text": "8:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sauli abaza uwo muntu wiwe, ati Mbega none, ni twajayo tumugemura iki? Kw impamba yashize mu masaho yacu, tukaba ata ngemu tugira yo guha uwo muntu w’Imana. Mbega har’ ico dufise? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.7",
            "verseOrgIds": [
              "1SA.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muntu yishura Sauli, at’ Ehe ndafise ikigirakane ca shekeli y’ifeza; ndagiha uwo muntu w’ Imana kugira ngw aturangire inzira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.8",
            "verseOrgIds": [
              "1SA.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.22"
              },
              "items": [
                {
                  "text": "Ita 25:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.15.27"
              },
              "items": [
                {
                  "text": "2 Sam 15:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.13"
              },
              "items": [
                {
                  "text": "2 Abam 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.29"
              },
              "items": [
                {
                  "text": "1 Ngo 29:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.10"
              },
              "items": [
                {
                  "text": "Yes 30:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kera mu Bisirayeli, umuntu iyo yagira ic’ aja gusiguza Imana, yavuga, ati Hogi tuje kwa kamenyi; kuk’ uwitwa ūvugishwa n’Imana ubu, kera yitwa kamenyi.) ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.9",
            "verseOrgIds": [
              "1SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sauli abgira uwo muntu wiwe, ati Ni vyiza; ngwino tugende. Nuko baja ku gisagara ah’ uwo muntu w’Imana yaba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.10",
            "verseOrgIds": [
              "1SA.9.10"
            ]
          }
        }
      ]
    },
    {
