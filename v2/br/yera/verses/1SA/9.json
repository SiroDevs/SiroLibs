              "items": [
                {
                  "text": "Ita 24:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakidūga umusozi ngo bashike ku gisagara, bahūra n’abigeme bavuyeyo baja kuvoma; barababaza, bati Mbega kamenyi ni ho ari? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.11",
            "verseOrgIds": [
              "1SA.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.5"
              },
              "items": [
                {
                  "text": "1 Sam 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.2"
              },
              "items": [
                {
                  "text": "16:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.20.29"
              },
              "items": [
                {
                  "text": "20:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.2+1KI.3.3+1KI.3.4"
              },
              "items": [
                {
                  "text": "1 Abam 3:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabishura, bat’ Ego me; nguyo ah’ imbere yanyu; ariko munyaruke: ni ho agishika mu gisagara, azanywe n’ukw abantu bagira batange ibimazi ku mpinga y’umusozi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.12",
            "verseOrgIds": [
              "1SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwashika mu gisagara muca mumubona ataradūga ku mpinga y’umusozi kurīrayo; kukw abantu badashobora kurya ataraza, kukw ari we ahezagira ibimazi, maz’ abātowe bakabona kurya. Nuko rero ni mudūge: muca mumubona aka kanya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.13",
            "verseOrgIds": [
              "1SA.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baradūga ngo baje mu gisagara; bagishikayo baca bahūra na Samweli avayo ngw adūge ku mpinga y’umusozi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.14",
            "verseOrgIds": [
              "1SA.9.14"
            ]
          }
        }
      ]
    },
