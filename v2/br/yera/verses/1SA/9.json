              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umusi Sauli ashikayo, Uhoraho yari yarāye abihishuriye Samweli, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.15",
            "verseOrgIds": [
              "1SA.9.15"
            ]
          }
        },
