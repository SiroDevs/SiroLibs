          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samweli ajana Sauli n’ umuntu wiwe, abinjiza mu nzu yo kuzimaniramwo, abaha ivyicaro vy’icubahiro mu bātowe, bāri nka mirongwitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.22",
            "verseOrgIds": [
              "1SA.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samweli abarira umusuku, ati Zana wa mutigiri nakubarira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.23",
            "verseOrgIds": [
              "1SA.9.23"
            ]
          }
        },
