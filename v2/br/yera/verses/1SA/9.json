                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Ejo nka magingo aya nzokurungikira umuntu avuye mu gihugu c’Ababenyamini; uz’ umwimikishe amavuta, abe umwami w’abantu banje Abisirayeli. Ni we azokiza abantu banje, abakūre mu maboko y’Abafilisitiya; kuko nitegereje abantu banje, kand’ ugutaka kwabo kwanshitseko. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.16",
            "verseOrgIds": [
              "1SA.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.16.12"
              },
              "items": [
                {
                  "text": "1 Sam 16:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Samweli agikubita ijisho Sauli, Uhoraho aramubarira, at’ Ehe nguyo wa muntu nakubarira! Uyo ni we azoganza abantu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.17",
            "verseOrgIds": [
              "1SA.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sauli yēgēra Samweli aho nyene mw irembo ry’igisagara, aramubarira, ati Ntabara undangire inzu ya kamenyi ah’ itumbereye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.18",
            "verseOrgIds": [
              "1SA.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli aramwishura, at’ Erega ni jewe nyene kamenyi; none hogi tuje ku mpinga y’umusozi, kuk’ uyu musi muribusangire nanje; maz’ ejo mu gitondo nzokurekura, ngusobanurire ibiri mu mutima wawe vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.19",
            "verseOrgIds": [
              "1SA.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.9.3"
              },
              "items": [
                {
                  "text": "1 Sam 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.16"
              },
              "items": [
                {
                  "text": "10:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku vya za ndogoba zawe, zimaze gatatu zizimiye, ntiziguhagarike umutima: zārabonetse. Mbeg’ ivy’ igikundiro vyose vyo mu Bisirayeli bibīkiwe nde? Si wewe nyene, n’inzu yose ya so? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.20",
            "verseOrgIds": [
              "1SA.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 9:21"
          },
          "items": [
