              "items": [
                {
                  "text": "Zab 68:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sauli aramwishura, ati Mbega sind’ Umubenyamini, ari wo muryango mutoya hanyuma y’iyindi yo mu Bisirayeli? Kand’ inzu yacu si yo ntoya hanyuma y’ayandi mazu yose yo mu Babenyamini? None n’iki gitumye umbarira ben’ ivyo?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.21",
            "verseOrgIds": [
              "1SA.9.21"
            ]
          }
        }
      ]
