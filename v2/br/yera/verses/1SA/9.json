              },
              "items": [
                {
                  "text": "Ezk 24:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo musuku azana igikenye c’ukuguru n’inkenyūre zaco, agitereka imbere ya Sauli. Maze Samweli aravuga, at’ Ehe ngibi ivyo wateguriwe; shirak’ ufungure, kukw ari wewe wabiteguriwe gushitsa iki gihe cāshinzwe, kugira ng’ usangire n’ abandi bāhamagawe. Nuk’ uwo musi Sauli asangira na Samweli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.24",
            "verseOrgIds": [
              "1SA.9.24"
            ]
          }
        }
