                "loc": "ACT.10.9"
              },
              "items": [
                {
                  "text": "Ivyak 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuye aho ku mpinga y’umusozi, baramanuka bashika mu gisagara, Samweli aja kugānirira na Sauli hejuru ku nzu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.25",
            "verseOrgIds": [
              "1SA.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye barazinduka; hakiri mu gaturuturu Samweli ahamagara Sauli iy’ ari hejuru ku nzu, ati Vyuka, ndaguherekeze. Nuko Sauli aravyuka, arengana irembo na Samweli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.26",
            "verseOrgIds": [
              "1SA.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakimanuka, bashitse ah’ igisagara kigarukira, Samweli abarira Sauli, ati Barira uwo muntu wawe atambuke imbere; nawe uhagarare gatoya, nkumenyeshe ijambo ry’ Imana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.9.27",
            "verseOrgIds": [
              "1SA.9.27"
            ]
          }
        }
      ]
