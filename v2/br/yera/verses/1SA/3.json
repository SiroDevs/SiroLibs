                "loc": "JER.19.3"
              },
              "items": [
                {
                  "text": "Yer 19:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Samweli, ati Rāba nzokora ikintu mu Bisirayeli, ūzocumva wese imīnzerere izomuvuga mu matwi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.11",
            "verseOrgIds": [
              "1SA.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
