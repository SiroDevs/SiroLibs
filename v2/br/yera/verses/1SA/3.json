            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi nzoshitsa kuri Eli ivyo navuze ku nzu yiwe vyose, iyo biva bikagera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.12",
            "verseOrgIds": [
              "1SA.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko mmaze kumubgira yuko ngiye guha inzu yiwe igihano kitazobavako, mbahōye ukugabitanya yirengagije, kukw abahungu biwe bihamagariye umuvumo, na we ntabateshe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.13",
            "verseOrgIds": [
              "1SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.14"
              },
              "items": [
                {
                  "text": "Yes 22:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye ndahira ab’ inzu ya Eli, yukw ibigabitanyo vyabo bitazotangirwa impongano, n’iyo coba ikimazi cank’ ishikanwa, gushitsa ibihe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.14",
            "verseOrgIds": [
              "1SA.3.14"
            ]
          }
        }
      ]
