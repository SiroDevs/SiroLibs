            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arongera aravuga, ati Ndahiye uguhoraho kw’Uhoraho, Uhoraho ubgiwe ni we azomwiyicira; cank’ umusi wiwe wo gupfa uzoshika; cank’ azomanuka aje mu ntambara, ayigwemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.10",
            "verseOrgIds": [
              "1SA.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 26:11"
          },
