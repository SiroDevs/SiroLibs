              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho azokwishura umuntu wese ukugororoka kwiwe n’ukuyoboka kwiwe; ereg’ uyu musi Uhoraho yari yakumpaye, ndaheza nanka kubangura ukuboko ku wimikishijwe amavuta n’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.23",
            "verseOrgIds": [
              "1SA.26.23"
            ]
          }
        },
        {
