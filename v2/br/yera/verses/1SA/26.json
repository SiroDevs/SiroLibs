                "loc": "1SA.24.6"
              },
              "items": [
                {
                  "text": "1 Sam 24:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.26.16"
              },
              "items": [
                {
                  "text": "26:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho arakabishira kure yanje, ko nobangurira ukuboko uwo Uhoraho yimikishije amavuta; ariko ni wābīre iryo cumu riri ku mutwe wiwe, n’uwo mukuza w’amazi, uze tugende. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.11",
            "verseOrgIds": [
              "1SA.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.21"
              },
              "items": [
                {
                  "text": "Ita 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.12"
              },
              "items": [
                {
                  "text": "15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi ajana iryo cumu n’umukuza w’amazi vyari ku mutwe wa Sauli, barīgīra, ata wubakubise ijisho canke ngw abimenye, haba n’uwokwikangura; bose bari basinziriye, kuk’ Uhoraho yari yabasinzirije ubutikoma.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.12",
            "verseOrgIds": [
              "1SA.26.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
