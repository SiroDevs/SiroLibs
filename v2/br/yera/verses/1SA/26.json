        },
        {
          "text": "Bukeye Abanyezifu baja i Gibeya kwa Sauli, baramubarira, bati Mbeg’ aho ntuzi ko Dawidi yinyegeje ku musozi Hakila, aharābana n’ubugaragwa? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.1",
            "verseOrgIds": [
              "1SA.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
