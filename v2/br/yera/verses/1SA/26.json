                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi aramwishura, ati Ngiri icumu ryawe, mwami! Umwe wo mu basore n’aze aryābīre. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.22",
            "verseOrgIds": [
              "1SA.26.22"
            ]
