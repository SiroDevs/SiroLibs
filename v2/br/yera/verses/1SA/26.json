                "loc": "1SA.24.4"
              },
              "items": [
                {
                  "text": "1 Sam 24:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abishayi abarira Dawidi, at’ Uyu musi Imana igabuye umwansi wawe mu maboko yawe; none rero reka ndamuzibure icumu rimwe gusa, rishinge hasi, sinsubīra ubga kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.8",
            "verseOrgIds": [
              "1SA.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
