            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Dawidi yishura Abishayi, ati Ntumwice: har’ uwoshobora kubangurira ukuboko uwo Uhoraho yimikishije amavuta, ntābizire? ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.9",
            "verseOrgIds": [
              "1SA.26.9"
            ]
          }
        },
        {
