              },
              "items": [
                {
                  "text": "1 Sam 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibirwanishwa vyiwe babishira mu rusengero rwa Ashitaroti, umuvyimba wiwe bawēnētsa ku ruzitiro rw’amabuye rw’igisagara c’i Beti‐shani.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.10",
            "verseOrgIds": [
