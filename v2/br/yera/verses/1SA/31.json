              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye bgaho, Abafilisitiya baje gukoba imivyimba, basanga Sauli n’abahungu biwe batatu barambaraye ku musozi Gilibowa bapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.8",
            "verseOrgIds": [
              "1SA.31.8"
            ]
          }
        },
