            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamuca izosi, bamukoba ibirwanishwa, batuma intumwa mu gihugu c’Abafilisitiya iyo kiva kikagera, ngo bakwize inkuru mu nsengero z’ibigirwamana vyabo no mu bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.9",
            "verseOrgIds": [
              "1SA.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
