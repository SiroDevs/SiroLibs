            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ab’i Yabeshi‐gileyadi bumvise ivy’ Abafilisitiya bagiriye Sauli, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.31.11",
            "verseOrgIds": [
