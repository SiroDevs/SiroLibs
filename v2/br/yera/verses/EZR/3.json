            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Guhēra ku musi wa mbere w’ukwezi kw’indwi ni ho batanguye kwosereza Uhoraho ibimazi, arikw itanguriro ry’urusengero rwiwe ntiryaribgashirweho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
