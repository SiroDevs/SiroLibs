              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gicaniro bacubaka aho cahora, kuko bari batewe ubgoba n’abantu bo mur’ ivyo bihugu; bacoserezak’ Uhoraho ibimazi vyo mu gitondo n’ivyo ku mugoroba.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
