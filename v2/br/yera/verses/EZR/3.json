            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "hanyuma bakomeza gutanga ibimazi vyo kwoswa vy’intasība, n’ivyo mu mboneko z’amezi, n’ivy’ imisi mikuru yose yerejwe Uhoraho, n’ ivyo umuntu wese yagomba gushikanira Uhoraho ishikanwa bivuye ku mutima ukunze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
