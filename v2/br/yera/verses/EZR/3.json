        {
          "text": "Bagira imisi mikuru y’insago, nk’uko vyanditswe, batanga ibimazi vyo kwoswa vyo ku musi n’ umusi, nk’ukw igitigiri cavyo kiri, uko vyari vyarashinzwe ngo babikurikiranye uko bukeye; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
