                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, Tatenayi, wewe cēgēra canje co hakurya y’uruzi, nawe Shetari‐bozenayi na bagenzi banyu b’Abafarisaki bo hakurya y’uruzi, ntimuje mur’ ivyo, s’ivyanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.6",
            "verseOrgIds": [
              "EZR.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "mureke igikorwa c’ iyo nzu y’Imana kije imbere, mureke n’icēgēra canje kigaba Abayuda n’abakuru babo bubake iyo nzu y’Imana mu kibanza cayo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.7",
            "verseOrgIds": [
              "EZR.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nshinze ibgirizwa ry’ ivyo mukwiye gukorera abakuru b’Abayuda mu vyo kwubakisha iyo nzu y’Imana: mugire umwete cane wo guha abo bantu ivyo bazotanga, kugira ngo hoye kuzogira ikibabuza gukora, muvyabiriye ku bintu vyanje, mbere kw ikori ry’ abo hakurya y’uruzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.8",
            "verseOrgIds": [
              "EZR.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’ ivyo bazokena nk’amamasa y’ imikangara n’amapfizi y’intama n’ imyagazi y’intama nyene vyo gutangakw ibimazi vyo kwosereza Imana Nyen’ ijuru, n’ingano n’ umunyu na vino n’amavuta, ivyo abaherezi b’i Yerusalemu bazokwāka, baze bame babihabga uko bukeye, ntibasībe, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.9",
            "verseOrgIds": [
              "EZR.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.7"
              },
              "items": [
                {
                  "text": "Yer 29:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.2"
              },
              "items": [
                {
                  "text": "1 Tim 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo baze bahore baha Imana Nyen’ ijuru ibimazi vy’umubabge umota neza, kandi bansabire kuramba, jewe umwami n’abahungu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.10",
            "verseOrgIds": [
              "EZR.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.5"
              },
              "items": [
                {
                  "text": "Dan 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.3.29"
              },
              "items": [
                {
                  "text": "3:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nshinze itēka, k’umuntu wese azohindura iri bgirizwa, bazositura inkingi mu nzu yiwe, bayishinge bayimumanikeko, kand’ inzu yiwe bayihindure ikirundo c’isakamburira bamuhoye ivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.11",
            "verseOrgIds": [
              "EZR.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.3"
              },
              "items": [
                {
                  "text": "1 Abam 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Imana yatumye izina ryayo rihaba, iragatsinda umwami wese n’ihanga ryose, abazorenga ibgirizwa ryanje, bakaramvura amaboko yabo, ngo basambure iyo nzu y’Imana i Yerusalemu. Jewe Dariyo nshinze iryo bgirizwa; rize rikorwe rishimikiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.12",
            "verseOrgIds": [
              "EZR.6.12"
            ]
          }
        }
      ]
