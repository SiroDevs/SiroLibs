          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Tatenayi icēgēra c’ umwami co hakuno y’uruzi na Shetari‐bozenayi na bagenzi babo bumvise ijambo ry’umwami Dariyo, bagira umwete wo kubishitsa nk’uko yabatumyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.13",
            "verseOrgIds": [
              "EZR.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
