                "loc": "EZR.7.21"
              },
              "items": [
                {
                  "text": "7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abakuru b’Abayuda bagira ikiganza ciza mu kwubaka, bafashijwe n’ukuvugishwa kwa Hagayi uwavugishwa n’Imana na Zekariya mwene Ido. Barayubaka iruzura, nk’ukw ibgirizwa ry’Imana y’ Abisirayeli ryashinze, kandi no kubg’ icagezwe ca Kuro na Dariyo, na Aritazeruzi umwami w’i Buperesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.14",
            "verseOrgIds": [
              "EZR.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.7"
              },
              "items": [
                {
                  "text": "Est 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ngoro yuzura ku musi ugira gatatu w’ukwezi kwa Adari, kwo mu mwaka ugira gatandatu umwami Dariyo ari ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.6.15",
            "verseOrgIds": [
              "EZR.6.15"
            ]
          }
        }
