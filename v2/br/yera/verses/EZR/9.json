            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndavuga, nt’ Ewe Mana yanje, isoni ziriko zirammwa, mu maso hanje hāhīndānye, bimbuza kukwunamurirakw amaso, Mana yanje, kukw ibigabitanyo vyacu bigwiriye, bikaba umurengera, ivyo twakoze biradutsinze, vyarundanye bigera mw ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.6",
            "verseOrgIds": [
              "EZR.9.6"
            ]
          }
        },
