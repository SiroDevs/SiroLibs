        },
        {
          "text": "Ariko noneho mur’ aka kanya gatoya Uhoraho Imana yacu atweretse ikigongwe ciwe, adusigariza amasigarira, adushimangiye nk’umusumari Ahēra hiwe, kugira ngw akeshe amaso yacu, aduhēmbūre buhoro mu bugurano bgacu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.8",
            "verseOrgIds": [
              "EZR.9.8"
            ]
          }
        },
