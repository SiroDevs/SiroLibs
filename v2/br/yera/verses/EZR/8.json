                  "text": "Neh 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ntora icumi na babiri mu bakuru b’abaherezi, ari bo Sherebiya na Hashabiya, n’abandi cumi muri bagenzi babo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.7.15"
              },
              "items": [
                {
                  "text": "Ezr 7:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amafeza n’amazahabu n’ ibintu vy’imbombovu mbigera ku munzane babona, ari vyo vyatanzwekw amashikanwa y’ingoro y’ Imana yacu, ivy’ umwami n’ abajanama biwe n’abaganwa biwe n’Abisirayeli bāriho bose bāshikanye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndabigera, ndaheza ndabibazēza, ar’ italanto z’ ifeza amajana atandatu na mirongwitanu, n’ibintu vy’imbombovu bicuzwe mu mafeza italanto ijana, n’italanto z’izahabu ijana nyene; ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibikombe vy’izahabu mirongwibiri biciye amahera yitwa dariki igihumbi, n’ibikoreshwa bibiri vy’imiringa myiza isenwe y’ igiciro kinini nk’ic’ izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
