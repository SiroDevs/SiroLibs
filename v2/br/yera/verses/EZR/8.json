                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndababgira, nti Mwebge mur’ aberejwe Uhoraho, n’ibintu vy’ imbombovu na vyo nyene n’ ivyera, kand’ ayo mafeza n’amazahabu ni yo mashikanwa bashikaniye Uhoraho Imana ya ba sogokuruza bivuye ku mitima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvyitwaririke mubizigame, kugeza aho muzobigerera ku munzane imbere y’abakuru b’abaherezi n’Abalewi n’abakuru b’ amazu ya ba sogokuruza b’Abisirayeli, mu vyumba vyo mu ngoro y’Uhoraho i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abaherezi n’Abalewi bākīra ayo mafeza n’amazahabu n’ibindi bintu uk’ urugero rwavyo rwangana, ngo babijane i Yerusalemu mu ngoro y’Imana yacu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
