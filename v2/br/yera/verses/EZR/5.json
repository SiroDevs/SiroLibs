              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ iyo misi nyene Tatenayi icēgēra c’umwami co hakuno y’uruzi, na Shetari‐bozenayi na bagenzi babo, baza aho bari, barababaza, bati Ni nde yabahaye ibgirizwa ryo kwubaka iyi nzu, ngo mwuzuze n’uru ruzitiro? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.3",
            "verseOrgIds": [
              "EZR.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi barababaza, bat’ Abantu bubaka iyi nzu ni ba nde? ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.4",
            "verseOrgIds": [
              "EZR.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.33.18"
              },
              "items": [
                {
                  "text": "Zab 33:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abakuru b’Abayuda, inyonga z’Imana yabo ziguma kuri bo, ntibābabuza kwubaka gushitsa batumye kuri Dariyo, icete c’inyishu kikagaruka.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.5",
            "verseOrgIds": [
              "EZR.5.5"
            ]
          }
        }
