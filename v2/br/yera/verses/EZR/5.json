                {
                  "text": "Ezr 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.14"
              },
              "items": [
                {
                  "text": "6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Zerubabeli mwene Sheyalitiyeli na Yosuwa mwene Yehozadaki bakūra hasi, batangura gusubira kwubaka ingoro y’Imana ir’i Yerusalemu, bari kumwe n’ abo bavugishwa n’Imana babafasha. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 5:3"
