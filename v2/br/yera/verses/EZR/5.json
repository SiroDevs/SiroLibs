              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abavugishwa n’Imana Hagayi na Zekariya mwene Ido bavugishwa mw izina ry’Imana y’Abisirayeli, babarira Abayuda bar’ i Buyuda n’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
