            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baratwishura, bati Tur’ abasavyi b’Imana Nyen’ ijuru n’isi, kandi turiko turasubira kwubaka ingoro yari yarubatswe kera, ubu hashize imyaka myinshi, iyo umwami ahambaye w’Abisirayeli yari yarubatse akayuzuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.11",
            "verseOrgIds": [
              "EZR.5.11"
            ]
          }
        },
