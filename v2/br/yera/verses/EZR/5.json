                  "text": "Ezr 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bat’ Ariko mu mwaka wa mbere Kuro umwami w’i Babuloni ari ku ngoma, uwo mwami Kuro nyene yashinze ibgirizwa yukw iyi ngoro y’Imana yubakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.13",
            "verseOrgIds": [
              "EZR.5.13"
            ]
          }
        },
