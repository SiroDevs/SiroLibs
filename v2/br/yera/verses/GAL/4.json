                "loc": "2CO.2.5"
              },
              "items": [
                {
                  "text": "2 Kor 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabinginze, bene Data, mumere nkanje, kuko nanje mmeze nkamwe. Nta nabi mwangiriye, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.12",
            "verseOrgIds": [
              "GAL.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GAL 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.6"
              },
              "items": [
                {
                  "text": "Ivyak 16:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.3"
              },
              "items": [
                {
                  "text": "1 Kor 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko murazi yukw amagara make y’umubiri ari yo yatumye mbabarira ubutumwa bgiza ubga mbere: ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.13",
            "verseOrgIds": [
              "GAL.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GAL 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.11"
              },
              "items": [
                {
                  "text": "Ivyak 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ivyābagerageza kubg’ umubiri wanje ntimwabitītūye, ntimwāciriye inyeri, ariko mwānyakiriye nk’umumarayika w’Imana, canke nka Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.14",
            "verseOrgIds": [
              "GAL.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GAL 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "None kwa kwishima kwanyu kuri hehe? Nd’ icabona canyu yukw iyo biba vyarashobotse, muba mwaremeye kwinogora amaso, mukayampa. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.15",
            "verseOrgIds": [
              "GAL.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GAL 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.10"
              },
              "items": [
                {
                  "text": "Am 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega mpinduwe umwansi wanyu no kubabgira ukuri? ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.16",
            "verseOrgIds": [
              "GAL.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GAL 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.1.7"
              },
              "items": [
                {
                  "text": "Gal 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bandi babagirira ishaka mu buryo butari bgiza; arikw ico bagomba n’ukubazigira hanze, kugira ngo namwe mubagirire ishaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.17",
            "verseOrgIds": [
              "GAL.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo, ni vyiza kugirira ivyiza ishaka ibihe vyose, atar’ igihe turi kumwe gusa, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.18",
            "verseOrgIds": [
              "GAL.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 4:19"
          },
          "items": [
