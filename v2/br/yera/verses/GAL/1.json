            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ubu n’ishimwe ry’abantu ngomba, canke n’iry’ Imana? Canke se ndondera kunezereza abantu? Iyo mba nkinezereza abantu, simba nd’umugurano wa Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.10",
            "verseOrgIds": [
              "GAL.1.10"
            ]
          }
        }
