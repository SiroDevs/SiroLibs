        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.1"
              },
              "items": [
                {
                  "text": "Ivyak 15:1",
                  "type": "text"
                }
              ]
