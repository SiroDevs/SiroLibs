            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.19"
              },
              "items": [
                {
                  "text": "1 Yoh 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yitangiye ivyaha vyacu, ngw aturokore mur’ iki gihe kibi ca none, nk’ukw Imana yacu yagomvye, ni yo Data we twese. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.4",
            "verseOrgIds": [
              "GAL.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GAL 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icubahiro kibe icayo ibihe bitazoshira. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.5",
            "verseOrgIds": [
              "GAL.1.5"
            ]
          }
        }
      ]
    },
    {
