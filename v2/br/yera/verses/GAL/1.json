              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndatangaye yuko muriko murareka vuba murtyo Iyabahamagaye kubg’ ubuntu bga Kristo, mukemera ubutumwa bunyuranye n’ubgo, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.6",
            "verseOrgIds": [
              "GAL.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
