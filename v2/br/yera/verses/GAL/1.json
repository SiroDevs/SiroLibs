                  "text": "Ivyak 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu bgoko bgacu narushije benshi bo mu bo twārukanye kuja imbere mw idini y’Abayuda, kuko nabarusha kugira ishaka ry’imigenzo twārazwe na ba sogokuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.14",
            "verseOrgIds": [
              "GAL.1.14"
            ]
          }
        },
        {
