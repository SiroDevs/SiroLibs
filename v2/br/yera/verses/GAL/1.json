                  "text": "Ivyak 26:4-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwumvise ingeso zanje nari mfise kera, nkiri mw idini y’Abayuda, ingene nahīga ishengero ry’Imana birengereje, nkaritikiza. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.13",
            "verseOrgIds": [
              "GAL.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
