            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw aho bihimbariye Imana yandobanuye nkiri mu nda ya mama, ikampamagara kubg’ ubuntu bgayo, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.15",
            "verseOrgIds": [
              "GAL.1.15"
            ]
          }
        },
