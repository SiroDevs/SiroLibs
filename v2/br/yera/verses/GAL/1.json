            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "guhishurira umutima wanje Umwana wayo, ngo mvuge ubutumwa bgiwe bgiza mu banyamahanga, ako kanya sinagishije inama abafise inyama n’amaraso, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.16",
            "verseOrgIds": [
