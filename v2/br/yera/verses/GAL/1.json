            }
          ]
        },
        {
          "text": "ariko bumva gusa abamvuga, bat’ Umwe yahora aduhīga mbere, ubu asigaye yamamaza ivyizerwa yatikiza kera; ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.23",
