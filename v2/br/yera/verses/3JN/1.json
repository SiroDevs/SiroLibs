              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe umushingantahe ndakwandikiye Gayo umukundwa, nkunda vy’ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.1",
            "verseOrgIds": [
              "3JN.1.1"
