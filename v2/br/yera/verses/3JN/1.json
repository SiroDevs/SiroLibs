            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari mfise vyinshi vyo kukwandikira, mugabo singomba kukwandikishiriza wino n’ikaramu: ",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.13",
            "verseOrgIds": [
              "3JN.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "3JN 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko nizigiye ko nzokubona vuba, tukazovugana imbonankubone.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.14",
            "verseOrgIds": [
              "3JN.1.14"
            ]
          }
        }
