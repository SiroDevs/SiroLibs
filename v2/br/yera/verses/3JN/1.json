          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.2"
              },
              "items": [
                {
                  "text": "Heb 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.10"
              },
              "items": [
                {
                  "text": "2 Yoh 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko twebge dukwiye kwākīra neza abameze bartyo, kugira ngo dufatanye n’ukuri gukora igikorwa.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.8",
            "verseOrgIds": [
              "3JN.1.8"
            ]
          }
        }
      ]
    },
