          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.35"
              },
              "items": [
                {
                  "text": "Yoh 19:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.24"
              },
              "items": [
                {
                  "text": "21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Demetiriyo ashingirwa intahe na bose, kandi n’ukuri ubgakwo kurayimushingira: natwe nyene turayimushingira; nawe urazi kw ivyo dushingira intahe ar’ ivy’ ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "3JN.1.12",
            "verseOrgIds": [
              "3JN.1.12"
            ]
          }
        }
      ]
