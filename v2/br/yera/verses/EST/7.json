              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami na Hamani baza gusangira n’umwamikazi Esiteri. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.1",
            "verseOrgIds": [
              "EST.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
