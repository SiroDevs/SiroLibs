                "loc": "EST.3.5"
              },
              "items": [
                {
                  "text": "Est 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo musi Hamani asohoka ahimbawe, afise akanyamuneza mu mutima; arikw abonye Moridekayi ku kirimba i bgami, atamuhagurukiye canke ngw amuroresheko n’ijisho, bimutera gushungumirwa cane. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.9",
            "verseOrgIds": [
              "EST.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara Hamani ariyumanganya, arataha; atuma guhamagara abagenzi, n’umugore wiwe Zereshi. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.3.1"
              },
              "items": [
                {
                  "text": "Est 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.9.7+EST.9.8+EST.9.9+EST.9.10"
              },
              "items": [
                {
                  "text": "9:7-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hamani abīgānira ukw atunze, n’uko bimuhaye icubahiro, n’ abana biwe ingen’ ari benshi, n’ ingen’ umwami yamushize hejuru muri vyose, kandi ko yamukujije kuruta abaganwa b’umwami n’ abamenyekana biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.11",
            "verseOrgIds": [
              "EST.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani arongera arababgira, ati Kandi n’umwamikazi Esiteri nta wundi yakundiye kwinjirana n’umwami ku giturire yiteguye atari jewe; mbere n’ubu yantumiye ngo n’ejo nze njane n’umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.12",
            "verseOrgIds": [
              "EST.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.19"
              },
              "items": [
                {
                  "text": "Est 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyo vyose nta co bimmariye, nkibona wa Muyuda Moridekayi yicaye ku kirimba i bgami. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umugore wiwe Zereshi n’abagenzi biwe bose bamugīra inama, bati Ni bashinge igiti c’intambge mirongwitanu z’ukuboko uciriye mu nkokora, maz’ ejo uz’ usabe umwami atange Moridekayi bakimumanikeko; uheze ubone kwinjirana n’umwami ku giturire unezerewe. Nuko Hamani ashima iyo nama; aca ashingisha ico giti.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        }
      ]
    }
