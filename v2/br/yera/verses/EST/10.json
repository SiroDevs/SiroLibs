            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ibikorwa vyose yakoresheje ububasha bgiwe n’ubushobozi bgiwe, bo n’amajambo adondora neza ubukuru bga Moridekayi, uburyo umwami yamushize hejuru, mbega ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’i Bumedi n’i Buperesi? ",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
