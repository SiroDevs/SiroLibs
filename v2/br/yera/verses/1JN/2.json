          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.10"
              },
              "items": [
                {
                  "text": "Ef 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Narabandikiye ba se, kuko muzi uwahereye ubga mbere na mbere. Narabandikiye misore, kuko mufise inkomezi, kand’ ijambo ry’Imana rikaguma muri mwebge, kandi mwanesheje wa Mubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.14",
            "verseOrgIds": [
              "1JN.2.14"
            ]
