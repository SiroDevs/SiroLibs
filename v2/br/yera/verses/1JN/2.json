          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.10"
              },
              "items": [
                {
                  "text": "Yoh 11:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.35"
              },
              "items": [
                {
                  "text": "12:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwanka mwene Data wundi ari mu mwiza, kand’ agendera mu mwiza, ntazi iy’ aja, kuk’ umwiza wamuhumishije amaso.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.11",
