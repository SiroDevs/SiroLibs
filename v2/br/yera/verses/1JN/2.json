            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na none bana bato, mugume muri we, kugira ngo ni yahishurwa tuze dushire ubgoba, ntidutētererwe imbere yiwe ah’ azozira. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.28",
