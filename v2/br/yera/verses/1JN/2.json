                {
                  "text": "Yoh 11:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūkunda mwene Data wundi aguma mu muco, nta gitsitaza kiri muri we. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.10",
            "verseOrgIds": [
              "1JN.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
