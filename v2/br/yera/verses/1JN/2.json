                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ndabandikira icagezwe gisha, kand’ ico n’ic’ ukuri muri we no muri mwebge: kuk’ umwiza urik’ urashira, umuco w’ukuri umaze kwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.8",
            "verseOrgIds": [
              "1JN.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.4.20"
              },
              "items": [
                {
                  "text": "1 Yoh 4:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūvuga kw ari mu muco, akanka mwene Data wundi, aba akiri mu mwiza na bugingo n’ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.9",
            "verseOrgIds": [
              "1JN.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.13"
              },
              "items": [
                {
                  "text": "Rom 14:13",
                  "type": "text"
