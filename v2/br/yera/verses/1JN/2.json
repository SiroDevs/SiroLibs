                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabandikiye bana bato, kukw ivyaha vyanyu mwabihariwe kubg’ izina ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.12",
            "verseOrgIds": [
              "1JN.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.1.1"
              },
              "items": [
                {
                  "text": "1 Yoh 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabandikiye ba se, kuko mwamenye uwahereye ubga mbere na mbere. Ndabandikiye misore, kuko mwanesheje wa Mubi. Narabandikiye bana bato, kuko muzi Data wa twese. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.13",
            "verseOrgIds": [
              "1JN.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
