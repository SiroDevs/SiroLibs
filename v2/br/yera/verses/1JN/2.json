            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nkunda, s’icagezwe gisha mbandikiye, ariko n’icagezwe ca kera, mwamanye uhereye mbere na mbere: ico cagezwe ca kera ni co rya jambo mwumvise. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.7",
            "verseOrgIds": [
              "1JN.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 2:8"
