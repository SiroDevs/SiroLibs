            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko muzi yuk’ uwo ar’ umugororotsi, murazi yuk’ ūkora ivy’ ukugororoka wese yavyawe na we.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.29",
