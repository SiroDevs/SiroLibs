                "loc": "JER.31.34"
              },
              "items": [
                {
                  "text": "Yer 31:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mweho ukurobanuzwa amavuta mwarobanujwe na we kuguma muri mwebge, namwe ntimurinda kugira uwo kubigisha, ariko nk’uk’ ukwo kubarobanura kwiwe kubigisha vyose, kand’ ar’ukw’ ukuri, atar’ ibinyoma, kandi nk’uko kwabigishije, ni ko muguma muri we.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.27",
            "verseOrgIds": [
              "1JN.2.27"
            ]
          }
        }
