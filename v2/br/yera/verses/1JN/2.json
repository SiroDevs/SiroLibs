                "loc": "1PE.4.2"
              },
              "items": [
                {
                  "text": "1 Pet 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ isi irikw irashirana n’ivyifuzo vyayo, arik’ ūkora ivy’ Imana igomba yamah’ ibihe bidashira.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.17",
