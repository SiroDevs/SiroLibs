              "items": [
                {
                  "text": "Tit 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ikiri mw isi cose ar’ ivyifuzo vy’umubiri, n’ivyifuzo vy’amaso, n’ubgibone bg’ubu bugingo, bitanduruka kuri Data wa twese, ariko vyanduruka mw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.16",
            "verseOrgIds": [
              "1JN.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 2:17"
