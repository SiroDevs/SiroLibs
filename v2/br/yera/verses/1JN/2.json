            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana banje bato, mbandikiye ivyo kugira ngo ntimukore icaha. Kandi ni hagira umuntu akora icaha, dufise Umwitsa kuri Data wa twese, ni Yesu Kristo umugororotsi, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.1",
            "verseOrgIds": [
              "1JN.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.20"
              },
              "items": [
                {
                  "text": "Kol 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.51"
              },
              "items": [
                {
                  "text": "Yoh 11:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ uwo ni we mpongano y’ivyaha vyacu, mugabo s’iy’ ivyacu twenyene, ariko n’iy’ ivy’ abari mw isi bose.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.2",
            "verseOrgIds": [
              "1JN.2.2"
            ]
          }
        }
      ]
    },
    {
