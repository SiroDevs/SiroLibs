            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.3"
              },
              "items": [
                {
                  "text": "1 Yoh 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwitondera ijambo ryiwe wese, ugukunda Imana kuba guhīngūwe muri we vy’ukuri. Iki ni co kitumenyesha ko turi muri we: ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.5",
            "verseOrgIds": [
              "1JN.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.15"
              },
              "items": [
                {
                  "text": "Yoh 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ūvuga kw ahora muri we, akwiye na we kugenda nk’uk’ uwo yagenda.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.2.6",
            "verseOrgIds": [
              "1JN.2.6"
            ]
          }
        }
