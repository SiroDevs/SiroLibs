              "items": [
                {
                  "text": "Mrk 12:29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi dufise iki cagezwe kuri yo, ng’ Ūkunda Imana akunde na mwene Data wundi.",
