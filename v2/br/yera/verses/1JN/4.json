              "1JN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.7",
            "verseOrgIds": [
              "1JN.4.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.29"
              },
              "items": [
                {
                  "text": "1 Yoh 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nkunda, dukundane: kuk’ urukundo ruva ku Mana. Umuntu wese akundana yavyawe n’Imana, kand’ azi Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.7",
            "verseOrgIds": [
              "1JN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūdakundana, ntazi Imana, kukw Imana ar’ urukundo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.8",
            "verseOrgIds": [
              "1JN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.16"
              },
              "items": [
                {
                  "text": "Yoh 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co caseruye urukundo rw’Imana muri twebge, n’ukw Imana yarungitse Umwana wayo w’ikinege mw isi, kugira ngo duheshwe ubugingo na we. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.9",
            "verseOrgIds": [
              "1JN.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.2"
              },
              "items": [
                {
                  "text": "1 Yoh 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co kirimw’ urukundo, s’uko twebge twakunze Imana, ariko n’ukw ari yo yadukunze, igatuma Umwana wayo kuba impongano y’ivyaha vyacu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.10",
            "verseOrgIds": [
              "1JN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.33"
              },
              "items": [
                {
                  "text": "Mat 18:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nkunda, kw Imana yadukunze irtyo, natwe dukwiye gukundana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.11",
            "verseOrgIds": [
              "1JN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.18"
              },
              "items": [
                {
                  "text": "Yoh 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta wigeze kubona Imana. Dukundanye, Imana iguma muri twebge, no kuyikunda kuba guhīngūwe muri twebge.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.12",
            "verseOrgIds": [
              "1JN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.12",
            "verseOrgIds": [
              "1JN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.13",
            "verseOrgIds": [
              "1JN.4.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.3.24"
              },
              "items": [
                {
                  "text": "1 Yoh 3:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.5"
              },
              "items": [
                {
                  "text": "Rom 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co kitumenyesha yuko tuguma muri yo, na yo ikaguma muri twebge, n’uko yaduhaye kuri Mpwemu wayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.13",
            "verseOrgIds": [
              "1JN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.17"
              },
              "items": [
                {
                  "text": "Yoh 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natwe twarabibonye, tubishingira intahe, yuko Data wa twese yatumye Umwana wiwe kuba Umukiza w’isi yose. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.14",
            "verseOrgIds": [
              "1JN.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.5"
              },
              "items": [
                {
                  "text": "1 Yoh 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwatura yuko Yesu ar’ Umwana w’Imana, Imana iguma muri we, na we akaguma mu Mana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.15",
            "verseOrgIds": [
              "1JN.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natwe twamenye kandi twizeye urukundo Imana idufitiye. Imana n’urukundo; kand’ ūguma mu rukundo aguma mu Mana, Imana ikaguma muri we. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.16",
            "verseOrgIds": [
              "1JN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.28"
              },
              "items": [
                {
                  "text": "1 Yoh 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico ni co kimaze guhīngūra urukundo muri twebge, kugira ngo tuze dushire ubgoba ku musi w’amateka, kuk’ ukw ari, ari ko turi mur’ iyi si. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.17",
            "verseOrgIds": [
              "1JN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta bgoba buba mu rukundo, arik’ urukundo ruhīngūwe rusenda ubgoba, kuk’ ubgoba bugendana n’igihano, kand’ ūfise ubgoba ntarahīngūrirwa mu rukundo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.18",
            "verseOrgIds": [
              "1JN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twebge tugira urukundo, kukw ari yo yabanje kudukunda. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.19",
            "verseOrgIds": [
              "1JN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yavuga, ati Nkunda Imana, akanka mwene Data wundi, aba ar’ umubeshi. Kuk’ ūdakunda mwene Data yabonye ntashobora gukunda Imana atābonye. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.4.20",
            "verseOrgIds": [
              "1JN.4.20"
            ]
          }
        },
        {
