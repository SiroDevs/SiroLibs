            "sid": "1JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ubgo bugingo bgarerekanywe, turabubona, turabushingira intahe, kandi turababarira ivy’ ubgo bugingo budashira, bgamanye na Data wa twese, tukabgerekwa — ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
