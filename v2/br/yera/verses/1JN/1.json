            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icariho uhereye ubga mbere na mbere, ico twumvise, ico twabonye n’amaso yacu, ico twitegereje, intoke zacu zikagikorako, ivyo kuri Jambo w’ubugingo — ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
