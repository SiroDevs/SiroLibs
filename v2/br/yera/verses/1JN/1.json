          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu ni bgo butumwa twumvise bgavuye kuri we, tukabubabgira, yukw Imana ar’ umuco, kandi muri yo ko hatagira umwiza na mukeya.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
