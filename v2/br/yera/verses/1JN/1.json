          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko tugendeye mu muco, nk’uko na yo iri mu muco, tuba dufatanije ubgacu, kand’ amaraso ya Yesu Umwana wayo atwoza icaha cose.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
