              },
              "items": [
                {
                  "text": "Yoh 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ico twabonye tukacumva ni co tubabgira namwe, kugira ngo namwe mufatanye natwe. Kandi natwe dufatanije na Data wa twese n’Umwana wiwe Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twanditse ivyo kugira ng’ umunezero wacu wuzure.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
