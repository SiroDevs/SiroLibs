                {
                  "text": "Yak 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuvuze yuko dufatanije na yo, tukagendera mu mwiza, kuba ar’ ukubesha, ntituba dukora ivy’ ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
