          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
