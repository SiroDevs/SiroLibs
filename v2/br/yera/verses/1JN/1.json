            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuvuze yukw ata caha dufise, tuba twizimiza, ukuri ntikuba kuri muri twebge. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.8",
            "verseOrgIds": [
              "1JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni twatura ivyaha vyacu, ni yo yo kwizigirwa kand’ igororoka, ivyo ni vyo bituma iduharira ivyaha vyacu, ikatwoza ukugabitanya kwose.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.9",
            "verseOrgIds": [
              "1JN.1.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
