                "loc": "1KI.15.27"
              },
              "items": [
                {
                  "text": "1 Abam 15:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira mirongwibiri n’indwi Asa umwami w’i Buyuda ari ku ngoma, ni ho Zimuri yima i Tirusa, amara imisi ndwi ari ku ngoma. Ico gihe abantu bari bateye i Gibetoni haganzwa n’ Abafilisitiya, bahūgarije. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.15",
            "verseOrgIds": [
              "1KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu bari bashagaje aho, bumva bavuga, bati Zimuri yayovye, yishe umwami. Uwo musi nyene Abisirayeli bose ni kwo kwimika Omuri, umugabisha w’ingabo, ngw abe umwami wabo; bamwimikira aho nyene aho bashagaje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.16",
            "verseOrgIds": [
              "1KI.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Omuri n’Abisirayeli bose bari kumwe na we, baca bareka i Gibetoni, baja gutera i Tirusa, barahūgariza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.17",
            "verseOrgIds": [
              "1KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.17.23"
              },
              "items": [
                {
                  "text": "2 Sam 17:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.25"
              },
              "items": [
                {
                  "text": "2 Abam 15:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Zimuri abonye ko batsinze igisagara, yitera mu munara wo mu rugo i bgami, yītuririramwo, arapfa, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.18",
            "verseOrgIds": [
              "1KI.16.18"
            ]
          }
        },
        {
