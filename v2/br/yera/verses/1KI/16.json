          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abisirayeli bigabanyamw’ ibice bibiri, igice kimwe gikurikira Tibuni mwene Ginati, kugira ngo bamwimike, ikindi gikurikira Omuri. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.21",
            "verseOrgIds": [
              "1KI.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abākurikiye Omuri banesha abākurikiye Tibuni mwene Ginati; nukw ivyo bizanira Tibuni urupfu, Omuri ahangama ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.22",
            "verseOrgIds": [
              "1KI.16.22"
            ]
          }
        }
      ]
    },
