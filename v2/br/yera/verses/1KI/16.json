          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.15.26"
              },
              "items": [
                {
