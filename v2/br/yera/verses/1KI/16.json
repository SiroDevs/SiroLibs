          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Omuri, n’ivy’ ubuhizi bgiwe, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.27",
            "verseOrgIds": [
              "1KI.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Omuri ahamvya ba sekuruza, bamuhamba i Samariya; maz’ umuhungu wiwe Ahabu asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.28",
            "verseOrgIds": [
              "1KI.16.28"
            ]
