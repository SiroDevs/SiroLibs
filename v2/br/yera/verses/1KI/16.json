          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Zimuri, n’ingene yayovye, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli?",
          "type": "text",
          "attrs": {
            "verseId": "1KI.16.20",
            "verseOrgIds": [
              "1KI.16.20"
            ]
          }
        }
      ]
