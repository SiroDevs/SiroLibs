                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu Bisirayeli bo, nta bo yahinduye abaja; ariko bār’ ingabo zo kuja mu ntambara, n’abagendanyi, n’abagabisha b’ingabo, n’ abatware, n’abagaba abagendera ku mafarasi n’imikogote. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.22",
            "verseOrgIds": [
              "1KI.9.22"
            ]
          }
        },
