          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose b’amasigarira y’Abamori n’ Abaheti n’Abaferizi n’Abahiwi n’ Abayebusi, abatār’ Abisirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.20",
            "verseOrgIds": [
              "1KI.9.20"
            ]
          }
        },
