              "type": "text"
            }
          ]
        },
        {
          "text": "nanje nzotuma ingoma yawe ihangama mu Bisirayeli ibihe vyose, nk’uko nasezeraniye so Dawidi, nkamubarira, nti Ntuzobura uwo gusubira ku ngoma y’ i Bgisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.5",
            "verseOrgIds": [
              "1KI.9.5"
            ]
          }
        },
        {
          "name": "verse",
