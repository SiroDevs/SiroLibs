            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko hashize imyaka mirongwibiri, ari yo Salomo yubakiyemw’ ingoro zompi, iy’ Uhoraho n’iyiwe ubgiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.10",
            "verseOrgIds": [
              "1KI.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "umwami Salomo aha Hiramu ibisagara mirongwibiri mu gihugu c’i Galilaya; kandi Hiramu uwo, umwami w’i Tiro, ni we yari yarahaye Salomo ibiti vy’amasederi n’ivy’ akajwari n’amazahabu, nk’uko yagomba kwose. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.11",
            "verseOrgIds": [
              "1KI.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Hiramu ava i Tiro aja kugendura ivyo bisagara Salomo yamuhaye; maze ntiyabishima. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.12",
            "verseOrgIds": [
              "1KI.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubarira, ati Mbega mugenzi wanje, ibisagara wampaye ubona ar’ ibisagara ki? Ni kwo kuhīta igihugu c’i Kabula;",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
              "1KI.9.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
