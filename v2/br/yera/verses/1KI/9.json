              "type": "text"
            }
          ]
        },
        {
          "text": "nuko nanje nzoherengeteza Abisirayeli mu gihugu nabahaye, kand’ iyi ngoro nejeje kubg’ izina ryanje nzoyishibura imve mu maso; kand’ Abisirayeli bazoba iciro ry’imigani n’agashinyaguro mu mahanga yose; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.7",
            "verseOrgIds": [
              "1KI.9.7"
            ]
          }
        },
