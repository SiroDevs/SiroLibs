            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho aramubarira, ati Numvise ugusenga kwawe n’ukwinginga kwawe wingingiye imbere yanje; kandi nejeje iyi ngoro wubakiye izina ryanje ngo rihabe ibihe vyose; nzoyihozakw amaso n’umutima na ntaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.3",
            "verseOrgIds": [
              "1KI.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
