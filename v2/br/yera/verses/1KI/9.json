            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni mwanta, mukareka kunkurikira, cank’ abana banyu, ntimwitondere ivyagezwe vyanje n’amabgirizwa yanje nabashize imbere, mukaja gusaba izindi mana, mukaba ari zo musenga; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.6",
            "verseOrgIds": [
              "1KI.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
