            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibisagara vyose vy’ibigega vyiwe, n’ibisagara vyo kubīkamw’ imikogote yiwe, n’ivy’ abagendera ku mafarasi biwe, n’ amazu yose yagomvye kwubaka i Yerusalemu n’i Lebanoni no mu gihugu cose yaganza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.19",
            "verseOrgIds": [
              "1KI.9.19"
            ]
          }
        },
        {
