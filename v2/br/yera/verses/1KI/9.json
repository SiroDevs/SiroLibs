            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ iyi ngoro nah’ ar’ agahambaye irtya, ūzoyica i ruhande wese azokwumirwa, avuze agahwa, at’ Ariko n’iki catumye Uhoraho agirira artya iki gihugu n’iyi ngoro? ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.8",
            "verseOrgIds": [
              "1KI.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazomwishura, bati N’uko bahevye Uhoraho Imana yabo, yakūye ba sekuruza mu gihugu ca Egiputa, bakaramatana n’izindi mana, bakazisenga, bakaba ari zo basaba; ni co catumye Uhoraho abateza ivyo vyago vyose.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.9",
            "verseOrgIds": [
              "1KI.9.9"
            ]
          }
        }
