            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nawe ni wagendera imbere yanje nk’uko so Dawidi yagenda, ufise umutima w’ukuri kand’ utunganye, ugakora ivyo nakugeze vyose, ukitondera amabgirizwa yanje n’amateka nashinze; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.4",
            "verseOrgIds": [
              "1KI.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
