        },
        {
          "text": "Maze Salomo arangije kwubaka ingoro y’Uhoraho n’ingoro y’ubgami n’ivyo yagomvye gukora vyose, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.1",
            "verseOrgIds": [
              "1KI.9.1"
            ]
