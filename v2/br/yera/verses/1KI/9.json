              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Hiramu yari yararungikiye umwami Salomo amazahabu italanto ijana na mirongwibiri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.14",
