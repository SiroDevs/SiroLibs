                {
                  "text": "7:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Farawo umwami wa Egiputa yari yarateye i Gezeri, arahatsinda, arahaturira, ageseza Abanyakanani bāba mur’ ico gisagara, ahaha muka Salomo umukobga wiwe kw indongoranywa. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.16",
            "verseOrgIds": [
              "1KI.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo yubaka i Gezeri nyene, n’i Beti‐horoni ho hepfo, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.17",
            "verseOrgIds": [
              "1KI.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Bayalati n’i Tamari mu bugaragwa bgo mu gihugu c’Abayuda; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.18",
            "verseOrgIds": [
              "1KI.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 9:19"
          },
          "items": [
