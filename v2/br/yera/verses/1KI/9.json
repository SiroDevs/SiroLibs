          "items": [
            {
              "text": "9:13",
              "type": "text"
            },
            {
              "text": "Kabula risobanurwa ngw Ahantu habi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kandi ni ko hacitwa na bugingo n’ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.9.13",
            "verseOrgIds": [
