              "items": [
                {
                  "text": "1 Abam 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira kabiri Asa umwami w’i Buyuda ari ku ngoma, ni ho Nadabu mwene Yerobowamu yima mu Bgisirayeli; amara imyaka ibiri aganza Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.25",
            "verseOrgIds": [
              "1KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.30"
              },
              "items": [
                {
                  "text": "1 Abam 12:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.16"
              },
              "items": [
                {
                  "text": "14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakora ivyo Uhoraho abona kw ari bibi, akagendera mu ngeso za se, no mu vyaha yakoze, akabikwegeramwo n’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.26",
            "verseOrgIds": [
              "1KI.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.14"
              },
              "items": [
                {
                  "text": "1 Abam 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.15"
              },
              "items": [
                {
                  "text": "16:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze hanyuma Bayasha mwene Ahiya, wo mu muryango wa Isakari, aramugarariza; amwicira i Gibetoni haganzwa n’Abafilisitiya; kukw ico gihe Nadabu n’ Abisirayeli bose bari bateye i Gibetoni bahūgarije. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.27",
            "verseOrgIds": [
              "1KI.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira gatatu Asa umwami w’Abayuda ari ku ngoma ni ho ico gihe Bayasha yamwica; araheza yiyimika mu gishingo ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.28",
            "verseOrgIds": [
              "1KI.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.10"
              },
              "items": [
                {
                  "text": "1 Abam 14:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agiheza kwima, ageseza ab’ inzu ya Yerobowamu bose; mu ba Yerobowamu ntiyasiga n’umwe agihumeka, gushitsa abaherengeteje, nk’ukw ijambo ry’Uhoraho ryavuze, iryo yavugiye mu kanwa k’umusavyi wiwe Ahiya w’i Shilo, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubg’ ivyaha Yerobowamu yakoze, akabikwegeramwo n’Abisirayeli, no kubg’ umwikomo yateye Uhoraho Imana y’Abisirayeli, akamuratsa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
    },
