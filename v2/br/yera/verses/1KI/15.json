                  "text": "2 Ngo 16:11-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Asa, n’ivy’ ububasha bgiwe bgose, n’ivyo yakoze vyose, n’ibisagara yubatse, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’ abami b’i Buyuda? Arikw ageze mu zabukuru, arwara ibirenge. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.23",
            "verseOrgIds": [
              "1KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
