          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.1"
              },
              "items": [
                {
                  "text": "2 Ngo 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.8"
              },
              "items": [
                {
                  "text": "Mat 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Asa ahamvya ba sekuruza, ahambga hamwe na bo ku murwa wa sekuruza Dawidi; maz’ umuhungu wiwe Yehoshafati asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.24",
            "verseOrgIds": [
              "1KI.15.24"
            ]
          }
        }
      ]
