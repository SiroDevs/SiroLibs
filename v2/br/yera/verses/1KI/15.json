              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Nadabu, n’ivyo yakoze vyose, none ntivyanditswe mu gitabo c’ ivyo ku ngoma z’abami b’Abisirayeli? ",
          "type": "text",
          "attrs": {
