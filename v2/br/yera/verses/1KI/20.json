                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.24"
              },
              "items": [
                {
                  "text": "16:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Beni‐hadadi umwami w’i Siriya akoranya ingabo ziwe zose, aradūga aja gutera i Samariya, ahugariza impande zose; abami mirongwitatu na babiri bafatanya na we, bari n’amafarasi n’imikogote y’intambara. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.1",
            "verseOrgIds": [
              "1KI.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuma intumwa mur’ ico gisagara kuri Ahabu umwami w’Abisirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.2",
            "verseOrgIds": [
              "1KI.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "muti Beni‐hadadi agize ngw Amafeza yawe n’amazahabu yawe n’ayiwe; ngo Mbere n’abarusha abandi ubgiza mu bagore bawe no mu bana bawe, ngo Na bo n’abiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.3",
            "verseOrgIds": [
              "1KI.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami w’Abisirayeli arabishura, muti Bizoba uk’ uvuze, segaba mwami wiwe; muti N’uwawe, bo n’ivy’ afise vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.4",
            "verseOrgIds": [
              "1KI.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye izo ntumwa ziragaruka, ziti Beni‐hadadi agize ngo Yari yagutumyeko ng’ umuhe amafeza yawe n’ amazahabu, n’abagore bawe n’ abana; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.5",
            "verseOrgIds": [
              "1KI.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngw Ariko rer’ ejo nk’ aya mango azorungika abantu biwe i wawe, basakangure mu ngoro yawe no mu mazu y’abantu bawe; maz’ ico bazobona cose giteye igomwe bakinyage, bakizane.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.20.6",
            "verseOrgIds": [
              "1KI.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
