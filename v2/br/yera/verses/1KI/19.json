              "items": [
                {
                  "text": "Mrk 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw aravyuka, ararya, aranywa; izo ndya azigendera imisi mirongwine n’amajoro mirongwine, ashika i Horebu ku musozi w’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.8",
            "verseOrgIds": [
              "1KI.19.8"
            ]
          }
        }
      ]
