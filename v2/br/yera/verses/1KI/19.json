                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho aramubarira, ati Subiray’ ujane inzira wazananye, uje mu bugaragwa bg’i Damasiko; ni washikayo, uz’ urobanuze Hazayeli amavuta, az’ abe umwami w’i Siriya; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.19.15",
            "verseOrgIds": [
              "1KI.19.15"
            ]
          }
        },
        {
          "name": "verse",
