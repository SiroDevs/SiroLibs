              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashitseyo, yinjira mw isenga, abaho; maz’ ijambo ry’Uhoraho rimuzako, riramubaza, rit’ Ukora iki hano ga Eliya? ",
          "type": "text",
          "attrs": {
