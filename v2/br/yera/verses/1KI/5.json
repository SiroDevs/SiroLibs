                "loc": "1KI.9.15"
              },
              "items": [
                {
                  "text": "9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami Salomo atoza abantu bo kuba abanyabikebere mu Bisirayeli hose; abo yatoje baba ibihumbi mirongwitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akāma abarungika i Lebanoni, bagahāna imbu, ibihumbi icumi‐icumi mu kwezi, bakamara ukwezi kumwe i Lebanoni, abiri bakayamara i muhira. Adoniramu ni we yagaba ivy’ abo banyabikebere. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.20+1KI.9.21+1KI.9.22"
              },
              "items": [
                {
                  "text": "1 Abam 9:20-22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.18"
              },
              "items": [
                {
                  "text": "2 Ngo 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Salomo yari yarashizeh’ abantu ibihumbi mirongwirindwi bāshinzwe ivyo kwikorera, n’abandi ibihumbi mirongumunani bāshinzwe kubāza amabuye ku misozi; ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.23"
              },
              "items": [
                {
                  "text": "1 Abam 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "udashizemw’ abakoresha biwe bakuru bākoresha ivyo bikorwa, ibihumbi bitatu n’amajana atatu, bāgaba abo bakozi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        },
