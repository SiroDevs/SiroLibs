              "items": [
                {
                  "text": "2 Sam 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.3"
              },
              "items": [
                {
                  "text": "2 Ngo 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu umwami w’i Tiro yumvise ko bimikishije Salomo amavuta ngw asubire ku ngoma ya se, amutumakw intumwa, kuk’ uhereye kera Hiramu yakundana na Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.3+2CH.2.4+2CH.2.5+2CH.2.6+2CH.2.7+2CH.2.8+2CH.2.9+2CH.2.10+2CH.2.11+2CH.2.12+2CH.2.13+2CH.2.14+2CH.2.15+2CH.2.16"
              },
              "items": [
                {
                  "text": "2 Ngo 2:3-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo atuma kwishura Hiramu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.2",
            "verseOrgIds": [
              "1KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.8"
              },
              "items": [
                {
                  "text": "1 Ngo 22:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.3"
              },
              "items": [
                {
                  "text": "28:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ut’ Urazi ko se Dawidi atābonye uburyo bgo kwubaka ingoro y’izina ry’ Uhoraho Imana yiwe, kubg’ intambara z’abansi biwe zari zimuturutse irya n’ino, uti Gushitsa ah’ Uhoraho yabashiriye musi y’ibirenge vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.3",
            "verseOrgIds": [
              "1KI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.24"
              },
              "items": [
                {
                  "text": "1 Abam 4:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.9"
              },
              "items": [
                {
                  "text": "1 Ngo 22:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ut’ Ariko we, Uhoraho Imana yiwe amuhaye impore impande zose; uti Nta murwanizi nta n’agakakaza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.4",
            "verseOrgIds": [
              "1KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.10"
              },
              "items": [
                {
                  "text": "1 Ngo 22:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.6"
              },
              "items": [
                {
                  "text": "28:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Non’ afise imigabo yo kwubaka ingoro y’izina ry’Uhoraho Imana yiwe, uti Nk’uk’ Uhoraho yabariye se wiwe Dawidi, at’ Umwana wawe nzosubiza ku ngoma yawe ni we azonyubakira ingoro y’izina ryanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.5",
            "verseOrgIds": [
              "1KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti None rer’ umubaririre abamwicirira ibiti vy’ amasederi i Lebanoni, uti Kand’ abantu biwe bazofatanya n’abawe; uti Kand’ azoguha ingero z’abakozi bawe uk’ uzozicīra kwose; uti Kuk’ uzi yukw ata n’umwe mu b’i wabo azi kwicira ibiti nk’Abasidoni.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hiramu yumvise amajambo ya Salomo aranezerwa cane, aravuga, at’ Uyu musi Uhoraho ashemagizwe, kuko yahaye Dawidi umwana w’incabgenge wo kuganza iryo hanga rihambaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hiramu atuma kuri Salomo, uti Yumvise ivyo umutumyeko; uti Nukw azogukorera ivyo wamusavye vyose ku vy’ibiti vy’amasederi no ku vy’ akajwari. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.7"
              },
              "items": [
                {
                  "text": "Ezr 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.20"
              },
              "items": [
                {
                  "text": "Ivyak 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ut’ Abantu biwe bazobikūra i Lebanoni, babimanukane babishikane ku kiyaga; uti Bishitseyo azobitekera imbambo, abicīshe mu kiyaga, ut’ Abishikane ah’ uzomurangira, babitekururireho, uti Nawe abe ari ho uzovyākīrira. Uti Nawe ni watanga ivyo kugaburira abo mu rugo rwiwe, uzoba uhaye.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hiramu aha Salomo ibiti vy’amasederi n’ivy’ akajwari, nk’uko yagomba kwose. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo na we agaha Hiramu ingano ingero zitwa koro ibihumbi mirongwibiri zo kugaburira abo mu rugo rwiwe, n’amavuta akūwe muri elayo zisekuwe ingero mirongwibiri. Uko ni ko Salomo yaha Hiramu uk’ umwaka utashe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.12"
              },
              "items": [
                {
                  "text": "1 Abam 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Uhoraho aha Salomo ubgenge nk’uko yamusezeraniye, na we abana amahoro na Hiramu, basezerana isezerano ryo gufatanya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        }
      ]
    },
    {
