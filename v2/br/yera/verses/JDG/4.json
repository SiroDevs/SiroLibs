              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze babarira Sisera yuko Baraki mwene Abinowamu adūze ashitse ku musozi Tabora. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.12",
            "verseOrgIds": [
              "JDG.4.12"
            ]
          }
        },
        {
