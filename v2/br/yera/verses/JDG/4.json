          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni kw Imana yamaze igabo Yabina umwami w’i Kanani kur’ uwo musi, imbere y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.23",
            "verseOrgIds": [
              "JDG.4.23"
            ]
          }
        },
