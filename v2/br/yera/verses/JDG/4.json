                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye atuma i Kedeshi‐nafutali guhamagara Baraki mwene Abinowamu; aramubgira, at’ Uhoraho Imana y’Abisirayeli arakugeze, ngo Genda ukoranirize i Tabora ingabo ibihumbi cumi bo mu ba Nafutali no mu ba Zebuloni; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.6",
            "verseOrgIds": [
              "JDG.4.6"
            ]
          }
        },
        {
