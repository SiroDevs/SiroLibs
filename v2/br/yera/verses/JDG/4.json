              "items": [
                {
                  "text": "Abac 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sisera akoranya imikogote yiwe yose y’ivyuma ukw ar’ amajana cenda, n’ingabo zose yar’ afise, uhereye i Harosheti‐ha‐goyimu ugashitsa ku mugezi Kishoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.13",
            "verseOrgIds": [
              "JDG.4.13"
            ]
          }
        },
