        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.19"
              },
              "items": [
                {
                  "text": "Abac 1:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.9"
              },
              "items": [
                {
                  "text": "3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abisirayeli batakambira Uhoraho, kubg’ imikogote y’ivyuma amajana cenda Yabina yar’ afise, kandi yar’ amaze imyaka mirongwibiri ahahaza Abisirayeli bibi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.3",
            "verseOrgIds": [
              "JDG.4.3"
            ]
          }
        }
      ]
    },
    {
