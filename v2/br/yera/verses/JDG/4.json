          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Abisirayeli bagenda barushiriza kugira ubushobozi bgo kumunesha, gushitsa bamuherengeteje.",
          "type": "text",
