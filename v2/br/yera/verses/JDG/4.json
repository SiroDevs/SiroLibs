            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Debora abgira Baraki, ati Haguruka, kuk’ uyu musi ari wo Uhoraho agabuye Sisera mu maboko yawe. Rāba Uhoraho ni we akugiye imbere. Nuko Baraki amanukana n’ingabo ziwe ukw ar’ ibihumbi cumi, bava ku musozi Tabora bamukōndōreye inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.14",
            "verseOrgIds": [
              "JDG.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
