        },
        {
          "text": "Uhoraho abagabura mu maboko ya Yabina umwami w’i Kanani, yaba i Hasori; kand’ umugabisha w’ingabo ziwe yari Sisera, yaba i Harosheti‐ha‐goyimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.2",
            "verseOrgIds": [
              "JDG.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
