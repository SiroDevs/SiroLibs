            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho ashwiragiriza imbere ya Baraki imikogote yose ya Sisera n’ingabo ziwe zose, abatsindisha inkota; Sisera arataruka ava mu mukogote wiwe, ahunga yiruka ku maguru. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.4.15",
            "verseOrgIds": [
              "JDG.4.15"
            ]
          }
        },
