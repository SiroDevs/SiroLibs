              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijoro ry’uwo musi Uhoraho aramubarira, ati Va hasi, umanuke aho bashagaje, kuko mbagabuye mu maboko yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.9",
            "verseOrgIds": [
              "JDG.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni waba utinya kumanukayo, jana n’uwo muntu wawe Pura umanuke aho bashagaje; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.10",
            "verseOrgIds": [
              "JDG.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.9"
              },
              "items": [
                {
                  "text": "1 Sam 14:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "wumvirize ivyo bavuga; ni ho uja kurema, ubone kumanuka kubatera. Nukw amanukana n’umuntu wiwe Pura, bashikira ku ngabo za mbere ziteramye aho bashagaje. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.11",
            "verseOrgIds": [
              "JDG.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 7:12"
          },
          "items": [
