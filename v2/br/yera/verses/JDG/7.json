              "attrs": {
                "loc": "1SA.13.5"
              },
              "items": [
                {
                  "text": "1 Sam 13:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.23"
              },
              "items": [
                {
                  "text": "Yer 46:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abamidiyani n’Abamaleki n’ab’i burasirazuba bose bari bajimagije ico kiyaya, ar’ amasinzi nk’inzige, n’ingamiya zabo zitoharūrika, ar’ amasinzi nk’umusenyi wo kw isēsero ry’ikiyaga.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.12",
            "verseOrgIds": [
              "JDG.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
