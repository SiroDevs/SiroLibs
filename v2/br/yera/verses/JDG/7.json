          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.20"
              },
              "items": [
                {
                  "text": "1 Sam 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.23"
              },
              "items": [
                {
                  "text": "2 Ngo 20:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bakomeza kuvuza za nzamba ukw ar’ amajana atatu, maz’ Uhoraho atuma Abamidiyani basubiranamwo, bazibagurana inkota mu ngabo zose; maz’ ingabo zisigaye zirahunga, zirinda zishika i Betishita ku nzira ija i Zerera, zishika no ku rubibe rw’i Abeli‐mehola ahahereranye n’i Tabati.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.22",
            "verseOrgIds": [
              "JDG.7.22"
            ]
          }
        }
      ]
