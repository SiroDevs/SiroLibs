            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerubayali, ari we Gideyoni, n’abantu bose bari kumwe na we, bazinduka kare, baragenda basagaza kw iriba ry’i Harodi, kand’ Abamidiyani bari bashagaje ahahera i burārūko bgabo, ahēgeranye n’umusozi More, mu kiyaya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.1",
            "verseOrgIds": [
              "JDG.7.1"
            ]
          }
        }
