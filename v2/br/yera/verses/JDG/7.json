              },
              "items": [
                {
                  "text": "1 Kor 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho abarira Gideyoni, at’ Abantu muri kumwe ni benshi kurenza urugero: kubg’ ivyo sinshobora kugabura Abamidiyani mu maboko yabo, kugira ngw Abisirayeli boye kunyishirako hejuru, bat’ Ubutōre bgacu ni bgo bgadukijije. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.2",
            "verseOrgIds": [
              "JDG.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.8"
              },
              "items": [
                {
                  "text": "Gus 20:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None genda ubitāngāze, abantu bavyumve, ut’ Umuntu wese afise akōba atinya, n’atahe, ave kur’ uyu musozi Gileyadi. Nuko hataha abantu ibihumbi mirongwibiri na bibiri, hasigara ibihumbi cumi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.7.3",
            "verseOrgIds": [
              "JDG.7.3"
            ]
          }
        }
      ]
    },
    {
