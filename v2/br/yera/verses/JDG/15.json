                "loc": "JDG.14.6"
              },
              "items": [
                {
                  "text": "Abac 14:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.19"
              },
              "items": [
                {
                  "text": "19",
