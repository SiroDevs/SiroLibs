                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.6"
              },
              "items": [
                {
                  "text": "1 Sam 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashitse i Lehi, Abafilisitiya bamusanganiza urwamo. Maze Mpwemu w’Uhoraho amuzako akābushūngwe, imigozi yar’ imuboshe amaboko ihinduka nk’ubugwēgwe bufashwe n’umuriro; ivyari bimuboshe ku bikonjo biravutagurika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.14",
            "verseOrgIds": [
              "JDG.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abona urwāsaya rw’indogoba rutarūma, atuma ukuboko araruraha, arwicisha abantu igihumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.15",
            "verseOrgIds": [
              "JDG.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samusoni aravuga,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.16",
            "verseOrgIds": [
              "JDG.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.17",
            "verseOrgIds": [
              "JDG.15.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.15.9"
              },
              "items": [
                {
                  "text": "Abac 15:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahejeje kuvuga artyo, ashibura rwa rwāsaya yar’ afise mu minwe; aho hantu haca hitwa Ramati‐lehi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.17",
            "verseOrgIds": [
              "JDG.15.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:17",
              "type": "text"
            },
            {
              "text": "Ramati‐lehi risobanurwa ng’ Umusozi w’urwāsaya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.17",
            "verseOrgIds": [
              "JDG.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwa umwūmwa, atakambira Uhoraho, ati Jewe umusavyi wawe ko wampaye uku kunesha gukomeye, none nicwe n’inyota, ngwe mu maboko y’ abatākebge? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.18",
            "verseOrgIds": [
              "JDG.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ikinogo car’ i Lehi Imana iragisatura, amazi aradudubiza; nukw amaze kunywa, udutege turagaruka, arahēmbūka. Ni co catumye bacita Eni‐hakore:",
          "type": "text",
          "attrs": {
            "verseId": "JDG.15.19",
            "verseOrgIds": [
              "JDG.15.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:19",
              "type": "text"
            },
            {
              "text": "Eni‐hakore risobanurwa ngw Iriba ry’ūtakamvye.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kiracar’ i Lehi na bugingo n’ubu. ",
