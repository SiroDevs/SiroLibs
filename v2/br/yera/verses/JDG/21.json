              "JDG.21.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.10"
              },
              "items": [
                {
                  "text": "Gus 20:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.20.47"
              },
              "items": [
                {
                  "text": "Abac 20:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ iryo koraniro ryose rituma impore ku Babenyamini bāri kuri ca gitandara c’i Rimona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.13",
            "verseOrgIds": [
              "JDG.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno Ababenyamini baca barahūngūka, babashingira ba bigeme bārokoye mu bagore b’i Yabeshi‐gileyadi, ariko ntibābakwira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.14",
            "verseOrgIds": [
              "JDG.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.21.6"
              },
              "items": [
                {
                  "text": "Abac 21:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu barīcuza kubg’ Ababenyamini, kuk’ Uhoraho yari yaciye igihengeri mu miryango y’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.15",
            "verseOrgIds": [
              "JDG.21.15"
            ]
          }
        }
      ]
    },
