          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko babarira Ababenyamini, bati Ni mugende muryame mu mizabibu, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.20",
            "verseOrgIds": [
              "JDG.21.20"
