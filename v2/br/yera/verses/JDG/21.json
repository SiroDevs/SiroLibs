            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze baravuga, bat’ Erega hariho wa musi mukuru w’Uhoraho bagira uk’ umwaka utashe i Shilo, hamwe i burārūko bg’ i Beteli, ku ruhande ruhera i burasirazuba rw’inzira iva i Beteli ija i Shekemu, i bumanuko bg’i Lebona. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.21.19",
            "verseOrgIds": [
              "JDG.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
