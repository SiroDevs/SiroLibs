                  "text": "Yos 13:2-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hār’ abaganwa batanu b’Abafilisitiya, n’Abanyakanani bose, n’Abasidoni, n’Abahiwi bo ku musozi Lebanoni, uhereye ku musozi Bayali‐Herumoni ugashitsa ahafata i Hamati. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.3",
            "verseOrgIds": [
              "JDG.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo Uhoraho yaretse, kugira ngw abageragereshe Abisirayeli, arābe ko bokwitondera ivyagezwe vyiwe, ivyo yageze ba sekuruza abitumye Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.4",
            "verseOrgIds": [
              "JDG.3.4"
            ]
          }
        },
