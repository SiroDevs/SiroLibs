            "number": "2",
            "style": "v",
            "sid": "JDG 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ico yagomba gusa kwar’ ukugira ngw abārutse hanyuma bo mu Bisirayeli bamenyerezwe ivy’ intambara, avyigishe abatigeze kubimenya ubga mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.2",
            "verseOrgIds": [
              "JDG.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
