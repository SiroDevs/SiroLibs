                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze gusohoka, abantu ba Eguloni baraza, basanga inzugi z’ico cumba zidadiye, bati Ngira ngw ari kwihagarika mu kazu ko mur’ ico cumba co gusama akayaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.24",
            "verseOrgIds": [
              "JDG.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bararorēra gushitsa bibazazaniye kukw atuguruye inzugi z’ico cumba; bararuha bazana urupfunguzo, barugurura: basanga umwami wabo arambaraye hasi yāpfuye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.25",
            "verseOrgIds": [
              "JDG.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
