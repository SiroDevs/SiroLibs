                "loc": "1CH.12.2"
              },
              "items": [
                {
                  "text": "1 Ngo 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abisirayeli batakambiye Uhoraho, abahagurukiriza uwo kubakiza yitwa Ehudi mwene Gera w’Umubenyamini; yar’ ibamfu. Bukeye Abisirayeli bamurungikana ishikanwa ryo gushikanira Eguloni umwami w’i Mowabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.15",
            "verseOrgIds": [
              "JDG.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ehudi yicurishiriza intambi; uburebure bgayo bgar’ itambge rimwe ry’ukuboko uciriye mu nkokora; ayambara kw itako ry’i buryo, ayirenzakw impuzu ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.16",
            "verseOrgIds": [
              "JDG.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw aragenda, ashikanira Eguloni umwami w’i Mowabu iryo shikanwa; kandi Eguloni yar’ umuntu yavyibushe yasenyutse. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.17",
            "verseOrgIds": [
              "JDG.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ehudi ahejeje kwākīrirwa iryo shikanwa, arungika abantu baje baryikoreye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.18",
            "verseOrgIds": [
              "JDG.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.26"
              },
              "items": [
                {
                  "text": "Abac 3:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko we, ashitse i Pesilimu hafi y’i Gilugali, arakimirana; arashika abgira umwami, ati Bgirukiro, mfise ijambo ry’ibanga nsaba kukubgira. Na we ati Banza uhagarare. Maz’ abāri kumwe na we bose barataramuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.19",
            "verseOrgIds": [
              "JDG.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ehudi aramwēgēra aho yar’ avyagiye ari wenyene, mu cumba co gusama akayaga co hejuru ku nzu; Ehudi aramubgira, ati Ngufitiye ijambo ntumwe n’Imana. Nuko Eguloni ahaguruka ku ntebe yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.20",
            "verseOrgIds": [
              "JDG.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ehudi atuma ukuboko kwiwe kw’i bumoso, anyakura intambi kw itako ry’i buryo, ayimuzibura ku nda; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.21",
            "verseOrgIds": [
              "JDG.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo ntambi ijana n’ikirindi na co, ibinure biyirenga hejuru, kukw atāyisokōye, iseruka mu mugongo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.22",
            "verseOrgIds": [
              "JDG.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ehudi arasohoka, ashitse ku rubaraza aramwugarana, yugaza inzugi z’ico cumba urupfunguzo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.23",
            "verseOrgIds": [
              "JDG.3.23"
            ]
          }
        }
