        {
          "text": "Aya ni yo mahanga Uhoraho yaretse, kugira ngw ayageragereshe Abisirayeli, cane‐cane abatigeze kubona intambara zabaye i Kanani; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.1",
