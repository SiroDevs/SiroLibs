                  "text": "Zab 83:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eguloni atabaza Abamoni n’ Abamaleki, aja gutera Abisirayeli arabanesha, begukira ca gisagara co mu bigazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.13",
            "verseOrgIds": [
              "JDG.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Abisirayeli baganzwa na Eguloni umwami w’i Mowabu imyaka cumi n’ umunani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.14",
            "verseOrgIds": [
              "JDG.3.14"
            ]
          }
        }
      ]
