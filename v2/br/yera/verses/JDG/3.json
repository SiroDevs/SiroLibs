                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.8"
              },
              "items": [
                {
                  "text": "2 Ngo 16:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira, ati Ni munkurikire, kuk’ Uhoraho agabuye abansi banyu b’Abanyamowabu mu maboko yanyu. Nuko bamanukana na we bamwōmyeko, bazibira ivyambu vya Yorodani bija i Mowabu, ntibākundira umuntu n’umwe kujabuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.28",
            "verseOrgIds": [
              "JDG.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe bica abagabo nk’ ibihumbi cumi b’Abanyamowabu, bose b’abahizi b’intōre; ntihārokoka n’uwa kirazira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.29",
            "verseOrgIds": [
              "JDG.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.11"
              },
              "items": [
                {
                  "text": "Abac 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo musi Abanyamowabu baneshwa n’Abisirayeli. Igihugu gihabga impore kumara imyaka mirongumunani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.3.30",
            "verseOrgIds": [
              "JDG.3.30"
            ]
          }
        }
