                "loc": "1SA.5.2+1SA.5.3+1SA.5.4+1SA.5.5+1SA.5.6+1SA.5.7"
              },
              "items": [
                {
                  "text": "1 Sam 5:2-7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.10.10"
              },
              "items": [
                {
                  "text": "1 Ngo 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abaganwa b’Abafilisitiya bakoranira gutanga ibimazi vyinshi babiha Dagoni imana yabo no kunezerwa, kuko bāvuga, bat’ Imana yacu yagabuye umwansi wacu Samusoni mu maboko yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.23",
            "verseOrgIds": [
              "JDG.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bamubonye batāzīra iyo mana yabo, bat’ Imana yacu yagabuye umwansi wacu mu maboko yacu, ari we yar’ umuranduzi w’igihugu cacu, yishe benshi muri twebge. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.24",
            "verseOrgIds": [
              "JDG.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bacuzuye umunezero, baravuga, bati Ni muhamagare Samusoni, tube turamwitwengera. Nuko baja guhamagara Samusoni, bamukūra mu nzu y’imbohe; ashitse imbere yabo baramwitwengera. Bamuhagarika hagati y’inkingi; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.25",
            "verseOrgIds": [
              "JDG.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze Samusoni abarira umuhungu yar’ amufashe ukuboko, ati Njana numve ah’ inkingi ziri ziteze iyi nzu, mbe ndazegamiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.26",
            "verseOrgIds": [
              "JDG.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo nzu yari yuzuye abagabo n’abagore, n’abaganwa bose b’Abafilisitiya ni ho bāri bari; kandi no hejuru ku nzu hār’ abagabo n’abagore nk’ibihumbi bitatu, bāriko bararorēra bamwitwengera. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.27",
            "verseOrgIds": [
              "JDG.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.15"
              },
              "items": [
                {
                  "text": "Yer 15:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samusoni atakambira Uhoraho, at’ Ewe Mwami Uhoraho, ndakwinginze nyibuka, umpe se inkomezi iri rimwe gusa, Mana, nsubirize Abafilisitiya mu nkōko aka kanya gusa, mpōre amaso yanje yompi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.28",
            "verseOrgIds": [
              "JDG.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Samusoni afata izo nkingi zompi zo hagati ziteze inzu, arazegamira, ukuboko kw’i buryo gufata imwe, ukw’ i bumoso iyindi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.29",
            "verseOrgIds": [
              "JDG.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ aravuga, ati Reka mpfane n’Abafilisitiya. Araheza arīkōngānya n’inkomezi ziwe zose, arazishika, inzu ihomvokera kuri ba baganwa no ku bantu bose bari muri yo. Nukw abo yishe mu gupfa kwiwe bāruta abo yishe akiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.30",
            "verseOrgIds": [
              "JDG.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
