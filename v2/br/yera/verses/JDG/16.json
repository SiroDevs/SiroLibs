            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.25"
              },
              "items": [
                {
                  "text": "Abac 13:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.15.20"
              },
              "items": [
                {
                  "text": "15:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ab’i wabo n’abo kwa se bose baramanuka, bajana ikiziga ciwe, barakidūgana, bamuhamba hagati y’i Sora n’i Eshitayoli, ahantu aho se Manowa yahambge. Kandi Samusoni yar’ amaze imyaka mirongwibiri acira imanza Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.16.31",
            "verseOrgIds": [
              "JDG.16.31"
            ]
          }
        }
