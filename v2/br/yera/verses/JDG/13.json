            }
          ]
        },
        {
          "text": "umuriro wo ku gicaniro ukiriko urarabagiza uja hejuru, wa mumarayika w’Uhoraho adūga mur’ uwo muriro wo ku gicaniro, Manowa n’umugore wiwe babirorēra; baca barapfukama, barūnama. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.20",
            "verseOrgIds": [
