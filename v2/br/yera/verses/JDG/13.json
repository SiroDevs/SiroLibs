            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuva ubgo, uwo mumarayika w’Uhoraho ntiyongeye kwiyereka Manowa cank’ umugore wiwe ukundi. Nuko Manowa amenya kw ar’ umumarayika w’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
            "verseOrgIds": [
              "JDG.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
