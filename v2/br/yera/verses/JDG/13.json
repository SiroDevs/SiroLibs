              "items": [
                {
                  "text": "Ivyah 19:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mumarayika w’Uhoraho aramwishura, at’ Umbariza iki izina ryanje, kw ar’ izina ritangaje? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.19+JDG.6.20+JDG.6.21"
              },
              "items": [
                {
                  "text": "Abac 6:19-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Manowa yābīra iyo suguru y’impene n’ishikanwa ry’ifu, abishikanirira Uhoraho hejuru ku gitandara; haca haba igitangaza, Manowa n’umugore wiwe babirorēra: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
