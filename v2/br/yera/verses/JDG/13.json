        {
          "text": "Kandi hār’ umuntu w’i Sora wo mu muryango w’Abadani, yitwa Manowa. Umugore wiwe yar’ ingumba itigeze kuvyara. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.2",
            "verseOrgIds": [
              "JDG.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.6.12"
              },
              "items": [
                {
                  "text": "Abac 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.11"
              },
              "items": [
                {
                  "text": "Luk 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika w’Uhoraho yiyereka uwo mugore, aramubarira, ati Rāba ur’ ingumba, ntiwigeze kuvyara; arik’ uzosama inda, uvyare umwana w’umuhungu. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.2+NUM.6.3+NUM.6.4+NUM.6.5"
              },
              "items": [
                {
                  "text": "Guh 6:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.14"
              },
              "items": [
                {
                  "text": "Abac 13:14",
