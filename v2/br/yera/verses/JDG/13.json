                {
                  "text": "Luk 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, uz’ uzire akaziri ntunywe vino cank’ ikiboreza na kimwe, kandi ntuz’ urye ikintu na kimwe gihumanya; ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.4",
            "verseOrgIds": [
              "JDG.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw ehe rāba, ugiye gusama inda, uvyare umwana w’umuhungu; kandi ntihaze hagire urupfuhe rumugera ku mutwe; kuk’ uwo mwana azoba Umunaziri",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "13:5",
              "type": "text"
            },
            {
              "text": "Umunaziri",
              "type": "text"
            },
            {
              "text": ": Rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.2"
              },
              "items": [
                {
                  "text": "Guh 6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ku Mana uhereye akiva mu nda; kandi ni we azotangura kurokora Abisirayeli, abakūre mu maboko y’Abafilisitiya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        }
