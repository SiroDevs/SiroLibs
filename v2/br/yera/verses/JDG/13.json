                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Manowa abarira umugore wiwe, ati Nta kabuza turapfuye, kuko tubonye Imana! ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
            "verseOrgIds": [
              "JDG.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umugore wiwe aramwishura, at’ Iyaba Uhoraho yagomba kutwica, ntaba yātwākīriye ikimazi cacu coshejwe bo n’ishikanwa ryacu ry’ifu, kandi ntaba yātweretse ivyo vyose, canke ngw atubarire amajambo ameze nk’ayo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.23",
            "verseOrgIds": [
              "JDG.13.23"
            ]
          }
        }
