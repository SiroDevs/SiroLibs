              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mutāma aramwishura, ati Ruhuka, gira amahoro: ivy’ ugomba vyose ndabikugirira; mugabo ntimushobora kurāra ku musozi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.20",
            "verseOrgIds": [
              "JDG.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abajana i we, agaburira izo ndogoba; nuko bamaze kwoga ibirenge, bararya baranywa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.21",
            "verseOrgIds": [
              "JDG.19.21"
            ]
          }
        }
