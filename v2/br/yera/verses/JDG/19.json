            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.7"
              },
              "items": [
                {
                  "text": "1 Sam 11:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashitse i we, ahitana imbugita, afata umuvyimba w’uyo mugore wiwe, awuhimbaguramw’ ibihimba cumi na bibiri, acīra mu ngingo mu ngingo, abirungika mu bihugu vyose vy’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.29",
            "verseOrgIds": [
              "JDG.19.29"
            ]
          }
        },
