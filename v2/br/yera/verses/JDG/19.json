            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.4",
            "verseOrgIds": [
              "JDG.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.5",
            "verseOrgIds": [
              "JDG.19.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.5"
              },
              "items": [
                {
                  "text": "Ita 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira kane bavyutse kare, arīkora ngw agende. Se wa nya mugore abarira uwo mukwe wiwe, ati Banza wābīre utw’ utamira, uhēmbūre umutima, mubone kugenda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.5",
            "verseOrgIds": [
              "JDG.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.3.7"
              },
              "items": [
                {
                  "text": "Rus 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bompi baca baricara, bararya, baranywa, kugeza se wa nya mugore amubariye, at’ Enda se subira urāre hano, ube urījandajandira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.6",
            "verseOrgIds": [
              "JDG.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwo mugabo arahaguruka ngw agende; sebukwe aramwinginga, arongera ararāra. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.7",
            "verseOrgIds": [
              "JDG.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira gatanu azinduka kare ngw agende. Se wa nya mugore aravuga, at’ Enda banza wihēmbūre! Ba muraguma hano gushitsa umusi ukuze. Nuko bompi bararya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.8",
            "verseOrgIds": [
              "JDG.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugabo araheza ava hasi ngw agende, bo n’umugore wiwe n’umuntu wiwe; maze sebukwe, se w’uwo mugore, aramubarira, at’ Ehe burije, ndabinginze murāre hano iri joro; rāba bgāhinnye: kīnja hano wījandajandire! Ejo uz’ uhenge mu gatwenzi, wifatire inzira, utahe.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.9",
            "verseOrgIds": [
              "JDG.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.9",
            "verseOrgIds": [
              "JDG.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
