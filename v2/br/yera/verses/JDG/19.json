                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubarira, ati Vyuka, tugende; ariko ntiyakakaza. Nukw aramuterura, amurambika ku ndogoba; uwo mugabo ni kwo guca yitahira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.28",
            "verseOrgIds": [
              "JDG.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
