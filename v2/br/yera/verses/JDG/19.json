                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.1"
              },
              "items": [
                {
                  "text": "18:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.21.25"
              },
              "items": [
                {
                  "text": "21:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ico gihe, Abisirayeli bataragira umwami, hār’ Umulewi yari yaracīkiye mu mugamba w’Abefurayimu wo hirya, yari yābiriye umugore ava i Betelehemu h’i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.1",
            "verseOrgIds": [
              "JDG.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye umugore wiwe amucumurako, arasambana, arāhukana, aja kwa se i Betelehemu h’i Buyuda; amaray’ igihe nk’amezi ane. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.2",
            "verseOrgIds": [
              "JDG.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye umugabo wiwe arīkora, aramukurikira, kugira ngw amuhōyahōye, amugarukane; ajana n’ umuntu wiwe n’indogoba zibiri; ashitse i wabo w’uwo mugore, se wa nya mugore amubonye, aza kumusanganira anezerewe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.3",
            "verseOrgIds": [
              "JDG.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze sebukwe, se wa nya mugore, aramusīvya, amarana na we imisi itatu, barya, banywa, ari ho barāra.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.4",
            "verseOrgIds": [
              "JDG.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
