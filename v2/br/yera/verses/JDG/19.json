              "JDG.19.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.8"
              },
              "items": [
                {
                  "text": "Yos 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.63"
              },
              "items": [
                {
                  "text": "63",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwo mugabo ntiyemera kurāra; arīkora, aragenda, ashika aharābana n’i Yebusi, ari ho Yerusalemu; kandi yar’ afise indogoba zibiri zirikw amatandiko, n’umugore wiwe bari kumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.10",
            "verseOrgIds": [
              "JDG.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bāshitse hafi y’i Yebusi buriko buragoroba. Wa muntu abgira shebuja, at’ Enda ngo dukevye, twāke indāro muri kirya gisagara c’Abayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.11",
            "verseOrgIds": [
              "JDG.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.28"
              },
              "items": [
                {
                  "text": "Yos 18:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko shebuja aramubarira, ati Ntitwokevya ngo tuje mu gisagara c’abanyamahanga kitar’ ic’ Abisirayeli; ariko ngo tujabuke dufate i Gibeya. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.12",
            "verseOrgIds": [
              "JDG.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.25"
              },
              "items": [
                {
                  "text": "Yos 18:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.17"
              },
              "items": [
                {
                  "text": "1 Sam 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera abarira uwo muntu wiwe, at’ Enda tuje mu gisagara kimwe muri biriya, twāke indāro i Gibeya cank’ i Rama. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.13",
            "verseOrgIds": [
              "JDG.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bararamiriza, izuba ricokera bashitse hafi y’i Gibeya h’Ababenyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.14",
            "verseOrgIds": [
              "JDG.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.2"
              },
              "items": [
                {
                  "text": "Ita 19:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakeberezayo, baja kwāka indāro i Gibeya. Ashitseyo, apfa kwicara mu kibuga co mur’ ico gisagara, kukw ata wemeye kubaha indāro.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.15",
            "verseOrgIds": [
              "JDG.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze haza umutāma avuye mu murima gukora buhwibiriye; kand’ uwo muntu yahora mu mugamba w’Abefurayimu, acīkira i Gibeya, arikw abo mur’ ico gisagara bār’ Ababenyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.16",
            "verseOrgIds": [
              "JDG.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yunamuye amaso, abona umuntu w’ingenzi ari ngaho mu kibuga co mur’ ico gisagara. Uwo mutāma aramubaza, at’ Uva hehe, ukaja he? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.17",
            "verseOrgIds": [
              "JDG.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.31"
              },
              "items": [
                {
                  "text": "Abac 18:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwishura, ati Tuvuye i Betelehemu h’i Buyuda, tuja mu mugamba w’Abefurayimu wo hirya, iyo naturutse; nari nagiye i Betelehemu h’i Buyuda, none ndatashe; kandi mbuze umuntu yompa indāro, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.18",
            "verseOrgIds": [
              "JDG.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "naho nari nīfitiye ivyarire vy’indogoba zacu n’ivyo kurya vyazo, bo n’ivyo kurya vya twe n’uyu mugore n’uyu muhungu turi kumwe: nta co tubuze na mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.19",
            "verseOrgIds": [
              "JDG.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
