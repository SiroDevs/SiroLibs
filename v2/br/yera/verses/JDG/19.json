        },
        {
          "text": "Bakiriko barījandajandira, haza abanyagisagara b’abanyangeso mbi, bakikiza iyo nzu impande zose, bakubitagura ku rugi, babarira uwo mutāma nyen’ urugo, bati Sohora uwo mugabo yinjiye i wawe, tumwonone. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.19.22",
            "verseOrgIds": [
              "JDG.19.22"
            ]
          }
        },
