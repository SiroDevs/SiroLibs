              "type": "text"
            }
          ]
        },
        {
          "text": "Hariho n’ibindi bimenyetso vyinshi Yesu yakoreye imbere y’abigishwa, bitanditswe mur’ iki gitabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.30",
