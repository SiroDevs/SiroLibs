                  "text": "18:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abo muzoharira ivyaha bose, bazoba babihariwe; arikw abo mutazobiharira bose, ntibazoba babihariwe.",
          "type": "text",
          "attrs": {
