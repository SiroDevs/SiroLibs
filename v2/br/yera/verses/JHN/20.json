                  "text": "Yoh 19:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bigishwa baramubgira, bati Twabonye Umwami. Na we arabishura, ati Ni ntabona inkovu z’imambo mu biganza vyiwe, ngo nkoze urutoke rwanje mu nkovu z’imambo, ngo nshire urushi mu rubavu rwiwe, sinemera.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.25",
            "verseOrgIds": [
              "JHN.20.25"
            ]
          }
        }
