            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Toma ari we Hasa, umwe wo muri bamwe cumi na babiri, ntiyari kumwe na bo aho Yesu yaza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.24",
