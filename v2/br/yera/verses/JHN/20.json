            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuze ivyo, abahumekerako, ati Ni mwākīre Mpwemu Yera. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.22",
            "verseOrgIds": [
