              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku wa mbere w’imisi ndwi mu gahuru, hatarabona, Mariya Magadalene aja ku mva, abona ikibuye gikūwe ku mva; ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.1",
            "verseOrgIds": [
              "JHN.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.13.23"
              },
              "items": [
                {
                  "text": "Yoh 13:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "agenda ariruka ashikīra Simoni Petero na wa mwigishwa wundi Yesu yakunda, arababgira, ati Bākūye Umwami Yesu mu mva, kandi ntituzi aho bāmushize. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.2",
            "verseOrgIds": [
              "JHN.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Petero arasohoka, na wa mwigishwa wundi, baja ku mva. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.3",
            "verseOrgIds": [
              "JHN.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bompi birukira icarimwe, kandi wa mwigishwa wundi asiga Petero, amutanga ku mva. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.4",
            "verseOrgIds": [
              "JHN.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yunamye, arungurutseyo, abona za mpuzu zera derere zirambitseho, ariko ntiyinjira. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.5",
            "verseOrgIds": [
              "JHN.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Simoni Petero arashika amukurikiye, yinjira mu mva, abona za mpuzu zirambitseho, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.6",
            "verseOrgIds": [
              "JHN.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.44"
              },
              "items": [
                {
                  "text": "Yoh 11:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’igitambara cari mu mutwe wiwe, kitarambitse hamwe na za mpuzu, ariko kizinze kir’ ahaco ukwa conyene. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.7",
            "verseOrgIds": [
              "JHN.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ho hinjiye wa mwigishwa wundi na we, umwe yabanje gushika ku mva, abibonye arizera. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.8",
            "verseOrgIds": [
              "JHN.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.4"
              },
              "items": [
                {
                  "text": "1 Kor 15:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.2.24+ACT.2.25+ACT.2.26+ACT.2.27+ACT.2.28+ACT.2.29+ACT.2.30+ACT.2.31+ACT.2.32"
              },
              "items": [
                {
                  "text": "Ivyak 2:24-32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko bataribgamenye ivyanditswe yukw akwiye kuzozuka mu bapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.9",
            "verseOrgIds": [
              "JHN.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abo bigishwa bavayo basubira i wabo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.10",
            "verseOrgIds": [
              "JHN.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariya yar’ ahagaze ku mva arira. Akirikw ararira, arunama, arunguruka mu mva, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.11",
            "verseOrgIds": [
              "JHN.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "abona abamarayika babiri bambaye impuzu zera, bicaye umwe ku mutwe, uwundi mu mirambizo y’ah’ ikiziga ca Yesu cari kiryamye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.12",
            "verseOrgIds": [
              "JHN.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramubaza, bati Mbega nyina wanje, urizwa n’iki? Na we ati N’uko bakūyeh’ Umwami wanje, nanje nkaba ntazi aho bamushize. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.13",
            "verseOrgIds": [
              "JHN.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuze ivyo, arakebuka, abona Yesu ahagaze, ariko ntiyamenya kw ari Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.14",
            "verseOrgIds": [
              "JHN.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubaza, ati Mbega nyina wanje, urizwa n’iki? Urondera nde? Na we yiyumvira kw ar’ umurimyi waho, aramubgira, ati Mugenzi, namb’ ari wewe wamukūye hano, ndangira aho wamushize, ndamukūreyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.15",
            "verseOrgIds": [
              "JHN.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramuhamagara, ati Mariya. Na we arahindukira, amwitaba mu Giheburayo, ati Rabuni (risobanurwa ngo Mwigisha). ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.16",
            "verseOrgIds": [
              "JHN.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.11"
              },
              "items": [
                {
                  "text": "Heb 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.2.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.29"
              },
              "items": [
                {
                  "text": "Rom 8:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubgira, ati Ntunkoreko, kuko ntaradūga kwa Data; ariko genda kwa bene Data, ubabarire, ut’ Agira adūge kwa Se ari we So, uti Ku Mana yiwe ari yo Mana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.17",
            "verseOrgIds": [
              "JHN.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mariya Magadalene aragenda, abarira abigishwa inkuru, ati Nabonye Umwami; abadondera ivyo yamubariye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.20.18",
            "verseOrgIds": [
              "JHN.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
