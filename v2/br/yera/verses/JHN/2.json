          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abayuda bat’ Uru rusengero rwubatswe imyaka mirongwine n’itandatu: none wewe uzoruhagarika mu misi itatu? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.20",
            "verseOrgIds": [
