              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw amaze kuzurwa mu bāpfuye, abigishwa biwe bibuka yuko yari yaravuze ivyo, bemera icanditswe, na rya jambo Yesu yavuze.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.22",
