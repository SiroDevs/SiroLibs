            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko we yavuga urusengero rw’umubiri wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.21",
            "verseOrgIds": [
              "JHN.2.21"
            ]
          }
        },
        {
