                "loc": "PSA.69.9"
              },
              "items": [
                {
                  "text": "Zab 69:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa biwe bibuka ko handitswe, ngw Ishaka ry’inzu yawe rizondya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.17",
            "verseOrgIds": [
              "JHN.2.17"
            ]
          }
        }
