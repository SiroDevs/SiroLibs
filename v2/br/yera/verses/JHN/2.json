              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabishura, ati Musambure uru rusengero, nanje nzoruhagarika mu misi itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.19",
            "verseOrgIds": [
