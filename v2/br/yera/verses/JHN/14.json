              "items": [
                {
                  "text": "Mrk 11:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuhagarike imitima yanyu, mwizere Imana, nanje munyizere. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "I muhira kwa Data har’ amazu menshi, iy’ aba atariho, mba ndabibabgiye, kuko ngiye kubategurira ahanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.2",
            "verseOrgIds": [
              "JHN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.26"
              },
              "items": [
                {
                  "text": "Yoh 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.24"
              },
              "items": [
                {
                  "text": "17:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ko ngiye kubategurira ahanyu, nzogaruka kubajana i wanje, ngw aho ndi namwe abe ari ho muba. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.3",
            "verseOrgIds": [
              "JHN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo nja murazi inzira ijayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.4",
            "verseOrgIds": [
              "JHN.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Toma aramubgira, ati Mugenzi, ntituzi iy’ uja, dushobora dute kumenya inzira? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.5",
            "verseOrgIds": [
              "JHN.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.20"
              },
              "items": [
                {
                  "text": "Heb 10:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.27"
              },
              "items": [
                {
                  "text": "Mat 11:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.25"
              },
              "items": [
                {
                  "text": "Yoh 11:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.1"
              },
              "items": [
                {
                  "text": "Rom 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubgira, ati Ni jewe nzira n’ukuri n’ubugingo: nta wushika kuri Data ntamujanye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo muba mwarammenye, na Data muba mumuzi. Uhereye ubu muramuzi, kandi mwamubonye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.7",
            "verseOrgIds": [
              "JHN.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
