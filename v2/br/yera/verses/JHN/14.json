            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko none ndabibabgiye bitaraba, ngw aho bizobera muze mwizere. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.29",
            "verseOrgIds": [
              "JHN.14.29"
            ]
          }
        },
