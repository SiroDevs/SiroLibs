                  "text": "Yoh 17:21-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi muzomenya ko ndi muri Data, namwe muri muri jewe, nanje ndi muri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.20",
            "verseOrgIds": [
              "JHN.14.20"
            ]
          }
