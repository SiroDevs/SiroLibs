                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasigaye igihe gito, ab’ isi ntibabe bakimbona, ariko mweho muzombona; kuko ndiho, namwe muzobaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.19",
            "verseOrgIds": [
