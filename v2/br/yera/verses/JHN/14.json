          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.23"
              },
              "items": [
                {
                  "text": "Yoh 16:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.16.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwagira ico musaba mw izina ryanje, nzogikora.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.14",
            "verseOrgIds": [
              "JHN.14.14"
            ]
          }
        }
