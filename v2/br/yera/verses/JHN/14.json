            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanje nzosaba Data, na we azobaha uwundi Mwitsa, ngw az’ abane namwe ibihe bidashira, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.16",
            "verseOrgIds": [
              "JHN.14.16"
            ]
