        },
        {
          "text": "Yesu aramwishura, ati Ni hagira ūnkunda, azokwitondera ijambo ryanje, kandi Data azomukunda, maze tuzoza kuri we, tubane na we. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
