            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahoro ndayabasigaranye, amahoro yanje ndayabagabiye. Jeho simbagabira nk’ukw ab’ isi bagaba. Imitima yanyu ntihagarare, kandi ntitinye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.27",
            "verseOrgIds": [
