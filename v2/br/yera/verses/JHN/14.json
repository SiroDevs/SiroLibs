                  "text": "Ivyak 10:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda (atari Isikaryota), aramubaza, ati Mugenzi, bibaye bite, k’ugira wihishurire twebge, ntiwihishurire ab’ isi? ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.22",
            "verseOrgIds": [
