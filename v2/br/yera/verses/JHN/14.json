            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūri n’ivyagezwe vyanje akavyitondera, uwo ni we ankunda, kand’ ūnkunda azokundwa na Data, nanje nzomukunda, kandi nzomwihishurira. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.21",
            "verseOrgIds": [
