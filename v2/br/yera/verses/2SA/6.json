                {
                  "text": "2 Ngo 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi ahagurukana n’abo bantu bose bari kumwe na we, baja i Bayali‐yuda gukūray’ isandugu y’Imana yitirirwa rya Zina, ari ryo zina ry’Uhoraho Nyen’ ingabo yama avyagiye ku bakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.7"
              },
              "items": [
                {
                  "text": "1 Sam 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1"
              },
              "items": [
                {
                  "text": "7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bashira iyo sandugu y’Imana ku mukogote musha, bayikūra kwa Abinadabu yaba kur’ uwo musozi; Uza na Ahiyo bene Abinadabu bayobora inka zikwega uyo mukogote musha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko bākūye iyo sandugu y’ Imana kwa Abinadabu kur’ uwo musozi, Ahiyo ari we ayigiye imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.68.25"
              },
              "items": [
                {
                  "text": "Zab 68:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.150.3+PSA.150.4+PSA.150.5"
              },
              "items": [
                {
                  "text": "150:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi n’umuryango wose w’Abisirayeli bagenda biyereka biginagura, bar’ imbere y’Uhoraho, bavuza inanga n’amakembe n’ udushako tw’ingoma n’imiduri n’ivyitwa matowazi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        }
      ]
    },
