            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uko vyagenze n’uku: abareruye isandugu y’Uhoraho batambutse intambuko zitandatu, atanga impfizi kw ikimazi, bo n’ ishuri y’igishishe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.15.20"
              },
              "items": [
                {
                  "text": "Kuv 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.18"
              },
              "items": [
                {
                  "text": "1 Sam 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi yiyerekera imbere y’Uhoraho yiginagura; kandi yar’ akenyeye efodi yera derere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
