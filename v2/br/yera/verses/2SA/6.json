            }
          ]
        },
        {
          "text": "Bukeye Dawidi yongera gukoranya ingabo zose zatoranijwe mu Bisirayeli; bār’ ibihumbi mirongwitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
