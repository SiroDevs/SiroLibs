            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi amaze kwosa ikimazi no gutanga ibimazi vy’ishimwe, ahezagira abantu mw izina ry’Uhoraho Nyen’ ingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
