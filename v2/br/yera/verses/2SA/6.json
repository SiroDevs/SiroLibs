              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko binjiza iyo sandugu y’Uhoraho, bayishira aho yagerewe hagati mw ihema Dawidi yari yarayishingiye. Dawidi araheza atangira imbere y’Uhoraho ibimazi vyoswa n’ivy’ ishimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
