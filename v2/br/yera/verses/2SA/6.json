            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi n’umuryango wose w’Abisirayeli badūgana isandugu y’Uhoraho basēsereza impundu, bavuza inzamba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
