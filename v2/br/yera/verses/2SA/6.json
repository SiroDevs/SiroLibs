              "items": [
                {
                  "text": "1 Abam 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye babarira umwami Dawidi, bat’ Uhoraho yahaye umugisha urugo rwa Obed‐edomu n’ivy’ afise vyose, kubga ya sandugu yiwe. Nuko Dawidi arahaguruka aja gukūra iyo sandugu y’ Imana kwa Obed‐edomu, ayitahana ku murwa wiwe anezerewe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
