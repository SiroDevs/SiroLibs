          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ isandugu y’Uhoraho igitamaje ku murwa wa Dawidi, Mikali umukobga wa Sauli arungurukira mw idirisha, abona umwami Dawidi yitera hejuru, yiyerekera imbere y’Uhoraho; amugayira mu mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
