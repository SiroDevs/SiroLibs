              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.20"
              },
              "items": [
                {
                  "text": "Ita 14:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ahimasi ashira ijwi hejuru, abarira umwami, ati Vyose vyagenze neza. Araheza akubita inkoro hasi imbere y’umwami, aramubarira, at’ Uhoraho Imana yawe ahimbazwe, yaguhaye abantu bari bakubanguriye amaboko, mwami wanje nyen’ ingoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramubaza, ati Wa muhungu Abusalomu ar’ amahoro? Ahimasi aramwishura, at’ Aho Yowabu yantuma, jewe umusavyi wawe, nabonye agahōgo kenshi, ariko sinamenye ivy’ ari vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramubarira, ati Rēngāna uhagarare hano. Nukw ararēngāna, arahagarara. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.18.19"
              },
              "items": [
                {
                  "text": "2 Sam 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa Munyekushi aca ashika ubgo nyene, aravuga, ati Nkuzaniye inkuru, mwami wanje nyen’ ingoma. Uyu musi Uhoraho yashubirije mu nkōko abāri baguhagurukiye bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.25.26"
              },
              "items": [
                {
                  "text": "1 Sam 25:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami abaza uwo Munyekushi, ati Wa muhungu Abusalomu ar’ amahoro? Uwo Munyekushi aramwishura, at’ Abansi bawe n’ aboguhagurukira kukugirira nabi bose, barakaba nk’uk’ uwo muhungu yabaye, mwami wanje nyen’ ingoma! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami avyumvise, inkonko irakoroka, yūrira mu cumba cubatswe hejuru kw irembo, arira; akirikw aragenda aravuga, ati Yō! Mwananje Abusalomu! Es’ umwananje! Ewe mwananje Abusalomu! Iyo mpfuma ari jewe mpfa mu gishingo cawe, ewe Abusalomu mwana wanje, mwana wanje we!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.18.33"
            ]
          }
        }
      ]
    }
