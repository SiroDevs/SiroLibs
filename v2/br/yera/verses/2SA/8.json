                "loc": "2SA.12.30"
              },
              "items": [
                {
                  "text": "12:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "i Siriya n’i Mowabu no mu Bamoni no mu Bafilisitiya no mu Bamaleki, bo na ya masahu yari yarasahuye umwami w’i Zoba, Hadadezeri mwene Rehobu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.12",
            "verseOrgIds": [
              "2SA.8.12"
            ]
          }
        }
