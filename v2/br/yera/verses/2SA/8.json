          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi yironkera izina rya rurangiranwa. Maz’ atabarutse avuye kunesha Abasiriya, atsinda Abanyedomu ibihumbi cumi n’umunani mu Kiyaya c’ Umunyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.13",
            "verseOrgIds": [
              "2SA.8.13"
            ]
          }
        },
