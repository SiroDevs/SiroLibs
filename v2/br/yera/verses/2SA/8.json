          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.7.51"
              },
              "items": [
                {
                  "text": "1 Abam 7:51",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.26.26"
              },
              "items": [
                {
                  "text": "1 Ngo 26:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na vyo nyene umwami Dawidi abirobanurira Uhoraho, hamwe n’amafeza n’ amazahabu yari yaramurobanuriye, ayasahuye mu mahanga yari yaranesheje, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.11",
            "verseOrgIds": [
              "2SA.8.11"
            ]
          }
        },
        {
