            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Toyu umwami w’i Hamati yumvise ko Dawidi yanesheje ingabo zose za Hadadezeri, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.9",
            "verseOrgIds": [
              "2SA.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "atuma umuhungu wiwe Yoramu ku mwami Dawidi kumuramutsa no kumushima, ko yarwanye na Hadadezeri akamunesha; kuko Hadadezeri yahora arwanya Toyu. Kandi Yoramu yar’ azanye ibintu vy’amafeza n’ivy’ amazahabu n’ ivy’ imiringa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.8.10",
            "verseOrgIds": [
              "2SA.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
