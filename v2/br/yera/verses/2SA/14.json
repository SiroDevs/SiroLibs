                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.8"
              },
              "items": [
                {
                  "text": "8:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.4.14"
              },
              "items": [
                {
                  "text": "Yak 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erega twese tuzopfa, tumeze nk’amazi asēseka ntayorwe. Mbere n’Imana ntiyiciraho, arikw irondera uburyo kugira ng’ uwaciwe ntaz’ arinde apfa akir’ igicibga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.14",
            "verseOrgIds": [
              "2SA.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mwami wanje nyen’ ingoma, igitumye nza kukubgira iryo jambo n’ukw abantu banteye ubgoba; incoreke yawe nkavuga nti Hinge nje kwivuganira n’umwami; nti Kumbure umwami yokwemera gukora ico incoreke yiwe imusavye; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.15",
            "verseOrgIds": [
              "2SA.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nt’ Umwami aranyumvira, ankize jewe incoreke yiwe, ankūre mu maboko ya wa muntu agomba kundandurana n’umwana wanje, adukūre mw ishamvu y’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.16",
            "verseOrgIds": [
              "2SA.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.27"
              },
              "items": [
                {
                  "text": "2 Sam 19:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi jewe incoreke yawe ngatako nkiyumvira, nt’ Ijambo ry’umwami wanje nyen’ ingoma rizondemesha; nti Kuk’ umwami ameze nk’umumarayika w’Imana ku vyo gutandukanya ibibi n’ ivyiza. Nuk’ Uhoraho Imana yawe az’ ahorane nawe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.17",
            "verseOrgIds": [
              "2SA.14.17"
            ]
          }
        }
      ]
    },
