          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Yowabu umwana wa Seruwiya amenya k’ umwami afitiye inkumbu Abusalomu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.1",
            "verseOrgIds": [
              "2SA.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yowabu atuma i Tekowa guhamagaza umugore w’ umunyabgenge; aramubarira, ati Ntabara wīgire nk’ūgandaye, wambare nk’ūri ku kigandaro, ntiwīsīge amavuta, arik’ use n’umugore amaze imisi myinshi agandariye uwapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.2",
            "verseOrgIds": [
              "2SA.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.14.19"
              },
              "items": [
                {
                  "text": "2 Sam 14:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze uje i bgami, ubarire umwami urtya n’urtya. Nuko Yowabu amutegekera ivyo aja kuvuga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.14.3",
            "verseOrgIds": [
              "2SA.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 14:4"
          },
          "items": [
