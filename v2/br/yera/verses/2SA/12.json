                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.27"
              },
              "items": [
                {
                  "text": "1 Abam 21:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye Dawidi yinginga Imana kubg’ uwo mwana, akisonzesha, akinjira mu nzu agakesha ijoro arambaraye hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bakuru bo mu rugo rwiwe babibonye bamuhagarara i ruhande, ngo bamuvyure ave hasi, aranka, yanka no kuja aho bari ngw afūngure. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.17",
            "verseOrgIds": [
              "2SA.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ku musi ugira indwi uwo mwana arapfa; abantu ba Dawidi batinya kumubgira k’umwana acīkānye; bati Mbega ko twamuhanūye umwana akiriho, akanka kutwumvira, none biracura iki, ni twamubgira k’umwana acīkānye? Ubgo ntaca yiyahura? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.18",
            "verseOrgIds": [
              "2SA.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi abonye kw abantu biwe bongorerana, amenyera aho k’ umwana apfuye; abaza abo bantu biwe, ati Mbeg’ umwana aracīkānye? Bat’ Aracīkānye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.18"
              },
              "items": [
                {
                  "text": "2 Sam 7:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.20"
              },
              "items": [
                {
                  "text": "Yob 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi aca arahaguruka, ava aho yar’ arambaraye hasi, ariyuhagira arirtyorora, yambara iyindi myambaro, araheza aja mu ngoro y’ Uhoraho, arasenga; hanyuma ataha i we; maze yatse ivyo kurya barabimuzanira, arafūngura. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu biwe baramubaza, bati Mbeg’ ukoze ibiki? Umwana akiriho ko wisonzesheje ukamuririra, ariko non’ amaze guhwera, uca urahaguruka, urafūngura! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JON.3.9"
              },
              "items": [
                {
                  "text": "Yon 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Nka ko, umwana akiriho narisonzesheje ndarira, nti Sinzi, kumbure Uhoraho yongirira imbabazi, umwana agakira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
