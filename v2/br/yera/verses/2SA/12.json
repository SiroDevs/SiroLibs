                "loc": "GEN.37.35"
              },
              "items": [
                {
                  "text": "Ita 37:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.19"
              },
              "items": [
                {
                  "text": "1 Sam 28:19",
