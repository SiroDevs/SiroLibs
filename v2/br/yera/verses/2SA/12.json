              "type": "text"
            }
          ]
        },
        {
          "text": "N’iki catumye ukēngēra ijambo ryanje jewe Uhoraho, ugakora ivyo mbona kw ari bibi, ukicisha inkota Uriya Umuheti, ugacūra umugore wiwe ukamugira rwawe, na we Uriya ukamwicisha inkota y’Abamoni? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
