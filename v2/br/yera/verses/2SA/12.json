                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.6"
              },
              "items": [
                {
                  "text": "Mat 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi yirura umugore wiwe Batisheba, yinjira iy’ ari, aramurārira; hanyuma avyara umwana w’umuhungu, amwita Salomo. Uhoraho aramukunda, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "atuma ūvugishwa na we Natani kumwita Yedidiya;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:25",
              "type": "text"
            },
            {
              "text": "Yedidiya risobanurwa ng’ Ūkunzwe n’Uhoraho.",
              "type": "text"
            }
          ]
        },
        {
          "text": " agenza artyo nk’uk’ Uhoraho yamubariye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
