            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko kuko wahaye abansi b’Uhoraho urwitwazo rukomeye rwo kumurogotako kubg’ ico wakoze, wa mwana wavyara ntakabuza azopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
            "verseOrgIds": [
              "2SA.12.14"
            ]
          }
        },
