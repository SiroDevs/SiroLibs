            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Uhoraho atēza indwara wa mwana muka Uriya yavyarana na Dawidi, agera kure. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
