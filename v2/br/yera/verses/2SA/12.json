              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, inkota nta ho izova mu rugo rwawe, kuko wankēngereye, ugacūra muka Uriya Umuheti, ukamugira umugore wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.16.22"
              },
              "items": [
                {
                  "text": "2 Sam 16:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, ati Nzokuvyurira ivyago vyanduruka mu rugo rwawe; nzokunyaga abagore bawe ubona, mbahe umubanyi wawe, aryamane na bo ku murango. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe wabikoreye mu mpisho, ariko jeho nzobikora icese imbere y’Abisirayeli, ku murango nyene.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        }
      ]
