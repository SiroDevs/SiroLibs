              "items": [
                {
                  "text": "Luk 19:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "non’ az’ amurihe uwo mwana w’intama kane, kuko yakoze ikintu nk’ico, akaba imburakigongwe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        }
