            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.7.8+JOB.7.9+JOB.7.10"
              },
              "items": [
                {
                  "text": "Yob 7:8-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None se kw amaze gupfa, noba ncisonzeshereza iki? Mbega noshobora kumugarura? Nzoja iy’ ari, ariko we ntakigaruka aho ndi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        }
