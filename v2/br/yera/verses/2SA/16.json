                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kare ho nosavye nde? Sinosavye umwana wiwe? Nk’uko nahora nsaba so ni ko nawe nzogusaba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.19",
