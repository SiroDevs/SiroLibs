              },
              "items": [
                {
                  "text": "1 Sam 26:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abishayi umwana wa Seruwiya abaza umwami, at’ Ariko n’iki gituma tureka uwo muvyimba w’imbga akagenda aragutuka ga mwami wanje nyen’ ingoma? Hinge njabuke ndamuce izosi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.9",
            "verseOrgIds": [
              "2SA.16.9"
            ]
          }
        },
