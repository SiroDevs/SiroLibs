              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hushayi Umwaruki, umukunzi wa Dawidi, ashikiriye Abusalomu, aramubarira, at’ Uragahora ku ngoma, uragahora ku ngoma! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.16",
