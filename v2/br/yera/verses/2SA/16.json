              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.28"
              },
              "items": [
                {
                  "text": "Kuv 22:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
