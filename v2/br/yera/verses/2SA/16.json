        },
        {
          "text": "Maz’ umwami Dawidi ashitse i Bahurimu, hasokoroka umuntu wo mu muryango wa Sauli yitwa Shimeyi mwene Gera, agenda aramutuka inzira yose. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.5",
            "verseOrgIds": [
              "2SA.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agenda aratera umwami Dawidi amabuye, n’abantu biwe bose; kand’ abantu bose n’abahizi bose bari bamuhagatiye i buryo n’i bumoso. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.6",
            "verseOrgIds": [
              "2SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.12"
              },
              "items": [
                {
                  "text": "1 Sam 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.21"
              },
              "items": [
                {
                  "text": "2 Sam 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko Shimeyi yagenda aramutuka, ati Genda, urakagenda, wa mwicanyi we, wa mugesera we! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.7",
            "verseOrgIds": [
              "2SA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
