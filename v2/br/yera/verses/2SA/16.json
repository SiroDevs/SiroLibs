                "loc": "LAM.3.38"
              },
              "items": [
                {
                  "text": "38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramwishura, ati Dusangiye iki ga yemwe bana ba Seruwiya? Ni yaba antutse Uhoraho ari we yamubariye, ati Tuka Dawidi; har’ uwoshobora kumubuza, at’ Ivyo ubitewe n’iki? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.10",
            "verseOrgIds": [
              "2SA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.11"
              },
              "items": [
                {
                  "text": "2 Sam 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere Dawidi abarira Abishayi n’abantu biwe bose, ati K’umwana wanje nīkūriye mu nda arondera agatwe kanje, mbeg’ urya Mubenyamini we ntarushiriza? Nuko mureke antuke, kuk’ Uhoraho ari we yabimubariye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.11",
            "verseOrgIds": [
              "2SA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.3.28+LAM.3.29+LAM.3.30+LAM.3.31+LAM.3.32+LAM.3.33"
              },
              "items": [
                {
                  "text": "Int 3:28-33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbure Uhoraho azorāba ayo mbonye, ampe ivyiza mu gishingo c’iyo mivumo mvumwe uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.12",
            "verseOrgIds": [
              "2SA.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.21"
              },
              "items": [
                {
                  "text": "2 Sam 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi n’abantu biwe bakomeza inzira, Shimeyi na we agenda akikamanye umusozi abangikanye na we, amutuka ingenda, amutera amabuye asūra umukungugu. ",
          "type": "text",
          "attrs": {
