              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.17.29"
              },
              "items": [
                {
                  "text": "2 Sam 17:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami abaza Ziba, at’ Ibi n’ivy’ iki? Ziba aramwishura, at’ Indogoba n’izo kugira ngw abo mu rugo rwawe bazigendereko, mugenzi; imitsima n’ amatunda na vyo n’induhuro y’ imikangara, vino na yo n’iyo guhēmbūra abazogwira isari mu bugaragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.2",
            "verseOrgIds": [
              "2SA.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.26"
              },
              "items": [
                {
                  "text": "2 Sam 19:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aramubaza, ati Mbega mwene shobuja we ari hehe? Ziba aramwishura, at’ Erega yigumiye i Yerusalemu, kuko yavuze ng’ uyu musi ab’ inzu ya Isirayeli baramusubiza ku ngoma ya se. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.3",
            "verseOrgIds": [
              "2SA.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.29"
              },
              "items": [
                {
                  "text": "2 Sam 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami abarira Ziba, at’ Ehe rāba, ivyar’ ivya Mefibosheti vyose ndabikugabiye. Ziba aramwishura, ati Ndagukūriye ubgatsi, mwami wanje nyen’ ingoma; urakāma untonesha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.16.4",
            "verseOrgIds": [
              "2SA.16.4"
            ]
          }
        }
