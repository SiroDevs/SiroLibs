              "items": [
                {
                  "text": "1 Kor 16:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw aho naja i Tirowa, njanywe n’ubutumwa bgiza bga Kristo, ngasanga nugururiwe urugi mu Mwami wacu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.12",
            "verseOrgIds": [
              "2CO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.1"
              },
              "items": [
                {
                  "text": "Ivyak 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nabuze uko nduhuka mu mutima wanje, kuko ntasanzeyo Tito mwene Data; nuko narabasezeye, nja i Makedoniya.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.2.13",
            "verseOrgIds": [
              "2CO.2.13"
            ]
          }
        }
      ]
    },
