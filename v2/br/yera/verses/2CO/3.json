              },
              "items": [
                {
                  "text": "2 Kor 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "s’uko dushobora ubgacu kwiyumvira ikintu cose nk’ah’ ari twebge candurutseko, ariko dushobozwa n’Imana; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.5",
            "verseOrgIds": [
              "2CO.3.5"
            ]
          }
        },
        {
