              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.63"
              },
              "items": [
                {
                  "text": "Yoh 6:63",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni yo yadushoboje kuba abakozi b’isezerano risha, yamara s’abakozi b’ivyandikishijwe inyuguti, ariko n’ab’ impwemu: kukw ivyandikishijwe inyuguti vyicisha, arikw impwemu ihesha ubugingo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.6",
            "verseOrgIds": [
              "2CO.3.6"
            ]
