                {
                  "text": "1 Kor 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwebge cete cacu, canditswe ku mitima yacu, ico abantu bose bamenya bagasoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.3.2",
            "verseOrgIds": [
              "2CO.3.2"
            ]
