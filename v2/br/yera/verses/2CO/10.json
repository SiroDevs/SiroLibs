          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.13",
            "verseOrgIds": [
              "2CO.10.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.3"
              },
              "items": [
                {
                  "text": "Rom 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tweho ntituzokwirata ibirenze urugero, ariko tuzokwiyumvira urugero rwacu ko ruhwanye n’urugezo rw’ah’ Imana yatugereye, ngo dushike no kuri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.13",
            "verseOrgIds": [
              "2CO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntidushingīra ngo turenge urugezo rwacu, nk’abatāshitse kuri mwebge, kuko twāshitse no kuri mwebge koko, tuzanye ubutumwa bgiza bga Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.14",
            "verseOrgIds": [
              "2CO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.20"
              },
              "items": [
                {
                  "text": "Rom 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntitwirata ibirenze urugero, ntitwirata ivy’ abandi bakoze. Ariko twizigiye yuk’ ukwizera kwanyu ni kwakura, tuzoshirwa hejuru kubganyu, ku vyo twagerewe, ngo twāgukirwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.15",
            "verseOrgIds": [
              "2CO.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.21"
              },
              "items": [
                {
                  "text": "Ivyak 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "tuvuge ubutumwa bgiza mu bihugu biri hirya yanyu, kugira ngo twoye kwirata ivyo dusanze bīteguye, ahāgerewe uwundi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.16",
            "verseOrgIds": [
              "2CO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.23"
              },
              "items": [
                {
                  "text": "Yer 9:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.31"
              },
              "items": [
                {
                  "text": "1 Kor 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwirata yirate Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.17",
            "verseOrgIds": [
              "2CO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.5"
              },
              "items": [
                {
                  "text": "1 Kor 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uwishimagiza atari we yemerwa, ariko hemerwa uw’ Umwami wacu ashimagiza.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.18",
            "verseOrgIds": [
              "2CO.10.18"
            ]
          }
        }
      ]
    }
