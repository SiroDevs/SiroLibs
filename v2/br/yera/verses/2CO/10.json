                "loc": "1CO.2.3"
              },
              "items": [
                {
                  "text": "1 Kor 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.2"
              },
              "items": [
                {
                  "text": "Gal 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe Paulo ubganje ndabinginga kubg’ ubugwaneza n’ineza vya Kristo, jewe umuntu aciye bugufi muri mwebge imbere yanyu, arikw iyo tutari kumwe ndabubahuka; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.1",
            "verseOrgIds": [
              "2CO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.4.21"
              },
              "items": [
                {
                  "text": "1 Kor 4:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko ndabinginga kugira ngo ni twaba kumwe sinze ndinde kububahuka, nk’uko ngabiye kuzokwubahuka bamwe nshize ubgoba, batwiyumvira ko tugenda dukurikira ivy’ akameremere kacu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.2",
            "verseOrgIds": [
              "2CO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho turi n’umubiri ntiturwana mu buryo bg’umubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.3",
            "verseOrgIds": [
              "2CO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.13+EPH.6.14+EPH.6.15+EPH.6.16+EPH.6.17"
              },
              "items": [
                {
                  "text": "Ef 6:13-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw ibirwanishwa vy’intambara yacu atar’ ivyo mu buryo bg’umubiri, arikw imbere y’Imana bifise ubushobozi bgo gushingūra akarimbi, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.4",
            "verseOrgIds": [
              "2CO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "dushingūra impāri n’igishizwe hejuru cose, kihashiriwe kurwanya ukumenya Imana, dufata mpiri ivyiyumvirwa mu mitima vyose, ngo tubigomōrere Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.5",
            "verseOrgIds": [
              "2CO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.9"
              },
              "items": [
                {
                  "text": "2 Kor 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi twiteguye guhana ubutumva bgose, aho mwebge muzogirira ukwumva gushitse.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.6",
            "verseOrgIds": [
              "2CO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega murāba ibibonwa n’amaso? Namba har’ umuntu yizigiye kw ar’ uwa Kristo, yibgire n’ibi, yuk’ ukw ar’uwa Kristo, natwe ari ko turi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.7",
            "verseOrgIds": [
              "2CO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.6"
              },
              "items": [
                {
                  "text": "2 Kor 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.4"
              },
              "items": [
                {
                  "text": "1 Kor 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ububasha bgacu Umwami wacu yaduhaye kugira ngo tububake, ntitubasambure, naho norushiriza kubgirata, sinzomāramāzwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.8",
            "verseOrgIds": [
              "2CO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "sinze niyumvirwe nk’ūbateza ubgoba ivyete vyanje. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.9",
            "verseOrgIds": [
              "2CO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko bavuga, bat’ Ivyete vyiwe birahambaye, birasogōta, arikw iy’ ar’ ino, arakēngēretse, kand’ amajambo yiwe nta co amaze. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.10",
            "verseOrgIds": [
              "2CO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.2"
              },
              "items": [
                {
                  "text": "2 Kor 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūvuga ibisa birtyo ni yibgire n’ibi, yuk’ uko tumeze ku majambo yo mu vyete atari ho turi, ari ko tumeze no ku vyo dukora ari ho turi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.11",
            "verseOrgIds": [
              "2CO.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.1"
              },
              "items": [
                {
                  "text": "2 Kor 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.12"
              },
              "items": [
                {
                  "text": "5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko tutubahuka kwishira mu gitigiri ca bamwe bishimagiza, canke kwigereranya na bo: arikw abo, ko bīrēhēsha ubgabo kandi bīgereranya ubgabo, nta bgenge bagira.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.10.12",
            "verseOrgIds": [
              "2CO.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
