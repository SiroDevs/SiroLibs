                "loc": "2CO.1.3+2CO.1.4+2CO.1.5+2CO.1.6"
              },
              "items": [
                {
                  "text": "2 Kor 1:3-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyo vyose biba kubganyu, kugira ng’ubuntu bg’Imana bgongeranishwe n’ukugwira kw’ abantu, bugwize ishimwe, ngo ritere Imana icubahiro.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.15",
            "verseOrgIds": [
              "2CO.4.15"
            ]
          }
        }
