                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma tutihebura, kuko dufise ubgo busuku, nk’uko twagiriwe ikigongwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.1",
            "verseOrgIds": [
              "2CO.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.17"
              },
              "items": [
                {
                  "text": "2 Kor 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.2.5"
              },
              "items": [
                {
                  "text": "1 Tes 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twanse ibiteye isoni bikorerwa mu mpisho, ntitugenda mu bugunge, ntidufudika ijambo ry’Imana, ariko kwerekana ukuri ni kwo twishimagirisha mu nyonga z’Imana ku mutima w’umuntu wese. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.2",
            "verseOrgIds": [
              "2CO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.18"
              },
              "items": [
                {
                  "text": "1 Kor 1:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko namb’ ubutumwa bgiza twahawe butwikirwa, butwikirirwa abahona, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.4.3",
            "verseOrgIds": [
              "2CO.4.3"
            ]
          }
        },
        {
          "name": "verse",
