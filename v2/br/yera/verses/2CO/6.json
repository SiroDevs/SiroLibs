              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko yavuze,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.2",
            "verseOrgIds": [
              "2CO.6.2"
            ]
