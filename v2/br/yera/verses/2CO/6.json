              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimwifatanye n’abatizera, kand’ ata co musangiye: ukugororoka n’ukugabitanya bifatana bite? Cank’ umuco n’umwiza bifatanya bite? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.14",
            "verseOrgIds": [
              "2CO.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Kristo ahūriye hehe na Beliyari?",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:15",
              "type": "text"
            },
            {
              "text": "Beliyari n’irindi zina rya Satani, risobanurwa ng’ Ububi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " Cank’ uwizera n’ūtizera basangiye iki? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.15",
            "verseOrgIds": [
              "2CO.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ urusengero rw’Imana ruhūza rute n’ibigirwamana? Kuko twebge tur’ urusengero rw’Imana nzima: nk’ukw Imana yavuze,",
          "type": "text",
          "attrs": {
            "verseId": "2CO.6.16",
            "verseOrgIds": [
              "2CO.6.16"
            ]
          }
        }
