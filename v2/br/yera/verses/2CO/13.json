                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.19"
              },
              "items": [
                {
                  "text": "1 Tim 5:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu bugira bube ubga gatatu nza i wanyu. Ijambo ryose rizoringanizwa bivuye mu kanwa k’ivyabona bibiri canke bitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabivuze nkiri kumwe namwe ubugira kabiri kera, na none ntar’ iyo ni ko mbivuga bitaraba, mbarira abācumuye kera n’abandi bose, yuko ni nagaruka ntazogira akagongwe: ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.2",
            "verseOrgIds": [
              "2CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko murondera ikimenyetso co kwerekana yuko Kristo ari we amvugisha, umwe atar’ umunyantege nke kuri mwebge, arikw agira ubushobozi hagati yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.7"
              },
              "items": [
                {
                  "text": "Flp 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw intege nke zāteye kw abambga, ariko non’ ariho kubg’ ubushobozi bg’Imana. Natwe tur’ abanyantege nke muri we, ariko tuzobanaho na we, kubg’ ubushobozi bg’Imana tubereyeho mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        }
      ]
    },
    {
