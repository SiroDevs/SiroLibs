          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu bg’Umwami wacu Yesu Kristo, n’urukundo rw’Imana, n’ubumwe buva kuri Mpwemu Yera, bibane namwe mwese.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.14",
