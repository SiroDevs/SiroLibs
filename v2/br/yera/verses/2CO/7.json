          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bakundwa, ko dufise ivyo vyasezeranywe, twiyuhagire ubuhumane bgose bg’umubiri n’ubg’ umutima, kuba abera tugushikishe kwubaha Imana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.1",
            "verseOrgIds": [
              "2CO.7.1"
            ]
          }
        }
      ]
    },
