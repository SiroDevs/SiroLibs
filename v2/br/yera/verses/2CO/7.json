                "loc": "ACT.20.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamwe twaja i Makedoniya umubiri wacu ntiwaribgatenzukirwe na gatoya, kuko twababajwe uburyo bgose; inyuma hār’ intambara, imbere hār’ ubgoba. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.5",
            "verseOrgIds": [
              "2CO.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.3"
              },
              "items": [
                {
                  "text": "2 Kor 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.1.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.13"
              },
              "items": [
                {
                  "text": "2:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.113.6"
              },
              "items": [
                {
                  "text": "Zab 113:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.138.6"
              },
              "items": [
                {
                  "text": "138:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.2"
              },
              "items": [
                {
                  "text": "Yes 66:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Imana ihūmuriza abicisha bugufi yaduhūmurishije ukuza kwa Tito. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.6",
            "verseOrgIds": [
              "2CO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi s’ukuza kwiwe kwonyene, ariko kandi n’uguhūmurizwa yahūmurijwe namwe, n’uko yatwīgāniye inkumbu zanyu mwangiriye, n’amarira yanyu, n’ishaka mwandwanira, ni co catumye ndushiriza kunezerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.7",
            "verseOrgIds": [
              "2CO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.4"
              },
              "items": [
                {
                  "text": "2 Kor 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho nabateje umubabaro ca cete canje, sinicuza, naho nari naricujije; kuko mbonye yukw ico cete cabateye umubabaro, naho mwawugize igihe gito gusa; ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.8",
            "verseOrgIds": [
              "2CO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "noneho ndanezerewe; sinnejerejwe n’uko mwagize umubabaro, ariko n’uk’ uwo mubabaro wabateye kwihana. Kuko mwagize umubabaro mu buryo bg’Imana, kugira ngo ntihagire ico mubura kubgacu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.9",
            "verseOrgIds": [
              "2CO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.3+MAT.27.4+MAT.27.5"
              },
              "items": [
                {
                  "text": "Mat 27:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.17"
              },
              "items": [
                {
                  "text": "Heb 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umubabaro wo mu buryo bg’Imana utera ukwihana kuticuzwa, kuzana agakiza: arik’ umubabaro wo mu buryo bg’isi utera urupfu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.10",
            "verseOrgIds": [
              "2CO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimubona uwo mubabaro wo mu buryo bg’Imana, ukuntu wabateye umwete mwinshi urtyo? Kandi ko wabateye no kwiregura, no guhigimanga, no gutinya, n’inkumbu, n’ishaka, no guhana? Muri vyose mwiyerekanye ko mwejejwe mur’ ivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.11",
            "verseOrgIds": [
              "2CO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko naho nabandikiye, ivyanyandikishije s’ivy’ uwagize nabi, kandi s’ivy’ uwagiriwe nabi, ariko n’ukugira ng’umwete mutugirira werekanirwe hagati yanyu mu nyonga z’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.12",
            "verseOrgIds": [
              "2CO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye duhūmurizwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mur’ ukwo guhūmurizwa turushiriza guterwa umunezero n’umunezero wa Tito, kuk’ umutima wiwe waruhuwe namwe mwese. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.13",
            "verseOrgIds": [
              "2CO.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namba har’ icanteye ko mbirata mbarātira Tito, ntivyantētereje: ariko nk’uko twababgiye vyose ukuri, ni ko n’ukwirata kwacu, twarātiye Tito, kwabonetse kw ar’ ukw’ ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.14",
            "verseOrgIds": [
              "2CO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.9"
              },
              "items": [
                {
                  "text": "2 Kor 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umutima wiwe urushiriza kubagirira igishika, uko yibutse ingene mwanyumviye mwese, n’ingene mwamwākiriye mutinya, muhinda agashitsi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.15",
            "verseOrgIds": [
              "2CO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nnezerewe yuko mfise umutima uremye kubg’ ivyanyu vyose.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.7.16",
            "verseOrgIds": [
              "2CO.7.16"
            ]
          }
        }
      ]
    }
  ],
