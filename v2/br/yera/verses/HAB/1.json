                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.41"
              },
              "items": [
                {
                  "text": "Ivyak 13:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda ni murābe mu mahanga, muvyitegereze; mutangare, mwumirwe: kuko mu gihe canyu ngira nkore igikorwa mutokwemera naho mwokibarirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.15"
              },
              "items": [
                {
                  "text": "Yer 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ehe rāba, ngira nkakamure Abakaludaya, rya hanga ry’inkazi kandi ry’inkuba, bagenda batera isi iyo iva ikagera, bakikeberezako ingo zitar’ izabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo n’ibirara vy’inkazi, kandi bateye ubgoba: uguhana no gutikiza ni bo bivako. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.49"
              },
              "items": [
                {
                  "text": "Gus 28:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.13"
              },
              "items": [
                {
                  "text": "Yer 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.6"
              },
              "items": [
                {
                  "text": "5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amafarasi yabo arusha ingwe ubukuba, kand’ arusha ubukazi amabingira agenda ijoro: abagendera ku mafarasi yabo baza bihaya: mber’ abagendera ku mafarasi yabo baza bavuye kure; baguruka nk’inkukuma",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:8",
              "type": "text"
            },
            {
              "text": "inkukuma ni yo mpungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yihutira ico irotsa. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.4"
              },
              "items": [
                {
                  "text": "Yos 11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose bazanwa n’umuryano; amaso yabo bayahangana igihababu imbere yabo; bakumakuma imbohe nk’ umusenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.4.2"
              },
              "items": [
                {
                  "text": "Ezk 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere bacōkōra abami, bagatwenga abaganwa, ibihome vyose barabitwenga gusa, kuko babirundira ibigūngūzi vy’ ivu vyo kwuririrako, bakabinesha. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagaheza bagahita nk’umuyaga, bagakomeza inzira, ar’ abanyabicumuro; kand’ inkomezi zabo bāzigize imana yabo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.11",
            "verseOrgIds": [
              "HAB.1.11"
            ]
          }
        }
      ]
    },
