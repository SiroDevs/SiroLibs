                  "text": "Mal 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntiwamyeho uhereye kera hose, Uhoraho Mana yanje, Uwera wanje? Ntituzopfa. Uhoraho, wabashizeho ng’ ubacishe amateka; Gitandara we, wabashiriyeho guhana. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
