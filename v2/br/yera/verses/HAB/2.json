                "loc": "ISA.30.8"
              },
              "items": [
                {
                  "text": "Yes 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho aranyishura, at’ Andika ivyo weretswe, uvyandike ku bisate mu nyuguti zisomeka, kugira ng’ ūbisoma anyarutse. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        },
        {
