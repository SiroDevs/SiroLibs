              },
              "items": [
                {
                  "text": "Zek 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ abo bose ntibazobīvuga, bakabacakw akagani bakīkiriza, bati Bazobona ibara, abakuma ibitar’ ivyabo, bagatako bakīremēka amasahu! Mbega bazogeza ryari? ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ abazobarya ntibazobūbīra giturumbuka, n’abazobajegenyura ntibazokwikangura, namwe mugacika inyagano zabo? ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.33.1"
              },
              "items": [
                {
                  "text": "Yes 33:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko mwanyaze amahanga menshi, namwe amasigarira yose y’amoko azobanyaga, abahōye amaraso y’ abantu, n’umuryano igihugu cabonye, bo n’ibisagara n’ababibamwo bose.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
