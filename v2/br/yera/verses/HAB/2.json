                "loc": "HEB.10.38"
              },
              "items": [
                {
                  "text": "Heb 10:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba, umutima wiwe urīkakishije, ntutunganye: arik’ umugororotsi azobeshwaho n’ukwizera kwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
