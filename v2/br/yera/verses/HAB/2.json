                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azobona ibara, uwubakisha igisagara amaraso yavishije, akaninaharisha igisagara ibigabitanyo! ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        },
