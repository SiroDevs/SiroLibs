        },
        {
          "text": "Azobona ibara, ūronderera inzu yiwe inyungu mbi, kugira ngo yiyarikire icāri ciwe hejuru iyo bigwa, ngw abone gukira ukuboko kw’umunyakibi! ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 2:10"
          },
          "items": [
