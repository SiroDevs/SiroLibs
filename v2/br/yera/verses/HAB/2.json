                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntibiva k’Uhoraho Nyen’ ingabo kw amoko atamishwa n’ibizoturirwa n’umuriro, amahanga akiruhiriza ubusa? ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
