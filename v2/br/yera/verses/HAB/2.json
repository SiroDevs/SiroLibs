            }
          ]
        },
        {
          "text": "Kand’ ikindi, abo bantu n’imborerwa, n’abantu bihayagiza, bataragama i wabo; baromoye nk’i kuzimu, bameze nk’urupfu, ntibahāga; ariko biyegeranirizakw amahanga yose, bakikumakumirakw amoko yose. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.8"
              },
              "items": [
                {
                  "text": "Yes 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.2.4"
              },
              "items": [
                {
                  "text": "Mik 2:4",
