              },
              "items": [
                {
                  "text": "2 Pet 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyerekanywe bifise igihe vyashingiwe, kandi vyihutira kugishikako, ntibizobesha; naho vyotebagana, ubirorēre, kuko bitazobura kuza, ntibizoteba. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        },
        {
          "name": "verse",
