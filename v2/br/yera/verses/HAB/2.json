                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzohagarara nshibamye, nje ku munara wo gushibamako, nkenguze ndābe ico aribumbarire, n’ico ndibumwishure, ku vy’ amaganya yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        },
        {
