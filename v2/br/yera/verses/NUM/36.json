                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru b’amazu ya ba sekuruza bo mu muryango wa Gileyadi mwene Makiri, Makiri mwene Manase, umwe mu miryango ya Yosefu, bīgira hafi, bavugira imbere ya Mose n’abatware, ari bo bakuru b’amazu ya ba sekuruza y’Abisirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.1",
            "verseOrgIds": [
              "NUM.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 36:2"
          },
          "items": [
