                "loc": "JOS.17.3"
              },
              "items": [
                {
                  "text": "Yos 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati Mugenzi, Uhoraho yakubariye kugabuza igihugu ubupfindo, ng’ ugihe Abisirayeli kw amashamvu; kandi mugenzi, Uhoraho yakubariye guha abakobga ba Selofehadi mwene wacu ishamvu yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.2",
            "verseOrgIds": [
              "NUM.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ni barongorwa n’umuntu wese wo mu yindi miryango y’ Abisirayeli, ishamvu yabo izokūrwa kw ishamvu ya ba sogokuruza, ishirwe kw ishamvu y’ umuryango bazojamwo: nukw izoba ikūwe ku mugabane twahawe kw ishamvu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.3",
            "verseOrgIds": [
              "NUM.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.10"
              },
              "items": [
                {
                  "text": "Lew 25:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwaka wa yubile y’Abisirayeli ni washika, ishamvu yabo izoshirwa kw ishamvu y’umuryango bazoba baragiyemwo; nukw ishamvu yabo izoba ikūwe kw ishamvu y’umuryango wa ba sogokuruza.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.4",
            "verseOrgIds": [
              "NUM.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.4",
            "verseOrgIds": [
              "NUM.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose ashikiriza Abisirayeli ivyo Uhoraho amubariye, at’ Ab’ umuryango w’Abayosefu, ivyo bavuze n’ivy’ ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.5",
            "verseOrgIds": [
              "NUM.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co cagezwe Uhoraho ashinze ku vy’abakobga ba Selofehadi, ati Bararongorwa n’abo bagomba: ariko bo mu nzu yo mu muryango wa se. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.6",
            "verseOrgIds": [
              "NUM.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.3"
              },
              "items": [
                {
                  "text": "1 Abam 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire ishamvu iva mu muryango ngw ije mu wundi; arik’ umuntu wese wo mu Bisirayeli aze yame yīzīziye ishamvu yo mu muryango wa ba sekuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.7",
            "verseOrgIds": [
              "NUM.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.22"
              },
              "items": [
                {
                  "text": "1 Ngo 23:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukobga wese azogira ishamvu mu muryango wose w’Abisirayeli, az’ arongorwe n’uwo mu nzu yo mu muryango wa se, kugira ng’umuntu wese mu Bisirayeli agire ishamvu ya ba sekuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.8",
            "verseOrgIds": [
              "NUM.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire ishamvu iva mu muryango ngw ije mu wundi; kukw imiryango yose y’Abisirayeli izoba ikwiye kwīzīzira amashamvu yayo ubgayo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.36.9",
            "verseOrgIds": [
              "NUM.36.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
