              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi w’intangamarāra wayo muze mukoranywe no kuba ikoraniro ryera: ntihaze hagire igikorwa kiruhisha muwukorako: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.18",
            "verseOrgIds": [
              "NUM.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
