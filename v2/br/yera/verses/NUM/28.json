                  "text": "Mat 26:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi w’ icumi na gatanu w’ukwo kwezi nyene, haze habe umusi mukuru: muze mumare imisi ndwi murya imitsima itambiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.17",
            "verseOrgIds": [
              "NUM.28.17"
            ]
