            }
          ]
        },
        {
          "text": "Mu kwezi kwa mbere, ku musi ugira icumi na kane wakwo, haze hame haba Pasika yanje, jewe Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.16",
