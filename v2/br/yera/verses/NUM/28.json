        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kw isabato muze mutange abana b’intama babiri b’amasuguru, batarengeje umwaka, batagira agasembga, bo n’ibigiracumi bibiri vy’ifu igogōretse vy’ingero ya efa, ivanzwe n’amavuta ya elayo, kw ishikanwa ry’ifu, hamwe n’ishikanwa ry’ibiturire rigendanye na vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.9",
            "verseOrgIds": [
              "NUM.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni co kimazi co kwoswa kw isabato yose ukw itashe, congerwe ku kimazi co kwoswa c’intasība, no kw ishikanwa ry’ibiturire rigendanye na co.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.10",
            "verseOrgIds": [
              "NUM.28.10"
            ]
          }
        }
      ]
    },
