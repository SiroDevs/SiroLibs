              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.4+NUM.15.5+NUM.15.6+NUM.15.7+NUM.15.8+NUM.15.9+NUM.15.10+NUM.15.11+NUM.15.12"
              },
              "items": [
                {
                  "text": "Guh 15:4-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "imasa yose muze muyitangane n’ibigiracumi bitatu vy’ifu igogōretse vy’iyo ngero ya efa, ivanzwe n’amavuta ya elayo, kw ishikanwa ry’ifu; ya mpfizi y’intama na yo muyitangane n’ ibigiracumi bibiri vy’ifu igogōretse vy’iyo ngero nyene, ivanzwe n’amavuta ya elayo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.12",
            "verseOrgIds": [
              "NUM.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "umwana w’intama umwe‐umwe muwutangane n’ikigiracumi kimwe c’ifu igogōretse ivanzwe n’amavuta ya elayo: bize bibe ikimazi co kwoswa, umubabge umota neza, ikimazi gitōngōrwa n’umuriro nshikaniwe jewe Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.13",
            "verseOrgIds": [
              "NUM.28.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 28:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amashikanwa y’ibiturire agendana na vyo az’ abe aya: irigendana n’ imasa yose rize ribe vino itīmbānye iyo ngero ya hini, iryo kur’ iyo mpfizi y’intama rize ribe ikigira gatatu ca hini nyene, iryo ku mwana w’intama wose rize ribe ikigira kane c’iyo hini; ivyo bize bibe ikimazi co kwoswa uk’ ukwezi kubonetse, ukw amezi yo mu mwaka angana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.14",
            "verseOrgIds": [
              "NUM.28.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 28:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.24"
              },
              "items": [
                {
                  "text": "Guh 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muze mutange n’impfizi y’impene, muyimpaye jewe Uhoraho, kw ikimazi gitangiwe ivyaha, mucongere ku kimazi co kwoswa c’ intasība, no kw ishikanwa ry’ibiturire rigendanye na co.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.15",
            "verseOrgIds": [
              "NUM.28.15"
            ]
          }
        }
      ]
