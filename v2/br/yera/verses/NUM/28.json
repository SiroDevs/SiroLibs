            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.8.21"
              },
              "items": [
                {
                  "text": "Ita 8:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.11"
              },
              "items": [
                {
                  "text": "Lew 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Ugere Abisirayeli, ubabarire, ut’ Ibimazi vyiwe, ari zo mfungurwa ashikanirwa zitōngōrwa n’umuriro, z’umubabge umumotera neza, uti Muze muhore muvyitondera, mubimushikanire mu bihe vyavyo vyashinzwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.2",
            "verseOrgIds": [
              "NUM.28.2"
            ]
          }
        }
      ]
    },
    {
