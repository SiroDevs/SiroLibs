                {
                  "text": "Gus 15:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko muze munshikanire ikimazi gitōngōrwa n’umuriro, jewe Uhoraho, ari co kimazi co kwoswa: kize kibe amamasa abiri y’imikangara, n’impfizi y’intama imwe, n’abana b’intama ndwi b’amasuguru, batarengeje umwaka; muze mubitange bitagira agasembga, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.19",
            "verseOrgIds": [
              "NUM.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe n’ishikanwa ry’ifu bigendanye, ifu igogōretse ivanzwe n’amavuta ya elayo: iryo kw imasa ribe ibigiracumi bitatu vy’iyo ngero ya efa, iryo ku mpfizi y’intama ribe ibigiracumi bibiri vya efa nyene, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.20",
            "verseOrgIds": [
              "NUM.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "iryo ku mwana w’intama umwe‐umwe mur’ abo, ukw ari ndwi, ribe ikigiracumi kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.21",
            "verseOrgIds": [
              "NUM.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mutange n’impfizi y’impene kw ikimazi gitangirwa ivyaha, co kubabera impongano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.22",
            "verseOrgIds": [
              "NUM.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo muze muvyongere ku kimazi co kwoswa co mu gitondo, ari co kimazi co kwoswa c’intasība. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.23",
            "verseOrgIds": [
              "NUM.28.23"
            ]
          }
        },
        {
