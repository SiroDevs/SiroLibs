            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ukwezi kwose kubonetse, muze munshikanire ikimazi co kwoswa, jewe Uhoraho; kibe amamasa abiri y’imikangara, bo n’impfizi y’intama imwe, n’ abana b’intama ndwi b’amasuguru, batarengeje umwaka, batagira agasembga; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.11",
            "verseOrgIds": [
              "NUM.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 28:12"
          },
          "items": [
