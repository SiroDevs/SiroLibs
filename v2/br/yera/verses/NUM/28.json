          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku musi ugira indwi muze mukoranywe no kuba ikoraniro ryera: ntihaze hagire igikorwa kiruhisha muwukorako.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.25",
