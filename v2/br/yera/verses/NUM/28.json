              "NUM.28.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.38+EXO.29.39+EXO.29.40+EXO.29.41+EXO.29.42"
              },
              "items": [
                {
                  "text": "Kuv 29:38-42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubabarire, ut’ Iki ni co kimazi co gutōngōrwa n’umuriro muzohora mumushikanira: muze mutange abana b’intama babiri‐babiri uko bukeye, b’amasuguru, batarengeje umwaka, batagira agasembga, kw ibimazi vyo kwoswa vy’intasība. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.3",
            "verseOrgIds": [
              "NUM.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana w’intama umwe muze muwutange mu gitondo, uwundi ku mugoroba; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.4",
            "verseOrgIds": [
              "NUM.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "bo n’ifu igogōretse y’ikigiracumi c’ ingero yitwa efa kw ishikanwa ry’ ifu, ivanzwe n’amavuta avuye muri elayo zisekuwe y’ikigirakane c’ ingero yitwa hini. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.5",
            "verseOrgIds": [
              "NUM.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo n’ikimazi co kwoswa c’intasība, nk’uko vyashingiwe ku musozi Sinayi, ngo kibe umubabge umota neza w’ikimazi nshikaniwe jewe Uhoraho, kigatōngōrwa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.6",
            "verseOrgIds": [
              "NUM.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishikanwa ry’ibiturire muzohora mushikanana n’umwana w’intama umwe‐umwe, rize ribe ikigirakane ca hini nyene; iryo shikanwa ry’ ibiturire bihiye munshikanira, muze murivyagize Ahēra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.7",
            "verseOrgIds": [
              "NUM.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwundi mwana w’intama muze muwutange ku mugoroba: muwutangane n’ishikanwa ry’ifu n’iry’ ibiturire, nk’ivyo mu gitondo, bibe ikimazi gitōngōrwa n’umuriro, umubabge ummotera neza, jewe Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.28.8",
            "verseOrgIds": [
              "NUM.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
