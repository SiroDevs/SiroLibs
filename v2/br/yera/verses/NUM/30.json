              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ho ni yarongorwa akiri mur’ ayo masezerano, no mu vyo akanwa kiwe kātuntumukanye, akavyībohesha; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "umugabo wiwe akavyumva, agapfa kwihorera akamureka kur’ uwo musi avyumviyeko; ayo masezerano yiwe azohama, bo n’ivyo yaraganye yibohesheje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umugabo wiwe ni yamubuza ku musi avyumviyeko, azoba akūyeh’ iryo sezerano yarimwo, n’ivyo akanwa kiwe kātuntumukanye, akavyibohesha; kand’ Uhoraho azomuharira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw isezerano ry’umupfakazi, canke ry’uwahukanye, ico azoba yībohesheje cose kizomuhambira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umugore ni yasezerana isezerano ari mu rugo, akībohesha ivyo araganye, akarahira, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "umugabo wiwe akavyumva, agapfa kwihorera akamureka, ntamubuze; ayo masezerano yiwe yose azohama, bo n’ivyo yaraganye vyose yibohesheje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umugabo wiwe ni yavyanzuza ku musi avyumviyeko, ivyamuvuye mu kanwa vyose vy’ amasezerano n’ivyo yaraganye akavyibohesha, ntibizohama, kuk’ umugabo wiwe yavyanjuje; kand’ Uhoraho azomuharira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isezerano ryose n’indahiro yose yokwibohesha ngo yibabaze, umugabo wiwe ni we yobishinga canke ni we yobikūra. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umugabo wiwe ni yapfa kwihorera uko bukeye uko bgije, akamureka, azoba akomeje amasezerano yiwe yose n’ivyo yaraganye vyose bimuhambiriye. Kw azoba yarihoreye akamureka ku musi avyumviyeko, azoba yarabishinze. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni yavyanzuza amaze igihe yaravyumvise, azogībgako n’ibigabitanyo vy’umugore wiwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        }
      ]
    },
