          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw i Heshiboni war’ umurwa wa Sihoni umwami w’Abamori, yari yararwanije umwami w’i Mowabu wo ku ngoma yahise, akamunyaga igihugu ciwe cose gushitsa kuri Arunoni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
