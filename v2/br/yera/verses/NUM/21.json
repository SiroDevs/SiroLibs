              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli basezeranira Uhoraho isezerano, bati Ni wagabura aba bantu mu maboko yacu, tuzokomvomvora ibisagara vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.2",
            "verseOrgIds": [
              "NUM.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yumvira Abisirayeli, agabura abo Banyakanani mu maboko yabo; babakomvomvorana n’ibisagara vyabo: aho hantu haca hitwa Horuma.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.3",
            "verseOrgIds": [
              "NUM.21.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:3",
              "type": "text"
            },
            {
              "text": "Horuma risobanurwa ngw Ahakomvomvowe.",
              "type": "text"
            }
          ]
        }
      ]
    },
