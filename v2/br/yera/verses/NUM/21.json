                {
                  "text": "Guh 11:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "batonganya Imana na Mose, bati Mwadukūriye iki muri Egiputa, mukatuzana gupfira mur’ ubu bugaragwa? kw ata vyo kurya tuharonka, ata n’amazi ariho, kandi tubihiwe n’ibi vyo kurya bitagira ikimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.5",
            "verseOrgIds": [
              "NUM.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 21:6"
          },
          "items": [
            {
              "text": "6",
