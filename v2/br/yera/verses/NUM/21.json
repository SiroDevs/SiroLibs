            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuduka ku musozi Hori, bajana inzira ija ku Kiyaga Gitukura kugira ngo bagendane urubibe rw’igihugu ca Edomu; abantu bīhebūzwa cane n’urwo rugendo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.4",
            "verseOrgIds": [
              "NUM.21.4"
            ]
          }
        },
        {
