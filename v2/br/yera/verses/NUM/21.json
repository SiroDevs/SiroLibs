        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.15",
            "verseOrgIds": [
              "NUM.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavudukayo bashika i Beri; aho ni ha handi Beri Uhoraho yabaririra Mose, ati Koranya abantu, ndabahe amazi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.16",
            "verseOrgIds": [
              "NUM.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bagaca baririmba iyi ndirimbo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahaguruka mur’ ubgo bugaragwa, bashika i Matana; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.18",
            "verseOrgIds": [
              "NUM.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "bavuduka i Matana, bashika i Nahaliyeli; bavuduka i Nahaliyeli bashika i Bamoti; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.19",
            "verseOrgIds": [
              "NUM.21.19"
            ]
          }
        },
