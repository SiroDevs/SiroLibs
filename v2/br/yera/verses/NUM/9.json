                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi rya hema ryashinzweko, ca gicu kiraza, kiraripfuka, ari ryo hema ry’Ibishinga intahe: maz’ uhereye ku mugoroba ugashitsa mu gitondo caba kur’ iryo hema gisa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15",
            "verseOrgIds": [
              "NUM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko vyagenda biba imisi yose: ico gicu cama kiripfutse, mw ijoro kigasa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.16",
            "verseOrgIds": [
              "NUM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.40.36"
              },
              "items": [
                {
                  "text": "Kuv 40:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.11"
              },
              "items": [
                {
                  "text": "Guh 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ico gicu iyo kidūze kivuye kur’ iryo hema, Abisirayeli ni ho bābona kugenda; kand’ ahantu cahagarara, ni ho bāsagaza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
