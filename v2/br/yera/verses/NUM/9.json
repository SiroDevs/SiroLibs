                "loc": "NUM.5.2"
              },
              "items": [
                {
                  "text": "Guh 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze hār’ abagabo bahumanijwe n’umuvyimba w’umuntu, bituma badashobora kurya ivya Pasika kur’ uwo musi. Baza imbere ya Mose na Aroni kur’ uwo musi nyene, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "baramubarira, bati Turahumanye kubg’ umuvyimba w’umuntu: none n’iki cotuma dukūrwamwo, ngo ntidutange ikimazi c’Uhoraho mu gihe caco cashinzwe, hamwe n’Abisirayeli bandi? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose arabishura, ati Banza muhagarare, numve ico Uhoraho aribushinge ku vyanyu.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        }
      ]
    },
