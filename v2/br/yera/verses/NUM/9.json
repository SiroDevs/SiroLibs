              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.43+EXO.12.44+EXO.12.45+EXO.12.46+EXO.12.47+EXO.12.48+EXO.12.49"
