                  "text": "Yoh 19:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntibaze bagire izo basiga ngo zirāre, kandi ntibaze bavune igufa na rimwe ryazo: nk’ukw amabgirizwa yose ya Pasika ameze, az’ abe ari ko babirya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.15"
              },
              "items": [
                {
                  "text": "Kuv 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umuntu adahumanye, kandi ntabe mu rugendo, akareka kurya ku vya Pasika, uwo muntu az’ acibge mu bgoko bgabo. Icaha c’uwo muntu kizomusubirako kukw atātanze ikimazi canje mu gihe caco cashinzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.48"
              },
              "items": [
                {
                  "text": "Kuv 12:48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.49"
              },
              "items": [
                {
                  "text": "49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunyamahanga ni yaza kuba muri mwebge, akagomba kuja mu vya Pasika yanje, jewe Uhoraho, az’ agenze nk’ukw ibgirizwa ry’ ivya Pasika rimeze, bo n’imigenzo yayo: muze mugire ibgirizwa rimwe ku munyamahanga no ku mvukira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        }
      ]
