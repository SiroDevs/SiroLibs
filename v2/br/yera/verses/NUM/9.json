                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baze babirye mu kwezi kwa kabiri, ku musi wakwo ugira icumi na kane nyene, ku mugoroba; inyama baze bazikoze imitsima itambiwe n’imboga zirura; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
