              "items": [
                {
                  "text": "Gus 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo, abantu baba mur’ ico gihugu n’abahizi, kand’ ibisagara vyaho bizitijwe inzitiro z’amabuye, kandi ni binini‐binini cane; eka mbere twabonyey’ Abānaki. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.28",
            "verseOrgIds": [
              "NUM.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8"
              },
              "items": [
                {
                  "text": "Kuv 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igihugu c’i Negebu kibamw’ Abamaleki, n’umugamba waho ubamw’ Abaheti n’Abayebusi n’Abamori; kand’ ahaherereye ku kiyaga haba Abanyakanani, bo n’ahaherereye kuri Yorodani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.29",
            "verseOrgIds": [
              "NUM.13.29"
            ]
          }
        }
      ]
