                "loc": "GEN.6.4"
              },
              "items": [
                {
                  "text": "Ita 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi twabonyey’ ibigatanya, ari bo Bānaki, bakomōtse ku bigatanya nyene: ku ruhande rwacu twabonye ko tubamezeko nk’inzige, na bo kandi bakabona kw ari ko tumeze.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.33",
            "verseOrgIds": [
              "NUM.13.33"
            ]
          }
