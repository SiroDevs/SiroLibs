          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Kalebu yamira abantu bariko baridodombera Mose, aravuga, ati Ni muze tudūge ubu nyene, tuhashikīre, kuko dushobora rwose kuhatsinda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.30",
            "verseOrgIds": [
              "NUM.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abari baradūganye na we, bati Ntitwoshobora kudūga ngo turwanye abo bantu, kuko baturusha ubuhizi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.31",
            "verseOrgIds": [
              "NUM.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babarira Abisirayeli inkuru z’agacavutu z’ico gihugu batase, bat’ Igihugu twanyuragiyemwo tugitata n’igihugu kimiragura abantu baho, kand’ abantu bose twahabonye n’abagabo barebare cane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.13.32",
            "verseOrgIds": [
              "NUM.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
