              "items": [
                {
                  "text": "Ezk 29:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuk’ uwo mugabo akwiye kujana umugore wiwe ku muherezi, amujanane n’ishikanwa amutangiriye ry’ikigiracumi c’ingero yitwa efa y’ifu ya sayiri; ntaz’ ayisukekw amavuta, canke ngw ayishirekw imibavu, kukw ar’ ishikanwa ry’ifu rizanywe kubg’ ifūhe, ar’ ishikanwa ry’icibutso, cibutsa ibigabitanyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.15",
            "verseOrgIds": [
              "NUM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi amwīgize hafi, amushire imbere yanje Uhoraho: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.16",
            "verseOrgIds": [
              "NUM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo muherezi aheze yābīre amazi yejejwe mu kintu c’ikibumbano, yābīre no ku mukungugu wo hasi mw ihema, awushire mur’ ayo mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.17",
            "verseOrgIds": [
              "NUM.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashire uwo mugore imbere yanje, amuhamburure umushatsi, amutereke mu maboko rya shikanwa ry’ifu ry’icibutso, ari ryo shikanwa rizanywe kubg’ ifūhe. Uwo muherezi afate mu ntoke ayo mazi y’umururazi atera umuvumo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.18",
            "verseOrgIds": [
              "NUM.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi aheze arahize uwo mugore, amutongēre, at’ Asangw’ ata mugabo wundi mwaryamanye, canke ng’ ube wararetse kurāba umugabo wawe, ukihumanya, kand’ ukiganzwa na we, aya mazi y’umururazi atera umuvumo ntagire ico akugira. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.19",
            "verseOrgIds": [
              "NUM.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw asangwa wararetse kuba ari we urāba, kand’ ari we akikuganza, ukihumanya, hakaba har’ uwundi mugabo mwaryamanye atar’ uwawe— ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.20",
            "verseOrgIds": [
              "NUM.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.22"
              },
              "items": [
                {
                  "text": "Yer 29:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo muherezi aheze arahize uwo mugore indahiro yo kwivuma, amutongēre, at’ Uhoraho aguhindure ikivume n’indahiro mu bgoko bganyu, bitewe n’ukw akunyunyuye ikibero, akagaragamvya inda yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.21",
            "verseOrgIds": [
              "NUM.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.15"
              },
              "items": [
                {
                  "text": "Gus 27:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.109.18"
              },
              "items": [
                {
                  "text": "Zab 109:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’aya mazi atera umuvumo araja mu mara yawe, agaragamvye inda yawe, anyunyure ikibero cawe. Nuk’ uwo mugore yitabirize, ati Amen, amen!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.22",
            "verseOrgIds": [
              "NUM.5.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:22",
              "type": "text"
            },
            {
              "text": "Amen risobanurwa ngo Ni bibe birtyo.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
