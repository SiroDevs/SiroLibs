              },
              "items": [
                {
                  "text": "Lew 18:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.4"
              },
              "items": [
                {
                  "text": "Yoh 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwundi mugabo akaryamana na we, bikazīkwa, umugabo wiwe ntabimenye, uwo mugore akaba ahumanye, ntihaboneke ūmwagiriza, canke ngw afatwe akibikora; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.13",
            "verseOrgIds": [
              "NUM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "umugabo wiwe agafatwa n’ifūhe, agafūhira umugore wiwe, yahumanye, canke yofatwa n’ifūhe, agafūhira umugore wiwe, kand’ atāhumanye; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.14",
            "verseOrgIds": [
              "NUM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 5:15"
