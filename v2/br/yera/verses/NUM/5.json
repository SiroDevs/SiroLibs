              "items": [
                {
                  "text": "Lew 8:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi acishemwo, akūre rya shikanwa ry’ifu rizanywe kubg’ ifūhe mu maboko y’uwo mugore, arizungurize imbere yanje Uhoraho, arijane aje ku gicaniro, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.25",
            "verseOrgIds": [
              "NUM.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
