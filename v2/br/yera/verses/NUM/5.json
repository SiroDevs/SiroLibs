        },
        {
          "text": "ar’ icitwa izinamuhungu cank’ izinamukobga, mubakūreho, mubashire hirya y’aho mushagaje, kugira ngo ntibahahumanye, kand’ ari ho mba hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.3",
            "verseOrgIds": [
              "NUM.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Abisirayeli babigenza bartyo, babashira hirya y’aho bashagaje; nk’uk’ Uhoraho yabariye Mose, baba ari ko bakora.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.4",
            "verseOrgIds": [
              "NUM.5.4"
            ]
          }
        }
