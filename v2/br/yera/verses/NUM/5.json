            }
          ]
        },
        {
          "text": "ati Barira Abisirayeli, ut’ Umugabo cank’ umugore ni yakora icaha cose mu vy’abantu bagenda bakora, agatsindwa n’urubanza; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.6",
