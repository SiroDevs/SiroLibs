            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nyene kugirirwa nabi, namb’ ata mwene wabo wo hafi yasize, yokirihwa, indihano ya wa wundi yatsinzwe iz’ ibe iyanje Uhoraho, ihabge umuherezi, ayigerekekw impongano y’impfizi y’intama, bayimutangirekw impongano. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.8",
            "verseOrgIds": [
              "NUM.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 5:9"
          },
