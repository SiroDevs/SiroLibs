            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.12"
              },
              "items": [
                {
                  "text": "5:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikamatek’ urushi rumwe rwo kuba icibutso caryo, arwosereze ku gicaniro, abone kunywesha uwo mugore ayo mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.26",
            "verseOrgIds": [
              "NUM.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.37"
              },
              "items": [
                {
                  "text": "Gus 28:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.9"
              },
              "items": [
                {
                  "text": "Yer 24:9",
