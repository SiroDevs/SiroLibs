            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "aze yature icaha yakoze, arihe n’ico kintu uko kingana, camukwegeye gutsindwa, kand’ akigerekeko n’ikingana n’ikigira gatanu caco, akirihe uwo yagiriye nabi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.7",
            "verseOrgIds": [
              "NUM.5.7"
            ]
          }
        },
        {
