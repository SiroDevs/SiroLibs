                {
                  "text": "Guh 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabane wose uzoshingūrwa ku vyēra vyose Abisirayeli bashikana, bazanira umuherezi, uz’ ube uwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.9",
            "verseOrgIds": [
              "NUM.5.9"
            ]
          }
        },
        {
