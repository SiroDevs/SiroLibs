            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivy’ umuntu wese arobanuye ngw abitange, bize bibe ivy’ umuherezi; mber’ ic’ umuntu aha umuherezi cose kizoba iciwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.10",
            "verseOrgIds": [
              "NUM.5.10"
