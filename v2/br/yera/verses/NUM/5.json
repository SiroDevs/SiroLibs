              },
              "items": [
                {
                  "text": "Zek 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yamara kuyamunywesha, bizomera birtya: ni yaba yarahumanye, akaba yacumuye ku mugabo wiwe, ayo mazi atera umuvumo amushitsemwo azomuhindukira umururazi, agaragambe inda, anyunyuke ikibero, ahinduke ikivume mu bgoko bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.27",
            "verseOrgIds": [
              "NUM.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwo mugore ni yaba atāhumanye, ntiyandure, azoba yēze, ntibizomubuza gusama inda.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
            "verseOrgIds": [
              "NUM.5.28"
            ]
          }
        }
      ]
    },
