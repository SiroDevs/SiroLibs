          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawomi ajana uwo mwana, amushira mu gikiriza, aba umurezi wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.16",
            "verseOrgIds": [
              "RUT.4.16"
