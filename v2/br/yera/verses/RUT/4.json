            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Bowazi yābīra Rusi, aba umugore wiwe; abana na we, Uhoraho amuha gusama inda, avyara umuhungu. ",
          "type": "text",
          "attrs": {
