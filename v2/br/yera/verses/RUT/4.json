              "items": [
                {
                  "text": "Gus 25:7-10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kera uyu ni wo war’ umugenzo w’Abisirayeli wo gucungura no kunyuranya, kugira ngo vyose bishingwe: umuntu yakūra inkweto yiwe, akayiha uwundi. Uko ni kw’Abisirayeli bātanga icabona ca ben’ ivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.7",
            "verseOrgIds": [
              "RUT.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "RUT 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko wa mucunguzi abarira Bowazi, ati N’uryīgurire. Maz’ akūra inkweto yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.8",
            "verseOrgIds": [
              "RUT.4.8"
            ]
          }
        },
        {
