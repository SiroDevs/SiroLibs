                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ azosubiza intege mu bugingo bgawe, kand’ azogutunga ugeze mu zabukuru: kuk’ umukazana wawe agukunda, akakurutira abahungu ndwi wovyaye, ari we amuvyaye. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.15",
            "verseOrgIds": [
              "RUT.4.15"
            ]
          }
        },
        {
