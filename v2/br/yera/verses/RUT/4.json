              "items": [
                {
                  "text": "4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Bowazi aramubarira, ati Ni wagura iryo tongo na Nawomi, ukwiye kurigurana na Rusi Umunyamowabukazi, umugore w’umuhisi, ng’ uhonore umuhisi, ribe ishamvu y’izina ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.5",
            "verseOrgIds": [
              "RUT.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "RUT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.3.12"
              },
              "items": [
                {
                  "text": "Rus 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.3.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mucunguzi aramwishura, at’ Ubganje sinshobora kuritora, ngw iyanje shamvu ndayidabanganye: subira mu gishingo canje co kuritora, kuko jeho ntashobora kuritora.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.6",
            "verseOrgIds": [
              "RUT.4.6"
            ]
          }
        }
      ]
