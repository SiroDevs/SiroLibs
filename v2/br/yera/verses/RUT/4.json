            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nagomvye kubikumenyesha, no kukubgira kurigurira imbere y’aba bicaye hano, n’imbere y’ abashingantahe b’i wacu. Ni wagomba kuritora, uritore, n’utabigomba mbarira, mbimenye: kukw ata wundi yoritora atari wewe, canke jewe ngukurikiye. Aramwishura, ati Ndaritora. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.4",
            "verseOrgIds": [
              "RUT.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "RUT 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.5"
              },
              "items": [
                {
                  "text": "Gus 25:5",
                  "type": "text"
                }
