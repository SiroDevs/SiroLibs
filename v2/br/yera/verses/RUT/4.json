              },
              "items": [
                {
                  "text": "Imig 31:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azana abantu cumi bo mu bashingantahe b’ico gisagara, arababgira, ati Ni mwicare hano. Baricara. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.2",
            "verseOrgIds": [
              "RUT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.22"
              },
              "items": [
                {
                  "text": "Rus 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abgira wa mucunguzi, ati Nawomi, umwe yagaruka avuye mu gihugu c’i Mowabu, agomba kugura itongo ryar’ irya mwene wacu Elimeleki: ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.3",
            "verseOrgIds": [
              "RUT.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "RUT 4:4"
          },
          "items": [
