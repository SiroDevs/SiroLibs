                "loc": "JER.6.16"
              },
              "items": [
                {
                  "text": "Yer 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.42.13"
              },
              "items": [
                {
                  "text": "42:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati Ku vy’ijambo utubariye mw izina ry’Uhoraho ntitukwumvira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.16",
            "verseOrgIds": [
              "JER.44.16"
            ]
          }
        },
