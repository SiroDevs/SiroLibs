              "items": [
                {
                  "text": "Gus 31:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko mwosheje imibavu, mugacumura k’Uhoraho, ntimwumvire Uhoraho, ngo mugendere mu vyagezwe vyiwe, no mu vyo yashinze no mu vyo yihanikirije, ivyo ni vyo vyatumye ibi vyago bibashikako, nk’uko bimeze n’uyu musi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.23",
            "verseOrgIds": [
              "JER.44.23"
            ]
