          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uhereye igihe twarekeye kwosereza imibavu umwamikazi wo mw ijuru, no kumusukira ibiturire, ni ho twaciye duhīndāna, tukamarwa n’inkota n’inzara. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.18",
            "verseOrgIds": [
              "JER.44.18"
            ]
          }
        },
