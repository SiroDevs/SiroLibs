            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba mbahozakw igitsure, ngo mbazanekw ivyago atar’ ivyiza; kand’ abagabo bose b’Abayuda bari mu gihugu ca Egiputa bazoririkwa n’inkota n’inzara, gushitsa baherengeteye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.27",
            "verseOrgIds": [
              "JER.44.27"
            ]
          }
        },
