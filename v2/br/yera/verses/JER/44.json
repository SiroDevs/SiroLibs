            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bigatuma Uhoraho atagishobora kuvyihanganira, kubg’ ibibi vy’ibikorwa vyanyu, no kubg’ ibizira vy’ ubuyobe mwakoze; ivyo ni vyo vyatumye igihugu canyu gihinduka imisaka n’akajoreza n’ikivume, ata wukikibamwo, nk’uko bimeze n’ uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.22",
            "verseOrgIds": [
