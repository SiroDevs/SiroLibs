          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abagabo bose bāri bazi yukw abagore babo bosereza imibavu izindi mana, bo n’abagore bose bahagararanye aho, ar’ ishengero rinini, ni bo bantu bose bagiye kuba mu gihugu ca Egiputa i Patirosi, bishura Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.44.15",
            "verseOrgIds": [
              "JER.44.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 44:16"
          },
          "items": [
