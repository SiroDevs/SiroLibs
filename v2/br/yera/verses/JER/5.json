                "loc": "2CH.16.9"
              },
              "items": [
                {
                  "text": "2 Ngo 16:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwiruke hirya no hino mu nzira z’i Yerusalemu, murondere mwitegereze, mucakare no mu hiyaguye haho, namba mwobona umuntu yoba umugororotsi arondera ivy’ ukuri, nanje nzohaharira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.1",
            "verseOrgIds": [
              "JER.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.1.16"
              },
              "items": [
                {
                  "text": "Tit 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho barahira uguhoraho kw’Uhoraho, n’ukuri barahira ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.2",
            "verseOrgIds": [
              "JER.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.30"
              },
              "items": [
                {
                  "text": "Yer 2:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.28"
              },
              "items": [
                {
                  "text": "7:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.8"
              },
              "items": [
                {
                  "text": "Ezk 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.2"
              },
              "items": [
                {
                  "text": "Zef 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ Uhoraho, inyonga zawe ntizitegereza ivy’ ukuri? Warabakubise, ntibābibabara; warabatūbije, banka guhaha: bākomantaje mu maso habo gusumvya ibuye; banse kugaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.3",
            "verseOrgIds": [
              "JER.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndavuga, nt’ Erega n’ukw ari ba nyarucari: n’ibijuju, kuko batazi inzira y’Uhoraho, ntibamenye n’ukuroranya kw’Imana yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.4",
            "verseOrgIds": [
              "JER.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.3"
              },
              "items": [
                {
                  "text": "Zab 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.1"
              },
              "items": [
                {
                  "text": "Mik 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Reka nje ku bakuru, mvugane na bo; kuko bo bazi inzira y’Uhoraho, n’ukuroranya kw’Imana yabo. Ariko na bo nyene bāhūrije inama hamwe kuvuna ingōgo no gucagagura imvuto. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.5",
            "verseOrgIds": [
              "JER.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.7"
              },
              "items": [
                {
                  "text": "Yer 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.7"
              },
              "items": [
                {
                  "text": "Hos 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAB.1.8"
              },
              "items": [
                {
                  "text": "Hab 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma intambge yo mu kibira izobica, n’ibingira rigendagenda uko buhwibiriye rizobasahura, n’ingwe izotegera ku bisagara vyabo, maz’ ūbisokorokamwo wese atabagurwe; kuk’ ukugabitanya kwabo ari kwinshi, n’ugusubira inyuma kwabo kukaba kurenze urugero. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.6",
            "verseOrgIds": [
              "JER.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.15"
              },
              "items": [
                {
                  "text": "Gus 32:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.23.7"
              },
              "items": [
                {
                  "text": "Yos 23:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.2"
              },
              "items": [
                {
                  "text": "Yer 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega noshobora nte kuguharira? Abana bawe barantaye, bīrahira izitar’ imana; mpejeje kubagaburira bagahāga, bāciye basambana, barema inteko i wabo w’abasambanyikazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.7",
            "verseOrgIds": [
              "JER.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.13.27"
              },
              "items": [
                {
                  "text": "Yer 13:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.22.11"
              },
              "items": [
                {
                  "text": "Ezk 22:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bameze nk’impfizi z’amafarasi ahimvye yiruka irya n’ino, umuntu wese akaroherana, arondera umugore wa mugenzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.8",
            "verseOrgIds": [
              "JER.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.2.2"
              },
              "items": [
                {
                  "text": "Rom 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ivyo ntibizotuma nisidukira? ni k’Uhoraho abaza; mbeg’ ivyo umutima wanje ntuzobihōra ubgoko bumeze burtyo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.9",
            "verseOrgIds": [
              "JER.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.9",
            "verseOrgIds": [
              "JER.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwūrire ku nzitiro zaho, muhonnye; yamara ntimuherengeteze rwose: mukūreh’ amashami yaho, kukw atar’ ay’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.10",
            "verseOrgIds": [
              "JER.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw inzu ya Isirayeli n’inzu ya Yuda zandyarutse rwose, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.11",
            "verseOrgIds": [
              "JER.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.4"
              },
              "items": [
                {
                  "text": "Ita 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.13"
              },
              "items": [
                {
                  "text": "Yer 14:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bīhakanye Uhoraho, ngo Nta we; kandi ngo Nta vyago bizotuzako, nta n’inkota tuzobona cank’ amapfa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.12",
            "verseOrgIds": [
              "JER.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngw Ivy’ abavugishwa n’Imana n’ibitwarwa n’umuyaga, kand’ ijambo ryayo ntiriri muri bo: ngw Ivyo babūra birakaba ari bo bigarukako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.13",
            "verseOrgIds": [
              "JER.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.9"
              },
              "items": [
                {
                  "text": "Yer 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.1.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.6"
              },
              "items": [
                {
                  "text": "Zek 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.11.5"
              },
              "items": [
                {
                  "text": "Ivyah 11:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Uhoraho agize, ni we Mana Nyen’ ingabo, ati Ko bavuga ben’ ayo magambo, ehe ngira mpindure amajambo yanje umuriro mu kanwa kawe, ubu bgoko na bgo ndabuhindure inkwi, ubatongore. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.14",
            "verseOrgIds": [
              "JER.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.49"
              },
              "items": [
                {
                  "text": "Gus 28:49",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.33.19"
              },
              "items": [
                {
                  "text": "Yes 33:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.6.14"
              },
              "items": [
                {
                  "text": "Am 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe ngira mbazanire ihanga rivuye kure, yemwe ab’ inzu ya Isirayeli, ni jewe Uhoraho mbivuze; n’ihanga rihambaye, n’ihanga ryamyeho kera, n’ihanga rivuga ururimi mutazi, mutoshobora no kwumva ico rivuga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.15",
            "verseOrgIds": [
              "JER.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.28"
              },
              "items": [
                {
                  "text": "Yes 5:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutana wabo ni nk’imva irangaye, bose n’abantu b’abahizi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.16",
            "verseOrgIds": [
              "JER.5.16"
            ]
          }
        },
        {
