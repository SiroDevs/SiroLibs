              "type": "text"
            }
          ]
        },
        {
          "text": "Muti Kuko mu bantu biwe habonekamw’ abantu b’abanyakibi: baratega nk’ukw abatezi b’inyoni batega; batega umutego, bagafata abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.26",
            "verseOrgIds": [
