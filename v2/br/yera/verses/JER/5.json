              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ukw igisamba cokwuzuzwa izo nyoni, ni kw amazu yabo yuzuyemw’ ibigungano: ni co catumye bacika abahambaye, bakaba abatunzi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.5.27",
            "verseOrgIds": [
