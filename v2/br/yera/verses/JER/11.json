              "items": [
                {
                  "text": "Ezk 20:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahindukiriye ibigabitanyo vya ba sekuruza bāhora banka kwumva amajambo yanje; bakurikiye izindi mana ngw abe ari zo basaba: ab’ inzu ya Isirayeli n’ab’ inzu ya Yuda bishe isezerano ryanje nasezeranye na ba sekuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
              "JER.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.28"
              },
              "items": [
                {
                  "text": "Imig 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.18"
              },
              "items": [
                {
                  "text": "Ezk 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero nzobazanakw ivyago batazoshobora gukira, ni jewe Uhoraho mbivuze; bazontakambira, ariko sinzobumva. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.28"
              },
              "items": [
                {
                  "text": "Yer 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ibisagara vy’i Buyuda n’ababa i Yerusalemu bazogenda gutakambira imana bāhora bosereza imibavu: ariko ntizizobakiza na gatoya mu gihe c’ivyago vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.10"
              },
              "items": [
                {
                  "text": "Hos 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ibisagara vyawe bingana, ewe Buyuda, ari kw izo mana zawe zingana: kandi nk’ukw inzira zo muri Yerusalemu zingana ni ko mwagiye mushirah’ ibicaniro mubishiriyeho bga buyobe bganyu, ni vyo bicaniro vyo kwoserezakw imibavu Bayali. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.16"
              },
              "items": [
                {
                  "text": "Yer 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ntusengere ubu bgoko, ntubītwarire canke ng’ ubasabire; kuko ntazobumva igihe bazontakambira babonye ivyago vyabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
              "JER.11.14"
            ]
          }
        }
      ]
    },
