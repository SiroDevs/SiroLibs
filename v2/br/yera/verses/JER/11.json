              "type": "text"
            }
          ]
        },
        {
          "text": "iryo nihanikirije ba sogokuruza ku musi nabakūriye mu gihugu ca Egiputa, muri rya tanure rivugutira ivyuma, nti Ni munyumvire, mukore vyose ivyo mbagera: uko ni ko muzoba abantu banje, nanje nzoba Imana yanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.4",
            "verseOrgIds": [
              "JER.11.4"
            ]
          }
        },
