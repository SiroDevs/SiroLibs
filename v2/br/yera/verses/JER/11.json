            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Ni mwumve amajambo y’iri sezerano, muvugane n’abagabo b’i Buyuda n’ababa i Yerusalemu; ",
          "type": "text",
