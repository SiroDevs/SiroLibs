              "type": "text"
            }
          ]
        },
        {
          "text": "uku ni k’Uhoraho Nyen’ ingabo agize rero, at’ Ehe nzobāzira: imisore yabo izokwicwa n’inkota; abahungu babo n’abakobga babo bazokwicwa n’inzara; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
