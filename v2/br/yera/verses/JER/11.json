        },
        {
          "text": "kugira ngo mbone gushitsa indahiro narahiye ba sogokuruza, yuko nzobaha igihugu gitemba amata n’ubūki, nk’uko bimeze uyu musi. Nuko ndishura, nti Amen, Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
