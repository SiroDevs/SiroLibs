        },
        {
          "text": "Zedekiya mwene Yosiya aja ku ngoma mu gishingo ca Koniya mwene Yehoyakimu, Nebukadineza umwami w’i Babuloni ari we amwimitse mu gihugu c’i Buyuda. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.1",
            "verseOrgIds": [
              "JER.37.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.12+2CH.36.13+2CH.36.14"
              },
              "items": [
                {
                  "text": "2 Ngo 36:12-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntiyumvira amajambo y’Uhoraho ayo yavugisha Yeremiya, ubgiwe cank’ abasavyi biwe cank’ abantu bo mu gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.2",
            "verseOrgIds": [
              "JER.37.2"
            ]
          }
        }
      ]
