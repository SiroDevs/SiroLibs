            }
          ]
        },
        {
          "text": "Maz’ umwami Zedekiya atuma Yehukali mwene Shelemiya na Zefaniya mwene Mayaseya umuherezi kuri Yeremiya uwavugishwa n’Imana, ati N’udusengere k’Uhoraho Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.3",
            "verseOrgIds": [
              "JER.37.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
