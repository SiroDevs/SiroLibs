            }
          ]
        },
        {
          "text": "Nuko Yeremiya amaze gushika mw ibohero, mu kazu ko mu kuzimu, ahamaze imisi myinshi, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.16",
            "verseOrgIds": [
              "JER.37.16"
            ]
