        },
        {
          "text": "Nukw ingabo z’Abakaludaya zimaze gukimirana zitaye i Yerusalemu kubgo kugirira ubgoba ingabo za Farawo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.37.11",
            "verseOrgIds": [
              "JER.37.11"
            ]
          }
        },
