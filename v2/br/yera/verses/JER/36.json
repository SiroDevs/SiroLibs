            {
              "text": "46:1—51:64.",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Abīra umuzingo w’igitabo, wandikemw’ amajambo yose nakubariye abūrira Abisirayeli n’Abayuda n’amahanga yose, utanguye umusi nakubaririye, uhereye ku ngoma ya Yosiya, ugashitsa no kur’ uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.2",
            "verseOrgIds": [
              "JER.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 36:3"
          },
