              },
              "items": [
                {
                  "text": "Ezk 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbure ab’ inzu ya Yuda bokwumva ivyago vyose nageneye kubatēza, bagahindukira, umuntu wese akava mu nzira yiwe mbi, kugira ngo mbone guharira ukugabitanya kwabo n’icaha cabo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.3",
            "verseOrgIds": [
              "JER.36.3"
            ]
          }
        }
