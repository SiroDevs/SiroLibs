              },
              "items": [
                {
                  "text": "Yer 32:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yeremiya ahamagara Baruki mwene Neriya; maze Baruki yandika amajambo yose y’ Uhoraho mu muzingo w’igitabo, ayakūye mu kanwa ka Yeremiya, ukw ayamubgiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.4",
            "verseOrgIds": [
              "JER.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.2"
              },
              "items": [
                {
                  "text": "Yer 32:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yeremiya abarira Baruki, ati Jewe ndabujijwe kuja mu ngoro y’ Uhoraho: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.5",
            "verseOrgIds": [
              "JER.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero wewe genda usome mur’ uwo muzingo amajambo y’Uhoraho wanditse ukūye mu kanwa kanje, uyasomere abantu mu ngoro y’Uhoraho ku musi wo kwisonzesha: uyasomere n’Abayuda bose baza bavuye mu bisagara vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.6",
            "verseOrgIds": [
              "JER.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbure bokwitwara k’Uhoraho, bagahindukira, umuntu wese akareka inzira yiwe mbi: kuk’ uburake n’ubushangashirwe, ivyo Uhoraho yabūye kur’ ubu bgoko, ar’ ibihambaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.7",
            "verseOrgIds": [
              "JER.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Baruki mwene Neriya akora vyose nk’uk’ ūvugishwa n’Imana Yeremiya yamubariye, asoma mur’ ico gitabo amajambo y’Uhoraho ahagaze mu ngoro y’Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.36.8",
            "verseOrgIds": [
              "JER.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
