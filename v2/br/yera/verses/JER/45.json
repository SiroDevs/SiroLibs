            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Wavuze, uti Mbonye ibara, kuk’ Uhoraho yongereje intuntu ku mubabaro wanje! Kuniha kurandambiye, simbona akaruhuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.3",
            "verseOrgIds": [
              "JER.45.3"
            ]
