          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Uku ni k’Uhoraho akubariye, ni we Mana y’Abisirayeli, wewe Baruki: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.2",
