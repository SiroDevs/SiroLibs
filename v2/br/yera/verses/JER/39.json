            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Genda ubarire Ebedumeleki Umunyetiyopiya, ut’ Uku ni k’Uhoraho Nyen’ ingabo agize, ni we Mana y’Abisirayeli, ati Rāba ngira nshitse kur’ iki gisagara ayo nakivuzeko y’ivyago, atar’ ay’ ivyiza; kandi bizoshika uvyibonera kuri nya musi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.16",
            "verseOrgIds": [
              "JER.39.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 39:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko weho nzokurokora kur’ uwo musi, ni jewe Uhoraho mbivuze: kandi ntuzotangwa mu maboko y’abo utinya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.17",
            "verseOrgIds": [
              "JER.39.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
