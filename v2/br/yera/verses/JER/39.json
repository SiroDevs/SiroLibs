            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ijambo ry’Uhoraho ryari ryaje kuri Yeremiya, igihe yar’ acugaraniwe mu rugo rw’ ibohero, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.39.15",
