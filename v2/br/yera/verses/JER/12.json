              "items": [
                {
                  "text": "6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abungere benshi bāhanyaguye uruzabibu rwanje, bāsiribanze umugabane wanje, umugabane wanje w’igikundiro bāwuciye ubugaragwa bg’ibitongozi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.10",
            "verseOrgIds": [
              "JER.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.42.25"
              },
              "items": [
                {
                  "text": "Yes 42:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bāhagize amatongo; haramborogera, kuko habaye ibitongozi; igihugu cose n’amatongo, kukw ata wigeze kubishirak’ umutima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.11",
            "verseOrgIds": [
              "JER.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyazi baserutse ku mpinga zose mu ruharabuga: kukw inkota y’Uhoraho iriritse, uhereye ku mpera y’igihugu ugashitsa ku yindi: nta muntu n’umwe afise amahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.12",
            "verseOrgIds": [
              "JER.12.12"
            ]
          }
        },
