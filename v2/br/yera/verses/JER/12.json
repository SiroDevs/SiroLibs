        },
        {
          "text": "Ewe Uhoraho, iyo nkubūranije uboneka k’ugororotse; yamara na ho nyene nogomvye ko dusiguzanya: mbeg’ igituma abanyakibi bagenda bagubga neza mu kubaho kwabo n’iki? N’iki gituma abaryarukanyi bose bidibamira ngaho? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.1",
            "verseOrgIds": [
              "JER.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 12:2"
          },
          "items": [
