            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahevye inzu yanje, nataye ishamvu yanje; narekuriye inkundwakazi y’umutima wanje mu maboko y’abansi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.7",
            "verseOrgIds": [
              "JER.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishamvu yanje yampindukiye nk’intambge yo mu kibira: irantontomeye, ni co gitumye ndayanka. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.8",
            "verseOrgIds": [
              "JER.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.9"
              },
              "items": [
                {
                  "text": "Yes 56:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.33"
              },
              "items": [
                {
                  "text": "Yer 7:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.39.17"
              },
              "items": [
                {
                  "text": "Ezk 39:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ishamvu yanje ntiyampindukiye nk’ igisīga c’amabara y’uruyoberane? Mbeg’ ibindi bisīga ntivyagikonganije impande zose? Ni mugende mukoranye ibikōko vyo mw ishamba vyose, mubizane bikākagure. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.9",
            "verseOrgIds": [
              "JER.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
