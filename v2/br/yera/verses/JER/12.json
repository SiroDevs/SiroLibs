            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.63.18"
              },
              "items": [
                {
                  "text": "Yes 63:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.8"
              },
              "items": [
                {
                  "text": "Yer 2:8",
