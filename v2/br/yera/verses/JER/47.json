                {
                  "text": "Am 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.9.7"
              },
              "items": [
                {
                  "text": "9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ umusi ugira uze wo kuzonyagwako kw’Abafilisitiya bose, wo kuzorandura umutabazi wese azoba agisigaye muri Tiro n’i Sidoni: kuk’ Uhoraho azonyaga Abafilisitiya, n’amasigarira yo ku kizinga co mu kiyaga citwa Kafutori. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.4",
            "verseOrgIds": [
              "JER.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.37"
              },
              "items": [
                {
                  "text": "Yer 48:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Gaza hasigaye ar’ uruharabuga; Ashikeloni harakomvomvowe, bo n’amasigarira yo mu kiyaya caho: uzokwikebagura ushitse ryari? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.5",
            "verseOrgIds": [
              "JER.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.41"
              },
              "items": [
                {
                  "text": "Gus 32:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Weho wa nkota y’Uhoraho, uzogeza ryari kutaruhuka? Enda ni wisubize mu rwubati rwawe, utekereze, ugume hamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.6",
            "verseOrgIds": [
              "JER.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 47:7"
          },
          "items": [
