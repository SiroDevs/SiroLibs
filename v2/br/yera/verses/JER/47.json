                "loc": "JOL.3.4"
              },
              "items": [
                {
                  "text": "Yow 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.8"
