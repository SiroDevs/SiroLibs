        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.46.5"
              },
              "items": [
                {
                  "text": "Yer 46:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.2"
              },
              "items": [
                {
                  "text": "Nah 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bumvise kudida imigere kw’amafarasi yiwe ahambaye, n’ukugenda akabushungwe kw’ imikogote yiwe, n’uguhinda kw’ amakurudumu, bituma abavyeyi batanakebuka ngo barābe abana babo kubgo gucika inkokora; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.3",
            "verseOrgIds": [
              "JER.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
