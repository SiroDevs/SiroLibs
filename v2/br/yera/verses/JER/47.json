              "items": [
                {
                  "text": "Yes 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, at’ Eh’ amazi azodudubiza avuye i burārūko ahinduke uruzi rudengereye, ruzodengera rurenge ku gihugu no ku birimwo vyose, rurenge ku gisagara no ku bakibamwo bose: abantu bazotaka, n’ ababa mu gihugu bose bazoboroga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.47.2",
            "verseOrgIds": [
              "JER.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
