              "JER.38.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami Zedekiya aratuma, bamuzanira Yeremiya umuvugishwa, bamumusanza imbere mw irebe rya gatatu ryo mu ngoro y’ Uhoraho: maz’ umwami abarira Yeremiya, ati Har’ ico nkubaza: ntugire ico umpisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.14",
            "verseOrgIds": [
              "JER.38.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yeremiya abarira Zedekiya, ati Ni nakikubarira, wobura kunyica? Kandi ni nakugīra inama, na ho nyene ntiwonyumva. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.15",
            "verseOrgIds": [
              "JER.38.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.16"
              },
              "items": [
                {
                  "text": "Yes 57:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.17"
              },
              "items": [
                {
                  "text": "Yer 37:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.1+JER.38.2+JER.38.3+JER.38.4+JER.38.5+JER.38.6+JER.38.7+JER.38.8+JER.38.9"
              },
              "items": [
                {
                  "text": "38:1-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami Zedekiya arahirira Yeremiya mu mpisho, ati Nk’uk’ Uhoraho ahoraho, ari we yandemeye uyu mutima, sinkwica, kandi singutanga mu maboko y’abo bantu barondera kukwica. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.16",
            "verseOrgIds": [
              "JER.38.16"
            ]
          }
        },
        {
