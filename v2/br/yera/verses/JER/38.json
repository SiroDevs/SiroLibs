                "loc": "JER.39.3"
              },
              "items": [
                {
                  "text": "39:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yeremiya abarira Zedekiya, at’ Uku ni k’Uhoraho agize, ni we Mana Nyen’ ingabo, Imana y’Abisirayeli, ati Ni wagenda ukīsaba abaganwa b’umwami w’i Babuloni, uzokwikiza, kand’ iki gisagara ntikizotongozwa umuriro; nawe uzobona kubaho, n’abo mu nzu yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.17",
            "verseOrgIds": [
              "JER.38.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko n’utemera kwīsaba abaganwa b’umwami w’i Babuloni, iki gisagara kizotangwa mu maboko y’Abakaludaya, kandi bazogitongoza umuriro, nawe ntuzokwikiza ng’ uve mu maboko yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.18",
            "verseOrgIds": [
              "JER.38.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 38:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.4"
              },
              "items": [
                {
                  "text": "1 Sam 31:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami Zedekiya yishura Yeremiya, ati Ntinya Abayuda bāmaze kwisaba Abakaludaya, kuko bobampa bakanshinyagurira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.19",
            "verseOrgIds": [
              "JER.38.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 38:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya aramwishura, ati Ntibazobaguha. Ndakwinginze, wumvire Uhoraho mur’ ivyo nkubariye: ni ho uzomererwa neza, ukikiza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.20",
            "verseOrgIds": [
              "JER.38.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 38:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.12"
              },
              "items": [
                {
                  "text": "Yer 27:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.27.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni wanka kugenda, iri ni ryo jambo Uhoraho yanyeretse: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.21",
            "verseOrgIds": [
              "JER.38.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 38:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.20.10"
              },
              "items": [
                {
                  "text": "Yer 20:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Rāba abagore bose basigaye mu rugo rw’umwami w’i Buyuda, bazokūrwayo bahabge abaganwa b’umwami w’i Babuloni, kand’ abo bagore bazovuga, bat’ Abakunzi bawe pfampfe bāraguhenze, uja na rwo: arikw ibirenge vyawe bimaze gushaya mu kivurugu c’ivyondo, barakimirana. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.22",
            "verseOrgIds": [
              "JER.38.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 38:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.6"
              },
              "items": [
                {
                  "text": "Yer 39:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.10"
              },
              "items": [
                {
                  "text": "41:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bazosohora abamikazi bawe bose n’abana bawe babahe Abakaludaya: nawe ntuzokwikiza ng’ uve mu maboko yabo, arik’ uzofatwa n’ukuboko kw’umwami w’i Babuloni: kandi ni wewe uzoba uzaniye iki gisagara gutongozwa umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.23",
            "verseOrgIds": [
              "JER.38.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 38:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Zedekiya abarira Yeremiya, ati Ntihakagire umuntu agira ico amenya kur’ ayo majambo; ni ho utopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.24",
            "verseOrgIds": [
              "JER.38.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 38:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abaganwa ni baramuka bumvise ko twavuganye, bakaza bakakubarira, bati Twīgānire ivyo wabariye umwami, ntuduhishe, natwe ntitukwica, bati Tubgire n’ivyo umwami yakwishuye: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.25",
            "verseOrgIds": [
              "JER.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.20"
              },
              "items": [
                {
                  "text": "Yer 37:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uz’ ubabgire, uti Nari kwinginga umwami ngo yoye kunsubiza mu nzu kwa Yonatani, ngo ngweyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.26",
            "verseOrgIds": [
              "JER.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abaganwa bose baza kuri Yeremiya, barabimubaza: na we abishura amajambo yose nk’uk’ umwami yamubariye. Baca baramureka, barīgīra, kukw ayo majambo yabaye akabanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.27",
            "verseOrgIds": [
              "JER.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.2"
              },
              "items": [
                {
                  "text": "Yer 32:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yeremiya aba mu rugo rw’ibohero, gushitsa umusi Yerusalemu hatsinzwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.38.28",
            "verseOrgIds": [
              "JER.38.28"
            ]
          }
