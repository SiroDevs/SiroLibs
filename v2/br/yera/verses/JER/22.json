                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ubeshejwe ku ngoma n’uk’ urushije abandi kwubakisha amasederi? Mbega so ntiyabonye gufungura no kwuhira? Yamara we yaciye iziroranye n’izibereye; maze yibereye amahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.15",
            "verseOrgIds": [
              "JER.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 22:16"
          },
          "items": [
