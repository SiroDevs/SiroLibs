                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.8"
              },
              "items": [
                {
                  "text": "Hos 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ uyu Koniya n’urwavya rukēngērwa rusāvye? N’urwavya rudahimbaye? N’iki catumye bashiburwa, bashiburirwa mu gihugu batazi? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.28",
            "verseOrgIds": [
              "JER.22.28"
            ]
          }
        },
