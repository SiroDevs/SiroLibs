          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "akavuga, ati Hinge niyubakire inzu nini n’ivyumba vyagutse, akayicamw’ amadirisha; akayishiramw’ insenge z’amasederi, akazisīga irangi ritukura. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.14",
            "verseOrgIds": [
