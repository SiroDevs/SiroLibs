              "items": [
                {
                  "text": "34:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, uku ni k’Uhoraho agize ku vya Yehoyakimu mwene Yosiya umwami w’i Buyuda, ati Ntibazomuborogera, bat’ Ewe musazanje! Ewe mwana wa mama! Ntibazomuborogera, bat’ Ewe mwami wanje! Ewe cubahiro ciwe! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.18",
            "verseOrgIds": [
              "JER.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
