                "loc": "PRO.31.9"
              },
              "items": [
                {
                  "text": "Imig 31:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaciriye urubanza umworo n’umukene; maze hakaba amahoro. Mbeg’ ivyo si kwo kummenya kw’ukuri? ni jewe Uhoraho mbibajije. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.16",
            "verseOrgIds": [
              "JER.22.16"
            ]
          }
        },
        {
