                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzogushiburana na nyoko yakuvyaye, mbashiburire mu kindi gihugu, aho mutāvukiye; aho ni ho muzogwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.26",
            "verseOrgIds": [
              "JER.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.44.14"
              },
              "items": [
                {
                  "text": "Yer 44:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw igihugu imitima yabo yifuza kugarukamwo, ntibazokigarukamwo na mba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.27",
            "verseOrgIds": [
              "JER.22.27"
            ]
          }
        },
