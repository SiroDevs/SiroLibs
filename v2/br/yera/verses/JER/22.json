        },
        {
          "text": "Uku ni k’Uhoraho agize, ati Manuka uje ku ngoro y’ umwami w’i Buyuda, uhavugire iri jambo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.1",
            "verseOrgIds": [
              "JER.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Ni wumve ijambo ry’ Uhoraho, yewe mwami w’i Buyuda, uri ku ngoma ya Dawidi, wewe n’abasavyi bawe, n’abaca mur’ aya marembo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.2",
            "verseOrgIds": [
              "JER.22.2"
            ]
          }
        },
        {
