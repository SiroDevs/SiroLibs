                  "text": "Ezk 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ku vya Shalumu mwene Yosiya umwami w’i Buyuda, yasubiye ku ngoma ya se Yosiya, yavuye aha hantu akagenda mazimayongo: ntazosubira kugaruka ino ukundi, ni jewe Uhoraho mbivuze; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.11",
            "verseOrgIds": [
              "JER.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw iyo bāmushorereye ar’ inyagano ni yo azogwa, kandi ntazosubira kubona iki gihugu ukundi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.12",
            "verseOrgIds": [
              "JER.22.12"
            ]
          }
        }
