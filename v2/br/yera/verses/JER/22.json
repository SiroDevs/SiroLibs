              "items": [
                {
                  "text": "Ezk 22:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko weho amaso yawe n’umutima wawe nta handi bitumbereye atar’ ukwifuza inyungu mbi, no kuvisha amaraso y’abatācumuye, no guhahaza, n’umuryano. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.17",
            "verseOrgIds": [
              "JER.22.17"
            ]
          }
        },
