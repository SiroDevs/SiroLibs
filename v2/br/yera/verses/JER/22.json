                "loc": "JER.3.1"
              },
              "items": [
                {
                  "text": "Yer 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dūga i Lebanoni, utake; shira ijwi hejuru ur’ i Bashani; taka uhagaze ahitwa Abarimu; kukw abūzure bawe bose bageseye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.20",
            "verseOrgIds": [
              "JER.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuganye nawe igihe war’ umerewe neza, arik’ uravuga, uti Sinduha ndavyumva. Iyo ni yo ngeso yawe uhereye mu buto bgawe, yo kutanyumvira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.21",
            "verseOrgIds": [
              "JER.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.25"
              },
              "items": [
                {
                  "text": "Yer 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.10"
              },
              "items": [
                {
                  "text": "Ezk 34:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuyaga ni wo uzoragira abungere bākuragira bose, kand’ abūzure bawe bazoja mu mugozi: bibaye birtyo ntuzobura gutētērwa no kumāramāra kubg’ ibibi vyawe vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.22",
            "verseOrgIds": [
              "JER.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
