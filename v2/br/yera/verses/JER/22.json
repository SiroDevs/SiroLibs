          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.2"
              },
              "items": [
                {
                  "text": "Yer 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.36.30"
              },
              "items": [
                {
                  "text": "36:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azotabga nk’uko bata indogoba, bamukweze bamushiburiye inyuma y’ibirimba vy’i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.19",
            "verseOrgIds": [
              "JER.22.19"
            ]
          }
        }
      ]
