              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.2"
              },
              "items": [
                {
                  "text": "Yes 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe wa gihugu we, wa gihugu we, wa gihugu we, ni wumve ijambo ry’Uhoraho! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.22.29",
            "verseOrgIds": [
              "JER.22.29"
            ]
