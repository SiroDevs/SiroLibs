              "items": [
                {
                  "text": "46:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ azoza atere igihugu ca Egiputa; abagerewe kwicwa bazoja kwicwa, abagerewe umugozi bazoja mu mugozi, abagerewe inkota bazoja ku nkota. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.43.11",
            "verseOrgIds": [
              "JER.43.11"
            ]
          }
        },
