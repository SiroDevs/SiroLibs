                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abūzure bawe bose barakwibagiye; ntibakikubabaye; kuko ngukomerekeje nk’ūkomerekejwe n’umwansi, ngukubise bga ruburakigongwe; ni kubg’ ibigabitanyo vyawe vyinshi, kukw ivyaha vyawe vyari vyiyongeranije. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.14",
            "verseOrgIds": [
              "JER.30.14"
            ]
          }
        },
        {
