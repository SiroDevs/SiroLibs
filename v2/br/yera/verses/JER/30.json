              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni yo majambo Uhoraho yavuze ku Bisirayeli n’Abayuda: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.4",
            "verseOrgIds": [
              "JER.30.4"
            ]
