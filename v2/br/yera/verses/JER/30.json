              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana babo bazomera nk’uko bār’ ubga mbere, kand’ ikoraniro ryabo rizokomezwa imbere yanje, nanje nzohana abābahahaza bose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.20",
