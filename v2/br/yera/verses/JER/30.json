          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Uku ni ko mbivuze, jewe Uhoraho, nti Twumvise ijwi ry’ abari mu gatengo no mu bgoba, atar’ iry’ abari mu mahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.5",
