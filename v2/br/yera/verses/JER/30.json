            "number": "7",
            "style": "v",
            "sid": "JER 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ew’ amagorwa ari hano! Kuk’ uwo musi uhambaye, nta wuhwanye na wo: n’igihe c’umubabaro wa ba Yakobo; yamara bazogikizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        },
