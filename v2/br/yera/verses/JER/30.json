            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ndabivuze, jewe Uhoraho, nti Rāba nzotuma abo mu mahema ya Yakobo bahindukira, bave mu ngoyi zabo, ngirire ikigongwe amazu yabo; kand’ igisagara kizokwubakwa mu bitongozi vyaho, n’ ingoro isubire kumera nk’uko yahora. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.18",
            "verseOrgIds": [
              "JER.30.18"
            ]
          }
        },
