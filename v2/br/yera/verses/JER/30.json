            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta wo kukwitsa ariho, kugira ng’ upfukwe igikomere: nta n’imiti ufise yo kukuvūra. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.13",
