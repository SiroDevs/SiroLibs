            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.24"
              },
              "items": [
                {
                  "text": "Yer 10:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ndi kumwe nawe, ni jewe Uhoraho mbivuze, kugira ngo ngukize; kuko nzoherengeteza amahanga yose, ayo nagushwiragirijemwo: ariko weho sinzoguherengeteza; mugabo nzogubana ibigeze, sinzokureka ntaguhannye.",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.11",
            "verseOrgIds": [
              "JER.30.11"
            ]
          }
        }
