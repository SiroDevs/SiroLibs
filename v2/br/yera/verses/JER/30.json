                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kur’ uwo musi, ni jewe Uhoraho Nyen’ ingabo mbivuze, nzovuna ingōgo bambitswe, ndayikūre kw izosi ryabo, ncagagure imvuto baboheshejwe; kandi ntibazoba bakijakarira amahanga: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
