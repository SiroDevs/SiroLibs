            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari ko mvuze, jewe Uhoraho, nt’ Igikomere cawe ntikivūrika, n’igisebe cawe n’ ikigoye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.12",
