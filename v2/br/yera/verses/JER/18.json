            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Uhoraho agize, at’ Enda ni mubaze mu mahanga ko hoba har’ uwumvise ibimeze birtyo; inkumi, ni yo Bisirayeli, yakoze ibibi vy’ubuyobe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.13",
            "verseOrgIds": [
              "JER.18.13"
            ]
          }
        },
        {
