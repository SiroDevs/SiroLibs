                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ iryo hanga navuzeko ryohindukira rikareka ibibi vyaryo, nanje nzokwigarura ndeke ibibi nari namaramaje kuzobakorera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.8",
            "verseOrgIds": [
              "JER.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikindi gihe novuga ku vy’ihanga no ku vy’ubgami, ku vyo kuzoryubaka no kuzoritēragira: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.9",
            "verseOrgIds": [
              "JER.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze ni ryakora ibibi mu nyonga zanje, ntiryumvire ijwi ryanje, nuko nanje nzogarwa, ndeke ivyiza nari namaramaje kuzobagirira neza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.10",
            "verseOrgIds": [
              "JER.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.13"
              },
              "items": [
                {
                  "text": "2 Abam 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.35.15"
              },
              "items": [
                {
                  "text": "Yer 35:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rer’ ubarire abagabo b’i Buyuda n’ababa i Yerusalemu, ut’ Uku ni k’Uhoraho agize, at’ Ehe mbagereye ikibi, nīgīriye imigabo y’ivyo nzobagirira: enda ni mugaruke, umuntu wese ave mu nzira yiwe mbi, mutunganye inzira zanyu n’ ingeso zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.11",
            "verseOrgIds": [
              "JER.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.25"
              },
              "items": [
                {
                  "text": "Yer 2:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.17"
              },
              "items": [
                {
                  "text": "3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bo baravuga, bati N’utwiziguruke, kuko twebge tugomba gukurikira imigabo yacu ubgacu, kand’ umuntu wese muri twebge agomba gukora nk’uk’ ubudadarare bg’umutima wiwe mubi bumeze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.12",
            "verseOrgIds": [
              "JER.18.12"
            ]
          }
        }
      ]
    },
