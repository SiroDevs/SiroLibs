          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijambo ry’Uhoraho rinzako, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.5",
            "verseOrgIds": [
              "JER.18.5"
            ]
