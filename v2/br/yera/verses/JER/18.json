          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega shelegi",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:14",
              "type": "text"
            },
            {
              "text": "shelegi n’ikintu coroshe cera, gikoroka hasi nk’imvura, gikanye cane.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’i Lebanoni yoreka kugwa kuri vya bitandara vyaho vyibonekeza mu gihugu? Cank’ amazi yayo atimvye atemba ava kure yokamuka? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.18.14",
            "verseOrgIds": [
              "JER.18.14"
            ]
          }
        },
