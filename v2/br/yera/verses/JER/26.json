              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abaherezi na ba kamenyi n’ abantu bose bumva Yeremiya avugira ayo majambo yose mu ngoro y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.7",
            "verseOrgIds": [
              "JER.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yeremiya aheraheje kuvuga vyose Uhoraho yamugeze kubarira abantu bose, abaherezi n’abo ba kamenyi n’ abantu bose baramufata, bati Ntugenda udapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.8",
            "verseOrgIds": [
              "JER.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’iki kikuvugisha mw izina ry’Uhoraho ngw Iyi ngoro izomera nk’i Shilo, ngo N’iki gisagara kizoba amatongo, ata wukikibamwo? Nukw abantu bose bakoranira kuri Yeremiya mu ngoro y’Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.9",
            "verseOrgIds": [
              "JER.26.9"
            ]
          }
        }
      ]
    },
    {
