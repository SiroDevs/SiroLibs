              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuk’ umwami Yehoyakimu atuma abantu muri Egiputa, ni bo Elunatani mwene Akabori n’abandi bagabo bamwe bajanye na we muri Egiputa; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.22",
            "verseOrgIds": [
