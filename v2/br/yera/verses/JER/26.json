                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abaganwa b’i Buyuda bumvise ivyo, baradūga bavuye mu ngoro i bgami, baja ku ngoro y’ Uhoraho; bicara mw ishikiro ku kirimba gisha c’urugo rw’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.10",
            "verseOrgIds": [
              "JER.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.38.4"
              },
              "items": [
                {
                  "text": "Yer 38:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abaherezi na ba kamenyi babarira abaganwa n’abantu bose, bat’ Uyu muntu akwiye gupfa; kukw ataze ibibi kur’ iki gisagara, nk’uko mwiyumviye n’amatwi yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.11",
            "verseOrgIds": [
              "JER.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yeremiya abarira abaganwa bose n’abantu bose, at’ Uhoraho ni we yantumye kubūrira kur’ iyi ngoro no kur’ iki gisagara amajambo yose mwumvise. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.12",
            "verseOrgIds": [
              "JER.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.2"
              },
              "items": [
                {
                  "text": "Gus 30:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.3"
              },
              "items": [
                {
                  "text": "Yer 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.3"
              },
              "items": [
                {
                  "text": "26:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mutunganye ingeso zanyu n’ibikorwa vyanyu, mwumvire Uhoraho Imana yanyu; maz’ Uhoraho azokwigarura areke ibibi yar’ abageneye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.13",
            "verseOrgIds": [
              "JER.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko jeho ndi mu maboko yanyu: mungire nk’uko mubona ko bikwiye kandi bibereye mu maso yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.14",
            "verseOrgIds": [
              "JER.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.24"
              },
              "items": [
                {
                  "text": "Mat 27:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwe gusa, mumenye rwose ni mwanyica, ko muzoba mwizanyekw amaraso y’ ūtācumye, azoba kuri mwebge ubganyu no kur’ iki gisagara no ku bakibamwo: kuko vy’ukuri Uhoraho ni we yabantumyeko kuvugira ayo majambo yose mu matwi yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.15",
            "verseOrgIds": [
              "JER.26.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
