            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.12"
              },
              "items": [
                {
                  "text": "Yer 7:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.9"
              },
              "items": [
                {
                  "text": "24:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo Ni ho azohindura iyi ngoro kuba nk’i Shilo, kandi n’iki gisagara ngw Azogihindura ikivume ku mahanga yose yo mw isi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.6",
            "verseOrgIds": [
              "JER.26.6"
            ]
          }
        }
