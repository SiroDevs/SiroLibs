        },
        {
          "text": "Mu matangura yo kuba ku ngoma kwa Yehoyakimu mwene Yosiya umwami w’Abayuda, haza iri jambo rivuye k’ Uhoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.1",
            "verseOrgIds": [
              "JER.26.1"
            ]
          }
        },
        {
