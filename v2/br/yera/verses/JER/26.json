                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.27"
              },
              "items": [
                {
                  "text": "Ivyak 20:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uku ni k’Uhoraho agize, ati Hagarara mu nyubakwa y’ingoro yanje Uhoraho, ubarire ab’ibisagara vyose vy’i Buyuda baza gusenga mu ngoro yanje, amajambo yose nkubarira yo kubabgira: ntusige na rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.2",
            "verseOrgIds": [
              "JER.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.8"
              },
              "items": [
                {
                  "text": "Yer 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.36.3"
              },
              "items": [
                {
                  "text": "36:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbure bohava bumva, umuntu wese agahindukira akareka inzira yiwe mbi, ngo nanje mbone kwigarura, ndeke ibibi mmaramaje kubakorera kubg’ ibibi vy’ibikorwa vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.3",
            "verseOrgIds": [
              "JER.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.14"
              },
              "items": [
                {
                  "text": "Lew 26:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ubabarire, ut’ Uku ni k’Uhoraho agize, ati Ni mwanka kumutega amatwi, ngo mugendere mu vyagezwe vyiwe yabashize imbere, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.26.4",
            "verseOrgIds": [
              "JER.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.3"
              },
              "items": [
                {
                  "text": "Yer 25:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.4"
              },
