                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mwebge, ntimuruhe mwumvira ba kamenyi banyu, cank’ abapfumu banyu, cank’ inzozi zanyu, cank’ abamenyi banyu, cank’ abarozi banyu, bababarira, bati Ntimuzoruha musaba umwami w’i Babuloni: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko babaragurira ibinyoma, kugira ngo mwambukanwe kure y’igihugu canyu, no kugira ngo nanje ndakibirukanemwo, muhone. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ihanga rizogondera izosi umwami w’i Babuloni, rikamusaba, iryo nzoryemerera kuguma mu gihugu cabo bgite, ni jewe Uhoraho mbivuze; bazokirima, bakibemwo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
