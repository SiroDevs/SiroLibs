        },
        {
          "text": "Kandi non’ ibi bihugu vyose mbishize mu kuboko kwa Nebukadineza umwami w’i Babuloni, umusavyi wanje; ndamuhaye n’ibikōko vyo ku misozi kumukorera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
