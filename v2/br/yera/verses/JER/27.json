                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mbarira Zedekiya umwami w’i Buyuda nk’ukw ayo majambo yose ameze, nti Ni mugondere izosi ingōgo y’umwami w’i Babuloni, mumusabe, musabe n’abantu biwe, mubone kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.31"
              },
              "items": [
                {
                  "text": "Ezk 18:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugombera iki gupfa, wewe n’abantu bawe, ngo mwicishwe inkota n’inzara n’ikīza, nk’uk’ Uhoraho yavuze kw ihanga ritazokwemera gusaba umwami w’i Babuloni? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuruhe mwumvira amagambo ya ba kamenyi bababarira, bati Ntimuzoruha musaba umwami w’i Babuloni: kuko babaragurira ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ Uhoraho avuze kw atari we yabatumye, ariko bavuga ibinyoma mw izina ryiwe; kugira ngw abirukane, muhone, mwe n’ abo ba kamenyi babaragurira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.13"
              },
              "items": [
                {
                  "text": "2 Abam 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mbarira n’abaherezi n’ ubgo bgoko bgose, nt’ Uku ni k’Uhoraho agize, ati Ntimuruhe mwumvira amagambo y’abo ba kamenyi banyu babaragurira, bat’ Ibintu vy’imbombovu vyo mu ngoro y’Uhoraho bizohava bigarukanwa bive i Babuloni: kuko babaragurira ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
