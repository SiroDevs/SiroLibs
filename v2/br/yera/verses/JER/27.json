            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namb’ ar’ abavugishwa n’Imana, kandi namb’ ijambo ry’Uhoraho riri muri bo, ni bashireko binginge Uhoraho Nyen’ ingabo ngw ibintu vy’imbombovu bisigaye mu ngoro y’Uhoraho no mu ngoro y’umwami w’i Buyuda, n’i Yerusalemu, bireke kujanwa i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
