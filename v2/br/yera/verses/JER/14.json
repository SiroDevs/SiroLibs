              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubabgire rer’ iri jambo, ut’ Amaso yanje acunduguta amosozi ku murango no mw ijoro adahengeshanya; kuk’ umukobga w’inkumi, ari we bgoko bgacu, avunitse, ari n’imvune nini, ari n’uruguma rubi rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.17",
            "verseOrgIds": [
              "JER.14.17"
