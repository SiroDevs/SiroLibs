              "items": [
                {
                  "text": "Zab 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nah’ ibigabitanyo vyacu bitwagiriza, gira ico ukora kubg’ izina ryawe, Uhoraho we: kuko gusubira inyuma kwacu ari kwinshi, kandi twagucumuyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.7",
            "verseOrgIds": [
              "JER.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.71.5"
              },
              "items": [
                {
                  "text": "Zab 71:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.13"
              },
              "items": [
                {
                  "text": "Yer 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.7"
              },
              "items": [
                {
                  "text": "50:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wewe vyizigiro vy’Abisirayeli, umukiza wabo mu gihe c’ivyago, n’iki cotuma utubako nk’umuntu w’akavantara ari mu gihugu, canke nk’impirahisi yaka indāro y’ijoro rimwe? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.8",
            "verseOrgIds": [
              "JER.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.45"
              },
              "items": [
                {
                  "text": "Kuv 29:45",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.59.1"
              },
              "items": [
                {
                  "text": "Yes 59:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.9.18"
              },
              "items": [
                {
                  "text": "Dan 9:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’iki cotuma uba nk’ umuntu atamāriwe, nk’umuhizi ayobewe gukiza? Yamara wewe Uhoraho, uri hagati muri twebge, kandi twitiriwe izina ryawe: ntuduhebe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.9",
            "verseOrgIds": [
              "JER.14.9"
            ]
          }
        }
      ]
    },
    {
