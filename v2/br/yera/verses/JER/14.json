              },
              "items": [
                {
                  "text": "Zab 79:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abo bantu baragurira bazoshiburirwa hanze mu nzira z’i Yerusalemu bishwe n’inzara n’inkota; kandi ntibazogira uwo kubahamba, bo ubgabo, cank’ abagore babo, cank’ abahungu babo, cank’ abakobga babo: kuko nzobasubizakw ibibi vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.16",
            "verseOrgIds": [
              "JER.14.16"
            ]
          }
        },
