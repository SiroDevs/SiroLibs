        },
        {
          "text": "Uhoraho aranyishura, at’ Abo ba kamenyi bavuga ibinyoma mw izina ryanje: sinabatumye, nta co nabageze, nta co nababariye: babarotorera ivyo beretswe vy’ibinyoma, n’ indagu, n’ibitagira ikimazi, n’ ubuhuhuta bgo mu mitima yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.14",
            "verseOrgIds": [
              "JER.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 14:15"
          },
          "items": [
