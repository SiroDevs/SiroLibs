              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’Uhoraho riza kuri Yeremiya rivuga ivy’ uruzuba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.1",
            "verseOrgIds": [
              "JER.14.1"
            ]
