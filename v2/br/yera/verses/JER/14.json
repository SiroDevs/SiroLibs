                "loc": "JER.23.34"
              },
              "items": [
                {
                  "text": "Yer 23:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, uku ni ko mvuze, jewe Uhoraho, ku vya ba kamenyi bavuga mw izina ryanje, kandi ntābatumye, yamara bakavuga ngw Inkota n’inzara ntibizoba mur’ iki gihugu: mber’ inkota n’ inzara ni vyo bizorandura abo ba kamenyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.15",
            "verseOrgIds": [
              "JER.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
