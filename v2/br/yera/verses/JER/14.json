              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.9"
              },
              "items": [
                {
                  "text": "9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho abarira ubu bgoko, at’ Ivyo bakunda n’ ukuyerera; ntibābujije ibirenge vyabo: ni co gituma Uhoraho atabemera; n’ubu yibuka ibigabitanyo vyabo, kand’ arabagīriye kubg’ ivyaha vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.10",
            "verseOrgIds": [
              "JER.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.16"
              },
              "items": [
                {
                  "text": "Yer 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho arambarira, ati Nta co usabira ubu bgoko kugirirwa neza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.11",
            "verseOrgIds": [
              "JER.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.15"
              },
              "items": [
                {
                  "text": "Yes 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.20"
              },
              "items": [
                {
                  "text": "Yer 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo bisonzesha sinzoruha numva ugutakamba kwabo; iyo bosa ikimazi, bazanye n’ishikanwa ry’ifu, sinzobākīrira: ariko nzobaranduza inkota n’inzara n’ikīza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.12",
            "verseOrgIds": [
              "JER.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.4.10"
              },
              "items": [
                {
                  "text": "Yer 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.14"
              },
              "items": [
                {
                  "text": "6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndavuga, nti Yō! Erega Mwami Uhoraho, ba kamenyi bababgira, ngo nta ho bazobona inkota cank’ inzara, ariko ng’ uzobaha kugirira aha hantu amahoro y’ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.14.13",
            "verseOrgIds": [
              "JER.14.13"
            ]
          }
        },
