              },
              "items": [
                {
                  "text": "Yer 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku vya Egiputa: amajambo yo ku vy’ingabo za Farawo‐Neko umwami wa Egiputa, zari ku nkengera y’uruzi Efurate i Karukemeshi, izo Nebukadineza umwami w’i Babuloni yanesheje mu mwaka ugira kane Yehoyakimu mwene Yosiya umwami w’i Buyuda ari ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.2",
            "verseOrgIds": [
              "JER.46.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
