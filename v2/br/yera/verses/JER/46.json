            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo Uhoraho yabariye Yeremiya ūvugishwa na we, ry’ ingene Nebukadineza umwami w’i Babuloni azoza gutera igihugu ca Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.13",
            "verseOrgIds": [
