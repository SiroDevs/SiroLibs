              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.15"
              },
              "items": [
                {
                  "text": "Yer 50:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.15"
              },
              "items": [
                {
                  "text": "Yow 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uwo musi ar’ uw’ Umwami, ni we Uhoraho Nyen’ ingabo, ar’ umusi wo kwīhōrako, kugira ngo yīhōre abarwanizi biwe: inkota izorya ihāge, izonywa amaraso yabo ihīmbe: kuk’ Umwami, ari we Uhoraho Nyen’ ingabo, acumitira ibimazi mu gihugu c’i burārūko ku nkengera y’uruzi Efurate. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.10",
            "verseOrgIds": [
              "JER.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.8.22"
              },
              "items": [
                {
                  "text": "Yer 8:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.21"
              },
              "items": [
                {
                  "text": "Ezk 30:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dūga upfe kwizenza i Gileyadi, wābīrey’ umuti, wewe mukobga w’inkumi ari we Egiputa: nta kimazi kunywa imiti myinshi: nta wo kuzogukiza uriho. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.11",
            "verseOrgIds": [
              "JER.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga yumvise ibitētērwa vyawe, isi yuzuye amaborogo yawe: kuk’ umuhizi atsitaye ku wundi, bompi bagatemba hamwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.46.12",
            "verseOrgIds": [
              "JER.46.12"
            ]
          }
        }
      ]
    },
