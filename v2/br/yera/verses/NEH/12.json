          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.9"
              },
              "items": [
                {
                  "text": "Neh 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo bāriho mu gihe ca Yoyakimu mwene Yosuwa, Yosuwa wa Yehozadaki, no mu gihe ca Nehemiya icēgēra c’umwami, na Ezira umuherezi, ari we munyabgenge w’ivyanditswe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
