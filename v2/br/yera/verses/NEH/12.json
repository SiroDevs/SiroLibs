        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi bo mu gihe ca Yoyakimu b’abakuru b’amazu ya ba sekuruza n’aba: mu ba Seraya ni Meraya; mu ba Yeremiya ni Hananiya; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12",
            "verseOrgIds": [
              "NEH.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Ezira ni Meshulamu; mu ba Amariya ni Yehohanani; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.13",
            "verseOrgIds": [
              "NEH.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Maluki ni Yonatani; mu ba Shebaniya ni Yosefu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.14",
            "verseOrgIds": [
              "NEH.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Harimu ni Adina; mu ba Merayoti ni Helikayi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.15",
            "verseOrgIds": [
              "NEH.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Ido ni Zekariya; mu ba Ginetoni ni Meshulamu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.16",
            "verseOrgIds": [
              "NEH.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Abiya ni Zikuri; mu ba Minyamini no mu ba Mohadiya ni Pilitayi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.17",
            "verseOrgIds": [
              "NEH.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Biliga ni Shamuwa; mu ba Shemaya ni Yehonatani; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.18",
            "verseOrgIds": [
              "NEH.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Yoyaribu ni Matenayi; mu ba Yedaya ni Uzi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.19",
            "verseOrgIds": [
              "NEH.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NEH 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Salayi ni Kalayi; mu ba Amoki ni Eberi; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.20",
            "verseOrgIds": [
              "NEH.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NEH 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Hilukiya ni Hashabiya; mu ba Yedaya ni Netaneli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.21",
            "verseOrgIds": [
              "NEH.12.21"
            ]
          }
        }
      ]
