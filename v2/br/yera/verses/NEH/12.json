              "items": [
                {
                  "text": "29:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bagatako bakagenda bahāna imbu mu gukorera Imana yabo no mu kwiyeza. Kand’ abaririmvyi n’abashibamyi ni ko bāgenza, bakurikiye icagezwe ca Dawidi n’ic’ umuhungu wiwe Salomo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.45",
            "verseOrgIds": [
              "NEH.12.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NEH 12:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko kera mu gihe ca Dawidi na Asafu hārih’ abarōngōzi b’abaririmvyi, hakabaho n’indirimbo zo guhimbaza Imana no kuyishima. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.46",
            "verseOrgIds": [
              "NEH.12.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NEH 12:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
