                "loc": "1CH.15.16"
              },
              "items": [
                {
                  "text": "1 Ngo 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe bāshikiriza Imana uruzitiro rw’i Yerusalemu, bāhamagaye Abalewi aho bāba hose, ngo baze i Yerusalemu ku musi mukuru wo kurushikiriza Imana banezerewe, ngo bashimishe indirimbo bafise n’ivyo kuvuza vyitwa matowazi bo n’amakembe n’inanga. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abaririmvyi barakorana bava mu biyaya bikikije i Yerusalemu no mu mihana y’ Abanetofati, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Beti‐gilugali no mu misozi y’i Geba n’i Azimaveti, kukw abaririmvyi bari biyubakiye imigerero impande zose z’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.22"
              },
              "items": [
                {
                  "text": "Neh 13:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abaherezi n’Abalewi bariyeza, maze beza abantu n’amarembo n’uruzitiro.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nuriza abakuru b’Abayuda ngo baje hejuru ku ruzitiro, ndabagabanyamw’ imice ibiri minini ngo bagende barōngōye bahimbaza. Umuce umwe ugenda ku ruzitiro werekeye i buryo, kw irembo bacishamw’ umwavu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakurikirwa na Hoshaya n’ igice kimwe c’abakuru b’Abayuda, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Azariya na Ezira na Meshulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yuda na Benyamini na Shemaya na Yeremiya, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’abahungu b’abaherezi bamwe bafise inzumbete: Zekariya mwene Yonatani, Yonatani wa Shemaya, Shemaya wa Mataniya, Mataniya wa Mikaya, Mikaya wa Zakuri, Zakuri wa Asafu; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.5"
              },
              "items": [
                {
                  "text": "1 Ngo 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bagenzi biwe Shemaya na Azareli na Milalayi na Gilalayi na Mahayi na Netaneli na Yuda na Hanani, bari bafise ibintu vyo kuvuza vyar’ ivya Dawidi umuntu w’Imana; kandi Ezira umunyabgenge w’ ivyanditswe yar’ abagiye imbere; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.15"
              },
              "items": [
                {
                  "text": "Neh 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baca kw irembo rija kw iriba batumbera imbere yabo, badūgira ahadondagirwa haja mu gisagara ca Dawidi, ah’ uruzitiro rudūgira haruguru y’ingoro yar’ iya Dawidi, bashika kw irembo ry’amazi ryerekeye i burasirazuba.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
