              "items": [
                {
                  "text": "Ezr 3:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abakuru b’ Abalewi ni Hashabiya na Sherebiya na Yosuwa mwene Kadimiyeli na bagenzi babo, bari bashinzwe guhimbaza Imana no kuyishima, bakurikiye ibgirizwa rya Dawidi umuntu w’Imana, bahāna imbu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mataniya na Bakibukiya na Obadiya na Meshulamu na Talimoni na Akubu bar’ abashibamyi barinda amazu y’ububīko yo ku marembo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
