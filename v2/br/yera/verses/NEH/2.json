                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno Sanibalati Umuhoroni bo na Tobiya Umwamoni w’umugurano bavyumvise, bibamerera nabi cane yuko haje umuntu ababaye Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.10",
            "verseOrgIds": [
              "NEH.2.10"
            ]
          }
        }
