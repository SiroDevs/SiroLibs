                "loc": "1KI.1.31"
              },
              "items": [
                {
                  "text": "1 Abam 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.3"
