              },
              "items": [
                {
                  "text": "Ezr 8:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nshitse i Yerusalemu mmaray’ imisi itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.11",
            "verseOrgIds": [
              "NEH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaheza mpenga mw ijoro mvyukana n’ abantu bake, kandi sinagize umuntu n’umwe mbgira ivyo Imana yashize mu mutima wanje ngo ndabikorere Yerusalemu; kandi nta mafarasi twajanye atar’ iyo nagenderako. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.12",
            "verseOrgIds": [
              "NEH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.3"
              },
              "items": [
                {
                  "text": "Neh 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw iryo joro nca mw irembo rija ku mwonga, nkomeza inzira y’isōko y’ikiyoka, nshika no kw irembo bācishamw’ umwavu, ngenda nitegereza inzitiro z’amabuye z’i Yerusalemu ukuntu zāsenyutse, n’amarembo yaho ingene yahiye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.13",
            "verseOrgIds": [
              "NEH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nkomeza inzira nshika kw irembo rija kw iriba, nshika no ku kidengeri c’umwami, ariko ntihaboneka inzira ifarasi nagenderako icamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.14",
            "verseOrgIds": [
              "NEH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw iryo joro nyene nsubira kudūgana akagezi, nkomeza kugenda nitegereza inzitiro, ndaheza ndakevya nsubira guca muri rya rembo rija ku mwonga; nuko ndataha. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.15",
            "verseOrgIds": [
              "NEH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abakuru ntibari bazi iyo nagiye cank’ ico nakoze, kandi nta co naribgabarire Abayuda, ar’ abaherezi cank’ abanyacubahiro cank’ abakuru cank’ abandi bose bazokorana nanje ico gikorwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.16",
            "verseOrgIds": [
              "NEH.2.16"
            ]
          }
        }
      ]
    },
