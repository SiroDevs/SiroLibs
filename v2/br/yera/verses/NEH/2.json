            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ngenda njanye n’abagabisha b’ingabo bo n’abagendera ku mafarasi umwami yampaye, nshikīra ivyēgēra vyiwe vyo hakurya y’uruzi, mbahēreza ivyete umwami yandungikanye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.9",
            "verseOrgIds": [
              "NEH.2.9"
            ]
          }
        },
        {
          "name": "verse",
