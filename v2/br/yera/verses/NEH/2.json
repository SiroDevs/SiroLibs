              "items": [
                {
                  "text": "Dan 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndamwishura, nti Mwami nyaguhora ku ngoma, mbega nobura kwiraburanirwa, igisagara ca ba sogokuruza, aho bāhambge, carabaye amatongo kand’ amarembo yaco yarahiye? ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.2.3",
            "verseOrgIds": [
              "NEH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
