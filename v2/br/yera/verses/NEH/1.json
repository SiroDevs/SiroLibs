          ]
        },
        {
          "text": "Ni wibuke ijambo wabariye umusavyi wawe Mose, uti Ni mwandyaruka nzobashwiragiriza mu mahanga; ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
