        },
        {
          "text": "Mu kwezi kwa Kisilevu, mu mwaka ugira mirongwibiri, nari nsanzwe ndi ku murwa i Shushani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
