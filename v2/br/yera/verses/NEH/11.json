        },
        {
          "text": "Abakuru b’abantu ni bo bāba i Yerusalemu; maz’ abandi bantu bose bapfinda ubupfindo kugira ng’ umuntu umwe‐umwe mur’ icumi na we az’ agerēre i Yerusalemu ku murwa wera, abandi basigaye babe mu bindi bisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.1",
            "verseOrgIds": [
              "NEH.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu bahezagira abandi bose bitanze n’ imitima ikunze kuba i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.2",
            "verseOrgIds": [
              "NEH.11.2"
            ]
          }
        }
      ]
