                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko har’ icagezwe cashinzwe n’ umwami kw abaririmvyi bazohora bahabga ibibatunga ku musi n’ umusi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.23",
            "verseOrgIds": [
              "NEH.11.23"
            ]
          }
        },
        {
