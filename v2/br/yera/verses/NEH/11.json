          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu Balewi, imitigiri imwe y’abāhora i Buyuda yagiye kuba i Bubenyamini.",
          "type": "text",
