          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petahiya mwene Meshezabeli wo mu bandurutse kuri Zera mwene Yuda ni we yar’ umushikirwa w’amajambo y’abantu bose aza ku mwami.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.24",
            "verseOrgIds": [
