              },
              "items": [
                {
                  "text": "Neh 3:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abahawe ibango ry’ibikorwa vy’urusengero bāba i Ofeli, kandi Siha na Gishipa ni bo bābaganza. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.21",
            "verseOrgIds": [
              "NEH.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umukoresha w’Abalewi i Yerusalemu, ari we yajejwe ibikorwa vyo mu ngoro y’Imana, ni Uzi mwene Bani, Bani wa Hashabiya, Hashabiya wa Mataniya, Mataniya wa Mika wo mu bākomotse kuri Asafu, ari bo baririmvyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.22",
            "verseOrgIds": [
              "NEH.11.22"
            ]
          }
        },
        {
