              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasigaye bo mu Bisirayeli no mu baherezi no mu Balewi bāba mu bindi bisagara vyose vy’i Buyuda, umuntu wese mw itongo ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.20",
            "verseOrgIds": [
              "NEH.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
