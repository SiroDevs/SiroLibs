          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Eni‐rimoni n’i Zora n’i Yarimuti, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.29",
            "verseOrgIds": [
              "NEH.11.29"
            ]
          }
        },
