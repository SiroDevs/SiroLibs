                  "text": "Yos 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Zanowa n’i Adulamu no mu bisagara bigenda bihakūkira, n’i Lakishi no mu matongo yaho, n’i Azeka no mu bisagara bihakūkira. Uko ni ko bāgerereye uhereye i Beri‐sheba ugashitsa no ku mwonga wa Hinomu. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.30",
            "verseOrgIds": [
              "NEH.11.30"
            ]
          }
        },
        {
