              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashibamyi, Akubu na Talimoni na bagenzi babo bāshibama ku marembo, bose na bose bar’ ijana na mirongwirindwi na babiri.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.19",
