              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku vy’imihana n’amatongo yayo, bamwe bo mu Bayuda bāba i Kiriyati‐Araba no mu bisagara bihakūkira, n’i Diboni no mu bisagara bihakūkira, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.11.25",
            "verseOrgIds": [
