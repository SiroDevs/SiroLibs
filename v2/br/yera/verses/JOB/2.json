            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw aramwishura, at’ Uvuze nk’umwe wo mu bagore b’ibipfapfa. Mbega none twohabga ivyiza bisa mu biganza vy’Imana, tukanka kwākīra n’ibibi na vyo? Mur’ ivyo vyose Yobu ntiyakoresheje icaha akanwa kiwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.10",
            "verseOrgIds": [
              "JOB.2.10"
            ]
