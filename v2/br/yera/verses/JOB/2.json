                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwundi musi abana b’Imana baje bashengereye Uhoraho, na Satani azanana na bo gushengerera Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.1",
            "verseOrgIds": [
              "JOB.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.7"
              },
              "items": [
                {
                  "text": "Yob 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abaza Satani, at’ Uvuye hehe? Satani yishura Uhoraho, ati Mvuye gukwiragira mw isi no kuyigendagendamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.2",
            "verseOrgIds": [
              "JOB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.8"
              },
              "items": [
                {
                  "text": "Yob 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abaza Satani, ati Mbega witegereje umusavyi wanje Yobu, yukw ata wuhwanye na we mw isi, ar’ umuntu atunganye w’umugororotsi, anyubaha, akitandukanya n’ikibi? Erega yakomeje ukugororoka kwiwe gushitsa n’ubu, naho wanteye kumugeseza ata co ndamuhōye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.3",
            "verseOrgIds": [
              "JOB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Satani yishura Uhoraho, at’ Amagara akābga ayandi! Mber’ ivy’ umuntu atunze vyose yobitanga ku magara yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.4",
            "verseOrgIds": [
              "JOB.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.5"
              },
              "items": [
                {
                  "text": "Yob 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko pfa gutuma ukuboko kwawe, utere amagufa yiwe n’umubiri wiwe, urābe kw atazokurogotako imbonankubone. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.5",
            "verseOrgIds": [
              "JOB.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yishura Satani, at’ Eh’ ari mu kuboko kwawe; kimwe gusa, uzigurize ubugingo bgiwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.6",
            "verseOrgIds": [
              "JOB.2.6"
            ]
          }
        }
      ]
    },
    {
