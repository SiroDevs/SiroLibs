            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umugore wiwe aramubaza, ati Mbega n’ubu uracakomeje kwa kugororoka kwawe? Tuka Imana, upfe uveho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.9",
            "verseOrgIds": [
              "JOB.2.9"
            ]
          }
        },
