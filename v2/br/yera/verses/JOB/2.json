            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Satani aca arasohoka, ava imbere y’Uhoraho, atēza Yobu ibihute bikomeye uhēreye mu bgōro bg’ikirenge ugashitsa mu gitwariro. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.2.7",
            "verseOrgIds": [
              "JOB.2.7"
            ]
          }
        },
