              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yobu yishura Uhoraho,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.6",
            "verseOrgIds": [
              "JOB.42.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Uhoraho amaze kubgira Yobu ayo majambo, Uhoraho abarira Elifazi w’i Temani, at’ Uburake bganje burakuziriringiye, mwe na bagenzi bawe bompi: kuko mutamvuzekw ibiroranye, nk’uk’ umusavyi wanje Yobu yagize. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.7",
            "verseOrgIds": [
              "JOB.42.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.7"
              },
              "items": [
                {
                  "text": "Ita 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.1"
              },
              "items": [
                {
                  "text": "Guh 23:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.12.23"
              },
              "items": [
                {
                  "text": "1 Sam 12:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.5"
              },
              "items": [
                {
                  "text": "Yob 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.16"
              },
              "items": [
                {
                  "text": "1 Yoh 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ni mwijanire amashūri ndwi n’impfizi z’intama ndwi, muje ku musavyi wanje Yobu, mwitangire ibimazi vyoswa; kand’ umusavyi wanje Yobu azobasabira, kukw ari we nzokwemera, kugira ngo noye kubagirira nk’uk’ ubupfu bganyu bumeze; kuko mutamvuzekw ibiroranye, nk’uk’ umusavyi wanje Yobu yagize. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.8",
            "verseOrgIds": [
              "JOB.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Elifazi w’i Temani na Biludadi w’i Shuhi na Zofari w’i Nayama baragenda, bagira nk’uk’ Uhoraho yababariye: maz’ Uhoraho yumvira ugusenga kwa Yobu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.9",
            "verseOrgIds": [
              "JOB.42.9"
            ]
          }
        }
      ]
    },
    {
