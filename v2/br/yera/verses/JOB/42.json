              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.7"
              },
              "items": [
                {
                  "text": "Yes 61:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobu agisengera bagenzi biwe, Uhoraho amukūrak’ uburushwa bgiwe, amushumbusha ibingana n’ivyo yar’ afise ibihetangabo kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.10",
            "verseOrgIds": [
              "JOB.42.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.22"
              },
              "items": [
                {
                  "text": "Ita 24:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.19.13"
              },
              "items": [
                {
                  "text": "Yob 19:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abo bavukana bose baraza, na bashiki biwe bose, n’abāri bāzinanyi na we bose ubga mbere, basangirira na we mu nzu yiwe; baje kumugarukirako no kumwirura kubg’ ivyago vyose Uhoraho yari yaramutēje; umuntu wese amuha ihera ryitwa kesita n’impeta y’ izahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.11",
            "verseOrgIds": [
              "JOB.42.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.3"
              },
              "items": [
                {
                  "text": "Yob 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.8.7"
              },
              "items": [
                {
                  "text": "8:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.10"
              },
              "items": [
                {
                  "text": "42:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Uhoraho aha Yobu umugisha mu gihe c’amaheruka kuruta ica mbere: aronka intama ibihumbi cumi na bine, n’ ingamiya ibihumbi bitandatu, n’ inka zirima ibihumbi bibiri, n’ indogoba zivyara igihumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.12",
            "verseOrgIds": [
              "JOB.42.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 42:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ avyara n’abahungu ndwi n’abakobga batatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.13",
            "verseOrgIds": [
              "JOB.42.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 42:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukobga wa mbere amwita Yemima; uw’ ubuheta amwita Keziya; uwa gatatu amwita Kereni‐hapuki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.14",
            "verseOrgIds": [
              "JOB.42.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 42:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.27.1+NUM.27.2+NUM.27.3+NUM.27.4+NUM.27.5+NUM.27.6+NUM.27.7+NUM.27.8"
              },
              "items": [
                {
                  "text": "Guh 27:1-8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu gihugu cose nta bigeme bāri bahwanije akaranga n’ abakobga ba Yobu: nuko se abaraga hamwe na basaza babo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.15",
            "verseOrgIds": [
              "JOB.42.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 42:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.50.23"
              },
              "items": [
                {
                  "text": "Ita 50:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.128.6"
              },
              "items": [
                {
                  "text": "Zab 128:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma yaho, Yobu amara imyaka ijana na mirongwine, abona abana biwe n’abuzukuru biwe, gushitsa no ku buzukururuza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.5.26"
              },
              "items": [
                {
                  "text": "Yob 5:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yobu apfa yīsāziye, ageze mu zabukuru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.17",
            "verseOrgIds": [
              "JOB.42.17"
            ]
          }
        }
      ]
    }
  ],
