                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ adūga umusozi muremure, ahamagara abo agomba, baza kuri we. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.13",
            "verseOrgIds": [
              "MRK.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atoranya icumi na babiri bo kubana na we, maze ngw abatume kwigisha, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.14",
            "verseOrgIds": [
              "MRK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kugira ububasha bgo gusenda abadayimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.15",
            "verseOrgIds": [
              "MRK.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.42"
              },
              "items": [
                {
                  "text": "Yoh 1:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw atoranya aba cumi na babiri: Simoni, amwita Petero; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.16",
            "verseOrgIds": [
              "MRK.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.54"
              },
              "items": [
                {
                  "text": "Luk 9:54",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "atoranya na Yakobo mwene Zebedayo, na Yohana mwene nyina wa Yakobo, na bo abita Bowanerige, risobanurwa ngw Abana b’inkuba; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.17",
            "verseOrgIds": [
              "MRK.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "atoranya na Andereya, na Filipo, na Barutolomayo, na Matayo, na Toma, na Yakobo mwene Alufayo, na Tadayo, na Simoni Umunyakananayo, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.18",
            "verseOrgIds": [
              "MRK.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Yuda Isikaryota, ni we yamuguze.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aja mu nzu: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.19",
            "verseOrgIds": [
              "MRK.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ishengero ryongera gukoranira kuri we, bituma babura ingene botamira n’agatsima. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.20",
            "verseOrgIds": [
              "MRK.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
