                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera kwinjira mw isinagogi; kandi hār’ umuntu anyunyutse ukuboko; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.1",
            "verseOrgIds": [
              "MRK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "baramugenza ngo barābe kw amukiza kw isabato, ngo bamurege. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.2",
            "verseOrgIds": [
              "MRK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarira uwo muntu anyunyutse ukuboko, ati Va hasi, uhagarare hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.3",
            "verseOrgIds": [
              "MRK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababaza, ati Mbeg’ ivyemerwa n’ugukora ivyiza kw isabato canke n’ugukora ibibi? Gukiza umuntu canke kumwica? Barihorera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.4",
            "verseOrgIds": [
              "MRK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.33"
              },
              "items": [
                {
                  "text": "Yoh 11:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aberaguzamw’ amaso, aratse, ababazwa n’ukw imitima yabo ikomantaye, abarira uwo muntu, ati Ramvura ukuboko kwawe. Arakuramvura, kurakira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.5",
            "verseOrgIds": [
              "MRK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.22.16"
              },
              "items": [
                {
                  "text": "Mat 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo barasohoka, baca bamugīra inama n’abantu ba Herode ngo babone ingene bomwica.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.6",
            "verseOrgIds": [
              "MRK.3.6"
            ]
          }
        }
      ]
    },
    {
