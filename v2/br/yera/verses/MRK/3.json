            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.19+LUK.8.20+LUK.8.21"
              },
              "items": [
                {
                  "text": "Luk 8:19-21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nyina na bene nyina baraza, batuma kumuhamagara, bahagaze hanze. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.31",
            "verseOrgIds": [
              "MRK.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishengero ryari ryicaye rimukikije; maze baramubgira, bat’ Ereg’ umuvyeyi wawe na barumuna bawe bari hanze, barakurondera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.32",
            "verseOrgIds": [
              "MRK.3.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arababaza, ati Mama ni nde, canke bene mama ni ba nde? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.33",
            "verseOrgIds": [
              "MRK.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeraguza amaso abari bicaye impande zose bamukikije, ati Ngaba mama na bene mama: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.34",
            "verseOrgIds": [
              "MRK.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "umuntu wese akora ivyo Imana igomba ni we murumunanje, ni we mushikanje, ni we mama.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.35",
            "verseOrgIds": [
              "MRK.3.35"
            ]
          }
        }
      ]
    }
