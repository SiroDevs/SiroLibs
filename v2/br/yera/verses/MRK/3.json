                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yesu n’abigishwa biwe bavayo, baja ku kiyaga: ishengero ryinshi riramukurikira, bavuye i Galilaya n’i Yudaya ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.7",
            "verseOrgIds": [
              "MRK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.25"
              },
              "items": [
                {
                  "text": "Mat 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Yerusalemu no muri Idumaya no hakurya ya Yorodani, n’abahereranye no muri Tiro n’i Sidoni, ishengero ryinshi ryumvise ivyo yakoze riza kuri we. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.8",
            "verseOrgIds": [
              "MRK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarira abigishwa biwe ngo bagumishe ubgato butoya hafi kubg’ ishengero, ngo ntirimubānde. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.9",
            "verseOrgIds": [
              "MRK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yakijije benshi, ni co catumye abāri bafise ivyago bose bamuhenukirako, ngo bamukoreko. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.10",
            "verseOrgIds": [
              "MRK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.41"
              },
              "items": [
                {
                  "text": "Luk 4:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impwemu zihumanye na zo uko zimubonye zamwikubita imbere, zigasemerera zit’ Ur’ Umwana w’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.11",
            "verseOrgIds": [
              "MRK.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.34"
              },
              "items": [
                {
                  "text": "Mrk 1:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arazihanikiriza cane, ngo ntizigende ziramwandagaza.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.12",
            "verseOrgIds": [
              "MRK.3.12"
            ]
          }
        }
      ]
    },
