              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atangura kubigisha, at’ Umwana w’umuntu akwiye kuzobabazwa uburyo bginshi, no kuzokwankwa n’abashingantahe n’abaherezi bakuru n’abanyabgenge b’ivyanditswe, no kuzokwicwa, maze hashize imisi itatu akazuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.31",
            "verseOrgIds": [
              "MRK.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuga iryo jambo adakingitiranije. Petero aramwihererana, atangura kumwāmira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.32",
            "verseOrgIds": [
              "MRK.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arahindukira, abona abigishwa biwe, akankamira Petero, ati Herēra inyuma yanje, Satani, kukw ivy’ Imana atari vyo ubabaye, ariko n’ivy’ abantu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.33",
            "verseOrgIds": [
              "MRK.8.33"
            ]
          }
        }
      ]
    },
