                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baraza bashika i Betsayida. Bamuzanira impumyi, baramwinginga ngw ayikoreko. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.22",
            "verseOrgIds": [
              "MRK.8.22"
            ]
          }
