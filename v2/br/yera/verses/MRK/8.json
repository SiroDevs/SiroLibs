              "MRK.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamagara ishengero bo n’abigishwa biwe, arababgira, at’ Umuntu ni yagomba kunkurikira, ni yiyanke, yikorere umusaraba wiwe, ankurikire; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.34",
            "verseOrgIds": [
              "MRK.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.39"
              },
              "items": [
                {
                  "text": "Mat 10:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ ūgomba gukiza ubugingo bgiwe azobubura, arik’ ūzoheba ubugingo bgiwe kubganje no kubg’ ubutumwa bgiza, azobukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.35",
            "verseOrgIds": [
              "MRK.8.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 8:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umuntu vyomumarira iki kwunguka ivyo mw isi vyose, ni yakwa ubugingo bgiwe kw iciru? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.36",
            "verseOrgIds": [
              "MRK.8.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 8:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ umuntu yotanga iki ngw acungure ubugingo bgiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.37",
            "verseOrgIds": [
              "MRK.8.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 8:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.33"
              },
              "items": [
                {
                  "text": "Mat 10:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umuntu wese bizotera isoni kunyemera no kwemera amajambo yanje mur’ iki gihe c’ubusambanyi kandi c’ikinyavyaha, n’Umwana w’umuntu bizomutera isoni kumwemera, ah’ azozira afise ubgiza bga Se, azananye n’abamarayika bera.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.38",
            "verseOrgIds": [
              "MRK.8.38"
            ]
          }
        }
      ]
    }
