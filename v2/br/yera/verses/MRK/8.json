                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu avanayo n’abigishwa biwe, aja mu mihana y’i Kayisariya mu bga Filipo: bari mu nzira, abaza abigishwa biwe, at’ Abantu bagira ngo ndi nde? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.27",
            "verseOrgIds": [
              "MRK.8.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.6.15"
              },
              "items": [
                {
                  "text": "Mrk 6:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura, bati Bagira ng’ uri Yohana Umubatizi, abandi ng’ uri Eliya, abandi ng’ ur’ umwe mu bavugishwa n’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.28",
            "verseOrgIds": [
              "MRK.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.6.67+JHN.6.68+JHN.6.69"
              },
              "items": [
                {
                  "text": "Yoh 6:67-69",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arababaza, at’ Ariko mweho mugira ngo ndi nde? Petero aramwishura, at’ Uri Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.29",
            "verseOrgIds": [
              "MRK.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.9"
              },
              "items": [
                {
                  "text": "Mrk 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabihanikiriza ngo ntihagire umuntu babgira ivyiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.30",
            "verseOrgIds": [
              "MRK.8.30"
            ]
          }
        }
      ]
    },
    {
