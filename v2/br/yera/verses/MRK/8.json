              },
              "items": [
                {
                  "text": "Yoh 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afata iyo mpumyi ukuboko, ayikūra mu mihana, acira amate mu maso yayo, ayirambikakw ibiganza, arayibaza, ati Har’ ico ubona? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.23",
            "verseOrgIds": [
              "MRK.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iraramura amaso, iramwishura, iti Ndabona abantu kuko mbona ibisa n’ibiti bigendagenda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.24",
            "verseOrgIds": [
              "MRK.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera kurambika ibiganza ku maso yayo, iritegereza, irakira, yihweza vyose neza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.25",
            "verseOrgIds": [
              "MRK.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.36"
              },
              "items": [
                {
                  "text": "Mrk 7:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amurungika i we, ati Ntuje no mur’ iyi mihana.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.8.26",
            "verseOrgIds": [
              "MRK.8.26"
            ]
          }
        }
