                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashize imisi, asubira i Kaperinawumu, bimenyekana kw ari mu nzu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.1",
            "verseOrgIds": [
              "MRK.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoraniraho benshi, ntibakwirwa mu nzu, eka n’imbere y’umuryango hose; ababgira ijambo ry’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.2",
            "verseOrgIds": [
              "MRK.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza abazanye ikimuga, bagiteruye ari bane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.3",
            "verseOrgIds": [
              "MRK.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babuze ingene bamushikīra kubg’ ishengero, basambura inzu hejuru y’ah’ atumbereye; bahejeje kuhatobora, bururukirizamw’ inderuzo, iryamyemw’ ico kimuga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.4",
            "verseOrgIds": [
              "MRK.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abonye ukwizera kwabo, abgira ico kimuga, ati Mwana wanje, ivyaha vyawe urabihariwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.5",
            "verseOrgIds": [
              "MRK.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko hārih’ abanyabgenge b’ivyanditswe bamwe bicayeho, bībūranya mu mitima, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.6",
            "verseOrgIds": [
              "MRK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.25"
              },
              "items": [
                {
                  "text": "Yes 43:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati N’iki gitumye uyo avuga artyo? Ararogose: ni nde ashobora guharira ivyaha, atar’ umwe, ni we Mana? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.7",
            "verseOrgIds": [
              "MRK.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amenye mu mutima wiwe yuko bībūranya muri bo bartyo, aca arababaza, ati N’iki gitumye mwībūranya ivyo mu mitima yanyu? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.8",
            "verseOrgIds": [
              "MRK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icoroshe n’ikihe, n’ukubarira ikimuga, nt’ Uhariwe ivyaha vyawe; canke n’ukukibarira, nti Vyuka, wikorere inderuzo yawe, ugende? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.9",
            "verseOrgIds": [
              "MRK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko kugira ngo mumenye k’Umwana w’umuntu afise ububasha mw isi bgo guharira ivyaha — abgira ikimuga, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.10",
            "verseOrgIds": [
              "MRK.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Ndakubariye nti Vyuka, wikorere inderuzo yawe, utahe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.11",
            "verseOrgIds": [
              "MRK.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravyuka, aca yikorera inderuzo, asohoka imbere ya bose: nuko bose barumirwa, bahimbaza Imana, bati Ntitwaribgabone ben’ ibi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.12",
            "verseOrgIds": [
              "MRK.2.12"
            ]
          }
        }
      ]
    },
    {
