                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.27+LUK.5.28+LUK.5.29+LUK.5.30+LUK.5.31+LUK.5.32"
              },
              "items": [
                {
                  "text": "Luk 5:27-32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arasohoka, yongera kuja i ruhande y’ikiyaga: ishengero ryose riza kuri we, arabigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.13",
            "verseOrgIds": [
              "MRK.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.43"
              },
              "items": [
                {
                  "text": "Yoh 1:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw arikw aragenda abona Lewi mwene Alufayo, yicaye aho yatoreza ikibuguro, aramubarira, ati Nkurikira. Ava hasi, aramukurikira.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.14",
            "verseOrgIds": [
              "MRK.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yicaye mu nzu y’uwo, arikw ararya, haza benshi mu batozakori n’abanyavyaha basangira na Yesu n’abigishwa biwe: bāri benshi, kandi bāramukurikira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.15",
            "verseOrgIds": [
              "MRK.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyabgenge b’ivyanditswe bo mu Bafarisayo babonye asangira n’abanyavyaha n’abatozakori babgira abigishwa biwe, bati Mbega kw asangira n’abatozakori n’abanyavyaha! ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.16",
            "verseOrgIds": [
              "MRK.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu avyumvise, arababgira, at’ Abakomeye nta co bagombera umuvūzi, atar’ abarwaye. Sinaje guhamagara abagororotsi, atar’ abanyavyaha.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.17",
            "verseOrgIds": [
              "MRK.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
