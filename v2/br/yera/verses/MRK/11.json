              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye kare‐kare bariko barahita babona wa musukoni, wahereye ku mizi wakabiranye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.20",
            "verseOrgIds": [
              "MRK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero yibutse aramubgira, ati Mwigisha, ehe wa musukoni wavumye wakabiranye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
            "verseOrgIds": [
              "MRK.11.21"
            ]
          }
        },
        {
