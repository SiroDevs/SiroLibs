            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gitumye mbabgira yukw ivyo musenga canke musaba vyose, mwizere yuko mubihawe, kandi muzobibona. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.24",
