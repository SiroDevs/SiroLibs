                "loc": "LUK.19.45+LUK.19.46+LUK.19.47+LUK.19.48"
              },
              "items": [
                {
                  "text": "Luk 19:45-48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashika i Yerusalemu, yinjira mu rusengero, maz’ ahejeje kweraguza vyose, kuko bgari bugorovye, arasohoka, aja i Betaniya, ajanye na bamwe cumi na babiri.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.11",
            "verseOrgIds": [
              "MRK.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye bamaze kuva i Betaniya, yumva arashonje. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.12",
            "verseOrgIds": [
              "MRK.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.9"
              },
              "items": [
                {
                  "text": "Luk 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.6+LUK.13.7+LUK.13.8+LUK.13.9"
              },
              "items": [
                {
                  "text": "13:6-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiri kure, abona umusukoni urikw amababi, arawēgēra ngo kumbure yogira ic’ awusangako: awushitseko ntiyagira ic’ awubonako, atar’ amababi: kuko kitār’ igihe co kwama c’umusukoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.13",
            "verseOrgIds": [
              "MRK.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.11.20"
              },
              "items": [
                {
                  "text": "Mrk 11:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arawubgira, ati Ntugapfe har’ ūriye ku nsukoni zawe uhereye ubu ugashitsa ibihe bidashira. Abigishwa biwe baravyumva.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.14",
            "verseOrgIds": [
              "MRK.11.14"
            ]
          }
        }
      ]
    },
