          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.2.14+JHN.2.15+JHN.2.16"
              },
              "items": [
                {
                  "text": "Yoh 2:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashika i Yerusalemu. Yinjira mu rusengero, atangura guhindira hanze abarudandarizamwo n’abaruguriramwo, ahenura ameza y’abāvunja amahera n’intebe z’abāriko baragurwakw inuma, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.15",
            "verseOrgIds": [
              "MRK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntiyakundira umuntu n’umwe guhita mu rusengero atwaye ikintu co mu mbombovu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.16",
            "verseOrgIds": [
              "MRK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.7"
              },
              "items": [
                {
                  "text": "Yes 56:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.11"
              },
              "items": [
                {
                  "text": "Yer 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arigisha arababgira, ati Mbega ntivyanditswe, ngw Ingoro yanje izokwitwa inzu yo gusengerwamwo n’amahanga yose? Ariko mwebge mwayihinduye nk’isenga ry’abambuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi bakuru n’abanyabgenge b’ivyanditswe bavyumvise barondera ingene bomwica, kuko bāmutinya, kukw abantu bose batangazwa n’inyigisho ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
              "MRK.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo bugorovye, yama ava mu gisagara.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.19",
            "verseOrgIds": [
              "MRK.11.19"
            ]
          }
        }
      ]
    },
