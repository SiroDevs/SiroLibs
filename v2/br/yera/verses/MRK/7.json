            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.29+MAT.15.30+MAT.15.31"
              },
              "items": [
                {
                  "text": "Mat 15:29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera kuva mu ntāra yo muri Tiro, araza aca i Sidoni, ashika ku kiyaga c’i Galilaya, aciye hagati y’intāra y’i Dekapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.31",
            "verseOrgIds": [
              "MRK.7.31"
            ]
          }
        },
        {
