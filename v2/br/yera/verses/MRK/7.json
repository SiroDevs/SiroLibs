              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.1+MAT.15.2+MAT.15.3+MAT.15.4+MAT.15.5+MAT.15.6+MAT.15.7+MAT.15.8+MAT.15.9+MAT.15.10+MAT.15.11+MAT.15.12+MAT.15.13+MAT.15.14+MAT.15.15+MAT.15.16+MAT.15.17+MAT.15.18+MAT.15.19+MAT.15.20"
              },
              "items": [
                {
                  "text": "Mat 15:1-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo bakoranira kuri we n’abanyabgenge b’ivyanditswe bamwe bavuye i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.1",
            "verseOrgIds": [
              "MRK.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.11.38"
              },
              "items": [
                {
                  "text": "Luk 11:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babona abigishwa biwe bamwe barisha ivyo kurya intoke zihumanye, bisobanurwa ngo zidakaravye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.2",
            "verseOrgIds": [
              "MRK.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Abafarisayo n’Abayuda bose, iyo batīfyikinyuye mu gukaraba ntibārya, kuko bākurikiye imigenzo bābgirijwe n’aba kera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.3",
            "verseOrgIds": [
              "MRK.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bavuye mu kaguriro, iyo batīmijagiye amazi ntibārya, kandi harih’ ibindi vyinshi bābgirijwe n’aba kera ngo bavyumireko, nko kwoza mu buryo bginshi ibikombe n’inzavya n’inkono zikozwe mu miringa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.4",
            "verseOrgIds": [
              "MRK.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo n’abanyabgenge b’ivyanditswe baramubaza, bati N’iki gitumye abigishwa bawe badakurikira ingeso twabgirijwe n’aba kera, bagapfa kurisha ivyo kurya intoke zihumanye? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.5",
            "verseOrgIds": [
              "MRK.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Yesaya yavuze neza ivyo yavugishijwe n’Imana kuri mwebge indyarya, nk’uko handitswe,",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.6",
            "verseOrgIds": [
              "MRK.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.13",
            "verseOrgIds": [
              "MRK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yongera guhamagara ishengero, araribarira, ati Munyumve mwese, mubitahure: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.14",
            "verseOrgIds": [
              "MRK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.14"
              },
              "items": [
                {
                  "text": "Ivyak 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nta kintu kir’ inyuma, iyo kigiye imbere mu muntu gishobora kumuhumanya, arikw ibivuye mu muntu ni vyo bimuhumanya. [",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.15",
            "verseOrgIds": [
              "MRK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namba har’ ūfise amatwi yumva, ni yumve.] ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.16",
            "verseOrgIds": [
              "MRK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yinjiye mu nzu asize ishengero hanze, abigishwa biwe bamusiguza uwo mugani. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.17",
            "verseOrgIds": [
              "MRK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arababaza, ati Mbega namwe mur’ imburabgenge murtyo? Ntimutahura yukw ata kintu kir’ inyuma iyo kigiye imbere mu muntu gishobora kumuhumanya, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.18",
            "verseOrgIds": [
              "MRK.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko kitagiye mu mutima wiwe, ariko kija mu nda, kigaca mu nzira yaco? Ivyo yabivugiye kuzirura ivyo kurya vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.19",
            "verseOrgIds": [
              "MRK.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ aravuga, at’ Ibiva imbere mu muntu, ni vyo bimuhumanya: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.20",
            "verseOrgIds": [
              "MRK.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw imbere mu mitima y’abantu havamw’ ivyiyumviro bibi, ubushakanyi, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.21",
            "verseOrgIds": [
              "MRK.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubgivyi, ubgicanyi, ubusambanyi, ukwifuza, kugira nabi, ubugunge, ivy’ isoni nke, ijisho ribi, ibitutsi, ubgibone, ubupfu: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.22",
            "verseOrgIds": [
              "MRK.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyo bibi vyose biva imbere ni vyo bihumanya umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.23",
            "verseOrgIds": [
              "MRK.7.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
