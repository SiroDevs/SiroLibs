            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ararangamiza, arāba mw ijuru, yitsa umutima, arakibarira, ati Efata, risobanurwa ngo Zibūka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.34",
            "verseOrgIds": [
              "MRK.7.34"
            ]
          }
        },
        {
