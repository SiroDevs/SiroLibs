            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agikūra mw ishengero, aracihererana, agishira intoke mu matwi, acira amate, agikora ku rurimi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.33",
            "verseOrgIds": [
              "MRK.7.33"
            ]
