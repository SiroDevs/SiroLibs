          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatwi yiwe arazibūka, inkingi z’ururimi rwiwe zirabohoka, avuga neza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.7.35",
