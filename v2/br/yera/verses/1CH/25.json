          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubg’ icumi na gatatu bgerekana Shubayeli n’abigishwa biwe na bagenzi biwe, bose na bose bār’ icumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.20",
            "verseOrgIds": [
              "1CH.25.20"
            ]
          }
        },
