          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubg’ icenda bgerekana Mataniya n’abigishwa biwe na bagenzi biwe, bose na bose bār’ icumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.16",
