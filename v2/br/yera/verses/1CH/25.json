          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubg’ icumi na kabiri bgerekana Hashabiya n’abigishwa biwe na bagenzi biwe, bose na bose bār’ icumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.19",
