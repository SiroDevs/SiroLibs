            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubg’ icumi bgerekana Shimeyi n’abigishwa biwe na bagenzi biwe, bose na bose bār’ icumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.17",
