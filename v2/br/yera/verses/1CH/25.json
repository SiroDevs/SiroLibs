          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubg’ icumi na gatandatu bgerekana Hananiya n’abigishwa biwe na bagenzi biwe, bose na bose bār’ icumi na babiri; ",
          "type": "text",
          "attrs": {
