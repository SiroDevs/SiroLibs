          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubga gatandatu bgerekana Bukiya n’abigishwa biwe na bagenzi biwe, bose na bose bār’ icumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.13",
            "verseOrgIds": [
              "1CH.25.13"
            ]
          }
        },
