          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubg’ icumi na kane bgerekana Matitiya n’abigishwa biwe na bagenzi biwe, bose na bose bār’ icumi na babiri; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.21",
