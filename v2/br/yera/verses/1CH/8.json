            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.9.35+1CH.9.36+1CH.9.37+1CH.9.38"
              },
              "items": [
                {
                  "text": "1 Ngo 9:35-38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeyeli se wa Gibeyoni yaba i Gibeyoni nyene; umugore wiwe yitwa Mayaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.29",
            "verseOrgIds": [
              "1CH.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfura yiwe ni Abudoni, agakurikirwa na Suri na Kishi na Bayali na Nadabu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.30",
            "verseOrgIds": [
              "1CH.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Gedori na Ahiyo na Zekeri, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.31",
            "verseOrgIds": [
              "1CH.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Mikuloti ari we se wa Shimeya. Abo na bo bābāna n’abo b’i wabo i Yerusalemu nyene, babangikanye. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.8.32",
            "verseOrgIds": [
              "1CH.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1CH 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
