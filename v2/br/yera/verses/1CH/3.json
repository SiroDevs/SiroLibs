              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bose bar’ abahungu ba Dawidi, udashizemw’ abo yavyaye ku ncoreke ziwe; kandi bari bafise mushiki wabo Tamari.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        }
