                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba ni bo bana b’abahungu Dawidi yavyariye i Heburoni: uw’ imfura ni Amunoni, uwo yavyaye kuri Ahinowamu w’i Yezireli; uwa kabiri ni Daniyeli, uwo yavyaye kuri Abigayili w’i Karumeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwa gatatu ni Abusalomu, uwo yavyaye kuri Mayaka, umukobga wa Talumayi umwami w’i Geshuri; uwa kane ni Adoniya, uwo yavyaye kuri Hagita; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwa gatanu ni Shefatiya, uwo yavyaye kuri Abitali; uwa gatandatu ni Itureyamu, uwo yavyaye ku wundi mugore wiwe yitwa Egila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
