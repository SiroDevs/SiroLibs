        },
        {
          "text": "Aba ni bo yavyariye i Yerusalemu: Shimeya na Shobabu na Natani na Salomo, abo ukw ari bane yabavyaye kuri Batishuwa umukobga wa Amiyeli; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "avyara na Ibuhari na Elishama na Elifeleti, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6",
            "verseOrgIds": [
              "1CH.3.6"
            ]
          }
        },
