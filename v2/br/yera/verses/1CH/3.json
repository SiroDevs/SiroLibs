          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Noga na Nefegi na Yafiya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.7",
            "verseOrgIds": [
              "1CH.3.7"
            ]
          }
        },
