              "items": [
                {
                  "text": "5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ukw ari batandatu ni bo yavyariye i Heburoni; kandi yamaze ku ngoma imyaka ndwi n’amezi atandatu ar’ i Heburoni, n’iyindi mirongwitatu n’itatu ar’ i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
