              "type": "tag",
              "attrs": {
                "loc": "2SA.8.1+2SA.8.2+2SA.8.3+2SA.8.4+2SA.8.5+2SA.8.6+2SA.8.7+2SA.8.8+2SA.8.9+2SA.8.10+2SA.8.11+2SA.8.12+2SA.8.13+2SA.8.14+2SA.8.15+2SA.8.16+2SA.8.17+2SA.8.18"
              },
              "items": [
                {
                  "text": "2 Sam 8:1-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo Dawidi anesha Abafilisitiya, abamara igabo, atsinda i Gati n’ibisagara bihakūkira, arabibanyaga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.18.1",
            "verseOrgIds": [
              "1CH.18.1"
            ]
          }
        }
      ]
