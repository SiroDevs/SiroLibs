                "loc": "JOS.15.17"
              },
              "items": [
                {
                  "text": "Yos 15:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.13"
              },
              "items": [
                {
                  "text": "Abac 1:13",
