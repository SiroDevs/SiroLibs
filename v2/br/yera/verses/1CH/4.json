        },
        {
          "text": "Abākomōtse kuri Yuda ni Peresi na Hesironi na Karumi na Huri na Shobali. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.1",
            "verseOrgIds": [
              "1CH.4.1"
            ]
          }
        },
