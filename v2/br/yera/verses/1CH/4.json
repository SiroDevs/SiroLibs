            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.17"
              },
              "items": [
                {
                  "text": "30:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bageseza amasigarira y’Abamaleki bāri bārarokotse, baca babayo gushitsa na bugingo n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.4.43",
            "verseOrgIds": [
