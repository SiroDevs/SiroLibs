              "items": [
                {
                  "text": "1 Ngo 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebuweli wo mu ba Gerushomu mwene Mose ni we yabaye umukuru w’ububiko bgose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.24",
            "verseOrgIds": [
              "1CH.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.17"
              },
              "items": [
                {
                  "text": "1 Ngo 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.24.21"
              },
              "items": [
                {
                  "text": "24:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’i wabo bo kuri Eliyezeri n’aba: umuhungu wiwe ni Rehabiya, uwa Rehabiya ni Yeshaya, uwa Yeshaya ni Yoramu, uwa Yoramu ni Zikuri, uwa Zikuri ni Shelomoti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.25",
            "verseOrgIds": [
              "1CH.26.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 26:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.8.11"
              },
              "items": [
                {
                  "text": "2 Sam 8:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shelomoti uwo, na bagenzi biwe, ni bo bājejwe ububīko bgose burimw’ ivyeguriwe Uhoraho, ivyo umwami Dawidi yātanze, bo n’abakuru bo mu mazu ya ba sekuruza, n’abagabisha bagaba ibihumbi n’abagaba amajana, n’abagabisha b’ingabo zose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.26",
            "verseOrgIds": [
              "1CH.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bākūye mu masahu bāsahuye mu ntambara, babitangakw inyegu ngo bibīkirwe kuzohora bitunganya ingoro y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.27",
            "verseOrgIds": [
              "1CH.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ivyo Samweli kamenyi, na Sauli mwene Kishi, na Abuneri mwene Neri, na Yowabu umwana wa Seruwiya bātanzekw inyegu vyose, mbere ikintu cose umuntu yeguriye Uhoraho, cāgabga na Shelomoti na bagenzi biwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.28",
            "verseOrgIds": [
              "1CH.26.28"
            ]
          }
        }
      ]
    },
