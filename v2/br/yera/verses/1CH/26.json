              },
              "items": [
                {
                  "text": "Neh 11:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ba Isuhari, Kenaniya n’ abahungu biwe ni bo bākora ivyerekeye ku vy’igihugu, bakaba abashingantahe n’abacamanza mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.29",
            "verseOrgIds": [
              "1CH.26.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 26:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ba Heburoni, Hashabiya na bagenzi biwe, abantu b’abahizi igihumbi n’amajana ndwi, ni bo bāgaba Abisirayeli bo hakuno ya Yorodani i burengerazuba, ku bikorwa vyose vy’ Uhoraho no ku bikorwa vy’umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.30",
            "verseOrgIds": [
              "1CH.26.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.81"
              },
              "items": [
                {
                  "text": "1 Ngo 6:81",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.24.23"
              },
              "items": [
                {
                  "text": "24:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yeriya ni we yar’ umukuru w’aba Heburoni iyo bava bakagera, uk’ urunganwe rwabo rwangana n’ukw amazu ya ba sekuruza yangana. Mu mwaka ugira mirongwine Dawidi ari ku ngoma ni ho bābiseranguye, basanga muri bo ko har’ abantu b’abahizi i Yazeri h’i Gileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.31",
            "verseOrgIds": [
              "1CH.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.19.11"
              },
              "items": [
                {
                  "text": "2 Ngo 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bagenzi biwe bār’ ibihumbi bibiri n’amajana ndwi, abantu b’ abahizi, abakuru bo mu mazu ya ba sekuruza; ni bo umwami Dawidi yagize ababgiriza ku Bareyubeni n’Abagadi n’ab’ igihimba c’umuryango w’Abamanase, ngo bababgirize mu biherereye ku vy’ Imana no mu biherereye ku vy’i bgami.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.26.32",
            "verseOrgIds": [
              "1CH.26.32"
            ]
          }
        }
