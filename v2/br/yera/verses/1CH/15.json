          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.6.16"
              },
              "items": [
                {
                  "text": "2 Sam 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ iyo sandugu y’isezerano ry’Uhoraho igitamaje ku murwa wa Dawidi, Mikali umukobga wa Sauli arungurukira mw idirisha, abona umwami Dawidi yiyereka yiginagura; amugayira mu mutima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.29",
            "verseOrgIds": [
              "1CH.15.29"
            ]
          }
        }
