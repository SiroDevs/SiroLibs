            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bga bundi mutāyireruye, ni co catumye Uhoraho Imana yacu aduhwikira, kuko tutayigenjeje nk’uko vyashinzwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.13",
            "verseOrgIds": [
              "1CH.15.13"
