            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Dawidi yiyubakira amazu ku murwa wiwe, atunganya n’ah’ isandugu y’Imana izoba, ayishingira ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.1",
            "verseOrgIds": [
              "1CH.15.1"
            ]
          }
        },
