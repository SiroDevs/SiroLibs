              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi abarira abakuru bo mu Balewi gutora abaririmvyi mu b’i wabo, ngo bazane ivyo kuvuza, amakembe n’inanga n’ivyitwa matowazi, babivuze baririmbana umunezero. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.16",
            "verseOrgIds": [
              "1CH.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 15:17"
          },
