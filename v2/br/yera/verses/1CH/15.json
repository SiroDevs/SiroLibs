                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi n’abakuru b’ Abisirayeli n’abagabisha bagaba ibihumbi baja kudūgana iyo sandugu y’isezerano ry’Uhoraho, bayikūra kwa Obed‐edomu banezerewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.25",
            "verseOrgIds": [
              "1CH.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
