              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo baherezi n’Abalewi bariyeza, kugira ngo babone kudūgana iyo sandugu y’Uhoraho Imana y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.14",
            "verseOrgIds": [
