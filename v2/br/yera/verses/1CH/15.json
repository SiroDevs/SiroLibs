                "loc": "1CH.16.6"
              },
              "items": [
                {
                  "text": "1 Ngo 16:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shebaniya na Yoshafati na Netaneli na Amasayi na Zekariya na Benaya na Eliyezeri abaherezi ni bo bāgenda bavuza inzumbete imbere y’iyo sandugu y’Imana; Obed‐edomu na Yehiya na bo bār’ abashibamyi b’iyo sandugu nyene.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.24",
            "verseOrgIds": [
              "1CH.15.24"
            ]
          }
        }
