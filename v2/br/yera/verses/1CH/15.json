            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababarira, ati Ni mwebge bakuru mu mazu ya ba sogokuruza b’Abalewi; nuko ni mwiyeze, mwe na bagenzi banyu, kugira ngo mubone kuja kudūgana isandugu y’Uhoraho Imana y’Abisirayeli, muyishire aho nayitunganirije; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.12",
            "verseOrgIds": [
              "1CH.15.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 15:13"
