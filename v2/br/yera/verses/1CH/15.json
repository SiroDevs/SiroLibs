            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi ahamagaza Sadoki na Abiyatari abaherezi, ahamagaza n’abo mu Balewi, Uriyeli na Asaya na Yoweli na Shemaya na Eliyeli na Aminadabu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.15.11",
            "verseOrgIds": [
              "1CH.15.11"
            ]
          }
        },
