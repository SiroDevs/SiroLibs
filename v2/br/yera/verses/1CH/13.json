            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.6.21"
              },
              "items": [
                {
                  "text": "1 Sam 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1"
              },
              "items": [
                {
                  "text": "7:1",
