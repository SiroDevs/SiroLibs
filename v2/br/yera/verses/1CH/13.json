          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi aja inama n’ abagabisha bagaba ibihumbi n’abagaba amajana, mbere n’umukuru wese. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.1",
            "verseOrgIds": [
              "1CH.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.35.2+NUM.35.3+NUM.35.4+NUM.35.5"
              },
              "items": [
                {
                  "text": "Guh 35:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi abarira ikoraniro ryose ry’Abisirayeli, ati Ni mwumva mubishimye, kandi namba bivuye k’Uhoraho Imana yacu, dutume hose kuri bagenzi bacu basigaye mu ntāra zose z’i Bgisirayeli, no ku baherezi n’Abalewi bari mu bisagara vyabo bifise amaragiro, kugira ngo bakoranire aho turi; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.2",
            "verseOrgIds": [
              "1CH.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.1"
              },
              "items": [
                {
                  "text": "1 Sam 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.7.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.14.18"
              },
              "items": [
                {
                  "text": "14:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "duheze tuje kugarukana isandugu y’Imana aho turi; kuko tutāyibabaye ku ngoma ya Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.3",
            "verseOrgIds": [
              "1CH.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abahakoraniye bose baravyemera, kukw abantu bose bashimye iyo nama.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.13.4",
            "verseOrgIds": [
              "1CH.13.4"
            ]
          }
        }
      ]
    },
