              "items": [
                {
                  "text": "Kuv 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni wabona indogoba y’ uw’ i wanyu cank’ inka yiwe itemvye ku nzira, ntuz’ upfe kwirengagiza: ntuz’ ubure kumufasha kuyivyura.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.4",
            "verseOrgIds": [
              "DEU.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.4",
            "verseOrgIds": [
              "DEU.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire izinamukobga yambarana impuzu n’izinamuhungu, canke ngo hagire izinamuhungu yambarana n’izinamukobga: kuk’ ūkoze ivyo wese aba abaye ikizira k’Uhoraho Imana yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.5",
            "verseOrgIds": [
              "DEU.22.5"
            ]
          }
        }
      ]
    },
    {
