            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impuzu zanyu mwambara, muze muzitere ubuyonga mu mitwe yazo ukw ar’ ine.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.12",
