              "items": [
                {
                  "text": "Yoh 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yafatwa aryamanye n’umugore w’uwundi, baze babice bompi: abo ukw ari babiri, uwo mugabo yaryamanye n’ uwo mugore, na nya mugore nyene, bapfe; ukw az’ abe ari ko mukūra ikibi muri mwebge Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.22",
            "verseOrgIds": [
              "DEU.22.22"
            ]
          }
        }
