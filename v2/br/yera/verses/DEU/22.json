              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.24",
            "verseOrgIds": [
              "DEU.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umuntu ni yasanga umukobga mu gahinga, kand’ ar’ uwasabge, akamugōbēra, agasambana na we; uwo mugabo yasambanye na we az’ abe ari we apfa wenyene: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.25",
            "verseOrgIds": [
              "DEU.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "arik’ uyo mukobga ntimuze mugire ico mumugira, kukw ata caha azoba yakoze co kumwicisha: kukw ivyiwe bizoba bibaye nk’uk’ umuntu avira hasi uwundi, akamwica. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.26",
            "verseOrgIds": [
              "DEU.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uyo mugabo azoba yamusanze mu gahinga, uyo mwigeme akazoba yaravugije induru, hakabura ikimutabara.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.27",
            "verseOrgIds": [
              "DEU.22.27"
            ]
          }
        }
      ]
    },
