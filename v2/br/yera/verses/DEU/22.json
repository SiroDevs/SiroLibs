          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire uwambara impuzu ijishwe mu nyuzi z’ubgoko bubiri, nk’iz’ ubgoya bg’intama n’iziva ku giti citwa pishita.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.11",
