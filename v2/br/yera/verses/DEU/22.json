                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yasanga umukobga akizigamye ubgigeme bgiwe, kand’ ataribgasabge, akamufata, agasambana na we, bakabaserukako; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.28",
            "verseOrgIds": [
              "DEU.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyo mugabo azoba yasambanye na we az’ ahe se w’uyo mukobga inkwano ya shekeli z’ ifeza mirongwitanu, uyo aheze abe umugore wiwe, kuko yamwononye; az’ arinde apfa atamwirukanye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.29",
            "verseOrgIds": [
              "DEU.22.29"
            ]
          }
        }
      ]
