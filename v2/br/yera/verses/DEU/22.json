            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze hagire ūsukiranya imbuto z’imiryango ibiri mu ruzabibu rwiwe, imyimbu yose ikazohava ihinduka inyegu y’Ahēra, ar’ iy’ izo mbuto yarimye, ar’ iy’ imizabibu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.9",
            "verseOrgIds": [
              "DEU.22.9"
            ]
          }
        }
