            "number": "8",
            "style": "v",
            "sid": "DEU 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni hagira uwubaka inzu nsha muri mwebge, wewe uyubaka uz’ uyikīkūzekw igikugiro hejuru co gutangīra umuntu, ntakoroke, bigahava bizanira inzu yawe guharūrwakw amaraso y’uno akorotse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.8",
            "verseOrgIds": [
              "DEU.22.8"
            ]
          }
        }
      ]
