        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.13"
              },
              "items": [
                {
                  "text": "Gus 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.20"
              },
              "items": [
                {
                  "text": "19:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bose bazovyumva, batinye, boye kwongera gukorera ikibi kingana girtyo hagati muri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.11",
            "verseOrgIds": [
              "DEU.13.11"
            ]
          }
        }
