              "items": [
                {
                  "text": "Gus 17:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muze mubibariritse, mubicishe agace, mubihwēbūtse mushirutse umwete. Maze ni mwasanga ar’ ivy’ ukuri, ata mazinda, yuk’ ubuyobe bungana burtyo bukorerwa hagati muri mwebge; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.14",
            "verseOrgIds": [
              "DEU.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntimuze mubure kuririkisha inkota ababa mur’ ico gisagara, mugitikizanye n’ ibirimwo vyose, muririkishe inkota amasho yaho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.15",
