        },
        {
          "text": "Muri mwebge ni hāduka umuvugishwa cank’ umurōsi, akabaha ikimenyamenya cank’ akababarira igitangaza, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.1",
            "verseOrgIds": [
              "DEU.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
