            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.7"
              },
              "items": [
                {
                  "text": "Gus 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ntuz’ ubure kumwica: ukuboko kwawe az’ abe ari kwo gutangura kumwica, maze habone gukurikirako n’ abandi bantu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.9",
            "verseOrgIds": [
              "DEU.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kumwica, uz’ umwicishe amabuye, kuko yagerageje kugukwegakwega ng’ uve k’Uhoraho Imana yawe, yagukūye mu gihugu ca Egiputa, mu nzu y’ubuja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.10",
            "verseOrgIds": [
              "DEU.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
