            }
          ]
        },
        {
          "text": "Ni mwaramuka mwumvise inkuru mu gisagara kimwe mu vyo Uhoraho Imana yanyu agiye kuzobaha ngo mubibemwo, bavuga, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.12",
            "verseOrgIds": [
              "DEU.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati Hādutse abagesera muri mwebge bariko barakwegakwega abo mu gisagara cabo, bat’ Ingo tugende, dusabe izindi mana, kand’ ar’ izo mutigeze kumenya; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.13",
            "verseOrgIds": [
              "DEU.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 13:14"
          },
