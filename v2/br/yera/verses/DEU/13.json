              "items": [
                {
                  "text": "1 Kor 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uwo muvugishwa cank’ uwo murōsi baze bamwice, kukw azoba avuze ibibatera kugarariza Uhoraho Imana yanyu, n’ivyo kubakūra mu nzira Uhoraho Imana yanyu yabarangiye ngo muyicemwo, kand’ ari we yabakūye mu gihugu ca Egiputa, akabagobōtora, akabakūra mu nzu y’ ubuja. Uko az’ abe ari ko mukūra ikibi hagati muri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.5",
            "verseOrgIds": [
              "DEU.13.5"
            ]
          }
        }
