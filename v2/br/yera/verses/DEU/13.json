                "loc": "DEU.6.14"
              },
              "items": [
                {
                  "text": "Gus 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ar’ imana zo mu mahanga abakīkije, namb’ ar’ ayoba hafi yanyu canke ya kure, uhēreye ku mpera y’isi, ugashitsa ku yindi); ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.7",
            "verseOrgIds": [
              "DEU.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "wewe wohejwe ntuz’ umwemerere, ntuz’ umwumvire; ntuz’ umugirire akagongwe, canke ng’umugirire ikibabarwe, canke ng’ umuhishīre; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.13.8",
            "verseOrgIds": [
              "DEU.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 13:9"
          },
          "items": [
