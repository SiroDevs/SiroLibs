              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mugire imisi mikuru y’insāgo kumara imisi ndwi, ni mwaheza kubīka imihūre mwāhūriye ku mbuga, no kwengūra vino zo mu mato yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.13",
            "verseOrgIds": [
              "DEU.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
