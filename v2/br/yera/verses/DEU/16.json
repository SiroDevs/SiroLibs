            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze muharūre amasabato ndwi; muyaharūre muhereye igihe mutanguriye guha amahonda umuhoro. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.9",
            "verseOrgIds": [
