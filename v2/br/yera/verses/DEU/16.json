          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.16"
              },
              "items": [
                {
                  "text": "Lew 23:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.26"
              },
              "items": [
                {
                  "text": "Guh 28:26",
