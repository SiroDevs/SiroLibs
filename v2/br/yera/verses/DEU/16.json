                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.16.2"
              },
              "items": [
                {
                  "text": "1 Kor 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi ukurikira ayo masabato ndwi muze muwugire mukuru wo kuninahaza Uhoraho Imana yanyu, mu gutanga amashikanwa, muyatanze nk’uko muvyigombeye, nk’ukw azoba yarabahaye umugisha; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.10",
            "verseOrgIds": [
              "DEU.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.18"
              },
              "items": [
                {
                  "text": "Gus 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muheze munezererwe imbere yiwe, Uhoraho Imana yanyu, ha hantu nyene azoba yātoranije ngw ahashire izina ryiwe ngo rihabe, munezeranwe n’ abahungu banyu n’abakobga banyu, n’abagurano banyu n’abaguranokazi banyu, n’Abalewi baba i wanyu, n’inyambukīra n’ impfuvyi n’abapfakazi baba muri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.11",
            "verseOrgIds": [
              "DEU.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.15.15"
              },
              "items": [
                {
                  "text": "Gus 15:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muze mwibuke yuko mwari mu buja muri Egiputa, mwitondere ayo mabgirizwa, muyashitse.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.12",
            "verseOrgIds": [
              "DEU.16.12"
            ]
          }
        }
