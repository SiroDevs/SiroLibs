                "loc": "EXO.13.4"
              },
              "items": [
                {
                  "text": "Kuv 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukwezi kwa Abibu muze mwame mukugira gukuru, mwitondere ivya Pasika y’Uhoraho Imana yanyu; kuko mu kwezi kwa Abibu ari ho Uhoraho Imana yanyu yahenze mw ijoro akabakūra muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.1",
            "verseOrgIds": [
              "DEU.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.5"
              },
              "items": [
                {
                  "text": "Gus 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mutange ivya Pasika, mubihe Uhoraho Imana yanyu kw ikimazi, mubikūye mu mikuku yanyu no mu masho yanyu, mubitangire ahantu Uhoraho azoba yātoranije ngw ahashire izina ryiwe ngo rihabe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.2",
            "verseOrgIds": [
              "DEU.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mugire imitsima yambiwe mubikoza; muze mumare imisi ndwi murya imitsima itambiwe yavyo, ari yo mitsima y’ amagorwa, kuko mwavuye mu gihugu ca Egiputa ikibiriraho; kugira ngw imisi yose muzoba mukiriho, muze mwame mwibuka wa musi mwaviriye mu gihugu ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.3",
            "verseOrgIds": [
              "DEU.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ iyo misi ukw ar’ indwi ntihaze hagire icitwa umwambiro kibabonekamwo, mu gihugu canyu cose; kandi ku kimazi muzotanga ku musi wa mbere ku mugoroba, ntihaze hagire inyama zaco zirāra ngo zishitse mu gitondo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.4",
            "verseOrgIds": [
              "DEU.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mutangire ikimazi ca Pasika mu gisagara na kimwe mu vyo Uhoraho Imana yanyu azobaha: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.5",
            "verseOrgIds": [
              "DEU.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw ahantu Uhoraho Imana yanyu azoba yātoranije ngw ahashire izina ryiwe ngo rihabe, az’ abe ari ho mutangira ico kimazi ca Pasika ku mugoroba, ku kirengazuba, ari co gihe nyene mwaviriye muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.6",
            "verseOrgIds": [
              "DEU.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu nyene Uhoraho Imana yanyu azoba yātoranije az’ abe ari ho mutara inyama zaco, muhazirīre; mu gitondo muheze muhindukire, musubire mu mahema yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.7",
            "verseOrgIds": [
              "DEU.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imitsima itambiwe iz’ ibe ari yo murya kumara imisi itandatu; maze ku wugira indwi muze mugire ikoraniro ry’agahebuza, mushengereye Uhoraho Imana yanyu; ntihaze hagire igikorwa muwukorako.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.16.8",
            "verseOrgIds": [
              "DEU.16.8"
            ]
          }
        }
      ]
    },
