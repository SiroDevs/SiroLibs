                "loc": "JOS.20.7"
              },
              "items": [
                {
                  "text": "Yos 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.20.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni mwitondera ibi vyagezwe vyose mbagera uyu musi, mukabishitsa, mugakunda Uhoraho Imana yanyu, mukāma mugendera mu nzira ziwe, azokibaha; maze muze muheze mwironderere ibindi bisagara bitatu, mubigereke kuri vya bindi bitatu vyari bisanzwe; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.9",
            "verseOrgIds": [
              "DEU.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngw amaraso y’abatācumuye ntaz’ avishirizwe mu gihugu canyu, ico Uhoraho Imana yanyu abahaye kw ishamvu, ayo maraso akazohava abakora. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.10",
            "verseOrgIds": [
              "DEU.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 19:11"
