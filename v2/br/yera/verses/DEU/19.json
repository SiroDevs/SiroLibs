              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mumugirire akagongwe, arikw amaraso y’ūtācumuye muze muyīkūreko mwebge Abisirayeli, kugira ngo mubone kuba mu vyiza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.13",
