            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Imana yanyu ni yasunika hirya imbibe zanyu, nk’uko yasezeraniye ba sogokuruza banyu arahira, akabaha igihugu cose yabasezeraniye; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.8",
            "verseOrgIds": [
              "DEU.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
