              "items": [
                {
                  "text": "Yos 20:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muze mwirobanurire ibisagara bitatu hagati mu gihugu canyu, ico Uhoraho Imana yanyu abahaye ngo mucegukire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.2",
            "verseOrgIds": [
              "DEU.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze muharure amabarabara ajayo, kand’ ico gihugu Uhoraho Imana yanyu abahaye kw ishamvu, muze mukigabanye mu bihimba bitatu, kugira ng’ umukoracumu abone guhungira mu gisagara kimwe mur’ ivyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.19.3",
            "verseOrgIds": [
              "DEU.19.3"
            ]
          }
        }
      ]
    },
    {
