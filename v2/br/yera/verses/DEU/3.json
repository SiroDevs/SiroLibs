                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "twegukira n’ibisagara vyo mu kiyaya cose, n’i Gileyadi hose, n’i Bashani hose, gushitsa i Saleka n’ahitwa Edireyi, ibisagara vy’i Bashani mu gihugu ca Ogi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.10",
            "verseOrgIds": [
              "DEU.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.11"
              },
              "items": [
                {
                  "text": "Gus 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.2.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.26"
              },
              "items": [
                {
                  "text": "2 Sam 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Kand’ uyo Ogi, umwami w’i Bashani, ni we wenyene yar’ agasigarira k’Abarefa. Uburiri bgiwe bgar’ ubg’ icuma: mbega ntibukir’ i Raba mu Bamoni no kugeza n’ubu? Uburebure bgabgo bgar’ amatambge cenda y’ukuboko uciriye mu nkokora, ubgaguke bgar’ amatambge ane, nk’ukw itambge ry’ ukuboko risanzwe rireha.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.11",
            "verseOrgIds": [
              "DEU.3.11"
            ]
          }
        }
      ]
    },
    {
