              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe ninginga Uhoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
            ]
