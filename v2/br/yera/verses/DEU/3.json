                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe tumaze gushikīra ico gihugu, ngiha Abareyubeni n’ Abagadi, uhereye kuri Aroweri ho ku mwonga wo kuri Arunoni, n’ igice c’umugamba w’i Gileyadi, bo n’ibisagara vyaho; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.12",
            "verseOrgIds": [
              "DEU.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.29+JOS.13.30+JOS.13.31"
              },
              "items": [
                {
                  "text": "Yos 13:29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihimba c’umuryango wa Manase ndagiha ikindi gice gisigaye c’i Gileyadi, n’i Bashani hose mu gihugu ca Ogi, ari yo ntāra yose yo muri Arugobu. Aho i Bashani hose bahita igihugu c’ Abarefa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.13",
            "verseOrgIds": [
              "DEU.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.41"
              },
              "items": [
                {
                  "text": "Guh 32:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.13"
              },
              "items": [
                {
                  "text": "Yos 13:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Yayiri umwuzukuruza wa Manase ni we yanesheje iyo ntāra yose yo muri Arugobu, ari ho i Bashani, gushitsa ku rubibe rw’Abageshuri n’ Abanyamayaka: ibisagara vyaho avyitiranya n’izina ryiwe, avyita Havoti‐yayiri, nk’uko bicitwa na bugingo n’ubu.) ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.14",
            "verseOrgIds": [
              "DEU.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
