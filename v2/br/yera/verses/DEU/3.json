        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.7",
            "verseOrgIds": [
              "DEU.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ ico gihe uko ni ko twegukiye ivyo bihugu vy’abo bami b’ Abamori bompi bāri hakuno ya Yorodani, uhereye ku mwonga wo kuri Arunoni ugashitsa ku musozi Herumoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.8",
            "verseOrgIds": [
              "DEU.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.5.23"
              },
              "items": [
                {
                  "text": "1 Ngo 5:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.29.6"
              },
              "items": [
                {
                  "text": "Zab 29:6",
                  "type": "text"
