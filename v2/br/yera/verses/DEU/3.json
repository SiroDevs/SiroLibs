                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "At’ Uradūga ku mpinga ya Pisiga, utereze amaso, urābe i burengerazuba n’i burārūko n’i bumanuko n’i burasirazuba, uharābishe amaso, kuk’ uru Yorodani utazorujabuka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
