                "loc": "PSA.42.6"
              },
              "items": [
                {
                  "text": "42:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Uwo musozi Herumoni, Abasidoni bawita Siriyoni, Abamori bawita Seniri); ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.9",
            "verseOrgIds": [
              "DEU.3.9"
            ]
          }
        },
        {
