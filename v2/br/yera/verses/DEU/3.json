                "loc": "EXO.14.14"
              },
              "items": [
                {
                  "text": "Kuv 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nti Ntimuze mubatinye; nti Kuk’ Uhoraho Imana yanyu ari we azobarwanira.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.22",
            "verseOrgIds": [
              "DEU.3.22"
            ]
          }
