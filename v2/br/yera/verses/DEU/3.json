              "items": [
                {
                  "text": "Yos 1:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nti Ndakwinginze, nyemerera njabuke ndābe ico gihugu ciza co hakurya ya Yorodani, n’uriya mugamba waho mwiza, n’i Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
