                "loc": "NUM.27.18+NUM.27.19+NUM.27.20"
              },
              "items": [
                {
                  "text": "Guh 27:18-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
