                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mpa Abamakiri i Gileyadi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.15",
            "verseOrgIds": [
              "DEU.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.2"
              },
              "items": [
                {
                  "text": "Yos 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abareyubeni n’Abagadi mbaha igihugu uhereye i Gileyadi ugashitsa ku mwonga wo kuri Arunoni, urubibe rukajana uwo mwonga gushitsa ku ruzi Yaboki, ari rwo rubibe rugarukirakw Abamoni; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.16",
            "verseOrgIds": [
              "DEU.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 3:17"
          },
          "items": [
            {
