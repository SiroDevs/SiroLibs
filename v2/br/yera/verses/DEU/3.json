            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ ico gihe ndababarira, nt’ Uhoraho Imana yanyu abahaye iki gihugu ngo mukiganze; nt’ Abahizi mwese ni mujabuke, mwitwaje ibirwanishwa, muje imbere y’Abisirayeli bagenzi banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.18",
            "verseOrgIds": [
              "DEU.3.18"
            ]
          }
        },
        {
