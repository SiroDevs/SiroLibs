                  "text": "1 Ngo 29:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nt’ Uhoraho Bgirukiro, jewe umusavyi wawe utanguye kunyereka ububasha bgawe n’ubushobozi bgawe buhambaye. Nti Mbega har’ iyindi mana, yaba iyo mw ijuru canke mw isi, yoshobora gukora ibikorwa n’ibihambaye bihwanye n’ivyo ukora? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
