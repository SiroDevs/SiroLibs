                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nt’ Arikw abagore banyu n’ abana banyu n’inka zanyu bisigare mu bisagara vyanyu mbahaye: nti Ndazi ko mufise inka nyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.19",
            "verseOrgIds": [
              "DEU.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nti Muze mushitse aho Uhoraho azohēra bagenzi banyu gushika hasi nk’uko namwe yabibahaye, bakinjira igihugu Uhoraho Imana yanyu yabahaye hakurya ya Yorodani; nti Maze muze mubone kugaruka, umuntu wese mw ishamvu yiwe nabahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.20",
            "verseOrgIds": [
              "DEU.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ ico gihe mbarira Yosuwa, nt’ Amaso yawe yiboneye ivyo vyose Uhoraho Imana yanyu yagiriye ba bami bompi: nt’ Uko ni kw azogirira abami bose b’ibihugu mugiye kujamwo hakurya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.21",
            "verseOrgIds": [
              "DEU.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
