              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.37"
              },
              "items": [
                {
                  "text": "Gus 1:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ Uhoraho arandakira kubganyu, ntiyanyemerera; arambarira, at’ Ugeze ngaho: ntiwongere kumbarira iryo jambo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
