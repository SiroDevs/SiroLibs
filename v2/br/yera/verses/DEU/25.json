                "loc": "DEU.4.40"
              },
              "items": [
                {
                  "text": "Gus 4:40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw amabuye ashitse, y’ukuri, az’ abe ari yo mugeresha; n’ingero zitwa efa zishitse, z’ ukuri, az’ abe ari zo mugeresha; kugira ngo muze murambire mu gihugu Uhoraho Imana yanyu abahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.15",
            "verseOrgIds": [
              "DEU.25.15"
            ]
          }
        },
