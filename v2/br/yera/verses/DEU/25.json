              "type": "text"
            }
          ]
        },
        {
          "text": "Ni hagira abantu bari n’ico bapfa, bakaja kubūrana, bakabacira urubanza, haze hatsinde ūrufise, hatsindwe uwakoze nabi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.1",
            "verseOrgIds": [
              "DEU.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi namb’ uyo yakoze nabi yakoze ibikwiye kumukubitisha, umucamanza avuge kw aryama, bamukubitire imbere yiwe igitigiri c’inkoni zihwanye n’ikibi yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.2",
            "verseOrgIds": [
              "DEU.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.24"
              },
              "items": [
                {
                  "text": "2 Kor 11:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashobora gushitsa ku nkoni mirongwine, ariko ntaz’ azirenze; kugira ng’ uyo w’i wanyu yoye gukēngēreka kuri mwebge, ni yazirenza, akamukubita izindi nyinshi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.3",
            "verseOrgIds": [
              "DEU.25.3"
            ]
          }
        }
      ]
    },
