                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abavukana babana, umwe ni yapfa adasize umuhungu, umugore w’uyo apfuye ntaz’ acūrwe n’ uw’ ahandi, ariko muramu we az’ abe ari we amwābīra, amucūre, amugirire ibikwiye muramu w’ umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.5",
            "verseOrgIds": [
              "DEU.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.9"
              },
              "items": [
                {
                  "text": "Ita 38:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.5"
              },
              "items": [
                {
                  "text": "Rus 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uw’ imfura azotangura kuvyara az’ abe ari we asubira mu gishingo c’uwapfuye, kugira ngw izina ryiwe ryoye kuzimangana mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.6",
            "verseOrgIds": [
              "DEU.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwo mugabo n’atākunda gucūra umugorabo, uwo mugorabo az’ aje kw irembo ry’igisagara, abarire abashingantahe, ati Muramwanje yanse guhonōra uwabo ngw izina ryiwe ntirizimangane mu Bisirayeli, ntakunze kungirira ibikwiye muramu w’umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.7",
            "verseOrgIds": [
              "DEU.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.6"
              },
              "items": [
                {
                  "text": "Rus 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bashingantahe bo mur’ ico gisagara cabo baheze bamuhamagaze, bamuhanūre; n’atemera gukūrwa kw ijambo, akavuga ati Singomba kumucūra; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.8",
            "verseOrgIds": [
              "DEU.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.12.14"
              },
              "items": [
                {
                  "text": "Guh 12:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.7"
              },
              "items": [
                {
                  "text": "Rus 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo mugorabo agende amushikīre imbere y’abo bashingantahe, amukūre inkweto mu kirenge, amucire amate mu maso, avuge, at’ Uku ni kw agirirwa, uwanse guhonōra uwo bavukana! ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.9",
            "verseOrgIds": [
              "DEU.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ inzu yiwe baze bahore bavugwa bartya mu Bisirayeli, ngw Inzu y’uwakūwe inkweto.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.10",
            "verseOrgIds": [
              "DEU.25.10"
            ]
          }
        }
      ]
    },
