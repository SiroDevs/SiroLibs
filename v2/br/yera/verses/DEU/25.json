              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagabo ni birwanira, umugore w’umwe muri bo akaza gutabara umugabo wiwe ūrikw aramukubita, agatuma ukuboko, agafata uwo mugabo epfo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.11",
            "verseOrgIds": [
              "DEU.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "nya mugore muze mumuce igikonjo, ata kagongwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.25.12",
            "verseOrgIds": [
              "DEU.25.12"
            ]
          }
        }
      ]
