          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugororotsi mwamuciriyekw iteka, muramwica, ntiyabarwanya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.6",
            "verseOrgIds": [
