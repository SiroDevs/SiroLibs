            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abāvugishijwe mw izina ry’Umwami Imana bababere icitegererezo bene Data, co kubabazwa no kwihangana. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.10",
