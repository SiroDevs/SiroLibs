                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko namwe mwihangane, mureme mu mitima, kuk’ ukuza kw’Umwami kuri hafi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.8",
            "verseOrgIds": [
              "JAS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JAS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimwidodomberanire, bene Data, kugira ngo ntimucirwekw iteka: eh’ Umucamanza ahagaze ku rugi. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.9",
            "verseOrgIds": [
              "JAS.5.9"
            ]
          }
        },
