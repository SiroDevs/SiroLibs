        {
          "text": "Eh’ ingero z’abashwabuzi bābashwaburiye imirima, izo mwabagunze, zirataka: amaborogo y’abābashwaburiye yinjiye mu matwi y’Uhoraho Nyen’ ingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.4",
            "verseOrgIds": [
              "JAS.5.4"
            ]
