            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwidibamiye mw isi, mwihaye ibibahimbara: mwifunereje mu mitima ku musi wo gukekagurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.5",
            "verseOrgIds": [
              "JAS.5.5"
            ]
          }
        },
