                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubutunzi bganyu buraboze, impuzu zanyu zirīwe n’inyenzi; ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.5.2",
            "verseOrgIds": [
              "JAS.5.2"
