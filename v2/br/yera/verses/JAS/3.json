              "JAS.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.2.18"
              },
              "items": [
                {
                  "text": "Yak 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.12"
              },
              "items": [
                {
                  "text": "1 Pet 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde muri mwebge w’umunyabgenge kandi w’umuhanga? Ni yerekanishe ibikorwa vyiwe ingeso nziza mu bugwaneza bufatanije n’ubgenge. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.13",
            "verseOrgIds": [
              "JAS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JAS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.4.31"
              },
              "items": [
                {
                  "text": "Ef 4:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko namba mugira ishari ry’inkazi mu mitima yanyu, mugakunda kwirema ibice, mwoye kwirata, mubesha, mucumura ku kuri. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.14",
            "verseOrgIds": [
              "JAS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JAS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.5"
              },
              "items": [
                {
                  "text": "Yak 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgo bgenge si bgo bgururuka buvuye mw ijuru, ariko n’ubg’ isi, n’ubg’ abantu, n’ubg’ abadayimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.15",
            "verseOrgIds": [
              "JAS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JAS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ah’ ishari riri, bo no kwirema ibice, ari ho umuvurungano uri, n’igikorwa kibi cose. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.16",
            "verseOrgIds": [
              "JAS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JAS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.11"
              },
              "items": [
                {
                  "text": "Heb 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ubgenge buva mw ijuru, irya mbere buratunganye, kandi n’ubg’ amahoro, burengenga, bukunda kugīrwa inama, bguzuye imbabazi n’imbuto nziza, ntibukekeranya, ntibugira uburyarya. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.17",
            "verseOrgIds": [
              "JAS.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JAS 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.32.17"
              },
              "items": [
                {
                  "text": "Yes 32:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.9"
              },
              "items": [
                {
                  "text": "Mat 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ imbuto zo kugororoka zibibga mu mahoro n’ababanguranya.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.18",
            "verseOrgIds": [
              "JAS.3.18"
            ]
          }
        }
      ]
