        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.3.12",
            "verseOrgIds": [
              "JAS.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
