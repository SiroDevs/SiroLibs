                "loc": "COL.1.24"
              },
              "items": [
                {
                  "text": "Kol 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma nihanganira vyose kubg’ abatoranijwe, kugira ngo na bo baronke agakiza kari muri Kristo Yesu, gafatanije n’ubgiza budashira. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.10",
            "verseOrgIds": [
              "2TI.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 2:11"
          },
          "items": [
