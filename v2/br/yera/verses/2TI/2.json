              "type": "text"
            }
          ]
        },
        {
          "text": "Wame ugira umwete wo kwiha Imana nk’uwamaze kurama, umukozi atarinda gutētērwa, aramiriza neza mw ijambo ry’ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.15",
            "verseOrgIds": [
              "2TI.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 2:16"
          },
          "items": [
