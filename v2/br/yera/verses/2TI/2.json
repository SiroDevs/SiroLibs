              "type": "text"
            }
          ]
        },
        {
          "text": "Wame wibuka Yesu Kristo, yazutse mu bapfuye, yakomotse mu ruvyaro rwa Dawidi, nk’uk’ ubutumwa nahawe buvuga: ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.8",
            "verseOrgIds": [
              "2TI.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
