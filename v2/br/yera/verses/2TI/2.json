              "items": [
                {
                  "text": "2 Kor 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri jambo n’iryo kwizerwa, ngo Namba twarapfanye na we, tuzobanaho na we; ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.11",
            "verseOrgIds": [
              "2TI.2.11"
            ]
          }
