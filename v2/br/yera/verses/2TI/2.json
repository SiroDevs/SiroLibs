                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubgo mbabarizwamwo, no kubohwa nkabohwa, nk’inkozi y’ikibi; arikw ijambo ry’Imana ntiriboshwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.2.9",
            "verseOrgIds": [
