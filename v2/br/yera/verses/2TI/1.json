                "loc": "TIT.3.5"
              },
              "items": [
                {
                  "text": "Tit 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yadukijije, ikaduhamagarisha umuhamagaro wera, udatewe n’ibikorwa vyacu, arik’ utewe n’uko yabigabiye ubgayo, kand’ utewe n’ubuntu bgayo, twaherewe muri Kristo Yesu ibihe vyose bitaraba, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.9",
            "verseOrgIds": [
              "2TI.1.9"
            ]
          }
        },
        {
