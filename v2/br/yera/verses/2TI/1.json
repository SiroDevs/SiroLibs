        },
        {
          "text": "Ni co gituma nkwibutsa gufurūra ingabire y’Imana iri muri wewe ngo yake, yagushizwemwo no kurambikwakw ibiganza vyanje. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.6",
            "verseOrgIds": [
              "2TI.1.6"
            ]
          }
        },
        {
