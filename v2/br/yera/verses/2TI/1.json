              "items": [
                {
                  "text": "2 Tim 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urazi yukw abo muri Asiya bose banteye ibitugu, mur’ abo umwe ni Fugelo na Herumogene. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.15",
            "verseOrgIds": [
              "2TI.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2TI 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami agirire abo kwa Onesiforo ikigongwe, kuko yanduhura kenshi, kandi ntiyatewe n’isoni n’umunyororo wanje, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.16",
            "verseOrgIds": [
              "2TI.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TI 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko, ashitse i Roma, agira umwete wo kundondera, arambona. ",
          "type": "text",
          "attrs": {
