              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko none bgaseruwe n’ukuboneka kw’Umukiza wacu Kristo Yesu, yahinduye urupfu ubusa, ubugingo no kutagipfa akabiserurisha ubutumwa bgiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.10",
            "verseOrgIds": [
              "2TI.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2TI 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.7"
