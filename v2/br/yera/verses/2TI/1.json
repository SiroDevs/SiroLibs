              "items": [
                {
                  "text": "1 Tim 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgo butumwa nabushiriweho kuba umuvuzi wabgo n’intumwa n’umwigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.11",
            "verseOrgIds": [
              "2TI.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2TI 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma kandi mbabazwa ntya, yamara ntibintera isoni, kuko nzi uwo nizeye, kandi nzi ntakekeranya yukw ashobora kuzigama ikibītsanyo namubīkije gushitsa kuri wa musi. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.12",
            "verseOrgIds": [
              "2TI.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2TI 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.3"
              },
              "items": [
                {
                  "text": "1 Tim 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.1"
              },
              "items": [
                {
                  "text": "Tit 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gumya icitegererezo c’amajambo mazima wanyumvanye, ukigumishe ukwizera n’urukundo rubonerwa muri Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.13",
            "verseOrgIds": [
              "2TI.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2TI 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.20"
              },
              "items": [
                {
                  "text": "1 Tim 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikibītsanyo ciza wabīkijwe, ukizigamishe Mpwemu Yera aba muri twebge.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.14",
            "verseOrgIds": [
              "2TI.1.14"
            ]
          }
        }
