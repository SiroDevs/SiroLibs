                "loc": "ACT.16.1"
              },
              "items": [
                {
                  "text": "Ivyak 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko nibutse ukwizera kutar’ ukw’ uburyarya kuri muri wewe, kwabanje kuba muri nyogokuru Lowisi no muri nyoko Ewunike: kandi ndazi ntakekeranya yuko kuri muri wewe nawe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.5",
            "verseOrgIds": [
              "2TI.1.5"
            ]
          }
        }
