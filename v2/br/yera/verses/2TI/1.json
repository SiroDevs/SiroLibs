        },
        {
          "text": "Paulo, intumwa ya Kristo Yesu, nk’ukw Imana yagomvye, intumwa yo kuvuga isezerano ry’ubugingo bubonerwa muri Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.1",
            "verseOrgIds": [
              "2TI.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2TI 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndakwandikiye Timoteyo, umwana wanje nkunda: ubuntu n’imbabazi n’amahoro bibe kuri wewe, biva ku Mana Data wa twese no kuri Kristo Yesu Umwami wacu.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.1.2",
            "verseOrgIds": [
              "2TI.1.2"
            ]
          }
        }
      ]
    },
