                  "text": "Zab 119:99",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ uzi yuk’ uhereye mu buto bgawe wamye uzi ivyanditswe vyera bishobora kukumenyesha ubgenge bgo kukuzanira agakiza gaheshwa no kwizera Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.15",
            "verseOrgIds": [
              "2TI.3.15"
            ]
          }
        },
