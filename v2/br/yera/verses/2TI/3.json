              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umenye yuko mu misi y’iherezo hazoza ibihe bigoye. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.1",
            "verseOrgIds": [
