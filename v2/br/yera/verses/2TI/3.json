                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyanditswe vyose vyahumetswe n’Imana, kandi bigira ikimazi co kwigisha umuntu, no kumuhana, no kumutunganya, no kumutoza indero nziza mu kugororoka: ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.16",
            "verseOrgIds": [
              "2TI.3.16"
            ]
          }
        },
        {
