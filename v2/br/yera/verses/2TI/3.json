            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uko Yane na Yambure bārwanije Mose, ni ko n’abo bagabo barwanya ukuri, abo n’abononekaye ubgenge, babaye ibihombe ku kwizera. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.8",
            "verseOrgIds": [
              "2TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo ntibazoshobora kurengaho: kuk’ ubusazi bgabo buzogaragarira abantu bose, nk’uk’ ubga ba bandi bgagaragaye.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.9",
            "verseOrgIds": [
              "2TI.3.9"
            ]
          }
        }
