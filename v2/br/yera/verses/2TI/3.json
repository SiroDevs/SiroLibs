          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2TI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "badakunda n’ababo, banka kwuzura, barementanya, batigarura, inkazi, badakunda ivyiza, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.3",
            "verseOrgIds": [
              "2TI.3.3"
            ]
          }
        },
        {
