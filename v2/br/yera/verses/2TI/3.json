                  "text": "1 Tim 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ng’ umuntu w’Imana abe ūshitse, afise ibimukwiye vyose, ngw akore igikorwa ciza cose.",
