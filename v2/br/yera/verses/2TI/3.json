                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abantu babi, bo n’abahūmbūzi, bazorushiriza kuba babi, bazimiza bakazimizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.13",
            "verseOrgIds": [
