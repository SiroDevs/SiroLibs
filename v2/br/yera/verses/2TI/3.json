              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw abantu bazoba bikunda gusa, bakunda amahera, bīrārīra, bībona, batukana, batumvira abavyeyi, intashima, abanegura ivy’ Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.2",
            "verseOrgIds": [
              "2TI.3.2"
            ]
          }
        },
        {
