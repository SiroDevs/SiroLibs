          ]
        },
        {
          "text": "bafise ishusho yo kwubaha Imana, ariko bahakana ubushobozi bgakwo: abameze bartyo wame ubatera ibitugu. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.3.5",
