            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yagabiye kera ko duheshwa na Yesu Kristo gucika abana bayo kubgayo, nk’uko yabigomvye bikayihimbara: ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.1.5",
            "verseOrgIds": [
              "EPH.1.5"
            ]
