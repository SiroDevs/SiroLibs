          ]
        },
        {
          "text": "kubabgira ku vy’ingeso zanyu za kera ngo mwiyambure wa muntu wa kera, abozwa n’ukwifuza kw’uruhendo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.22",
