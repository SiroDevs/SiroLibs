              },
              "items": [
                {
                  "text": "Rom 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harih’ umubiri umwe, na Mpwemu umwe, nk’uko kandi mwahamagariwe icizigiro kimwe c’ihamagarwa ryanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.4",
            "verseOrgIds": [
              "EPH.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
