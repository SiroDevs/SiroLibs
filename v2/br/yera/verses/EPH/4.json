                "loc": "COL.3.12"
              },
              "items": [
                {
                  "text": "Kol 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwiyoroheje rwose, mufise ubugwaneza, mwihangana, mubabariranira muri mu rukundo, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.2",
            "verseOrgIds": [
              "EPH.4.2"
            ]
          }
        },
