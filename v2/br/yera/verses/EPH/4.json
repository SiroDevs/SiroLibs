            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umuntu wese muri twebge yahawe ubuntu, nk’uko tugererwa ingabire ya Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.7",
            "verseOrgIds": [
              "EPH.4.7"
            ]
          }
        },
