                {
                  "text": "1 Kor 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harih’ Umwami umwe, n’ukwizera kumwe, no kubatizwa kumwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.5",
            "verseOrgIds": [
              "EPH.4.5"
            ]
          }
        },
        {
