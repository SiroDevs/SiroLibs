          ]
        },
        {
          "text": "namba mwaramwumvise, mukigishirizwa muri we nk’uk’ ukuri kwo muri Yesu kuri, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.21",
            "verseOrgIds": [
              "EPH.4.21"
            ]
