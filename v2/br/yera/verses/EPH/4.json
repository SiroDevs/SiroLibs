            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bābaye ibiti, bīshira mu ngeso z’isoni nke, gukora ibihumanya vy’uburyo bgose bifatanije n’ukwifuza. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.4.19",
            "verseOrgIds": [
              "EPH.4.19"
