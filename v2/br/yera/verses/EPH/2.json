                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe yarabagize bazima, hamwe mwari mupfuye mwishwe n’ibicumuro n’ivyaha vyanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.1",
            "verseOrgIds": [
              "EPH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
