              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.6.12"
              },
              "items": [
                {
                  "text": "Ef 6:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.3"
              },
              "items": [
                {
                  "text": "Tit 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.12.31"
              },
              "items": [
                {
                  "text": "Yoh 12:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.13"
              },
              "items": [
                {
                  "text": "Kol 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyo mwagenderamwo kera, nk’ukw ivy’ iyi si bigenda, mwumvira umwami w’abaganza ikirēre, ni we mpwemu ikorera mu bantu b’intabarirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.2",
            "verseOrgIds": [
              "EPH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EPH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.3.6"
              },
              "items": [
                {
                  "text": "Kol 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi natwe twese twahora muri bo kera mu kwifuza kw’ imibiri yacu, tugakora ivy’ imibiri n’imitima vyacu bigomba, kandi mu kameremere kacu twar’ abo kurakirwa, nk’abandi bose. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.3",
            "verseOrgIds": [
              "EPH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EPH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Imana, kukw ar’ umutunzi w’ikigongwe, kubg’ urukundo rwayo rwinshi yadukunze, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.4",
            "verseOrgIds": [
              "EPH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EPH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.24"
              },
              "items": [
                {
                  "text": "Luk 15:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.5.14"
              },
              "items": [
                {
                  "text": "Ef 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.13"
              },
              "items": [
                {
                  "text": "Rom 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe twari tugipfuye, twishwe n’ibicumuro vyacu, yatugiranye bazima na Kristo — ubuntu ni bgo bgabakijije — ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.5",
            "verseOrgIds": [
              "EPH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EPH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.10"
              },
              "items": [
                {
                  "text": "Rom 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.20"
              },
              "items": [
                {
                  "text": "Flp 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yatuzuranye na we, itwicarikana na we ahantu ho mw ijuru, turi muri Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.6",
            "verseOrgIds": [
              "EPH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EPH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.7"
              },
              "items": [
                {
                  "text": "Ef 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo mu bihe bizoza ize yerekane itunga rihebuje ry’ubuntu bgayo mu kutugirira neza muri Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.7",
            "verseOrgIds": [
              "EPH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EPH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.16"
              },
              "items": [
                {
                  "text": "Gal 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu ni bgo bgabakijije kubg’ ukwizera: na vyo nyene ntivyavuye kuri mwebge, n’ingabire y’Imana; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.8",
            "verseOrgIds": [
              "EPH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EPH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.1.29"
              },
              "items": [
                {
                  "text": "1 Kor 1:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntivyavuye ku bikorwa, kugira ngo hoye kugira uwirarira. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.9",
            "verseOrgIds": [
              "EPH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EPH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tit 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko tur’ ibiremwa vyayo, twaremewe muri Kristo Yesu ngo dukore ibikorwa vyiza, ivyo Imana yateguye kera ngo tubigenderemwo.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.10",
            "verseOrgIds": [
              "EPH.2.10"
            ]
          }
        }
      ]
    },
