                  "text": "Ef 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwibuke yuk’ ubga mbere, mwebge abanyamahanga ku rukoba, mwebge mucitwa abatākebge n’abo bitwa abākebge n’intoke ku mubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.11",
            "verseOrgIds": [
              "EPH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EPH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.4"
              },
              "items": [
                {
                  "text": "Rom 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.4.13"
              },
              "items": [
                {
                  "text": "1 Tes 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kw ico gihe mwari mutandukanye na Kristo, muri n’itandukaniro n’ihanga rya Isirayeli, mur’ injabuka ku masezerano y’ivyasezeranywe, ata co mwizigiye ku bizoba, mwari mw isi mutagira Imana Rurema. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.12",
            "verseOrgIds": [
              "EPH.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EPH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.19"
              },
              "items": [
                {
                  "text": "Yes 57:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "52:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.1.20"
              },
              "items": [
                {
                  "text": "Kol 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneho, kuko muri muri Kristo Yesu, mwebge abāri kure kera mwigijwe hafi n’amaraso ya Kristo ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.13",
            "verseOrgIds": [
              "EPH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EPH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.6"
              },
              "items": [
                {
                  "text": "Yes 9:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.28"
              },
              "items": [
                {
                  "text": "Gal 3:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.14"
              },
              "items": [
                {
                  "text": "Kol 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we mahoro yacu, kuko yahinduye ya macakubiri kuba kimwe, ahomvoye ca gisika co hagati cadutandukanya, ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.14",
            "verseOrgIds": [
              "EPH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EPH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.5.17"
              },
              "items": [
                {
                  "text": "2 Kor 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubgansi amaze kubuhinduza ubusa umubiri wiwe, ni bgo vya vyagezwe birimw’ amabgirizwa ava mu vyashinzwe; kugira ngo muri we ya macakubiri ayarememw’ umuntu umwe musha, ngw azane amahoro artyo; ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.2.15",
            "verseOrgIds": [
              "EPH.2.15"
            ]
          }
        },
