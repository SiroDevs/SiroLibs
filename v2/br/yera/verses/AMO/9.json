              "AMO.9.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.46.6"
              },
              "items": [
                {
                  "text": "Zab 46:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ Umwami Uhoraho Nyen’ ingabo ari we akora ku gihugu, kigaca gishonga, abakibamwo bose bagacura umuborogo; kigateragurwa rwose nk’uko rwa Ruzi rwiteragura, kigasubira kigahwāmīra nka rwa Ruzi rwo muri Egiputa; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.3"
              },
              "items": [
                {
                  "text": "Zab 104:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ni we yiyubakira ingoro mw ijuru, agahetera ijuru ryiwe kw isi; ni we ahamagara amazi yo mu kiyaga akayasuka kw isi; Uhoraho ni ryo zina ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.47.4"
              },
              "items": [
                {
                  "text": "Yer 47:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.5"
              },
              "items": [
                {
                  "text": "Am 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntimumbereye nk’Abanyetiyopiya, ga mwa Bisirayeli mwe? ni k’Uhoraho abaza. Mbega si jewe nadūganye Abisirayeli mbakūye mu gihugu ca Egiputa, n’Abafilisitiya nkabakūra i Kafutori, n’Abasiriya nkabakūra i Kiri? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.30.11"
              },
              "items": [
                {
                  "text": "Yer 30:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ Umwami Uhoraho atungiriye igitsūre ubgami bukora ivyaha, ati Nzoburandura mw isi; mugabo sinzorandura inzu ya Yakobo rwose, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.28"
              },
              "items": [
                {
                  "text": "Yes 30:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.22.31"
              },
              "items": [
                {
                  "text": "Luk 22:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko rāba nzobishinga, ngosorere ab’ inzu ya Isirayeli mu moko yose, nk’ibigosozwa urutaro, ariko nta gatete na kamwe kazokorokera hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.9",
            "verseOrgIds": [
              "AMO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.6.3"
              },
              "items": [
                {
                  "text": "Am 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyavyaha bose bo mu bantu banje bazokwicwa n’inkota, kand’ ari bo bavuga, bat’ Ivyago ntibizoduhamvya canke ngo duhūrire imbere.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.10",
            "verseOrgIds": [
              "AMO.9.10"
            ]
          }
        }
      ]
    },
    {
