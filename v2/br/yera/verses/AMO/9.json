            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.16+ACT.15.17+ACT.15.18"
              },
              "items": [
                {
                  "text": "Ivyak 15:16-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi nzovyura urusago rwa Dawidi rwatemvye, nzibire ibihengeri vyarwo; nongere nsanasane ahāshize harwo, ndarwubake rumere nk’uko rwahoze kera; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.11",
            "verseOrgIds": [
              "AMO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo begukire amasigarira y’Abanyedomu, n’amahanga yose yitirirwa izina ryanje, ni k’Uhoraho agize, kand’ akora ivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.12",
            "verseOrgIds": [
              "AMO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.5"
              },
              "items": [
                {
                  "text": "Lew 26:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.18"
              },
              "items": [
                {
                  "text": "Yow 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ imisi izoza, ni k’Uhoraho agize, umurimyi azogerekerana n’umwimbuzi, n’umukānyi w’inzabibu agerekerane n’ūbiba imbuto; kand’ imisozi izojējēta vino ziryoshe, n’uturambi twose tuzisendanishe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.13",
            "verseOrgIds": [
              "AMO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.4"
              },
              "items": [
                {
                  "text": "Yes 61:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.5"
              },
              "items": [
                {
                  "text": "Yer 31:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzogarukana abantu banje b’Abisirayeli bājanywe ar’ inyagano, bongere kwubaka ibisagara vyāsenyutse, babibemwo; bazotera imirima y’imizabibu, binywere vino yayo; bazorima indimiro bīrīre ivyeze muri zo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.24.6"
              },
              "items": [
                {
                  "text": "Yer 24:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzobateragira mu gihugu cabo, ntibazosubira kurandurwa mu gihugu cabo nabahaye, ni k’Uhoraho Imana yawe igize.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.15",
            "verseOrgIds": [
              "AMO.9.15"
            ]
          }
        }
      ]
    }
