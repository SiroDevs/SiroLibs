        {
          "text": "Uku ni k’Uhoraho agize, ati Kubg’ ibicumuro bitatu vy’i Gaza, mbere ni bine, sinzovyirengagiza; kuko bajanye ihanga ryose ar’ inyagano, bakabashora ku Banyedomu: ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
