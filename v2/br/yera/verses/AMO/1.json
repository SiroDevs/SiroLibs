        },
        {
          "text": "Amajambo ya Amosi wo mu bungere b’i Tekowa, y’ivyo yeretswe ku Bisirayeli ku ngoma ya Uziya umwami w’i Buyuda, no ku ngoma ya Yerobowamu mwene Yehowasi, umwami w’Abisirayeli, avyeretswe, hashira imyaka ibiri kwa gutigita kw’isi kuraza.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
