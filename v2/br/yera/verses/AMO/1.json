          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nzohenebereza ababa muri Ashidodi, bo n’uwitwaje icumu ry’ubugabe muri Ashikeloni; kandi nzotuma ukuboko kwanje ntere Ekuroni, maz’ amasigarira y’Abafilisitiya azohona, ni k’Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
