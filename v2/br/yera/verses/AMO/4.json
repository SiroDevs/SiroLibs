              "type": "text"
            }
          ]
        },
        {
          "text": "Mutange imitsima yambiwe kw ibimazi vyo gukenguruka, n’ivyo mutanga muvyigombeye ni muvyāmāmaze, mubikwize! Kukw ivyo ari vyo bibahimbara, yemwe Bisirayeli, ni k’Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.5",
            "verseOrgIds": [
              "AMO.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 4:6"
