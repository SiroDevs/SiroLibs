            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabateje ikīza nk’icateye muri Egiputa: imisore yanyu nayicishije inkota, nnyaga amafarasi yanyu; natumye umunuko ur’ aho mushagaje ubinjira mu mazuru: na ho nyene ntimwangarukako, ni k’ Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.10",
            "verseOrgIds": [
              "AMO.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
