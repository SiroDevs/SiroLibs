            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Uhoraho arahiye ukwera kwiwe, ati Rāba, imisi izobūbīra, bazobatwarisha ivyuma vy’ingobe, n’amasigarira yanyu bazoyatwarisha amagera aroba. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.2",
            "verseOrgIds": [
              "AMO.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobacisha mu vyuho, umugore wese aramirije imbere yiwe; bazobashiburira mw iboma, ni k’Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.3",
            "verseOrgIds": [
              "AMO.4.3"
            ]
          }
        }
      ]
    },
