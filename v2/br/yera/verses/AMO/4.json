          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.3.2"
              },
              "items": [
                {
                  "text": "Zek 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.23"
              },
              "items": [
                {
                  "text": "Yud 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasanganguye ibisagara bimwe vyanyu nko mu gihe jewe Imana nahenebereza Sodomu na Gomora, muba nk’ igishirīra cokowe mu muriro: na ho nyene ntimwangarukako, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.11",
            "verseOrgIds": [
              "AMO.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero nzokugira ntyo nyene, ewe Isirayeli; kandi ko nzokugira ntyo, itegure guhwana n’Imana yawe, Isirayeli we. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.12",
            "verseOrgIds": [
              "AMO.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
