                  "text": "Hag 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabateje kurumvya bo n’ururyi: isinzi ry’ imirima yanyu yakegeswe n’inzige, bo n’inzabibu zanyu, n’imisukoni yanyu, na elayo zanyu: na ho nyene ntimwangarukako, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.4.9",
            "verseOrgIds": [
              "AMO.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 4:10"
          },
          "items": [
