                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu bana banyu natoyemw’ abo nzovugisha, no mu misore yanyu abo kuba Abanaziri. Mbega si ko vyābaye, ga yemwe Bisirayeli? ni k’Uhoraho abaza. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 2:12"
          },
          "items": [
