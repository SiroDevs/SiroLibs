                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara mweho nabadūganye mbakuye mu gihugu ca Egiputa, mbarōngōra mu bugaragwa imyaka mirongwine, kugira ngo mwegukire igihugu c’Abamori nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.10",
            "verseOrgIds": [
              "AMO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 2:11"
          },
