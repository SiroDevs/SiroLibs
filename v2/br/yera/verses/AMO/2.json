              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwebge mwāhaye Abanaziri vino ngo bayinywe, mutako mubuza abo mvugisha, muti Ntimukavugishwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umve, ngira mbashikamire aho muri, nk’uk’ umukogote wuzuye ibinyankinda ushikamira hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.13",
            "verseOrgIds": [
              "AMO.2.13"
            ]
          }
        },
        {
          "name": "verse",
