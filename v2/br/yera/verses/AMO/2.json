              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūbangutse azobura ukw ahunga, n’umuhizi nta co ubuhizi bgiwe buzomumarira, n’intōre ntizoruha yikiza; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.14",
            "verseOrgIds": [
              "AMO.2.14"
