        },
        {
          "text": "Basiribangira imitwe ya ba nyarucari mu mukungugu wo hasi, bakagoreka inzira z’abicisha bugufi; umwana na se binjirana umwigeme umwe, bagatukisha izina ryanje ryera. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
