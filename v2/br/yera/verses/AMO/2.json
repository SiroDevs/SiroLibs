        },
        {
          "text": "Uku ni k’Uhoraho agize, ati Kubg’ ibicumuro bitatu vy’i Mowabu, mbere ni bine, sinzovyirengagiza; kuko baturiye amagufa y’umwami w’Abanyedomu, bayahindura nk’ishwagara. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.1",
            "verseOrgIds": [
              "AMO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.24"
              },
              "items": [
                {
                  "text": "Yer 48:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nzokwanda umuriro i Mowabu, utongore ingoro z’i Keriyoti; kandi Mowabu hazopfa har’ amaruru n’urwamo n’inzamba zivuga. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.7"
              },
              "items": [
                {
                  "text": "Yer 48:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzohahenebereza ūhaganza, ndamwicane n’abaganwa baho bose, ni k’Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
