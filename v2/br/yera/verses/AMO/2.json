                "loc": "EXO.22.26"
              },
              "items": [
                {
                  "text": "Kuv 22:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bīryāmira i ruhande y’igicaniro cose ku mpuzu z’inkizurano, kandi mu ngoro y’Imana yabo bakahanywera vino baciriye abantu kw iciru. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamar’ ari jewe naranduye Abamori imbere yabo, uburebure bgabo bgari bumeze nk’ubg’ amasederi, kandi bari bakomeye nk’ibiti vy’imyeloni; ariko nahenebereje ivyo bamye mpereye hejuru, n’imizi yabo, mpereye hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
