              },
              "items": [
                {
                  "text": "Am 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nzi ibicumuro vyanyu ingen’ ari vyinshi, n’ivyaha vyanyu ingen’ ar’ ibikomeye, yemwe abahahaza umugororotsi, mukarya ingurire, mukazibiranya abakene mu manza muri mw ishikiro ry’igisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.12",
            "verseOrgIds": [
              "AMO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.2.3"
              },
              "items": [
                {
                  "text": "Mik 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma umunyamakenga apfa kwinumira mu gihe nk’ico, kukw ar’ igihe kibi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.13",
            "verseOrgIds": [
              "AMO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.15"
              },
              "items": [
                {
                  "text": "Gus 30:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyiza abe ari vyo mushishikara, ariko s’ibibi, kugira ngo mubone kubaho: ni ho Uhoraho Imana Nyen’ ingabo azobana namwe, nk’uko mwavyibgira. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.14",
            "verseOrgIds": [
              "AMO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 5:15"
          },
          "items": [
