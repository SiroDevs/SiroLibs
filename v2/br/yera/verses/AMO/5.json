                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzinutswe imisi mikuru yanyu, ndayigaye, kandi simpimbawe na gatoya n’amakoraniro yanyu y’agahebuza. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.21",
            "verseOrgIds": [
              "AMO.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "AMO 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere naho mwonshikanira ibimazi vyoswa n’amashikanwa y’amafu, sinzovyemera; kand’ ibimasa vyanyu binuze muzanakw ibimazi vy’ ishimwe, sinzobishirako n’ijisho. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.22",
            "verseOrgIds": [
              "AMO.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "AMO 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.3"
              },
              "items": [
                {
                  "text": "Am 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkūra urwamo rw’indirimbo zanyu mu matwi, kuko ntagomba kwumva guhibongoza kw’inanga zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.23",
            "verseOrgIds": [
              "AMO.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "AMO 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw imanza ziroranye, reka zisendanishe nk’amazi, n’ukugororoka gusendanishe nk’ uruzi rudahōka. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.24",
            "verseOrgIds": [
              "AMO.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "AMO 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.42"
              },
              "items": [
                {
                  "text": "Ivyak 7:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.43"
              },
              "items": [
                {
                  "text": "43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega mwaranzaniye ibimazi n’amashikanwa mu bugaragwa ya myaka ukw ari mirongwine, yemwe ab’ inzu ya Isirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.25",
            "verseOrgIds": [
              "AMO.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "AMO 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.17"
              },
              "items": [
                {
                  "text": "Gus 32:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.46.7"
              },
              "items": [
                {
                  "text": "Yes 46:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero muzorerura Sikuti umwami wanyu, na Kiyuni, inyenyeri yanyu y’ikigirwamana, ari vyo bishushanyo mwironkeye ubganyu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.26",
            "verseOrgIds": [
              "AMO.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "AMO 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
