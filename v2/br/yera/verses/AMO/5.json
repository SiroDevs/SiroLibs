              "items": [
                {
                  "text": "9:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe yaremye inyenyeri zitwa Kilimiya na Oriyoni abe ari we mubaza; ni we ahindura igitūtu c’urupfu kigacika agatondo, n’umurango akawuhindura umwiza w’ijoro; ni we ahamagara amazi yo mu kiyaga, akayasendanisha kw isi; Uhoraho ni ryo zina ryiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.8",
            "verseOrgIds": [
              "AMO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni we atuma agatikizo gasūmira abanyenkomezi, kagashika no ku bihome bikomeye.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.9",
            "verseOrgIds": [
              "AMO.5.9"
            ]
          }
        }
      ]
    },
