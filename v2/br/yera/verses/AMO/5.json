              "items": [
                {
                  "text": "Yes 29:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banka ūhanūrira mw ishikiro ry’igisagara, bakazinukwa ūvuga ivy’ ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.10",
            "verseOrgIds": [
              "AMO.5.10"
            ]
          }
        },
