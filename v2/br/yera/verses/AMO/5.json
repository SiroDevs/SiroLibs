                "loc": "2KI.17.6"
              },
              "items": [
                {
                  "text": "2 Abam 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co kizotuma mbambukanisha mur’ inyagano hirya y’i Damasiko, ni jewe Uhoraho mbivuze, kand’ izina ryanje nd’ Imana Nyen’ ingabo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.27",
