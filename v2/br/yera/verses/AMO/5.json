              },
              "items": [
                {
                  "text": "Yak 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, ko mwasiribanze umurushwa, mukamutoza utugano twiwe; amazu mwiyubakishirije amabuye abajwe, ntimuzoyabamwo; imirima myiza y’imizabibu mwateye, ntimuzonywa vino zayo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.11",
            "verseOrgIds": [
              "AMO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
