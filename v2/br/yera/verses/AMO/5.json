          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.14"
              },
              "items": [
                {
                  "text": "Yow 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.9"
              },
              "items": [
                {
                  "text": "Rom 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanke ibibi, mukunde ivyiza, mukomeze imanza zibereye mw ishikiro ry’igisagara: kumbure Uhoraho Imana Nyen’ ingabo azohangaza amasigarira ya Yosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.5.15",
            "verseOrgIds": [
              "AMO.5.15"
            ]
          }
        },
