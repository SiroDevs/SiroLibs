                "loc": "PSA.77.20"
              },
              "items": [
                {
                  "text": "Zab 77:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yadūganye Abisirayeli abakūra muri Egiputa, abakūjey’ uwavugishwa na we, kand’ uwavugishwa na we ni we yabazigama. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.13",
            "verseOrgIds": [
              "HOS.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.17"
              },
              "items": [
                {
                  "text": "2 Abam 17:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu yarakije Uhoraho bikomeye, ni co gituma amaraso yiwe ari we azokora, kand’ Umwami wiwe azomusubiriza mu nkōko umuvumo yavumanye.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.14",
            "verseOrgIds": [
              "HOS.12.14"
            ]
          }
        }
