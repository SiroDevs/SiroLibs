              "items": [
                {
                  "text": "6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu n’Umunyakanani, umunzane w’ibinyoma uri mu kuboko kwiwe: akunda guhendana. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.19"
              },
              "items": [
                {
                  "text": "Gus 29:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.11.5"
              },
              "items": [
                {
                  "text": "Zek 11:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.3.17"
              },
              "items": [
                {
                  "text": "Ivyah 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu aravuga, ati N’ukuri nd’umukire, nironkeye ubutunzi: mu bucurumbe bganje bgose ntibazombonakw ikibi na kimwe cokwitwa icaha. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.39+LEV.23.40+LEV.23.41+LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Lew 23:39-43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.4+NEH.8.5+NEH.8.6+NEH.8.7+NEH.8.8+NEH.8.9+NEH.8.10+NEH.8.11+NEH.8.12+NEH.8.13+NEH.8.14+NEH.8.15+NEH.8.16+NEH.8.17+NEH.8.18"
              },
              "items": [
                {
                  "text": "Neh 8:4-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni jewe Uhoraho Imana yawe, uhereye igihe waviriye mu gihugu ca Egiputa; nzokwongera gutuma usubira kuba mu mahema, nk’uko vyari bimeze mu misi mikuru yashinzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.17.13"
              },
              "items": [
                {
                  "text": "2 Abam 17:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuganye n’abo navugisha, nagwije ivyo nerekanye; naciye imigani, ncishije mu bo navugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ i Gileyadi ntihar’ ibigabitanyo? Eka rwose n’abatagira ikimazi! I Gilugali bacumita amapfizi kw ibimazi: mber’ ibicaniro vyabo bimeze nk’ibihongo vyo mu busīze bgo mu ndimiro. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.5"
              },
              "items": [
                {
                  "text": "Ita 28:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.20"
              },
              "items": [
                {
                  "text": "29:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yahungiye i Padan‐Aramu, Isirayeli aca ingero umugeni, mber’ araragira kugira ngw aronke umugeni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        },
        {
