              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Isirayeli we, garuka k’Uhoraho Imana yawe; kuko wagwishijwe n’ibigabitanyo vyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.1",
            "verseOrgIds": [
              "HOS.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.50.13"
              },
              "items": [
                {
                  "text": "Zab 50:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.50.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
