            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.6.3"
              },
              "items": [
                {
                  "text": "Hos 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayeli nzomubera nk’ ikime, na we azoshurika nk’ikirungu, ashōre imizi nk’ibiti vy’i Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.5",
            "verseOrgIds": [
              "HOS.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.52.8"
              },
              "items": [
                {
                  "text": "Zab 52:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amashami yiwe azogasara, ubgiza bgiwe buse n’igiti c’umwelayo, n’ugutāmirana kwiwe kumere nk’ibiti vy’i Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.6",
            "verseOrgIds": [
              "HOS.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.91.1"
              },
              "items": [
                {
                  "text": "Zab 91:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababa mu gitūtu ciwe bazogaruka; bazobaduka nk’ingano, bashurike nk’umuzabibu: ugutāmirana kwabo kuzomera nka vino y’i Lebanoni. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.7",
            "verseOrgIds": [
              "HOS.14.7"
            ]
          }
        },
        {
          "name": "verse",
