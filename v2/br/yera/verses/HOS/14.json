            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.10.14"
              },
              "items": [
                {
                  "text": "Zab 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.16"
              },
              "items": [
                {
                  "text": "Yes 30:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.31.1"
              },
              "items": [
                {
                  "text": "31:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mut’ Abashuri si bo bazodukiza; muti Ntituzosimbira ku mafarasi; muti Kandi nta ho tuzokwongera kubarira ivyakozwe n’intoke zacu, ngo Mur’ imana zacu; muti Kuko kuri wewe ari ho impfuvyi zigirirwa imbabazi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.3",
            "verseOrgIds": [
              "HOS.14.3"
            ]
          }
        }
      ]
    },
