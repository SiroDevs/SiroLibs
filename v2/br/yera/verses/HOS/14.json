              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu azovuga, ati Turacahūriye hehe n’ibigirwamana? Naramwishuye, kandi nzomushirak’ umutima. Mmeze nk’igiti c’akajwari gitotahaye: imbuto zawe ni jewe zandurukako.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.8",
            "verseOrgIds": [
              "HOS.14.8"
            ]
          }
        }
