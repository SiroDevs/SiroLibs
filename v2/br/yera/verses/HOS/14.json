              },
              "items": [
                {
                  "text": "Heb 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mujane amajambo yo kwisaba mugaruke k’Uhoraho; mumwinginge, muti N’uduharire ibigabitanyo vyose, uduhangaze: muti Mu gishingo c’amapfizi tuzogushikanira ibimazi vy’iminwa yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.2",
            "verseOrgIds": [
              "HOS.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 14:3"
          },
