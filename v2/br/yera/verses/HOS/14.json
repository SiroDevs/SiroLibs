            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoharira ugusubira inyuma kwabo, nzobakunda urukundo rutagira akagero: kuk’ uburake bganje busubiye inyuma bubavuyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.14.4",
            "verseOrgIds": [
              "HOS.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
