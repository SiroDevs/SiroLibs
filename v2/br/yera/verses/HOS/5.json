              "attrs": {
                "loc": "JER.4.5"
              },
              "items": [
                {
                  "text": "Yer 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvugirize inzamba i Gibeya, n’urumbete i Rama: muvugirize akarūru i Betaveni; ngah’ inyuma yawe, Benyamini! ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.8",
            "verseOrgIds": [
              "HOS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu azosigara ar’ imbura ku musi wo guhanwa: namenyesheje imiryango y’Abisirayeli ibitazobura kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.9",
            "verseOrgIds": [
              "HOS.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.14"
              },
              "items": [
                {
                  "text": "Gus 19:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaganwa b’i Buyuda bahwanye n’abashingūra akarimbi k’urubibe: nzobasukak’ uburake bganje nk’amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.10",
            "verseOrgIds": [
              "HOS.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.33"
              },
              "items": [
                {
                  "text": "Gus 28:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.7.11"
              },
              "items": [
                {
                  "text": "Hos 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.12.1"
              },
              "items": [
                {
                  "text": "12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu arahahajwe, avungavunzwe n’iteka aciriweko, kuko yahurumbiye inyuma y’ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.11",
            "verseOrgIds": [
              "HOS.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.13.28"
              },
              "items": [
                {
                  "text": "Yob 13:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma mmereye Efurayimu nk’ inyenzi ku mpuzu, n’inzu ya Yuda nk’ibungwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.12",
            "verseOrgIds": [
              "HOS.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.19"
              },
              "items": [
                {
                  "text": "2 Abam 15:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.5"
              },
              "items": [
                {
                  "text": "Yes 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.6"
              },
              "items": [
                {
                  "text": "6",
