                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.14.3"
              },
              "items": [
                {
                  "text": "Hos 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe Efurayimu yabonye indwara yiwe, na Yuda abonye uruguma rwiwe, ni ho Efurayimu yagiye muri Ashuri, agatuma ku mwami Yarebu; yamara ntazoshobora kubakiza, canke ngw avūre uruguma rwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.13",
            "verseOrgIds": [
              "HOS.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.7"
              },
              "items": [
                {
                  "text": "Hos 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nzomerera Efurayimu nk’intambge, n’inzu ya Yuda nk’ umugunza w’intambge: jewe, jewe nyene nzotabagura, nīgīre; nzogenda nsēngēse, kandi nta wuzonyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.14",
            "verseOrgIds": [
              "HOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.16"
              },
              "items": [
                {
                  "text": "Yes 26:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.29.10+JER.29.11+JER.29.12"
              },
              "items": [
                {
                  "text": "Yer 29:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzogenda nisubirire i wanje, kugeza aho bazokwemerera igicumuro cabo, bakarondera mu nyonga hanje: babonye ivyago bazoca bandonderana umwete.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.5.15",
            "verseOrgIds": [
              "HOS.5.15"
            ]
          }
        }
