              },
              "items": [
                {
                  "text": "Hos 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho borera abana babo, nzobabahēkūra, ntihaze hagire umuntu asigara: mbere bazobona ibara igihe nzoba mbataye! ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.12",
            "verseOrgIds": [
              "HOS.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 9:13"
          },
          "items": [
