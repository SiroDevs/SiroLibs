              },
              "items": [
                {
                  "text": "Rom 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe nabona Abisirayeli, bari bameze nk’inzabibu ziri mu bugaragwa; ba sogokuruza nababonye bameze nk’insukoni z’isega zo ku musukoni ugitangura kwama: ariko bāgiye kuri Bayali y’i Peyori, bīyegurira ako gatētereza, bahinduka umuziro nk’ico nyene bakunze. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.10",
            "verseOrgIds": [
              "HOS.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abefurayimu na bo nyene, ubgiza bgabo buzoguruka nk’inyoni: nta wuzovyara, nta wuzogira inda, canke ngw ayisame. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.11",
            "verseOrgIds": [
              "HOS.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.15"
              },
              "items": [
                {
                  "text": "1 Sam 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.16"
              },
              "items": [
                {
                  "text": "16",
