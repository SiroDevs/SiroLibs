        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.15"
              },
              "items": [
                {
                  "text": "1 Sam 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.28.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.3"
              },
              "items": [
                {
                  "text": "Ezk 27:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana ba Efurayimu, nk’uko nababonye, bagerewe kuba iminyago: mbere Efurayimu, ubgiwe azosokorora abana biwe abahe umwicanyi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.13",
            "verseOrgIds": [
              "HOS.9.13"
            ]
          }
        }
      ]
    },
