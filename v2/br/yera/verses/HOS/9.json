                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho, n’ubahe — mbe wobaha iki? N’ubahe gukorokesha inda, n’amabere agadutse!",
          "type": "text",
          "attrs": {
            "verseId": "HOS.9.14",
            "verseOrgIds": [
              "HOS.9.14"
            ]
          }
        }
