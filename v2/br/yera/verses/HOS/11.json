              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayeli uhereye akir’ umwana naramukunda, maze mpamagara uwo mwana wanje ngw ave muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.1",
            "verseOrgIds": [
              "HOS.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
