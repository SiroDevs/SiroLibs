        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efurayimu ankikije ibinyoma, n’ab’ inzu ya Isirayeli bankikije ubugunge; ariko Yuda we aracatwarira Imana, aracar’ umwizigirwa k’Uwera.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.12",
            "verseOrgIds": [
              "HOS.11.12"
            ]
          }
        }
