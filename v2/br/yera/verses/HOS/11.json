              "items": [
                {
                  "text": "Gus 32:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noshobora nte kuguheba ga Efurayimu? Noshobora nte kugutanga ga Isirayeli? Noshobora nte kukugirira nk’i Adima? Noshobora nte kuguhindura nk’i Seboyimu? Umutima wanje ubuze uburagamo muri jewe, n’imbabazi zanje zose zirakongerejwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.8",
            "verseOrgIds": [
              "HOS.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.19"
              },
              "items": [
                {
                  "text": "Guh 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.12.6"
              },
              "items": [
                {
                  "text": "Yes 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sinzogenza nk’uk’ uburake bganje bg’inkazi buri, sinzohindukiranwa no kugeseza Efurayimu: kuko jewe nd’Imana, ntar’ umuntu; nd’ Uwera ari hagati muri wewe: sinzoza ndi n’uburake. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.9",
            "verseOrgIds": [
              "HOS.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.31.4"
              },
              "items": [
                {
                  "text": "Yes 31:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.30"
              },
              "items": [
                {
                  "text": "Yer 25:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.16"
              },
              "items": [
                {
                  "text": "Yow 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazogenda bankurikira jewe Uhoraho, nivuga nk’intambge: mbere nzokwivuga, maz’ abana bazoza bahinda agashitsi, bavuye i burengerazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.10",
            "verseOrgIds": [
              "HOS.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.8"
              },
              "items": [
                {
                  "text": "Yes 60:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.6"
              },
              "items": [
                {
                  "text": "Zek 10:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazoza bavuye muri Egiputa bahinda agashitsi nk’inyoni, no muri Ashuri bameze nk’inuma, kandi nzobabesha mu mazu yabo, ni k’Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.11.11",
            "verseOrgIds": [
              "HOS.11.11"
            ]
          }
        }
      ]
    },
