                {
                  "text": "Lew 27:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndamutangakw intete z’ifeza cumi na zitanu, n’ingero yitwa homeru ya sayiri imwe n’igice. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
