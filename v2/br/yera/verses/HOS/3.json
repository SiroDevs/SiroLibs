            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndamubarira, nt’ Uzomara imisi myinshi undorereye; ntuz’ uje mu busambanyi, ntuz’ uje ku wundi mugabo wese: nanje nzokumerera ntyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
