                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda ni muze, dusubire k’Uhoraho, kukw ari we yadutabaguye kandi ni we azotuvūra; ni we yadukubise kandi ni we azodusomōra. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.1",
            "verseOrgIds": [
              "HOS.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.71.20"
              },
              "items": [
                {
                  "text": "Zab 71:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.27"
              },
              "items": [
                {
                  "text": "Luk 24:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.44"
              },
              "items": [
                {
                  "text": "44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisi ibiri ishize azoduhēmbūra: ku musi ugira gatatu azoduhagurutsa, tube bazima imbere yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.2",
            "verseOrgIds": [
              "HOS.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.6"
              },
              "items": [
                {
                  "text": "Hos 4:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.14.5"
              },
              "items": [
                {
                  "text": "14:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.23"
              },
              "items": [
                {
                  "text": "Yow 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.2"
              },
              "items": [
                {
                  "text": "Mik 5:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda tumenye Uhoraho, tugire umwete wo kumumenya; nk’uk’ umutwenzi ata cowubuza kuza, ni ko na we azoza: azotuzako nk’imvura, nk’ imvura y’umutasuro inyosheje hasi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.3",
            "verseOrgIds": [
              "HOS.6.3"
            ]
          }
        }
      ]
    },
    {
