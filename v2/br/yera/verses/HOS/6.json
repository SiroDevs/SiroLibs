              "attrs": {
                "loc": "HOS.13.3"
              },
              "items": [
                {
                  "text": "13:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Efurayimu, mbega nkugire nte? Nawe nyene Yuda, ndakugire nte? Kuk’ urukundo munkunda rumeze nk’igipfungu co mu gatondo‐tondo, kandi nk’ urume ruta mu kanya gato. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.4",
            "verseOrgIds": [
              "HOS.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.29"
              },
              "items": [
                {
                  "text": "Yer 23:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.12"
              },
              "items": [
                {
                  "text": "Heb 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma nzobatemagurisha abavugishwa nanje; nzobicisha amajambo yo mu kanwa kanje; kand’ imanza mbaciriye zizokwira hose nk’umuco. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.5",
            "verseOrgIds": [
              "HOS.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.22"
              },
              "items": [
                {
                  "text": "1 Sam 15:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.13"
              },
              "items": [
                {
                  "text": "Mat 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.7"
              },
              "items": [
                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ imbabazi ni zo ngomba, s’ibimazi, n’ukummenya jewe Imana, kuruta ibimazi vyoshejwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.6",
            "verseOrgIds": [
              "HOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.2"
              },
              "items": [
                {
                  "text": "Gus 17:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.31.33"
              },
              "items": [
                {
                  "text": "Yob 31:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.7"
              },
              "items": [
                {
                  "text": "Hos 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bo, bishe isezerano nka Adamu: aho ni ho bāndyarukiye. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gileyadi n’igisagara c’inkozi z’ibibi, cayoberanijwe n’amaraso. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.8",
            "verseOrgIds": [
              "HOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ukw ibitero vy’abambuzi biryamira umuntu, ni k’umurongo w’abaherezi wicira abantu mu nzira ija i Shekemu: bakora ivy’ ubugesera. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nzu ya Isirayeli nahabonye ikintu c’ubuyobe: aho ni ho habonekeye ubusambanyi muri Efurayimu, ni ho Isirayeli yahumaniye. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.42.10"
              },
              "items": [
                {
                  "text": "Yob 42:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.126.1"
              },
              "items": [
                {
                  "text": "Zab 126:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.13"
              },
              "items": [
                {
                  "text": "Yow 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nawe, Yuda, urindirijwe igihe c’iyimbura, igihe nzogarukana abantu banje bajanywe ar’ inyagano.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.11",
            "verseOrgIds": [
              "HOS.6.11"
            ]
          }
        }
      ]
    }
