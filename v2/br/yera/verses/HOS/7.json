            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakigenda, nzobatega ururiba rwanje; nzobakororera hasi nk’ ibisīga vyo mu kirēre: nzobakubita, nk’uko mw ikoraniro ryabo bābibūriwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.12",
            "verseOrgIds": [
              "HOS.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.9.12"
              },
              "items": [
                {
                  "text": "Hos 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobona ibara, kuko bāgiye bāngāra bakamvako! Bazotikizwa, kuko bāncumuyeko! Naho nagomba kubacungura, ariko bo bāhavuye bandemera ibinyoma! ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.13",
            "verseOrgIds": [
              "HOS.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
