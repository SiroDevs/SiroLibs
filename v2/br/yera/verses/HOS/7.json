                "loc": "HOS.11.3"
              },
              "items": [
                {
                  "text": "Hos 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "naho namenyereje amaboko yabo nkayakomeza, ariko bangīra inama z’ibibi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.15",
            "verseOrgIds": [
              "HOS.7.15"
            ]
