              "attrs": {
                "loc": "2KI.15.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.8.4"
              },
              "items": [
                {
                  "text": "Hos 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose bashushe nk’ iziko, batsontsomera abacamanza babo; abami babo bose barahindikiranye; nta n’umwe muri bo antakambira.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.7",
            "verseOrgIds": [
              "HOS.7.7"
            ]
          }
        }
      ]
    },
    {
