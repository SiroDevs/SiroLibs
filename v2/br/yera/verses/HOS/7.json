              "items": [
                {
                  "text": "Am 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibantakambiye bivuye ku mutima, ariko baborogera ku mariri yabo: ikibakoraniriza hamwe n’indya na vino, ariko jeho barangarariza; ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.7.14",
            "verseOrgIds": [
              "HOS.7.14"
            ]
          }
        },
        {
          "name": "verse",
