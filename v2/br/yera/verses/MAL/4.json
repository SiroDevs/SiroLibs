              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umve nzobarungikira Eliya uwavugishwa nanje, uwo musi w’Uhoraho uhambaye kand’ uteye ubgoba utarashika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.5",
