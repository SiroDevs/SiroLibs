            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mweho abubaha izina ryanje izuba ry’ubugororotsi rizobarasira, rifise ugukiza mu mababa yaryo. Maze muzosohoka mukina amatavu nk’inyana zivuye mu ruhongore. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.2",
            "verseOrgIds": [
              "MAL.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAL 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muzosiribanga abanyakibi; bazoba umunyota musi y’ibirenge vyanyu ku musi nzoshinga, ni k’Uhoraho Nyen’ ingabo agize.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.4.3",
            "verseOrgIds": [
              "MAL.4.3"
            ]
          }
        }
      ]
