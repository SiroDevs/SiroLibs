                {
                  "text": "Ita 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.31"
              },
              "items": [
                {
                  "text": "49:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka aracīkāna, apfa yisāziye neza, ageze mu zabukuru, ahamvya ababo: Esau na Yakobo abana biwe baramuhamba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.29",
