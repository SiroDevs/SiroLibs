              },
              "items": [
                {
                  "text": "Ita 28:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yakobo ashika i Luzi, ari ho Beteli, ho mu gihugu c’i Kanani, bo n’abantu bose bāri kumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.6",
            "verseOrgIds": [
              "GEN.35.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 35:7"
          },
          "items": [
            {
