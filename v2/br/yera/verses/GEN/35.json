          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.59"
              },
              "items": [
                {
                  "text": "Ita 24:59",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Debora, umurezi yari yarareze Rebeka arapfa; bamuhamba hepfo y’i Beteli, musi y’igiti citwa umweloni: bacita Aloni‐bakuti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.8",
            "verseOrgIds": [
              "GEN.35.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "35:8",
              "type": "text"
            },
            {
              "text": "Aloni‐bakuti risobanurwa ng’ Umweloni w’amarira.",
              "type": "text"
            }
          ]
        }
      ]
    },
