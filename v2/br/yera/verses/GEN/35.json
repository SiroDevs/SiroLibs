            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Ita 29:31—30:24",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.17"
              },
              "items": [
                {
                  "text": "35:17",
                  "type": "text"
                }
