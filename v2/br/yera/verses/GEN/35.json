            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abahungu ba Yakobo bari cumi na babiri: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.22",
            "verseOrgIds": [
              "GEN.35.22"
            ]
          }
        },
