                "loc": "GEN.35.1"
              },
              "items": [
                {
                  "text": "Ita 35:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahubaka igicaniro, yita aho hantu Eli‐beteli: kukw ari ho Imana yamwiyerekeye, igihe yahunga mukuru we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.7",
            "verseOrgIds": [
              "GEN.35.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 35:8"
          },
          "items": [
