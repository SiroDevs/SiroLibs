        },
        {
          "text": "Imana iramubarira, iti Ni jewe Mana Ishobora vyose; urondoke, ugwire; ihanga rizogukomōkako, mbere n’igugu ry’amahanga, n’abami bazokomōka mu rura rwawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.11",
            "verseOrgIds": [
              "GEN.35.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 35:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ igihugu nemeye ko mpaye Aburahamu na Isaka nzokiguha nawe, n’uruvyaro rwawe ruzogukurikira nzorugiha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.12",
            "verseOrgIds": [
              "GEN.35.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
