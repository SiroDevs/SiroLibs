            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baragenda; Imana itera ubgoba ibisagara bibakikije, ntibakurikira bene Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.5",
            "verseOrgIds": [
              "GEN.35.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 35:6"
          },
          "items": [
            {
              "text": "6",
