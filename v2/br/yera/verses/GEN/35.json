                  "text": "Ita 17:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana imusiga aho bivuganiye, iradūga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.13",
            "verseOrgIds": [
              "GEN.35.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 35:14"
          },
          "items": [
