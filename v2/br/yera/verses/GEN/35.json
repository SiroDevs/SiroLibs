            }
          ]
        },
        {
          "text": "Igihe Yakobo yar’ agarutse avuyei Padan‐aramu, Imana yongeye kumwiyereka, iramuhezagira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.9",
            "verseOrgIds": [
              "GEN.35.9"
            ]
          }
        },
        {
