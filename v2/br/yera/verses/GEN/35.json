              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baha Yakobo ibigirwamana vy’abanyamahanga vyose bari bafise, n’impeta zari ku matwi yabo; Yakobo abizīka musi y’ igiti citwa umweloni cari hafi y’i Shekemu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.35.4",
            "verseOrgIds": [
              "GEN.35.4"
            ]
          }
        },
        {
          "name": "verse",
