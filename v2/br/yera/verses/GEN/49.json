        },
        {
          "text": "Ni ho bahamvye Aburahamu na Sara umugore wiwe; ni ho bahamvye Isaka na Rebeka umugore wiwe, kandi ni ho nahamvye Leya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.49.31",
            "verseOrgIds": [
