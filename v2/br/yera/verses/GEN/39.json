          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze shebuja yumvise amagambo umugore wiwe amubariye, y’ingen’ uwo mugurano wiwe yamugiriye, uburake bgiwe buraziriringa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.19",
