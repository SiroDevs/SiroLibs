        },
        {
          "text": "Yosefu bamumanukana muri Egiputa; maze Potifari, Umunyegiputa, umugendanyi wa Farawo, yaganza abamushibamira, amugura n’Abishimayeli bamumanukanyeyo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.39.1",
            "verseOrgIds": [
              "GEN.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
