                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoshira inyankane hagati yawe n’uyu mugore, no hagati y’uruvyaro rwawe n’urwiwe: ruzogukomeretsa umutwe, nawe uzorukomeretsa igitsintsiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.15",
            "verseOrgIds": [
              "GEN.3.15"
            ]
          }
        },
        {
