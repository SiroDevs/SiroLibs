              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muntu yita umugore wiwe Eva,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
