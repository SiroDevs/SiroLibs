        },
        {
          "text": "Inzoka yarusha ubugunge ibikōko vyose vyo mw ishamba Uhoraho Imana yaremye. Ibaza uwo mugore, iti Mbega n’ivy’ ukuri koko yukw Imana yavuze, ngo Ntimurye ku giti na kimwe co mur’ iri tongo? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.1",
            "verseOrgIds": [
              "GEN.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugore yishura iyo nzoka, at’ Ivyama ku biti vyo mur’ iri tongo twemererwa kubirya: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.2",
            "verseOrgIds": [
              "GEN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.2.17"
              },
              "items": [
                {
                  "text": "Ita 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw ivyama ku giti kiri hagati mw itongo, ni vy’Imana yatubujije, ngo ntitubiryeko, canke ngo tunabikoreko, kugira ngo twoye gupfa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.3",
            "verseOrgIds": [
              "GEN.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.3"
              },
              "items": [
                {
                  "text": "2 Kor 11:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo nzoka yishura uwo mugore, iti Haba n’intete ntimuzopfa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.4",
            "verseOrgIds": [
              "GEN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw Imana izi yuk’ umusi mwabiriyeko, amaso yanyu azokwihweza, mukamera nk’ Imana ku vyo kumenya iciza n’ikibi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.5",
            "verseOrgIds": [
              "GEN.3.5"
            ]
          }
        }
      ]
    },
