              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "rizohora rikumerera imikere n’ibitovu, arik’ uzotungwa n’ibirimano vyo mu ndimiro; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.18",
