              "text": "3:17",
              "type": "text"
            },
            {
              "text": "Adamu risobanurwa, ng’Umuntu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na we, ati Ko wumviye umugore wawe, ukarya ku giti nari narakubujije, nti Ntuze ukiryeko: uzaniye ivu umuvumo; uzokwama urya ibirivamwo ubiruhiye, imisi yose y’ukubaho kwawe; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.17",
            "verseOrgIds": [
              "GEN.3.17"
            ]
          }
        },
