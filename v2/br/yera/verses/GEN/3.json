        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.25"
              },
              "items": [
                {
                  "text": "Yes 65:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.17"
              },
              "items": [
                {
                  "text": "Mik 7:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Imana abarira iyo nzoka, ati K’ukoze ivyo, ubaye ikivume mu bitungano vyose no mu bikōko vyose vyo mw ishamba: uzohora ukwega inda hasi, uzorya umukungugu imisi yose y’ukubaho kwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.14",
            "verseOrgIds": [
              "GEN.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
