              "text": "3:20",
              "type": "text"
            },
            {
              "text": "Eva risobanurwa ng’Ūfise ubugingo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kukw ari we nyina w’abari n’ubugingo bose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.20",
            "verseOrgIds": [
              "GEN.3.20"
