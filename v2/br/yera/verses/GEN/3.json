                {
                  "text": "1 Tim 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugore abonye ico giti yukw ar’ ikibereye kuribga, kandi ko gihimbaye mu jisho, ar’ igiti co kwifuzwa kimenyesha ubgenge, yamura ku vyo camye, arabirya, ahako n’umugabo wiwe bāri kumwe, na we ararya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.6",
            "verseOrgIds": [
              "GEN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaso yabo bompi arihweza, bamenya yuko bagenda amēnya, badandikanya ibibabi vy’imisukoni, bīronkeramw’ uducocerwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.3.7",
            "verseOrgIds": [
              "GEN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
