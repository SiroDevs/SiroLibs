                  "text": "Ita 47:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosefu abigira icagezwe, kikiriho na bugingo n’ubu, yukw igihimba ca gatanu c’ivyimburwa vyo mu gihugu ca Egiputa kizoba ica Farawo: amatongo y’abaherezi yonyene ni yo atabaye aya Farawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.26",
            "verseOrgIds": [
              "GEN.47.26"
            ]
          }
        },
