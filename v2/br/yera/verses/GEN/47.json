                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.31"
              },
              "items": [
                {
                  "text": "46:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu araheza aragenda, abgira Farawo, ati Data n’abo tuvukana bashitse ino bavuye mu gihugu c’i Kanani, bo n’imikuku yabo n’amasho yabo n’ivyo bafise vyose; none bari ngaho mu gihugu c’i Gosheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.1",
            "verseOrgIds": [
              "GEN.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arobanura batanu muri bene se, abashīra Farawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.2",
            "verseOrgIds": [
              "GEN.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.33"
              },
              "items": [
                {
                  "text": "Ita 46:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.46.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo abaza bene se ba Yosefu, at’ Umwuga wanyu n’umuki? Bishura Farawo, bat’ Abasavyi bawe tur’ abama baragira, twebge ubgacu uhereye no kuri ba sogokuruza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.3",
            "verseOrgIds": [
              "GEN.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.43.1"
              },
              "items": [
                {
                  "text": "Ita 43:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi baramubarira, bati Tuzanywe no gusuhukira mur’ iki gihugu, kukw abasavyi bawe twabuze ubgatsi bg’ imikuku yacu, kukw ikigoyi ari cinshi cane mu gihugu c’i Kanani; none rero turasavye, wemerere abasavyi bawe, tube mu gihugu c’i Gosheni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.4",
            "verseOrgIds": [
              "GEN.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo abarira Yosefu, ati So n’abo muvukana ko baje kuri wewe, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.5",
            "verseOrgIds": [
              "GEN.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihugu ca Egiputa ngico: ubagerēre aharuta ahandi ubgiza, babe mu gihugu c’i Gosheni; kandi namb’ uzi abahanga muri bo, ubagire abatongore b’ inka zanje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.6",
            "verseOrgIds": [
              "GEN.47.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.6",
            "verseOrgIds": [
              "GEN.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu araheza yinjiza na se Yakobo, amushikana imbere ya Farawo: Yakobo ahezagira Farawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.7",
            "verseOrgIds": [
              "GEN.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo abaza Yakobo, at’ Imyaka umaze n’ingahe? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.8",
            "verseOrgIds": [
              "GEN.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
