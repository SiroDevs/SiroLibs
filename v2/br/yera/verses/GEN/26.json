                {
                  "text": "28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba urasuhukiye mur’ iki gihugu, nanje nzobana nawe, nguhe umugisha; kuko wewe n’ uruvyaro rwawe nzobaha ibi bihugu vyose; kandi nzokomeza indahiro narahiye Aburahamu so; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.3",
            "verseOrgIds": [
              "GEN.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "Ita 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.5"
              },
              "items": [
                {
                  "text": "15:5",
