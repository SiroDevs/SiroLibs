                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Isaka abiba mur’ ico gihugu, mur’ uwo mwaka nyene yimbura ibirenze ivyo yabivye ingero ijana. Uhoraho amuha umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.12",
            "verseOrgIds": [
              "GEN.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugabo aba umutunzi, agenda arushiriza, gushitsa aho yabereye umutunzi bihebuje. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.13",
            "verseOrgIds": [
              "GEN.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.4.4"
              },
              "items": [
                {
                  "text": "Umus 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yar’ afise ibitayega vy’imikuku n’amasho, n’abantu bahinda: atera Abafilisitiya ishari, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.14",
            "verseOrgIds": [
              "GEN.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.30"
              },
              "items": [
                {
                  "text": "Ita 21:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bituma basivya amariba yose, bayuzuza ivu, ayo abantu ba se bari barimvye, mu gihe ca se nyene Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.15",
            "verseOrgIds": [
              "GEN.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abimeleki abarira Isaka, ati Genda utuvemwo, kuk’ uturuta.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.16",
            "verseOrgIds": [
              "GEN.26.16"
            ]
          }
        }
      ]
    },
