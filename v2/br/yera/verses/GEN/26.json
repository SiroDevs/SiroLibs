          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi abantu ba Isaka baraza, bamubarira ivya rya riba bimvye, bati Turabonye amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.32",
            "verseOrgIds": [
