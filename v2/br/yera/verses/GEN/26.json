                "loc": "EXO.32.13"
              },
              "items": [
                {
                  "text": "Kuv 32:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nzogwiza uruvyaro rwawe, rungane n’inyenyeri zo kw ijuru, kand’ uruvyaro rwawe nzoruha ibi bihugu vyose; kandi mu ruvyaro rwawe ni ho amahanga yose yo mw isi azohērwa umugisha; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.4",
            "verseOrgIds": [
              "GEN.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.18"
              },
              "items": [
                {
                  "text": "Ita 22:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko Aburahamu yanyumviye, agashitsa ivyo namwihanikirije n’ amabgirizwa yanje n’ivyo nashinze n’ivyagezwe vyanje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.5",
            "verseOrgIds": [
              "GEN.26.5"
            ]
          }
        }
      ]
