            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abungere b’i Gerari batonganira ayo mazi n’ abungere ba Isaka, bat’ Aya mazi n’ayacu! Isaka yita iryo riba Eseki,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:20",
              "type": "text"
            },
            {
              "text": "Eseki risobanurwa ng’ Ubutāti.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuko bāritātiye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.20",
            "verseOrgIds": [
              "GEN.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongera kwimba irindi riba, na ryo bararitonganira: aca aryita Sitina.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:21",
              "type": "text"
            },
            {
              "text": "Sitina risobanurwa ng’ Urwanko.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.21",
            "verseOrgIds": [
              "GEN.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avayo arunguruza, yimbisha irindi riba, ryo ntibaritonganira: aca aryita Rehoboti;",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
              "GEN.26.22"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:22",
              "type": "text"
            },
            {
              "text": "Rehoboti risobanurwa ngw Ahiyaguye.",
              "type": "text"
            }
          ]
        },
        {
          "text": " aravuga, ati Noneh’ Uhoraho adushize ahiyaguye, tuzogasāra mu gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.22",
            "verseOrgIds": [
