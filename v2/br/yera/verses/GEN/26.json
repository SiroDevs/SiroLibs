                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka arababaza, ati N’iki kibazanye iyo ndi, kandi munyanka, mwaranyirukanye i wanyu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.27",
