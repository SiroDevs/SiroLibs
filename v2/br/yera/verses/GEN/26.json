              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Isaka aba i Gerari: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.6",
            "verseOrgIds": [
              "GEN.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.13"
              },
              "items": [
                {
                  "text": "Ita 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.2"
              },
              "items": [
                {
                  "text": "20:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.16"
              },
              "items": [
                {
                  "text": "24:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.29.25"
              },
              "items": [
                {
                  "text": "Imig 29:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "abantu baho bamubaza ivy’ umugore wiwe; arabishura, ati Ni mushikanje; kuko yatinye kuvuga kw ar’umugore wiwe, ngw abantu baho bomwica kubga Rebeka, kuko yari mwiza w’umunyakaranga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.7",
            "verseOrgIds": [
              "GEN.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazey’ igihe kirekire, Abimeleki umwami w’Abafilisitiya arungurukira mw idirisha, abona Isaka akinisha Rebeka umugore wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.8",
            "verseOrgIds": [
              "GEN.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki ahamagaza Isaka, aramubarira, at’ Erega biraboneka kw ar’ umugore wawe! None n’iki cakuvugishije kw ari mushikawe? Isaka aramwishura, ati N’uko natinye ko bonyica kubgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.9",
            "verseOrgIds": [
              "GEN.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.9"
              },
              "items": [
                {
                  "text": "Ita 20:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki aramwishura, at’ Ico wadukoreye ico n’ iki? Ereg’ umwe mu bantu banje yari kuryamana n’umugore wawe ata co yicura, ukaba uturemētse icaha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.10",
            "verseOrgIds": [
              "GEN.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abimeleki yihanikiriza abantu biwe bose, at’ Ūzokora kur’ uyu mugabo canke ku mugore wiwe, ntibizobura kumucisha umutwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.11",
            "verseOrgIds": [
              "GEN.26.11"
            ]
          }
        }
      ]
    },
