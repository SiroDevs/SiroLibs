            }
          ]
        },
        {
          "text": "Bukeye abantu ba Isaka bimba mur’ ico kibande, babonamw’ iriba ry’amazi adudubiza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.19",
            "verseOrgIds": [
              "GEN.26.19"
            ]
          }
        },
        {
