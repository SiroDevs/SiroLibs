              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abimeleki ava i Gerari, aja iy’ari, ari kumwe na Ahuzati umumenyekana wiwe na Fikoli umugabisha w’ingabo ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.26.26",
