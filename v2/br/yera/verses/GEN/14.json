              "items": [
                {
                  "text": "2 Sam 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atabarutse, avuye kunesha Kedolawoma n’abandi bami bāri kumwe, umwami w’i Sodomu amusanganirira mu kiyaya c’i Shave, (ni co kiyaya c’umwami).",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.17",
            "verseOrgIds": [
