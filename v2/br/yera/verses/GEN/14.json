              "items": [
                {
                  "text": "Umus 2:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu yumvise yuk’ uw’ i wabo yafashwe mpiri, ajana abanyarugo biwe bize kurwana, bāvukiye i we, amajana atatu n’icumi n’umunani, barabakurikira, babahambiriza i Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.14",
            "verseOrgIds": [
              "GEN.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu ahenga mw ijoro, abantu biwe abacamw’ ibico, barabatera barabanesha, barabakinagiza gushitsa i Hoba, ahahera i bumoso bg’i Damasiko. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.15",
            "verseOrgIds": [
              "GEN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.11"
              },
              "items": [
                {
                  "text": "Ita 14:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agarura ibintu vyose, agarura n’uw’i wabo Loti, n’ibintu vyiwe, n’abagore n’abakobga na bo, n’abandi bantu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.16",
            "verseOrgIds": [
              "GEN.14.16"
            ]
          }
        }
      ]
    },
