            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Melekisedeki umwami w’i Salemu, umuherezi w’Imana Isumba vyose, azana imitsima na vino. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.14.18",
            "verseOrgIds": [
