        {
          "text": "Aramubaza, ati Mwami Uhoraho, icommenyesha yuko nzocegukira n’iki? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.8",
            "verseOrgIds": [
              "GEN.15.8"
            ]
          }
