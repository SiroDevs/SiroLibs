              "type": "text"
            }
          ]
        },
        {
          "text": "Yābīra ivyo vyose, abihimburamwo kubiri‐kubiri, igihimba cose agitumberanya na kigenzi caco: arikw inyoni zo ntiyazihimbagura. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.10",
            "verseOrgIds": [
              "GEN.15.10"
            ]
          }
        },
        {
          "name": "verse",
