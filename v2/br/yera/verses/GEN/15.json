              "items": [
                {
                  "text": "Ita 17:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijambo ry’Uhoraho ryongera kuza kuri we, rit’ Uyo si we azotora ivyawe, arik’ ūzova mu kara kawe ni we azobitora. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.4",
            "verseOrgIds": [
              "GEN.15.4"
            ]
