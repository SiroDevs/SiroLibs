              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisīga vy’amērwe ngo bigwe kur’ iyo mivyimba, Aburamu akabigurura.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.11",
            "verseOrgIds": [
