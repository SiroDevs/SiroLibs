        },
        {
          "text": "Aburamu aramubaza, ati Mwami Uhoraho, uzompa iki, ko ngiye gupfa ata kana nsize, kand’ ūzotorana urugo rwanje akaba ari Eliyezeri Umunyadamasiko? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.2",
            "verseOrgIds": [
              "GEN.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
