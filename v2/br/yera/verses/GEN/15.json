              },
              "items": [
                {
                  "text": "Ita 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arongera, at’ Erega nta ruvyaro wampaye, kand’ umunyarugo yavukiye i wanje ni we azotora ivyanje. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.15.3",
            "verseOrgIds": [
              "GEN.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
