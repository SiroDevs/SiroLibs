          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Oholibama na Ela na Pinoni, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.41",
            "verseOrgIds": [
              "GEN.36.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "GEN 36:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kenazi na Temani na Mibusari, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.42",
            "verseOrgIds": [
              "GEN.36.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "GEN 36:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Magidiyeli na Iramu. Abo ni bo bakuru b’imiryango yakomōtse kuri Edomu ari we Esau, sekuruza w’ Abanyedomu, nk’ukw amashamvu yabo ari mu gihugu bīzīziye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.43",
            "verseOrgIds": [
