              },
              "items": [
                {
                  "text": "Ita 25:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo ruvyaro rwa Esau, ari we Edomu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.1",
            "verseOrgIds": [
              "GEN.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.34"
              },
              "items": [
                {
                  "text": "Ita 26:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau yarongoye Abanyakananikazi, Ada umukobga wa Eloni Umuheti, na Oholibama umukobga wa Ana, Ana mwene Sibeyoni Umuhiwi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.9"
              },
              "items": [
                {
                  "text": "Ita 28:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Basemati mushiki wa Nebayoti, umukobga wa Ishimayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.35"
              },
              "items": [
                {
                  "text": "1 Ngo 1:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau avyarana na Ada Elifazi; Basemati na we bavyarana Ruweli; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.4",
            "verseOrgIds": [
              "GEN.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oholibama bavyarana Yushi na Yalamu na Kora: abo ni bo bahungu ba Esau, yavyariye mu gihugu c’i Kanani.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esau akora abagore biwe n’abahungu biwe n’abakobga biwe, n’ abantu bose bo mu rugo rwiwe, n’ inka ziwe, n’ibiyevera vyiwe vyose, n’ibintu vyiwe vyose, yaronkeye mu gihugu c’i Kanani; aja mu kindi gihugu, atandukana na mwene nyina Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.6",
            "verseOrgIds": [
              "GEN.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.6"
              },
              "items": [
                {
                  "text": "Ita 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw itunga ryabo ryari ryinshi, bigatuma badashobora kubangikana; kand’ igihugu bari bararoyemw’ ar’ inyambukīra, nticabakwira kubg’ amasho yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.7",
            "verseOrgIds": [
              "GEN.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.3"
              },
              "items": [
                {
                  "text": "Ita 32:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Esau aja kuba ku musozi Seyiri: Esau ni we Edomu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo ruvyaro rwa Esau sekuruza w’Abanyedomu bo ku musozi Seyiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.9",
            "verseOrgIds": [
              "GEN.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.4"
              },
              "items": [
                {
                  "text": "Ita 36:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Esau aya ni yo mazina yabo: uwa Ada muka Esau ni Elifazi, n’uwa Basemati muka Esau ni Ruweli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.10",
            "verseOrgIds": [
              "GEN.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.36"
              },
              "items": [
                {
                  "text": "1 Ngo 1:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.1.37"
              },
              "items": [
                {
                  "text": "37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Elifazi ni Temani na Omari na Sefo na Gatamu na Kenazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.11",
            "verseOrgIds": [
              "GEN.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.24.20"
              },
              "items": [
                {
                  "text": "Guh 24:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.17+DEU.25.18+DEU.25.19"
              },
              "items": [
                {
                  "text": "Gus 25:17-19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.2"
              },
              "items": [
                {
                  "text": "1 Sam 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.15.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Timuna yar’ incoreke ya Elifazi mwene Esau: Elifazi avyarana na we Amaleki: abo ni bo buzukuru ba Ada, muka Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.12",
            "verseOrgIds": [
              "GEN.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ aba ni bo bene Ruweli: Nahati na Zera na Shama na Miza: abo ni bo buzukuru ba Basemati, muka Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.13",
            "verseOrgIds": [
              "GEN.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ aba ni bo bene Oholibama muka Esau, umukobga wa Ana, Ana mwene Sibeyoni: Esau avyarana na Oholibama Yushi na Yalamu na Kora.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.14",
            "verseOrgIds": [
              "GEN.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba ni bo bakuru b’imiryango yakomōtse ku bahungu ba Esau. Bene Elifazi imfura ya Esau, abakuru b’imiryango, n’aba: Temani, na Omari, na Sefo, na Kenazi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.15",
            "verseOrgIds": [
              "GEN.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Kora, na Gatamu, na Amaleki: abo ni bo bakuru b’imiryango yandurutse kuri Elifazi mu gihugu ca Edomu; abo ni bo buzukuru ba Ada. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.16",
            "verseOrgIds": [
              "GEN.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bene Ruweli mwene Esau, abakuru b’imiryango, n’aba: Nahati, na Zera, na Shama, na Miza: abo ni bo bakuru b’imiryango yandurutse kuri Ruweli mu gihugu ca Edomu; abo ni bo buzukuru ba Basemati muka Esau. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.17",
            "verseOrgIds": [
              "GEN.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo Esau yavyaranye na Oholibama umugore wiwe, abakuru b’imiryango n’aba: Yushi na Yalamu na Kora: abo ni bo bakuru b’imiryango yandurutse kuri Oholibama muka Esau, mwene Ana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.18",
            "verseOrgIds": [
              "GEN.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo ni bo bo mu nda ya Esau, ari we Edomu; abo ni bo bakuru b’imiryango yabo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.19",
            "verseOrgIds": [
              "GEN.36.19"
            ]
          }
        }
      ]
    },
