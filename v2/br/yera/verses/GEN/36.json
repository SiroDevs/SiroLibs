                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba ni bo bami babaye ku ngoma mu gihugu ca Edomu, hatarīma umwami mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.31",
            "verseOrgIds": [
              "GEN.36.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 36:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela mwene Beyori yaganza muri Edomu; umurwa wiwe witwa Dinihaba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.32",
            "verseOrgIds": [
              "GEN.36.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 36:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bela atanze, Yobabu mwene Zera w’i Bosira asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.33",
            "verseOrgIds": [
              "GEN.36.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 36:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yobabu atanze, Hushamu wo mu gihugu c’Abatemani asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.34",
            "verseOrgIds": [
              "GEN.36.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 36:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hushamu atanze, Hadadi mwene Bedadi, umwe yaneshereza Abamidiyani mu gihugu c’i Mowabu, asubira ku ngoma yiwe; umurwa wiwe witwa Aviti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.35",
            "verseOrgIds": [
              "GEN.36.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 36:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadi atanze, Samula w’i Masireka asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.36",
            "verseOrgIds": [
              "GEN.36.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 36:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samula atanze, Sauli w’i Rehoboti ahahera kuri rwa Ruzi, asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.37",
            "verseOrgIds": [
              "GEN.36.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 36:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli atanze, Bayali‐hanani mwene Akibori asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.38",
            "verseOrgIds": [
              "GEN.36.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "GEN 36:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayali‐hanani mwene Akibori atanze, Hadari asubira ku ngoma yiwe; umurwa wiwe witwa Pawu; umwamikazi wiwe yitwa Mehetabeli, umukobga wa Matiredi, Matiredi umukobga wa Mezahabu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.39",
            "verseOrgIds": [
              "GEN.36.39"
            ]
          }
        }
      ]
