            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni yo mazina y’abakuru b’ imiryango bandurutse kuri Esau, nk’ukw imiryango yabo iri, nk’ ukw ibihugu vyabo biri, nk’ukw amazina yabo ari: abakuru b’imiryango ni Timuna na Aliwa na Yeteti, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.40",
            "verseOrgIds": [
              "GEN.36.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
