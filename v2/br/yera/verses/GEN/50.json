            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu yubama kuri se mu maso, amuririrako, aramugūmbīra. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.1",
            "verseOrgIds": [
              "GEN.50.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 50:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu agera abantu biwe b’abaganga ngo bose se: nukw abo baganga bosa Isirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.2",
            "verseOrgIds": [
              "GEN.50.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 50:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.29"
              },
              "items": [
                {
                  "text": "Guh 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.8"
              },
              "items": [
                {
                  "text": "Gus 34:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamara imisi mirongwine bamwosa, uko ni kw imisi yo kwosa ingana: Abanyegiputa bamara imisi mirongwirindwi bamugandariye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.3",
            "verseOrgIds": [
              "GEN.50.3"
            ]
          }
        }
      ]
