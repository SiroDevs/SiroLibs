            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.16.14"
              },
              "items": [
                {
                  "text": "2 Ngo 16:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.16"
              },
              "items": [
                {
                  "text": "Yes 22:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.60"
              },
              "items": [
                {
                  "text": "Mat 27:60",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muti Se yaramurahije, at’ Ehe ngiye gupfa: uz’ umpambe mu cobo niyimbiye mu gihugu c’i Kanani. None mut’ Aragusavye, umurekure adūge, ahambe se, aheze agaruke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.5",
            "verseOrgIds": [
              "GEN.50.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 50:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Farawo aramwishura, ati Dūga, ugende uhambe so, nk’uko yakurahije.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.6",
            "verseOrgIds": [
              "GEN.50.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
