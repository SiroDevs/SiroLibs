            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisi y’ikigandaro ishize, Yosefu abarira abo mu rugo rwa Farawo, ati Ni mwaba mumbabaye, ndabasavye mumbaririre Farawo, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.50.4",
            "verseOrgIds": [
              "GEN.50.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 50:5"
          },
          "items": [
            {
              "text": "5",
