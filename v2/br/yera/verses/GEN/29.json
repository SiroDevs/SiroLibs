        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.16"
              },
              "items": [
                {
                  "text": "Kuv 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akivugana na bo, Rakeli arashika, azanye intama za se, kukw ari we yaziragira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.9",
            "verseOrgIds": [
              "GEN.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.17"
              },
              "items": [
                {
                  "text": "Kuv 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yakobo abonye Rakeli mwene Labani inarume, n’intama za inarume nyene Labani, aca yegera iriba, atembagaza ca kibuye agikūra ku munwa w’iriba, avomera umukuku wa Labani inarume, zirashōka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.10",
            "verseOrgIds": [
              "GEN.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo agūmbīra Rakeli, araheza araturika ararira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.11",
            "verseOrgIds": [
              "GEN.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.8"
              },
              "items": [
                {
                  "text": "Ita 13:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.14"
              },
              "items": [
                {
                  "text": "14:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yibarira Rakeli kw afitanye akamwe na se, kw ar’ umwana wa Rebeka: na we aca arirukanga, abibgira se.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.29.12",
            "verseOrgIds": [
              "GEN.29.12"
            ]
          }
        }
      ]
    },
    {
