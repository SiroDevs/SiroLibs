              "items": [
                {
                  "text": "1 Sam 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho agendera Sara nk’ uko yavuze, kand’ amugirira nk’uko yamubariye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.1",
            "verseOrgIds": [
              "GEN.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.21"
              },
              "items": [
                {
                  "text": "Ita 17:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.11"
              },
              "items": [
                {
                  "text": "Heb 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara asama inda, avyarana na Aburahamu umuhungu mu butāma bgiwe, mu gihe cāshinzwe, kimwe Imana yari yaramubariye nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.2",
            "verseOrgIds": [
              "GEN.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.19"
              },
              "items": [
                {
                  "text": "Ita 17:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana Aburahamu yavyaye amwita Isaka, uwo yavyaranye na Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.3",
            "verseOrgIds": [
              "GEN.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.10+GEN.17.11+GEN.17.12"
              },
              "items": [
                {
                  "text": "Ita 17:10-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.8"
              },
              "items": [
                {
                  "text": "Ivyak 7:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu akeba Isaka umwana wiwe amaze imisi munani avutse, nk’ ukw Imana yamubariye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.4",
            "verseOrgIds": [
              "GEN.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.17"
              },
              "items": [
                {
                  "text": "Ita 17:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu yar’ amaze imyaka ijana igihe yavyara umwana wiwe Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.5",
            "verseOrgIds": [
              "GEN.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.1"
              },
              "items": [
                {
                  "text": "Yes 54:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.14"
              },
              "items": [
                {
                  "text": "Luk 1:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.58"
              },
              "items": [
                {
                  "text": "58",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sara aravuga, at’ Imana irantwengeje; kand’ abazovyumva bose bizobatwenza nkanje. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.6",
            "verseOrgIds": [
              "GEN.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Har’ uwogize ico abarira Aburahamu, ngo Sara azokwonsa abana? yamar’ amvyayek’ umwana w’umuhungu mu butāma bgiwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.7",
            "verseOrgIds": [
              "GEN.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwana arakura, aracuka; ku musi Isaka yacutseko Aburahamu atumirira abantu benshi amazimano. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.8",
            "verseOrgIds": [
              "GEN.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.1"
              },
              "items": [
                {
                  "text": "Ita 16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.29"
              },
              "items": [
                {
                  "text": "Gal 4:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sara abona wa mwana wa Hagari Umunyegiputakazi, uwo yavyaranye na Aburahamu, arikw aratwenga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.9",
            "verseOrgIds": [
              "GEN.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.4.30"
              },
              "items": [
                {
                  "text": "Gal 4:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bituma abarira Aburahamu, at’ Irukana iyi ncoreke n’umwana wayo, kuk’ umwana w’iyi ncoreke atazoraganwa n’umwana wanje Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.10",
            "verseOrgIds": [
              "GEN.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu ababazwa cane n’ ivy’ uwo mwana wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.11",
            "verseOrgIds": [
              "GEN.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.7"
              },
              "items": [
                {
                  "text": "Rom 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.18"
              },
              "items": [
                {
                  "text": "Heb 11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ibarira Aburahamu, iti Reka kubabazwa n’ivy’ uwo mwana n’incoreke yawe: ivyo Sara akubariye vyose n’uvyemere: kuko kuri Isaka ari ho uruvyaro rwawe ruzokwītīrirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.12",
            "verseOrgIds": [
              "GEN.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.10"
              },
              "items": [
                {
                  "text": "Ita 16:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’uwo mwana nyene w’iyo ncoreke nzomuhindura ihanga, kuko na we ar’ ubura bgawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.13",
            "verseOrgIds": [
              "GEN.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu akoroka kare, yābīra impamba n’ umukuza w’urusato wuzuye amazi, abitekerera Hagari, abishira ku rutugu rwiwe, amuha n’uwo mwana, aramwirukana; aragenda, azimagirika mu bugaragwa bg’i Beri‐sheba.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.14",
            "verseOrgIds": [
              "GEN.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazi yari muri wa mukuza arashira; arambika umwana musi y’igisaka caho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.15",
            "verseOrgIds": [
              "GEN.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aragenda, yicara amutumbereye amwitanguye, nk’ahoraswa umwampi; kuko yari yibgiye, ati Noye kurāba ipfa ry’ umwana wanje. Nuko yicara amutumbereye, araturika ararira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.16",
            "verseOrgIds": [
              "GEN.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana yumva ijwi ry’uwo muhungu; maz’ umumarayika w’ Imana ari mw ijuru, ahamagara Hagari, aramubaza, at’ Ubaye iki ga Hagari? Nta co utinya! kukw Imana yumvise ijwi ry’uwo muhungu ah’aryamye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.17",
            "verseOrgIds": [
              "GEN.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.13"
              },
              "items": [
                {
                  "text": "Ita 21:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Va hasi, uvyure uwo muhungu, umuramire mu maboko, kuko nzomuhindura ihanga rikomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.18",
            "verseOrgIds": [
              "GEN.21.18"
            ]
          }
        },
        {
