                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo yunamura amaso, agize artya abona Esau aje, ari kumwe n’abantu amajana ane. Atandukanya abana, abaha Leya na Rakeli na za ncoreke zompi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.1",
            "verseOrgIds": [
              "GEN.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atanguza imbere izo ncoreke n’ abana bazo, akurikizako Leya n’ abana biwe, Rakeli na Yosefu abashira inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.2",
            "verseOrgIds": [
              "GEN.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.2"
              },
              "items": [
                {
                  "text": "Ita 18:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.6"
              },
              "items": [
                {
                  "text": "42:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ubgiwe abaja imbere, akubita inkoro hasi ibihetangabo ndwi, kugeza yegereye mukuru we.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.33.3",
            "verseOrgIds": [
              "GEN.33.3"
            ]
          }
        }
      ]
    },
    {
