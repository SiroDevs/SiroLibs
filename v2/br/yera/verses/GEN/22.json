          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imfura yiwe ni Usi, murumuna we ni Buzi, na we akurikirwa na Kemuweli, ari we se wa Aramu; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.21",
            "verseOrgIds": [
              "GEN.22.21"
            ]
          }
        },
        {
