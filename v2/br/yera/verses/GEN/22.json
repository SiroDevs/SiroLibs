              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Betuweli yavyaye Rebeka: abo ukw ar’ umunani Miluka yabavyaranye na Nahori murumuna wa Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.23",
            "verseOrgIds": [
              "GEN.22.23"
            ]
