              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Ndirahiye, ni k’Uhoraho agize, k’ukoze ivyo, ntunyime umwana wawe, kand’ ar’ ikinege, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.16",
            "verseOrgIds": [
