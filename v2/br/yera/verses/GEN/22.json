          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bo bakurikirwa na Kesedi na Hazo na Piludashi na Yidilafu na Betuweli. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.22.22",
            "verseOrgIds": [
              "GEN.22.22"
            ]
