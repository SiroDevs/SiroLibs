            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yakobo akomeza urugendo, maz’ abamarayika b’ Imana bahūra na we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.1",
            "verseOrgIds": [
              "GEN.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.5.14"
              },
              "items": [
                {
                  "text": "Yos 5:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.103.21"
              },
              "items": [
                {
                  "text": "Zab 103:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.2.13"
              },
              "items": [
                {
                  "text": "Luk 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ababonye, aravuga, at’ Aha ni ho ingabo z’Imana zishagaje: yita aho hantu Mahanayimu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.2",
            "verseOrgIds": [
              "GEN.32.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "32:2",
              "type": "text"
            },
            {
              "text": "Mahanayimu risobanurwa ngw Imice ibiri y’ingabo zishagaje.",
              "type": "text"
            }
          ]
        }
      ]
    },
