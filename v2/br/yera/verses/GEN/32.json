              },
              "items": [
                {
                  "text": "Ita 33:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo ntumwa zigaruka kuri Yakobo, ziti Twarashitse kwa mukurwawe Esau, non’ araje kugusanganira, kand’ azananye n’ingabo amajana ane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.6",
            "verseOrgIds": [
              "GEN.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo aca aranduka umutima, arihebūra; maz’ agabanyamwo kubiri abantu bāri kumwe na we, n’imikuku n’amasho n’ingamiya; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.7",
            "verseOrgIds": [
              "GEN.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Esau ni yaramuka aserukiye ku muce umwe akawunyaga, ūsigaye wokira.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.8",
            "verseOrgIds": [
              "GEN.32.8"
            ]
          }
        }
      ]
    },
