                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.31.3"
              },
              "items": [
                {
                  "text": "31:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yakobo aratakamba, ati Mana ya sogokuru Aburahamu, Mana ya data Isaka, ewe Uhoraho, si wewe wambariye, uti Subira mu gihugu canyu, no muri bene wanyu, uti Nanje nzokugirira neza? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.9",
            "verseOrgIds": [
              "GEN.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.18"
              },
              "items": [
                {
                  "text": "2 Sam 7:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo mbabazi zose wagiriye umusavyi wawe, n’ukuntu utampemukiye, sinari mbereye kugirirwa na bikeya; kuko najabutse Yorodani uru nitwaje akoho gusa, none nahindutse imice ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.10",
            "verseOrgIds": [
              "GEN.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.18.19"
              },
              "items": [
                {
                  "text": "Imig 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakwinginze, n’unkize, unkūre mu maboko ya mukurwanje Esau: kuko ndamutinya, yoye kuza akanyicana n’abana na ba nyina. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.11",
            "verseOrgIds": [
              "GEN.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.13+GEN.28.14+GEN.28.15"
              },
              "items": [
                {
                  "text": "Ita 28:13-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ari wewe wambariye, uti Sinzobura kukugirira neza, uti Nzohindura uruvyaro rwawe, rungane n’umusenyi wo ku kiyaga, w’isinzi utōharūrika.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.12",
            "verseOrgIds": [
              "GEN.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
