                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ku musi ugira gatatu, abo bagikanashijwe, bene Yakobo babiri, Simeyoni na Lewi, basaza ba Dina, bahitana inkota zabo, batera igisagara giturumbuka, bica abagabo baho bose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.25",
            "verseOrgIds": [
              "GEN.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bicisha Hamori inkota, n’umuhungu wiwe Shekemu, bahitana Dina mu nzu ya Shekemu, bavayo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.26",
            "verseOrgIds": [
              "GEN.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Yakobo bakoba imivyimba, basahura igisagara, babahōra kwonona mushiki wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.27",
            "verseOrgIds": [
              "GEN.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banyaga imikuku yabo n’amasho yabo n’indogoba zabo, n’ivyari mu gisagara n’ivyari mu misozi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.28",
            "verseOrgIds": [
              "GEN.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "banyaga ubutunzi bgabo bgose, bafata mpiri abana babo bose n’abagore babo, n’ivyari mu nzu vyose.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.29",
            "verseOrgIds": [
              "GEN.34.29"
            ]
          }
        }
