              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho aravuga, ati Mpwemu wanje ntazokwama aranyinyūrana n’umuntu ibihe vyose, kukw ar’ uw’ inyama gusa: nuko rer’ imisi yiwe izoba imyaka ijana na mirongwibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.3",
            "verseOrgIds": [
              "GEN.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ ico gihe hār’ibigatanya mw isi, no mu gihe co hanyuma, abana b’Imana bamaze kurongora abakobga b’abantu, bakavyarana na bo abana: ni bo ba bahizi ba kera bābaye ba rurangiranwa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.4",
            "verseOrgIds": [
              "GEN.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 6:5"
          },
          "items": [
