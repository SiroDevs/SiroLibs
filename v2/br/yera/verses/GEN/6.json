                  "text": "Am 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ibarira Nowa, iti Ndamaramaje guherengeteza abari n’ umubiri bose, kukw isi yuzuye umuryano kubgabo; nuko nzobarandurana n’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.13",
            "verseOrgIds": [
              "GEN.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wibāzire ubgato mu biti vyitwa goferu, ubucemw’ utwumba, ubuhome ishīshi imbere n’inyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.14",
            "verseOrgIds": [
              "GEN.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ ububāze urtya: uburebure bg’umurambararo bg’ubgo bgato buze bube amatambge amajana atatu y’ukuboko uciriye mu nkokora, amakika na yo az’ abe amatambge mirongwitanu, uburebure bg’igihagararo buze bube amatambge mirongwitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.15",
            "verseOrgIds": [
              "GEN.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ubgo bgato uz’ ubuce amadirisha, az’ asigaze itambge rimwe kuva ku musozo ahahera hejuru; umuryango w’ubgo bgato na wo uz’ uwushire mu rubavu rwabgo; kand’ uz’ ugerekeranye utwo twumba gatatu: utwo hasi n’utwo hagati n’utwo hejuru. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.16",
            "verseOrgIds": [
              "GEN.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.4"
              },
              "items": [
                {
                  "text": "Ita 7:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.5"
              },
              "items": [
                {
                  "text": "2 Pet 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nanje nzozana umwuzure w’amazi mw isi, ngo mperengeteze musi y’ijuru ibifise umubiri vyose, biri n’ubugingo bihumeka; ibiri mw isi vyose bizopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.17",
            "verseOrgIds": [
              "GEN.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nzoshinga isezerano nzogusezeranira: uzokwinjirana mur’ubgo bgato n’ abana bawe n’umugore n’abakazana bawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.18",
            "verseOrgIds": [
              "GEN.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu bgoko bgose bg’ibiri n’ubugingo bifise umubiri, uze winjize mur’ ubgo bgato bibiri‐bibiri, kugira ngo birokokane nawe; ivyo bibe ikigabo n’ikigore. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.19",
            "verseOrgIds": [
              "GEN.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biguruka, nk’ukw amoko yavyo ari, no mu bitungano, nk’ ukw amoko yavyo ari, no mu vyikwega hasi vyose, nk’ukw amoko yavyo ari, bibiri‐bibiri vy’amoko yose bizoza ah’ uri, ngo birokoke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.20",
            "verseOrgIds": [
              "GEN.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uze wijanire mu biribga vyose, ubiziganye, kuko bizoba ivyo kubatunga, mwe n’ivyo muri kumwe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.21",
            "verseOrgIds": [
              "GEN.6.21"
            ]
          }
        }
      ]
