            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Uhoraho abona ibibi vy’abantu ingen’ ari vyinshi mw isi, kandi kw ivyiyumviro vy’imitima yabo vyamogoreye gukora ibibi gusa na ntaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.6.5",
            "verseOrgIds": [
              "GEN.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 6:6"
          },
          "items": [
