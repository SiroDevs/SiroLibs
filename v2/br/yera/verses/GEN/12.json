            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Aburamu, ati Va mu gihugu canyu, no mu muryango wanyu, no mu nzu ya so, uje mu gihugu nzokwereka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.1",
            "verseOrgIds": [
              "GEN.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.18"
              },
              "items": [
                {
                  "text": "Ita 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.8"
              },
              "items": [
                {
                  "text": "1 Abam 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje nzoguhindura ubgoko bukomeye, nzoguha umugisha, izina ryawe ndarigire rurangiranwa; n’abandi baze bagire umugisha kubgawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.2",
            "verseOrgIds": [
              "GEN.12.2"
            ]
          }
        },
        {
