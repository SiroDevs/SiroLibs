                {
                  "text": "Gal 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abazoguhezagira nzobahezagira, kand’ ūzokuvuma nzomuvuma: kandi muri wewe ni ho imiryango yose yo mw isi izohērwa umugisha.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.3",
            "verseOrgIds": [
              "GEN.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aburamu aragenda, nk’ uk’ Uhoraho amubariye; Loti ajana na we. Aburamu yar’ amaze imyaka mirongwirindwi n’itanu igihe yava i Harani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.4",
            "verseOrgIds": [
              "GEN.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.11.31"
              },
              "items": [
                {
                  "text": "Ita 11:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu ajana Sarayi umugore wiwe na Loti umuhungwabo, n’itunga ryabo ryose bari batungiye i Harani, bo n’abantu bāronkeyeyo; bavaho ngo baje mu gihugu c’i Kanani; nuko bashika i Kanani nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.5",
            "verseOrgIds": [
              "GEN.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.11.30"
              },
              "items": [
                {
                  "text": "Gus 11:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.1"
              },
              "items": [
                {
                  "text": "Abac 7:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu adwēbēra ico gihugu, ashika ahantu hitwa i Shekemu, ku giti c’umweloni ca More. Ico gihe Abanyakanani ni bo bāba mur’ ico gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.6",
            "verseOrgIds": [
              "GEN.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.13.15"
              },
              "items": [
                {
                  "text": "Ita 13:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.33.1"
              },
              "items": [
                {
                  "text": "Kuv 33:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.34.4"
              },
              "items": [
                {
                  "text": "Gus 34:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yiyereka Aburamu, aramubarira, at’ Uruvyaro rwawe nzoruha iki gihugu. Aca ahubaka igicaniro, yubakiye Uhoraho amwiyeretse. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.7",
            "verseOrgIds": [
              "GEN.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.11.9"
              },
              "items": [
                {
                  "text": "Heb 11:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikora avayo, aja ku musozi wo ku ruhande rw’i burasirazuba rw’i Beteli, ahashinga amahema; i Beteli hasigara i burengerazuba bgiwe, i Hayi hakaba i burasirazuba bgiwe: na ho nyene ahubakira Uhoraho igicaniro, yambaza izina ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.8",
            "verseOrgIds": [
              "GEN.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aburamu akomeza kugenda aratāhīra, yerekeye i Negebu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:9",
              "type": "text"
            },
            {
              "text": "Negebu n’igihugu co ku ruhande rw’i bumanuko bg’i Kanani.",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.9",
            "verseOrgIds": [
              "GEN.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ inzara itera mur’ ico gihugu: nuko Aburamu aramanuka, aja muri Egiputa, ngw asuhukireyo, kukw inzara yari nyinshi mur’ ico gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.10",
            "verseOrgIds": [
              "GEN.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ari hafi gushika muri Egiputa, abarira Sarayi umugore wiwe, at’ Umve ndazi k’ur’ umugore w’igikundiro: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.11",
            "verseOrgIds": [
              "GEN.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.20.1+GEN.20.2+GEN.20.3+GEN.20.4+GEN.20.5+GEN.20.6+GEN.20.7+GEN.20.8+GEN.20.9+GEN.20.10+GEN.20.11+GEN.20.12+GEN.20.13+GEN.20.14+GEN.20.15+GEN.20.16+GEN.20.17+GEN.20.18"
              },
              "items": [
                {
                  "text": "Ita 20:1-18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nukw Abanyegiputa ni bakubona, bazovuga, bat’ Uyo n’umugore wiwe, baheze banyice, nawe bakureke. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.12",
            "verseOrgIds": [
              "GEN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakwinginze, uz’ uvuge k’uri mushikanje, kugira ngo ndābge neza kubgawe, ubugingo bganje ubukirishe ivy’ uvuze. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.13",
            "verseOrgIds": [
              "GEN.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aburamu ashitse muri Egiputa, Abanyegiputa babona yuk’ uwo mugore ari mwiza cane. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.14",
            "verseOrgIds": [
              "GEN.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.16"
              },
              "items": [
                {
                  "text": "Est 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abamenyekana ba Farawo bamubonye, bamushimira Farawo: nuk’ uwo mugore ajanwa kwa Farawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.15",
            "verseOrgIds": [
              "GEN.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo agirira Aburamu neza kubg’ uwo, aharonkera intama n’ inka n’indogoba z’amapfizi n’abagurano b’abahungu n’abakobga n’indogoba zivyara n’ingamiya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.16",
            "verseOrgIds": [
              "GEN.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.14"
              },
              "items": [
                {
                  "text": "Zab 105:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho ateza Farawo ivyago bihambaye, bo n’urugo rwiwe, amuhōra Sarayi muka Aburamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.12.17",
            "verseOrgIds": [
              "GEN.12.17"
            ]
          }
        },
        {
          "name": "verse",
