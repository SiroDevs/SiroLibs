              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bagabo barahaguruka, baragenda, batumbereye i Sodomu: Aburahamu abaja inyuma arabaherekeza. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.16",
