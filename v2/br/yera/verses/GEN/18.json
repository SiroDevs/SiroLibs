              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramubaza, bati Sara umugore wawe ari hehe? arabishura, at’ Ari mw ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.9",
            "verseOrgIds": [
