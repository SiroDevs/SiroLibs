              "items": [
                {
                  "text": "Rom 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubgira, at’ Umwaka ugeze ah’ uyu ugeze, sinzobura kugaruka i wawe, Sara umugore wawe yavyaye umuhungu. Sara avyumviririza mu muryango w’ihema, ahahera inyuma yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.10",
            "verseOrgIds": [
              "GEN.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 18:11"
          },
          "items": [
