              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho arivuganya, ati Mbega Aburahamu nomuhisha ico ngira nkore, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.17",
            "verseOrgIds": [
              "GEN.18.17"
            ]
          }
        },
