                  "text": "9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega har’ ikinanira Uhoraho? Igihe gishinzwe, umwaka ugeze ah’ uyu ugeze, nzogaruka i wawe Sara yavyaye umuhungu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.14",
            "verseOrgIds": [
              "GEN.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sara arahakana, at’ Eka sintwenze: kukw atinye. Aramubarira, at’ Oya uratwenze.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.15",
            "verseOrgIds": [
              "GEN.18.15"
            ]
          }
        }
      ]
