                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.2"
              },
              "items": [
                {
                  "text": "Heb 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yunamuye amaso abona abagabo batatu bahagaze bamutumbereye: ababonye, ava mu muryango w’ihema, yirukanga kubasanganira, akubita inkoro hasi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.2",
            "verseOrgIds": [
              "GEN.18.2"
            ]
          }
        },
        {
          "name": "verse",
