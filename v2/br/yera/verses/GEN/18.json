                  "text": "1 Pet 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sara atwengera mu mutima, ati Ko mmaze gukecura noba nkigomba umugabo, kand’ umwami wanje akaba ashaje? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.12",
            "verseOrgIds": [
              "GEN.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abaza Aburahamu, ati N’iki gitumye Sara atwenga, akavuga ngw Aho n’ivy’ ukuri, noba nkivyara umwana nkecuye? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.13",
            "verseOrgIds": [
              "GEN.18.13"
            ]
          }
        },
        {
