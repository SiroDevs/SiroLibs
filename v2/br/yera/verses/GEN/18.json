              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Aburahamu na Sara bari bashaje, bageze mu zabukuru: kandi Sara yari yaraciye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.11",
            "verseOrgIds": [
              "GEN.18.11"
