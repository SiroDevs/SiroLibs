                "loc": "GEN.24.36"
              },
              "items": [
                {
                  "text": "Ita 24:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu araga Isaka ivyo yar’ afise vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.5",
            "verseOrgIds": [
              "GEN.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abana bo ku ncoreke Aburahamu yar’ afise, arabagabira; araheza arabarungika, akiriho, ngw abatandukanye na Isaka umwana wiwe, bagende berekeye i burasirazuba, baje mu gihugu c’i burasirazuba nyene.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.6",
            "verseOrgIds": [
              "GEN.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw imisi Aburahamu yamaze n’imyaka ijana na mirongwirindwi n’itanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.7",
            "verseOrgIds": [
              "GEN.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.15"
              },
              "items": [
                {
                  "text": "Ita 15:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.17"
              },
              "items": [
                {
                  "text": "25:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.10"
              },
              "items": [
                {
                  "text": "Abac 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu aracīkāna, atāmbūra ageze mu zabukuru, apfa yisāziye neza; ahamvya ababo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.8",
            "verseOrgIds": [
              "GEN.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.23.16+GEN.23.17+GEN.23.18+GEN.23.19"
              },
              "items": [
                {
                  "text": "Ita 23:16-19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka na Ishimayeli abana biwe bamuhamba mw isenga y’i Makipela, iri mw itongo ryar’ irya Efuroni mwene Sohari Umuheti, aharābana n’i Mamure; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.9",
            "verseOrgIds": [
              "GEN.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ari ryo tongo Aburahamu yaguze n’Abaheti: ni ho Aburahamu yahambge, bo na Sara umugore wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.10",
            "verseOrgIds": [
              "GEN.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.62"
              },
              "items": [
                {
                  "text": "Ita 24:62",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburahamu amaze gupfa, Imana iha umugisha Isaka umwana wiwe; kandi Isaka yaba hafi y’Iriba ry’i Lahayi‐royi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.11",
            "verseOrgIds": [
              "GEN.25.11"
            ]
          }
        }
      ]
    },
