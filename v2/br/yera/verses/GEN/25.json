            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.1.2"
              },
              "items": [
                {
                  "text": "Mat 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo ruvyaro rwa Isaka mwene Aburahamu: Aburahamu yavyaye Isaka. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.19",
            "verseOrgIds": [
              "GEN.25.19"
            ]
          }
        },
        {
          "name": "verse",
