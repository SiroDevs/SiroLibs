              "items": [
                {
                  "text": "Heb 12:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo aramwishura, ati Banza undahire. Aramurahira, agura na Yakobo ivyo kuba samuragwa kwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo araheza aha Esau umutsima n’ibiharage; nukw ararya aranywa, yivira hasi, arīgīra. Uko ni ko Esau yakēngereye ivyo kuba samuragwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
