                "loc": "ISA.22.5"
              },
              "items": [
                {
                  "text": "Yes 22:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.6"
