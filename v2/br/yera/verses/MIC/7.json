              "attrs": {
                "loc": "NAM.1.10"
              },
              "items": [
                {
                  "text": "Nah 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūrusha abandi kumera neza ameze nk’umukere, kand’ ūbaye ūrusha abandi kugororoka n’insobane kurusha uruzitiro rw’amahwa: umusi wavuzwe n’abashibamyi bawe urashitse, ari wo wo guhanwa kwawe; kandi muzogwa mu gahundwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.9.4"
              },
              "items": [
                {
                  "text": "Yer 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukizigire umukunzi, ntimukishimire incuti; ufate n’akanwa kawe no ku mugore wawe mupfumbatirana. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.21"
              },
              "items": [
                {
                  "text": "Mat 10:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.35"
              },
              "items": [
                {
                  "text": "35",
