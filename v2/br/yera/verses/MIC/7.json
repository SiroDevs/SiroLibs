                "loc": "ISA.11.11"
              },
              "items": [
                {
                  "text": "Yes 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.16"
              },
              "items": [
                {
