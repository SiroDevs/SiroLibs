              },
              "items": [
                {
                  "text": "Zef 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaboko yabo yamogoreye gukora ibibi; umuganwa ari n’ivyo yāka, umucamanza aca ingurire, ūhambaye yenyaguza ivyifuzo bibi vyo mu mutima wiwe: uko ni ko babijishira hamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
