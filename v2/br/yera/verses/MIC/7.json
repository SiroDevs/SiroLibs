                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abubaha Imana baraherengeteye mw isi, kandi mu bantu nta n’umwe atunganye: bose babundira kuvisha amaraso, umuntu wese ahīga mugenzi we ngw amute mu ruriba. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
