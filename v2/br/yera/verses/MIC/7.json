                "loc": "MAT.10.36"
              },
              "items": [
                {
                  "text": "36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umuhungu akēngēra se, umukobga agahagurukira nyina, umukazana agahagurukira inabukwe; kand’ abansi b’umuntu bakaba abo mu rugo rwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
