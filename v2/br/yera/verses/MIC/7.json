                "loc": "ZEC.9.10"
              },
              "items": [
                {
                  "text": "Zek 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi bazoza kuri wewe bavuye muri Ashuri no mu bisagara vyo muri Egiputa, uhereye muri Egiputa ugashitsa kuri rwa Ruzi, uhereye ku kiyaga ugashitsa ku kindi, uhereye ku musozi ugashitsa ku wundi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        },
