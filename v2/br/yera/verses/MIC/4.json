            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.2.6"
              },
              "items": [
                {
                  "text": "Zab 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.23"
              },
              "items": [
                {
                  "text": "Yes 24:23",
