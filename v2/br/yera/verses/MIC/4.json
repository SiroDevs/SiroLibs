              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.12"
              },
              "items": [
                {
                  "text": "Mat 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntibazi ivyiyumviro vy’Uhoraho, canke ngo batahure imigabo yiwe, yuko yabakoranirije hamwe nk’imikama irunze ku mbuga. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.12",
            "verseOrgIds": [
              "MIC.4.12"
            ]
          }
        },
