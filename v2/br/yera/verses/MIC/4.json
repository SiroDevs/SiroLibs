              "items": [
                {
                  "text": "Zek 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu amahanga menshi akoraniye kugutera, aravuga, ati Siyoni ni hahumanywe, amaso yacu avyibonere! ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.11",
            "verseOrgIds": [
              "MIC.4.11"
            ]
          }
        },
        {
