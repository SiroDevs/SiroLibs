              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.33"
              },
              "items": [
                {
                  "text": "Luk 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.22"
              },
              "items": [
                {
                  "text": "Heb 12:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ abacumbagira nzobasigazaho babe amasigarira, n’abari baraciwe mbahindure ihanga rikomeye; maze jewe Uhoraho nzobaganza ndi ku murwa Siyoni, uhereye aho ugashitsa ibihe bidashira. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.7",
            "verseOrgIds": [
              "MIC.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe, mutara wo kurābirak’ umukuku, umusozi w’umukobga w’i Siyoni, ya nganji izoza kuri wewe: imwe ya mbere izokugarukako, bga bgami bg’umukobga w’i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.8",
            "verseOrgIds": [
              "MIC.4.8"
            ]
          }
        }
      ]
    },
