              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi, ni k’Uhoraho agize, nzokoraniriza hamwe abacumbagira, nkumakume abasanzaye, n’abo nababaje; ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.6",
            "verseOrgIds": [
              "MIC.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
