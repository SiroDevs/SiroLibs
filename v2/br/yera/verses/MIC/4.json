                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None se n’iki gituma uvuza induru? Mbega nta mwami ari muri wewe? Canke se umujanama wawe yapfuye, kw ibise bigufashe nk’umugore aramutswe? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.4.9",
            "verseOrgIds": [
              "MIC.4.9"
            ]
          }
        },
        {
