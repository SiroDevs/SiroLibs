          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 1:2"
          },
          "items": [
