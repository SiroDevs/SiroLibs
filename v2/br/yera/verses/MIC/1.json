                "loc": "JOB.30.29"
              },
              "items": [
                {
                  "text": "Yob 30:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.20.2+ISA.20.3+ISA.20.4"
              },
              "items": [
                {
                  "text": "Yes 20:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.4"
              },
              "items": [
                {
                  "text": "22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubg’ ivyo nzorira mboroge, ngende nambaye ubusa, ata n’ inkweto: nzorira nk’imbgebge, mboroge nk’ igisīga citwa imbuni. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.8",
            "verseOrgIds": [
              "MIC.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.5.13"
              },
              "items": [
                {
                  "text": "Hos 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uruguma rwaho rutazovūrika: mbere rwashitse n’i Buyuda; rushika kw irembo ry’ abantu banje, mbere rurinda rushika n’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.9",
            "verseOrgIds": [
              "MIC.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.1.20"
              },
              "items": [
                {
                  "text": "2 Sam 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.26"
              },
              "items": [
                {
                  "text": "Yer 6:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukabikerukirize i Gati, ntimuzirukanye ngo murire; i Beti‐Leyafura abe ari ho mwikumbagariza mu mukungugu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.10",
            "verseOrgIds": [
              "MIC.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda vayo wambaye ubusa utēterewe, wewe uba i Shafiri; ūba i Zanani ntaruha asokoroka; i Beti‐Ezeli hazorandurwa, hakūrwe ku matanguriro yaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.11",
            "verseOrgIds": [
              "MIC.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.3.6"
              },
              "items": [
                {
                  "text": "Am 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūba i Maroti yiteganye ivyiza umutima uhagaze: kukw ivyago vyamanutse bivuye k’Uhoraho, bigashika kw irembo ry’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.12",
            "verseOrgIds": [
              "MIC.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.14"
              },
              "items": [
                {
                  "text": "2 Abam 18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.1"
              },
              "items": [
                {
                  "text": "Hos 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe ababa i Lakishi, muhambīrire umukogote kw ifarasi inyaruka: ni mwebge mwabanje gucumuza umukobga w’i Siyoni; kukw ibicumuro vy’Abisirayeli vyabonetse kuri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.13",
            "verseOrgIds": [
              "MIC.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma uzoha Moresheti‐Gati ivyo gucancabura: amazu ya Akizibu azoyangārira abami b’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.14",
            "verseOrgIds": [
              "MIC.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe muba i Maresha nzobarungikira ūzobanesha; ubgiza bg’ Abisirayeli buzoshika no muri Adulamu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.15",
            "verseOrgIds": [
              "MIC.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
