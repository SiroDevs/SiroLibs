                {
                  "text": "Hos 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’Uhoraho ryaje kuri Mika w’i Moresheti, ku ngoma ya Yotamu no ku ya Ahazi no ku ya Hezekiya, abami b’i Buyuda, amajambo y’ivyo yeretswe kuri Samariya n’i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.1.1",
            "verseOrgIds": [
              "MIC.1.1"
            ]
          }
        }
      ]
    },
    {
