                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besaleli na Oholiyabu n’ umuntu wese w’umuhinga, abo Uhoraho yashizemw’ ubuhinga n’ubgenge ngo bamenye gukora vyose vy’iryo hema, baze babikore nk’uk’ Uhoraho yabigeze vyose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose ahamagara Besaleli na Oholiyabu, n’umuntu wese w’ umuhinga, ab’ Uhoraho yashize ubuhinga mu mutima, mbere n’umuntu wese yasunitswe n’umutima kuza gukora ico gikorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.35.24+EXO.35.25+EXO.35.26+EXO.35.27+EXO.35.28+EXO.35.29"
              },
              "items": [
                {
                  "text": "Kuv 35:24-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abaha ya mashikanwa yose, ayo Abisirayeli bāshikaniye gukora ivy’ iryo hema, ngo bayakoreshe. Kand’ uko bukeye mu gitondo bākomeza kumuzanira ayandi mashikanwa avuye ku mitima ikunze, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.3",
            "verseOrgIds": [
              "EXO.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bituma abo bantu bose b’ abahinga bakora ibikorwa vyose vyo kur’ iryo hema, bahērako baraza, umuntu wese ava ku gikorwa ciwe yakora, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.4",
            "verseOrgIds": [
              "EXO.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.2"
              },
              "items": [
                {
                  "text": "2 Kor 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "babarira Mose, bat’ Ereg’ abantu bazanye ibirenze rwose ku vyo Uhoraho yageze gukora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose ashinga kubibuza, babitāngāza aho bashagaje hose, bati Ntihaze hagire umugabo cank’ umugore asubira gukora ikindi kintu na kimwe co gushikana kubg’ iryo hema. Uko ni ko bābujije abantu kugira ikindi bazana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.6",
            "verseOrgIds": [
              "EXO.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyo bari bafise vyari bihāgije gukora ico gikorwa cose, bigasāguka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.7",
            "verseOrgIds": [
              "EXO.36.7"
            ]
          }
        }
      ]
    },
    {
