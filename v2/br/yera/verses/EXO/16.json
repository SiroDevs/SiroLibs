              "items": [
                {
                  "text": "Kuv 16:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo Uhoraho yavuze, at’ Umuntu wese yegeranye ibihwanye n’igisa ciwe, kand’ ajanire abo mw ihema ryiwe ingero yitwa omeru imwe‐imwe ku muntu ku muntu, nk’ ukw igitigiri c’abantu banyu kingana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.16",
            "verseOrgIds": [
              "EXO.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli babigenza bartyo, baravyegeranya, bamwe begeranya vyinshi, abandi bike. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.17",
            "verseOrgIds": [
              "EXO.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.8.15"
              },
              "items": [
                {
                  "text": "2 Kor 8:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babigeze kuri ya ngero yitwa omeru, uwegeranije vyinshi asanga nta co asāguye; uwegeranije bike asanga nta co akehaniwe: umuntu wese asanga yegeranije ibihwanye n’igisa ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.18",
            "verseOrgIds": [
              "EXO.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose arabīhaniza, ati Ntihagire umuntu abirāza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.19",
            "verseOrgIds": [
              "EXO.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara Mose ntibamwumvira: bamwe babirāzako, basanga vyaboze, binyagara inyo. Mose arabarakira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.20",
            "verseOrgIds": [
              "EXO.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bama bavyegeranya uko bukeye, umuntu wese ibihwanye n’igisa ciwe: izuba ngo risasike, bikayaga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.21",
            "verseOrgIds": [
              "EXO.16.21"
            ]
          }
        }
      ]
    },
