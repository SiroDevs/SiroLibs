          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aroni akirikw aravugana n’ikoraniro ryose ry’Abisirayeli, bahindukiye babona mu bugaragwa ubgiza bg’ Uhoraho bgiyerekaniye muri ca gicu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.10",
            "verseOrgIds": [
