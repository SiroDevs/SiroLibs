            }
          ]
        },
        {
          "text": "Maze Mose abarira Aroni, ati Barira ikoraniro ryose ry’Abisirayeli, uti Ni mwīgire hafi imbere y’ Uhoraho, uti Kuko yumvise imyidodombo yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.9",
            "verseOrgIds": [
              "EXO.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
