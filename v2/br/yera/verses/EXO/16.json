              "items": [
                {
                  "text": "Lew 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira, at’ Ivyo ni vyo Uhoraho yavuze, at’ Ejo uzoba umusi wo kuruhūka, w’isabato irobanuriwe Uhoraho; ni bagende barondere ivyo bagomba, bateke ivyo bagomba; ibisāgutse babibīke, babirāze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.23",
            "verseOrgIds": [
              "EXO.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko barabirāza nk’uko Mose yabageze; ntivyabora, ntivyagwa urunyo na rumwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.24",
            "verseOrgIds": [
              "EXO.16.24"
            ]
          }
        }
      ]
    },
