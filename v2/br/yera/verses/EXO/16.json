        },
        {
          "text": "Nuko Mose na Aroni babarira Abisirayeli bose, bati Ku mugoroba ni ho muja kumenya yuk’ Uhoraho ari we yabakūye mu gihugu ca Egiputa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.6",
            "verseOrgIds": [
              "EXO.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
