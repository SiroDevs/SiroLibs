                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mu gitondo ni ho muzobona icubahiro c’Uhoraho: kuko yumvise ingene mumwidodombera; natwe ga twar’ iki, aho mutwidodombera? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.7",
            "verseOrgIds": [
              "EXO.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose arababgira, at’ Ivyo murabibona igihe Uhoraho aja kubaha inyama zo kurya kur’ uyu mugoroba, mu gitondo akazobaha umutsima, mukarya mugahāga; kuk’ Uhoraho yumvise imyidodombo yanyu mumwidodombera; natwe twar’ iki? erega si twebge mwidodombera, mwidodombera Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.8",
            "verseOrgIds": [
              "EXO.16.8"
            ]
          }
        }
