                  "text": "Heb 9:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abarira Aroni, ati Jana urwavya, urusukemwo manu yuzuye omeru imwe, urutereke imbere y’Uhoraho, kugira ngo rubīkirwe ab’urunganwe rwanyu uko ruzogenda rukurikirana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.33",
            "verseOrgIds": [
              "EXO.16.33"
            ]
          }
        },
