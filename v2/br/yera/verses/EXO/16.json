        },
        {
          "text": "Nuko ku mugoroba inkware ziraza, zigwa aho bashagaje, zirahazimya; mu gitondo buca ikime gitonze impande zaho zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.13",
