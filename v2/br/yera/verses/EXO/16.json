            "sid": "EXO 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ku wa gatandatu begeranya ivyo kurya bingana kabiri n’ivyo bahora bazana: umuntu wese agira omeru zibiri‐zibiri; abakuru bose b’iryo shengero baraza babibarira Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.22",
            "verseOrgIds": [
              "EXO.16.22"
            ]
          }
        },
        {
          "name": "verse",
