          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku wa gatandatu, igihe basorongora ivyo bazanye, bazosanga harimw’ ibingana kabiri n’ivyo bahora bazana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.16.5",
