              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.24.12"
              },
              "items": [
                {
                  "text": "Kuv 24:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho amaze kubonanira na Mose kur’ uwo musozi Sinayi, amuha ibisate bibiri vyanditswekw Ibishinga intahe, ivyo bisate vyar’ ivy’ amabuye, vyanditsweko n’ urutoke rw’ Imana.",
          "type": "text",
          "attrs": {
