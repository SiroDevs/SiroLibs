                  "text": "Kuv 29:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze ushire ca gicaniro co kwoserezakw ibimazi imbere y’ umuryango w’iryo hema, ari ryo hema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.6",
            "verseOrgIds": [
              "EXO.40.6"
            ]
          }
        },
