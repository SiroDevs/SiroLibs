            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashira na ca gicaniro c’izahabu mur’ iryo hema ry’ibonaniro, hino ya ca gihuzu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.26",
            "verseOrgIds": [
              "EXO.40.26"
            ]
