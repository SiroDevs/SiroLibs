                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze uzane Aroni n’abana biwe ku muryango w’iryo hema ry’ibonaniro, ubuhagire. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.12",
            "verseOrgIds": [
              "EXO.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wambike Aroni ya myambaro yejejwe, umurobanuze ayo mavuta, umweze, kugira ngw ankorere igikorwa c’ubuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.13",
            "verseOrgIds": [
              "EXO.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze uzane n’abana biwe, ubambike ya makanzo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.14",
            "verseOrgIds": [
              "EXO.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubarobanuze amavuta, nk’uk’ uyarobanuje se, kugira ngo bankorere igikorwa c’ubuherezi: ukwo kurobanurwa kwabo kuzoba kubahaye ubuherezi bg’intahava ukw ibihe vy’urunganwe rwabo bizogenda bikurikirana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.15",
            "verseOrgIds": [
              "EXO.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose abigenza artyo: uk’ Uhoraho yamubariye kwose, ni ko yabikoze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.16",
            "verseOrgIds": [
              "EXO.40.16"
            ]
          }
        }
      ]
    },
