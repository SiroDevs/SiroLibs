              "type": "text"
            }
          ]
        },
        {
          "text": "na ca gicaniro c’izahabu co kwoserezakw imibavu uz’ ugitereke hino ya ya sandugu y’Ibishinga intahe, ukinge ca gihuzu ku muryango w’iryo hema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.5",
            "verseOrgIds": [
              "EXO.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
