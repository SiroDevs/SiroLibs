            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ utereke ca kigārigāri co gukaraba hagati y’ihema ry’ibonaniro n’ico gicaniro, ugisukemw’ amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.7",
            "verseOrgIds": [
