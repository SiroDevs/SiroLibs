            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashira ya meza mur’ iryo hema ry’ibonaniro, ayaherereza ku ruhande rw’i burārūko rw’iryo hema, hino y’ico gihuzu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.22",
            "verseOrgIds": [
