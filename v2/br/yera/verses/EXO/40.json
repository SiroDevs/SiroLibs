        {
          "text": "Maze winjizemwo ya meza, uyaterekekw ibintu vyayo, ubiroranye; winjize na ca gitereko c’amatara, ugishirekw amatara yaco; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.4",
            "verseOrgIds": [
              "EXO.40.4"
            ]
