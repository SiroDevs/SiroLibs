              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze wābire ya mavuta yo kurobanuza abahabga ibango, uyarobanuze iryo hema n’ibirimwo vyose, uryezanye n’ibintu vyaryo vyose: nuko rizoba ribaye iryera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.40.9",
            "verseOrgIds": [
              "EXO.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
