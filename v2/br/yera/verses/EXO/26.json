                  "text": "Heb 9:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi wa mutemere wo guhongerako uz’ uwurumye kur’ iyo sandugu y’ Ibishinga intahe, ir’ Ahēra cane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ya meza uz’ uyashire hino y’ico gihuzu, na ca giterekwakw amatara uz’ ugishire ku ruhande rw’i bumanuko mur’ iryo hema, aharābana n’ayo meza; ayo meza na yo uyaherereze mu ruhande rw’i burārūko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
