                  "text": "Lew 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ico gihuzu uz’ ukimanike ugitumbereje musi ya twa turinda, uze winjize ya sandugu y’Ibishinga intahe hirya yaco: ico gihuzu kize kibabere ico gutandukanya Ahēra n’Ahēra cane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
