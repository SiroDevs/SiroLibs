            {
              "text": "2:22",
              "type": "text"
            },
            {
              "text": "Gerushomu risobanurwa, ngw Inyambukīra y’aha hantu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ati Nabaye inyambukīra mu gihugu kitar’ icacu.",
          "type": "text",
