                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.9.11"
              },
              "items": [
                {
                  "text": "1 Sam 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hār’ umuherezi w’i Midiyani yar’ afise abakobga ndwi: baraza, baravoma, buzuza ingomero, ngo bashore umukuku w’ intama wa se. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.16",
            "verseOrgIds": [
              "EXO.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.10"
              },
              "items": [
                {
                  "text": "Ita 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza abungere, barabirukana: ariko Mose ava hasi, arabatabara, ashora umukuku wabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.17",
            "verseOrgIds": [
              "EXO.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.29"
              },
              "items": [
                {
                  "text": "Guh 10:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse kwa se Ruweli, arababaza, ati Ko muje n’ ingoga uyu musi? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.18",
            "verseOrgIds": [
              "EXO.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bati N’ uk’ umuntu w’Umunyegiputa yadutabaye abungere, atakw atuvomera n’amazi, ashora umukuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.19",
            "verseOrgIds": [
              "EXO.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
