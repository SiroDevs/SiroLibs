              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avyara umuhungu, se amwita Gerushomu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.22",
            "verseOrgIds": [
              "EXO.2.22"
