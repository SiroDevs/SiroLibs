              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose ashima kubana n’uwo muntu: na we arahava amuha umwigeme wiwe Zipora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.2.21",
