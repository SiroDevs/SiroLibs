                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.29"
              },
              "items": [
                {
                  "text": "2 Ngo 20:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.4.20"
              },
              "items": [
                {
                  "text": "Neh 4:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho ni we agira ngw abarwanire, namwe ni mwinumire gusa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
