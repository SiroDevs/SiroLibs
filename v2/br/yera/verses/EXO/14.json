              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abisirayeli baca hagati mu kiyaga nk’abaca ku musozi; amazi ababera nk’umurombero i buryo n’i bumoso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
