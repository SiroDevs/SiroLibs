            "sid": "EXO 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho yokwica umwana w’umuntu, ar’ umuhungu cank’ umukobga, nyene yo agirwe nk’ukw ico cagezwe kivuga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.31",
            "verseOrgIds": [
              "EXO.21.31"
            ]
          }
        },
