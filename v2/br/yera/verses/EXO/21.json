                "loc": "1KI.2.28+1KI.2.29+1KI.2.30+1KI.2.31+1KI.2.32+1KI.2.33+1KI.2.34"
              },
              "items": [
                {
                  "text": "1 Abam 2:28-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umuntu ni yatera mugenzi we ibigirankana, ngw amwice mu bugunge, muze mumukūre ku gicaniro canje, kugira ngo yicwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.14",
            "verseOrgIds": [
              "EXO.21.14"
            ]
          }
        }
