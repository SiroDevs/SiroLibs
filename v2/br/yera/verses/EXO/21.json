              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inka y’umuntu ni yica iy’ uwundi, igahwera, iyishe iyindi bayigure, bagabure ivyo iguzwe, n’ umuvyimba na wo nyene bawugabure. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.35",
            "verseOrgIds": [
