              "type": "text"
            }
          ]
        },
        {
          "text": "ijisho rihōrwe irindi, iryinyo rihōrwe irindi, igikonjo gihōrwe ikindi, ikirenge gihōrwe ikindi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.24",
