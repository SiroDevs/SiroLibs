          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw iyo nka ni yaba yar’ isanzwe yica, nyene yo bakaba baramwihanije, ntayizigame, ikica umugabo cank’ umugore, agashika, iyo nka ize yicishwe amabuye, na nyene yo na we bamwice. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.29",
            "verseOrgIds": [
              "EXO.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
