            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwobigira atavyitumye, ari jewe Imana ntumye amugwa mu maboko, nzokurangira ah’ azohungira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.13",
            "verseOrgIds": [
              "EXO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
