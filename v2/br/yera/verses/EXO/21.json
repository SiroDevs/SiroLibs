                  "text": "Guh 35:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ho ni bamwaka indihano, atange ico bazomucira cose, kugira ngw acungure ubugingo bgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.30",
            "verseOrgIds": [
              "EXO.21.30"
            ]
          }
        },
