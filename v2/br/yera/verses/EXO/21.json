          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyene rwo az’ arihe ico yar’ imaze, ahe nyene yo amahera, umuvyimba ube uwa nyen’ urwobo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.34",
