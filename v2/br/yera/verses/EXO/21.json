              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni yagira ikindi aba, uz’ ugere k’ubugingo buhōrwa ubundi, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.23",
