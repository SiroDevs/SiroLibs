              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yarumūra urwobo rwo kubīka amazi, canke ni yarwimba ntarurumye, inka ikarukorokeramwo cank’ indogoba; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
            "verseOrgIds": [
              "EXO.21.33"
            ]
          }
