              "items": [
                {
                  "text": "Neh 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yashōra umwana wiwe w’umukobga akaja kuba umugurano, igihe kigeze ntaz’ arekurwe nk’uko barekura abagurano b’abagabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.7",
            "verseOrgIds": [
              "EXO.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko n’atātunganira shebuja, yari yaramurongoye, shebuja aze yemere acungurwe. Ariko kumugura n’abanyamahanga ntivyemerwa, kukw azoba yaramwononye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.8",
            "verseOrgIds": [
              "EXO.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke ni yamuha umuhungu wiwe, amutere itēka nk’uko yogiriye umukobga wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.9",
            "verseOrgIds": [
              "EXO.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.7.3"
              },
              "items": [
                {
                  "text": "1 Kor 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ho ni yamuharika uwundi, ntaz’ ahaze umutēko wiwe w’ inyama yamugereye cank’ imyambaro yiwe, cank’ imbu ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.10",
            "verseOrgIds": [
              "EXO.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni yaramuka atiriganye mur’ ivyo ukw ari bitatu, uwo mugore az’ arekurwe gusa, ata mahera atanzwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.11",
            "verseOrgIds": [
              "EXO.21.11"
            ]
          }
        }
      ]
    },
