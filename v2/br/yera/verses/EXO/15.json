            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira, ati Ni mwagira umwete wo kwumvira Uhoraho Imana yanyu, mugakora ibitunganye mu nyonga ziwe mukumvira ivyagezwe vyiwe, mukitondera ivyo yihanikirije vyose, ngo Nta ndwara azobateza nk’ izo yateje Abanyegiputa; ngo Kukw ari we Uhoraho, abakiza indwara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
