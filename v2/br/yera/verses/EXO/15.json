              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ajana Abisirayeli, bararamvura, bava ku Kiyaga Gitukura, bataha mu bugaragwa bg’i Shura, bagenda imisi itatu mur’ ubgo bugaragwa, babura amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
