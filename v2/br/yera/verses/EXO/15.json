        },
        {
          "text": "Kandi Miriyamu yavugishwa n’Imana, mushiki wa Aroni, ahitana agashāko k’ingoma; abagore bose barasohoka, baramukurikira bari n’udushāko tw’ingoma, bagenda baravyina; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
