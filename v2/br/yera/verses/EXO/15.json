            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "15:23",
              "type": "text"
            },
            {
              "text": "Mara risobanurwa ng’ Umururazi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
