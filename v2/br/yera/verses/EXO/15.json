            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse i Mara, ntibāshobora kunywa amazi yaho, kuko yar’ umururazi; ni co catumye hitwa Mara.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
