        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hamwe amafarasi ya Farawo, n’imikogote yiwe, n’ abagendera ku mafarasi, vyari bimanutse mu kiyaga, Uhoraho abiteranirizakw amazi y’ikiyaga; arikw Abisirayeli bo bāciye hagati mu kiyaga nk’ abaca ku musozi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        }
      ]
    },
