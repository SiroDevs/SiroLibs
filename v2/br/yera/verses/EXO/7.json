            "number": "10",
            "style": "v",
            "sid": "EXO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose na Aroni binjira kwa Farawo, bagira nk’uk’ Uhoraho yababariye: Aroni aterera inkoni yiwe hasi imbere ya Farawo n’abantu biwe, ihinduka inzoka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.10",
            "verseOrgIds": [
              "EXO.7.10"
            ]
          }
        },
