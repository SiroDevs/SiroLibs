        },
        {
          "text": "ati Farawo ni yabaronderakw ikimenyetso kibamenyekanisha, ubgire Aroni, uti Zana iyo nkoni witwaje, uyiterere hasi imbere ya Farawo, kugira ngw ihinduke inzoka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.9",
            "verseOrgIds": [
              "EXO.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
