          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyegiputa bose bimba hafi y’ uruzi, kugira ngo baronke amazi yo kunywa, kuko batāshobora kunywa amazi yo mu ruzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
