        },
        {
          "text": "Ishengero ryose ry’ Abisirayeli riva mu bugaragwa bg’i Sini, bagenda baratāhīra, nk’ uk’ Uhoraho yabageze, barinda bashika i Refidimu, basagazayo. Abantu basanga nta mazi ariho yo kunywa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.1",
            "verseOrgIds": [
              "EXO.17.1"
            ]
          }
        },
