              "items": [
                {
                  "text": "1 Kor 10:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu batonganya Mose, bati Duhe amazi, tunywe. Mose arababaza, ati Muntonganiriza iki? N’iki kibateye kugerageza Uhoraho? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.2",
            "verseOrgIds": [
              "EXO.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.16.2"
              },
              "items": [
                {
                  "text": "Kuv 16:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bahicirwa n’inyota, bidodombera Mose, bati Wadukūriye iki muri Egiputa kutwicisha inyota, twe n’abana bacu n’ibitungwa vyacu? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.3",
            "verseOrgIds": [
              "EXO.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.10"
              },
              "items": [
                {
                  "text": "Guh 14:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.30.6"
              },
              "items": [
                {
                  "text": "1 Sam 30:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose atakambira Uhoraho, ati Mbeg’ aba bantu ndabagire nte? ko bashigaje gatoya bakantera amabuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.4",
            "verseOrgIds": [
              "EXO.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.19"
              },
              "items": [
                {
                  "text": "Kuv 7:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.7.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ati Ca imbere y’abantu, ujane bamwe mu bakuru b’Abisirayeli; witwaze na ya nkoni wakubitishije rwa ruzi, ugende. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.5",
            "verseOrgIds": [
              "EXO.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.41"
              },
              "items": [
                {
                  "text": "Zab 105:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.114.8"
              },
              "items": [
                {
                  "text": "114:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.4"
              },
              "items": [
                {
                  "text": "1 Kor 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe rāba nanje ndahagarara imbere yawe hariya ku gitandara c’i Horebu; nawe uheze uje gukubita ico gitandara, amazi aca yisuka avuye muri co, abantu banywe. Nuko Mose abikora artyo imbere y’abakuru b’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.6",
            "verseOrgIds": [
              "EXO.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.20.13"
              },
              "items": [
                {
                  "text": "Guh 20:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.95.8"
              },
              "items": [
                {
                  "text": "Zab 95:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yita aho hantu Masa",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:7",
              "type": "text"
            },
            {
              "text": "Masa risobanurwa ngo Kugerageza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na Meriba",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:7",
              "type": "text"
            },
            {
              "text": "Meriba risobanurwa ngw Imitongano.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kukw Abisirayeli bamutonganije, kandi kuko bagerageje Uhoraho, bakabaza ngo Mbeg’ Uhoraho ari muri twebge, canke ntari muri twebge?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.17.7",
            "verseOrgIds": [
              "EXO.17.7"
            ]
          }
        }
      ]
    },
