                  "text": "1 Ngo 28:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakerubi babe abashanje amababa hejuru, ayo mababa yabo ngw akingīre uwo mutemere wo guhongerako, barābane; bashire amaso kur’ uwo mutemere. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.20",
            "verseOrgIds": [
              "EXO.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze urumye uwo mutemere wo guhongerako kuri ya sandugu, uyishizemwo vya Bishinga intahe nzoguha. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.21",
            "verseOrgIds": [
              "EXO.25.21"
            ]
          }
        },
