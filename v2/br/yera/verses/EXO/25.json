                {
                  "text": "Heb 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ubāze ameza mu giti citwa umushita: uburebure bgayo bg’umurambararo bube amatambge abiri y’ukuboko uciriye mu nkokora, ubgaguke bgayo bube itambge rimwe, uburebure bg’igihagararo bube itambge rimwe n’igihimba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.23",
            "verseOrgIds": [
              "EXO.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ uyomekekw izahabu iramuye, uyakīkūze umuguno w’izahabu impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.24",
            "verseOrgIds": [
              "EXO.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ uyabāzire ibizingiti vyo kugumya amaguru biyakīkūze impande zose, ubgaguke bgavyo bungane n’urushi, ubikīkūzek’ umuguno w’izahabu impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.25",
            "verseOrgIds": [
              "EXO.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ uyacurire ibigombo bine mw izahabu, ubitēre ku nkokora ukw ari zine zo ku maguru yayo ukw ar’ ane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.26",
            "verseOrgIds": [
              "EXO.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bigombo bibe hafi ya vya bizingiti, bibe ivyo kwinjizamw’ iminiho yo kurerura ayo meza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.27",
            "verseOrgIds": [
              "EXO.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ubāze iminiho mu mushita, uyomekekw izahabu, ibe iyo kurerura ameza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.28",
            "verseOrgIds": [
              "EXO.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ucure amasahani n’udukombe vy’ayo meza, bo n’amakarabo n’imibehe vyayo vyo gusukisha ibiturire ku gicaniro: uz’ ubicure mw izahabu iramuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.29",
            "verseOrgIds": [
              "EXO.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.5"
              },
              "items": [
                {
                  "text": "Lew 24:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.6"
              },
              "items": [
                {
                  "text": "6",
