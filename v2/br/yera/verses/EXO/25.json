                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.12"
              },
              "items": [
                {
                  "text": "Ivyah 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze uz’ ugicurire amatara ndwi, ayo matara az’ aterekwe kuri co uburyo butuma abonesha imbere yaco. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.37",
            "verseOrgIds": [
              "EXO.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imakasi zaco zo gutunganya urutambi, bo n’udusahani two gushirwak’ umunyota warwo, bize bicurwe mw izahabu iramuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.38",
            "verseOrgIds": [
              "EXO.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gitereko, bo n’ivyo bintu vyaco vyose, bize bikorwe mw izahabu iramuye, inganye kuriba n’italanto",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "25:39",
              "type": "text"
            },
            {
              "text": "Italanto ni nk’ ibilo 55.",
              "type": "text"
            }
          ]
        },
        {
          "text": " imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.39",
            "verseOrgIds": [
              "EXO.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 25:40"
          },
          "items": [
