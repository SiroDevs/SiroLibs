            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.17.4"
              },
              "items": [
                {
                  "text": "17:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ni ho nzohora mbonanira nawe, nkakubarira ivyo ngushikirije vyose vy’ivyagezwe ngeze Abisirayeli, ndi hejuru y’uwo mutemere wo guhongerako, hagati y’abo bakerubi bo kw isandugu y’Ibishinga intahe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.22",
            "verseOrgIds": [
              "EXO.25.22"
            ]
          }
        }
      ]
