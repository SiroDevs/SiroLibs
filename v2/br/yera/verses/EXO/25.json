              "items": [
                {
                  "text": "Heb 8:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ ugire umwete wo kubikoresha, ubigereranije n’ikigereranyo cavyo werekewe kur’ uyu musozi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.40",
