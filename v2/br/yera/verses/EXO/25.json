            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.2"
              },
              "items": [
                {
                  "text": "Heb 9:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uz’ utereke kur’ ayo meza imitsima y’ibiterekērwa, yame imbere yanje na ntaryo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.25.30",
            "verseOrgIds": [
              "EXO.25.30"
            ]
          }
        }
