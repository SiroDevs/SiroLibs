            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mukoranire hamwe, mbere ni mukorane, yewe hanga ritagira isoni; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.1",
            "verseOrgIds": [
