                "loc": "2KI.23.26"
              },
              "items": [
                {
                  "text": "2 Abam 23:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mutaratūmūrirwa kure nk’umuguruka, kand’ uburake bg’Uhoraho bg’inkazi butarabashikako, mbere wa musi w’ uburake bg’Uhoraho utarabashikīra. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.2",
            "verseOrgIds": [
              "ZEP.2.2"
            ]
          }
        },
