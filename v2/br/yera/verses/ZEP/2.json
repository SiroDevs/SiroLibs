            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murondere Uhoraho, yemwe bagwaneza mwese bo kw isi, bashitsa amabgirizwa yiwe: murondere ubugororotsi, bo n’ukwicisha bugufi; kumbure muzokinjishwa ku musi w’uburake bg’ Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.2.3",
            "verseOrgIds": [
              "ZEP.2.3"
            ]
          }
        }
      ]
    },
    {
