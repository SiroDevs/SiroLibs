                "loc": "ISA.60.21"
              },
              "items": [
                {
                  "text": "Yes 60:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.4"
              },
              "items": [
                {
                  "text": "Mik 5:4",
