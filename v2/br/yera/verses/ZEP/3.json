              "items": [
                {
                  "text": "Zek 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naranduye amahanga, iminara yabo isigaye ar’ imisaka; nashibije inzira zabo, bituma ata wukihahita; ibisagara vyabo birasanganguwe, bituma hatakibonekay’ umuntu, kand’ ata wukihaba na mba. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.6",
            "verseOrgIds": [
              "ZEP.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEP 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.3"
              },
              "items": [
                {
                  "text": "Mik 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari nibgiye, nti N’ukuri uzontinya, uzokwemera guhanūrwa, ngw inzu zawe zoye gusangangurwa, nk’uko nari mmaze kubishinga vyose: ariko bama bazindukanwa no kwonona ibikorwa vyabo vyose.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.7",
            "verseOrgIds": [
              "ZEP.3.7"
            ]
          }
        }
      ]
    },
