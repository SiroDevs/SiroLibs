                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.4"
              },
              "items": [
                {
                  "text": "Yes 60:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasavyi banje, ari bo bana banje bāsābagiye, bazonzanira ingorore, bavuye hakurya y’inzūzi zo muri Etiyopiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.10",
            "verseOrgIds": [
              "ZEP.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
