            "number": "11",
            "style": "v",
            "sid": "ZEP 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.11"
              },
              "items": [
                {
                  "text": "Yes 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.1"
              },
              "items": [
                {
                  "text": "Mal 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
