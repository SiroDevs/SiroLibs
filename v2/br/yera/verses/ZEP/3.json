            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ico gihe nzohindura amoko bagire ururimi rutunganye, kugira ngo bose babone kwambaza izina ryanje jewe Uhoraho, bankorere bahuje inama. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.9",
            "verseOrgIds": [
              "ZEP.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEP 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
