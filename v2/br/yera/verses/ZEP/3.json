              "items": [
                {
                  "text": "Ivyah 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amasigarira y’Abisirayeli ntibazokora ivyo kugabitanya, canke ngo bavuge ibinyoma, kandi nta rurimi rw’ubugunge ruzoboneka mu kanwa kabo: bazorisha bagaramange, ata wubateye ubgoba.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.13",
            "verseOrgIds": [
              "ZEP.3.13"
            ]
          }
        }
