                "loc": "MAT.3.9"
              },
              "items": [
                {
                  "text": "Mat 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi ntuzokwongera gutēterezwa n’ibikorwa vyawe vyose, ivyo wagenda uncumurako: kukw ico gihe nzoba ngukūyemw’ abihayagiza bībona, kandi nawe ntuzokwongera kwishira hejuru ku musozi wanje wera. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.11",
            "verseOrgIds": [
              "ZEP.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEP 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.32"
              },
              "items": [
                {
                  "text": "Yes 14:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nzogusigamw’ abaciye bugufi na ba nyarucari, abo ni bo bazokwizigira izina ryanje jewe Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.3.12",
            "verseOrgIds": [
              "ZEP.3.12"
            ]
          }
        },
        {
