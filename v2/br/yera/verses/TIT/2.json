              "items": [
                {
                  "text": "1 Yoh 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "butwigisha kwikunkumura ukutubaha Imana n’ukwifuza ivy’ isi, bukatwigisha kwama tudahugumba, tugororoka, twubaha Imana, mu gihe ca none, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.12",
            "verseOrgIds": [
              "TIT.2.12"
            ]
          }
        },
