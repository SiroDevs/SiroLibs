              "items": [
                {
                  "text": "Flp 3:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "twitega ivyizigiro vy’amahirwe no kuzoseruka kw’ubgiza bga Yesu Kristo, ni we Mana yacu ihambaye n’Umukiza, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.2.13",
            "verseOrgIds": [
              "TIT.2.13"
            ]
          }
        },
