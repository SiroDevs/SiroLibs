              "items": [
                {
                  "text": "2 Tim 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "agumya ijambo ryo kwizerwa rihūra n’ukwigisha kwacu, kugira ngw abone guhanūra abantu mu kwigisha kuzima no gutsinda abamuhāririza.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.9",
            "verseOrgIds": [
              "TIT.1.9"
            ]
          }
        }
      ]
