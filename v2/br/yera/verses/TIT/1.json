                "loc": "1TI.1.1"
              },
              "items": [
                {
                  "text": "1 Tim 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu bihe yitoranirije yerekanishije ijambo ryayo ubutumwa najejwe, nk’ukw Imana Umukiza wacu yageze. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.3",
            "verseOrgIds": [
              "TIT.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "TIT 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.2"
              },
              "items": [
                {
                  "text": "1 Tim 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakwandikiye Tito, umwana wanje nyakuri kubg’ ukwizera dusangiye. Ubuntu n’amahoro bibe kuri wewe biva ku Mana Data wa twese no kuri Kristo Yesu Umukiza wacu.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.4",
            "verseOrgIds": [
              "TIT.1.4"
            ]
          }
        }
      ]
    },
    {
