                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.24"
              },
              "items": [
                {
                  "text": "2 Tim 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umuzezwashengero akwiye kutabak’ umugayo, nk’umubgiriza w’Imana nyene; kandi ntakwiye kuba ūdakūrwa kw ijambo, cank’ ūsugurirwa, cank’ umunywi wa vino, cank’ umusinzi, cank’ uwifuza inyungu mbi; ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.7",
            "verseOrgIds": [
              "TIT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw abe ūkunda gutanga indāro, akunda ivyiza, adahugumba, agororoka, yera, yirinda, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.1.8",
            "verseOrgIds": [
              "TIT.1.8"
            ]
          }
        },
        {
