              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.11"
              },
              "items": [
                {
                  "text": "Tit 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.8.31"
              },
              "items": [
                {
                  "text": "Imig 8:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ineza y’Imana Umukiza wacu n’urukundo ikunda abantu, bimaze kuboneka, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.4",
            "verseOrgIds": [
              "TIT.3.4"
            ]
          }
        },
