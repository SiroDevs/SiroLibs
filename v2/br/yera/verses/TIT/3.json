            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "iradukiza, itadukirishije ibikorwa vyo kugororoka twakoze, ariko, nk’ukw imbabazi zayo ziri, idukirisha ukwozwa kuzana ukuvyarwa ubga kabiri, ikadukirisha uguhindurwa basha na Mpwemu Yera, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.5",
            "verseOrgIds": [
              "TIT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "TIT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
