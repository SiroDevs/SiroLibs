              "items": [
                {
                  "text": "Yow 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo yaducuncuburiyeko kubga Yesu Kristo Umukiza wacu, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.6",
            "verseOrgIds": [
              "TIT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "TIT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.3.24"
              },
              "items": [
                {
                  "text": "Rom 3:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo dutsindanishirizwe n’ubuntu bgayo, duce tuba abaragwa b’ubugingo budashira, nk’ukw ivyizigiro vyacu biri. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.7",
            "verseOrgIds": [
              "TIT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "TIT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo jambo n’iryo kwizerwa, ndagomba yuk’ utsindagira ivyo, ubikobereje, kugira ngw abizeye Imana bagire umwete wo kugumya gukora ibikorwa vyiza. Ivyo ni vyiza, bigira ico bimarira abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.8",
            "verseOrgIds": [
              "TIT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "TIT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.7"
              },
              "items": [
                {
                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, impāri z’ubupfu no kuzirora ivy’ akaronda n’imitongano no guhārīra ivyo mu vyagezwe, wame ubizibukīra, kuko bitagira ikimazi kand’ ar’ ivy’ ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.9",
            "verseOrgIds": [
              "TIT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "TIT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2JN.1.10"
              },
              "items": [
                {
                  "text": "2 Yoh 1:10",
                  "type": "text"
                }
