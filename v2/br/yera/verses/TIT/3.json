          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.14"
              },
              "items": [
                {
                  "text": "Tit 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.7.19"
              },
              "items": [
                {
                  "text": "Mat 7:19",
