              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ uzi yuk’ ūmeze artyo agoramye kand’ akora ivyaha, yitsindisha.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.11",
            "verseOrgIds": [
              "TIT.3.11"
            ]
