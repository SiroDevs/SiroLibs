              },
              "items": [
                {
                  "text": "29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abacu na bo ni bige kugumya gukora ibikorwa vyiza ngo babone kumara ubukene ababikwiye rwose, kugira ngw abacu ntibabe ibirumbirane.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        }
