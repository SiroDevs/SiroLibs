              "attrs": {
                "loc": "MAT.18.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūzana ibice ni wamara kumuhanūra ubga mbere n’ubga kabiri akanka, ntukamwemere, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.10",
            "verseOrgIds": [
              "TIT.3.10"
            ]
          }
        },
