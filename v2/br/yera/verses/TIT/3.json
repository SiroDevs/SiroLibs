          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.5"
              },
              "items": [
                {
                  "text": "Flp 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kutagira uwo bambika ibara, no kutitoraguza, no kwengenga, berekana ubugwaneza bgose ku bantu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.2",
            "verseOrgIds": [
              "TIT.3.2"
            ]
          }
        },
