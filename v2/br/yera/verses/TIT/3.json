                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nagutumako Arutema canke Tukiko, uz’ ugire umwete wo kunsanga i Nikopoli; kukw ari ho nagabiye kuzomara urushana. ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.12",
            "verseOrgIds": [
              "TIT.3.12"
            ]
          }
        },
        {
