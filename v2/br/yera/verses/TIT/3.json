            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubibutse kugamburukira abakuru n’abafise ubushobozi, no kubumvira, no kwitegurira igikorwa ciza cose, ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.1",
            "verseOrgIds": [
              "TIT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "TIT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
