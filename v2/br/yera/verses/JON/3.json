                "loc": "ISA.59.6"
              },
              "items": [
                {
                  "text": "Yes 59:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.18.11"
              },
              "items": [
                {
                  "text": "Yer 18:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw abantu ni bambare amagunira, n’ibitunzwe babiyapfuke, baheze bambaze Imana bakobeje, kandi bahindukire, umuntu wese areke inzira yiwe mbi, bareke n’umuryano uri muri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.8",
            "verseOrgIds": [
              "JON.3.8"
            ]
          }
        },
        {
