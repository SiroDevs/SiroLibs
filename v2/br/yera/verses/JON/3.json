          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijambo ry’Uhoraho rija kuri Yona ubugira kabiri, riramubarira, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.1",
            "verseOrgIds": [
              "JON.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JON 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Va hasi uje i Ninewe, ca gisagara kinini, ukibūrire imbūri nzokubgira. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.2",
            "verseOrgIds": [
              "JON.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JON 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yona ava hasi aja i Ninewe, nk’ ukw ijambo ry’ Uhoraho rivuze. Kandi Ninewe car’ igisagara kinini c’agahebuza, kugikikuza rwar’ urugendo rw’ imisi itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.3",
            "verseOrgIds": [
              "JON.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JON 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yona atangura kuja mu gisagara agenda urugendo rw’umusi umwe; arasemerera, ati Hasigaye imisi mirongwine, Ninewe hagakomvomvorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.4",
            "verseOrgIds": [
              "JON.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JON 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.3"
              },
              "items": [
                {
                  "text": "2 Ngo 20:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.41"
              },
              "items": [
                {
                  "text": "Mat 12:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu b’i Ninewe bemera Imana, bashinga ngo habeho kwisonzesha, baca bambara amagunira, uhereye k’ūhambaye ugashitsa kuri nyarucari hanyuma y’abandi.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.5",
            "verseOrgIds": [
              "JON.3.5"
            ]
          }
        }
      ]
    },
