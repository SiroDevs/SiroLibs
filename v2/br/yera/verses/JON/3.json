            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agera ko bamamaza i Ninewe icagezwe ciwe n’ic’ abaganwa biwe, ngo Ntihagire umuntu agira ico atamira, n’ibitunzwe n’uko, vy’amasho n’imikuku, ntihagire ico birya cank’ amazi binywa; ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.7",
            "verseOrgIds": [
              "JON.3.7"
            ]
          }
        },
        {
