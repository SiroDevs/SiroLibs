                  "text": "Yow 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta wubizi: kumbure Imana yohindukira, ikīgarura, ikareka uburake bgayo bg’inkazi, ntiduhone.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.9",
            "verseOrgIds": [
              "JON.3.9"
