              "type": "text"
            }
          ]
        },
        {
          "text": "Inkuru zishika ku mwami w’i Ninewe, ahaguruka ku ntebe yiwe yiyambura imyambaro yiwe, yambara igunira, yicara mu munyota. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.6",
