          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.12.8"
              },
              "items": [
                {
                  "text": "Rom 12:8",
