                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.2.29"
              },
              "items": [
                {
                  "text": "Flp 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru b’ishengero baganza neza ni babiyumvire ko bakwiye guhabga icubahiro kirushiriza, kandi cane‐cane abacumukura mu kuvuga ijambo ry’Imana no mu kwigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.17",
            "verseOrgIds": [
              "1TI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Gus 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.15"
              },
              "items": [
                {
                  "text": "24:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.9"
              },
              "items": [
                {
                  "text": "1 Kor 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.7"
              },
              "items": [
                {
                  "text": "Luk 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw icanditswe kivuga, ngo Ntimuze murumye umunwa w’inka irikw irasekura ingano; kandi ng’ Umukozi akwiye ingero yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.18",
            "verseOrgIds": [
              "1TI.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TI 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "Gus 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.16"
              },
              "items": [
                {
                  "text": "Mat 18:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.13.1"
              },
              "items": [
                {
                  "text": "2 Kor 13:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukuru ntukemere ico bazomukuregako hatabonetse ivyabona bibiri canke bitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.19",
            "verseOrgIds": [
              "1TI.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TI 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.14"
              },
              "items": [
                {
                  "text": "Gal 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakora ivyaha ubahanire mu maso ya bose, kugira ngw abandi na bo batinye. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.5.20",
            "verseOrgIds": [
              "1TI.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
