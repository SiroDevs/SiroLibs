          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi wa mirongwibiri na kane w’ukwezi kw’icenda, mu mwaka ugira kabiri Dariyo ari ku ngoma, ijambo ry’Uhoraho ryavugiye muri Hagayi uwavugishwa na we, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.10",
            "verseOrgIds": [
              "HAG.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAG 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
