              "items": [
                {
                  "text": "Hag 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabateje kurumvya n’ururyi n’urubura ku vyo mwakoresheje amaboko yanyu vyose: na ho nyene ntimwangarukako, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.17",
            "verseOrgIds": [
              "HAG.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAG 2:18"
          },
          "items": [
            {
