              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.3.10"
              },
              "items": [
                {
                  "text": "Ezr 3:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.9"
              },
              "items": [
                {
                  "text": "Zek 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndabinginze, ni mwitegereze ivyabaye gushitsa uyu musi, gushitsa umusi wa mirongwibiri na kane w’ukwezi kw’icenda, mwitegereze n’ivyabaye uhereye umusi itanguriro ry’urusengero rw’ Uhoraho ryashirwaho. ",
