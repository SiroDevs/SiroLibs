            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi nzohindisha amahanga yose agashitsi, kand’ ivy’ igiciro vyo mu mahanga yose bizoza, nanje nzokwuzuza iyi ngoro ubgiza, ni k’Uhoraho Nyen’ ingabo agize. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.7",
            "verseOrgIds": [
              "HAG.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAG 2:8"
          },
          "items": [
