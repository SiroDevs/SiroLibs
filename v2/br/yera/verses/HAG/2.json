                "loc": "HEB.12.26"
              },
              "items": [
                {
                  "text": "Heb 12:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasigaye rimwe, maze mu gihe gitoya ngatigitisha ijuru n’isi n’ikiyaga n’i musozi; ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.6",
            "verseOrgIds": [
              "HAG.2.6"
            ]
