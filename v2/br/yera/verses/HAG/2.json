              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uku ni k’Uhoraho Nyen’ ingabo agize, at’ Enda baza abaherezi ku vy’ ivyagezwe, ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.11",
            "verseOrgIds": [
              "HAG.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAG 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ut’ Umuntu yojana inyama z’ikimazi zejejwe mu mutwe w’impuzu yiwe, maz’ agakoza uwo mutwe w’impuzu ku mutsima canke mu mufa canke muri vino canke mu mavuta ya elayo canke ku co kurya cose, mbega vyoca biba ivyera? Abaherezi barishura, bati Na mba! ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.12",
            "verseOrgIds": [
              "HAG.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAG 2:13"
          },
          "items": [
