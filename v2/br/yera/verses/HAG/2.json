            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk’ukw ijambo ryanje riri nabasezeraniye igihe mwava muri Egiputa, kandi Mpwemu wanje akaba muri mwebge: nuko ntimutinye. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.5",
            "verseOrgIds": [
              "HAG.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAG 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
