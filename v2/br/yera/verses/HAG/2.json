              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amafeza n’ayanje, n’amazahabu nyene n’ayanje, ni k’Uhoraho Nyen’ ingabo agize. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.8",
            "verseOrgIds": [
              "HAG.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAG 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgiza bgo hanyuma buzoba kur’ iyi ngoro buzorusha ubga mbere, ni k’Uhoraho Nyen’ ingabo agize, kand’ aha hantu nzohaha amahoro, ni k’Uhoraho Nyen’ ingabo agize.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.2.9",
            "verseOrgIds": [
              "HAG.2.9"
            ]
          }
        }
      ]
