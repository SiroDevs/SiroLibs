                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ab’ i bumanuko bazokwegukira umusozi wa Esau; n’ababa mu kiyaya begukire i Bufilisitiya; bazokwegukira igihugu ca Efurayimu, n’igihugu c’i Samariya: kand’ i Gileyadi hazoba aha Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.19",
            "verseOrgIds": [
              "OBA.1.19"
            ]
          }
