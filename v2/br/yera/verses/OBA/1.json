              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umusi w’Uhoraho uri hafi, uziye amahanga yose: uko wagize ni k’uzogirirwa; ivyo wakoze bizogusubira ku mutwe. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.15",
            "verseOrgIds": [
              "OBA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
