            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uko mwanywereye ku musozi wanje wera, uko ni kw amahanga yose azokwama anywa na ntaryo; mbere bazonywa bagotomere, bamere nk’abatakiriho.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.16",
            "verseOrgIds": [
              "OBA.1.16"
            ]
          }
