              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.10+2KI.25.11+2KI.25.12+2KI.25.13+2KI.25.14+2KI.25.15+2KI.25.16+2KI.25.17+2KI.25.18+2KI.25.19+2KI.25.20"
              },
              "items": [
                {
                  "text": "2 Abam 25:10-20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.7"
