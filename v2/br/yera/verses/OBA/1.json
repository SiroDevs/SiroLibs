                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubg’ inabi wagiriye mwene nyoko Yakobo uzomāramāra, uzorandurwa uheneberezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.10",
            "verseOrgIds": [
              "OBA.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "OBA 1:11"
          },
          "items": [
