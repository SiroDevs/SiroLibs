                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.3"
              },
              "items": [
                {
                  "text": "Yow 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri wa musi wari wihagarariye urāba utw’ ininga, umusi ab’ akavantara bāsahura ibintu vyiwe, abanyamahanga bakamūzira mu marembo, bagapfindira i Yerusalemu, nawe wari nk’uwo muri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.11",
            "verseOrgIds": [
              "OBA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "OBA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.11"
              },
              "items": [
                {
                  "text": "Mik 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.7.8"
              },
              "items": [
                {
                  "text": "7:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara ntiwar’ ukwiye kurāba utw’ ininga umusi wa mwene nyoko ugeze, ku musi yashikiweko n’ivyago; umusi Abayuda bagesezwa, ntivyari bikwiye kukunezereza; ntiwari gutwengera mw ijigo ku musi w’amazigirizwa yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.12",
            "verseOrgIds": [
              "OBA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "OBA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu banje ntiwari kubāzira mw irembo, umusi baboneyekw amagorwa; mbere ntiwari kwirābira utw’ ininga agahahazo barimwo, umusi baboneyekw amagorwa; kandi ntiwari gusahura ibintu vyabo, umusi baboneyekw amagorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.13",
            "verseOrgIds": [
              "OBA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "OBA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiwar’ ukwiye guhagarara mu mayirabiri ng’ utikize ababo bacitse, kandi ntiwari gutanga amasigarira yabo ku musi w’amazigirizwa yabo.",
          "type": "text",
          "attrs": {
            "verseId": "OBA.1.14",
            "verseOrgIds": [
              "OBA.1.14"
            ]
          }
        }
      ]
    },
