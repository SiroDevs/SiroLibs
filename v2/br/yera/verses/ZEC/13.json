              "items": [
                {
                  "text": "Mat 26:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikangure, wa nkota we, urwanye umwungere wanje, urwanye umuntu mugenzanje, ni k’Uhoraho Nyen’ ingabo agize; kubita umwungere, intama zisanzare; kandi n’imyagazi nzoyihindurirak’ ukuboko kwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.7",
            "verseOrgIds": [
              "ZEC.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ ico gihugu cose, ni k’Uhoraho agize, ibice bibiri vyo muri co bizorandurwa bipfe, arikw ica gatatu kizosigazwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.8",
            "verseOrgIds": [
              "ZEC.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
