                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi ab’inzu ya Dawidi n’ababa i Yerusalemu bazotoborerwa imbizi yo kubōza ivyaha n’ibihumane. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.1",
            "verseOrgIds": [
              "ZEC.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.13"
              },
              "items": [
                {
                  "text": "Kuv 23:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.13"
              },
              "items": [
                {
                  "text": "Mik 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.2"
              },
              "items": [
                {
                  "text": "Zek 10:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo musi nzoherengeteza amazina y’ibigirwamana mu gihugu, ni k’Uhoraho Nyen’ ingabo agize, vyoye kuzokwibukwa ukundi; kandi ba kamenyi nzobamaririkanya mu gihugu bo n’impwemu zihumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.2",
            "verseOrgIds": [
              "ZEC.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.13.1+DEU.13.2+DEU.13.3+DEU.13.4+DEU.13.5+DEU.13.6+DEU.13.7+DEU.13.8+DEU.13.9+DEU.13.10+DEU.13.11"
              },
              "items": [
                {
                  "text": "Gus 13:1-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ni haramuka habonetse uwīgira ngw aravugishijwe, se na nyina bāmwivyariye bazomubgira, bati Ntugenda udapfuye, kuk’ uvuga ibinyoma mw izina ry’Uhoraho: maze se na nyina bāmwivyariye bazomutobekeranya akibivuga. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.3",
            "verseOrgIds": [
              "ZEC.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.8"
              },
              "items": [
                {
                  "text": "2 Abam 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.7"
              },
              "items": [
                {
                  "text": "Mik 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko kur’ uwo musi abīgira abavugishwa n’Imana bazogira isoni z’ivyo bārose, umuntu wese muri bo akirikw arabivuga; kandi ntibazoba bacambara insāto zo guhumbagura: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.4",
            "verseOrgIds": [
              "ZEC.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.7.14"
              },
              "items": [
                {
                  "text": "Am 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arik’ umuntu wese azovuga, ati Sind’ ūvugishwa n’Imana; jewe nd’umurimyi, kuko nagizwe umukozi uhereye mu buto bganje. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.5",
            "verseOrgIds": [
              "ZEC.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bamubajije, bat’ Izo nguma zo mu biganza vyawe n’iz’ iki? Na we azokwishura, ati N’izo nakomerekeye mu nzu y’abakunzi banje.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.13.6",
            "verseOrgIds": [
              "ZEC.13.6"
            ]
          }
        }
      ]
    },
