        },
        {
          "text": "Uku ni k’Uhoraho agize, uwāgānuye amajuru agashirah’ itanguriro ry’isi, akarema impwemu yo mu muntu, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.1",
            "verseOrgIds": [
