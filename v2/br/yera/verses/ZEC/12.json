                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "umuryango w’inzu ya Lewi ukwawo, n’abagore babo ukwabo; umuryango w’Abashimeyi ukwawo, n’abagore babo ukwabo; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.13",
            "verseOrgIds": [
              "ZEC.12.13"
            ]
          }
        },
