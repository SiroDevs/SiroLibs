                {
                  "text": "Ivyah 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzosuka ku nzu ya Dawidi no ku baba i Yerusalemu impwemu y’ubuntu n’iyo gusenga; kandi bazokwitegereza uwo bācumise; bazomuborogera nk’ ūborogera umwana wiwe w’ikinege, bamurware akabonge nk’ūkarwazwa n’imfura yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
