              "items": [
                {
                  "text": "Zek 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Ehe nzohindura Yerusalemu igikombe co kudandabagiranya amahanga yose ahakikije, igihe bazoba bateye Abayuda, bugarije Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.2",
            "verseOrgIds": [
              "ZEC.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.2"
              },
              "items": [
                {
                  "text": "Zek 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.21.44"
              },
              "items": [
                {
                  "text": "Mat 21:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi nzohindura Yerusalemu ibuye riremēra amahanga yose, abazoryikorera bose bazokomereka bibi; kand’ amahanga yose yo mw isi azokoranywa no kuharwanya. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.3",
            "verseOrgIds": [
              "ZEC.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.28"
              },
              "items": [
                {
                  "text": "Gus 28:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.76.6"
              },
              "items": [
                {
                  "text": "Zab 76:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi, ni k’Uhoraho agize, nzogwisha igihūmura ifarasi yose, kand’ ūri kuri yo nzomutēza ibisazi. Nzosubiza amaso ku nzu ya Yuda, kand’ ifarasi yose y’amahanga nzoyitēza uruhumyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.4",
            "verseOrgIds": [
              "ZEC.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatware b’ Abayuda bazokwibgira mu mitima, bat’ Ababa muri Yerusalemu ni bo nkomezi zacu, kuko bafise Uhoraho Nyen’ ingabo kw Imana yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.5",
            "verseOrgIds": [
              "ZEC.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.14"
              },
              "items": [
                {
                  "text": "Yer 5:14",
                  "type": "text"
                }
              ]
            },
