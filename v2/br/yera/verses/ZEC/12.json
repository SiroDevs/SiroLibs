              },
              "items": [
                {
                  "text": "14:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi abatware b’Abayuda nzobahindura nk’urujo rurik’ umuriro rushirwa mu nkwi, canke nk’urumuri rwaka rushizwe mu mikama y’ingano; bazotōngōra amahanga yose abakikije i buryo n’i bumoso; kandi Yerusalemu hazokwongera kwubakwa aho hāhoze, ni ho i Yerusalemu nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.6",
            "verseOrgIds": [
              "ZEC.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Uhoraho azobanza gukiza amahema y’Abayuda, kugira ngw ishimwe ry’inzu ya Dawidi n’ishimwe ry’ababa i Yerusalemu ryoye gushirwa hejuru gusumba iry’ Abayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.7",
            "verseOrgIds": [
              "ZEC.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.19.27"
              },
              "items": [
                {
                  "text": "2 Sam 19:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.22"
              },
              "items": [
                {
                  "text": "Yes 60:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi Uhoraho azokīranira ababa i Yerusalemu; umunyantege nke wo muri bo kur’ uwo musi azomera nka Dawidi; kand’ inzu ya Dawidi izomera nk’Imana, nk’ umumarayika w’Uhoraho ar’ imbere yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.8",
            "verseOrgIds": [
              "ZEC.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.3"
              },
              "items": [
                {
                  "text": "Zek 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo musi nzokwitwaririka kugeseza amahanga yose yaje gutera i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 12:10"
          },
