              "items": [
                {
                  "text": "Luk 3:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igihugu kizoboroga, umuryango wose ukwawo; umuryango w’inzu ya Dawidi ukwawo, n’abagore babo ukwabo; umuryango w’inzu ya Natani ukwawo, n’abagore babo ukwabo; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12",
            "verseOrgIds": [
              "ZEC.12.12"
            ]
          }
        },
