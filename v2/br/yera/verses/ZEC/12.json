            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi hazoba umuborogo ukomeye i Yerusalemu, nka ya maborogo yabaye i Hadadi‐rimoni mu kiyaya c’i Megidoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
