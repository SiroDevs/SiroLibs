                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abazoba bari kure bazoza bubake urusengero rw’Uhoraho; ni ho muzomenya yuk’ Uhoraho Nyen’ ingabo ari we yabantumyeko. Ivyo bizoshika ni mwagira umwete wo kwumvira ijwi ry’Uhoraho Imana yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.15",
            "verseOrgIds": [
              "ZEC.6.15"
            ]
