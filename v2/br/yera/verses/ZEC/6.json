              },
              "items": [
                {
                  "text": "Ezk 21:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koko ni we azokwubaka urusengero rw’Uhoraho, azogira icubahiro, kand’ azovyagira ku ntebe, aganze; kur’ iyo ntebe azohabera n’umuherezi; kandi bompi bazohuza inama zizana amahoro. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.13",
            "verseOrgIds": [
              "ZEC.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ZEC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ivyo bitsibo bizobera Helemu na Tobiya na Yedaya na Heni mwene Zefaniya icibutso mu rusengero rw’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.6.14",
            "verseOrgIds": [
              "ZEC.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
