            "number": "10",
            "style": "v",
            "sid": "ZEC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mureke kurya abapfakazi n’impfuvyi n’ingenzi na ba nyarucari; ntihagire n’umwe muri mwebge yīgīra imigabo mu mutima wiwe yo kugirira nabi mugenzi we. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.10",
            "verseOrgIds": [
              "ZEC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 7:11"
          },
