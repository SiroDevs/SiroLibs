            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere bīkomantaje imitima imera nk’isare, ngo boye kwumva ivyagezwe n’amajambo Uhoraho Nyen’ ingabo yarungitse muri Mpwemu wiwe, ayavugira mu bavugishwa na we ba kera; ni co catumye uburake buhambaye buva k’Uhoraho Nyen’ ingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.12",
            "verseOrgIds": [
              "ZEC.7.12"
            ]
          }
        },
