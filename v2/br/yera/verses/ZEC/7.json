            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko banka kwumva, bantera ibitugu, bīziba amatwi ngo boye kwumva. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.11",
            "verseOrgIds": [
              "ZEC.7.11"
            ]
          }
        },
