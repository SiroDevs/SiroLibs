              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Uku ni k’ Uhoraho Nyen’ ingabo yagize, ati Ni muce imanza ziroranye, umuntu wese agirire mugenzi we imbabazi n’ikigongwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.9",
            "verseOrgIds": [
              "ZEC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
