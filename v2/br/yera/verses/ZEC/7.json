                {
                  "text": "1 Sam 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.9"
              },
              "items": [
                {
                  "text": "Mal 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ab’i Beteli bāri batumye Shareseri na Regemu‐Meleki n’abantu babo, ngo binginge Uhoraho abahangaze, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.2",
            "verseOrgIds": [
              "ZEC.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.8"
              },
              "items": [
                {
                  "text": "2 Abam 25:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.12"
              },
              "items": [
                {
                  "text": "Zek 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngo babonane n’abaherezi bo mu ngoro y’Uhoraho Nyen’ ingabo n’abavugishwa n’Imana, bababaze, bati Mbega dukwiye kwama turira mu kwezi kwa gatanu, twigungiye ukwacu, nk’uko twabigenza mur’ iyo myaka yose ukw ingana? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.3",
            "verseOrgIds": [
              "ZEC.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijambo ry’ Uhoraho Nyen’ ingabo rinzako, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.4",
            "verseOrgIds": [
              "ZEC.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 7:5"
          },
          "items": [
