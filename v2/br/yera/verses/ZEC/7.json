                "loc": "1CO.11.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo murya cank’ iyo munywa, mbega si mwebge mwīrīra ubganyu, mukīnywera ubganyu? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.6",
            "verseOrgIds": [
              "ZEC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.26"
              },
              "items": [
                {
                  "text": "Yer 17:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntimwari mukwiye kwumva amajambo Uhoraho yavugiye mu bāvugishwa na we ba kera, hamwe Yerusalemu hāri hagitūritse, hakir’ amahoro, bo n’ibisagara vyaho bihakikije, kand’ igihugu c’i bumanuko no mu biyaya na vyo bigitūritse?",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.7",
            "verseOrgIds": [
              "ZEC.7.7"
            ]
          }
        }
      ]
