        },
        {
          "text": "Mu mwaka ugira kane Dariyo ari ku ngoma, ijambo ry’Uhoraho ryaje kuri Zekariya ku musi wa kane w’ukwezi kw’icenda kwitwa Kisilevu. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.1",
            "verseOrgIds": [
              "ZEC.7.1"
            ]
          }
        },
        {
