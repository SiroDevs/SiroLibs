            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nk’uko nahamagaye bakica amatwi, ni ko na bo bazohamagara nanje nkica amatwi, ni k’Uhoraho Nyen’ ingabo agize; ",
          "type": "text",
          "attrs": {
