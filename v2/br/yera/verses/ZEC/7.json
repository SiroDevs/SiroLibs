            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.12"
              },
              "items": [
                {
                  "text": "Zek 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Barira abantu bose bo mu gihugu, bo n’abaherezi, uti Hamwe mwahora mwisonzesha mukaboroga mu kwezi kwa gatanu no mu kw’indwi mur’ iyi myaka yose ukw ari mirongwirindwi, mbega ni jewe ubganje mwagiye mwisonzeshereza? ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.7.5",
            "verseOrgIds": [
              "ZEC.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 7:6"
          },
          "items": [
