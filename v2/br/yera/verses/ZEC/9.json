                "loc": "HOS.1.7"
              },
              "items": [
                {
                  "text": "Hos 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.5"
              },
              "items": [
                {
                  "text": "Mik 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
