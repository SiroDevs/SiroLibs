              },
              "items": [
                {
                  "text": "21:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nezerwa cane, wa mukobga w’i Siyoni we! Sēsereza impundu, wa mukobga w’i Yerusalemu we! Rāba, umwami wawe aje kuri wewe, n’umugororotsi, kand’ ari n’inganji; yicishije bugufi, agendera ku ndogoba, mbere ni ku mukangara, inyana y’indogoba. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.9",
            "verseOrgIds": [
              "ZEC.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.8"
              },
              "items": [
                {
                  "text": "Zab 72:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
