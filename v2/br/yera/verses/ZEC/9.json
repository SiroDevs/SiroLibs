            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.5"
              },
              "items": [
                {
                  "text": "Zek 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umufilisitiya nzomuhanagura amaraso mu kanwa, ndamukūre n’ibizira mu menyo; na we azoba indokorano ku Mana yacu, abe nk’umutware w’i Buyuda, kand’ uwo muri Ekuroni azoba nk’Umuyebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.7",
            "verseOrgIds": [
              "ZEC.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.4"
              },
              "items": [
                {
                  "text": "Zek 10:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.4"
              },
              "items": [
                {
                  "text": "12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingoro yanje nzoyisagaza impande zose, ndayibuze igitero, kugira ngo ntihagire ūhaca aja irya cank’ agaruka, kugira ng’ uwabatwaza ituntu ntiyongere kubaca hagati: kuko noneho mvyiboneye n’amaso yanje.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.8",
            "verseOrgIds": [
              "ZEC.9.8"
            ]
          }
        }
      ]
    },
