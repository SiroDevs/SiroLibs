                "loc": "DEU.17.9"
              },
              "items": [
                {
                  "text": "Gus 17:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Uku ni k’Uhoraho Nyen’ ingabo agize, ati Ni wagendera mu nzira zanje, ukitondera ivyo nakujeje, nawe uzogaba ivyo mu ngoro yanje, urinde n’urugo rwanje, kandi nzoguha ubgishikira hagati mur’ aba bahagaze hano. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
