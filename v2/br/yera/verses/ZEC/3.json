            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe rāba ibuye nshize imbere ya Yosuwa: kur’ iryo buye rimwe harikw amaso ndwi; ehe nzoricakw amagarwe, ni k’Uhoraho Nyen’ ingabo agize; kand’ ukugabitanya kw’ico gihugu nzogukūrah’ umusi umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
