        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.1",
            "verseOrgIds": [
              "HEB.6.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.9.14"
              },
              "items": [
                {
                  "text": "Heb 9:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero turēngāne ivya mbere vya Kristo, twīgire imbere, dushike ku vyo gutunganywa rwose, twoye gusubira gushirah’ itanguriro ryo kwihana ibikorwa vy’impfagusa, no kwizera Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.1",
            "verseOrgIds": [
              "HEB.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kwigisha ivyo kubatizwa n’ivyo kurambikwakw ibiganza, n’ivyo kuzuka kw’abapfuye, n’ivyo gucirwakw iteka kw’ibihe bidashira. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.2",
            "verseOrgIds": [
              "HEB.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ni yabikunda turagenza durtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.3",
            "verseOrgIds": [
              "HEB.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.26"
              },
              "items": [
                {
                  "text": "Heb 10:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.27"
              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.31"
              },
              "items": [
                {
                  "text": "Mat 12:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.16"
              },
              "items": [
                {
                  "text": "1 Yoh 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw abamaze kwākirwa n’umuco, bagatamira ingabire iva mw ijuru, bagasangira Mpwemu Yera, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.4",
            "verseOrgIds": [
              "HEB.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.3"
              },
              "items": [
                {
                  "text": "1 Pet 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bagatamira ijambo ryiza ry’Imana, n’ububasha bgo mu gihe kizoza, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.5",
            "verseOrgIds": [
              "HEB.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze bakagwa bakabivamwo, ntibishoboka gusubira kubahindura basha ngo bihane: kuko bongera kwibambira Umwana w’Imana, bakamutēterereza ahibonekeza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.6",
            "verseOrgIds": [
              "HEB.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.11"
              },
              "items": [
                {
                  "text": "Ita 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.1.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indimiro zinyoye imvura yaziguyeko kenshi, iyo zimezemw’ ibirimwa bikwiye abazirimiwe, zironka umugisha w’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.7",
            "verseOrgIds": [
              "HEB.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.17"
              },
              "items": [
                {
                  "text": "Ita 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.3.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw iyo zimezemw’ imikere n’ibitovu, ziba zisivye, ziba zishigaje gatoya zikavumwa, iherezo ryazo n’uguturirwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.8",
            "verseOrgIds": [
              "HEB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.8",
            "verseOrgIds": [
              "HEB.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, abo nkunda, naho tuvuze durtyo, turazi ivyanyu tudakekeranya yuko birusha ivyo kuba vyiza, kandi bizanana n’agakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.9",
            "verseOrgIds": [
              "HEB.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.32+HEB.10.33+HEB.10.34"
              },
              "items": [
                {
                  "text": "Heb 10:32-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ntigabitanya ngo yibagire ibikorwa vyanyu n’urukundo mwerekanye ko mukunze izina ryayo, kuko mwātunga abera, na none mukibatunze. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.10",
            "verseOrgIds": [
              "HEB.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.14"
              },
              "items": [
                {
                  "text": "Heb 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.6"
              },
              "items": [
                {
                  "text": "Flp 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi turagomba cane yuk’ umuntu wese wo muri mwebge yerekana uwo mwete nyene w’ivyizigiro vyuzuye gushitsa kw iherezo: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.11",
            "verseOrgIds": [
              "HEB.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo ntimube ibinebge, ariko mwīgāne abaheshwa n’ukwizera n’ukwihangana kuragwa ivyasezeranywe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.12",
            "verseOrgIds": [
              "HEB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.12",
