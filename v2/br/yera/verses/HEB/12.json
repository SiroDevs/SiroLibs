                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko muzi yuko hanyuma, hamwe yagomba kuragwa umugisha, atemerewe, kukw atābonye uburyo bgo kwihana, naho yawurondera cane arira.",
          "type": "text",
