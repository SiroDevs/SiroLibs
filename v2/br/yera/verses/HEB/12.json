        {
          "text": "ntihabeh’ umushakanyi, cank’ igihumane nka Esau, yagurānye ivyo kuba samuragwa kwiwe ingaburo imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.16",
