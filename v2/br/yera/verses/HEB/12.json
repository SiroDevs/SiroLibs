              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko batābashije ivyagezwe, ngo Naho coba igitungwa gikoze kur’ uwo musozi bacicishe amabuye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.20",
