          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuragera ku kuvishwa amaraso murwanya icaha, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.4",
            "verseOrgIds": [
              "HEB.12.4"
            ]
          }
        },
