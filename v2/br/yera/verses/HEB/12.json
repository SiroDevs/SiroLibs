            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "dutumbereye Yesu wenyene, ni we nyanduruko yo kwizera kandi ni we yagusozereye; uwo, kubg’ umunezero yashizwe imbere, yihanganiye umusaraba, ntiyagira ikindi isoni zawo, avyagira i buryo bg’intebe y’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.2",
            "verseOrgIds": [
              "HEB.12.2"
            ]
