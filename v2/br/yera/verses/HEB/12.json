            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwizigame, ntihagire umuntu adashikīra ubuntu bg’Imana, kandi ntihagire umuzi wo kurura umera, ukabahagarika imitima, abenshi bakāndura, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.15",
