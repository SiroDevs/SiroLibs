              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo jambo, ngo Hasigaye rimwe, ryerekana gukūrwaho kw’ibinyiganyizwa, kukw ar’ ivyaremwe, kugira ngw ibitoshobora kunyiganyizwa bigumeho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
