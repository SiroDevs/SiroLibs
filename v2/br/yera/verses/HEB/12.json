                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijwi ryayo ryanyiganyigije isi ico gihe: ariko noneh’ irasezeranye, iti Hasigaye rimwe, ngatigitisha, s’isi gusa, ariko n’ijuru na ryo. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.26",
