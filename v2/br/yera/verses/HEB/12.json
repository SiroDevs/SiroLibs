          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi mwibagiye rya jambo ribahubūra ribahanūra nk’abana,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.5",
            "verseOrgIds": [
              "HEB.12.5"
            ]
          }
        }
