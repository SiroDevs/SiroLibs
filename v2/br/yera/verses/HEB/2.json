            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uweza n’abezwa bose bākomotse kur’ Imwe: ni co gituma atagira isoni zo kubīta bene Se,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.11",
            "verseOrgIds": [
              "HEB.2.11"
