              "items": [
                {
                  "text": "Gal 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kw ijambo ryavugiwe mu kanwa k’abamarayika ryagumyeho, kand’ ibicumuro vyose no kutaryumvira bikagererwa ingero bikwiranye, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.2",
            "verseOrgIds": [
              "HEB.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.29"
              },
              "items": [
                {
                  "text": "Heb 10:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.25"
              },
              "items": [
                {
                  "text": "12:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "tweho tuzokwikiza dute, ni twanjanjwa ku gakiza kangana gartyo? Kabanje kuvugwa n’Umwami wacu, kagakomezwa kuri twebge n’abakumvise, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.3",
            "verseOrgIds": [
              "HEB.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
