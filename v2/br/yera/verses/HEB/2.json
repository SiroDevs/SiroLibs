          ]
        },
        {
          "text": "Ni co gituma dukwiye kurushiriza kwitwaririka ivyo twumvise, kugira ngo ntidutwarwe akayombekere tukabivako. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.1",
            "verseOrgIds": [
