              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ifatanije na bo kugashingira intahe, iyishingisha ibimenyetso n’ibitangaza n’ibikomeye vy’uburyo bginshi n’ingabire za Mpwemu Yera zagabanganijwe nk’uko yagomvye.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.2.4",
            "verseOrgIds": [
              "HEB.2.4"
            ]
          }
        }
      ]
    },
    {
