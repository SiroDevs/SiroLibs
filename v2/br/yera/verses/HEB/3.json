          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, ni mwirinde, ntihagire uwo muri mwebge agira umutima mubi utizera, umutera kureka Imana nzima. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.12",
            "verseOrgIds": [
              "HEB.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.11"
              },
              "items": [
                {
                  "text": "1 Tes 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko muhanūrane uko bukeye bicitwa uyu musi, ntihagire uwo muri mwebge akomantazwa umutima n’uruhendo rw’icaha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.13",
            "verseOrgIds": [
              "HEB.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
