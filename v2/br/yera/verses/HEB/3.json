              "items": [
                {
                  "text": "11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko twacitse abasangiye Kristo, namba tubangirije rwose ivyizigiro vyacu twatanguranye gushitsa kw iherezo: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.3.14",
            "verseOrgIds": [
              "HEB.3.14"
            ]
          }
        },
