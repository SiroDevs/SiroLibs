                {
                  "text": "Guh 19:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw ivyo, hamwe n’ivy’ ivyo kurya n’ivyo kunywa n’ivyo kwiyuhagira bo n’ukwoza vy’uburyo bginshi, ar’ amabgirizwa yo mu buryo bg’abantu gusa, yashinzwe gushitsa igihe co gutunganywa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.10",
            "verseOrgIds": [
              "HEB.9.10"
            ]
