          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
