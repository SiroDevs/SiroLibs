            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababgira, at’ Aya ni yo maraso y’isezerano Imana yabagereye. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.20",
