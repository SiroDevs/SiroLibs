            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose amaze kubgira abantu bose amabgirizwa yose nk’uko vyagezwe, yābīra amaraso y’amashūri n’ay’ impene n’amazi n’ubgoya bg’intama buzigishijwe agahama, yābīra na ezobu,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:19",
              "type": "text"
            },
            {
              "text": "ezobu n’agati bācucagirisha.",
              "type": "text"
            }
          ]
        },
        {
          "text": " acucagira igitabo c’ivyagezwe, bo n’abantu bose, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.19",
            "verseOrgIds": [
              "HEB.9.19"
            ]
