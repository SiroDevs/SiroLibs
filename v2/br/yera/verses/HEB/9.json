                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ihema n’imbombovu zose z’ivy’ ubuherezi, na vyo n’uko abicucagira amaraso. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.21",
            "verseOrgIds": [
              "HEB.9.21"
            ]
