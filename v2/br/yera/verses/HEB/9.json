                "loc": "HEB.10.19"
              },
              "items": [
                {
                  "text": "Heb 10:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpwemu Yera amenyekanisha artyo yukw inzira ija ahēra cane itaribgerekanwe, ihema rya mbere rikiriho: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.8",
            "verseOrgIds": [
              "HEB.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.1"
              },
              "items": [
                {
                  "text": "Heb 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.10.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ryo kigereranyo c’igihe ca none, abakurikira ivyagezwe vyaryo bashikana amashikanwa bagatanga ibimazi, ariko ku ruhande rw’ijwi ryo mu mutima ntibishobora gutunganya ūsenga, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.9",
            "verseOrgIds": [
              "HEB.9.9"
            ]
          }
        },
        {
