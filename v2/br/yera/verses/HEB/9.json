            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma aba umuhūza, ahesha isezerano risha, kugira ngw abāhamagawe bahabge umwandu udashira w’isezerano, bitewe n’uko habayeh’ urupfu rucungura abacumuye bakiganzwa n’isezerano rya mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.15",
            "verseOrgIds": [
              "HEB.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ah’ icete c’iragi kiri hakwiye rwose yuk’ urupfu rw’uwaraze ruseruka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.16",
            "verseOrgIds": [
              "HEB.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icete c’iragi kibeshwaho n’urupfu rwonyene, kuko kitagira ikimazi uwaraze akiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.17",
            "verseOrgIds": [
              "HEB.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma isezerano rya mbere ritāsezeranywe ata maraso. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.18",
            "verseOrgIds": [
              "HEB.9.18"
            ]
          }
