              "type": "text"
            }
          ]
        },
        {
          "text": "Non’ amaraso y’impene n’ay’ amapfizi bo n’umunyota w’inka y’iriza ucucagiwe abahumanye, ko vyeza imibiri igahumanuka, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.13",
            "verseOrgIds": [
