          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntiyashikanyweyo no kwitanga kenshi, nk’uk’ umuherezi mukuru yinjira ahēra cane uk’ umwaka utashe, ajanye amaraso atar’ ayiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.25",
            "verseOrgIds": [
              "HEB.9.25"
            ]
          }
        },
