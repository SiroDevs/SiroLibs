                "loc": "LEV.11.2"
              },
              "items": [
                {
                  "text": "Lew 11:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.15.18"
              },
              "items": [
                {
                  "text": "15:18",
