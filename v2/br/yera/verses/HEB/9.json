              "items": [
                {
                  "text": "26:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hejuru yayo hār’ abakerubi b’ubgiza bateye igitūtu umutemere wo guhongerako: ivyo ntidushobora kubidonda kimwe‐kimwe nonaha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.5",
            "verseOrgIds": [
              "HEB.9.5"
            ]
          }
        }
