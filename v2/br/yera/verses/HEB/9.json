                  "text": "Ef 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ukw ivyagezwe biri, ibintu ni nka vyose vyozwa n’amaraso, kandi hatavuye amaraso ntihaba guharirwa ivyaha.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.22",
