            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hār’ ihema ryiteguwe, mu ryo hino hārimw’ igiterekwakw amatara, n’ameza, n’imitsima y’ibiterekerwa yama kuri yo: iryo ryitwa Ahēra. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.2",
            "verseOrgIds": [
              "HEB.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.26.33"
              },
              "items": [
                {
                  "text": "Kuv 26:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hirya y’igihuzu ca kabiri gikinze, hār’ ihema ryitwa Ahēra Cane: ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.3",
            "verseOrgIds": [
              "HEB.9.3"
            ]
          }
        },
        {
