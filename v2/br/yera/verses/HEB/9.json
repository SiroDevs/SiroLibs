            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko mu rya kabiri hinjiramw’ umuherezi mukuru wenyene, rimwe gusa uk’ umwaka utashe, ariko ntiyinjiramwo atajanye amaraso yo kwitangirira no gutangirira ubuzimuzimu bg’abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.7",
            "verseOrgIds": [
              "HEB.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 9:8"
          },
