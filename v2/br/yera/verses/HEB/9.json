            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Kristo atinjiye ahēra cane hākozwe n’intoke, h’ikigereranyo c’ah’ ukuri, ariko yinjiye mw ijuru ubgaho, kugira ngo non’ aduserukire imbere y’inyonga z’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.9.24",
            "verseOrgIds": [
              "HEB.9.24"
            ]
          }
        },
        {
