                "loc": "MAT.25.36"
              },
              "items": [
                {
                  "text": "Mat 25:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwibuke ababoshwe nk’ababohanywe na bo: mwibuke n’abagirirwa nabi, kuko namwe muri mu mubiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.3",
            "verseOrgIds": [
              "HEB.13.3"
            ]
          }
        },
        {
