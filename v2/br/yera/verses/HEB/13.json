            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.22"
              },
              "items": [
                {
                  "text": "12:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hano tutahafise igisagara kizokwamaho, ariko turondera ikizoza. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.14",
            "verseOrgIds": [
