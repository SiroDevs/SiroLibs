                "loc": "LEV.16.27"
              },
              "items": [
                {
                  "text": "Lew 16:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw imivyimba ya vya bitungwa, ivyo umuherezi mukuru ajana amaraso yavyo ahēra kuba impongano y’ivyaha, ituririrwa inyuma y’insago. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.13.11",
            "verseOrgIds": [
              "HEB.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 13:12"
          },
          "items": [
