                "loc": "HEB.7.19"
              },
              "items": [
                {
                  "text": "7:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyagezwe ko bifise igitūtu c’ivyiza bizoza, bidafise ishusho bgite y’ivyo vyiza, nta ho vyoshobora guhīngūra abēgēra igicaniro, bibahīngūrisha ivyo bimazi nyene bahora batanga imyaka n’imyaka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo bibishobora, mbega ntibaba barasizeho kubitanga? Kukw abavyitangirira bamaze guhumanurwa rwose rimwe, bataba bakigira imitima irimw’ ijwi ribāgiriza ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.21"
              },
              "items": [
                {
                  "text": "Lew 16:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mur’ ivyo bimazi har’ icibukiriza ivyaha uk’ umwaka utashe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko bidashoboka kw amaraso y’amapfizi n’ay’ impene akūrah’ ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye, hamwe yaza mw isi, avuga,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.5",
            "verseOrgIds": [
              "HEB.10.5"
            ]
          }
        }
      ]
    },
    {
