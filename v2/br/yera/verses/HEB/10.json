              "items": [
                {
                  "text": "Kuv 29:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umuherezi wese ahagarara uko bukeye akora ivy’ ubuherezi, atanga kenshi ivyo bimazi nyene, ata ho vyoshobora gukūrah’ ivyaha na mba. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.11",
            "verseOrgIds": [
              "HEB.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwo we, amaze gutanga ikimazi kimwe c’ivyaha c’intahava, avyagira i buryo bg’Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.12",
            "verseOrgIds": [
              "HEB.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.110.1"
              },
              "items": [
                {
                  "text": "Zab 110:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahēraho, arorēra igihe abansi biwe bazohindurirwa indava yo musi y’ibirenge vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.13",
            "verseOrgIds": [
              "HEB.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ikimazi kimwe ari co yatunganishije rwose abezwa, ukazoshitsa ibihe bidashira. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.14",
            "verseOrgIds": [
              "HEB.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na Mpwemu Yera ni we cabona kidushingira intahe y’ivyo. Amaze kuvuga,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.15",
            "verseOrgIds": [
              "HEB.10.15"
            ]
          }
        }
      ]
    },
