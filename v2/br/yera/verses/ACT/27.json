          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.25.12"
              },
              "items": [
                {
                  "text": "Ivyak 25:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze gushinga ngo tujabuke tuje muri Italiya, Paulo n’izindi mbohe babaha umugabisha w’abasoda ijana yitwa Yuliyo, wo mu ngabo za Augusito. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.1",
            "verseOrgIds": [
              "ACT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.19.29"
              },
              "items": [
                {
                  "text": "Ivyak 19:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.4"
              },
              "items": [
                {
                  "text": "20:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dutambukira mu bgato bgāvuye muri Aduramutiyo, bugira bugende bujabukiranya ahantu ho muri Asiya haherereye ku kiyaga, tuvudukayo turi kumwe na Arisitariko Umunyamakedoniya w’i Tesalonike. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.2",
            "verseOrgIds": [
              "ACT.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.24.23"
              },
              "items": [
                {
                  "text": "Ivyak 24:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.2"
              },
              "items": [
                {
                  "text": "28:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye bg’aho dufata i Sidoni, Yuliyo agirira Paulo neza, amukundira kugendera abagenzi ngo bamuzimane. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.3",
            "verseOrgIds": [
              "ACT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuvudukayo, duca musi y’i Kupuro ngo tuhīkinge umuyaga, kuko war’ uduturutse imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.4",
            "verseOrgIds": [
              "ACT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tujabutse ikiyaga gihereranye n’i Kilikiya n’i Pamfiliya, dufata mu gisagara c’i Lukiya citwa Mura. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.5",
            "verseOrgIds": [
              "ACT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugabisha w’abasoda ijana ahasanga ubgato buvuye muri Alekisanderiya buja muri Italiya, adushiramwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.6",
            "verseOrgIds": [
              "ACT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumaze imisi myinshi tugenda buhoro, dushika hafi y’i Kinido bitugoye cane, maz’ umuyaga utubujije duca musi y’i Kirete, imbere y’i Salumone, ngo tuhikinge umuyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.7",
            "verseOrgIds": [
              "ACT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuhakikira bitugoye cane, dushika ahantu hitwa Vyambuvyiza, hafi y’igisagara citwa Laseya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        }
      ]
    },
    {
