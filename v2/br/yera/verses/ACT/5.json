              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kubazana babashira mw ikombe: umuherezi mukuru arababaza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.27",
            "verseOrgIds": [
