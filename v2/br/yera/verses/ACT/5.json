                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma yiwe hāduka Yuda Umunyagalilaya, mu misi yo kwandikwa, yikwegera abantu inyuma; na we apfa rubi, n’abāmwumvira bose uko bangana barasābagira. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.37",
            "verseOrgIds": [
              "ACT.5.37"
            ]
