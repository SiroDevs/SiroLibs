          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arababarira, ati Yemwe bagabo b’Abisirayeli, ni mwirinde mumenye uko mugirira aba bantu: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.35",
