            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibimenyetso n’ibitangaza vyinshi bikorwa mu bantu n’amaboko y’intumwa: kandi bose bākoranira mw ibaraza rya Salomo n’umutima uhūye: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.12",
            "verseOrgIds": [
              "ACT.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko mu bandi nta muntu yatinyuka kwifatanya na bo, yamar’ abantu bose bārabashimagiza, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.13",
            "verseOrgIds": [
              "ACT.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
