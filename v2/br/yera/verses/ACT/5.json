            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Petero n’intumwa barabishura, bat’ Igikwiye n’ukwumvira Imana kuyirutisha abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.29",
