              "items": [
                {
                  "text": "21:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bārushiriza kwongerwakw abizeye Umwami Yesu, ishengero ryinshi ry’abagabo n’abagore; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.14",
            "verseOrgIds": [
              "ACT.5.14"
            ]
          }
        },
        {
