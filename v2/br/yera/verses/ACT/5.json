            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi none ndababgire: Ni muzibukire aba bantu, mubarekure: kukw iyi nama n’iki gikorwa ni vyaba biturutse mu bantu, bizosendwa: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.38",
