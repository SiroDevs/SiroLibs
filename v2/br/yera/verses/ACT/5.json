                  "text": "Ivyak 21:38",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko mu misi ishize Teyuda yādutse yiyita agakomeye, igitigiri c’abantu gishika nk’amajana ane gikondōrera inyuma yiwe: maz’ aricwa, abāmwumvira bose barasābagira, bacika ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.36",
