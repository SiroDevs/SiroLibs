            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo Imana yaramushize hejuru n’ukuboko kwayo kw’i buryo, ngw abe Umukuru n’Umukiza, ngw ahe Abisirayeli kwihana no guharirwa ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.31",
