              "items": [
                {
                  "text": "Mrk 6:56",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bituma banaterurira abarwaye ku nzira, babashira mu nderuzo no ku birago, kugira ngo Petero ni yahaca, naho coba igitūtu ciwe gishike kuri bamwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.15",
            "verseOrgIds": [
              "ACT.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakoranira ishengero rivuye no mu bisagara bihereranye n’i Yerusalemu, bazana abarwaye n’abababazwa n’impwemu zihumanye: bakizwa uko bangana.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.16",
            "verseOrgIds": [
              "ACT.5.16"
            ]
          }
        }
      ]
