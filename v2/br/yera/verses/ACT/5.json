            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ya ba sogokuruza yazuye Yesu, uwo mwebge mwishe mumumanitse ku giti. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.5.30",
            "verseOrgIds": [
