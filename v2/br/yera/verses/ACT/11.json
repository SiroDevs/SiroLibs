          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intumwa na bene Data bar’i Yudaya bumva yukw abanyamahanga na bo bemeye ijambo ry’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.1",
            "verseOrgIds": [
              "ACT.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.45"
              },
              "items": [
                {
                  "text": "Ivyak 10:45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Petero adūze i Yerusalemu, abo mu bākebge baramutonganya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.2",
            "verseOrgIds": [
              "ACT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.2.12"
              },
              "items": [
                {
                  "text": "Gal 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.11"
              },
              "items": [
                {
                  "text": "Ef 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati Ko winjiriye abatākebge, ugasangira na bo! ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.3",
            "verseOrgIds": [
              "ACT.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Petero aratangura, abibasobanurira uko bikurikirana, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.4",
            "verseOrgIds": [
              "ACT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.9+ACT.10.10+ACT.10.11+ACT.10.12+ACT.10.13+ACT.10.14+ACT.10.15+ACT.10.16+ACT.10.17+ACT.10.18+ACT.10.19+ACT.10.20+ACT.10.21+ACT.10.22+ACT.10.23+ACT.10.24+ACT.10.25+ACT.10.26+ACT.10.27+ACT.10.28+ACT.10.29+ACT.10.30+ACT.10.31+ACT.10.32+ACT.10.33+ACT.10.34+ACT.10.35+ACT.10.36+ACT.10.37+ACT.10.38+ACT.10.39+ACT.10.40+ACT.10.41+ACT.10.42+ACT.10.43+ACT.10.44+ACT.10.45+ACT.10.46+ACT.10.47+ACT.10.48"
              },
              "items": [
                {
                  "text": "Ivyak 10:9-48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Nari mu gisagara c’i Yopa, ndiko ndasenga, mbona neretswe nko mu nzozi ikintu kimanuka kivuye mw ijuru, kimeze nk’uruhuzu runiniya rufashwe ku mitwe ine, kiza aho ndi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.5",
            "verseOrgIds": [
              "ACT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngihanga amaso, ndacitegereza, mbonamw’ ibigenza amaguru ane vyo kw isi, n’ibikōko vyo mw ishamba, n’ibikwega inda hasi, n’ibiguruka vyo mu kirēre. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.6",
            "verseOrgIds": [
              "ACT.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi numva ijwi rimbarira, riti Va hasi, Petero, ubāge urye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.7",
            "verseOrgIds": [
              "ACT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje nt’ Oyaye, Mwami, kukw ata kizira cank’ igihumanya cigeze kija mu kanwa kanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.8",
            "verseOrgIds": [
              "ACT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijwi rimbarira ubugira kabiri rivuye mw ijuru, rit’ Ivy’ Imana ihumanuye, reka kuvyita ibizira. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.9",
            "verseOrgIds": [
              "ACT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biba birtyo gatatu, biradūzwa vyose, bisubizwa mw ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.10",
            "verseOrgIds": [
              "ACT.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwanya abagabo batatu bavuye i Kayisariya, bantumweko, bahagarara imbere y’inzu turimwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.11",
            "verseOrgIds": [
              "ACT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpwemu ambarira kujana na bo, ata tandukaniro. Kandi na bene Data aba, ukw ari batandatu, turajana, twinjira mu nzu y’uwo mugabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.12",
            "verseOrgIds": [
              "ACT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atwīgānira ingene yabonye umumarayika mu nzu yiwe, ahagaze amubarira, ati Tuma i Yopa, utumeko Simoni ari we Petero, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.13",
            "verseOrgIds": [
              "ACT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "azokubarira amajambo yo kugukizanya n’abo mu nzu yawe bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.14",
            "verseOrgIds": [
              "ACT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngitanguye kuvuga, Mpwemu Yera arabamanukira, nk’uko yamanukiye kuri twebge ubga mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.15",
            "verseOrgIds": [
              "ACT.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.1.5"
              },
              "items": [
                {
                  "text": "Ivyak 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibuka rya jambo ry’Umwami Yesu, uko yavuze, ati Yohana yabatirishije amazi, ariko mweho muzobatizwa na Mpwemu Yera. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.16",
            "verseOrgIds": [
              "ACT.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "None kw Imana yabahaye ingabire imwe n’iyo natwe twahawe hamwe twizera Umwami Yesu Kristo, jewe nd’ iki gishobora gutāngīra Imana? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.17",
            "verseOrgIds": [
              "ACT.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.13.48"
              },
              "items": [
                {
                  "text": "Ivyak 13:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.27"
              },
              "items": [
                {
                  "text": "14:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bumvise ivyo barīhorera, bahimbaza Imana, bati Noneho rer’ Imana ihaye n’abanyamahanga kwihana ngo baronke ubugingo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.11.18",
            "verseOrgIds": [
              "ACT.11.18"
            ]
          }
        }
      ]
    },
