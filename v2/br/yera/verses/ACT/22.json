          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bukeye bg’aho, agomvye kumenya neza ic’ Abayuda bamurega ic’ ari co, aramubohora, agera kw abaherezi bakuru bakorana n’abanyekombe bose, amanukana Paulo, amuhagarika imbere yabo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
