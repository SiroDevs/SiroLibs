                "loc": "ACT.13.2"
              },
              "items": [
                {
                  "text": "13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aranyishura, ati Genda, kuko nzogutuma kure ku banyamahanga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
