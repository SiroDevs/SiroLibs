          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndamubona ambgira, ati Tebuka, uve i Yerusalemu vuba, kuko batazokwemera ivy’ unshingira intahe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
