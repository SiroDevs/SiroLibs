            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ngarutse i Yerusalemu, nariko ndasenga mu rusengero, mmera nk’ūrota, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
