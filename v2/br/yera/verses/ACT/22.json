          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.58"
              },
              "items": [
                {
                  "text": "Ivyak 7:58",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.1"
              },
              "items": [
                {
                  "text": "8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hamwe amaraso y’uwagushingira intahe Stefano yava, nanje ni ho nari mpagaze, mbishimye, nsanze impuzu z’abāmwica. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
