          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.24.8"
              },
              "items": [
                {
                  "text": "Ivyak 24:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mbariwe yuko bahigiye uwo mugabo, nca ndamukurungikira, mbarira abarezi ko bamuregera imbere yawe. Ndakwikebanuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        }
      ]
