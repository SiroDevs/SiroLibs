          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "aravuga, ati Nzokwumva ivyawe abarezi bawe ni bamara kuza. Agera ko bamurindira mw iboma ya Herode.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.35",
            "verseOrgIds": [
              "ACT.23.35"
