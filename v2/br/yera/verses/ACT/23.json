                {
                  "text": "Ivyak 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kugisoma abaza intāra y’i wabo iy’ ari yo; amenye kw ar’uw’ i Kilikiya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
