              },
              "items": [
                {
                  "text": "24:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ahanga amaso abanyekombe, arababgira, ati Bagabo bene Data, nāmanye umutima utarimw’ ijwi rinyagiriza ikibi na kimwe imbere y’Imana gushitsa kur’ uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.22"
              },
              "items": [
                {
                  "text": "Yoh 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.18.23"
              },
              "items": [
                {
                  "text": "23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananiya umuherezi mukuru abarira abamuhagaze i ruhande kumukubita ku munwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.2",
            "verseOrgIds": [
              "ACT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.27"
              },
              "items": [
                {
                  "text": "Mat 23:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.10+EZK.13.11+EZK.13.12+EZK.13.13+EZK.13.14+EZK.13.15"
              },
              "items": [
                {
                  "text": "Ezk 13:10-15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.15"
              },
              "items": [
                {
                  "text": "Lew 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Paulo aramubgira, at’ Imana izogukubita, wa rusika rukuyengejekw ingwa: mbega wewe ko wicaritswe no kuncira urubanza nk’ukw ivyagezwe biri, ugatako ukavuga ko bankubita ukanyuranya n’ivyagezwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.3",
            "verseOrgIds": [
              "ACT.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abāri bahagazeho, bati Mbeg’ uratuka umuherezi mukuru w’Imana? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.4",
            "verseOrgIds": [
              "ACT.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.28"
              },
              "items": [
                {
                  "text": "Kuv 22:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo, ati Sinari ndamuzi, bene Data, kw ar’ umuherezi mukuru; kuko handitswe ngo Ntukavuge nabi umukuru wo mu bgoko bganyu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
