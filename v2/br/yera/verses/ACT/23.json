                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona yuko bamurega amajambo y’ivyagezwe vyabo, ariko kw ata co yarezwe gikwiye kumwicisha canke kumubohesha. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.29",
            "verseOrgIds": [
              "ACT.23.29"
            ]
          }
        },
        {
          "name": "verse",
