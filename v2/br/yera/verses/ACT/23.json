                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Non’ uyo mugabo Abayuda bāri bamaze kumuta mu maboko bagira bamwice, nanje mmenye kw ar’ Umuroma nzanana n’ingabo ndamubakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.27",
            "verseOrgIds": [
              "ACT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.30"
              },
              "items": [
                {
                  "text": "Ivyak 22:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nshatse kumenya ico bamurega, ndamumanukana mw ikombe ryabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.28",
            "verseOrgIds": [
              "ACT.23.28"
            ]
          }
        },
        {
