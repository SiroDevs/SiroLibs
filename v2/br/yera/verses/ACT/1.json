            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:12",
              "type": "text"
            },
            {
              "text": "Urugendo rwemewe kugendwa kw isabato rwari nka km 1.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
