                "loc": "MRK.13.32"
              },
              "items": [
                {
                  "text": "Mrk 13:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati S’ivyanyu kumenya imisi cank’ ibihe Data yashinze n’ububasha bgiwe wenyene; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.7",
            "verseOrgIds": [
              "ACT.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko muzohabga ubushobozi, Mpwemu Yera ni yabazako, muzoba ivyabona vyo kunshingira intahe i Yerusalemu, n’i Yudaya hose, n’i Samariya, no gushitsa ku mpera y’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.8",
            "verseOrgIds": [
              "ACT.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
