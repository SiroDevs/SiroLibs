                {
                  "text": "Luk 24:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagihanze amaso mw ijuru akigenda, abagabo babiri bambaye impuzu zera bahagarara i ruhande yabo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.10",
            "verseOrgIds": [
              "ACT.1.10"
            ]
          }
        },
        {
