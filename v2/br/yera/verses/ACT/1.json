              },
              "items": [
                {
                  "text": "Mat 13:55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bose bāsenga badahumeka n’umutima uhūye, hamwe n’abagore, na Mariya nyina wa Yesu, na bene nyina.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.14",
