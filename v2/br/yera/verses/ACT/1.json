              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ iyo misi Petero ava hasi ahagarara hagati ya bene Data, (hāri hakoraniye ishengero ry’abantu nk’ijana na mirongwibiri), aravuga, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.15",
