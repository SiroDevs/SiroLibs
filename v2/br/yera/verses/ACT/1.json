              "type": "text"
            }
          ]
        },
        {
          "text": "barababaza, bati Yemwe bagabo b’i Galilaya, n’iki gitumye muhagaze murāba mw ijuru? Uyo Yesu, abakūwemwo, akadūzwa mw ijuru, azoza artyo, nk’uko mumubonye aja mw ijuru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.11",
            "verseOrgIds": [
