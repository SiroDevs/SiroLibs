              "items": [
                {
                  "text": "Yoh 6:62",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kuvuga artyo, adūzwa babona, igicu kimukūra mu maso yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.9",
            "verseOrgIds": [
              "ACT.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 1:10"
          },
          "items": [
