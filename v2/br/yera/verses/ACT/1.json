        },
        {
          "text": "Buno basubira i Yerusalemu, bavuye ku musozi witwa Elayono, uri hafi y’i Yerusalemu nk’urugendo rwemewe kugendwa kw’ isabato.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.12",
            "verseOrgIds": [
              "ACT.1.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
