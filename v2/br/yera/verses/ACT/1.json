            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bakoranye, baramubaza, bati Mwami, iki gihe ni co ugira ugarukane ingoma y’Abisirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.6",
            "verseOrgIds": [
              "ACT.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
