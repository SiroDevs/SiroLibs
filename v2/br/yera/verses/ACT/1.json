                  "text": "Luk 6:13-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitseyo, barūrira baja mu nzu yo hejuru, aho bāri basembereye, ari Petero, na Yohana, na Yakobo, na Andereya, na Filipo, na Toma, na Barutolomayo, na Matayo, na Yakobo mwene Alufayo, na Simoni Zelote, na Yuda mwene Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.13",
            "verseOrgIds": [
              "ACT.1.13"
            ]
          }
        },
        {
