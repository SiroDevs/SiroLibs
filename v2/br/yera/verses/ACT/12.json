              "items": [
                {
                  "text": "Ezk 27:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ashāmira abo muri Tiro n’i Sidoni, na bo bahūza inama, baja kuri we, bahongera Bulasito, umukuru w’abagaranzurira umwami, basaba impore, kukw igihugu cabo casuma mu gihugu c’uwo mwami. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.20",
            "verseOrgIds": [
              "ACT.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ku musi washinzwe, Herode yambara impuzu z’ubgami, avyagira ku ntebe y’icubahiro, abacūrira amajambo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
              "ACT.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 12:22"
          },
