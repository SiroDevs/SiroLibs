                "loc": "ACT.5.21"
              },
              "items": [
                {
                  "text": "Ivyak 5:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
