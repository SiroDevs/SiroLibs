                "loc": "ACT.4.3"
              },
              "items": [
                {
                  "text": "Ivyak 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nko mur’ ico gihe umwami Herode ata mu maboko bamwe bo mw ishengero ngw abagirire nabi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.1",
            "verseOrgIds": [
              "ACT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yicisha inkota Yakobo mwene nyina wa Yohana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.2",
            "verseOrgIds": [
              "ACT.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abonye ko bihimbaye Abayuda, ariyongeza, afata na Petero. Hāri mu misi y’imitsima itambiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.3",
            "verseOrgIds": [
              "ACT.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kumufata, amushira mw ibohero, amuha abasoda cumi na batandatu kumurinda ari bane‐bane, agira ngw az’ amushikirize abantu, Pasika ishize. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.4",
            "verseOrgIds": [
              "ACT.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.5.16"
              },
              "items": [
                {
                  "text": "Yak 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Petero arindirwa mw ibohero: arikw ab’ishengero baramusengera, batakambira Imana bakobeje.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.5",
            "verseOrgIds": [
              "ACT.12.5"
            ]
          }
        }
      ]
    },
    {
