                "loc": "EZK.28.2"
              },
              "items": [
                {
                  "text": "Ezk 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu barasemerera, bati N’ijwi ry’imana, s’iry’ umuntu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
              "ACT.12.22"
            ]
          }
        },
        {
