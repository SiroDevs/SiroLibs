                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.37"
              },
              "items": [
                {
                  "text": "15:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kuvyiyumvira, aja kwa Mariya, nyina wa Yohana ari we Mariko, aho bāri bakoraniye benshi, bariko barasenga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.12",
            "verseOrgIds": [
              "ACT.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero akomanga ku rugi rw’irembo, umukobga w’umugurano yitwa Rode aja kwumvīra. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.13",
            "verseOrgIds": [
              "ACT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amenye ijwi rya Petero akanyamuneza kamubuza kwugurura, arirukanga arinjira, ababarira yuko Petero ahagaze kw irembo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.14",
            "verseOrgIds": [
              "ACT.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.24"
              },
              "items": [
                {
                  "text": "Ivyak 26:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.37"
              },
              "items": [
                {
                  "text": "Luk 24:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura, bat’ Urasara. Na we avuga ashimitse kw ar’ivy’ ukuri. Bati N’umumarayika wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.15",
            "verseOrgIds": [
              "ACT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Petero ashishikara gukomanga: buguruye baramubona, barūmirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.16",
            "verseOrgIds": [
              "ACT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabamama, abīgānira uk’Umwami Imana yamukūye mw ibohero, arababgira, at’ Ivyo mubibarire Yakobo na bene Data bandi. Arahava, aja ahandi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.17",
            "verseOrgIds": [
              "ACT.12.17"
            ]
          }
        }
      ]
    },
