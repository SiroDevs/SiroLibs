              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kuvuga ubutumwa bgiza mur’ ico gisagara no guhindura benshi abigishwa, basubira i Lusitira no muri Ikoniyo no muri Antiyokiya, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.21",
            "verseOrgIds": [
              "ACT.14.21"
            ]
