          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abigishwa bahagaze bamukikije, aravyuka, aja mu gisagara; bukeye bg’aho avanayo na Barunaba, aja i Derube. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.20",
            "verseOrgIds": [
              "ACT.14.20"
            ]
          }
        },
        {
