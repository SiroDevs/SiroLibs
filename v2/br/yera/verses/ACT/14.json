              "items": [
                {
                  "text": "Yoh 9:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Lusitira hār’ umugabo yar’ aremaye ibirenge uhereye aho yakaviriye mu nda ya nyina, nta ho yari yarigeze gutambuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.8",
            "verseOrgIds": [
              "ACT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.3.4"
              },
              "items": [
                {
                  "text": "Ivyak 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.28"
              },
              "items": [
                {
                  "text": "Mat 9:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo yumva Paulo avuga, na we amuhanze amaso abona kw afise ukwizera kwo gukizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.9",
            "verseOrgIds": [
              "ACT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuga n’ijwi rirenga, ati Hagarara n’ibirenge vyawe, weme. Arabaduka, aratambuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.10",
            "verseOrgIds": [
              "ACT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.6"
              },
              "items": [
                {
                  "text": "Ivyak 28:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ishengero ribonye ico Paulo akoze, bavuga n’ijwi rirenga mu Kinyalukawoniya, bat’ Imana zitumanukiyemwo zīshushanije n’abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.11",
            "verseOrgIds": [
              "ACT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barunaba bamwita Zeyu, Paulo na we bamwita Herume, kukw ari we yar’ imvuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.12",
            "verseOrgIds": [
              "ACT.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umuherezi wa Zeyu, ingoro y’igitabo cayo yar’ imbere y’igisagara, azana amapfizi n’imyīshwa, agira acumite ikimazi, we n’ishengero. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.13",
            "verseOrgIds": [
              "ACT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw intumwa, Barunaba na Paulo, bavyumvise, bītantamurirakw impuzu zabo, bītera mu bantu, basemerera, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.14.14",
            "verseOrgIds": [
              "ACT.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
