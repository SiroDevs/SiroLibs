                  "text": "2 Pet 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abo bantu batuka ivyo batazi: kandi n’ivyo bamenyeshwa n’akameremere kabo, nk’ukw ibikōko bimeze bitagira ubgenge, na vyo nyene baravyiyonōnesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.10",
            "verseOrgIds": [
              "JUD.1.10"
            ]
          }
        },
