                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo n’ivyubirizi mw isangira ryanyu ry’urukundo, iyo basangira namwe ivyiza; n’abungere bīragira ubgabo ata dusoni: n’ibicu bitagira amazi, bikubebga hose n’umuyaga; n’ibiti birumvye bitāma, vyapfuye kabiri, vyaranduranywe n’imizi; ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.12",
            "verseOrgIds": [
              "JUD.1.12"
            ]
          }
        },
        {
