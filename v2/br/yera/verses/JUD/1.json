                {
                  "text": "2 Pet 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko hariho bamwe bābājemwo binyegeteza, bandikiwe kera gucirwakw iryo teka, batubaha Imana, bahindura ubuntu bg’Imana yacu isoni nke, bakīhakana Yesu Kristo, ni we wenyene Databuja n’Umwami wacu.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.4",
            "verseOrgIds": [
              "JUD.1.4"
            ]
