                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko na Mikayeli, umumarayika mukuru, hamwe yatongana na wa Murwanizi, ahārīra na we bapfa umuvyimba wa Mose, ntiyubahutse kumuhinyura ngw amucokore, ariko yamubgiye, at’ Uhoraho aguhane. ",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.9",
            "verseOrgIds": [
              "JUD.1.9"
            ]
          }
        },
        {
