            }
          ]
        },
        {
          "text": "Kandi n’abantu b’i Sodomu n’i Gomora bo n’ibisagara vyari bihereranye na ho, kuko bitanze bakīha ubusambanyi nka ba bandi, n’ukwendana, ukw imibiri itaremewe, ivyo bisagara vyashiriweho kuba akabarore, bibabazwa n’igihano c’umuriro utazima.",
          "type": "text",
          "attrs": {
            "verseId": "JUD.1.7",
