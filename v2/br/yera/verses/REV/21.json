          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "REV 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bazozanay’ ubgiza n’icubahiro vy’amahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
              "REV.21.26"
            ]
          }
        },
