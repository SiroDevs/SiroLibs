                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " itanguriro n’iherezo. Ūfise inyota nzomuha kunywa kw isōko y’amazi y’ubugingo ku buntu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.6",
