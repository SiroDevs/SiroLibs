            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ amahanga azogendera mu muco wawo, abami bo kw isi bazozanay’ ubgiza bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.24",
            "verseOrgIds": [
              "REV.21.24"
            ]
