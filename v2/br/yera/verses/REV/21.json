              "type": "tag",
              "attrs": {
                "loc": "ISA.60.1+ISA.60.2+ISA.60.3+ISA.60.4+ISA.60.5+ISA.60.6+ISA.60.7+ISA.60.8+ISA.60.9+ISA.60.10+ISA.60.11+ISA.60.12+ISA.60.13+ISA.60.14+ISA.60.15+ISA.60.16+ISA.60.17+ISA.60.18+ISA.60.19+ISA.60.20"
