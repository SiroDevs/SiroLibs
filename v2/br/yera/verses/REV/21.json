              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.31+EZK.48.32+EZK.48.33+EZK.48.34+EZK.48.35"
              },
              "items": [
                {
                  "text": "Ezk 48:31-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uzigujwe n’urugo runini rurerure rufise ibirimba cumi na bibiri, no mu birimba harih’ abamarayika cumi na babiri, kandi hār’ amazina yanditsweko, ni yo y’imiryango cumi n’ibiri y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.12",
            "verseOrgIds": [
              "REV.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahahera i burasirazuba har’ ibirimba bitatu; ahahera i burārūko har’ ibirimba bitatu; ahahera i bumanuko har’ ibirimba bitatu; ahahera i burengerazuba har’ ibirimba bitatu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.13",
            "verseOrgIds": [
              "REV.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urugo ruziguje uwo murwa rufise amatanguriro cumi n’abiri, yanditswekw amazina cumi n’abiri y’intumwa cumi na zibiri za wa Mwagazi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        }
      ]
