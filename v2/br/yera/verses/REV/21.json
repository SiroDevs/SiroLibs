              },
              "items": [
                {
                  "text": "Zek 14:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibirimba vyawo ntibijishwa na rimwe, kukw ata joro ribayo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.25",
            "verseOrgIds": [
              "REV.21.25"
            ]
          }
        },
