              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo murwa ungana impande zose, uburebure bungana n’ubgaguke. Ageresha uwo murwa rya renga, ageramwo stadiyo",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "21:16",
              "type": "text"
            },
            {
              "text": "stadiyo 12.000 ni nk’ibilometero 2.000.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ibihumbi cumi na bibiri: uburebure bg’umurambararo n’ubgaguke n’uburebure bg’igihagararo birangana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.16",
            "verseOrgIds": [
              "REV.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agera urugo rwawo, rushikana amatambge ijana na mirongwine n’ane, y’ukuboko uciriye mu nkokora, nk’ukw itambge ritambishwa ukuboko kw’umuntu ringana, ni kw iry’ umumarayika ringana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.17",
            "verseOrgIds": [
              "REV.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urugo rwawo rwubakishijwe yasipi, umurwa war’ izahabu ishize inkamba imeze nk’ibirahuri bishize inkamba nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.18",
            "verseOrgIds": [
              "REV.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
