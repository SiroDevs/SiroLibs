              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona umurwa wera, Yerusalemu musha, wururuka uva mw ijuru ku Mana, witeguwe nk’uk’ umugeni asharizwa umugabo wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.2",
            "verseOrgIds": [
