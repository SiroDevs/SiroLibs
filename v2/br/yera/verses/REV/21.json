                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi wa murwa nturinda kwākirwa n’izuba canke n’ukwezi, kuk’ ubgiza bg’Imana ari bgo buwākira, kandi wa Mwagazi ari we tara ryawo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.23",
