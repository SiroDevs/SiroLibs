              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.43.16"
              },
              "items": [
                {
                  "text": "Ezk 43:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.48.16"
              },
              "items": [
                {
                  "text": "48:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
