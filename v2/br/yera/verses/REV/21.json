                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ufise ubgiza bg’Imana. Ugukayangana kwawo gusa n’ukw’ ibuye ry’akabuyenge ry’igiciro kinini cane, nk’akabuyenge kitwa yasipi, kabonerana nk’icirore, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.11",
            "verseOrgIds": [
              "REV.21.11"
            ]
