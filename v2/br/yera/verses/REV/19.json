                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numva ikimeze nk’ijwi ry’ishengero rinini, n’ikimeze nk’ugusūma kw’amazi menshi, n’ikimeze nk’ijwi ry’imituragaro ihambaye, kivuga, kiti Haleluya, kuk’ Umwami Imana yacu ishobora vyose ihangamye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        },
        {
