              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo numva mw ijuru ikimeze nk’ijwi rirenga ry’ishengero ryinshi, riti Haleluya",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:1",
              "type": "text"
            },
            {
              "text": "Haleluya risobanurwa ngo Ni mutazire Uhoraho.",
              "type": "text"
            }
          ]
        },
        {
          "text": "; agakiza n’ubgiza n’ububasha n’ivy’ Imana yacu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        },
