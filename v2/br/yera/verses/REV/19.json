            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijwi riva kur’ iyo ntebe rivuga, riti Ni mushime Imana yacu, yemwe mwese abagurano bayo, abayubaha, aboroshe n’abakomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        },
        {
