        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.104.35"
              },
              "items": [
                {
                  "text": "Zab 104:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.10"
              },
              "items": [
                {
                  "text": "Yes 34:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rivuga ubugira kabiri, riti Haleluya. Kand’ umwotsi wiwe upfunduka ibihe bitazoshira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        },
