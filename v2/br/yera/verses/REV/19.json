            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tunezerwe, duhimbarwe, tuyihe icubahiro, kuk’ ubukwe bga wa Mwagazi w’Intama bushitse, umugeni wiwe ariteguye. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        },
