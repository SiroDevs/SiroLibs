            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bakuru mirongwibiri na bane na vya binyabugingo bine vyikubita hasi, bisenga Imana ivyagira kuri ya ntebe, biti Amen; Haleluya. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
            "verseOrgIds": [
              "REV.19.4"
            ]
          }
        },
        {
