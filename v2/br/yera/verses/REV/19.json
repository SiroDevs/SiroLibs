                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw amateka yayo ar’ay’ ukuri n’ukugororoka. Yaciriyekw iteka umwe maraya w’agahebuza, yononesha abari mw isi ubusambanyi bgiwe, kand’ imuhōye amaraso y’abagurano bayo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
