            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza umumarayika wundi, ahagarara ku gicaniro, afise icotero c’izahabu, ahabga imibavu myinshi ngw ayishire ku gusenga kw’abera bose kuri ku gicaniro c’izahabu kir’ imbere y’iyo ntebe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.141.2"
              },
              "items": [
                {
                  "text": "Zab 141:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwotsi w’umubavu uva mu kuboko kw’umumarayika upfundukana n’ugusenga kw’abera imbere y’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
