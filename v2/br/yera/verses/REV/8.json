            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika ajana icotero, acuzuza umuriro wo ku gicaniro, ashiburira mw isi: habah’ imituragaro n’amajwi n’imiravyo no gutigita kw’isi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
