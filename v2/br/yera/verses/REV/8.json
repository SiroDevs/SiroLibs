          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ikigira gatatu c’ivyaremwe vyo mu kiyaga bifise ubugingo kirapfa; ikigira gatatu c’amato kirahona.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
