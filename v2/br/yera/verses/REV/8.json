              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika wa kabiri aravuza. Ikimeze nk’igisozi kinini caka umuriro gishiburirwa mu kiyaga; ikigira gatatu c’ikiyaga gihinduka amaraso; ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
