          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo nyenyeri yitwa Mururazi. Ikigira gatatu c’amazi gihinduka umururazi, abantu benshi bicwa n’ayo mazi, kuko yarurishijwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
