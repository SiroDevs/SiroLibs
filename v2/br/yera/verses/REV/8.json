            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika wa gatatu aravuza: inyenyeri nini iva mw ijuru iratibuka, yaka nk’urumuri, itibukira ku kigira gatatu c’inzūzi no ku masōko. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
