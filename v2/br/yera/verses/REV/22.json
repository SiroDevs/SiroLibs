                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ arambarira, ati Ntumatanishe ishashara n’ikimenyetso amajambo avugishijwe n’Imana yo mur’ iki gitabo; kukw igihe kiri hafi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.10",
            "verseOrgIds": [
              "REV.22.10"
            ]
          }
        },
        {
