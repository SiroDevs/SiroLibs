              "items": [
                {
                  "text": "Dan 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūgabitanya n’ashishikare agabitanye; uwanduye mu mutima n’ashishikare yandure; ūgororotse n’ashishikare agororoke; uwera n’ashishikare yezwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.11",
