              },
              "items": [
                {
                  "text": "27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta joro rizoba rikiriho, kandi ntibazorinda kubonesherezwa n’itara canke kwākirwa n’izuba, kuk’ Umwami Imana ari yo izobākira, kandi bazoba abami ibihe bitazoshira.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.5",
            "verseOrgIds": [
              "REV.22.5"
            ]
          }
        }
      ]
