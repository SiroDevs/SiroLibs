              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abanshingira intahe babiri nzobavugisha, bazovugishwa imisi igihumbi n’amajana abiri na mirongwitandatu bambaye amagunira.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
