              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abo mu moko n’imiryango n’indimi n’amahanga bazorāba imivyimba yabo imisi itatu n’igihimba, ntibazokunda kw iyo mivyimba ihambga. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
