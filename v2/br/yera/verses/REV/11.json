        {
          "text": "Intangaro y’urusengero uyireke, ntuyigere, kuko yahawe abanyamahanga: kandi n’igisagara cera bazogisiribanga amezi mirongwine n’abiri. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
