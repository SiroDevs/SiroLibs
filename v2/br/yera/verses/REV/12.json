                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mw ijuru numva ijwi rirenga, riti Noneh’ agakiza karashitse, gashikanye n’ubushobozi n’ubgami bg’Imana yacu n’ububasha bga Kristo wayo: kuk’ Umurezi wa bene Data akororewe hasi, yahora abarega ku murango no mw ijoro imbere y’Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.10",
            "verseOrgIds": [
              "REV.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
