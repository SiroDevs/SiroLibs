            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ca gisato c’amahēro kirakororwa, ni co ya nzoka ya mbere, yitwa Murwanizi, irindi ni Satani, ni co kizimiza abari kw isi bose, gikororerwa kw isi, abamarayika baco bakororanwa na co. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.9",
            "verseOrgIds": [
              "REV.12.9"
            ]
          }
        },
        {
