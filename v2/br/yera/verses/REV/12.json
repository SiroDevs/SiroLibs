              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ca gisato, kibonye yuko gikororewe kw isi, gihīga wa mugore yavyaye umuhungu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.13",
            "verseOrgIds": [
              "REV.12.13"
            ]
          }
        },
