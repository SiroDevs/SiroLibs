              },
              "items": [
                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugore ahabga amababa abiri y’inkukuma",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "12:14",
              "type": "text"
            },
            {
              "text": "inkukuma ni yo mpungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nini, kugira ngw agurukire mu bugaragwa ahantu hiwe, ah’ agaburirirwa igihe n’ibihe n’igice c’igihe, arindwa ico kiyoka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.14",
            "verseOrgIds": [
              "REV.12.14"
            ]
          }
        },
