        },
        {
          "text": "Ico kiyoka gisendanisha amazi nk’uruzi avuye mu kanwa kaco inyuma y’uwo mugore kugira ngo kimutwaze uruzi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.12.15",
