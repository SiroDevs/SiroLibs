              "type": "text"
            }
          ]
        },
        {
          "text": "Ikinyabugingo ca mbere casa n’intambge, ica kabiri casa n’inyana, ica gatatu cari gifise mu maso hasa n’ah’ umuntu, ica kane casa n’inkukuma",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
            "verseOrgIds": [
              "REV.4.7"
            ]
          }
        },
        {
