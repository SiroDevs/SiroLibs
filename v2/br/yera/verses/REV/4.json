          },
          "items": [
            {
              "text": "4:7",
              "type": "text"
            },
            {
              "text": "inkukuma ni yo mpungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " iguruka. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.7",
