            {
              "text": "4:3",
              "type": "text"
            },
            {
              "text": "n’utubuyenge tw’igiciro kinini.",
              "type": "text"
            }
          ]
        },
        {
          "text": " n’akitwa sarudiyo:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
            "verseOrgIds": [
              "REV.4.3"
            ]
          }
        },
        {
