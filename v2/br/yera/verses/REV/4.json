          },
          "items": [
            {
              "text": "4:3",
              "type": "text"
            },
            {
              "text": "n’utubuyenge tw’igiciro kinini.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kand’ umunywamazi war’ ukikije iyo ntebe, usa n’akitwa simaragido.",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.3",
