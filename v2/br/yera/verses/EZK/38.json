              "items": [
                {
                  "text": "Ivyah 16:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko navuganye ifuhe n’ uburake bgaka umuriro, nti N’ ukuri, kur’ uwo musi hazoba ugutigita gukomeye mu gihugu c’i Bgisirayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.38.19",
            "verseOrgIds": [
              "EZK.38.19"
            ]
          }
        },
        {
