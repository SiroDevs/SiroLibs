          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ anjana mu ntangaro, angenduza imfuruka zine z’urugo; nsanga izo mfuruka zose z’urugo zubatswek’ utunyubakwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.21",
            "verseOrgIds": [
              "EZK.46.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 46:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukw imfuruka z’urugo ari zine, hāri harumitsekw akanyubakwa; uburebure bgatwo bgār’ amatambge mirongwine y’ukuboko uciriye mu nkokora, amakika yar’ amatambge mirongwitatu: utunyubakwa two mu mfuruka ukw ari tune twār’ urugero rumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.22",
            "verseOrgIds": [
              "EZK.46.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 46:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri two ukw ari tune, hārimw’ imirongo y’amatafari itugendanye, yubatswemw’ amaziko impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.23",
            "verseOrgIds": [
              "EZK.46.23"
            ]
          }
        },
