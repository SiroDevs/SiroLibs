            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni yaramuka akebeye umwe mu basavyi biwe kw ishamvu yiwe, hazoba ahiwe gushitsa kuri wa mwaka w’umwidegemvyo; ico gihe haze hasubizwe segaba; arikw ishamvu azoba yahaye abana biwe izoba iyabo bgite. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.17",
            "verseOrgIds": [
              "EZK.46.17"
            ]
          }
        },
