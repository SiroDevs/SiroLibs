                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Segaba az’ ashikeyo aciye mu rubaraza rw’ikirimba ruhera inyuma, maz’ ahagarare i ruhande y’ igikingi c’ikirimba; abaherezi baze bamutangire ikimazi ciwe co kwoswa n’ibimazi vyiwe vy’ishimwe, maz’ asengere mw ishikiro ry’ico kirimba, aheze aveyo; arikw ico kirimba ntikize kijishwe gushitsa ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.2",
            "verseOrgIds": [
              "EZK.46.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 46:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.10"
              },
              "items": [
                {
                  "text": "Luk 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abantu bo mu gihugu baze bahore basengera imbere y’Uhoraho bar’ inyuma y’ico kirimba ku masabato no mu mboneko z’ukwezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.3",
            "verseOrgIds": [
              "EZK.46.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 46:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.9"
              },
              "items": [
                {
                  "text": "Guh 28:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.28.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.17"
              },
              "items": [
                {
                  "text": "Ezk 45:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibimazi vyo kwoswa segaba azohora atanga k’Uhoraho ku musi w’isabato bize bibe imyagazi y’intama itandatu itagira agasembga, n’ impfizi y’intama imwe itagira agasembga nyene; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.4",
            "verseOrgIds": [
              "EZK.46.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 46:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.17"
              },
              "items": [
                {
                  "text": "Gus 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.24"
              },
              "items": [
                {
                  "text": "Ezk 45:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ishikanwa ry’ifu rigerekwa kur’ iyo mpfizi y’ intama rize ribe ingero yitwa efa, n’irigerekwa ku myagazi y’intama az’ atange ibimushobokeye, no kuri efa yose y’ifu hajekw amavuta, ingero yitwa hini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.5",
            "verseOrgIds": [
              "EZK.46.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 46:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.18"
              },
              "items": [
                {
                  "text": "Ezk 45:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku musi ukwezi kubonetseko, haze hatangwe imasa y’umukangara itagira agasembga, n’imyagazi y’ intama itandatu n’impfizi y’intama; bibe ibitagira agasembga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.6",
            "verseOrgIds": [
              "EZK.46.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 46:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ az’ ashikane ishikanwa ry’ifu, ku masa hajekw ingero imwe yitwa efa, no ku mpfizi y’ intama hajeko efa imwe nyene, no ku myagazi y’intama hajekw ibimushobokeye, kandi kuri efa yose y’ifu hajekw amavuta, ingero yitwa hini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.7",
            "verseOrgIds": [
              "EZK.46.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 46:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi segaba iy’ ashikayo, ace mu rubaraza rw’ikirimba, maz’ ahindukiye ajane iyo nzira nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.8",
            "verseOrgIds": [
              "EZK.46.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 46:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.16.16"
              },
              "items": [
                {
                  "text": "Gus 16:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abantu iyo baje imbere y’ Uhoraho mu misi mikuru ishinzwe, ūzoza aciye mu kirimba giherereye i burārūko aje gusenga, ni yavayo az’ ace mu kirimba giherereye i bumanuko; kand’ ūzoza aciye mu kirimba giherereye i bumanuko, ni yavayo az’ ace mu kirimba giherereye i burārūko: ntaz’ ahindukire mu kirimba yazananye, ariko ni yavayo akomeze atumbere imbere yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.9",
            "verseOrgIds": [
              "EZK.46.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 46:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi segaba iy’ ashikayo, agende hagati yabo, bavuyeyo bavireyo rimwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.10",
            "verseOrgIds": [
              "EZK.46.10"
            ]
          }
        }
      ]
    },
