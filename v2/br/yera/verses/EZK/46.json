            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambarira, at’ Aha ni ho abaherezi bazoteka ibimazi vy’impongano n’ibimazi bitangirwa ivyaha, kandi ni ho bazokaranga amashikanwa y’amafu; kugira ngo boye kubijana mu ntangaro, bakavyezesha abantu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.20",
            "verseOrgIds": [
              "EZK.46.20"
            ]
          }
        }
