            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara segaba ntakanyage amashamvu y’abantu, ngw abasohore mu mashamvu yabo; ariko ni yakebera abana biwe ishamvu, ayikūre ku ho yiganziye ubgiwe, ngw abantu banje boye kuzosābagizwa, ngo hagire umuntu akūrwa mw ishamvu yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.46.18",
            "verseOrgIds": [
              "EZK.46.18"
            ]
