              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bamwe bo mu bakuru b’Abisirayeli baza aho ndi, bicara imbere yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.1",
            "verseOrgIds": [
