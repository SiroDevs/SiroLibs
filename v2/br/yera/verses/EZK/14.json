              },
              "items": [
                {
                  "text": "Ezk 18:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero barira inzu ya Isirayeli, ut’ Uku ni k’Umwami Uhoraho agize, ati Ni mugaruke, mutere ibitugu ibigirwamana vyanyu, mukūre amaso yanyu ku bizira vyanyu vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.6",
            "verseOrgIds": [
              "EZK.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umuntu wese wo mu nzu ya Isirayeli, canke wo mu banyamahanga aba muri bo, yitandukanya nanje, agakimagiza ibigirwamana vyiwe mu mutima, agashira imbere yiwe igitsitaza kimutsinda mu bigabitanyo vyiwe, maz’ akaza k’ūvugishwa nanje ngw amunsigurize; jewe Uhoraho nzomwiyishurira ubganje: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.7",
            "verseOrgIds": [
              "EZK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
