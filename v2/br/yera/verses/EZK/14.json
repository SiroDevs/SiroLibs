          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bazogibgako n’ ibigabitanyo vyabo: ibigabitanyo vya kamenyi bizohwana n’ivy’ ūje kumusiguza ijambo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.10",
            "verseOrgIds": [
