          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ijambo ry’Uhoraho rinzako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.14.2",
            "verseOrgIds": [
              "EZK.14.2"
            ]
          }
        },
        {
          "name": "verse",
