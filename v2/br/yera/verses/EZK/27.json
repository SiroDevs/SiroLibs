            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.38.5"
              },
              "items": [
                {
                  "text": "38:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’i Buperesi n’ab’i Ludi n’ab’i Puti bāri mu ngabo zawe, ar’ abahizi bawe: bāmanika muri wewe inkinzo n’ inkofero z’intambara, bakerekana ubgiza bgawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.10",
            "verseOrgIds": [
              "EZK.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagabo bo muri Aruvadi bāri kumwe n’ ingabo zawe impande zose ku nzitiro zawe z’amabuye, n’Abagamadimu bāri mu minara yawe: bāmanika inkinzo zabo ku nzitiro zawe impande zose, bagashitsa ubgiza bgawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.11",
            "verseOrgIds": [
              "EZK.27.11"
            ]
          }
        }
      ]
    },
