                "loc": "JOL.3.4"
              },
              "items": [
                {
                  "text": "Yow 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’i Yavani n’ab’i Tubali n’ab’i Mesheki na bo bādandaza nawe: bāshōra abagurano n’imbombovu z’ivyakozwe mu miringa bakabikāba ivyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.13",
            "verseOrgIds": [
              "EZK.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ inzu ya Togaruma bākāba ivyawe amafarasi n’amafarasi y’intambara n’inyumbu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.14",
            "verseOrgIds": [
              "EZK.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu b’i Dedani na bo bādandaza nawe: ibidandazwa vy’ababa hirya no hino ku kiyaga vyari mu maboko yawe; kandi bākuzanira amahembe y’inzovu n’imbaho z’ibiti vyitwa imipingo ngo bakābe nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.15",
            "verseOrgIds": [
              "EZK.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’ab’i Siriya bādandaza nawe kubg’ ibitayega vy’ibintu vyavuye mu buhinga bgawe: bākāba ivyawe utubuyenge twitwa nofekina, n’impuzu z’amashigisha, n’izijererenze amabara, n’izera derere, n’utubuyenge twitwa fezaruka n’utwitwa marijani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.16",
            "verseOrgIds": [
              "EZK.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
