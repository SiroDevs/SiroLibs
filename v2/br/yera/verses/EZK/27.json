              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Nawe, mwana w’umuntu, cura intimba uririre Tiro; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.2",
            "verseOrgIds": [
              "EZK.27.2"
            ]
          }
        },
