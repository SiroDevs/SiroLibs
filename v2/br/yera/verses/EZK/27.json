                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubarire Tiro, uti Yewe uba mw ishikiro ku kiyaga, ukaba n’umudandaza ugurira amahanga aba hirya no hino ku kiyaga, uku ni k’Umwami Uhoraho agize, ati Yewe Tiro, waravuze, uti Ndi mwiza vy’agahore! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.3",
            "verseOrgIds": [
              "EZK.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mw idamba ry’ikiyaga ni ho hākubereye urubibe; abākubaje nk’ubgato bāsozereye ubgiza bgawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.4",
            "verseOrgIds": [
              "EZK.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.9"
              },
              "items": [
                {
                  "text": "Gus 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbaho zawe zose bāzibāje mu miberoshi ivuye i Seniri; bākūye amasederi i Lebanoni bayakubāziramw’ umuringoti. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.5",
            "verseOrgIds": [
              "EZK.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.13"
              },
              "items": [
                {
                  "text": "Yes 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu biti vy’imyeloni vy’i Bashani ni vyo bākubāziyemw’ ingafe; intebe zawe bāzibāje mu mbaho z’imiteyashuri zākūwe mu bizinga vyo mu kiyaga vyitwa i Kitimu, bazishazishije kuzidombagizak’ utubaru tw’amahembe y’inzovu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.6",
            "verseOrgIds": [
              "EZK.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihuzu cawe c’ubgato gikozwe mu mpuzu zera derere zijererenze amabara zivuye muri Egiputa, kugira ngo kikubere ibendera; amasufe n’amashigisha vyavuye mu Banyelishahu baba ku kiyaga ni vyo vyakubereye icugamo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.7",
            "verseOrgIds": [
              "EZK.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababa i Sidoni no muri Aruvadi ni bo bār’ abasoza bawe: abanyabgenge bawe baba muri wewe, ewe Tiro, ni bo bāgutumbereza nk’ubgato. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.8",
            "verseOrgIds": [
              "EZK.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashingantahe b’i Gebali n’abanyabgenge baho bāri muri wewe bahoma imiguma yawe: amato yose yo mu kiyaga n’abasoza bayo vyāri muri wewe, bakudandariza ibidandazwa vyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.9",
            "verseOrgIds": [
              "EZK.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "SNG.4.4"
              },
              "items": [
                {
                  "text": "Ind 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.5"
