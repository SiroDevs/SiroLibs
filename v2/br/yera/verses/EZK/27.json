                {
                  "text": "1 Abam 10:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’i Tarushishi bādandaza nawe kubg’ ibitayega vy’ubutunzi bgawe bg’uburyo bginshi; amafeza n’ivyuma n’amabati n’amasāsu ni vyo bākāba ivyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.12",
            "verseOrgIds": [
              "EZK.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 27:13"
          },
          "items": [
            {
