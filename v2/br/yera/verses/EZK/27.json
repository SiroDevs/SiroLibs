                "loc": "ACT.12.20"
              },
              "items": [
                {
                  "text": "Ivyak 12:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’ab’i Buyuda bo n’abo mu gihugu c’i Bgisirayeli bādandaza nawe: bākāba ivyawe ingano ziva i Miniti, n’ibishashara, n’ubūki, n’amavuta ya elayo, n’ umuti wo gusomōra. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.17",
            "verseOrgIds": [
              "EZK.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’ab’i Damasiko na bo bādandaza nawe ibitayega vy’ibintu vyavuye mu buhinga bgawe, kubg’ ibitayega vy’ubutunzi bgawe bg’uburyo bginshi; bāshōra vino ziva i Heluboni n’ubgoya bg’intama bgera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.27.18",
            "verseOrgIds": [
              "EZK.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 27:19"
          },
          "items": [
