                "loc": "2CO.12.2"
              },
              "items": [
                {
                  "text": "2 Kor 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ aramvura igisa n’ukuboko, afata umushatsi wo ku mutwe wanje; maze Mpwemu aranterura, ancisha hagati y’ ijuru n’isi mur’ ukwo kwerekwa n’Imana, mbona anjana i Yerusalemu, anshikana ku rugi rw’ikirimba c’inyubakwa kirābana n’i burārūko, ahār’ intebe y’igishushanyo c’ikēba, gikēba Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.3",
            "verseOrgIds": [
              "EZK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Ezk 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.23"
              },
              "items": [
                {
                  "text": "3:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi rāba, ubgiza bg’Imana y’Abisirayeli ni ho bgāri buri, nk’uko nari narabgerekewe mu kiyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambarira, ati Mwana w’umuntu, enda ni wunamure amaso yawe urābe ahahera i burārūko. Nuko nunamura amaso, ndāba ahahera i burārūko, mbona ca gishushanyo c’ikēba kiri mw irasukiro ry’ikirimba c’igicaniro, ku ruhande rw’i burārūko rwaco. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.5",
            "verseOrgIds": [
              "EZK.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.14"
              },
              "items": [
                {
                  "text": "2 Ngo 36:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambaza, ati Mwana w’ umuntu, mbeg’ ubonye ivyo bakora? Ubonye n’ibizira bikomeye, ivyo ab’ inzu ya Isirayeli bakorera hano vyanteye kwīgira kure y’ ahēra hanje? Arik’ uhava wongera kubona ibindi bizira bikomeye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw anshikana ku rugi rw’ inyubakwa; maze nitegereje, mbona umwenge ku nzu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.7",
            "verseOrgIds": [
              "EZK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambarira, ati Mwana w’umuntu, imba aho nyene ku nzu. Nuko mmaze kwimba, mbona urugi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.8",
            "verseOrgIds": [
              "EZK.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw arambarira, at’ Injira, urābe ibizira bibi bakorera hano hantu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.9",
            "verseOrgIds": [
              "EZK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.1.23"
              },
              "items": [
                {
                  "text": "Rom 1:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndinjira nditegereza; mbona amoko yose y’ibikwega inda hasi, n’ay’ ibikōko bizira, n’ibigirwamana vyose vy’ab’ inzu ya Isirayeli, bishushanijwe ku nzu impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.10",
            "verseOrgIds": [
              "EZK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ imbere yavyo hāri hahagaze abantu mirongwirindwi bo mu bakuru b’ inzu ya Isirayeli; no hagati yabo hāri hahagaze Yazaniya mwene Shafani; kand’ umuntu wese yar’ afise icotero ciwe mu minwe, hagapfunduka imyotsi itāmirana y’ imibavu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.11",
            "verseOrgIds": [
              "EZK.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
