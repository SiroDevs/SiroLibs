          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ anshikana ku rugi rw’ ikirimba co ku ngoro y’Uhoraho carābana n’i burārūko; maze mbona abagore bicaye baborogera ikigirwamana Tamuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambaza, ati Mbeg’ ivyo urabibonye, ga mwana w’umuntu? Uhava wongera kubona ibizira bikomeye biruta ivyo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        }
      ]
    },
