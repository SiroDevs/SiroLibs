                "loc": "PSA.10.11"
              },
              "items": [
                {
                  "text": "Zab 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.15"
              },
              "items": [
                {
                  "text": "Yes 29:15",
