                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.9.9"
              },
              "items": [
                {
                  "text": "Ezk 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambaza, ati Mwana w’umuntu, mbeg’ ubonye ivyo abakuru b’inzu ya Isirayeli bakorera mu mwiza, umuntu wese mu gafuruka kiwe k’ibishushanyo? Kuko bavuga ng’ Uhoraho ntatubona; kandi ng’ Uhoraho yahevye igihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arongera arambgira, at’ Uhava wongera kubona ibindi bizira bikomeye bakora.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        }
      ]
    },
