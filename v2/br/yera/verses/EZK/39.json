          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.19.18"
              },
              "items": [
                {
                  "text": "Ivyah 19:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzorya inyama z’abahambaye, munywe amaraso y’abaganwa bo mw isi, n’ay’ impfizi z’intama, n’ay’ imyagazi, n’ay’ impene, n’ay’ ibimasa, vyose ar’ ibivyibushe vy’i Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.18",
            "verseOrgIds": [
              "EZK.39.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 39:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muzorya ibinure muhāge, munywe amaraso muborerwe, vy’ibimazi mbacumitiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.19",
            "verseOrgIds": [
              "EZK.39.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 39:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzohāgira ku meza yanje, muhāgijwe n’amafarasi aheka abantu n’ayakwega imikogote, n’abahizi, n’ingabo zose z’intambara, ni k’Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.20",
            "verseOrgIds": [
              "EZK.39.20"
            ]
          }
        },
