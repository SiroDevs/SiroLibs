            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgiza bganje nzobushira hagati mu mahanga; kand’ amahanga yose azobona iteka nashikije, n’ukuboko kwanje nabashōreyeko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.21",
            "verseOrgIds": [
              "EZK.39.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 39:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni kw ab’ inzu ya Isirayeli bazomenya yuko nd’ Uhoraho Imana yabo, uhereye uwo musi no mu bihe bizokurikiraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.39.22",
