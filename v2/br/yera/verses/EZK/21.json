            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amatongo, amatongo, nzobigira amatongo masa: kandi ni ko bizokwama, gushitsa igihe nyenevyo azozira; nanje nzobimuha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.27",
            "verseOrgIds": [
              "EZK.21.27"
            ]
          }
        }
