          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’Uhoraho ryongera kunzako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Ikindi kandi, mwana w’umuntu, toborera inzira zibiri inkota y’umwami w’i Babuloni ngw ibone kuza; zompi zizova mu gihugu kimwe: uheze ushireh’ icapa, ugishire ah’ inzira ija ku murwa ishamikiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        },
