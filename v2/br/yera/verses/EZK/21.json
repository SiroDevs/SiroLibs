                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ab’i Yerusalemu bo bazovyita nk’indagu z’ ibinyoma, kubg’ indahiro bābarahiye: arikw azokwibuka ibigabitanyo vyabo, kandi ni vyo bizotuma bafatwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
      ]
