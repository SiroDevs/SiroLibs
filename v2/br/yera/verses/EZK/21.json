              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.39.8"
              },
              "items": [
                {
                  "text": "39:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ni bakubaza, ngw Igituma uniha n’ iki? uz’ ubabgire, uti Mbitewe n’ inkuru mbi y’ibigira bize; umutima wose uzohababuka, amaboko yose adendebuke; umushaha wose uzocika ivutu, n’amavi yose aregarege acike nk’amazi: ehe biraje, bigira bishireko, ni k’ Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
