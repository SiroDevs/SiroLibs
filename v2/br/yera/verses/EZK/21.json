        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.49.10"
              },
              "items": [
                {
                  "text": "Ita 49:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
