          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobakūrakw amaso yanje ndore irya, ba bandi na bo bazohumanya ubgiherēro bganje, abambuzi bazohinjira bahahumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.22",
