                "loc": "1CO.7.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe kirashitse, umusi uri hafi: umuguzi areke kunezerwa, n’ūguzweko areke kuganya; kuk’ uburake bushitse ku masinzi yabo yose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.12",
            "verseOrgIds": [
              "EZK.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ūguzweko atazosubira ku vyo yaguze, naho boba bakiriho: kukw ivyerekanywe vyerekana ku masinzi yabo yose, kw ata wuzosubirayo; kandi nta wuzokwitungira amagara mu kugabitanya kwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.13",
            "verseOrgIds": [
              "EZK.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batabarishije inzamba, batunganije vyose, ariko nta n’umwe yagiye mu ntambara: kuk’ uburake bganje buri ku masinzi yabo yose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.14",
            "verseOrgIds": [
              "EZK.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.14.18"
