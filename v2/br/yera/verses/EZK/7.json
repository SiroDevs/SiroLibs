              "items": [
                {
                  "text": "Int 1:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma har’ inkota, imbere har’ ikīza n’inzara: ūzoba ari ku musozi azokwicishwa inkota; ūzoba ari mu gisagara inzara n’ikīza bizomuyongobeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.15",
            "verseOrgIds": [
              "EZK.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.38.14"
              },
              "items": [
                {
                  "text": "Yes 38:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abacitse bo muri bo bazocika bakire, bazoba ku misozi bameze nk’inuma zo mu myonga, bose bazoba bacura intimba, umuntu wese kubg’ ibigabitanyo vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.16",
            "verseOrgIds": [
              "EZK.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.7"
              },
              "items": [
                {
                  "text": "Ezk 21:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaboko yose azodendebuka, n’amavi yose azoregarega acike nk’ amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.17",
            "verseOrgIds": [
              "EZK.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
