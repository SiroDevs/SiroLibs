            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bazokenyera amagunira, ubgoba bubatwikire, kandi mu maso ha bose hazogira ibitētērwa, no ku mitwe ya bose hazoba inkomvorera. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.18",
            "verseOrgIds": [
              "EZK.7.18"
            ]
          }
        },
