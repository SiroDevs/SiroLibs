              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzobigabura mu maboko y’abanyamahanga ngo bibe iminyago, no ku banyakibi bo mu gihugu ngo bibe isahu, kandi bazobihumanya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.21",
            "verseOrgIds": [
              "EZK.7.21"
            ]
          }
