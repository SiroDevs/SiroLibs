              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgiza bg’ivyari bibasharije bgabateye ubgibone: babicuzemw’ ibishushanyo vy’ibizira vyabo n’ ibigirwamana vy’ubuyobe; ni co gitumye mbihindura igihumane kuri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.7.20",
            "verseOrgIds": [
              "EZK.7.20"
            ]
          }
        },
