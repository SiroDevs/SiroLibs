              "items": [
                {
                  "text": "2 Ngo 36:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "atoranya uwo mu nda y’ ingoma, ashirah’ isezerano na we, amwaka indahiro; kand’ ajana n’ abahambaye bo mu gihugu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.13",
            "verseOrgIds": [
              "EZK.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ng’ubgami bucishwe bugufi, bgoye kuja hejuru, ariko buhagarikwe no kuguma mw isezerano ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.14",
            "verseOrgIds": [
              "EZK.17.14"
            ]
          }
        },
        {
