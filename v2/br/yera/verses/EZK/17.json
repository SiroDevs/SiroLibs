                "loc": "EZK.12.9+EZK.12.10+EZK.12.11"
              },
              "items": [
                {
                  "text": "Ezk 12:9-11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rit’ Enda barira iyo nzu y’abagarariji, uti Mbega ntimuzi ingen’ ivyo bisobanurwa? Ubabgire, uti Rāba, umwami w’i Babuloni yaje i Yerusalemu, ata mu maboko umwami waho n’abaganwa biwe, abajana i we i Babuloni; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.12",
            "verseOrgIds": [
              "EZK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
