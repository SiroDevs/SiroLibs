            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ko ga! Urusha Daniyeli ubgenge, nta gihishijwe uyoberwa! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.3",
            "verseOrgIds": [
              "EZK.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubgenge bgawe no kumenya kwawe vyaguhesheje ubutunzi, vyatumye urunda izahabu n’ifeza mu bubīko bgawe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubgenge bgawe bginshi n’ubudandaza bgawe vyatumye ugwiza ubutunzi, maz’ ubgo butunzi bgawe bgateye umutima wawe kwishira hejuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
