                "loc": "2TH.2.4"
              },
              "items": [
                {
                  "text": "2 Tes 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Umwami Uhoraho agize, ati Ko wagereranije umutima wawe n’umutima w’Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.11"
              },
              "items": [
                {
                  "text": "Ezk 30:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.12"
              },
              "items": [
                {
                  "text": "31:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko nanje ngira ngutēze abantu b’akavantara b’agaterabgoba bo mu mahanga, basokore inkota zabo ngo barwanye ubgiza bg’ubgenge bgawe, bafutanye igitinyiro cawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokumanura bakurokeze muri rwa rwobo; kand’ uzopfa urupfu rw’ abaguye mw idamba mu kiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ uzosubira kuvugira imbere y’ūkwica ng’ ur’ Imana? Ushima uzoba ur’ umuntu buntu, ntuzoba ur’ Imana, ushitse mu maboko y’ ūgusogota! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.31.18"
              },
              "items": [
                {
                  "text": "Ezk 31:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzopfa urupfu rw’abatākebge wishwe n’amaboko y’abanyamahanga; kukw ari jewe mbivuze, ni k’Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
