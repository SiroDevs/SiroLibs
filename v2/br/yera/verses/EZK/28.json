                {
                  "text": "Ezk 27:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mwana w’umuntu, cura intimba uririre umwami w’i Tiro, umubgire, ut’ Uku ni k’ Umwami Uhoraho agize, ati Ni wewe war’ akaminuza ka vyose, wuzuye ubgenge, ukaba mwiza vy’agahore. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
