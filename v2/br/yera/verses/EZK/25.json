              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mwana w’umuntu, tungīra ijisho ryawe ubgoko bg’ Abamoni, ubabūrire; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.2",
            "verseOrgIds": [
              "EZK.25.2"
            ]
