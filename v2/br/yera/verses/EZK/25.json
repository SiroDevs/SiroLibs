            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ubarire ubgo bgoko bg’Abamoni, uti Ni mwumve ijambo ry’Umwami Uhoraho, ng’ Uku ni k’Umwami Uhoraho agize, ati Ko wagize ngw Awa! ukītamba hejuru y’ahēra hanje igihe hāhumanywa, ukītamba no ku gihugu c’i Bgisirayeli mu gihe cāba amatongo, no ku b’inzu ya Yuda igihe bambukanwa ar’ inyagano; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.3",
            "verseOrgIds": [
              "EZK.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
