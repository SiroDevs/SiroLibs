                "loc": "EZK.21.32"
              },
              "items": [
                {
                  "text": "Ezk 21:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngicire ab’i burasirazuba, ngo babone ingene batera Abamoni, kandi nzobatanga ngo babegukire, kugira ng’ ubgoko bg’ Abamoni bgoye kwongera kwibukwa mu mahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.10",
            "verseOrgIds": [
              "EZK.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzoshitsa iteka nciriye kuri Mowabu, maze bazomenya yuko jewe nd’ Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.11",
            "verseOrgIds": [
              "EZK.25.11"
            ]
          }
        }
