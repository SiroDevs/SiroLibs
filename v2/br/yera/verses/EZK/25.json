        {
          "text": "Uku ni k’Umwami Uhoraho agize, at’ Abanyedomu ko bagiriye inzu ya Yuda nabi babīhōra, bagacumura cane, mbere bakabīhōra; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.12",
            "verseOrgIds": [
              "EZK.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero, uku ni k’ Umwami Uhoraho agize, ati Nzobangurira ukuboko kwanje ku Banyedomu, mbaranduremw’ abantu n’ibitungano; kandi nzohahindura amatongo uhereye i Temani, baririkwe n’inkota gushitsa n’i Dedani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.13",
            "verseOrgIds": [
              "EZK.25.13"
            ]
          }
        },
        {
