              },
              "items": [
                {
                  "text": "Ezk 36:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari k’Umwami Uhoraho agize, ati Ko wakomye amashi, ukavuza imihamirizo, ukītamba hejuru y’igihugu c’i Bgisirayeli n’ akagaye kose ko mu mutima wawe; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.6",
            "verseOrgIds": [
              "EZK.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero, nkubānguriyek’ ukuboko kwanje, ngira nkugabure ng’ ube inyagano y’abanyamahanga; nzokurandura ngukūre mu mahanga, nguherengeteze mu bihugu, nkugeseze; maz’ uzomenya yuko jewe nd’ Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.7",
            "verseOrgIds": [
              "EZK.25.7"
            ]
          }
        }
