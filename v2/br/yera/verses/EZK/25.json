                "loc": "JDG.6.3"
              },
              "items": [
                {
                  "text": "Abac 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero ngira nkugabure mu baba i burasirazuba, bakwegukire; bazogusagazamwo, bīshikire buzu; bazokurīra imirima, bakunywere n’ amata. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.4",
            "verseOrgIds": [
              "EZK.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.15"
              },
              "items": [
                {
                  "text": "Zef 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ahitwa i Raba nzohahindura ibirāro vy’ingamiya, n’igihugu c’Abamoni kibe ubugaramango bg’imikuku: nuko muzomenya yuko jewe nd’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.25.5",
            "verseOrgIds": [
              "EZK.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
