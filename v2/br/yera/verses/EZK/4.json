                "loc": "EZK.3.25"
              },
              "items": [
                {
                  "text": "Ezk 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi rāba, ngushize mu ngoyi, nta ho uzohindukirira urundi rubavu, gushitsa ah’ imisi yo kuhaziguza kwawe izoba irangiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.8",
            "verseOrgIds": [
              "EZK.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi wironderere ingano na sayiri n’ibiharage n’inkōre n’amasaka n’uburo, maz’ ubishire mu nkono imwe, ubicemw’ uturobe tw’udutsima; nk’ukw igitigiri c’imisi kiri uzoryamira urubavu, ukw ar’ amajana atatu na mirongwicenda, ivyo ni vyo bizogutunga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.9",
            "verseOrgIds": [
              "EZK.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ivyo kurya vyawe uze wame ubirya ku rugero, ari rwo shekeli mirongwibiri mu musi mu musi: uzokwama urya rimwe ku musi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.10",
            "verseOrgIds": [
              "EZK.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’ amazi uzokwama uyanywa ku rugero, ari rwo gihimba ca gatandatu c’ingero yitwa hini: na yo uzokwama uyanywa rimwe ku musi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.11",
            "verseOrgIds": [
              "EZK.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzokwama ubirya nk’ udutsima twa sayiri, kand’ uzokwama uducaniriza amavyi y’ abantu imbere yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.12",
            "verseOrgIds": [
              "EZK.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.8"
              },
              "items": [
