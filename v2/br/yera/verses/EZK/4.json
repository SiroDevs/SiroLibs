                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Uhoraho aravuga, at’ Uko ni kw Abisirayeli bazorīra ivyo kurya vyabo vyandavuye mu mahanga nzobashwiragirizamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
            "verseOrgIds": [
              "EZK.4.13"
            ]
          }
        },
