                {
                  "text": "Ezk 21:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ ukiziguze, wubake ibihome vyo kuhatera, ukirundire ibigunguzi vyo kwūririrako, ugisagazeko n’ insago, ugikikizeko hirya no hino ibiti vy’imigogo vyo kugihomvora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.2",
            "verseOrgIds": [
              "EZK.4.2"
            ]
          }
        },
        {
