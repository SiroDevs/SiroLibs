                {
                  "text": "21:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi wiyabīrire umubehe w’ icuma, uwukike ng’ukubere uruzitiro rw’icuma hagati yawe n’ igisagara: ugishinge ijisho ngo kiziguzwe, wewe ubgawe ukiziguze. Ivyo bizoba ikimenyamenya c’inzu ya Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.3",
            "verseOrgIds": [
              "EZK.4.3"
            ]
          }
        }
