                  "text": "Ivyak 10:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndavuga, nti Yo! Ewe Mwami Uhoraho! Erega kuva aho nakabereye nta ho nigeze mpumana: kuk’ uhereye mu buto bganje ugashitsa n’ubu ata ho nigeze kurya icipfiriye, cank’ icātabaguwe n’ igikōko; kandi nta ho inyama zihumanye zigeze kuja mu kanwa kanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambarira, ati Rāba, nguhaye ibisheshe vy’amase y’inka mu gishingo c’amavyi y’ abantu: ivyo ni vyo uzocaniriza ukora utwo dutsima twawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        },
        {
