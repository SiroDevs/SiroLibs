            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None vuga, ubabarire, ut’ Uku ni k’ Umwami Uhoraho agize, at’ Ehe, nzorangaza imva zanyu, mbadūze muve mu mva zanyu, mwa bantu banje; kandi nzobashikana mu gihugu c’i Bgisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.12",
            "verseOrgIds": [
              "EZK.37.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko muzomenya yuko jewe nd’ Uhoraho, igihe nzoba ndangaje imva zanyu, nkabadūza mukava muri zo, mwa bantu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.13",
            "verseOrgIds": [
              "EZK.37.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
