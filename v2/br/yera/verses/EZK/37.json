              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ubabgire, ut’ Uku ni k’Umwami Uhoraho agize, ati Rāba ngira nkūre Abisirayeli mu mahanga bāgiyemwo, mbakoranirize hamwe mbakūye mu mpande zose, mbashikane mu gihugu cabo bgite; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.21",
            "verseOrgIds": [
              "EZK.37.21"
            ]
