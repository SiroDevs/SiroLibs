            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzobashiramwo Mpwemu wanje, mube bazima, mbashire mu gihugu canyu bgite, maze muzomenya kw ari jewe Uhoraho nabivuze kandi ndabishikije, ni k’Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.14",
            "verseOrgIds": [
