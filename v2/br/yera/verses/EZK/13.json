              "EZK.13.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.13.2"
              },
              "items": [
                {
                  "text": "Ezk 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nawe, mwana w’umuntu, tungīra ijisho abakobga b’ ubgoko bganyu, bavuga ibiva mu mitima yabo ubgabo; ubabūrire, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.17",
            "verseOrgIds": [
              "EZK.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ut’ Uku ni k’Umwami Uhoraho agize, ngo Bazobona ibara, abagore bapfundika ibiheko mu ngingo z’amaboko yose, bakabarīra imyitwikiro yo ku mitwe y’abantu, ukw ikirēho c’umuntu wese kiri, uti Kugira ngo babone ingene bafata abantu! Uti Mbega mwofata abantu biwe, namwe mukīkiza? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.18",
            "verseOrgIds": [
              "EZK.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.28.21"
              },
              "items": [
                {
                  "text": "Imig 28:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.5"
              },
              "items": [
                {
                  "text": "Mik 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Mwamutītūje mu bantu biwe ngo mwironkere ingemu z’ amashi ya sayiri n’ubumanyagu bg’imitsima, uti Kugira ngo mwice abantu batāri bakwiye gupfa, mukize abatāri bakwiye kubaho, uti Mu buryo mubesha abantu biwe bakunda kwumviriza ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.19",
            "verseOrgIds": [
              "EZK.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Nuko rero, uku ni k’Umwami Uhoraho agize, ngw Ehe azohigūra n’ivyo biheko vyanyu, ivyo mutegesha abantu nk’ abatega inyoni; ut’ Azobibashikura ku maboko; uti Maz’ agobōtore abo bantu mwateze ngo bīgīre, nk’ūgobotora inyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.20",
            "verseOrgIds": [
              "EZK.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo N’iyo myitwikiro yanyu azoyitabagura, uti Maze ngw akize abantu biwe, abakūre mu maboko yanyu, ngo Kandi nta ho bazokwongera kuba mu maboko yanyu nk’abāfashwe; uti Nuko muzomenya yukw ari we Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.13.21",
            "verseOrgIds": [
