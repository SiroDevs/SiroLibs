                {
                  "text": "Ezk 36:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mwana w’umuntu, tungīra ijisho ryawe imisozi y’i Bgisirayeli, uyibūrire, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.2",
            "verseOrgIds": [
              "EZK.6.2"
            ]
          }
        },
        {
