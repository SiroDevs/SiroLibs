                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.21.14"
              },
              "items": [
                {
                  "text": "21:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Umwami Uhoraho agize, ati Kubita amashi ku yandi, dida ikirenge hasi, uvuge uti Yō! Ewe bizira bibi vyose inzu ya Isirayeli yakoze! Kuko bazoririkwa n’inkota n’inzara n’ikīza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.11",
            "verseOrgIds": [
              "EZK.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.5.13"
              },
              "items": [
                {
                  "text": "Ezk 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūri kure azokwicwa n’ikīza, ūri hafi azokwicwa n’inkota; kandi n’ ūsigaye asāgirijwe azokwicwa n’ inzara: uko ni ko nzokwimara uburake mbafitiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.12",
            "verseOrgIds": [
              "EZK.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.20"
              },
              "items": [
                {
                  "text": "Yer 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.28"
              },
              "items": [
                {
                  "text": "Ezk 20:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.13"
              },
              "items": [
                {
                  "text": "Hos 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bazomenya yuko jewe nd’ Uhoraho, igihe imihindigiti yabo izoba irambaraye hagati y’ibigirwamana vyabo impande zose z’ibicaniro vyabo, ku gasozi kose gahagaze, no ku dutwe twose tw’imisozi miremire, no musi y’igiti cose gitotahaye, no musi y’igiti cose c’umweloni gihūritse, aho bāshikanirira ibigirwamana vyabo vyose ibizana imibabge imota neza. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.13",
            "verseOrgIds": [
              "EZK.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.25.13"
              },
              "items": [
                {
                  "text": "Ezk 25:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzobabangurirak’ ukuboko kwanje, mpindure igihugu imisaka n’amatongo, uhereye mu bugaragwa burābana n’i Dibula, n’aho baba hose iyo hava hakagera: na bo bazomenya yuko jewe nd’ Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.6.14",
            "verseOrgIds": [
              "EZK.6.14"
            ]
          }
        }
