              "items": [
                {
                  "text": "Ivyah 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzozibiza ijwi ry’indirimbo zawe, kand’ ukuvuga kw’inanga zawe ntikuzosubira kwumvikana ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.13",
            "verseOrgIds": [
              "EZK.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzoguhindura urutare rugaragara: uzosigara ur’ aho kwanikira insenga; ntuzosubira kwubakwa ukundi: kuko jewe Uhoraho mbivuze, ni k’Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.14",
            "verseOrgIds": [
              "EZK.26.14"
            ]
          }
        }
