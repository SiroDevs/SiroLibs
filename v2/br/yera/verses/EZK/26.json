                  "text": "Ezk 27:12-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubutunzi bgawe bazobugira inyagano, basahure n’ibidandazwa vyawe; kandi bazosangangura inzitiro zawe z’ amabuye, bahomvagure n’amazu yawe ahimbaye; maz’ amabuye n’ibiti n’umukungugu vy’amasakamburira yawe bazobishiburira mu kiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.26.12",
            "verseOrgIds": [
              "EZK.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 26:13"
          },
          "items": [
