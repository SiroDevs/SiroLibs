                "loc": "EZK.1.3"
              },
              "items": [
                {
                  "text": "Ezk 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mpwemu aranterura, aranjana; ngenda nshavuye, nitonganya; arik’ ukuboko kw’Uhoraho kwari kunshikamiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.14",
            "verseOrgIds": [
              "EZK.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
