                {
                  "text": "Yer 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.10.9"
              },
              "items": [
                {
                  "text": "Ivyah 10:9",
