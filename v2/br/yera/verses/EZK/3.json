            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mpwemu aranterura, numva inyuma yanje ijwi rihinda cane, rivuga, ng’ Ubgiza bg’ Uhoraho bushemagirizwe ahantu hiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.12",
            "verseOrgIds": [
              "EZK.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 3:13"
          },
          "items": [
            {
              "text": "13",
