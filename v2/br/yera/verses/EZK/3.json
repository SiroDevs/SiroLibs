            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw iyo misi ndwi ishize, ijambo ry’Uhoraho rinzako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.16",
            "verseOrgIds": [
              "EZK.3.16"
