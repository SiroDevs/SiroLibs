            "sid": "EZK 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni wabūrira umunyakibi, ntahindukire ngw areke ibibi vyiwe, canke ngw ave mu nzira yiwe mbi, azopfira mu bigabitanyo vyiwe; ariko weho uzoba urokoye ubugingo bgawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.19",
            "verseOrgIds": [
              "EZK.3.19"
            ]
