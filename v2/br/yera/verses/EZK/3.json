              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw arambarira, ati Mwana w’umuntu, ico ubonye ukirye; urye uwo muzingo, uheze ugende, ubarire inzu ya Isirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.1",
            "verseOrgIds": [
              "EZK.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nasamika akanwa, angaburira uwo muzingo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.2",
            "verseOrgIds": [
              "EZK.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
