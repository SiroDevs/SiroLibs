                "loc": "REV.10.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambarira, ati Mwana w’umuntu, hāza inda yawe, n’amara yawe uyuzuze uyu muzingo nguhaye. Nuko ndawurya; mu kanwa unsosera nk’ubūki.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.3",
            "verseOrgIds": [
              "EZK.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambgira, ati Genda, ushikīre ab’ inzu ya Isirayeli, ubabarire amajambo yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.4",
            "verseOrgIds": [
              "EZK.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ntagutumye kw ihanga ry’abavuga imvugo itumvikana n’ururimi rugoye, ariko ni ku b’inzu ya Isirayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.5",
            "verseOrgIds": [
              "EZK.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "si ku mahanga menshi avuga imvugo zitumvikana n’indimi zigoye, abo mudashobora kwumvikana mu majambo. N’ukuri, iyaba ari bo ngutumyeko, bo bokwumviye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.6",
            "verseOrgIds": [
              "EZK.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.4"
              },
              "items": [
                {
                  "text": "Ezk 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.20"
              },
              "items": [
                {
                  "text": "Yoh 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw inzu ya Isirayeli ntizokwumvira, kuko nanje banse kunyumvira: kukw ab’ inzu ya Isirayeli bose mu ruhanga rwabo ar’abanyakadāda, bikomantaje imitima. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.7",
            "verseOrgIds": [
              "EZK.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe mpinduye mu maso hawe ngo hakomere hahangare mu maso habo, n’uruhanga rwawe ngo rukomere ruhangare impanga zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.8",
            "verseOrgIds": [
              "EZK.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.50.7"
              },
              "items": [
                {
                  "text": "Yes 50:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.6"
              },
              "items": [
                {
                  "text": "Ezk 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruhanga rwawe ndaruhaye gukomera nk’intosho rurushe isare: ntuz’ ubatinye canke ng’ urandurwe umutima n’igitsure cabo, nah’ ar’ inzu y’abagarariji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.9",
            "verseOrgIds": [
              "EZK.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arongera arambarira, ati Mwana w’umuntu, amajambo yanje yose nzogenda nkubarira uz’ uyākīre mu mutima wawe, uyumvishe n’amatwi yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.10",
            "verseOrgIds": [
              "EZK.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.4"
              },
              "items": [
                {
                  "text": "Ezk 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uheze ugende, ushikīre abo mu bgoko bganyu b’abanyagano, uvugane na bo ubabgire, bovyumva, batovyumva, ut’ Uku ni k’Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.11",
            "verseOrgIds": [
              "EZK.3.11"
            ]
          }
        }
      ]
