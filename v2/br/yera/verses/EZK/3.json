          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.2.13"
              },
              "items": [
                {
                  "text": "Yob 2:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.1"
              },
              "items": [
                {
                  "text": "Zab 137:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nshikīra ba banyagano i Telabibu, bāba ku ruzi Kebari, nshika aho hantu bāba; mpamara imisi ndwi numiwe nicaye hagati yabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.3.15",
            "verseOrgIds": [
              "EZK.3.15"
            ]
          }
        }
