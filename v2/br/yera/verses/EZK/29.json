            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka w’icumi, mu kwezi kw’icumi, ku musi ugira icumi na kabiri w’ukwo kwezi, ijambo ry’Uhoraho ryanjeko, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
