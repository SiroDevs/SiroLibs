                  "text": "Yer 25:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndamuhaye igihugu ca Egiputa kw ingororano c’ivyo yankoreye, kukw ari jewe bākoreye, ni k’Umwami Uhoraho agize.",
          "type": "text",
          "attrs": {
