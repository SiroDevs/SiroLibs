              },
              "items": [
                {
                  "text": "Int 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntibazokwongera kubera ab’ inzu ya Isirayeli ivyizigiro, ngo batume ibigabitanyo vyibukwa vy’igihe bābīsunga: maze bazomenya yuko nd’ Umwami Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.16",
            "verseOrgIds": [
              "EZK.29.16"
            ]
          }
        }
