              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.6"
              },
              "items": [
                {
                  "text": "Yer 39:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.7"
              },
              "items": [
                {
                  "text": "Ezk 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzoririkwa n’inkota; nzobacira urubanza ndi mu rugabano rw’i Bgisirayeli: namwe muzomenya yuko jewe nd’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.10",
            "verseOrgIds": [
              "EZK.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki gisagara ntikizobabera inkono, kandi namwe ntimuzoba inyama ziri muri yo; nzobacira urubanza ndi mu rugabano rw’i Bgisirayeli; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.11",
            "verseOrgIds": [
              "EZK.11.11"
            ]
          }
        },
        {
