            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakavuga, bat’ Ereg’ igihe ntikiragera: enda ni twiyubakire amazu; bat’ Iki gisagara n’inkono, natwe tur’ inyama ziri muri yo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.3",
            "verseOrgIds": [
              "EZK.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rer’ ubabūrire, mwana w’umuntu, ubabūrire.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.4",
            "verseOrgIds": [
              "EZK.11.4"
            ]
          }
        }
