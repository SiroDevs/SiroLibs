              "items": [
                {
                  "text": "7:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokibakūramwo, mbagabure mu maboko y’abanyamahanga, mbacirekw iteka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.9",
            "verseOrgIds": [
              "EZK.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 11:10"
          },
          "items": [
            {
