        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.19"
              },
              "items": [
                {
                  "text": "Ezk 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.16"
              },
              "items": [
                {
                  "text": "1 Tim 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara ni wabūrira umunyavyaha ivy’ ingeso ziwe, ngw ahindukire azivemwo, na we ntāhindukire ngw azivemwo; azopfira mu bigabitanyo vyiwe, ariko weho uzoba ukijije ubugingo bgawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.9",
            "verseOrgIds": [
              "EZK.33.9"
            ]
          }
        }
