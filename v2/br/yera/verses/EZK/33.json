              },
              "items": [
                {
                  "text": "Ezk 18:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikindi kandi, ni nabgira umunyavyaha, nti Ntuzobura gupfa, arikw agahindukira akava mu vyaha vyiwe, agakora ibitunganye n’ibikwiye, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.14",
            "verseOrgIds": [
              "EZK.33.14"
            ]
          }
        },
