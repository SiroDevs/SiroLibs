                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo munyavyaha agasubiza ingwati nyeneyo, akagarukana ivyo yambuye, akagendera mu vyagezwe bihesha ubugingo, ntagire ivy’ ukugabitanya akora, n’ukuri azobaho, ntazopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.15",
            "verseOrgIds": [
              "EZK.33.15"
            ]
          }
        },
