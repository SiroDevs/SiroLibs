            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, mwana w’umuntu, ubarire ab’ inzu ya Isirayeli, uti Musigaye muvuga, mut’ Ibicumuro vyacu n’ivyaha vyacu biri ku mitwe yacu, kandi duhondobereye muri vyo: none twoshobora dute kubaho? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.10",
            "verseOrgIds": [
              "EZK.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
