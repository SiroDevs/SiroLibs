                "loc": "AMO.3.6"
              },
              "items": [
                {
                  "text": "Am 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uyo yobona inkota ije iteye igihugu, akavuza inzamba ngw abūrire abantu; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.3",
            "verseOrgIds": [
              "EZK.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.13"
              },
              "items": [
                {
                  "text": "Ezk 18:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.6"
              },
              "items": [
                {
                  "text": "Ivyak 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuk’ uwokwumva ijwi ry’inzamba wese, agakina ku mbūri, inkota ikaza, ikamugahura, amaraso yiwe azoba ku mutwe wiwe ubgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.4",
            "verseOrgIds": [
              "EZK.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yumvise ijwi ry’inzamba, ariko yakinnye ku mbūri; amaraso yiwe azoba kuri we; arikw iyaba yarumviye imbūri yokijije amagara yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.5",
            "verseOrgIds": [
              "EZK.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.3.18"
              },
              "items": [
                {
                  "text": "Ezk 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw iyo nderetsi ni yabona inkota ije, ntivuze inzamba, abantu ngo babūrirwe, inkota ikaza ikagira uwo igahura muri bo; uwo azoba agahuriwe mu bigabitanyo vyiwe, arikw amaraso yiwe nzoyarondera kur’ iyo nderetsi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.6",
            "verseOrgIds": [
              "EZK.33.6"
            ]
          }
        }
      ]
    },
