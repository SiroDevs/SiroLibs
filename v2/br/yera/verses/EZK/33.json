                  "text": "Ezk 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu vyaha vyiwe vyose yakoze, nta na kimwe kizokwibukwa kuri we: kukw asigaye akora ibitunganye n’ibikwiye; ntazobura kubaho. ",
          "type": "text",
