            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamar’ ab’ ubgoko bganyu baravuga, ngw Inzira y’ Umwami Imana ntiroranye: erega bo ni bo inzira zabo zitaroranye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.17",
            "verseOrgIds": [
              "EZK.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugororotsi ni yahindukira akava mu bugororotsi bgiwe, agakora ivy’ ukugabitanya, azopfa ari vyo azize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.18",
            "verseOrgIds": [
              "EZK.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umunyavyaha ni yahindukira akava mu vyaha vyiwe, agakora ibitunganye n’ ibikwiye, azobeshwaho na vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.19",
            "verseOrgIds": [
              "EZK.33.19"
            ]
          }
        },
        {
