          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko mwishimiye inkota zanyu, mugakora ibizira, umuntu wese akonona muka mugenzi we: none mugira ngo mwohabga igihugu kw ishamvu? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.26",
            "verseOrgIds": [
              "EZK.33.26"
            ]
          }
        },
