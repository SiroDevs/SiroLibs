            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igihugu nzogihindura imisaka n’akajoreza, ubgibone buterwa n’ububasha bgaho buzoherengetera; kand’ imisozi y’i Bgisirayeli izosigara ar’ imisaka, bitume ata wuzoba akihaca. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.28",
            "verseOrgIds": [
              "EZK.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
