        },
        {
          "text": "Ukuboko kw’Uhoraho kwari kwarāye kunjeko ku mugoroba, iyo mpunzi itaraza; kandi yar’ agobotoye akanwa kanje uyo atarashika aho ndi bukeye mu gitondo; nukw akanwa kanje karagobodoka, ururimi ntirwari rukigobge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        },
