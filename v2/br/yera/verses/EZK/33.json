              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubabgire, uti Ndahiye ukubaho kwanje, ni k’Umwami Uhoraho agize, simpimbarwa n’uk’ umunyavyaha apfa, atar’ uko yohindukira, akava mu ngeso ziwe, akabaho: enda ni muhindukire, mugaruke muve mu ngeso zanyu mbi; n’iki gituma mugomba gupfa, yemwe ab’ inzu ya Isirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.11",
            "verseOrgIds": [
              "EZK.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
