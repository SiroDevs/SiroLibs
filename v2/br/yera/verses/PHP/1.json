          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ko nizigiye ivyo, ndazi neza yuko nzogumaho, nkabana namwe mwese, kugira ngo muje imbere, munezererwe ukwizera; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
