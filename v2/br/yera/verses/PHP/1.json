              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, ndagomba ko mumenya yukw ivyambāyeko cane‐cane vyashize imbere ubutumwa bgiza: ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.22"
              },
              "items": [
                {
                  "text": "Flp 4:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.1"
              },
              "items": [
                {
                  "text": "Ef 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bituma ingoyi zanje zo kubga Kristo zimenyekana mu basoda bahora bashibama kwa Kayisari bose, no mu bandi bose. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abenshi bo muri bene Data bari mu Mwami wacu, bāremeshejwe n’ingoyi zanje, barushiriza gutinyuka kuvuga ijambo ry’Imana bashize amanga.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        }
