              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo na Timoteyo, abagurano ba Kristo Yesu, turabandikiye abera bose bo muri Kristo Yesu b’i Filipi, hamwe n’abazezwashengero n’abakozi baryo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
