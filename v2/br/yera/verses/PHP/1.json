                {
                  "text": "1 Tes 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ni yo ntanzekw icabona c’ingene mbagirira igishika mwese, mfise imbabazi za Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        }
