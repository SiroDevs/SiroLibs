              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "yamara kuguma mu mubiri ni co corushiriza kubagirira ikimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
