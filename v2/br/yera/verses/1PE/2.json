                  "text": "Rom 12:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwubakwe nk’amabuye afise ubugingo, kugira ngo mube inzu yo mu buryo bg’impwemu, mugire ibango ry’ubuherezi ryera, ngo mutange ibimazi mu buryo bg’impwemu, bishimwa n’Imana kubga Yesu Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.2.5",
            "verseOrgIds": [
              "1PE.2.5"
            ]
          }
        },
