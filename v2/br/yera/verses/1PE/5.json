              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwicishe bugufi muri musi y’ukuboko kw’Imana kw’ubushobozi, kugira ngw iz’ ibashire hejuru mu gihe gikwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.6",
            "verseOrgIds": [
              "1PE.5.6"
            ]
          }
