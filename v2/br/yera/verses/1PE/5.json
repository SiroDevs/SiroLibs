            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muragire ubusho bg’Imana bgo muri mwebge, mutaburagira nk’abagōberewe, ariko mubikunze, nk’ukw Imana igomba: ntimuburagirishwe no kurondera inyungu mbi, ariko muburagire mushize igikonyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.2",
            "verseOrgIds": [
              "1PE.5.2"
            ]
          }
        },
        {
