        {
          "text": "Kandi ntimuragire nk’abatwaza amanyama amasho mwagabanganirijwe, ariko mube ivyitegererezo vy’ubusho. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.3",
