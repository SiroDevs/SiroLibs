                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbandikiye icete c’amajambo make, canditswe na Siluwano, mwene Data w’umwizigirwa uko niyumvira; mbahanūra nshinga intahe yuk’ ubgo ari bgo buntu bg’Imana bg’ukuri: mubuhagararemwo mushikamye. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
