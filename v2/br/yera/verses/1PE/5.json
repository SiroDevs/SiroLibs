            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Umwungere mukuru ni yerekanwa, muzokwambikwa mu mitwe igitsibo c’ubgiza kitazoshira. ",
          "type": "text",
          "attrs": {
