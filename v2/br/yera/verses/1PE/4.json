              "items": [
                {
                  "text": "1 Pet 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.10"
              },
              "items": [
                {
                  "text": "Rom 8:10",
