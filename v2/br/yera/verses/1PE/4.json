            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.3.3"
              },
              "items": [
                {
                  "text": "Tit 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw igihe cashize gihāgije gukora ivy’ abanyamahanga bakunda gukora, no kugendera mu ngeso z’isoni nke, n’izo kwifuza, no kunohorwa na vino, no kudandahirwa, no kurundāna aho bateretse, n’ibizira vyo gusenga ibigirwamana. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.3",
            "verseOrgIds": [
              "1PE.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Birabatangaza yuko mudafatanya na bo kwirukira mu birenze urugero vy’ubuhumbu, bakabarementaniriza; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.4",
            "verseOrgIds": [
              "1PE.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
