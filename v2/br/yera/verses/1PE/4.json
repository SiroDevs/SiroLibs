                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.5.5"
              },
              "items": [
                {
                  "text": "1 Kor 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw icatumye abapfuye na bo bābariwe ubutumwa bgiza kwar’ ukugira ngo bacirirwe imanza mu mubiri mu buryo bg’abantu, ariko babeho mu mpwemu mu buryo bg’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.6",
            "verseOrgIds": [
              "1PE.4.6"
            ]
          }
        }
