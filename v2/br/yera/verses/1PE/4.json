                {
                  "text": "Luk 12:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uk’ umuntu wese yagabiwe ingabire muzigaburirane, nk’uko bibereye ababgiriza beza b’ubuntu bg’Imana bg’uburyo bginshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.10",
            "verseOrgIds": [
              "1PE.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1PE 4:11"
          },
          "items": [
