                  "text": "Heb 13:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhāne indāro mutidodomba. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.9",
            "verseOrgIds": [
              "1PE.4.9"
            ]
