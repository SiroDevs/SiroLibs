        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.16"
              },
              "items": [
                {
                  "text": "1 Yoh 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngw amare imisi isigaye akiri mu mubiri atagikorera ivyifuzo vy’abantu, arikw akora ivy’ Imana igomba. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.2",
            "verseOrgIds": [
              "1PE.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1PE 4:3"
          },
          "items": [
