            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mugabo ni bo bazobazwa ivyo n’uwiteguye kuzoca imanza z’abakiriho n’abapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.5",
            "verseOrgIds": [
              "1PE.4.5"
            ]
          }
        },
