            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umuhero wa vyose uri hafi: nuko ntimuhugumbe, mwirinde, kugira ngo mubone uko mushishikara gusenga. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.7",
            "verseOrgIds": [
              "1PE.4.7"
            ]
          }
        },
        {
