                "loc": "1CO.13.7"
              },
              "items": [
                {
                  "text": "1 Kor 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikiruta vyose, mukovye mu gukundana, kuk’ urukundo rupfuka ivyaha vyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.4.8",
            "verseOrgIds": [
              "1PE.4.8"
            ]
          }
        },
