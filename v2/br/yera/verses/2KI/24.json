                "loc": "JER.46.26"
              },
              "items": [
                {
                  "text": "26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umwami wa Egiputa ntiyongeye kuva mu gihugu ciwe, kuk’ umwami w’i Babuloni yari yāmunyujije ivyar’ ivyiwe vyose, uhereye ku mugezi wa Egiputa ugashitsa ku ruzi Efurate.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.7",
            "verseOrgIds": [
              "2KI.24.7"
            ]
          }
        }
