        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Yehoyakimu, n’ivyo yakoze vyose, mbega ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’i Buyuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.5",
            "verseOrgIds": [
              "2KI.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 24:6"
