        },
        {
          "text": "Ku ngoma ya Yehoyakimu, Nebukadineza umwami w’i Babuloni arabatera; Yehoyakimu aramwisaba, amara imyaka itatu aganzwa na we; araheza aramuhinduka, aramugarariza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.24.1",
            "verseOrgIds": [
              "2KI.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 24:2"
          },
          "items": [
