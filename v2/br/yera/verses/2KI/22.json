            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya yagiye ku ngoma amaze imyaka munani; ayimarakw imyaka mirongwitatu n’ umwe ar’ i Yerusalemu; nyina yitwa Yedida, umukobga wa Adaya w’i Bosikati. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.1",
            "verseOrgIds": [
              "2KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo Uhoraho abona kw ari vyiza, agendera mu ngeso nziza zose za sekuruza Dawidi, ntiyatambamira i buryo cank’ i bumoso.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        }
      ]
    },
    {
