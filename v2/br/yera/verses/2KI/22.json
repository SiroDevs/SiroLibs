              "attrs": {
                "loc": "2CH.34.8+2CH.34.9+2CH.34.10+2CH.34.11+2CH.34.12+2CH.34.13+2CH.34.14+2CH.34.15+2CH.34.16+2CH.34.17+2CH.34.18+2CH.34.19+2CH.34.20+2CH.34.21+2CH.34.22+2CH.34.23+2CH.34.24+2CH.34.25+2CH.34.26+2CH.34.27+2CH.34.28"
              },
              "items": [
                {
                  "text": "2 Ngo 34:8-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira icumi n’ umunani umwami Yosiya ari ku ngoma, atuma umukarani Shafani mwene Asaliya, Asaliya wa Meshulamu, ngw aje mu ngoro y’Uhoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.3",
            "verseOrgIds": [
              "2KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
