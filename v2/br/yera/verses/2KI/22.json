            "number": "4",
            "style": "v",
            "sid": "2KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.4"
              },
              "items": [
                {
                  "text": "2 Abam 12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Dūga uje iyo Hilukiya ari, umuherezi mukuru, umubgire aharūre amahera azanwa mu ngoro y’Uhoraho, ayo abarinzi b’umuryango bamaze kwākīra mu bantu; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.11"
              },
              "items": [
                {
                  "text": "2 Abam 12:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayahe abashinzwe gukoresha ibikorwa vyo ku ngoro y’Uhoraho, na bo bayahembe abakozi bakora iyo ngoro, kugira ngo basanure aho yahubaguritse, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayahe ababāji n’ abubatsi n’abubakisha amabuye; ayandi bayagure imbaho n’amabuye abāje vyo gusanura iyo ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
            "verseOrgIds": [
              "2KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.15"
              },
              "items": [
                {
                  "text": "2 Abam 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo, ayo mahera bahawe, ntimuzorinda kuyabasuzumira, kukw ar’ abizigirwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Hilukiya umuherezi mukuru abarira Shafani umukarani, ati Ntoye igitabo c’ivyagezwe mu ngoro y’Uhoraho. Hilukiya araheza agiha Shafani, aragisoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo mukarani Shafani asubira ku mwami, amudondera uko vyagenze, at’ Abasavyi bawe bābiriye amahera yari mu ngoro y’Uhoraho, bayashikirije abakoresha ibikorwa vyo kur’ iyo ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mukarani Shafani yongera kubarira umwami, ati Kand’ umuherezi Hilukiya andungikanye igitabo. Nuko Shafani agisomera umwami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami yumvise amajambo yo mur’ ico gitabo c’ivyagezwe, yitantamurirakw impuzu ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.25.22"
              },
              "items": [
                {
                  "text": "2 Abam 25:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.24"
              },
              "items": [
                {
                  "text": "Yer 26:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami atuma Hilukiya umuherezi na Ahikamu mwene Shafani na Akibori mwene Mikaya n’uwo mukarani Shafani nyene na Asaya umumenyekana wiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.27"
              },
              "items": [
                {
                  "text": "Gus 29:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Ni mugende munsigurize Uhoraho, twe n’aba bantu n’abandi Bayuda bose, ivy’ amajambo yo mur’ iki gitabo batoye; kuk’ uburake bg’Uhoraho butuziriringiye ari bginshi, kubga ba sogokuruza batumviye amajambo yo mur’ iki gitabo, ngo bakore ivyanditswe muri co vyose twabariwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        }
      ]
    },
