                "loc": "LUK.2.36"
              },
              "items": [
                {
                  "text": "Luk 2:36",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hilukiya umuherezi na Ahikamu na Akibori na Shafani na Asaya baragenda, baja k’ūvugishwa n’Imana Hulida muka Shalumu, Shalumu mwene Tikuva umwuzukuru wa Haluhasi, yajejwe ububīko bg’imyambaro, baramusiguza. Kand’ uwo mugore yaba i Yerusalemu mu gice caho ca kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.14",
            "verseOrgIds": [
              "2KI.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, at’ Uku ni k’Uhoraho Imana y’Abisirayeli agize, ngo Murabarira uwo muntu yamubatumyeko, ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.15",
            "verseOrgIds": [
              "2KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "mut’ Uhoraho agize ngw Azotēza ivyago aha hantu, bo n’abahaba, ngo Nk’uko vyanditswe mu majambo yose yo mur’ ico gitabo wasomye, wewe nyene umwami w’i Buyuda; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.16",
            "verseOrgIds": [
              "2KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.29.25+DEU.29.26+DEU.29.27"
              },
