                "loc": "NUM.32.23"
              },
              "items": [
                {
                  "text": "Guh 32:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma baravugana, bat’ Ivyo tugize si vyo, kuk’ uyu musi ar’ umusi wo kuvuga inkuru nziza, natwe takaba dupfuye kwihorera; ni twarorēra ko buca, bizodusubirako. Ni muze tugende tubibarire ab’i bgami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.9",
            "verseOrgIds": [
              "2KI.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baragenda bahamagara abashibamyi b’irembo ry’igisagara, barababarira, bati Twagiye mu nsago z’ Abasiriya, dusanga hatarangwa umuntu n’umwe, ata n’agakakaza, atar’ amafarasi n’indogoba biziritse, kand’ amahema ar’ uko yakabaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.10",
            "verseOrgIds": [
              "2KI.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abo bashibamyi bahamagara abo mu rugo i bgami, barabibamenyesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.11",
            "verseOrgIds": [
              "2KI.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.17"
              },
              "items": [
                {
                  "text": "Yos 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami avyukuruka mur’ iryo joro, abarira abantu biwe, ati Reka mbabarire inama Abasiriya batugīriye: bamenye kw inzara irikw iratwica; ni co gitumye bava aho bashagaje bakaja kunyegagira mw ishamba, ngo ni twasokoroka mu gisagara baducakire, babone ingene bashika imbere mu gisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.12",
            "verseOrgIds": [
              "2KI.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe mu bantu biwe aramubarira, at’ Enda rungika abajana amafarasi atanu mu yasigaye; ni bakira, bazoba bameze nk’ Abisirayeli bose basigaye ngaha batāpfuye; na ho ni bapfa, bazoba babaye nk’ Abisirayeli bandi bose bāpfuye: tubarungike turābe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.13",
            "verseOrgIds": [
              "2KI.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bajana imikogote ibiri ikwegwa n’amafarasi, umwami arabarungika ngo bakurikire ingabo z’Abasiriya, ati Ni mugende murābe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.14",
            "verseOrgIds": [
              "2KI.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baca aho baciye, barinda bashika kuri Yorodani; basanga inzira yose ar’ impuzu n’ibintu Abasiriya bagiye barata mu kwiruka. Nukw izo ntumwa ziragaruka zibibarira umwami.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.15",
            "verseOrgIds": [
              "2KI.7.15"
            ]
          }
        }
      ]
    },
