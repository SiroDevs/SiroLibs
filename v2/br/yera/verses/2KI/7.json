                {
                  "text": "Lew 13:46",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hār’ abantu bane b’abanyamibembe kw irembo ry’igisagara; baravugana, bati N’iki kitwicaritse ngaha kugira ngo tuhapfire? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.3",
            "verseOrgIds": [
              "2KI.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.4.16"
              },
              "items": [
                {
                  "text": "Est 4:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tworamuka tugiye mu gisagara, kandi hariy’ inzara ingana irtyo, twogwayo; na ho nyene ni twapfa kwicara ngaha, n’ugupfa nta kindi. None rero ni muze twisabe ingabo z’Abasiriya; ni baduhangaza tuzobaho, na ho ni batwica, na kare kwar’ ugupfa n’ugupfa! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.4",
            "verseOrgIds": [
              "2KI.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bahenga buhwibiriye barīkora ngo baje ah’ Abasiriya bashagaje; ariko bashitse ah’ insago zabo zitangurira, basanga ata muntu akiharangwa; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.5",
            "verseOrgIds": [
              "2KI.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.24"
              },
              "items": [
                {
                  "text": "2 Sam 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.6.17"
              },
              "items": [
                {
                  "text": "2 Abam 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ Uhoraho yari yatumye haza mu matwi y’ingabo z’Abasiriya uguhinda kw’imikogote n’ukw’ amafarasi n’ukw’ ingabo nyinshi, bituma bavugana, bat’ Ereg’ umwami w’Abisirayeli yahēreye abami b’Abaheti n’abami bo muri Egiputa ngo badutere. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.6",
            "verseOrgIds": [
              "2KI.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bafashako baratemesha aho nyene bugihwibira, bata amahema yabo n’amafarasi yabo n’indogoba zabo, basiga vyose uko vyakabaye aho bashagaje, kugira ngo banyage amagara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.7",
            "verseOrgIds": [
              "2KI.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo banyamibembe bashitse ah’ izo nsago zitangurira, binjira mw ihema rimwe, bashirako bararya baranywa, basahuramw’ amafeza n’amazahabu n’imyambaro, baragenda barabinyegeza; baragaruka binjira mu rindi hema, basahuramw’ ibindi, na vyo nyene baragenda barabinyegeza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.8",
            "verseOrgIds": [
              "2KI.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
