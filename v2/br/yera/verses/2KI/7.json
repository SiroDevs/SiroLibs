            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu barasokoroka, basahura izo nsago z’Abasiriya; nukw ingero y’ifu igogōretse isigara igurwa shekeli imwe, n’ingero zibiri za sayiri zikagurwa shekeli imwe nyene, nk’ukw ijambo ry’Uhoraho ryavuze. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.16",
            "verseOrgIds": [
              "2KI.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.6.32"
              },
              "items": [
                {
                  "text": "2 Abam 6:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.7.2"
              },
              "items": [
                {
                  "text": "7:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze wa mugabisha umwami yagenda yegamiye, umwami amushira mw irembo kubuza ababandana; arikw abantu bamucako bamuhonyangira aho nyene mw irembo, arapfa, nk’uko wa muntu w’Imana yavuze, igihe umwami yaza ah’ ari. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.17",
            "verseOrgIds": [
              "2KI.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
