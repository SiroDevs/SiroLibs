                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umugabisha uwo mwami yagenda yegamiye yishura uwo muntu w’ Imana, ati Mbeg’ Uhoraho naho yotobora amadirisha mw ijuru, ivyo vyoshoboka? Aramwishura, at’ Uzobirābisha amaso, ariko ntuzobiryako.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.7.2",
            "verseOrgIds": [
              "2KI.7.2"
            ]
          }
        }
      ]
    },
    {
