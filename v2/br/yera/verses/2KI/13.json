              "2KI.13.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.2.12"
              },
              "items": [
                {
                  "text": "2 Abam 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowasi akiriho, Elisa afatwa n’indwara, ari yo nyene yamwishe. Yehowasi umwami w’Abisirayeli aramanuka aja kurāba ukw ameze, amuririra hejura, ati Yewe ga data we, yewe ga data we, wabereye Abisirayeli imikogote n’abagendera ku mafarasi! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa aramubarira, at’ Abīra umuheto n’imyampi. Nukw aravyābīra. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa abarira uwo mwami w’Abisirayeli, ati Fora. Nukw arafora; Elisa ashira intoke ziwe ku z’ umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araheza aravuga, at’ Ugurura idirisha ryerekeye i burasirazuba; bararyugurura. Maze Elisa aramubarira, ati Rasa; nukw ararasa. Elisa aravuga, ati N’umwampi w’Uhoraho w’intsinzi, ni wo mwampi wo kunesha i Siriya; kukw ari wewe uzorwanira n’Abasiriya muri Afeka gushitsa ah’ uzobaherengetereza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ at’ Abīra imyampi; nuk’ uwo mwami w’Abisirayeli arayābīra. Elisa aramubarira, ati Yikubite hasi. Ayikubita hasi gatatu, araheza ageza aho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muntu w’Imana aramurakira, aramubarira, at’ Iy’ uba war’ ukubise gatanu canke gatandatu, wonesheje Abasiriya gushitsa ah’ ubaherengeteje; ariko non’ uzobanesha gatatu gusa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
