              "items": [
                {
                  "text": "2 Abam 10:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira mirongwibiri na gatatu Yowasi mwene Ahaziya, umwami w’i Buyuda, ari ku ngoma, ni ho Yehowahazi mwene Yehu yima i Samariya mu Bisirayeli, amara imyaka cumi n’ indwi ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28+1KI.12.29+1KI.12.30"
              },
              "items": [
                {
                  "text": "1 Abam 12:28-30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo Uhoraho abona kw ari bibi, akurikira ivyaha vya Yerobowamu mwene Nebati, ivyo yakoze akabikwegeramwo n’Abisirayeli, ntiyabivamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.2.14"
              },
              "items": [
                {
                  "text": "Abac 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.8.12"
              },
              "items": [
                {
                  "text": "2 Abam 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.13.22"
              },
              "items": [
                {
                  "text": "13:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.13.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uburake bg’Uhoraho buziriringira Abisirayeli, akāma abagabura mu maboko ya Hazayeli umwami w’i Siriya, no mu ya Beni‐hadadi mwene Hazayeli nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.7"
              },
              "items": [
                {
                  "text": "Kuv 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.26"
              },
              "items": [
                {
                  "text": "2 Abam 14:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.34"
              },
              "items": [
                {
                  "text": "Zab 78:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yehowahazi atakambira Uhoraho, Uhoraho aramwumvira, kuko yabonye agahahazo umwami w’i Siriya yahahaza Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.3.9"
              },
              "items": [
                {
                  "text": "Abac 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.9.27"
              },
              "items": [
                {
                  "text": "Neh 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho aha Abisirayeli uwo kubakiza, bituma bīgobotora mu maboko y’Abasiriya, babona gusubira kwigumira i muhira nk’uko bāhora ubga mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.16"
              },
              "items": [
                {
                  "text": "1 Abam 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.33"
              },
              "items": [
                {
                  "text": "16:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo ntibāva mu vyaha vy’ab’ inzu ya Yerobowamu, ari we nyene yari yarabikwegeyemw’ Abisirayeli ngo bacumure, ariko bakomeza kubigenderamwo. Kand’ inkingi za Ashera ziguma i Samariya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umwami w’i Siriya ata co yasigarije Yehowahazi mu ngabo, atar’ abagendera ku mafarasi mirongwitanu, n’imikogote cumi, n’ abagendesha amaguru ibihumbi cumi; abandi yari yarabaranduye, abahindura nk’umukungugu wo ku mbuga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Yehowahazi, n’ivyo yakoze vyose, n’ivy’ ububasha bgiwe, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yehowahazi ahamvya ba sekuruza, bamuhamba i Samariya; maz’ umuhungu wiwe Yehowasi asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira mirongwitatu n’indwi Yowasi umwami w’i Buyuda ari ku ngoma, ni ho Yehowasi mwene Yehowahazi yima i Samariya mu Bisirayeli; amara imyaka cumi n’itandatu ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo Uhoraho abona kw ari bibi; ntiyava mu vyaha vyose vya Yerobowamu mwene Nebati, ivyo yakwegeyemw’ Abisirayeli ngo bacumure; arikw abigenderamwo na we.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
