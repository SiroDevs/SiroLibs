          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.8+2KI.14.9+2KI.14.10+2KI.14.11+2KI.14.12+2KI.14.13+2KI.14.14+2KI.14.15"
              },
              "items": [
                {
                  "text": "2 Abam 14:8-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Yehowasi, n’ivyo yakoze vyose, n’ ivy’ ubuhizi yar’ afise arwana na Amaziya umwami w’i Buyuda, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yehowasi ahamvya ba sekuruza, Yerobowamu asubira ku ngoma yiwe. Yehowasi ahambga i Samariya hamwe n’abami b’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
