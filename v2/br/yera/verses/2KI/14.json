              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.22",
            "verseOrgIds": [
              "2KI.14.22"
            ]
          }
        },
        {
          "name": "verse",
