              "2KI.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.25.17+2CH.25.18+2CH.25.19+2CH.25.20+2CH.25.21+2CH.25.22+2CH.25.23+2CH.25.24"
              },
              "items": [
                {
                  "text": "2 Ngo 25:17-24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Amaziya atuma intumwa kuri Yehowasi mwene Yehowahazi, Yehowahazi mwene Yehu, umwami w’Abisirayeli, muti N’uze muhangane. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.8",
            "verseOrgIds": [
              "2KI.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.9.8+JDG.9.9+JDG.9.10+JDG.9.11+JDG.9.12+JDG.9.13+JDG.9.14+JDG.9.15"
              },
              "items": [
                {
                  "text": "Abac 9:8-15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowasi umwami w’Abisirayeli atuma kwishura Amaziya umwami w’i Buyuda, mut’ Igitovu c’i Lebanoni catumye kw isederi y’i Lebanoni nyene, ut’ Umukobga wawe n’umushingire umuhungu waco. Bukeye igikōko caba i Lebanoni kihahise gikandagira ca gitovu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.9",
            "verseOrgIds": [
              "2KI.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nka ko waratsinze Abanyedomu, uraheza wishira hejuru mu mutima wawe: ego ni wihaye, arik’ ugume i muhira; n’iki gituma ugomba kwikwegera akaziri, mugapfa mwe n’ Abayuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.10",
            "verseOrgIds": [
              "2KI.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Amaziya ntiyaruha amwumvira. Nuko Yehowasi umwami w’Abisirayeli ni kwo kudūga, bahanganira na Amaziya umwami w’i Buyuda i Beti‐shemeshi h’i Buyuda nyene, bararumana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.11",
            "verseOrgIds": [
              "2KI.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abayuda baneshwa n’Abisirayeli, umuntu wese ahungira i we. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.12",
            "verseOrgIds": [
              "2KI.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yehowasi umwami w’Abisirayeli afata mpiri Amaziya umwami w’i Buyuda, mwene Yowasi, Yowasi mwene Ahaziya, amufatira i Beti‐shemeshi nyene; aca aja i Yerusalemu, asangangura uruzitiro rwaho rw’amabuye, uhereye kw irembo ry’Abefurayimu ugashitsa kw irembo ryo ku mfuruka, hose har’ amatambge amajana ane y’ ukuboko uciriye mu nkokora. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.13",
            "verseOrgIds": [
              "2KI.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.18"
              },
              "items": [
                {
                  "text": "2 Abam 12:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asahura amazahabu n’amafeza yose, n’ibintu vyose vy’imbombovu bāsanze mu ngoro y’Uhoraho n’ivyo bāsanze mu bubīko bgo mu ngoro y’umwami, afata n’abantu abajana bari mu bugōmbe, araheza asubira i Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.14",
            "verseOrgIds": [
              "2KI.14.14"
            ]
          }
        }
      ]
    },
