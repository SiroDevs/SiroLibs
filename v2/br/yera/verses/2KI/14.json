              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Yehowasi, n’ivy’ ubuhizi bgiwe, n’ingene yarwanye na Amaziya umwami w’i Buyuda, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.15",
            "verseOrgIds": [
              "2KI.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yehowasi ahamvya ba sekuruza, ahambga i Samariya hamwe n’abami b’Abisirayeli; maz’ umuhungu wiwe Yerobowamu asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.16",
            "verseOrgIds": [
              "2KI.14.16"
            ]
          }
        }
      ]
    },
