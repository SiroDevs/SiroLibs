            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira icumi na gatanu Amaziya mwene Yowasi umwami w’i Buyuda ari ku ngoma, ni ho Yerobowamu mwene Yehowasi umwami w’Abisirayeli yima i Samariya; amara imyaka mirongwine n’umwe ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
