                "loc": "2KI.13.12"
              },
              "items": [
                {
                  "text": "2 Abam 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
