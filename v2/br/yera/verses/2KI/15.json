                  "text": "1 Abam 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo Uhoraho abona kw ari bibi, ntiyava mu vyaha vya Yerobowamu mwene Nebati, ivyo yakwegeyemw’ Abisirayeli ngo bacumure. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Peka mwene Remaliya, umugabisha wiwe, afatanya n’ Abanyegileyadi mirongwitanu, aramugarariza, amwicana na Arugobi na Ariyeha, abatsinda i Samariya mu munara wo mu rugo i bgami; nukw amaze kumwica asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ibindi vyose vyadonzwe kuri Pekahiya, n’ivyo yakoze vyose, vyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.26",
            "verseOrgIds": [
              "2KI.15.26"
            ]
          }
        }
      ]
