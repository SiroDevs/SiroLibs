                "loc": "2KI.8.12"
              },
              "items": [
                {
                  "text": "2 Abam 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.13.16"
