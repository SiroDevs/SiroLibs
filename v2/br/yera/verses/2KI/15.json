              },
              "items": [
                {
                  "text": "2 Abam 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Hosheya mwene Ela agarariza Peka mwene Remaliya, amutsindaho aramwica, asubira ku ngoma yiwe; hāri mu mwaka ugira mirongwibiri Yotamu mwene Uziya ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Peka, n’ivyo yakoze vyose, vyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
      ]
