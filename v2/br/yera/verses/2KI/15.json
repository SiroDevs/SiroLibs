            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku ngoma ya Peka umwami w’Abisirayeli, Tigulati‐pileseri umwami w’i Ashuri araza, atera ahitwa Iyoni n’i Abeli‐beti‐mayaka, n’i Yanowa n’i Kedeshi, n’i Hasori n’i Gileyadi, n’i Galilaya n’igihugu cose c’i Nafutali; abantu baho abajana i Ashuri ar’ inyagano. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.29",
            "verseOrgIds": [
              "2KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
