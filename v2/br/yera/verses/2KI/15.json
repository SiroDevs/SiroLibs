              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.12.3"
              },
              "items": [
                {
                  "text": "2 Abam 12:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.27.3"
              },
              "items": [
                {
                  "text": "2 Ngo 27:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo ibitabo vyo ku mpinga z’imisozi ntivyakūrwaho; abantu bāri bagitangira ibimazi mur’ ivyo bitabo, bakahosereza imibavu. Yotamu ni we yubatse ikirimba co haruguru ku ngoro y’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ibindi vyose vyadonzwe kuri Yotamu, n’ivyo yakoze vyose, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’i Buyuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.36",
            "verseOrgIds": [
              "2KI.15.36"
            ]
          }
        },
        {
