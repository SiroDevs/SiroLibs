            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yar’ amaze imyaka mirongwibiri n’itanu igihe yima; amara imyaka cumi n’itandatu i Yerusalemu ari ku ngoma. Nyina yitwa Yerusha, umukobga wa Sadoki. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.33",
            "verseOrgIds": [
              "2KI.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo Uhoraho abona kw ari vyiza, nk’ ivyo se Uziya yakoze vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.34",
            "verseOrgIds": [
              "2KI.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
