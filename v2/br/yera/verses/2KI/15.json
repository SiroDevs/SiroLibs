                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira mirongwitatu n’icenda Uziya umwami w’i Buyuda ari ku ngoma, ni ho Shalumu mwene Yabeshi yima; amara ukwezi kumwe i Samariya ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.13",
            "verseOrgIds": [
              "2KI.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Menahemu mwene Gadi ava i Tirusa, aradūga aja i Samariya, amutsindaho aramwica, asubira ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.14",
            "verseOrgIds": [
              "2KI.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Shalumu, n’ingene yagararije, vyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
