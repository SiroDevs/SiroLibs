                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.15.32"
              },
              "items": [
                {
                  "text": "2 Abam 15:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Uhoraho atēza umwami imibembe, arinda atanga akir’ umunyamibembe, aba mu nzu ya wenyene; maze Yotamu umwana wiwe ni we yagaba ivyo mu rugo, agacira abantu bo mu gihugu imanza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        }
