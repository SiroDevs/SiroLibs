          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira mirongwitanu na kabiri Uziya umwami w’i Buyuda ari ku ngoma, ni ho Peka mwene Remaliya yima i Samariya mu Bisirayeli; amara imyaka mirongwibiri ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.27",
            "verseOrgIds": [
              "2KI.15.27"
            ]
          }
        },
        {
