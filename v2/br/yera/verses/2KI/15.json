              "items": [
                {
                  "text": "Hos 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu araheza atera i Tifusa, arahatsinda, ageseza n’ abari mur’ ico gisagara bose, anesha n’intara yaco uhereye i Tirusa nyene; icatumye ahageseza n’uko banse kumwugururira amarembo; nukw afomoza abagore bose bafise inda bari muri co.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
