            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ ico gihe ni ho Uhoraho yatangura kugomora Rezini umwami w’i Siriya na Peka mwene Remaliya kurwanya Abayuda. ",
          "type": "text",
          "attrs": {
