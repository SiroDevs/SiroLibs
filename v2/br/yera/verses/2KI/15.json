              "2KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ibindi vyose vyadonzwe kuri Uziya, n’ivyo yakoze vyose, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’abami b’Abayuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Uziya ahamvya ba sekuruza, bamuhamba hamwe na bo ku murwa wa Dawidi; maz’ uwo muhungu wiwe Yotamu asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
