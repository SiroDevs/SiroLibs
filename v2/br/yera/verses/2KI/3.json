              "items": [
                {
                  "text": "2 Abam 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira icumi n’ umunani Yehoshafati umwami w’Abayuda ari ku ngoma, ni ho Yehoramu mwene Ahabu yima mu Bisirayeli, amara imyaka cumi n’ibiri ari ku ngoma i Samariya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.1",
            "verseOrgIds": [
              "2KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.24"
              },
              "items": [
                {
                  "text": "Kuv 23:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.31"
              },
              "items": [
                {
                  "text": "1 Abam 16:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo Uhoraho abona kw ari bibi, mugabo ntiyashikīra se na nyina, kuko yakūyeh’ inkingi ya Bayali, iyo se yari yarashinze. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.2",
            "verseOrgIds": [
              "2KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.12.28"
              },
              "items": [
                {
                  "text": "1 Abam 12:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.14.16"
              },
              "items": [
                {
                  "text": "14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko rero yifatanya n’ivyaha vya Yerobowamu mwene Nebati, ivyo yari yarakwegeyemw’ Abisirayeli, ntiyabivamwo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.3",
            "verseOrgIds": [
              "2KI.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Mesha umwami w’i Mowabu yar’ umutunzi w’intama; yama ashikanira umwami w’Abisirayeli ubgoya bukemuwe ku bana b’intama ibihumbi ijana, n’ubg’ amapfizi y’intama ibihumbi ijana nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.4",
            "verseOrgIds": [
              "2KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.1"
              },
              "items": [
                {
                  "text": "2 Abam 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Ahabu amaze gutanga, uwo mwami w’i Mowabu agarariza umwami w’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.5",
            "verseOrgIds": [
              "2KI.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami Yehoramu ava i Samariya ico gihe, akoranya Abisirayeli bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.6",
            "verseOrgIds": [
              "2KI.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.4"
              },
              "items": [
                {
                  "text": "1 Abam 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ araheza atuma kuri Yehoshafati umwami w’Abayuda, ut’ Umwami w’i Mowabu yamugararije, uti Mbega wokwemera kumutabara, ukajana na we kuja gutera i Mowabu? Aramwishura, ut’ Ego me muzojana, uti We n’umwe nawe, uti N’abantu biwe ni bo b’iwawe, uti N’amafarasi yiwe ni yo y’iwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.7",
            "verseOrgIds": [
              "2KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu arongera aramubaza, uti Muzodūgana iyihe nzira? Aramwishura, uti Muzojana inzira ica mu bugaragwa bg’Abanyedomu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.8",
            "verseOrgIds": [
              "2KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.47"
              },
              "items": [
                {
                  "text": "1 Abam 22:47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’Abisirayeli aragenda, bo n’umwami w’Abayuda n’umwami w’Abanyedomu; baca ahaziguye, maze bagenze imisi ndwi mu nzira, ingabo zibura amazi, bo n’inyumbu zibakurikiye zīremētse intēkera zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.9",
            "verseOrgIds": [
              "2KI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.7"
              },
              "items": [
                {
                  "text": "Yos 7:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami w’Abisirayeli aravuga, ati Tubonye ibara, kuk’ Uhoraho yadukoranije tur’ abami batatu ngw atugabure mu maboko y’Abanyamowabu! ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.10",
            "verseOrgIds": [
              "2KI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.21"
              },
              "items": [
                {
                  "text": "1 Abam 19:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.22.7"
              },
              "items": [
                {
                  "text": "22:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati arabaza, ati Mbega nta wuvugishwa n’Uhoraho yoba ngaha, ngw adusigurize Uhoraho? Umwe mu bantu b’umwami w’ Abisirayeli aramwishura, ati Elisa mwene Shafati ari hano, yahora ar’ umusuku wa Eliya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:11",
              "type": "text"
            },
            {
              "text": "Mu Giheburayo handitswe ngo Yahora asukīra Eliya amazi mu minwe ngw akarabe.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.11",
            "verseOrgIds": [
              "2KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati aravuga, at’ Ijambo ry’ Uhoraho riri muri we. Nuk’ umwami w’Abisirayeli, na Yehoshafati, n’umwami w’Abanyedomu, baramanuka baja iy’ ari. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.12",
            "verseOrgIds": [
              "2KI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.19"
              },
              "items": [
                {
                  "text": "1 Abam 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa abarira umwami w’Abisirayeli, ati Dusangiye iki nawe? Genda usiguze ba kamenyi ba so na ba kamenyi ba nyoko! Umwami w’Abisirayeli aramwishura, at’ Oyaye, kuk’ Uhoraho yadukoranije tur’ abami batatu ngw atugabure mu maboko y’ Abanyamowabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.13",
            "verseOrgIds": [
              "2KI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.17.1"
              },
              "items": [
                {
                  "text": "1 Abam 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa aramwishura, ati Nkurahiye uguhoraho kw’Uhoraho Nyen’ ingabo, uwo nsavye, iyo ntubaha Yehoshafati umwami w’Abayuda, sinaruha nkurāba ngo ngushirekw ijisho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.14",
            "verseOrgIds": [
              "2KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.10.5"
              },
              "items": [
                {
                  "text": "1 Sam 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.46"
              },
              "items": [
                {
                  "text": "1 Abam 18:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.8.1"
              },
              "items": [
                {
                  "text": "Ezk 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.37.1"
              },
              "items": [
                {
                  "text": "37:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.1"
              },
              "items": [
                {
                  "text": "40:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneho nzanira umuvuzi w’inanga. Uwo muvuzi w’inanga ashitse, atanguye kuvuza, ukuboko kw’Uhoraho kuza kuri Elisa; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.15",
            "verseOrgIds": [
              "2KI.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "aravuga, at’ Uku ni k’Uhoraho agize, Ngw iki kiyaya ni mugisataguremw’ imigazo myinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.16",
            "verseOrgIds": [
              "2KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari k’Uhoraho agize, ngo Nta muyaga muja kubona, canke ngo mubone imvura, ngw Arikw iki kiyaya kizokwuzura amazi, munywe mwebge ubganyu, mushōre n’ivyo mushoreye n’inyumbu zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.17",
            "verseOrgIds": [
              "2KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
