          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ivyo s’ikigoye k’Uhoraho; mber’ azogabura n’Abanyamowabu mu maboko yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.18",
            "verseOrgIds": [
              "2KI.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
