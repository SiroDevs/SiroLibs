              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.19"
              },
              "items": [
                {
                  "text": "Gus 20:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe muze musangangure igisagara cose kizitijwe uruzitiro rw’amabuye, n’igisagara cose giteye igomwe; n’igiti ciza cose muze mugice, musivye n’amariba yaho yose, n’indimiro nziza zose muzisibanganishe amabuye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.3.19",
            "verseOrgIds": [
              "2KI.3.19"
            ]
          }
        }
      ]
    },
