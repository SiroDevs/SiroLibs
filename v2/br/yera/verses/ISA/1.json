              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwiyuhagire, mwitunganye, mukūreh’ ibibi vyo mu bikorwa vyanyu bive mu nyonga zanje; mureke gukora ibibi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.16",
            "verseOrgIds": [
