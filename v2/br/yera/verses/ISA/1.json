          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwemera mukumvira, muzorya ivyiza vyo mu gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.19",
            "verseOrgIds": [
              "ISA.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
