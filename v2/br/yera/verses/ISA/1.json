          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifeza zawe zihindutse inkamba, vino zawe zihindutse imihwanyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.22",
            "verseOrgIds": [
              "ISA.1.22"
            ]
          }
        },
