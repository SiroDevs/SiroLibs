            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko muzomera nk’umweloni uravye amababi, canke nk’ikigabiro kitagira amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.30",
            "verseOrgIds": [
              "ISA.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunyenkomezi azohinduka nk’ibisūsūrwa, n’igikorwa ciwe nk’ isase ry’umuriro; vyompi bizohīra hamwe, kandi nta wuzobizimya.",
          "type": "text",
