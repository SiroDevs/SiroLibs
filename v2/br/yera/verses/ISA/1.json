                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu canyu n’amatongo, ibisagara vyanyu vyakomvomvowe n’umuriro, abanyamahanga babaryana igihugu canyu mubona, kandi cacitse amatongo nk’ahakomvomvowe n’abanyamahanga koko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.7",
            "verseOrgIds": [
              "ISA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.27.18"
              },
              "items": [
                {
                  "text": "Yob 27:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukobga w’i Siyoni asigaye ameze nk’umutara uri mu ruzabibu, ameze nk’urusago ruri mu ndimiro y’imyungu, ameze nk’igisagara gitawe hagati n’abansi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.8",
            "verseOrgIds": [
              "ISA.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24"
              },
              "items": [
                {
                  "text": "Ita 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.29"
              },
              "items": [
                {
                  "text": "Rom 9:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyaba Uhoraho Nyen’ ingabo atadushigarije amasigarira na makeya, tuba twarabaye nk’i Sodomu, tukamera nk’i Gomora.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.9",
            "verseOrgIds": [
              "ISA.1.9"
            ]
          }
        }
      ]
    },
    {
