                  "text": "Zek 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru bawe n’abagarariji, n’abagenzi b’ibisuma; umuntu wese muri bo akunda ingurire, akurikira guhongerwa; ntibacira urubanza impfuvyi, kand’ imanza z’abapfakazi ntizigera aho bari.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.23",
            "verseOrgIds": [
              "ISA.1.23"
            ]
