            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ ukuntu umurwa wizigirwa ucitse maraya; ahāhora huzura imanza ziroranye, hakaba i wabo w’ubugororotsi, none hasigaye ar’ ah’ abicanyi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.21",
            "verseOrgIds": [
