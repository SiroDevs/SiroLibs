                "loc": "EZK.22.20"
              },
              "items": [
                {
                  "text": "Ezk 22:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzogufatisha ukuboko kwanje, ngukūremwo rwose inkamba zawe, nkumaremw’ urwevu rwawe rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.25",
            "verseOrgIds": [
              "ISA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.8.3"
              },
              "items": [
                {
                  "text": "Zek 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzosubizah’ abacamanza bawe nk’ubga mbere, n’abajanama bawe nko mu matangura; uheze witwe igisagara c’ubugororotsi, umurwa wizigirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.26",
            "verseOrgIds": [
              "ISA.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Siyoni hazocunguzwa guca iziroranye, abīsubiyemwo baho bazocunguzwa ukugororoka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.27",
            "verseOrgIds": [
              "ISA.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abacumura n’abanyavyaha bazotikirizwa rimwe, kand’ abataye Uhoraho bazohona. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.28",
            "verseOrgIds": [
              "ISA.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
