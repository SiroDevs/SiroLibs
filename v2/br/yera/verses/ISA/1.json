                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda ni muze, twītātūre, ni k’Uhoraho agize; nah’ ivyaha vyanyu vyotukura tukutuku, bizokwera derere nka shelegi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.18",
            "verseOrgIds": [
              "ISA.1.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:18",
              "type": "text"
            },
            {
              "text": "shelegi n’ikintu coroshe cera, gikoroka hasi nk’imvura, gikanye cane.",
              "type": "text"
            }
          ]
        },
        {
          "text": " naho vyotukura nk’agahama, bizohinduka nk’ubgoya bg’intama y’umwero. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.18",
            "verseOrgIds": [
              "ISA.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
