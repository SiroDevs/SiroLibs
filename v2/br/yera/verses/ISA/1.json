              "items": [
                {
                  "text": "Mik 4:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ho ni mwanka mukagarariza, inkota izobarya: kukw akanwa kanje Uhoraho ari ko kabivuze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.20",
