              "type": "text"
            }
          ]
        },
        {
          "text": "mwige gukora neza; mushimikire imanza zibereye, mutabare abahahazwa, mucire urubanza impfuvyi, mubūranire abapfakazi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.17",
