                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega n’ubu muracadaramīra ngo mukubitwe, ko mwiyongeranya kugarariza? Umutwe wose urarwaye, umutima wose uradendebukiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.5",
            "verseOrgIds": [
              "ISA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye mu bgoro bg’ikirenge ugashitsa ku mutwe nta hazima hariho, atar’ inguma n’ibipfupfuri n’imishishagu, bitigeze gukandwa canke gupfukwa canke kubombekeshwa amavuta.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.6",
            "verseOrgIds": [
              "ISA.1.6"
            ]
          }
        }
      ]
    },
