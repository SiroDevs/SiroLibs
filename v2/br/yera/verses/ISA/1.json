                {
                  "text": "Ita 49:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma Umwami, Uhoraho Nyen’ ingabo, Inyenkomezi y’Abisirayeli, avuga, at’ Erega nzotururuzwa n’ukwīhōra abarwanizi banje, kand’ abansi banje nzobasubiriza mu nkōko! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.24",
            "verseOrgIds": [
              "ISA.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 1:25"
          },
          "items": [
