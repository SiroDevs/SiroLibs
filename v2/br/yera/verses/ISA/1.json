                "loc": "JOL.2.15"
              },
              "items": [
                {
                  "text": "Yow 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukongere kunshikanira amashikanwa atagira ikimazi: imibavu n’igisesema kuri jewe; imboneko z’amezi n’amasabato no gukoranya ibikorane — eka sinshobora kwihanganira amakoraniro y’agahebuza avanze n’ibigabitanyo! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.13",
            "verseOrgIds": [
              "ISA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko muziririza imboneko z’amezi n’imisi mikuru mwashiriweho, umutima wanje urabizinutswe; birangoye, ndambiwe kuvyihanganira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.14",
            "verseOrgIds": [
              "ISA.1.14"
            ]
          }
        },
