        },
        {
          "text": "Ni mwatega amaboko yanyu nzobahisha mu nyonga hanje; mbere naho mwosenga amasengesho menshi sinzobumviriza: amaboko yanyu yuzuyekw ibitenga vy’amaraso.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.15",
            "verseOrgIds": [
              "ISA.1.15"
            ]
          }
        }
