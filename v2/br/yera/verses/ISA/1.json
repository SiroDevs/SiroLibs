            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwumve, mwa majuru, tega amatwi, wa si we, kuk’ Uhoraho abivuze: ati Narakujije abana, ndabarera, maze barampinduka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.2",
            "verseOrgIds": [
              "ISA.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inka irazi nyeneyo, n’indogoba irazi ubgato bga shebuja: arikw Abisirayeli bo nta co bazi, abantu banje nta co batahura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.3",
            "verseOrgIds": [
              "ISA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.5.24"
              },
              "items": [
                {
                  "text": "Yes 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.14.5"
              },
              "items": [
                {
                  "text": "Ezk 14:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe wa hanga rikora icaha, ubgoko buremerewe n’ukugabitanya, uruvyaro rw’inkozi z’ibibi, abana b’ivyanke! Barantaye, jewe Uhoraho, barankengēra, jewe Uwera w’Abisirayeli; twārahubanywe, bāsubiye inyuma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.4",
            "verseOrgIds": [
              "ISA.1.4"
            ]
          }
        }
      ]
    },
