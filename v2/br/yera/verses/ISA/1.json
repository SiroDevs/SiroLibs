            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko muzomāramāzwa n’ibiti vy’imyeloni mwishimiye, kandi muzokwumizwa n’ibigabiro mwashimye; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.1.29",
            "verseOrgIds": [
              "ISA.1.29"
            ]
          }
        },
        {
