              },
              "items": [
                {
                  "text": "Gal 4:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ririmba, mugore w’ingumba utigeze kuvyara, turika uririmbe usemerere, wewe utigeze kuramukwa: kukw abana b’intābga ari benshi, baruta abana b’ūfise umugabo, ni jewe Uhoraho mbivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.1",
            "verseOrgIds": [
              "ISA.54.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 54:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.19"
              },
              "items": [
                {
                  "text": "Yes 49:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tāzānura ikibanza c’ihema ryawe, ni bāgure amahema y’ah’ uba; ntugarukize hafi; wungure imigozi yaryo, ushimangire imambo zaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.2",
            "verseOrgIds": [
              "ISA.54.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 54:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.14"
              },
              "items": [
                {
                  "text": "Ita 28:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uzogasara, uje i buryo n’i bumoso; kand’ uruvyaro rwawe ruzoganza amahanga, ruzotuma ibisagara vyabaye imisaka bisubira kugerērwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.3",
            "verseOrgIds": [
              "ISA.54.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 54:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.17"
              },
              "items": [
                {
                  "text": "Yes 45:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta co utinya, kuk’ utazotētērwa; ntumāramāre, kukw isoni zitazokwica; kuk’ uzokwibagira isoni wagize mu buto bgawe, n’umugayo wo mu bupfakazi bgawe ntuzowibuka ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.4",
            "verseOrgIds": [
              "ISA.54.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 54:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.4"
              },
              "items": [
                {
                  "text": "Yes 62:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.5"
              },
              "items": [
                {
                  "text": "5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.9"
              },
              "items": [
                {
                  "text": "Zek 14:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko jewe Umuremyi wawe ari jewe mugabo wawe; Uhoraho Nyen’ ingabo ni ryo zina ryanje; Uwera w’Abisirayeli ni jewe Mucunguzi wawe; nzokwitwa Imana y’isi yose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.5",
            "verseOrgIds": [
              "ISA.54.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 54:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.49.14"
              },
              "items": [
                {
                  "text": "Yes 49:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko jewe Uhoraho nguhamagaye nk’umugore w’intābga afise intuntu mu mutima, ngucūye nk’umugore wo mu bucance yari yarirukanywe, ni jewe Imana yawe mbivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.6",
            "verseOrgIds": [
              "ISA.54.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 54:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbaye ndagutaye akanya gato, ariko nzokwiyegereza ngufitiye imbabazi nyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.7",
            "verseOrgIds": [
              "ISA.54.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 54:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburake bgāraziririnze, nguhisha inyonga zanje akanya gato, ariko nzokugirira imbabazi z’urukundo rutazoshira, ni jewe Uhoraho Umucunguzi wawe mbivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.8",
            "verseOrgIds": [
              "ISA.54.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 54:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.9.11"
              },
              "items": [
                {
                  "text": "Ita 9:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bimmereye nk’ivy’ umwuzure wo mu gihe ca Nowa; nk’ uko narahiye k’umwuzure wo mu gihe ca Nowa utazokwongera kurengera isi, ni ko n’ubu ndahiye ko ntazokurakira ngo ndagutonganye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.9",
            "verseOrgIds": [
              "ISA.54.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 54:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.25.12"
              },
              "items": [
                {
                  "text": "Guh 25:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.25"
              },
              "items": [
                {
                  "text": "Ezk 34:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw imisozi izovaho, n’uturambi tuzokūrwaho, arik’ ubuntu bganje ntibuzokuvako, kandi n’isezerano ry’amahoro nagusezeraniye ntirizokūrwaho, ni jewe Uhoraho nkugirira ikigongwe mbivuze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.54.10",
            "verseOrgIds": [
              "ISA.54.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
