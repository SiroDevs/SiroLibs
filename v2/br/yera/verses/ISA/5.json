                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye abantu banje bajanwa ar’ inyagano, ata co bigeze bamenya: abanyacubahiro bo muri bo bishwe n’inzara, kand’ ishengero ryabo ryose ryāgatuwe n’inyota. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.13",
            "verseOrgIds": [
              "ISA.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye i kuzimu harangara, hāsamitse akanwa kaho birengeje urugero: maz’ abakire b’i Yerusalemu na ba nyarucari baho barokeramwo, bakiri mu gahimbo, bavuza urwamo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.14",
            "verseOrgIds": [
              "ISA.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 5:15"
          },
