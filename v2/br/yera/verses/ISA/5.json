                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobona ibara, abomeka ingo ku zindi bakīkumirakw amatongo, gushitsa hatagira ahasigaye, mukaba ari mwebge mwenyene musigaye mwiganziye hagati mu gihugu! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.8",
            "verseOrgIds": [
              "ISA.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Nyen’ ingabo yavugiye mu matwi yanje, ati N’ukuri ingo nyinshi zizoba imisaka, mbere na nini‐nini nziza zizosigara ata wukizibamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.9",
            "verseOrgIds": [
              "ISA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.45.11"
              },
              "items": [
                {
                  "text": "Ezk 45:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw imirima cumi y’imizabibu izoreta umubindi umwe, kand’ igisamba cagezwemw’ imbuto kizozana inkōko gusa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.10",
            "verseOrgIds": [
              "ISA.5.10"
            ]
          }
        }
      ]
