          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "arik’ Uhoraho Nyen’ ingabo azoba ashizwe hejuru n’imanza ziroranye, kand’ Imana Yera izokwerekanisha ukwera kwayo ubugororotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.16",
            "verseOrgIds": [
              "ISA.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe imyagazi y’intama izorisha nk’ah’ ari mu canya cayo, kand’ ivyo mu matongo y’abakire abayerera ni bo bazobirya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.17",
