            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mw inywa ryabo bagira inanga n’ikembe n’agashako k’ingoma n’umwironge na vino; yamara ntibītegereza igikorwa c’Uhoraho, ntibashira umutima ku gikorwa c’amaboko yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.12",
            "verseOrgIds": [
              "ISA.5.12"
            ]
          }
        },
        {
