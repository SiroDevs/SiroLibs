              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobona ibara, abazindurwa mu gatondo no kwirukira ibiboreza, bakarāra kw ijoro gushitsa vino ibaboreje! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.11",
            "verseOrgIds": [
              "ISA.5.11"
            ]
