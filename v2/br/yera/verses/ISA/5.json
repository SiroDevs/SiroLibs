            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ azomanikira amahanga ya kure ibendera, abahamagaze uruhwa ngo bave ku mpera y’isi; na bo bazoza n’ingoga bihuta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.26",
            "verseOrgIds": [
              "ISA.5.26"
            ]
          }
