              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bazosubizwa hasi, abahambaye bacishwe bugufi, abībone bacurike amaso hasi: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.15",
            "verseOrgIds": [
              "ISA.5.15"
            ]
          }
        },
        {
