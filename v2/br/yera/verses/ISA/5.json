                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinge ndirimbe ivy’ umukunzi wanje, indirimbo y’uwo nkunda ivuga ivy’ uruzabibu rwiwe. Umukunzi wanje yagize uruzabibu ku musozi umera cane: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.1",
            "verseOrgIds": [
              "ISA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.21"
              },
              "items": [
                {
                  "text": "Yer 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yari yararurimiriye, akūramw’ amabuye, ateramw’ imizabibu y’ubgoko bgiza, arwubakamw’ umutara hagati, arwimbamwo n’ikinogo, agikora bga bgato: nuko yaziga ko ruzokwama inzabibu, ariko rwama ibijabija vy’inzabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.2",
            "verseOrgIds": [
              "ISA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mwa baba i Yerusalemu, namwe bagabo b’i Buyuda, ndabinginze mudutātūre, twe n’uruzabibu rwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.3",
            "verseOrgIds": [
              "ISA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.3"
              },
              "items": [
                {
                  "text": "Mik 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.6.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico nari gukorera uruzabibu rwanje ntārukoreye n’igiki? Ko naziga ko ruzokwama inzabibu, n’iki catumye rwama ibijabija vy’inzabibu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.4",
            "verseOrgIds": [
              "ISA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.80.12"
              },
              "items": [
                {
                  "text": "Zab 80:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.12"
              },
              "items": [
                {
                  "text": "Hos 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero reka mbereke ivyo ngira ngirire uruzabibu rwanje: ngira nkūreh’ ururombero rwarwo, maze rwonwe ruvumburwe; kandi nsambure uruzitiro rwarwo, rucibge iyondoyondo; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.5",
            "verseOrgIds": [
              "ISA.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.23"
              },
              "items": [
                {
                  "text": "Yes 7:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ndaruririke; ntiruzotuturirwa, ntiruzorimirirwa, ariko ruzomeramw’ imikere n’amahwa; kandi nzobuza ibicu vyoye kurugwishakw imvura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.6",
            "verseOrgIds": [
              "ISA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ uruzabibu rw’Uhoraho Nyen’ ingabo ari rwo nzu ya Isirayeli, kand’ abagabo b’i Buyuda ari bo muzabibu wamuhimbara; kandi yabazigamw’ imanza zibereye arikw abasangamw’ uguhahaza: yabazigamw’ ubugororotsi arikw abasangamw’ amaborogo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.7",
            "verseOrgIds": [
              "ISA.5.7"
            ]
          }
        }
      ]
    },
