              },
              "items": [
                {
                  "text": "Yes 8:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi bazobabomboranira hejuru nk’ukw ikiyaga kibomborana: kand’ uwokwitegereza ico gihugu yobona har’ umwiza n’ivyago, kand’ umuco uzimanganijwe n’ibicu bihubikije.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.5.30",
            "verseOrgIds": [
              "ISA.5.30"
            ]
