                "loc": "AMO.6.1"
              },
              "items": [
                {
                  "text": "Am 6:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe bagore bidibamiye, ni muve hasi, mwumve ijwi ryanje; yemwe bakobga b’ibidage, ni mutegere amatwi amajambo yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.9",
            "verseOrgIds": [
              "ISA.32.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzomara imisi irenze umwaka muhagaritse imitima, yemwe mwa bidage mwe, kukw imyengo izobura, kandi nta kwimbura kuzobaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.10",
            "verseOrgIds": [
              "ISA.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hinda agashitsi, yemwe bagore bidibamiye; hagarika imitima, yemwe mwa bidage! Mwiyambure impuzu, mwīsige ubusa, mukenyere amagunira mu rukenyerero. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.11",
            "verseOrgIds": [
              "ISA.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokwishishitira bababajwe n’amatongo yabanezereza, n’imizabibu yaregeza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.12",
            "verseOrgIds": [
              "ISA.32.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.25"
              },
              "items": [
                {
                  "text": "Yes 7:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.11"
              },
              "items": [
                {
                  "text": "24:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.24.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.24"
              },
              "items": [
                {
                  "text": "Yer 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gihugu c’abantu banje hazomera amahwa n’imikēre; mbere bizomera no ku mazu yose banezererwamwo yo ku murwa w’umunezero; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.13",
            "verseOrgIds": [
              "ISA.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw ingoro izohebga, umurwa bahora bayebanganako uzoba imisaka; umusozi n’umunara w’abateramyi bizohinduka amasenga gushitsa ibihe bidashira, bizoba aho guhimbara indogoba z’inyeshamba, hazoba ubgatsi bg’imikuku; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.14",
            "verseOrgIds": [
              "ISA.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.17"
              },
              "items": [
                {
                  "text": "Yes 29:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.1"
              },
              "items": [
                {
                  "text": "35:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.28"
              },
              "items": [
                {
                  "text": "Yow 2:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "gushitsa aho Mpwemu azodusukirwako avuye hejuru, ubugaragwa bugacika itongo rimera cane, kand’ itongo ryamera cane rikitwa ishamba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.15",
            "verseOrgIds": [
              "ISA.32.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ukuroranya kuzotsindaza mu bugaragwa, n’ubugororotsi buzoba mw itongo rimera cane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.16",
            "verseOrgIds": [
              "ISA.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.3"
              },
              "items": [
                {
                  "text": "Zab 72:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.3.18"
              },
              "items": [
                {
                  "text": "Yak 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubugororotsi buzovyara amahoro, kand’ ubugororotsi buzozana ugutekereza n’ivyizigiro gushitsa ibihe bidashira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.17",
            "verseOrgIds": [
              "ISA.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abantu banje bazoba mu ngo z’amahoro, no mu mazu bahabe amarembe, no mu buruhukiro butagira inkomanzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.18",
            "verseOrgIds": [
              "ISA.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.26.5"
              },
              "items": [
                {
                  "text": "Yes 26:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.11.2"
              },
              "items": [
                {
                  "text": "Zek 11:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ urubura ruzotsinda ikibira hasi, igisagara gisangangurwe rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.19",
            "verseOrgIds": [
              "ISA.32.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.23"
              },
              "items": [
                {
                  "text": "Yes 30:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.24"
              },
              "items": [
                {
                  "text": "24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murahiriwe, yemwe ababiba mu biyaya vy’ amazi yose, mukarekura inka n’ indogoba kugenda umwagambo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.32.20",
            "verseOrgIds": [
              "ISA.32.20"
            ]
          }
        }
      ]
    }
