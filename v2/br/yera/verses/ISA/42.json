              "items": [
                {
                  "text": "Yes 48:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe nd’Uhoraho, iryo ni ryo zina ryanje; icubahiro canje sinzogiha uwundi, n’ishimwe ryanje sinzoriha ibigirwamana vy’ibibāzano. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
