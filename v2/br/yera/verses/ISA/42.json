                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzozana impumyi mu nzira zitazi, ndazirōngōre mu ndari zitari zizi, nzohindura umwiza ube umuco imbere yazo, n’ahagoramye nzohagorora. Ivyo nzobishitsa, sinzobaheba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        },
        {
