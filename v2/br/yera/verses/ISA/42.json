            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntazodendebukirwa, ntazocika intege, gushitsa ah’ azoshingira amateka mw isi; ababa ku kiyaga bazokwitega ivyagezwe vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        },
