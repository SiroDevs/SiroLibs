          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.97.7"
              },
              "items": [
                {
                  "text": "Zab 97:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.29"
              },
              "items": [
                {
                  "text": "Yes 1:29",
