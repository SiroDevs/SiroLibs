                "loc": "ISA.45.16"
              },
              "items": [
                {
                  "text": "45:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abīshimira ibishushanyo vy’ibibāzano bazosubizwa inyuma, bazotētērwa cane, bo n’ababgira ibishushanyo vyāvugutiwe mu nkero, bati Mur’ imana zacu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 42:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.17",
            "verseOrgIds": [
              "ISA.42.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 42:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa bipfamatwi ni mwumve; mwa mpumyi ni murābe kugira ngo mwitegereze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde mpumyi atar’ umushumba wanje, canke gipfamatwi nk’intumwa yanje ntuma? Ni nde mpumyi nk’ umugendanyi wanje, kand’ ahumye nk’umushumba wanje, jewe Uhoraho? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.10"
              },
              "items": [
                {
                  "text": "Yer 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abona vyinshi yamara ntiyitegereza; amatwi yiwe arazibūtse, yamara ntiyumva. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyahimbaye Uhoraho kudūza ivyagezwe no kuvyubahiriza, kubg’ ukugororoka kwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.17"
              },
              "items": [
                {
                  "text": "Yes 14:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bantu n’abantu bāsahuwe, bānyazwe inkōkōre; bose bāratezwe, bagwa mu vyobo, kandi babanyegeje mu mabohero; n’abo gucika inyagano, ata wo kubakiza; n’abo gucika inyagano, ata wo kuvuga ati Barekure. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 42:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.9"
              },
              "items": [
                {
                  "text": "Mat 13:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde muri mwebge yotegera ugutwi ivyo, agaca uruma akumva ivy’ igihe kizoza? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.23",
            "verseOrgIds": [
              "ISA.42.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 42:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yatanze aba Yakobo ngo banyagwe, kand’ Abisirayeli akabaha ababanyaga? Mbega s’Uhoraho, uwo twacumuyeko, kandi ntitwemeye kugendera mu nzira ziwe, ntitwumviye ivyagezwe vyiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.24",
            "verseOrgIds": [
              "ISA.42.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 42:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.7.9"
              },
              "items": [
                {
                  "text": "Hos 7:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye aturekurirak’ uburake bgiwe bg’inkazi n’intambara zikomeye; bikaduturira impande zose, kandi ntitwabimenya, vyaraduturiye yamara ntitwabishirak’ umutima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.25",
            "verseOrgIds": [
              "ISA.42.25"
            ]
          }
        }
