              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng’ uhumūre impumyi, ng’ usohore imbohe mw ibohero, n’abicaye mu mwiza ngo bave mu nzu y’imbohe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        },
        {
          "name": "verse",
