              "items": [
                {
                  "text": "Yes 52:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yakuriye imbere yiwe nk’ikironge, kandi nk’agashami kava mw ivu rigadutse. Ntiyar’ afise ishusho nziza cank’ igikundiro, kand’ aho twamubona ntiyar’ afise ubgiza bgotumye tumwifuza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.2",
            "verseOrgIds": [
              "ISA.53.2"
            ]
          }
        },
