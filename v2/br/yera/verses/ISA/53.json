        },
        {
          "text": "Ni nde yemeye inkuru zacu? Kand’ ukuboko kw’Uhoraho kwahishuriwe nde? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.53.1",
            "verseOrgIds": [
              "ISA.53.1"
