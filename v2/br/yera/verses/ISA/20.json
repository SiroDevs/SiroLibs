              "items": [
                {
                  "text": "Mik 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uko ni k’umwami w’i Ashuri azojana abo muri Egiputa ar’ inyagano, n’abangajwe bo muri Etiyopiya, abato n’abakuru, bazogenda bambaye ubusa batagira n’ inkweto, n’amatako yabo ar’ ubusa, bimāramāze Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
