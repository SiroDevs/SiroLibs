            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.19.24"
              },
              "items": [
                {
                  "text": "1 Sam 19:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.1.8"
              },
              "items": [
                {
                  "text": "Mik 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ico gihe ni ho Uhoraho yavugiye muri Yesaya mwene Amosi, aramubgira, ati Genda ukenyurure igunira ukenyeye mu nda, ukūre n’inkweto mu birenge vyawe. Abigenza artyo, agenda yambaye ubusa, atagira n’inkweto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.18"
              },
              "items": [
                {
                  "text": "Yes 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho aravuga, ati Nk’uk’ umusavyi wanje Yesaya amaze imyaka itatu agenda yambaye ubusa atagira n’inkweto, akabera Egiputa na Etiyopiya ikimenyetso n’imbūri; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
