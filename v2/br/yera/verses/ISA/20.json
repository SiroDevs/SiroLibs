            }
          ]
        },
        {
          "text": "Umwaka Taritani yatereyemw’ ahitwa Ashidodi, agomowe na Sarigoni umwami w’i Ashuri, akaharwanya akahatsinda, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
