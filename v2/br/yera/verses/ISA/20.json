              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bazokwihebura bamāramāre, kubga Etiyopiya bari bizigiye, no kubga Egiputa birātana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
