              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukomeze amaboko areganutse, mugumishe amavi aregarega. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.3",
            "verseOrgIds": [
              "ISA.35.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 35:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubgire abahagaritse imitima, muti Rema, nta co mutinya: rāba, Imana yanyu izozanana n’uguhōra, ni kwo kwitura kw’Imana; izoza ibakize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.4",
            "verseOrgIds": [
              "ISA.35.4"
            ]
          }
        },
