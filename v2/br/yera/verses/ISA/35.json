              "type": "text"
            }
          ]
        },
        {
          "text": "Ahagadutse n’ubgeranyange hazonezerwa, ubugaragwa buzohimbarwa, bushurike amashurwe nk’aya habaseleti. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.1",
            "verseOrgIds": [
              "ISA.35.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 35:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buzoshurika amashurwe menshi, buhimbaranwe umunezero n’indirimbo; buzohabga ubgiza bg’i Lebanoni, n’ugushaza kw’i Karumeli n’i Sharoni: bazobona ubgiza bg’Uhoraho, ugushaza kw’ Imana yacu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.35.2",
            "verseOrgIds": [
              "ISA.35.2"
            ]
          }
        }
      ]
    },
