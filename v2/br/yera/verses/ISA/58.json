                "loc": "MIC.3.8"
              },
              "items": [
                {
                  "text": "Mik 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Semerera cane, woye kwigarura; rangurura ijwi ryawe nk’inzamba, ubarire abantu banje ibicumuro vyabo, n’inzu ya Yakobo ivyaha vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.1",
            "verseOrgIds": [
              "ISA.58.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 58:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.13"
              },
              "items": [
                {
                  "text": "Yes 29:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo bandondera uko bukeye, banezererwa kumenya inzira zanje; nk’ihanga ryakora ivy’ ukugororoka, ntirireke ivyagezwe vy’ Imana yabo, ni ko bansaba ivyagezwe vyo kugororoka, bakanezererwa kwēgēra Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.2",
            "verseOrgIds": [
              "ISA.58.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 58:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.5.1+NEH.5.2+NEH.5.3+NEH.5.4+NEH.5.5+NEH.5.6+NEH.5.7+NEH.5.8+NEH.5.9+NEH.5.10+NEH.5.11+NEH.5.12"
              },
              "items": [
                {
                  "text": "Neh 5:1-12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.17"
              },
              "items": [
                {
                  "text": "Yes 60:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.3.14"
              },
              "items": [
                {
                  "text": "Mal 3:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabaza, bati Mbeg’ igituma twisonzesha, nturuhe ubibona, ni ku ki? Igituma twibabaza, nawe ukavyirengagiza, ni ku ki? Erega mbiterwa n’uko ku musi wanyu wo kwisonzesha mupfa kwikorera ivyanyu, mugakoresha nabi abakozi banyu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.3",
            "verseOrgIds": [
              "ISA.58.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 58:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba ico mwisonzeshereza n’amahāne n’ imitongano no gukubitana ibipfunsi vyo kugiriranira nabi; ereg’ ukwisonzesha kwanyu kwo mur’ iyi misi si kwo kwotuma ijwi ryanyu ryumvikana mw ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.4",
            "verseOrgIds": [
              "ISA.58.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 58:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.7.5"
              },
              "items": [
                {
                  "text": "Zek 7:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Non’ ukwisonzesha nshima, mugira ngo kumeze gurtyo? Mugira ngo n’umusi wo kwibabarizamwo, no kujondamika umutwe nk’urufunzo, no kwisasira amagunira n’umunyota? Mbeg’ ivyo ni vyo mwita kwisonzesha, n’ umusi jewe Uhoraho nnezererwa? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.5",
            "verseOrgIds": [
              "ISA.58.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 58:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ uku si kwo kwisonzesha nshima? S’ukubohora abantu ingoyi z’ukugiriranira nabi, no guhamburura imigozi abatwazwa igitugu, no kurekura impahazwa ngo zīdegemvye, mukavuna ivy’ ugutwaza igitugu vyose? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.6",
            "verseOrgIds": [
              "ISA.58.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 58:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.18.7"
              },
              "items": [
                {
                  "text": "Ezk 18:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.25.35"
              },
              "items": [
                {
                  "text": "Mat 25:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega s’ugutanga ivyo kurya vyawe ukagaburira abashonje, ukazana aboro birukanywe ukabashira mu nzu yawe? Wabona ūgenda gusa ukamwambika, ntiwirengagize mwene wanyu? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.7",
            "verseOrgIds": [
              "ISA.58.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 58:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.11.17"
              },
              "items": [
                {
                  "text": "Yob 11:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.12"
              },
              "items": [
                {
                  "text": "Yes 52:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.30.17"
              },
              "items": [
                {
                  "text": "Yer 30:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze rer’ umuco wawe uzoca utambika nk’umutwenzi, amagara yawe asubire atotahare vuba; ukugororoka kwawe kuzokuja imbere, kand’ ubgiza bganje buzoba bukwimirije. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.8",
            "verseOrgIds": [
              "ISA.58.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 58:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.6.13"
              },
              "items": [
                {
                  "text": "Imig 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ni watabaza, jewe Uhoraho nzokwitaba; ni watakamba, nzovuga, nti Ndi hano. Ni wakūra ugutwaza igitugu hagati muri wewe, no gutūngira abandi urutoke, n’ibiyāgo bibi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.9",
            "verseOrgIds": [
              "ISA.58.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 58:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ugahebera umushonji ivyo wari kurya, ugahāza impahazwa: umuco wawe uzorasira mu mwiza, kand’ umwiza wawe uzohinduka nko ku murango w’amashōka; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.10",
            "verseOrgIds": [
              "ISA.58.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 58:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.31.12"
              },
              "items": [
                {
                  "text": "Yer 31:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi jewe Uhoraho nzokwama nkurōngōra, nzohāza ubugingo bgawe mu gihe c’ikigatwa, nguhe kunonoka mu magufa yawe; kand’ uzomera nk’indimiro ikwegewemw’ umwuzi, kand’ uzoba nk’isōko y’ amazi idakama. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.11",
            "verseOrgIds": [
              "ISA.58.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 58:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.6.14"
              },
              "items": [
                {
                  "text": "Ezr 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.61.4"
              },
              "items": [
                {
                  "text": "Yes 61:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ahār’ imisaka kera hazosubira kwubakwa; bazokwubaka ku matanguriro yariho mu bindi bihe; kand’ uzokwitwa Uwica ibirengero, n’Ūsibūra inzira zija mu ngo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.12",
            "verseOrgIds": [
              "ISA.58.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 58:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.15+NEH.13.16+NEH.13.17+NEH.13.18+NEH.13.19+NEH.13.20+NEH.13.21"
              },
              "items": [
                {
                  "text": "Neh 13:15-21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.56.2"
              },
              "items": [
                {
                  "text": "Yes 56:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wakūra ikirenge cawe, ngo ntukandagire isabato, ukareka gukora ivyo wigombeye ku musi wanje wera, arik’ ukita isabato umusi w’umunezero, mber’ umusi wanje wera ukawita uw’ icubahiro, ukawubaha, ntukore ivyo ugomba ubgawe, ntiwironderere gukora ivyawe, ntiwirirwe mu bijandijandi vy’ubusa, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.13",
            "verseOrgIds": [
              "ISA.58.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 58:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.13"
              },
              "items": [
                {
                  "text": "Gus 32:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.19"
              },
              "items": [
                {
                  "text": "Yer 50:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuk’ uzonnezererwa jewe Uhoraho; nanje nzoguha kugenda ujandagira ku mpinga z’ imisozi yo mu gihugu; kandi nzogutungisha ishamvu ya sogokuruza Yakobo: kukw akanwa kanje, jewe Uhoraho, ari ko kabivuze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.58.14",
            "verseOrgIds": [
              "ISA.58.14"
            ]
          }
        }
      ]
