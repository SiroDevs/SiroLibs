                  "text": "60:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bugaragwa nzohatera ibiti vy’amasederi n’ivy’ imishita n’ivy’ imihadasi n’ivya elayo; kandi mu gahinga nzohashira ibiti vy’akajwari n’ivy’ imitidari n’ivy’ imiteyashuri bikurane; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.19",
            "verseOrgIds": [
              "ISA.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 41:20"
          },
