              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.115.8"
              },
              "items": [
                {
                  "text": "Zab 115:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.8.4"
              },
              "items": [
                {
                  "text": "1 Kor 8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba nta co murimwo, kandi n’igikorwa canyu n’ ubusa: ūbahitamwo aba abaye umuyobe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.24",
            "verseOrgIds": [
