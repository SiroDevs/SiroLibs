              "items": [
                {
                  "text": "46:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni babiserure, batubarire ibizoba: ni muvuge ivyabayeho ivy’ ari vyo, kugira ngo tuvyiyumvire, tumenye iherezo ryavyo; canke se mutwereke ibizoza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.22",
            "verseOrgIds": [
              "ISA.41.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 41:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.45.7"
              },
              "items": [
                {
                  "text": "Yes 45:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muvuge ibigiye kuzoza hanyuma kugira ngo tumenye ko mur’ imana: mupfe gukora iciza canke gukora ikibi, kugira ngo tukirābe twese, tujorerwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.23",
            "verseOrgIds": [
              "ISA.41.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
