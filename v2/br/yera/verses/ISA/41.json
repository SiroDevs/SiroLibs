              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni muzane imibūrano yanyu, ni k’Uhoraho agize; muserure inyanduruko zanyu zikomeye, ni k’Umwami wa Yakobo agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.21",
            "verseOrgIds": [
              "ISA.41.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
