                  "text": "Yer 50:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nahagurukije umuntu avuye i burārūko, kand’ araje; uwambaza izina ryanje avuye i burasirazuba: azokāta abaganza nk’ūkāta urwondo, canke nk’uk’ umubumvyi akāta ibumba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.25",
            "verseOrgIds": [
              "ISA.41.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 41:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yabivuze uhereye ubga mbere ngo tubimenye, canke ni nde yabivuze kera kugira ngo tuvuge, tut’ Ivyo n’ivy’ ukuri? N’ukuri koko nta wabivuze, n’ukuri nta wavyerekanye, n’ukuri nta wumvise amajambo yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.26",
            "verseOrgIds": [
              "ISA.41.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 41:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.9"
              },
              "items": [
                {
                  "text": "Yes 40:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe nabanje kubgira Siyoni, nti Ngabo baraje! I Yerusalemu mpatuma intumwa yo kubabgira ubutumwa bgiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.27",
            "verseOrgIds": [
              "ISA.41.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 41:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naritegereje, mbona ata wuriho; muri bo ubgabo nta n’ umujanama ariho yoshobora kunyishura n’ijambo na rimwe mbabajije. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.28",
            "verseOrgIds": [
              "ISA.41.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 41:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba bose ibikorwa vyabo nta co birimwo kandi n’ubusa gusa: ibishushanyo vyabo vyāvugutiwe mu nkero ni bga muyaga kandi n’ubusa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.29",
            "verseOrgIds": [
              "ISA.41.29"
            ]
          }
        }
