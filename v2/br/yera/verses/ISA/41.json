              },
              "items": [
                {
                  "text": "Yak 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko weho Isirayeli musavyi wanje, Yakobo uwo natoranije, ruvyaro rwa Aburahamu umukunzi wanje: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.8",
            "verseOrgIds": [
              "ISA.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "wewe uwo natoye, nkagukūra ku mpera z’isi, nkaguhamagara ng’uve ku mfuruka zayo, nkakubgira, nt’ Ur’ umusavyi wanje, naragutoranije sinagutaye; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.9",
            "verseOrgIds": [
              "ISA.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.9"
              },
              "items": [
                {
                  "text": "Yos 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.48.10"
              },
              "items": [
                {
                  "text": "Zab 48:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntutinye, kuko ndi kumwe nawe; ntukihebure, kuko nd’ Imana yawe: nzogukomeza, nzogutabara, mbere nzokuramira n’ukuboko kw’i buryo kw’ukugororoka kwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.10",
            "verseOrgIds": [
              "ISA.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ abakurakiye bose bazotētērwa bamāramāre: abagutonganya bazocika ubusa, baranduke. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.11",
            "verseOrgIds": [
              "ISA.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.37.10"
              },
              "items": [
                {
                  "text": "Zab 37:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaguhāririza uzobarondera, ubabure, kand’ abakurwanya bazocika ubusa, bakamangane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.12",
            "verseOrgIds": [
              "ISA.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko jewe Uhoraho Imana yawe nzogufata ukuboko kw’i buryo, nkubgire, nti Ntutinye, ndagutabara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.13",
            "verseOrgIds": [
              "ISA.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.14"
              },
              "items": [
                {
                  "text": "Yes 43:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.5"
              },
              "items": [
                {
                  "text": "54:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntutinye, musiba we Yakobo, namwe nkehwa z’ Abisirayeli; nzogutabara, ni k’ Uhoraho agize; kand’ Uwera w’ Abisirayeli ni we mucunguzi wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.14",
            "verseOrgIds": [
              "ISA.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.13"
              },
              "items": [
                {
                  "text": "Mik 4:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba nzoguhindura igisekuzo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.15",
            "verseOrgIds": [
              "ISA.41.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "41:15",
              "type": "text"
            },
            {
              "text": "Ico gisekuzo car’ ikintu kiremereye gikwegwa n’inka, rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Gus 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.9"
              },
              "items": [
                {
                  "text": "1 Kor 9:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " gisha, gikarishe gifise amenyo: uzohūragura imisozi uyinoze, uzohindura uturambi nk’ umuguruka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.15",
            "verseOrgIds": [
              "ISA.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.2"
              },
              "items": [
                {
                  "text": "Yer 51:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzobigosora umuyaga ubitumure, agashururu kabishwiragize: nawe uzohimbarwa n’Uhoraho, wirate Uwera w’ Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.16",
            "verseOrgIds": [
              "ISA.41.16"
            ]
          }
        },
        {
