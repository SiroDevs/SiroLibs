                "loc": "JOB.12.9"
              },
              "items": [
                {
                  "text": "Yob 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo barābe, bamenye, bitegereze, batahurire hamwe yuk’ ukuboko kw’Uhoraho ari kwo gukoze ivyo, kandi k’Uwera w’Abisirayeli ari we yabiremye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.20",
