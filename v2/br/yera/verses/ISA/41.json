              "items": [
                {
                  "text": "44:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impahazwa n’ abakene barondera amazi bakayabura, ururimi rwabo rukagwa umwumwa; jewe Uhoraho nzobishura, jewe Imana ya Isirayeli sinzobaheba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.17",
            "verseOrgIds": [
              "ISA.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzoziburura inzūzi mu mpinga z’imisozi y’uruharabuga, n’amasōko hagati mu myonga: ubugaragwa nzobuhindura ikidengeri c’amazi, n’igihugu cumye nzogihindura imbizi z’amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.41.18",
            "verseOrgIds": [
              "ISA.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 41:19"
          },
          "items": [
