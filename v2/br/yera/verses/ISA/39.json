                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Merodaki‐Baladani mwene Baladani umwami w’i Babuloni arungikira Hezekiya ivyete n’ingemurano, kuko yari yumvise ko yarwaye agakira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.1",
            "verseOrgIds": [
              "ISA.39.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.15"
              },
              "items": [
                {
                  "text": "2 Abam 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abātumwe Hezekiya abākīra neza, abereka mu nzu ah’ abīka ibintu vyiwe vy’igiciro, amafeza n’amazahabu n’imibavu n’amavuta y’igiciro kinini, no mu nzu hose ah’ abīka ivyo kurwanisha, n’ikintu cose co mu vyo atunze cariho. Nta kintu na kimwe co mu ngoro yiwe canke co mu gihugu ciwe cose Hezekiya atāberetse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.2",
            "verseOrgIds": [
              "ISA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.2",
            "verseOrgIds": [
              "ISA.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye haza uwavugishwa n’Imana Yesaya ku mwami Hezekiya, aramubaza, at’ Abo bantu bavuze iki? Kandi baje i wawe bavuye hehe? Hezekiya aramwishura, ati Baje bavuye mu gihugu ca kure i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.3",
            "verseOrgIds": [
              "ISA.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arongera aramubaza, ati Babonye ibiki mu ngoro yawe? Hezekiya aramwishura, at’ Ibiri mu ngoro yanje vyose bābibonye: nta kintu na kimwe co mu vyo ntunze ntāberetse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.4",
            "verseOrgIds": [
              "ISA.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yesaya abarira Hezekiya, ati Ni wumve ijambo ry’Uhoraho Nyen’ ingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.5",
            "verseOrgIds": [
              "ISA.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.24.13"
              },
              "items": [
                {
                  "text": "2 Abam 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.36.18"
              },
              "items": [
                {
                  "text": "2 Ngo 36:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ imisi izoza, ibiri mu ngoro yawe vyose, n’ivyo ba sogokuruza bābītse bigashitsa n’ubu, bizosahurwa bijanwe i Babuloni; nta kintu na kimwe kizosigara, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.6",
            "verseOrgIds": [
              "ISA.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.1.3"
              },
              "items": [
                {
                  "text": "Dan 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abahungu bawe uzoba wīkūriye mu nda wavyaye bazobajana, bagirwe inkone zo kuba mu ngoro y’umwami w’i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.7",
            "verseOrgIds": [
              "ISA.39.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.3.18"
              },
              "items": [
                {
                  "text": "1 Sam 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.26"
              },
              "items": [
                {
                  "text": "2 Ngo 32:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hezekiya yishura Yesaya, at’ Ijambo ry’Uhoraho uvuze ni ryiza. Yongera kuvuga, ati Kazima hagiye kuba amahoro n’umutēkāno nkiriho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.39.8",
            "verseOrgIds": [
              "ISA.39.8"
            ]
          }
        }
      ]
    }
