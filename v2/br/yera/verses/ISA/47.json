              "items": [
                {
                  "text": "Ivyah 18:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ni wumve ibi, wewe wihaye ibihimbaro, ukicara ata co winona, ukīyāga mu mutima, uti Ni jewe ndiho, nta wundi atari jewe; sinzosigara nd’ umupfakazi, kandi sinzomenya kubura abana ic’ ari co. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.8",
            "verseOrgIds": [
              "ISA.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NAM.3.4"
              },
              "items": [
                {
                  "text": "Nah 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.19"
              },
              "items": [
                {
                  "text": "Yes 51:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.29"
              },
              "items": [
                {
                  "text": "Yer 50:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyo vyompi bizokugwako umusi umwe, kubura abana no gupfakara: bizogushikako uko vyakabaye, nah’ ubupfumu bgawe bgoba bginshi bute, n’ amahezayo yawe akaba isinzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.9",
            "verseOrgIds": [
              "ISA.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko widibamiye mu bubi bgawe ata co wicura, ukavuga, uti Nta wumbona; ubgenge bgawe n’ukumenya kwawe ni vyo bikujimije; wīyāga mu mutima, uti Ni jewe ndiho, nta wundi atari jewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.10",
            "verseOrgIds": [
              "ISA.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.41"
              },
              "items": [
                {
                  "text": "Yer 51:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co kizotuma ivyago bigushikako, ntumenye amahezayo yavyo; ibara rikugweko, ntushobore kuryīkūrako, kand’ ubugesera utazi buzokuzako giturumbuka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.11",
            "verseOrgIds": [
              "ISA.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko hagararana amahezayo yawe, n’ivy’ ubupfumu bgawe uko bingana, ivyo wakobereje uhereye mu buto bgawe: namba kumbure vyogira ico bikumarira, namba kumbure vyogushoboza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.12",
            "verseOrgIds": [
              "ISA.47.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 47:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.25"
              },
              "items": [
                {
                  "text": "Yes 44:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.2"
              },
              "items": [
                {
                  "text": "Dan 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wacumukujwe n’abakugīra inama benshi; abaragurisha ijuru, n’abaragurisha inyenyeri, na bamwe bahora bakumenyesha ibigira bikubeko, uk’ ukwezi kubonetse, ni baze bagukize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.13",
            "verseOrgIds": [
              "ISA.47.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 47:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.17"
              },
              "items": [
                {
                  "text": "Yes 10:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.4.1"
              },
              "items": [
                {
                  "text": "Mal 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba bazoba nk’ibishingwe, umuriro uzobaturira; ntibazokwikiza inkomezi z’ imbeya zawo; ntuzoba amakara yo kwota, cank’ umuriro wo kwicarako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.14",
            "verseOrgIds": [
              "ISA.47.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 47:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko bizokubera, ivyo wakobereje; abādandaza nawe uhereye mu buto bgawe bazokwīgīra, umuntu wese yīgīre ahiwe; ntihazogira ūgukiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.47.15",
            "verseOrgIds": [
              "ISA.47.15"
            ]
          }
        }
      ]
    }
