                "loc": "HAB.2.8"
              },
              "items": [
                {
                  "text": "Hab 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzobona ibara, wewe unyaga kand’ utānyazwe, uryarukana kandi batākuryarutse! Ni waheza kunyaga, nawe uzonyagwa; kandi ni wamara kuryarukana, bazokuryaruka nawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.1",
            "verseOrgIds": [
              "ISA.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Uhoraho, utugirire imbabazi; ni wewe twiteze; utubere amaboko uko bukeye, mber’ utubere agakiza mu gihe c’amagorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.2",
            "verseOrgIds": [
              "ISA.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoko ahungishijwe n’ijwi ryo guhūrīra; kubgo guhaguruka kwawe amahanga arasābagiye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.3",
            "verseOrgIds": [
              "ISA.33.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.3",
            "verseOrgIds": [
              "ISA.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazovumbura iminyago mwanyaze nk’ukw inzige zivumbura, bazoyigwako nk’uk’ ubuyige bg’intōteza bugwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.4",
            "verseOrgIds": [
              "ISA.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.97.9"
              },
              "items": [
                {
                  "text": "Zab 97:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho ashizwe hejuru nk’uko yibera iyo hejuru: yuzuza i Siyoni ibiroranye n’ubugororotsi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.5",
            "verseOrgIds": [
              "ISA.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.1.7"
              },
              "items": [
                {
                  "text": "Imig 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.39.8"
              },
              "items": [
                {
                  "text": "Yes 39:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bihe vyawe hazobah’ umutēkāno, n’ agakiza k’umurengera, n’ubgenge no kumenya: kwubaha Uhoraho ni bgo butunzi bgawe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.6",
            "verseOrgIds": [
              "ISA.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.7",
            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.37"
              },
              "items": [
                {
                  "text": "2 Abam 18:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe, abahizi babo baraborogera hanze; intumwa zo gusaba impore ziriko zirarira cane. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.7",
            "verseOrgIds": [
              "ISA.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.5.6"
              },
              "items": [
                {
                  "text": "Abac 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.14+2KI.18.15+2KI.18.16+2KI.18.17"
              },
              "items": [
                {
                  "text": "2 Abam 18:14-17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzira z’iroro zirasivye, nta wuhita akiboneka; yishe isezerano, akēngēra ibisagara, kandi ntagira udusoni ku bantu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.8",
            "verseOrgIds": [
              "ISA.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu kiriganyira, kirahondobereye: Lebanoni haratēterewe, harakabiranye; Sharoni hameze nk’ ubugaragwa; Bashani na Karumeli hakoraguye amababi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.9",
            "verseOrgIds": [
              "ISA.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.12.5"
              },
              "items": [
                {
                  "text": "Zab 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho aravuga, ati Hinge mvyaguruke non’ ubu, non’ ubu ngira mpaguruke, non’ ubu ngira nishire hejuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.10",
            "verseOrgIds": [
              "ISA.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzosama inda y’umuguruka, muvyare ishingwe; impwemu zanyu ni wo muriro uzobatongora. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.11",
            "verseOrgIds": [
              "ISA.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga azoturirwa nk’uko baturira ishwagara; azomera nk’igiteme c’amahwa, kigaturirirwa mu muriro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.12",
            "verseOrgIds": [
              "ISA.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe abari kure, ni mwumve ivyo nkoze, namwe abari hafi, ni mwemere ubushobozi bganje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.13",
            "verseOrgIds": [
              "ISA.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.15"
              },
              "items": [
                {
                  "text": "Yes 66:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.12.29"
              },
              "items": [
                {
                  "text": "Heb 12:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyavyaha b’i Siyoni baratinye; agatengo gafashe giturumbuka abatubaha Imana. Muri twebge ni nde yoshobora kubana n’umuriro utongora, kandi muri twebge ni nde yoshobora kubana n’ikibengebenge kidahengeshanya? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.14",
            "verseOrgIds": [
              "ISA.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.24.4"
              },
              "items": [
                {
                  "text": "Zab 24:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.119.27"
              },
              "items": [
                {
                  "text": "119:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūgendera mu bugororotsi akavuga ibitunganye, akagaya inyungu ziva mu gahahazo, agahungisha amaboko ngo ntiyābīre ingurire, akīziba amatwi ngo ntiyumve inama yo kuvisha amaraso, agahumiriza amaso ngo ntarābe ibibi: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.15",
            "verseOrgIds": [
              "ISA.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.23"
              },
              "items": [
                {
                  "text": "Yes 30:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.25"
              },
              "items": [
                {
                  "text": "25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo ni we azoba ahataramutse hejuru, ahantu hiwe ho kwikinga hazoba igihome c’ amabuye; azohabga ivyo kurya bimutunga, kandi n’amazi ntazoyabura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.16",
            "verseOrgIds": [
              "ISA.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.5"
              },
              "items": [
                {
                  "text": "Yes 6:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaso yawe azokwitegereza umwami afise ubgiza bgiwe: azorāba igihugu kigera kure. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.17",
            "verseOrgIds": [
              "ISA.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.14"
              },
              "items": [
                {
                  "text": "2 Abam 18:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutima wawe uzokwibuka ivyatera ubgoba; ukībaza, ut’ Uwaca ibitigiri vy’ ingorore ari hehe? Uwazākīra akarāba ko zishitse ari hehe? Uwaharūra iminara ari hehe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.33.18",
            "verseOrgIds": [
              "ISA.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 33:19"
          },
