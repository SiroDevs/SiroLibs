            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzira ziwe narazibonye, kandi nzomukiza; nzomurōngōra, nzoheruka kumwirurana n’abāmuborogera. ",
          "type": "text",
          "attrs": {
