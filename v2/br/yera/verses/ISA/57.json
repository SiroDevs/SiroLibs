              "items": [
                {
                  "text": "Yer 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Icaha ciwe c’igono ni co candakije ndamukubita, ndihisha, ndaraka: yamar’ ashishikara gukikamira mu nzira ikundwa n’umutima wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.17",
            "verseOrgIds": [
              "ISA.57.17"
            ]
          }
        },
