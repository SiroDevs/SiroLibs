            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ntotongana ibihe vyose, kandi sinokwama ndatse: kukw imitima n’ubugingo naremye vyodendebukirirwa imbere yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.57.16",
            "verseOrgIds": [
              "ISA.57.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 57:17"
          },
          "items": [
