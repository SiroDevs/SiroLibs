                "loc": "ISA.36.2"
              },
              "items": [
                {
                  "text": "Yes 36:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho abarira Yesaya, ati Sohoka non’ ubu, uje gusanganira Ahazi, wewe na Sheyari‐yashubu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "7:3",
              "type": "text"
            },
            {
              "text": "Sheyari‐yashubu risobanurwa ngw Amasigarira azogaruka.",
              "type": "text"
            }
          ]
        },
        {
          "text": " umwana wawe, murahūrira ah’ umugende wo ku kidengeri co haruguru ugarukira, ku nzira yo ku kibuga c’umumesuzi; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.3",
            "verseOrgIds": [
              "ISA.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ umubarire, uti Witonde, ureme; woye gutinya, kandi nturandurwe umutima n’ivyo bishirīra bibiri bifumba, bo n’uburake bg’inkazi bga Rezini n’Abasiriya n’ubga mwene Remaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.4",
            "verseOrgIds": [
              "ISA.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasiriya n’Abefurayimu na mwene Remaliya ko baguhigiye imihigo, bakavuga, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.5",
            "verseOrgIds": [
              "ISA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "bati Ni muze tudūge dutere i Buyuda, tubakūre imitima, tuhace icuho, twiyimikire umwami hagati muri co, mwene Tabeli: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.6",
            "verseOrgIds": [
              "ISA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.10"
              },
              "items": [
                {
                  "text": "Yes 8:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ut’ Ico ni co gitumye Uhoraho Imana agize, ngw Iyo migabo ntizohama kandi ntizoshika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.7",
            "verseOrgIds": [
              "ISA.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw iremezo ry’i Siriya ari Damasiko, kand’ iremezo ry’i Damasiko ari Rezini; kand’ imyaka mirongwitandatu n’itanu itarashira Abefurayimu bazovungwavungwa, ntibabe bakiba ihanga; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.8",
            "verseOrgIds": [
              "ISA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.20.20"
              },
              "items": [
                {
                  "text": "2 Ngo 20:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ iremezo ry’Abefurayimu ni Samariya, kand’ iremezo ry’i Samariya ni mwene Remaliya. Ariko ni mwanka kwizera, n’ukuri ntimuzoshikama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
            "verseOrgIds": [
              "ISA.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.9",
