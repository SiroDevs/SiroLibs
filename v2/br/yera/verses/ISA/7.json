              "items": [
                {
                  "text": "Neh 9:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.7"
              },
              "items": [
                {
                  "text": "Yes 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho azogutēza imisi mibi, wewe n’abantu bawe n’inzu ya so, imisi itigeze kubaho, uhereye umusi Abefurayimu bātandukanye n’Abayuda: ni kwo guterwa n’ umwami w’i Ashuri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.17",
            "verseOrgIds": [
              "ISA.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi Uhoraho azohamagaza uruhwa isāzi ziri ku mpera z’inzūzi zo muri Egiputa, n’inzuki zo mu gihugu c’i Ashuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.18",
            "verseOrgIds": [
              "ISA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bizoza, vyose bizokwarara mu biyaya bisigaye ar’ imisaka, no mu masenga yo mu bitandara, no ku mahwa yose, no ku bgatsi hose.",
