              "items": [
                {
                  "text": "16:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ngoma ya Ahazi mwene Yotamu, Yotamu wa Uziya, umwami w’i Buyuda, Rezini umwami w’i Siriya na Peka mwene Remaliya umwami w’Abisirayeli badūga i Yerusalemu kuhatera, maze harabananira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.1",
            "verseOrgIds": [
              "ISA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.12"
              },
              "items": [
                {
                  "text": "Yes 8:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babūrira umuryango wa Dawidi, bat’ Abasiriya bifatanije n’Abefurayimu. Maz’ umutima wa Ahazi urahungabana, bo n’imitima y’ abantu biwe, nk’ukw ibiti vyo mu kibira bihungabanywa n’umuyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.7.2",
            "verseOrgIds": [
              "ISA.7.2"
            ]
          }
        }
      ]
    },
    {
