                "loc": "PSA.145.7"
              },
              "items": [
                {
                  "text": "Zab 145:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokwamamaza ukugira neza kw’Uhoraho n’ishimwe ryiwe, nk’ ukw ivyo Uhoraho yatugiriye vyose bingana; mvuge n’ivyiza vyinshi yagiriye inzu ya Isirayeli, nk’ukw imbabazi ziwe ziri, kandi nk’uk’ ukugira neza kwiwe kwinshi kungana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.7",
            "verseOrgIds": [
              "ISA.63.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 63:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yavuze, ati N’ukuri n’abantu banje, abana batogunga; nuko rer’ ababera Umukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.8",
            "verseOrgIds": [
              "ISA.63.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 63:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
