          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twahindutse nk’abatigeze kuganzwa nawe, nk’abatigeze kwitirirwa izina ryawe.",
          "type": "text",
          "attrs": {
