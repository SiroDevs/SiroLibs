          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bawe bera bāhaganje igihe gito gusa; abarwanizi bacu bāsiribanze ahantu hawe hēra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.18",
            "verseOrgIds": [
              "ISA.63.18"
            ]
          }
