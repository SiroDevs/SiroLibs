            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Uhoraho, n’iki gituma utuzimiza inzira zawe, ugakomantaza imitima yacu ntitukwubahe? Garuka kubg’ abasavyi bawe, imiryango y’ishamvu yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.63.17",
            "verseOrgIds": [
              "ISA.63.17"
            ]
          }
        },
        {
          "name": "verse",
