              "items": [
                {
                  "text": "Ezk 20:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.51"
              },
              "items": [
                {
                  "text": "Ivyak 7:51",
