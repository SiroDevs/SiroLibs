            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw abazoyimbura ni bo bazoyarya, banshime jewe Uhoraho, kand’ abazoyamura ni bo bazoyinywa, mu ntangaro y’ ahēra hanje.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.9",
