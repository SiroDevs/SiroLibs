              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba, Uhoraho yabariye abo ku mpera y’isi, ati Ni mubgire umukobga w’i Siyoni, muti Rāba, agakiza kawe karaje; rāba, araje azanye impēra, kand’ inyishu yiwe ir’imbere yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.11",
            "verseOrgIds": [
              "ISA.62.11"
            ]
          }
        },
