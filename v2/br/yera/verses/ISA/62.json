                {
                  "text": "1 Pet 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntuzosubira kwitwa Ntabga, n’igihugu cawe ntikizosubira kwitwa Misaka; arik’ uzokwitwa Nkundwakazi, n’igihugu cawe kizokwitwa Uwābiriwe; kuk’ Uhoraho agukundwakaje, kand’ igihugu cawe kizokwābīrwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.4",
            "verseOrgIds": [
              "ISA.62.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
