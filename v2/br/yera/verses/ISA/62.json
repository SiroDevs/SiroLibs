            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.65.19"
              },
              "items": [
                {
                  "text": "Yes 65:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uk’ umusore arongora inkumi, ni kw abakubamwo bazokurongora, ewe Yerusalemu; kandi nk’uk’ umukwe anezererwa umugeni, ni kw Imana yawe izokunezererwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.5",
            "verseOrgIds": [
              "ISA.62.5"
            ]
          }
        }
