                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi na we ntimwemere kw aruhuka, gushitsa ah’ azovyurira Yerusalemu, akahahindura ishimwe mw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.7",
            "verseOrgIds": [
              "ISA.62.7"
            ]
          }
        },
