            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubga Siyoni sinzocereza, no kubga Yerusalemu sinzoruhuka, gushitsa ah’ ugutsinda kwaho kuzoserukira nk’umuco, n’ agakiza kaho kakamera nk’itara ryaka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.1",
            "verseOrgIds": [
              "ISA.62.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
