                  "text": "Yes 61:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bazobita Ihanga ryera, Abācunguwe n’Uhoraho; kand’ uzokwitwa Ahārondewe, Umurwa utāhebge.",
