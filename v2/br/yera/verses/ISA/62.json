            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yarahije ukuboko kwiwe kw’i buryo, ukuboko kw’inkomezi ziwe, ati N’ukuri sinzokwongera guha abansi bawe amasaka yawe ngo bayarye, kand’ abanyamahanga ntibazokunywera vino wacumukuriye; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.62.8",
            "verseOrgIds": [
              "ISA.62.8"
            ]
          }
        },
