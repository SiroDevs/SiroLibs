              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "Ita 22:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.1.10"
              },
              "items": [
                {
                  "text": "Hos 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ uruvyaro rwawe rwobaye nk’umusenyi, n’abava mu nda yawe bobaye nk’umuhekeheke wawo; izina ryawe ntiryorandutse canke ngo rizimangane imbere yanje.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.19",
            "verseOrgIds": [
              "ISA.48.19"
            ]
          }
        }
