                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.12"
              },
              "items": [
                {
                  "text": "Yes 66:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.19.42"
              },
              "items": [
                {
                  "text": "Luk 19:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iy’ uba warumviye ivyagezwe vyanje, uba waragize amahoro ameze nk’ uruzi, kand’ ukugororoka kwawe kuba kwarabaye nk’imipfunda y’ ikiyaga; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.48.18",
            "verseOrgIds": [
              "ISA.48.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 48:19"
          },
          "items": [
