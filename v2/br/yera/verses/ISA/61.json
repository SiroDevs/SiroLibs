                "loc": "PSA.45.7"
              },
              "items": [
                {
                  "text": "Zab 45:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.21"
              },
              "items": [
                {
                  "text": "Yes 60:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.15.8"
              },
              "items": [
                {
                  "text": "Yoh 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo nshirireh’ abagandaye i Siyoni igitsibo mu gishingo c’umunyota, ndabahe n’amavuta y’akaneza mu gishingo c’ukugandara, n’umwambaro wo guhimbaza mu gishingo c’umutima uhondobereye; kugira ngo baze bitwe ibiti vy’ukugororoka, imyeloni yatewe n’ Uhoraho, ngo bimutere icubahiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.3",
            "verseOrgIds": [
              "ISA.61.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 61:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.58.12"
              },
              "items": [
                {
                  "text": "Yes 58:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.9.14"
              },
              "items": [
                {
                  "text": "Am 9:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bazokwubaka ahār’ imisaka kera, bahagarike ahāsanganguwe ubga mbere, kandi bazosubira kuvyura ibisagara vyāsenyutse, ivyāmaze ibihe vyinshi ar’ imisaka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.4",
            "verseOrgIds": [
              "ISA.61.4"
            ]
          }
        }
