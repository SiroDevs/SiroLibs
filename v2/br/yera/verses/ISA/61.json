            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamahanga bazohagarara ngaho babaragirire imikuku, kand’ abanyamahanga ni bo bazokora mu mirima yanyu no mu nzabibu zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.5",
            "verseOrgIds": [
              "ISA.61.5"
            ]
          }
        },
        {
