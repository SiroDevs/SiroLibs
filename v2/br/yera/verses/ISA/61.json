        },
        {
          "text": "Mpwemu w’Umwami Uhoraho ari kuri jewe, kuk’ Uhoraho yandobanuje amavuta ngo mbgire abaciye bugufi ubutumwa bgiza; yantumye gutubika imitima imenetse, no kumenyesha abarindwa ko barekuwe, n’imbohe ko zugururiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.1",
            "verseOrgIds": [
              "ISA.61.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 61:2"
          },
          "items": [
