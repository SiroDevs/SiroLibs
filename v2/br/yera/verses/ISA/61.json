              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.34.8"
              },
              "items": [
                {
                  "text": "Yes 34:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.4"
              },
              "items": [
                {
                  "text": "Mat 5:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo mmenyeshe abantu umwaka wo kwemererwamwo n’Uhoraho, n’ umusi wo kwīhōra w’Imana yacu; ngo nirure abagandaye bose, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.61.2",
            "verseOrgIds": [
              "ISA.61.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 61:3"
          },
          "items": [
