            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.44.8"
              },
              "items": [
                {
                  "text": "Yes 44:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko muzogira indirimbo nk’iyo baririmba mw ijoro ku musi mukuru wera; muzogira n’umunezero wo mu mutima nk’uw’ umuntu afise umwironge aja ku musozi w’ Uhoraho, ngw ashikīre Igitandara c’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.29",
            "verseOrgIds": [
              "ISA.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.2"
              },
              "items": [
                {
                  "text": "Yes 28:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
