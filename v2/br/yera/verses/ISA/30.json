              "items": [
                {
                  "text": "Nah 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "impwemu ziwe zimeze nk’umugezi ushēshe ugashika no mw izosi, ngo zigosoze amahanga urutaro rumara umuguruka: kand’ umujiginya uzimiza uzoba mu binyigishi vy’ amahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.28",
