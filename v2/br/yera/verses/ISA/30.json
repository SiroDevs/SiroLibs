            "sid": "ISA 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inka n’indogoba z’imikangara zirima zizorya ivyo kurya birimw’ umunyu, bigosojwe urutaro n’igitemere. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.24",
            "verseOrgIds": [
              "ISA.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku gisozi cose gishizwe hejuru no ku musozi wose muremure hazoba amasōko n’imigezi y’amazi, ku musi wo gutōtōra abantu rwose, ah’ iminara izosidukira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.25",
            "verseOrgIds": [
              "ISA.30.25"
            ]
          }
        },
