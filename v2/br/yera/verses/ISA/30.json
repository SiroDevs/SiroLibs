                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nah’ Umwami Imana azobagaburira ivyo kurya vy’amagorwa n’amazi y’amarushwa, arikw abigisha banyu ntibazoba bacihisha ukundi: amaso yanyu azobībonera; ",
          "type": "text",
          "attrs": {
