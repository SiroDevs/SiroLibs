            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.16"
              },
              "items": [
                {
                  "text": "Yes 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ikibando bāgerewe uko kimashuye kwose, ico Uhoraho abamashuza, hazovuga udushako tw’ingoma n’ inanga; kand’ azorwana na bo mu ntambara adasībiza ukuboko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.32",
            "verseOrgIds": [
              "ISA.30.32"
            ]
          }
        },
