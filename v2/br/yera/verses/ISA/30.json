            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ azorekurira imvura imbuto muzobiba mu ndimiro, kand’ imihure ivuye mu ndimiro izoba inovereye yo gutunga amagara: ico gihe imikuku yanyu izorisha ivyanya binini. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.23",
            "verseOrgIds": [
              "ISA.30.23"
            ]
          }
        },
        {
