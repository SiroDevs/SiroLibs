            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muzotitura ifeza yometse ku bishushanyo vyanyu vy’ibibāzano, n’izahabu yometse ku bishushanyo vyanyu vyavugutiwe mu nkero; muzobishibura rwose nk’ikintu gihumanye, mubibarire, muti Vaho, mugende! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.22",
