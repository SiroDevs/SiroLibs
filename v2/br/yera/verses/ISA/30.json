                  "text": "29:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Uhoraho azotuma ijwi ryiwe ry’icubahiro ryumvikana, azokwerekana ugukubita kw’ukuboko kwiwe mu bushangashirwe bg’uburake, no mu rubeya rw’umuriro utongora, no mu gusegenyuka kw’imvura n’ ikirura n’imināna y’urubura. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.30",
            "verseOrgIds": [
              "ISA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ijwi ry’Uhoraho rizotuma Abashuri bahababuka, abakubitishe urugāge rwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.30.31",
            "verseOrgIds": [
              "ISA.30.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ISA 30:32"
          },
          "items": [
