                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.1.9"
              },
              "items": [
                {
                  "text": "Hag 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HAG.2.3"
              },
              "items": [
                {
                  "text": "2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzu yacu yera nziza, iyo ba sogokuruza bacu bāguhimbarizamwo, yaraturiwe; n’ ibintu vyacu vyose vyāduhimbara vyārononekaye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 64:12"
          },
          "items": [
