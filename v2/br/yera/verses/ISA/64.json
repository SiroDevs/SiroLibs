              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.1.12"
              },
              "items": [
                {
                  "text": "Zek 1:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Uhoraho, mbeg’ uzokwiyumanganya, kandi bimeze birtyo? Upfe kwiyumya, kand’ utubabaje birengeje urugero?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
