              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.16"
              },
              "items": [
                {
                  "text": "Yes 57:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho, reka kuraka cane birenze urugero, ntiwame wibuka ibigabitanyo vyacu ibihe vyose; ni witegereze se turakwinginze, twese tur’ abantu bawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.3"
              },
              "items": [
                {
                  "text": "Neh 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.2.3"
              },
              "items": [
                {
                  "text": "2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisagara vyawe vyera vyacitse ubugaragwa, i Siyoni hacitse ubugaragwa, i Yerusalemu hacitse amatongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
