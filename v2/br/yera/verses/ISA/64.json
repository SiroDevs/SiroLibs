              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneho, Uhoraho, uri Data wa twese; tur’ ibumba, nawe ur’ umubumvyi wacu; twese tur’ igikorwa c’ intoke zawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
