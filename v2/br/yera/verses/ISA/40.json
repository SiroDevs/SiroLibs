              "items": [
                {
                  "text": "Yob 9:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni yo ivyagiye ahihese hejuru y’isi, ababa mw isi bameze nk’uduhori; ni yo igaranzura amajuru nk’impuzu y’agakangayenzi, ikayāgānura nk’ihema ryo kubamwo; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.22",
            "verseOrgIds": [
              "ISA.40.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 40:23"
          },
          "items": [
