                  "text": "Yer 10:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūbaye mworo, atoshoboye ishikanwa ringana rirtyo, yironkera igiti kitazobora, maz’ akironderera umukozi w’umuhinga wo guhagarika ico kigirwamana, ngo kigume.",
