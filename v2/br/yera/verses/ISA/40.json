                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigirwamana, umuhinga arakiyaza, umucuzi w’izahabu akacomekakw izahabu, akagicurira imigufu y’ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.19",
