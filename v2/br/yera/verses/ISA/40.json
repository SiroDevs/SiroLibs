          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.30.4"
              },
              "items": [
                {
                  "text": "Imig 30:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yigeze kugera amazi y’ikiyaga ku rushi, akageresha ijuru itambge ry’intoke, akaronka ingero yokwirwamw’ umukungugu wo kw isi, akagera imisozi ku munzane, n’uturambi ku ngero? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.12",
            "verseOrgIds": [
              "ISA.40.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 40:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.34"
              },
              "items": [
                {
                  "text": "Rom 11:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.16"
              },
              "items": [
                {
                  "text": "1 Kor 2:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yigeze kurōngōra Mpwemu w’Uhoraho, akamwigisha nk’ah’ ar’ umujanama wiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.13",
            "verseOrgIds": [
              "ISA.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.21.22"
              },
              "items": [
                {
                  "text": "Yob 21:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde Mpwemu yigeze kugīsha inama, kandi ni nde yigeze kumwigisha, akamwigisha kuroranya, akamwigisha ubgenge, akamwereka uburyo bgo gutahura? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.14",
            "verseOrgIds": [
              "ISA.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.29.5"
              },
              "items": [
                {
                  "text": "Yes 29:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ amahanga ameze nk’ ima ry’amazi riri mu mubindi, agereranywa n’umukungugu ufashe ku munzane; rāba aterura ibizinga vyo mu kiyaga nk’ah’ ar’ akantu gato k’ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.15",
