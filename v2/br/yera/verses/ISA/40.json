                "loc": "HOS.2.14"
              },
              "items": [
                {
                  "text": "Hos 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muremēshe imitima y’ab’i Yerusalemu, mubabgire musemerera yukw intambara zaho zabangurukanye, k’ umwenda w’igicumuro cabo ushize, kukw ivyaha vyabo vyose babihaniwe kabiri n’ukuboko kw’ Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.2",
            "verseOrgIds": [
              "ISA.40.2"
            ]
          }
        }
      ]
    },
