              "items": [
                {
                  "text": "Yes 52:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yewe ubarira Siyoni ubutumwa bgiza, dūga umusozi muremure; yewe ubarira Yerusalemu ubutumwa bgiza, semerera cane ushimitse; semerera, ntutinye; ubgire ibisagara vy’i Buyuda, ut’ Eh’ Imana yanyu! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.9",
            "verseOrgIds": [
              "ISA.40.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 40:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.62.11"
              },
              "items": [
                {
                  "text": "Yes 62:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.12"
              },
              "items": [
                {
                  "text": "Ivyah 22:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ Uhoraho Imana azoza afise ubushobozi, kand’ ukuboko kwiwe kuzomutwarira: rāba, azoza azanye impēra, kand’ inyishu yiwe ir’ imbere yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.10",
            "verseOrgIds": [
              "ISA.40.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 40:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.12"
              },
              "items": [
                {
                  "text": "Mat 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.15.5"
              },
              "items": [
                {
                  "text": "Luk 15:5",
