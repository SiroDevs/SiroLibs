                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.147.5"
              },
              "items": [
                {
                  "text": "147:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiwaribgabimenye? Nturavyumva? Uhoraho n’Imana ihoraho, Umuremyi w’impera z’isi; ntadendebukirwa, nta ho aruha; ubgenge bgiwe ntibuserangurika. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.28",
            "verseOrgIds": [
              "ISA.40.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 40:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we aha inkomezi abadendebukiwe, kand’ ūtagira intege amwongeramw’ inkomezi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.29",
            "verseOrgIds": [
              "ISA.40.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ISA 40:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisore yonadendebukirwa, ikaruha, n’imisore y’imikangara yokwicakw igatemba, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.30",
            "verseOrgIds": [
              "ISA.40.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ISA 40:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.103.5"
              },
              "items": [
                {
                  "text": "Zab 103:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw abīteze Uhoraho bazokwama biyubura mu nkomezi nsha; bazodūgisha amababa nk’ inkukuma,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.31",
            "verseOrgIds": [
              "ISA.40.31"
            ]
          }
        },
        {
          "name": "note",
