                "loc": "JHN.10.3"
              },
              "items": [
                {
                  "text": "Yoh 10:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.21.15"
              },
              "items": [
                {
                  "text": "21:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoragira umukuku wiwe nk’umwungere, azoterura imyagazi mu maboko, ayitware mu gikiriza, kand’ izonsa azoziyobora buhoro‐buhoro.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.11",
            "verseOrgIds": [
              "ISA.40.11"
            ]
          }
        }
      ]
