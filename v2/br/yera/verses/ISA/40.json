              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’iki gituma uvuga, yewe Yakobo, ukiganyira, yewe Isirayeli, ut’ Inzira yanje inyegejwe Uhoraho, kand’ ut’ Ivyanje Imana yanje iravyirengagiza? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.27",
            "verseOrgIds": [
              "ISA.40.27"
            ]
          }
        },
        {
          "name": "verse",
