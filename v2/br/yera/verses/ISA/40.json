              "text": "40:31",
              "type": "text"
            },
            {
              "text": "inkukuma ni yo mpungu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " biruke ntibaruhe, bagende ntibadendebukirwe.",
          "type": "text",
