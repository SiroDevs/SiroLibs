        },
        {
          "text": "Ni muhūmurize abantu banje, ni mubahūmurize, ni kw Imana yanyu igize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.1",
            "verseOrgIds": [
              "ISA.40.1"
            ]
