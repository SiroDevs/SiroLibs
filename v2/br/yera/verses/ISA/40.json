                "loc": "JOB.12.21"
              },
              "items": [
                {
                  "text": "Yob 12:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni yo ihindura abaganwa ubusa; ikamanganya abacamanza bo mw isi, bakaba nk’akarēre kagaragara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.23",
            "verseOrgIds": [
              "ISA.40.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 40:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.83.13"
              },
              "items": [
                {
                  "text": "Zab 83:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bābaye bagiteragirwa, bābaye bakibibga, igishitsi cabo cābaye kigishinga imizi hasi, irabahūha, barakabirana, agashururu kabazingazinga nk’ibishingwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.24",
            "verseOrgIds": [
              "ISA.40.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ISA 40:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mwongereranya na nde twongana? ni k’Uwera abajije. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.25",
            "verseOrgIds": [
              "ISA.40.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 40:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwunamure amaso yanyu murābe hejuru, murābe uwaremye izo nyenyeri uw’ ari we, asohora ingabo zazo mu bitigiri: azihamagara zose mu mazina; kubg’ ububasha bg’ubushobozi bgiwe, no kubg’ inkomezi ziwe nyinshi, nta n’imwe ihara.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.26",
            "verseOrgIds": [
              "ISA.40.26"
            ]
          }
        }
      ]
    },
