              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.5"
              },
              "items": [
                {
                  "text": "Luk 3:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.3.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwonga wose uzokwuzuzwa, n’umusozi wose n’akarambi bizoringanizwa; ahār’ udutumba hazotega, uduhogoro ducike ikiyaya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.4",
            "verseOrgIds": [
              "ISA.40.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 40:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ubgiza bg’Uhoraho buzohishurwa, kand’ abafise umubiri bose bazobubonera rimwe, kukw akanwa k’Uhoraho ari ko kabivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.40.5",
            "verseOrgIds": [
              "ISA.40.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 40:6"
          },
