              "items": [
                {
                  "text": "Yer 50:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beli irarundutse, Nebo irubamye; ibishushanyo vyazo biremētswe ingamiya n’inka; bimwe mwarerura mushogamanga bicitse umutwaro ugenda uravuna inka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.1",
            "verseOrgIds": [
              "ISA.46.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 46:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo mana zirubamye zirundukiye hamwe; ntizashoboye kurokora uwo mutwaro, ariko na zo ubgazo zagiye ar’ inyagano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.2",
            "verseOrgIds": [
              "ISA.46.2"
            ]
          }
        }
      ]
    },
    {
