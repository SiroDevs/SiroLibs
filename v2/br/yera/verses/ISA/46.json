              "items": [
                {
                  "text": "Heb 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpēra kw itanguriro nkavuga ivy’ iherezo, ngahēra no mu bihe vya kera nkavuga ibitaraba; nkavuga nt’ Imigabo yanje izohama, kand’ ivyo nzogomba vyose nzobishitsa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.10",
            "verseOrgIds": [
              "ISA.46.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 46:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.23.19"
              },
              "items": [
                {
                  "text": "Guh 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.2"
              },
              "items": [
                {
                  "text": "Yes 41:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzohamagara igisīga caromoye kive i burasirazuba, ni co muntu afise imigabo yanje, ava mu gihugu ca kure. Narabivuze; no kubishitsa nzobishitsa; narabigabiye, no kubikora nzobikora. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.11",
            "verseOrgIds": [
              "ISA.46.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 46:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni munyumve, yemwe ab’ imitima ikomantaye, abari kure y’ukugororoka: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.12",
            "verseOrgIds": [
              "ISA.46.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 46:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.85.9"
              },
              "items": [
                {
                  "text": "Zab 85:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.51.5"
              },
              "items": [
                {
                  "text": "Yes 51:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.32"
              },
              "items": [
                {
                  "text": "Yow 2:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nīgije hafi ukugororoka kwanje, ntikuzoba kure; n’agakiza kanje ntikazotebagana; kandi nzoshira ako gakiza i Siyoni kubga Isirayeli, ni we cubahiro canje.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.46.13",
            "verseOrgIds": [
              "ISA.46.13"
            ]
          }
