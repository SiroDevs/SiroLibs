                  "text": "Zek 9:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbūri yo kuri Tiro. Boroga, yemwe māto y’i Tarushishi: kukw i Tiro hageseye, bigatuma ata mazu akiriho, ata n’aho gutaha; izo nkuru bazibgiwe zivuye mu gihugu c’i Kupuro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.1",
            "verseOrgIds": [
              "ISA.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mujorerwe, mwa baba mu kizinga co mu kiyaga, mwa badandaza b’i Sidoni, mwahora muca mu kiyaga, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.2",
            "verseOrgIds": [
              "ISA.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.18"
              },
              "items": [
                {
                  "text": "Yer 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.27.3+EZK.27.4+EZK.27.5+EZK.27.6+EZK.27.7+EZK.27.8+EZK.27.9+EZK.27.10+EZK.27.11+EZK.27.12+EZK.27.13+EZK.27.14+EZK.27.15+EZK.27.16+EZK.27.17+EZK.27.18+EZK.27.19+EZK.27.20+EZK.27.21+EZK.27.22+EZK.27.23"
              },
              "items": [
                {
                  "text": "Ezk 27:3-23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku mazi menshi; inyungu zanyu zar’ impeke zivuye kuri Shihori, n’ivyimburwa vyo kuri Nili; mwabaye abadandaza b’amahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.3",
            "verseOrgIds": [
              "ISA.23.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Sidoni māramāra; kukw ikiyaga kivuze, igihome co ku kiyaga kiravuze, kiti Sinaramutswe, sinavyaye, kandi sinonkeje abahungu, sinareze n’abakobga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.4",
            "verseOrgIds": [
              "ISA.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkuru ni yashika muri Egiputa bazobabazwa cane n’izo nkuru zivuye i Tiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.5",
            "verseOrgIds": [
              "ISA.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mujabuke muje i Tarushishi; muboroge, mwa baba mu kizinga co mu kiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.6",
            "verseOrgIds": [
              "ISA.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ iki ni ca gisagara canyu c’umunezero, camyeh’ uhereye imisi ya kera cane, cagendesha amaguru kure kugerērayo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.7",
            "verseOrgIds": [
              "ISA.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.2.12"
              },
              "items": [
                {
                  "text": "Yes 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yagabiye kugirira Tiro ivyo, kand’ ar’ igisagara cambika ibitsibo, abadandaza baho bakaba abahambaye, n’abahanjo baho bakaba ar’ abanyacubahiro mw isi? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.8",
            "verseOrgIds": [
              "ISA.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Nyen’ ingabo ni we yabigabiye, kugira ngw akengereze ubgibone bg’ icubahiro cose, kandi ngw agayishe abanyacubahiro bose bo mw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.9",
            "verseOrgIds": [
              "ISA.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sendanisha mu gihugu cawe nk’uko Nili rusendanisha, wa mukobga w’i Tarushishi, kukw ata kikikubujije. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.10",
            "verseOrgIds": [
              "ISA.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yabānguye ukuboko hejuru y’ikiyaga, anyiganyiza ibihugu vy’abami; Uhoraho agera ivy’ i Kanani ngo bakomvomvore ibihome vyaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.11",
            "verseOrgIds": [
              "ISA.23.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravuga, ati Ntugisubira kunezerwa, wa nkumi y’i Sidoni yononekaye; va hasi ujabuke uje i Kupuro, kandi n’iyo na ho ntuzoharonka uburuhukiro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.12",
            "verseOrgIds": [
              "ISA.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni murābe igihugu c’Abakaludaya: ubgo bgoko ntibukiriho; Abashuri bahahinduye ah’ ibikōko vyo mu bugaragwa. Bashinga ivyo būririrako, basambura ingoro zaho; bahaca amatongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.13",
            "verseOrgIds": [
              "ISA.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.23.1"
              },
              "items": [
                {
                  "text": "Yes 23:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Boroga, mwa māto y’i Tarushishi: kukw igihome canyu gisanganguwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.14",
            "verseOrgIds": [
              "ISA.23.14"
            ]
          }
        }
      ]
    },
    {
