              "ISA.23.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.11"
              },
              "items": [
                {
                  "text": "Yer 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kur’ uwo musi i Tiro hazokwibagirana imyaka mirongwirindwi, ihwanye n’imisi umwami umwe yomara ku ngoma; iyo myaka mirongwirindwi ni yashira, ibizoba kuri Tiro bizomera nk’ivyo mu kavyino ka maraya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.15",
            "verseOrgIds": [
              "ISA.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abira inanga ugendagende mu gisagara, wewe maraya wari waribagiranye; ucurarange neza, uvyine utuvyino twinshi kugira ngo wibukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.16",
            "verseOrgIds": [
              "ISA.23.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.1"
              },
              "items": [
                {
                  "text": "Ivyah 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.17.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw iyo myaka mirongwirindwi ni yashira Uhoraho azogendera i Tiro, hasubire ku mpēra y’ubumaraya bgaho, hasambane n’ibihugu vy’ abami bose bo mw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.17",
            "verseOrgIds": [
              "ISA.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyungu n’impēra vyaho bizoba ivyera k’Uhoraho; ntibizobīkwa kandi ntibizoshirwa ukwavyo, kukw inyungu zaho zizoba iz’ abahora imbere y’Uhoraho, kugira ngo barye bahāge, baronke n’imyambaro myiza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.23.18",
            "verseOrgIds": [
              "ISA.23.18"
            ]
          }
        }
      ]
    }
