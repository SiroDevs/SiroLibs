                "loc": "ROM.9.20"
              },
              "items": [
                {
                  "text": "Rom 9:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe bupfu buri hano! Mbeg’ umubumvyi mumuhwanya n’ibumba, ngw ikintu cabumbge gihakane uwakibumvye, kiti Ntiyambumvye; cank’ ikintu caremwe kigahakana uwakiremye, kiti Nta bgenge agira? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.16",
            "verseOrgIds": [
              "ISA.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntihasigaye akanya gato cane, Lebanoni hagacika itongo rimera cane, kand’ itongo ryamera cane rikitwa ishamba? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.17",
            "verseOrgIds": [
              "ISA.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.35.5"
              },
              "items": [
                {
                  "text": "Yes 35:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.11.5"
              },
              "items": [
                {
                  "text": "Mat 11:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi ibipfamatwi bizokwumva amajambo yo mu gitabo, n’amaso y’impumyi azoca umwiza n’umuzitanya abone. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.18",
            "verseOrgIds": [
              "ISA.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.3.12"
              },
              "items": [
                {
                  "text": "Zef 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.3"
              },
              "items": [
                {
                  "text": "Mat 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abaciye bugufi na bo bazogwiza umunezero banezererwa Uhoraho, n’abakene bo mu bantu bazohimbarwa n’Uwera w’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.19",
            "verseOrgIds": [
              "ISA.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.22"
              },
              "items": [
                {
                  "text": "Yes 28:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umuntu w’agaterabgoba atituwe, n’umucokoranyi aheze, kand’ abatambira kugabitanya bose barahonnye, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.10"
              },
              "items": [
                {
                  "text": "Am 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.5.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni bo bacumuza umuntu mw ijambo, bagatega umutego ūhanūrira mw ishikiro ry’igisagara, bakazibiranya umugororotsi n’amagambo y’ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        },
        {
