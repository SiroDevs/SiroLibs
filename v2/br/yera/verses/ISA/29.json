                  "text": "Ita 12:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rer’ Uhoraho, ari we yacunguye Aburahamu, uku ni kw avuze ku vy’inzu ya Yakobo, ati Yakobo ntazokwongera gutētērwa, kandi mu maso hiwe ntihazosubira kubgerabgera. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
