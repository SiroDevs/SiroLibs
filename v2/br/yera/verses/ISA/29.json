                  "text": "Yes 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.21"
              },
              "items": [
                {
                  "text": "60:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.2.10"
              },
              "items": [
                {
                  "text": "Ef 2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ubgiwe n’abana biwe ni babona ivyo amaboko yanje akorera hagati muri bo, bazokwemera izina ryanje ko ryera; mbere bazokwemera Uwera wa Yakobo ko nera, bahindire agashitsi jewe Imana y’ Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
