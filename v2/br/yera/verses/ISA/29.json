              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ngira nkore igikorwa c’igitangaza mur’ aba bantu, mbere n’igikorwa gitangaje c’akumiza: ubgenge bg’abanyabgenge babo buzoherengetera, n’ ubuhanga bg’abahanga babo buzokamangana.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.14",
            "verseOrgIds": [
