          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abazimira mu mitima bazoca ubgenge, n’abidodomba bazokwemera kwigishwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.24",
            "verseOrgIds": [
              "ISA.29.24"
            ]
