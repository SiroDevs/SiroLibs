        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banza muhagarare, mujorerwe; mwihume amaso, muhume; muborerwe mutanyoye vino; mudandabagirane, bitavuye ku biboreza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.9",
            "verseOrgIds": [
              "ISA.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.10"
              },
              "items": [
                {
                  "text": "Yes 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.8"
              },
              "items": [
                {
                  "text": "Rom 11:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ Uhoraho abasutsekw impwemu y’uruhuni, agahuma amaso yanyu, ni yo bavugishwa banyu, agapfuka n’imitwe yanyu, ni yo bamenyi banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.10",
            "verseOrgIds": [
              "ISA.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukwerekwa kwose kwabahindukiye nk’ amajambo yo mu gitabo kimatanishijwe ishashara, iyo bagihaye umuntu azi gusoma, bat’ Enda se soma iki: akabishura, ati Sinshobora, kuko kimatanijwe; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.11",
            "verseOrgIds": [
              "ISA.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze bagaha ico gitabo ūtazi gusoma, bat’ Enda se soma iki: akabishura, ati Ko ntazi gusoma.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.12",
            "verseOrgIds": [
              "ISA.29.12"
            ]
          }
        }
      ]
    },
