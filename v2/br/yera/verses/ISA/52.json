                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko mutazovayo mwihuta, canke ngo mugende nk’abahunga: kuk’ Uhoraho azobaja imbere; Imana y’Abisirayeli izobīmiriza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.12",
            "verseOrgIds": [
              "ISA.52.12"
            ]
          }
        }
