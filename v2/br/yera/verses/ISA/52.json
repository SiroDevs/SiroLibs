            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ ibirenge vy’ūzanye inkuru nziza ni vyiza ku misozi, akamamaza ivy’ amahoro, akazana inkuru nziza z’ivyiza, akamamaza ivy’ agakiza, akabarira Siyoni, at’ Imana yawe iri ku ngoma! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.7",
            "verseOrgIds": [
              "ISA.52.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
