              "items": [
                {
                  "text": "Zab 98:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.98.4"
