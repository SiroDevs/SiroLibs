              "items": [
                {
                  "text": "2 Kor 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mugende, ni mugende, muveyo; ntimugakore ku kintu gihumanya na kimwe; muve hagati yaho; mwitunganye, yemwe abashorezi b’imbombovu z’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.11",
            "verseOrgIds": [
              "ISA.52.11"
            ]
          }
        },
        {
