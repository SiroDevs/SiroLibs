                {
                  "text": "1 Yoh 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijwi ry’abashibamyi bawe! Bashize hejuru bavugiriza impundu hamwe; bazovyibonera imbonankubone aho Uhoraho azogaruka i Siyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.8",
            "verseOrgIds": [
              "ISA.52.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
