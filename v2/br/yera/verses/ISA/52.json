              "items": [
                {
                  "text": "Luk 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni muturike munezerwe, muririmbire hamwe, yemwe misaka y’i Yerusalemu: kuk’ Uhoraho aremesheje abantu biwe, acunguye Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.9",
            "verseOrgIds": [
              "ISA.52.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 52:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho akumye impuzu ku kuboko kwiwe kwera mu maso y’amahanga yose, kand’ impera z’isi zose zizobona agakiza k’Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.10",
            "verseOrgIds": [
              "ISA.52.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 52:11"
