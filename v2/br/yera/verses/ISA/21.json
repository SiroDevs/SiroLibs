            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.25"
              },
              "items": [
                {
                  "text": "Ita 37:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbūri yo kuri Arabiya. Yewe wa gugu ry’Abadedani, mw ishamba ryo muri Arabiya ni ho muzorāra. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.13",
            "verseOrgIds": [
              "ISA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwishwe n’inyota bamuzaniye amazi, ababa mu gihugu c’i Tema basanganije izo mpunzi ivyo kurya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.14",
            "verseOrgIds": [
              "ISA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko bāriko barahunga inkota, inkota zisokōwe, n’imiheto ifoye, n’ivyago vy’intambara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.15",
            "verseOrgIds": [
              "ISA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.60.7"
              },
              "items": [
                {
                  "text": "Yes 60:7",
