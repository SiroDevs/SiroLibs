                  "text": "Ezk 35:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbūri yo kuri Duma. Harih’ ūmpamagara ar’ i Seyiri, ati Yewe mushibamyi, ijoro rigeze hehe? Yewe mushibamyi, ijoro rigeze hehe? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.11",
            "verseOrgIds": [
              "ISA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mushibamyi aramwishura, ati Bugira buce, kandi bgongere bgire: ni mwagomba kubaza, mubaze; muhindukire muze.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.12",
            "verseOrgIds": [
              "ISA.21.12"
            ]
          }
        }
      ]
    },
