              "items": [
                {
                  "text": "Ivyah 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.18.2"
              },
              "items": [
                {
                  "text": "18:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "non’ ehe haje umuce w’ingabo zigendera ku mafarasi bagenda ari babiri‐babiri. Arongera aravuga, ati Babuloni harakomvomvowe, harakomvomvowe; n’ibishushanyo bibājwe vyose vy’ibigirwamana vyaho bihindikiraniye hasi bivunaguritse. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.9",
            "verseOrgIds": [
              "ISA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.33"
              },
              "items": [
                {
                  "text": "Yer 51:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.3"
              },
              "items": [
                {
                  "text": "Am 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe wa muhūre wanje, ewe mpeke zo ku mbuga yanje! Ivyo numvise bivuye k’Uhoraho Nyen’ ingabo, Imana y’Abisirayeli, ni vyo mbabariye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.21.10",
            "verseOrgIds": [
              "ISA.21.10"
            ]
          }
        }
      ]
    },
