                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe bikōko mwese vyo mw ishamba, ni muze mutabagure, namwe bikōko vyose vyo mu kibira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.9",
            "verseOrgIds": [
