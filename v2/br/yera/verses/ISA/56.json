                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Nzozishirira icibutso mu ngoro yanje no mu rugo rwanje, ndazihe n’izina riruta kugira abahungu n’abakobga; nzoziha izina ritazoshira, ritazokūrwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.5",
            "verseOrgIds": [
              "ISA.56.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 56:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abanyamahanga bīfatanya nanje Uhoraho kugira ngo bankorere, bakunde izina ryanje, babe abasavyi banje, umuntu wese aziririza isabato ntayikēngēre, akabangiriza isezerano ryanje, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.6",
            "verseOrgIds": [
              "ISA.56.6"
            ]
          }
        },
        {
