              },
              "items": [
                {
                  "text": "Yer 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abashibamyi biwe n’impumyi, bose nta co bazi; bose ni nk’imbga z’ibiyingiyingi, zitazi gukuga; bararavūta, bararyama, bakunda gusinzira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.10",
            "verseOrgIds": [
              "ISA.56.10"
            ]
          }
        },
        {
