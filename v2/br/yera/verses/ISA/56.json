              "items": [
                {
                  "text": "2 Sam 18:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.12"
              },
              "items": [
                {
                  "text": "Yoh 1:12",
