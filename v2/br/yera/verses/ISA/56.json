            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "abo na bo nzobashikana ku musozi wanje wera, mbanezereze mu ngoro yanje yo gusengeramwo; ibimazi vyabo vyo kwoswa n’ivyo gukererwa bizokwemerwa ku gicaniro canje: kukw ingoro yanje izokwitwa inzu yo gusengerwamwo n’amahanga yose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.7",
            "verseOrgIds": [
              "ISA.56.7"
            ]
          }
        },
        {
