            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Imana, umwe akoraniriza hamwe abāri birukanywe bo mu Bisirayeli, aravuze, ati Nzokwongera kumukoraniriza abandi, ukūye abiwe bāri bamaze gukoranywa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.56.8",
            "verseOrgIds": [
              "ISA.56.8"
            ]
          }
        }
