            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araheza aravuga, at’ Iki ni co kigira kibamenyeshe yukw Imana nzima iri muri mwebge, kandi yukw itazobura kwirukana Abanyakanani imbere yanyu, bo n’ Abaheti n’Abahiwi n’Abaferizi n’Abagirugashi n’Abamori n’Abayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.10",
            "verseOrgIds": [
              "JOS.3.10"
            ]
          }
        },
