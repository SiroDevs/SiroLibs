            "caller": "#"
          },
          "items": [
            {
              "text": "3:4",
              "type": "text"
            },
            {
              "text": "Mu Giheburayo handitswe, ngw Intambge ibihumbi biriri z’ukuboko uciriye mu nkokora.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ntimuze muyēgēre. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        },
