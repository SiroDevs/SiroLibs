                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo mumenye inzira mukwiye kujana, kuko mutigeze guca mur’ iyi nzira. Mugabo, hagati yanyu na yo haze hasigare ikirere c’intambuko igihumbi;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        },
        {
