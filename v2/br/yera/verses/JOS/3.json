            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ni murobanure abantu cumi na babiri mu miryango y’Abisirayeli, mu muryango wose havemw’ umuntu umwe‐umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.12",
            "verseOrgIds": [
              "JOS.3.12"
            ]
          }
        },
