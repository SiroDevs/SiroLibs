          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe rāba, isandugu y’isezerano ry’Uhoraho Nyen’ isi yose igira ibītangire imbere mu kuja muri Yorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.11",
            "verseOrgIds": [
              "JOS.3.11"
            ]
          }
        },
