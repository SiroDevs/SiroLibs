              "items": [
                {
                  "text": "Yos 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ubarire abaherezi bareruye isandugu y’isezerano, uti Ni mwashika ah’ amazi ya Yorodani agarukira, muyashōreremw’ ibirenge, muhagararemwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
