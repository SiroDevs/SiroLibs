              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosuwa abarira abantu, ati Ni mwiyeze, kukw ejo Uhoraho azokora ibitangaza muri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa araheza abarira abaherezi, ati Ni murerure isandugu y’ isezerano, mwītangire imbere y’ abantu mu kujabuka. Nuko barerura iyo sandugu, bītangira imbere y’abantu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.6",
            "verseOrgIds": [
              "JOS.3.6"
            ]
