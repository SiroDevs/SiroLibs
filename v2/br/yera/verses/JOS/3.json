              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa abarira Abisirayeli, ati Ni mwigire hano, mwumve amajambo y’Uhoraho Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
