        },
        {
          "text": "babarira abantu, bati Ni mwabona isandugu y’isezerano ry’Uhoraho Imana yanyu ireruwe n’abaherezi ari bo Balewi, muze muce muhaguruka muve aho muri, muyikurikire, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.3",
            "verseOrgIds": [
              "JOS.3.3"
            ]
          }
        },
