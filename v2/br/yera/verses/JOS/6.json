                {
                  "text": "1 Abam 16:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Yosuwa aca amahani abantu, aravuga, ati Ni hagira umuntu ahaguruka, akazokwubaka iki gisagara c’i Yeriko, aravumwe imbere y’Uhoraho. Igihe azokwubaka itanguriro ryaho azobura umwana wiwe w’imfura, kand’ igihe azotera ibikingi vy’amarembo yaho azobura umwana wiwe w’ umuhererezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.6.26",
            "verseOrgIds": [
              "JOS.6.26"
            ]
          }
        }
