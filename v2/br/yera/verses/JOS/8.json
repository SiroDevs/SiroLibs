            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.8+EXO.17.9+EXO.17.10+EXO.17.11+EXO.17.12+EXO.17.13+EXO.17.14+EXO.17.15"
              },
              "items": [
                {
                  "text": "Kuv 17:8-15",
