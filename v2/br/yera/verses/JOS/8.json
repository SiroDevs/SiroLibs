                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Yosuwa, ati Ntutinye, kandi nturanduke umutima; jana ingabo zose, uhaguruke, utere i Hayi: rāba, ngabuye umwami waho mu maboko yawe, bo n’abantu biwe n’igisagara ciwe n’igihugu ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.1",
            "verseOrgIds": [
              "JOS.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.20.14"
              },
              "items": [
                {
                  "text": "Gus 20:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.21"
              },
              "items": [
                {
                  "text": "Yos 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.27"
              },
              "items": [
                {
                  "text": "8:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uz’ ugire Hayi n’umwami waho nk’uko wagiriye Yeriko n’umwami waho; mugabo ivyo muzosahura vyose n’inka zaho, muze muvyitwarire bibe iminyago yanyu. Kandi muze muce igico hirya y’ ico gisagara.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.2",
            "verseOrgIds": [
              "JOS.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa arahaguruka, bo n’ingabo zose, ngo baje gutera i Hayi: maz’ atoranya abantu ibihumbi mirongwitatu b’abahizi, abarungika mw ijoro. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.3",
            "verseOrgIds": [
              "JOS.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira, ati Murumva: muje kubunda hirya y’ico gisagara; ntimukije kure cane, kandi mwese mube mwiteguye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.4",
            "verseOrgIds": [
              "JOS.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.4"
              },
              "items": [
                {
                  "text": "Yos 7:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje n’ abantu turi kumwe bose tuzokwēgereza igisagara: maze ni badushwabadukira nk’ubga mbere, tuzoca twīgira nk’ababahunze; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.5",
            "verseOrgIds": [
              "JOS.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.16"
              },
              "items": [
                {
                  "text": "Yos 8:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bo bazoca badukurikira, tubahende, tubavane hafi y’igisagara, bagire ngo turabahunze nk’ubga mbere. Uko ni ko tuzogenda dusa n’ababahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.6",
            "verseOrgIds": [
              "JOS.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze namwe muze muheze muvyuke aho mubunze mu gico, mutere ico gisagara, kuk’ Uhoraho Imana yanyu azoba akigabuye mu maboko yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.7",
            "verseOrgIds": [
              "JOS.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ni mwamara kukivyagira, muze mugiturire, nk’ukw ijambo ry’Uhoraho ryavuze. N’ivyo, ivyo mbageze. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.8",
            "verseOrgIds": [
              "JOS.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa arabarungika; baja aho baja kubunda, baguma hagati ya Beteli na Hayi, ahahera i burengerazuba bga Hayi; ariko Yosuwa we, iryo joro arāra mu ngabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.9",
            "verseOrgIds": [
              "JOS.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa ahenga kare mu gatondo akoranya ingabo, adūgana n’abakuru b’Abisirayeli, azigiye imbere, baja i Hayi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.10",
            "verseOrgIds": [
              "JOS.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo ngabo zose zari kumwe na we ziradūga, zishika hafi y’ico gisagara aharābana na co, zisagaza ku ruhande rwaco rw’i burārūko; kandi hār’ umwonga hagati yabo n’i Hayi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.11",
            "verseOrgIds": [
              "JOS.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ atoranya abantu nk’ibihumbi bitanu, abarungika kuja kubunda hagati y’i Beteli n’i Hayi, i burengerazuba bg’ico gisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.12",
            "verseOrgIds": [
              "JOS.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko bāciye abantu intēko: itsitsi ry’ingabo risigara i burārūko bg’ico gisagara, abagiye kubunda bakaja i burengerazuba bgaco; ariko Yosuwa we, iryo joro arāra mur’ uwo mwonga.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.13",
            "verseOrgIds": [
              "JOS.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.13",
            "verseOrgIds": [
              "JOS.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami w’i Hayi abibonye, akorokana kare n’abo mur’ ico gisagara, bihutira gushwabadukira Abisirayeli, umwami n’ abantu biwe bose, ngo babasange ku kamanuko kaja mu kiyaya, babasōbōre; ariko ntiyar’ azi ko har’ abābunze hirya y’ico gisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.14",
            "verseOrgIds": [
              "JOS.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa n’Abisirayeli bose bīgira nk’abaneshejwe imbere yabo, bahunga bajanye inzira ija mu bugaragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.15",
            "verseOrgIds": [
              "JOS.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.6"
              },
              "items": [
                {
                  "text": "Yos 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni kw abo mur’ ico gisagara bose bāciye bīvuta ngo babakōndōrere inyuma; kandi bakiriko barakōndōrera inyuma ya Yosuwa, arabahenda, abavana hafi y’ico gisagara. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.16",
            "verseOrgIds": [
              "JOS.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihasigara umugabo n’umwe i Hayi cank’ i Beteli, ataje kwirukana Abisirayeli; basiga igisagara cuguruwe, babakōndōrera inyuma.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.17",
            "verseOrgIds": [
              "JOS.8.17"
            ]
          }
        }
      ]
    },
