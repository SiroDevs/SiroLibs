              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.21.23"
              },
              "items": [
                {
                  "text": "Gus 21:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.7.26"
              },
              "items": [
                {
                  "text": "Yos 7:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.10.26"
              },
              "items": [
                {
                  "text": "10:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we umwami w’i Hayi amumanika ku giti gushitsa ku mugoroba; maze ku kirengazuba Yosuwa abarira abamanura umuvyimba wiwe ku giti, bawuterera imbere y’irembo ry’igisagara, bawurundakw ikirundo kinini c’amabuye; kiracariho na bugingo n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.29",
            "verseOrgIds": [
              "JOS.8.29"
            ]
          }
        }
      ]
