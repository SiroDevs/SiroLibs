        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.2+DEU.27.3+DEU.27.4"
              },
              "items": [
                {
                  "text": "Gus 27:2-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze yandikira imbere y’Abisirayeli ivyagezwe vya Mose ku mabuye, nk’uko Mose yari yaravyanditse. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
