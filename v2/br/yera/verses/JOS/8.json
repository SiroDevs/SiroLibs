              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosuwa yubakira Uhoraho Imana y’Abisirayeli igicaniro ku musozi Ebalu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk’uko Mose umusavyi w’Uhoraho yabariye Abisirayeli, nk’uko vyanditswe mu gitabo c’ivyagezwe vya Mose, igicaniro c’amabuye atabājwe, atigeze gukozwakw icuma; bagitangirakw ibimazi boshereje Uhoraho, batanga n’ibimazi vy’ ishimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
