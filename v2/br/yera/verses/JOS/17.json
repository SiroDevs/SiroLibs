              "items": [
                {
                  "text": "1 Ngo 7:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abamanase ibisagara bāhāwe mu bg’Abisakari no mu bg’Abasheri ni vy’ ibi: Beti‐sheyani na Ibuleyamu n’ababa i Dori n’ababa i Endori, n’ababa i Tanaki n’ababa i Megido, bo n’udusagara tugenda tuhakūkira; iyo ni yo misozi itatu ihagaze. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.11",
            "verseOrgIds": [
              "JOS.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.27"
              },
              "items": [
                {
                  "text": "Abac 1:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.1.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo, Abamanase ntibashoboye kwirukana ben’ ivyo bisagara, kukw Abanyakanani bāgataye kuva mur’ ico gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.12",
            "verseOrgIds": [
              "JOS.17.12"
            ]
          }
        },
        {
