        },
        {
          "text": "Ariko Selofehadi mwene Heferi, Heferi wa Gileyadi, Gileyadi wa Makiri, Makiri wa Manase, ntiyari yaravyaye abahungu, atar’ abakobga gusa; aya ni yo mazina yabo: Makila na Nowa na Hogila na Miluka na Tirusa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.3",
            "verseOrgIds": [
              "JOS.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 17:4"
          },
          "items": [
