        },
        {
          "text": "Maz’ ubupfindo bgerekana ishamvu y’umuryango wa Manase, ari we mfura ya Yosefu; imfura ya Manase yari Makiri, se wa Gileyadi; Makiri uwo, ni we yahawe i Gileyadi n’i Bashani, kuko yar’ umuhizi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.1",
            "verseOrgIds": [
              "JOS.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubupfindo bgerekana n’amashamvu ya bene Manase bandi, nk’ukw amazu yabo ari, ni bo ba Abiyezeri n’aba Heleki n’aba Asiriyeli n’aba Shekemu n’aba Heferi n’aba Shemida; abo ni bo bahungu ba Manase mwene Yosefu, nk’ukw amazu yabo ari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.2",
            "verseOrgIds": [
              "JOS.17.2"
            ]
          }
        }
      ]
    },
