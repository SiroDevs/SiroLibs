              "attrs": {
                "loc": "1KI.9.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Abisirayeli bamaze guhama, bashinga Abanyakanani ibikebere, ntibabirukana ngo babaherengeteze.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.13",
            "verseOrgIds": [
              "JOS.17.13"
            ]
          }
        }
