              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.13"
              },
              "items": [
                {
                  "text": "Gus 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa arabishura, ati Ko mur’ umuryango munini, ni mudūge muje mu kibira, mugiteme mwiyagurire mu gihugu c’Abaferizi n’Abarefa, asangw’ umugamba w’Abefurayimu wābāgiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.15",
            "verseOrgIds": [
              "JOS.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
