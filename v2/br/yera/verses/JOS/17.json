                  "text": "Yos 16:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ umuryango wa Yosefu babaza Yosuwa, bati N’iki catumye uduhesha ubupfindo igisate kimwe gusa kuba ishamvu yacu, kandi tur’ umuryango munini, kuk’ Uhoraho yaduhaye umugisha kugeza ubu? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.17.14",
            "verseOrgIds": [
              "JOS.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 17:15"
          },
          "items": [
