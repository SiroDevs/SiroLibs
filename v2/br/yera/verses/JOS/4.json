              "items": [
                {
                  "text": "Yos 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi Uhoraho akuza Yosuwa imbere y’Abisirayeli bose, baramwubaha imisi yose yamaze akiriho, nk’uko bubaha Mose.",
          "type": "text",
          "attrs": {
