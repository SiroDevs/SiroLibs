            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngw az’ abe ikimenyamenya muri mwebge. Hanyuma mu bihe bizoza, abana banyu ni babaza, bat’ Aya mabuye yerekana iki? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.6",
            "verseOrgIds": [
              "JOS.4.6"
            ]
          }
        },
