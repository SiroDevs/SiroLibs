          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingabo zabo zari nk’ibihumbi mirongwine, zītwaje ibirwanishwa, ziteguye kurwana, zica imbere y’Uhoraho mu kiyaya c’i Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.13",
            "verseOrgIds": [
              "JOS.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
