            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa ahamagaza ba bagabo ukw ar’ icumi na babiri yarobanuye mu Bisirayeli, umwe‐umwe mu miryango yose; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.4",
            "verseOrgIds": [
              "JOS.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababarira, ati Ni muje imbere y’ isandugu y’Uhoraho Imana yanyu muri Yorodani, umuntu wese yāndūre ibuye, muyashire ku rutugu, nk’ukw igitigiri c’imiryango y’ Abisirayeli kingana; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.5",
            "verseOrgIds": [
              "JOS.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
