              "items": [
                {
                  "text": "Yos 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muze mubishure, muti N’ukw amazi ya Yorodani yīmiriwe, akitandukaniriza imbere y’isandugu y’isezerano ry’ Uhoraho; mut’ Igihe yarikw irajabuka Yorodani, amazi yarwo yarīmiriwe; muti Kand’ aya mabuye yabereyeho kuba icibutso c’Abisirayeli gushitsa ibihe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.4.7",
            "verseOrgIds": [
              "JOS.4.7"
            ]
          }
        }
