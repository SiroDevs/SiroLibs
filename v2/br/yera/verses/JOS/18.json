            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ikoraniro ryose ry’Abisirayeli bakoranira i Shilo, bahashinga ihema ry’ibonaniro; kand’ igihugu cari kimaze gukōndōka.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.1",
            "verseOrgIds": [
              "JOS.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu Bisirayeli hari hagisigaye imiryango ndwi itarahabga amashamvu yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.2",
            "verseOrgIds": [
              "JOS.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.18.9"
              },
              "items": [
                {
                  "text": "Abac 18:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosuwa abaza Abisirayeli, ati Muzogeza hehe kugira urwangara rwo kutinjira igihugu ngo mucegukire, ar’ ico Uhoraho Imana ya ba sogokuruza yabahaye? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.3",
            "verseOrgIds": [
              "JOS.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda ni mwitoranirize abantu batatu‐batatu mu muryango wose; nanje ndabatume banyuranganye igihugu, bandike uko gisa, n’ingene cogabanganywamw’ amashamvu yabo; ni baheza bagaruke iyo ndi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.4",
            "verseOrgIds": [
              "JOS.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.1"
              },
              "items": [
                {
                  "text": "Yos 15:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.1"
              },
              "items": [
                {
                  "text": "16:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baze bakigaburemw’ imigabane ndwi; Abayuda bazoguma mu mugabane wabo i bumanuko, n’aba Yosefu bagume mu wabo i burārūko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.5",
            "verseOrgIds": [
              "JOS.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.14.2"
              },
              "items": [
                {
                  "text": "Yos 14:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ati Muze mwandike ico gihugu mu migabane ndwi; maz’ ivyo mwanditse mubinzanire hano, nanje nzokibagabanganisha ubupfindo ngaha nyene imbere y’Uhoraho Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.6",
            "verseOrgIds": [
              "JOS.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.32.33"
              },
              "items": [
                {
                  "text": "Guh 32:33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.13.33"
              },
              "items": [
                {
                  "text": "Yos 13:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo, Abalewi bo, nta mugabane bafise muri mwebge: kuba abaherezi b’Uhoraho ni yo shamvu yabo; na bo Abagadi n’Abareyubeni n’ab’ igihimba c’umuryango wa Manase bamaze guhabga amashamvu yabo hakurya ya Yorodani i burasirazuba, ni ho Mose umusavyi w’Uhoraho yabahaye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.7",
            "verseOrgIds": [
              "JOS.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bantu bīkoze ngo bagende kwandika ico gihugu uko gisa, Yosuwa arababarira, ati Ni mugende, munyuranganye ico gihugu cose, mwandike uko gisa, muheze mugaruke iyo ndi, nanje nzokibagabanganisha ubupfindo imbere y’Uhoraho ngaha nyene i Shilo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.8",
            "verseOrgIds": [
              "JOS.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.8",
            "verseOrgIds": [
              "JOS.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bantu baragenda, banyuranganya ico gihugu, bandika mu gitabo uko gisa, n’ibisagara vyaco vyose, bakigabanyamw’ imigabane ndwi; baraheza bagaruka iyo Yosuwa ari, aho bashagaje i Shilo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.9",
            "verseOrgIds": [
              "JOS.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.11.23"
              },
              "items": [
                {
                  "text": "Yos 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.12.7"
              },
              "items": [
                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa abapfindira ubupfindo imbere y’Uhoraho i Shilo; agabanganya Abisirayeli ico gihugu, nk’ukw imigabane yabo iri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.10",
            "verseOrgIds": [
              "JOS.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bapfindiye ubupfindo Ababenyamini, nk’ukw amazu yabo ari, ishamvu yabo bgerekanye yari hagati y’iy’ Abayuda n’iy’ Abayosefu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.11",
            "verseOrgIds": [
              "JOS.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.16.1+JOS.16.2+JOS.16.3"
              },
              "items": [
                {
                  "text": "Yos 16:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubibe rwabo rw’i burārūko rwāhēra kuri Yorodani, rukadūga ku mpinga y’umusozi ur’ i burārūko bg’i Yeriko, rukadūga mu mugamba rwerekeye i burengerazuba, rukagarukira mu bugaragwa bg’i Beti‐aveni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.12",
            "verseOrgIds": [
              "JOS.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ruvuye aho rukagenda rugashika i Luzi, ari ho i Beteli, ku mpinga yaho ahahera i bumanuko; rugaheza rukamanuka, rukagenda rubangikanye n’umusozi uhera i bumanuko bg’i Beti‐horoni ho hepfo, rugashika i Ataroti‐adari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.13",
            "verseOrgIds": [
              "JOS.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.9"
              },
              "items": [
                {
                  "text": "Yos 15:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.60"
              },
              "items": [
                {
                  "text": "60",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urwo rubibe rugaheza rugakevya, rukagenda rubangikanye n’i burengerazuba rwerekeye i bumanuko, ruvuye kuri wa musozi uhera i bumanuko bg’i Beti‐horoni, rukagarukira i Kiriyati‐bayali, ari ho Kiriyati‐yeyarimu, igisagara c’ Abayuda; urwo ni rwo rwar’ urubibe rw’i burengerazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.14",
            "verseOrgIds": [
              "JOS.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.15.5+JOS.15.6+JOS.15.7+JOS.15.8+JOS.15.9"
              },
              "items": [
                {
                  "text": "Yos 15:5-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubibe rw’i bumanuko rwāhēra kw iherezo ry’i Kiriyati‐yeyarimu, rukagenda rwerekeye i burengerazuba, rukarinda rushika kw iriba ry’i Nefutowa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.15",
            "verseOrgIds": [
              "JOS.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urwo rubibe rugaheza rukamanuka ku mucāmo w’umusozi uhanamiye umwonga wa mwene Hinomu, ni ho umwonga wa Refayimu wahēra, ku ruhande rw’i burārūko; rugaheza rukamanukana uwo mwonga nyene wa Hinomu, ahahera i bumanuko bg’ umucāmo w’umusozi w’Abayebusi, rukamanuka rukarinda rushika ahitwa Eni‐rogeli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.16",
            "verseOrgIds": [
              "JOS.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "rugaheza rugakevya, rukagenda rwerekeye i burārūko, rugashika i Eni‐shemeshi; rukavudukayo rugashika i Geliloti, aharābana n’inzira idūga Adumimu, rukamanuka rugashika kw ibuye rya Bohani mwene Reyubeni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.17",
            "verseOrgIds": [
              "JOS.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "rugakomeza rukagenda rubangikanye n’ ikiyaya Araba ahahera i burārūko, rugaheza rukamanuka muri Araba nyene, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.18",
            "verseOrgIds": [
              "JOS.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "rugakomeza rugashika ku mucāmo w’i Beti‐hogula ahahera i burārūko, rukagarukira ah’ Ikiyaga c’Umunyu gitaye ikirimi ahahera i burārūko nyene, aho Yorodani rushikira muri co. Urwo ni rwo rubibe rw’i bumanuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.19",
            "verseOrgIds": [
              "JOS.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yorodani ni rwo rwar’ urubibe rwaho rw’i burasirazuba. Iyo ni yo shamvu y’Ababenyamini, nk’ukw imbibe zaho ziri impande zose, nk’ukw amazu yabo ari.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.18.20",
            "verseOrgIds": [
              "JOS.18.20"
            ]
          }
        }
      ]
