              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Mose yahaye umuryango w’Abagadi ishamvu, nk’ukw amazu yabo ari. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.24",
            "verseOrgIds": [
              "JOS.13.24"
            ]
