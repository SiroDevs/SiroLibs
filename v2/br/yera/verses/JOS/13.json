            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Yosuwa yar’ ashaje, ageze mu zabukuru; nuk’ Uhoraho aramubarira, at’ Eh’ urashaje, ugeze mu zabukuru; ariko haracasigaye ibihugu vyinshi mutaregukira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.1",
            "verseOrgIds": [
              "JOS.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
