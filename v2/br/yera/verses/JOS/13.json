              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibisagara vyose vya Sihoni umwami w’Abamori yatwara i Heshiboni, no kugeza ku rubibe rw’Abamoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.10",
