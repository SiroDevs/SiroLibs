            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’igihugu cose ca Ogi umwami w’i Bashani, yaganziriza ahitwa Ashitaroti n’ahitwa Edireyi; uwo ni we yar’ agasigarira k’Abarefa; abo ni bo Mose yanesheje, arabasohora. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.12",
            "verseOrgIds": [
              "JOS.13.12"
            ]
          }
        },
        {
