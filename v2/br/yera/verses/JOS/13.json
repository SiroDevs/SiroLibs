              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Heshiboni n’ibisagara vyose vyo mu kiyaya bihakūkira, n’i Diboni n’i Bamoti‐bayali, n’i Beti‐bayali‐meyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.17",
            "verseOrgIds": [
              "JOS.13.17"
            ]
          }
        },
