                  "text": "1 Ngo 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu cabo cāhēra i Mahanayimu, n’i Bashani hose, igihugu cose ca Ogi umwami w’i Bashani, n’ibisagara vyose vya Yayiri vy’i Bashani nyene, vyose na vyose vyari mirongwitandatu; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
