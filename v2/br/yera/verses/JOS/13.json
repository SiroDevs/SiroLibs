            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu cabo cāhēra i Yazeri, n’ibisagara vyose vy’i Gileyadi, n’igihimba c’igihugu c’Abamoni gushitsa kuri Aroweri aharābana n’i Raba, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.25",
            "verseOrgIds": [
              "JOS.13.25"
            ]
          }
        },
