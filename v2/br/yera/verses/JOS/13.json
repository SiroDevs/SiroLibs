                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.2.18"
              },
              "items": [
                {
                  "text": "Yer 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uhēreye ku ruzi Shihori rurābana na Egiputa, gushitsa ku rubibe rw’i Ekuroni ahahera i burārūko, ahavugwa kw ar’ ah’ Abanyakanani: kand’ abaganwa batanu b’Abafilisitiya n’aba: uw’i Gaza, n’uw’i Ashidodi, n’uw’i Ashikeloni, n’uw’i Gati, n’uw’i Ekuroni; bo n’igihugu c’Abavimu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.3",
            "verseOrgIds": [
              "JOS.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahahera i bumanuko; bo n’igihugu cose c’ Abanyakanani, n’i Meyara h’Abasidoni, ugashitsa kuri Afeka ku rubibe rw’Abamori; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.4",
            "verseOrgIds": [
              "JOS.13.4"
            ]
          }
        },
        {
