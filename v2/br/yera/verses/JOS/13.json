            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ni we yahaye umuryango w’Abareyubeni ishamvu, nk’ ukw amazu yabo ari. ",
          "type": "text",
          "attrs": {
