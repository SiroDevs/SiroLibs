          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ni yo shamvu y’Abagadi, nk’ukw amazu yabo ari, ukw ibisagara vyaho biri, bo n’imihana yaho.",
          "type": "text",
