            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rer’ ivyo bihugu ubigabanganye imiryango cenda, bo na ca gihimba c’Abamanase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.7",
            "verseOrgIds": [
