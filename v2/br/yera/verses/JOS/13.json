          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Beti‐peyori, n’ agahanamo ka Pisiga, n’i Beti‐yeshimoti, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.20",
            "verseOrgIds": [
              "JOS.13.20"
            ]
          }
        },
        {
