                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uhereye kuri Aroweri ho ku mucāmo hejuru y’umwonga wo kuri Arunoni, no ku gisagara kiri hagati mur’ uwo mwonga nyene, n’ikiyaya cose c’i Medeba, ugashitsa i Diboni; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.9",
            "verseOrgIds": [
              "JOS.13.9"
            ]
