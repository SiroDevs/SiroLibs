                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "no guhēra i Heshiboni ugashitsa i Ramati‐Misipa n’i Betonimu, no guhēra i Mahanayimu ugashitsa ku rubibe rw’i Debira; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.26",
            "verseOrgIds": [
              "JOS.13.26"
            ]
          }
        },
