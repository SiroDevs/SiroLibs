            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bo n’igihugu c’Abagebali, n’i Lebanoni hose aherekeye i burasirazuba, uhereye i Bayali‐gadi musi y’umusozi Herumoni, ugashitsa ahafata i Hamati; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.5",
            "verseOrgIds": [
              "JOS.13.5"
            ]
          }
