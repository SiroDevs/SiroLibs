          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamar’ Abisirayeli bo ntibirukanye Abageshuri cank’ Abanyamayaka; arikw Abageshuri n’Abanyamayaka baciye babana n’Abisirayeli kugeza na bugingo n’ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.13",
            "verseOrgIds": [
              "JOS.13.13"
            ]
          }
        },
