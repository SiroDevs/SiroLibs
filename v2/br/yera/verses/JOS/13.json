            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikindi gihimba c’Abamanase, bo n’Abareyubeni n’Abagadi, bāri bamaze guhabga ishamvu yabo hakurya ya Yorodani ahahera i burasirazuba, nk’uko Mose umusavyi w’Uhoraho yabahaye; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.8",
            "verseOrgIds": [
              "JOS.13.8"
            ]
          }
        },
