            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umuryango w’Abalewi wo nta shamvu Mose yabahaye; ibimazi vyashikaniwe Uhoraho Imana y’ Abisirayeli bigatōngōrwa n’umuriro, ni vyo vyar’ ishamvu yabo, nk’uk’ Uhoraho yamubariye.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.14",
            "verseOrgIds": [
              "JOS.13.14"
            ]
