                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’i Gileyadi, n’ igihugu c’Abageshuri n’ic’ Abanyamayaka, n’umusozi wose w’i Herumoni, n’i Bashani hose gushitsa i Saleka; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.11",
            "verseOrgIds": [
              "JOS.13.11"
            ]
          }
        },
