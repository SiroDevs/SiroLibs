                "loc": "JDG.3.1"
              },
              "items": [
                {
                  "text": "Abac 3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo bihugu bisigaye: igihugu cose c’Abafilisitiya, n’ic’ Abageshuri cose, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.2",
            "verseOrgIds": [
              "JOS.13.2"
            ]
          }
        },
