            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hakurya ya Yorodani i burasirazuba bg’i Yeriko batoranyay’ i Beseri mu bugaragwa bgo mu kiyaya, mu bg’ umuryango w’Abareyubeni, n’i Ramoti i Gileyadi, mu bg’umuryango w’Abagadi, n’i Golani i Bashani, mu bg’umuryango w’ Abamanase. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.8",
            "verseOrgIds": [
              "JOS.20.8"
            ]
