            "sid": "JOS 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uti Kugira ng’ umukoracumu yishe umuntu atabigize ibigirankana, atavyitumye, ahungireyo; uti Ni vyo bizobabera ubuhungiro bgo guhunga ūhōra uwishwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.3",
            "verseOrgIds": [
              "JOS.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
