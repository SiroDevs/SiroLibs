            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umukoracumu ni yahungira mu gisagara kimwe mur’ ivyo, az’ ahagarare kw irembo ry’ico gisagara, adōndere abakuru baho ivyiwe; na bo baze bace bamushikana imbere muri co, bamuhe ah’ aba, abe muri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.4",
            "verseOrgIds": [
              "JOS.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ūhōra uwishwe ni yamukurikira, ntibaze bamuhe uwo mukoracumu, kuk’ uwo yishe yamwishe atavyitumye, adasanzwe amwanka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.5",
            "verseOrgIds": [
              "JOS.20.5"
            ]
          }
        },
        {
          "name": "verse",
