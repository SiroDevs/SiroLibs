        },
        {
          "text": "ati Barira Abisirayeli, uti Mwirobanurire vya bisagara vy’ ubuhungiro, ut’ Ivyo yababariye atumye Mose; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.20.2",
            "verseOrgIds": [
