            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Uhoraho abarira Yosuwa, ati Wisaturire amabuye akarishe bga mbugita, usubizeh’ ugukebga mu Bisirayeli ubga kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.2",
            "verseOrgIds": [
              "JOS.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa asatuza amabuye akarishe bga mbugita, akebeshereza Abisirayeli ku musozi Araloti. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.3",
            "verseOrgIds": [
              "JOS.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
