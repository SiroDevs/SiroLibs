                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.1.39"
              },
              "items": [
                {
                  "text": "Gus 1:39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana babo, abo yashubije mu kirenge cabo, ni bo Yosuwa yakebesheje, kuko bataribgakebge; inyanduruko n’uko batākebewe mu nzira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.7",
            "verseOrgIds": [
              "JOS.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bose bamaze kubakeba baguma ngaho nyene aho bari bashagaje, kugeza bakize. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.8",
            "verseOrgIds": [
              "JOS.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Yosuwa, at’ Uyu musi mbakūyekw agakēngērwe Abanyegiputa bābakēngereye, ndagatembagaje. Ni co catumye aho hantu hitwa Gilugali",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:9",
              "type": "text"
            },
            {
              "text": "Gilugali hasobanurwa ngo Gutembagaza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na bugingo n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.9",
            "verseOrgIds": [
              "JOS.5.9"
            ]
          }
        }
      ]
    },
