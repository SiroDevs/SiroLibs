            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw Abisirayeli bari bamaze imyaka mirongwine bagendagenda mu bugaragwa, kugeza ah’ abahizi bose b’iryo hanga bavuye muri Egiputa bāherengetereye, kuko batumviye Uhoraho. Kand’ Uhoraho yari yarabarahiye kw atazokunda ko babona igihugu yarahiye ba sekuruza babo kw azokibaha, ni co gihugu gitemba amata n’ubūki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.6",
            "verseOrgIds": [
              "JOS.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.31"
              },
              "items": [
                {
                  "text": "Guh 14:31",
