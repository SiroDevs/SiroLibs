              },
              "items": [
                {
                  "text": "Heb 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyanduruko Yosuwa abakebesha n’iyi: n’ukw abagabo bose b’abahizi bari bavuye muri Egiputa bari baraguye mu nzira, mu bugaragwa, bamaze kuva muri Egiputa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.4",
            "verseOrgIds": [
              "JOS.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw abantu bose bavuyeyo bari barakebge, arikw abāvukiye mu nzira bose mu bugaragwa, bamaze kuva muri Egiputa, bo ntibaribgakebge; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.5",
            "verseOrgIds": [
              "JOS.5.5"
            ]
          }
        },
