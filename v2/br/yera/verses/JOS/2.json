        },
        {
          "text": "Tuvyumvise, imitima yacu yaciye ituvamwo, nta muntu n’umwe yar’ agisigaranye umutima mu nda kubganyu: kuk’ Uhoraho Imana yanyu ari we Mana iri hejuru mw ijuru no hasi kw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.11",
            "verseOrgIds": [
              "JOS.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 2:12"
          },
