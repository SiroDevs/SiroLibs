            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ba bandi baragenda, baja kubakurikira mu nzira ija kuri Yorodani, ku majabukiro yarwo; bamaze kurenga irembo ry’igisagara, baca barugarira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.7",
            "verseOrgIds": [
              "JOS.2.7"
            ]
          }
        }
