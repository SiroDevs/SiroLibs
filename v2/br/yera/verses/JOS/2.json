                  "text": "Yos 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero ndabinginze, ni mundahire Uhoraho yuko muzogirira neza ab’ inzu ya data, nk’uko nanje ndabagiriye neza; mumpe ikimenyamenya c’ ukuri, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.12",
            "verseOrgIds": [
              "JOS.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
