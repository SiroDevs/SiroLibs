                  "text": "Yos 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni watuvuga, iyo ndahiro uturahije ntizodufata. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.20",
            "verseOrgIds": [
              "JOS.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Biraba nk’uko muvuze. Araheza arabasezera, baragenda. Maz’ apfundika ako kagozi gasa n’agahama kw idirisha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.21",
            "verseOrgIds": [
              "JOS.2.21"
            ]
          }
        }
