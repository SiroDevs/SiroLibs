          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "yuko muzorokora data na mama, na basaza banje na barumuna banje n’ababo bose, mukadukiza ntidupfe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.2.13",
            "verseOrgIds": [
              "JOS.2.13"
            ]
          }
        },
