          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abo bantu bompi baragaruka, bamanuka iyo misozi, barajabuka bashikīra Yosuwa mwene Nuni, bamudōndera ivyababayeko vyose. ",
          "type": "text",
          "attrs": {
