              },
              "items": [
                {
                  "text": "2 Sam 21:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda tubagire durtya: tubareke bībēreho, twoye kwihamagarira uburake kubga ya ndahiro twabarahiye: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "dupfe kubareka, ariko tubagire abashenyi n’abavomyi b’ ikoraniro ryose, nk’uko twababgiye. Uko ni kw abo bakuru bāvuze.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        }
