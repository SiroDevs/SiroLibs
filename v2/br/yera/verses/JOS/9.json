              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosuwa arabahamagaza, arababaza, ati N’iki catumye muduhenda, mukavuga yuko mur’ aba kure, kandi mur’ abo ngaha nyene muri twebge? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.22",
            "verseOrgIds": [
              "JOS.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero muravumwe, ntimuzobura kwama mur’ abaja, mube abashenyi n’abavomyi b’inzu y’Imana yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
