        },
        {
          "text": "Maz’ abami bose bo hakuno ya Yorodani, bo mu mugamba waho, n’abo mu misozi iciye bugufi, n’abo ku kiyaga kinini, aharābana n’i Lebanoni, Abaheti n’ Abamori n’Abanyakanani n’Abaferizi n’Abahiwi n’Abayebusi bavyumvise, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.1",
            "verseOrgIds": [
              "JOS.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "barifatanya bahūza umutima, ngo baje kurwanya Yosuwa n’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.2",
            "verseOrgIds": [
              "JOS.9.2"
            ]
          }
        }
      ]
