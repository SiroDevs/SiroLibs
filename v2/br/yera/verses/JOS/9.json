              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abo bakuru babarira ishengero ryose, bati Twabarahiye Uhoraho Imana y’Abisirayeli, none ntitwoshobora kubakakaza. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "verse",
