                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bishura Yosuwa, bat’ Erega twebge abasavyi bawe bātubariye inkuru y’imvaho yuk’ Uhoraho Imana yawe yabariye Mose umusavyi wayo kw azobaha iki gihugu cose, no kuzorandura bene co; ni co catumye dutinyirira amagara yacu kubganyu, tugakora durtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rāba, turi mu maboko yawe: utugire uk’ ugomba, nk’uko wumva bikubangukiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa abagirira nk’uko yavuze, arabakiza, abakūra mu maboko y’Abisirayeli, ntibābica. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.5"
              },
              "items": [
                {
                  "text": "Gus 12:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uyo musi abagira abashenyi n’abavomyi b’iryo shengero n’ ab’ igicaniro c’Uhoraho, ahantu Uhoraho azotoranya ko kihaba. Kandi ni ko bagikora na bugingo n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
