                "loc": "JOS.17.7"
              },
              "items": [
                {
                  "text": "Yos 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku ruhande rw’i burengerazuba rwagarukira i Mikimetati ahahera i burārūko; rugaheza rugakebereza ahahera i burasirazuba, rugaca i Tanati‐shilo, rugaca i burasirazuba bg’i Yanowa; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.6",
            "verseOrgIds": [
              "JOS.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruvuye i Yanowa rukamanuka rugaca i Ataroti n’i Nara, rugashika i Yeriko, rukagarukira kuri Yorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.7",
            "verseOrgIds": [
              "JOS.16.7"
            ]
          }
        },
        {
