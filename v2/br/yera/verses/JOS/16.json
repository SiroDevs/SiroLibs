            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe n’ibisagara bāsobanuriwe mw ishamvu y’Abamanase, ibisagara vyose n’imihana ibikūkira. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.9",
            "verseOrgIds": [
              "JOS.16.9"
            ]
          }
