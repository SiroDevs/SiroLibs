              "type": "text"
            }
          ]
        },
        {
          "text": "Ishamvu aba Yosefu baheshejwe n’ubupfindo yahēra kuri Yorodani aharābana n’i Yeriko, ku ruhande rw’i burasirazuba ku mazi ya Yeriko nyene; urubibe rwabo rwajana mu bugaragwa ruvuye i Yeriko, rugaca mu mugamba rugashika i Beteli; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.1",
            "verseOrgIds": [
              "JOS.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.19"
              },
              "items": [
                {
                  "text": "Ita 28:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.18.13"
              },
              "items": [
                {
                  "text": "Yos 18:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rukava i Beteli rugashika i Luzi, rugakomeza inzira rugashika ku rubibe rw’Abaruki ahitwa Ataroti; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.2",
            "verseOrgIds": [
              "JOS.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "rukamanuka rwerekeye i burengerazuba, rurābana n’urubibe rw’Abayafuleti, rukarinda rushika ku rubibe rw’i Beti‐horoni ho hepfo, bo n’i Gezeri, rukagarukira ku kiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.3",
            "verseOrgIds": [
              "JOS.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho ni ho aba Yosefu bāronse ishamvu, ari bo Bamanase n’Abefurayimu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.4",
            "verseOrgIds": [
              "JOS.16.4"
            ]
          }
        }
      ]
    },
