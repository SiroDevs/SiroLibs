              "type": "text"
            }
          ]
        },
        {
          "text": "Urubibe rw’Abefurayimu, nk’ ukw amazu yabo ari, rwagenda rurtya: urugabano rw’ishamvu yabo rw’ahahera i burasirazuba rwahēra kuri Ataroti‐adara rugashika i Beti‐horoni ho haruguru: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.16.5",
            "verseOrgIds": [
              "JOS.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
