            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Imana ntitebeje isezerano ryayo, uko bamwe biyumvira kw iritevya. Ariko yihanganira mwebge, ntigomba ko hagira abahona, arikw igomba ko bose bihana. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.9",
            "verseOrgIds": [
              "2PE.3.9"
            ]
