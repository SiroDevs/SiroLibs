            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyatumye isi ya kera amazi ayirengera, iratikira: ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.6",
            "verseOrgIds": [
              "2PE.3.6"
            ]
          }
        },
