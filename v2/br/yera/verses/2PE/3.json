            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "babaza, bat’ Isezerano ryo kuza kwiwe riri hehe se? Kuk’ uhereye aho ba sogokuruza basinziririye, vyose bihora uko vyamye, uhereye ku kuremwa kw’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.4",
