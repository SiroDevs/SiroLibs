        {
          "text": "Kuko biyobagiza ibigirankana yuko kera hār’ amajuru, n’isi yakūwe mu mazi n’ijambo ry’Imana, rikayirema mu mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.5",
            "verseOrgIds": [
              "2PE.3.5"
            ]
