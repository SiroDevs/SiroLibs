          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw amajuru y’ubu, bo n’isi, iryo jambo ryabibīkiye kuzosha, kugira ngo birindwe gushitsa ku musi w’amateka, wo gutikira kw’abatubaha Imana.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.7",
            "verseOrgIds": [
              "2PE.3.7"
            ]
