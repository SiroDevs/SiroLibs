            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "irya mbere mukwiye kumenya n’uko mu misi y’iherezo hazoza abacokoranyi bacokorana, bakurikira ukwifuza kwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.3.3",
