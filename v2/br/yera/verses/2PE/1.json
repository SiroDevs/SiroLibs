      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2PE 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petero, umugurano wa Yesu Kristo kand’ intumwa yiwe, ndabandikiye mwebge abāhawe ukwizera kw’akaburarugero kungana n’ukwacu, muguheshejwe n’ukugororoka kwa Yesu Kristo, ni we Mana yacu n’Umukiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.1",
            "verseOrgIds": [
              "2PE.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2PE 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JUD.1.2"
              },
              "items": [
                {
                  "text": "Yud 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuntu n’amahoro bigwire muri mwebge, mubiheshwa no kumenya Imana neza na Yesu Umwami wacu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.2",
            "verseOrgIds": [
              "2PE.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
