              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Umwami Uhoraho agize, at’ Ehe nzohigūra na Farawo umwami wa Egiputa, kandi nzomuvuna amaboko yompi, ukugikomeye bo n’ukwari kwavunitse; kandi nzotuma inkota yari mu kuboko kwiwe imwiyaka ikoroke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.22",
            "verseOrgIds": [
              "EZK.30.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 30:23"
