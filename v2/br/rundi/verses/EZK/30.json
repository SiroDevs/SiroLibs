        },
        {
          "text": "Ijambo ry’Uhoraho ryongera kunzako, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.1",
            "verseOrgIds": [
              "EZK.30.1"
            ]
          }
        },
