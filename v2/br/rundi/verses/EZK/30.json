                "loc": "JOL.2.1"
              },
              "items": [
                {
                  "text": "Yow 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mwana w’umuntu, vuga ubūre, ut’ Uku ni k’Umwami Uhoraho agize, ati Ni muboroge, muti Yō! Ewe wa musi wo kuzobona ibara! ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.2",
            "verseOrgIds": [
              "EZK.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koko uwo musi uri hafi, mber’ umusi w’Uhoraho uri hafi, n’umusi wo gufurangana; igihe c’abanyamahanga kizoba kigeze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.3",
            "verseOrgIds": [
              "EZK.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.8"
              },
              "items": [
                {
                  "text": "Ezk 29:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkota izorekurirwa kuri Egiputa, ubusinzikare buzoba muri Etiyopiya, igihe abariritswe bazohindikirana muri Egiputa; bazokūrah’ abantu baho b’isinzi, kand’ amatanguriro yaho azohomvagurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.4",
            "verseOrgIds": [
              "EZK.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Etiyopiya n’i Puti n’i Ludi, n’amahanga yose y’ikivange, n’i Kubi, n’abo mu gihugu gifatanije na bo, bazogwa hamwe bariritswe n’inkota.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.5",
            "verseOrgIds": [
              "EZK.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, at’ Abahagarikiye Egiputa na bo bazogwa, kand’ ubgibone buterwa n’ ububasha bgaho buzocishwa bugufi; bazogwa bariritswe n’inkota, uhereye i Migidoli ugashitsa i Sevene, ni k’Umwami Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.6",
            "verseOrgIds": [
              "EZK.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.12"
              },
              "items": [
                {
                  "text": "Ezk 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazosigara mu matongo hagati y’ibindi bihugu vyacitse amatongo, n’ibisagara vyaho bizoharūrwa hagati y’ibindi bisagara vyacitse imisaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.7",
            "verseOrgIds": [
              "EZK.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bazomenya yuko nd’Uhoraho, igihe nzoba mmaze kwanda umuriro Egiputa, abatabazi babo bahonnye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.8",
            "verseOrgIds": [
              "EZK.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi intumwa zizova imbere yanje zigende mu māto, ngo zibe agacavutu ku Banyetiyopiya bībera ngaho ata co binona: hazoba kwembemba muri bo, nk’ ukwabaye ku musi wo muri Egiputa; kand’ ehe biraje.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.9",
            "verseOrgIds": [
              "EZK.30.9"
            ]
          }
        }
      ]
    },
    {
