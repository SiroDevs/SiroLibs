            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.19"
              },
              "items": [
                {
                  "text": "Ezk 29:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Umwami Uhoraho agize, at’ Ikindi, nzoherengeteza isinzi ry’abantu bo muri Egiputa, mbikoresheje ukuboko kwa Nebukadineza, umwami w’i Babuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.10",
            "verseOrgIds": [
              "EZK.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.7"
              },
              "items": [
                {
                  "text": "Ezk 28:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.8"
              },
              "items": [
                {
                  "text": "29:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "We n’abantu biwe b’agaterabgoba bo mu mahanga, bazozanwa no kugeseza igihugu; bazosokōrera inkota zabo Egiputa, buzuze igihugu imivyimba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.11",
            "verseOrgIds": [
              "EZK.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.19.4+ISA.19.5+ISA.19.6"
              },
              "items": [
                {
                  "text": "Yes 19:4-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.10"
              },
              "items": [
                {
                  "text": "Ezk 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzūzi nzozikamya, igihugu nkigabure mu maboko y’abantu b’abanyakibi; kand’ igihugu n’ibirimwo vyose nzogihindura amatongo nkoresheje amaboko y’abantu b’akavantara: ni jewe, Uhoraho, mbivuze.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.12",
            "verseOrgIds": [
              "EZK.30.12"
            ]
          }
        }
      ]
    },
