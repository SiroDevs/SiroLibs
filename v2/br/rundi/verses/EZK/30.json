              "items": [
                {
                  "text": "Ezk 29:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyegiputa nzobasābagiriza mu mahanga, mbashwiragirize mu bihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.23",
            "verseOrgIds": [
              "EZK.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amaboko y’ umwami w’i Babuloni nzoyakomeza, inkota yanje ndayishire mu kuboko kwiwe; arikw amaboko ya Farawo nzoyavuna, kand’ azonihira imbere yiwe umuniho nk’uw’ ūkomeretse uruguma rw’intakira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.24",
            "verseOrgIds": [
              "EZK.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nzokomeza amaboko y’ umwami w’i Babuloni, arikw aya Farawo azodendebuka; maze bazomenya yuko nd’ Uhoraho, igihe nzoshira inkota yanje mu kuboko kw’umwami w’i Babuloni, na we akayibāngurira ku gihugu ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.25",
            "verseOrgIds": [
              "EZK.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abanyegiputa nzobasābagiriza mu mahanga, mbashwiragirize mu bihugu; maze bazomenya yuko nd’ Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.26",
