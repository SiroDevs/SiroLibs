                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.43.12"
              },
              "items": [
                {
                  "text": "Yer 43:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.11"
              },
              "items": [
                {
                  "text": "Zek 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Umwami Uhoraho agize, ati N’ibigirwamana na vyo nzobihonnya, kandi nzoherengeteza ibishushanyo muri Nofu; nta muganwa azosubira kuboneka mu gihugu ca Egiputa; kandi nzoshira ibiteye ubgoba mu gihugu ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.13",
            "verseOrgIds": [
              "EZK.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.28.18"
              },
              "items": [
                {
                  "text": "Ezk 28:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Patirosi nzohahindura amatongo, nande umuriro i Sowani, kandi nzoshitsa amateka nciriye ku hitwa No. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.14",
            "verseOrgIds": [
              "EZK.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzorekurira uburake bganje kuri Sini, ari co gihome ca Egiputa; kand’ abantu b’isinzi bo muri No nzobarandura. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.15",
            "verseOrgIds": [
              "EZK.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Egiputa nzohanda umuriro; muri Sini hazoba kwembemba kwinshi, no muri No hazosangangurwa; kand’ i Nofu hazotsindwa n’abansi ku murango w’amaminangohe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.16",
            "verseOrgIds": [
              "EZK.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisore yo muri Aveni n’iy’ i Pibeseti izoririkwa n’inkota: kand’ abo mur’ ivyo bisagara bazojanwa ar’ inyagano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.17",
            "verseOrgIds": [
              "EZK.30.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 30:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.6"
              },
              "items": [
                {
                  "text": "Ezk 30:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.9"
              },
              "items": [
                {
                  "text": "Am 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "I Tahapanesi hazoba ubgirakabiri, igihe nzohavunagurira ingōgo Egiputa hahatwarisha igitugu, n’ubgibone buterwa n’ ububasha bgaho buzoshirira aho nyene; igicu kizohubikiza, kand’ abakobga baho bazojanwa ar’ inyagano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.30.18",
            "verseOrgIds": [
              "EZK.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 30:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko nzoshitsa amateka nciriye Egiputa; maze bazomenya yuko nd’ Uhoraho.",
          "type": "text",
