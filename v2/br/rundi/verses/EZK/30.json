              "type": "tag",
              "attrs": {
                "loc": "EZK.34.12"
              },
              "items": [
                {
                  "text": "Ezk 34:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
