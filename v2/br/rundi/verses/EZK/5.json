                "loc": "EZK.22.4"
              },
              "items": [
                {
                  "text": "Ezk 22:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ikindi nzoguhindura umusaka n’igitutsi mu mahanga agukikije, no mu maso y’abahita bose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.14",
            "verseOrgIds": [
              "EZK.5.14"
            ]
          }
        },
