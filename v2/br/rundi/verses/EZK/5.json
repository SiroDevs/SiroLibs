            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigira gatatu cawe kizokwicwa n’ikīza, na kigoyi kizobamarira hagati muri wewe; ikindi kigira gatatu kizoririkirwa n’inkota impande zawe zose; n’ikindi kigira gatatu nzogishwiragiriza mu birēre vyose, kandi nzosokōra inkota ibirukane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.12",
            "verseOrgIds": [
              "EZK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 5:13"
          },
