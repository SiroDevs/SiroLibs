              "items": [
                {
                  "text": "11:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma ndahiye ukubaho kwanje, ni k’Umwami Uhoraho agize, kuko wahumanishije ahēra hanje ibintu vyawe vyankwa urunuka, n’ibizira vyawe vyose, ni co gituma nanje ntazobura kugutūvya; ijisho ryanje ntirizogira ico riziguriza, kandi nta n’akagongwe nzogira. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.11",
            "verseOrgIds": [
              "EZK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
