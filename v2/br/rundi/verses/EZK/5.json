            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwana w’umuntu, wiyabīrire inkota y’ubuhwe, uyābīre bga rupfuhe, uyicīshe ku mutwe wawe no ku bganwa bgawe: uheze wiyabīrire umunzane wo kugeresha, ugabanye iyo mishatsi wimoye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.1",
            "verseOrgIds": [
              "EZK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
