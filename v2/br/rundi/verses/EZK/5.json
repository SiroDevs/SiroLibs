                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.12.14"
              },
              "items": [
                {
                  "text": "12:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigira gatatu cayo uz’ ugituririre hagati mu gisagara, igihe imisi yo gutabga hagati kwaho izoba ihereye; ikindi kigira gatatu cayo ugicagagurize inkota hirya no hino yaho; kand’ ikindi kigira gatatu cayo ukirekurire mu muyaga ng’ugishwiragize, nanje nzosokora inkota icirukane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.2",
            "verseOrgIds": [
              "EZK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.40.6"
              },
              "items": [
                {
                  "text": "Yer 40:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.52.16"
              },
              "items": [
                {
                  "text": "52:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo mishatsi uz’ uyigabanyeko mukeya, uwutekere mu mutwe w’impuzu yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.3",
            "verseOrgIds": [
              "EZK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo nyene uwukūrekw akandi gakeya, ugaterere mu muriro, ugaturire; aho ni ho hazova umuriro uzoshika ku nzu yose ya Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.4",
            "verseOrgIds": [
              "EZK.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
