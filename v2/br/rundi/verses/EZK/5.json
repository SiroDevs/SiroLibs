              "attrs": {
                "loc": "EZK.36.6"
              },
              "items": [
                {
                  "text": "36:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko nzoba nimaze ishavu, n’ubushangashirwe nabagiriye nzoba ndabutuye, kandi nzoba nshizwe: nuko bazomenya yuko jewe, Uhoraho, nabivuganye agatsi, ni naheza kwimara uburake mbafitiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.5.13",
            "verseOrgIds": [
              "EZK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
