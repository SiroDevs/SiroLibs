                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.17"
              },
              "items": [
                {
                  "text": "Ezk 40:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ agera intimba y’inzu, iba amatambge atandatu; n’ubgaguke bg’akumba kose kometseko mu mbavu buba amatambge ane, twāri dukikije ku nzu impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.5",
            "verseOrgIds": [
              "EZK.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ utwo twumba two mu mbavu twāri mu mirongo itatu, umwe ugeretse ku wundi; mu murongo mu murongo hār’ utwumba mirongwitatu; imbaho zatwo zari zinjiye mu gisika, uko twubatswe inyuma ku ngoro impande zose; zari zifashe ahaniguye ku gisika c’ingoro ubgayo, ariko zitinjiyemwo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.6",
            "verseOrgIds": [
              "EZK.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utwo twumba two mu mbavu twagenda turutana uko tudūze dukikije ingoro, kukw aho haniguye hakikije ingoro, na ho hāgenda harutana uko hadūze, bigatuma igisika c’ingoro ubgayo kigenda gikeha uko kidūze; kand’ uwūrira mu kumba ko hejuru avuye mu ko hasi yaca mu ko hagati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.7",
            "verseOrgIds": [
              "EZK.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona yukw iyo ngoro yari n’ itanguriro rirerire impande zose; amatanguriro y’utwumba two mu mbavu yar’ irenga rimwe ry’ amatambge atandatu y’ukuboko uciriye mu nkokora n’ayandi atandatu y’intoke. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.8",
            "verseOrgIds": [
              "EZK.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Intimba y’ igisika cubakiwe utwo twumba two mu mbavu, ahahera hanze, yar’ amatambge atanu y’ukuboko uciriye mu nkokora; maz’ ahasigaye hār’ ahākebewe utwo twumba two mu mbavu two ku ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.9",
            "verseOrgIds": [
              "EZK.41.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi guhera kur’ utwo twumba hār’ umwanya w’amatambge mirongwibiri ukikuje ingoro impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.10",
            "verseOrgIds": [
              "EZK.41.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imiryango y’utwo twumba two mu mbavu yari yerekeye ha handi hāsigaye; umuryango umwe wari werekeye i burārūko, uwundi i bumanuko: kand’ aho hāsigaye, ubgaguke bgaho bgār’ amatambge atanu impande zose.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.11",
            "verseOrgIds": [
              "EZK.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hār’ inzu yar’ imbere y’ uwo mwanya uciye hagati, ku ruhande rw’i burengerazuba, ubgaguke bgayo bgar’ amatambge mirongwirindwi y’ukuboko uciriye mu nkokora, intimba y’iyo nzu yar’ amatambge atanu‐atanu impande zose, n’uburebure bgayo bgar’ amatambge mirongwicenda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.12",
            "verseOrgIds": [
              "EZK.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw agera uburebure bg’ umurambararo bg’ingoro buba amatambge ijana; agera n’uwo mwanya uciye hagati bo na ya nzu n’intimba yayo, uburebure bgavyo buba amatambge ijana nyene; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.13",
            "verseOrgIds": [
              "EZK.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "agera n’ubgaguke bg’imbere y’ urusengero bo na wa mwanya uciye hagati aharābana n’i burasirazuba, na vyo biba amatambge ijana. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.14",
            "verseOrgIds": [
              "EZK.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agera n’uburebure bg’ umurambararo bga ya nzu irābana na wa mwanya uciye hagati inyuma y’ingoro, bo n’amabaraza yo ku mpande zompi, biba amatambge ijana nyene.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere mu rusengero, n’amabaraza y’inyubakwa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.15",
            "verseOrgIds": [
              "EZK.41.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.42.5"
              },
              "items": [
                {
                  "text": "Ezk 42:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "no mw irebe, n’amadirisha atugururwa, n’amabaraza aciye impande zose za twa twumba turi mu mirongo itatu igerekeranye, aharābana n’irebe, hāri haranze imbaho impande zose, uhereye hasi ugashika ku madirisha, kand’ ayo madirisha nyene yarimw’ inshingo; ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.16",
            "verseOrgIds": [
              "EZK.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "no gushitsa hejuru y’irebe, n’ahitereye imbere mu ngoro, bo n’inyuma, bo n’inzu impande zose imbere n’ inyuma, vyose vyāri ku rugero. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.17",
            "verseOrgIds": [
              "EZK.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.6.29"
              },
              "items": [
                {
                  "text": "1 Abam 6:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi vyāri bisharijwekw ibishushanyo vy’abakerubi n’ibigazi; hagati y’umukerubi n’uwundi hāri harobetse ikigazi; kand’ umukerubi wese yar’ afise mu maso habiri, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.18",
            "verseOrgIds": [
              "EZK.41.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 41:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.10"
              },
              "items": [
                {
                  "text": "Ezk 1:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ahasa n’ah’ umuntu harābana n’ikigazi ku ruhande rumwe, n’ahasa n’ah’ umugunza w’intambge harābana n’ikindi kigazi ku rundi ruhande. Uko ni ko vyashushanijwe guheza inzu yose impande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.19",
            "verseOrgIds": [
              "EZK.41.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 41:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye hasi ugashitsa hejuru y’irebe hari hashushanijwekw abakerubi n’ibigazi; uko ni ko vyashushanijwe guheza urusengero rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.41.20",
            "verseOrgIds": [
              "EZK.41.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 41:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisapfu vy’urusengero vyangana impande zose; kand’ uruhande rw’imbere rw’Ahēra Cane rwāsa kumwe n’urusengero.",
          "type": "text",
          "attrs": {
