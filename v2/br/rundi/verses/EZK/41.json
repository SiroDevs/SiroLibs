          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "amarebe yompi yar’ afise inzugi zibiri zisomana; irebe rimwe ryagira inzugi zibiri, irindi zindi zibiri. ",
          "type": "text",
          "attrs": {
