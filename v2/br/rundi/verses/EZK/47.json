                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.14.8"
              },
              "items": [
                {
                  "text": "Zek 14:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.1"
              },
              "items": [
                {
                  "text": "Ivyah 22:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw angarukana ku muryango w’ingoro; ngize ntya, mbona har’ amazi yiburuka ava musi y’urwinjiriro rw’irebe ry’ingoro, atembera i burasirazuba, kukw ingoro yari yerekeye i burasirazuba nyene; nukw ayo mazi yatemba, ava i buryo bg’ ingoro, aca i ruhande y’igicaniro, ahahera i bumanuko. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.1",
            "verseOrgIds": [
              "EZK.47.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 47:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ andengana ikirimba cerekeye i burārūko, ancisha mu nzira igendanye urugo inyuma, anshikana ku kirimba c’inyuma kirābana n’i burasirazuba. Ngize ntya, mbona amazi asokoroka ku ruhande rwaco rw’i buryo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.2",
            "verseOrgIds": [
              "EZK.47.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 47:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.40.3"
              },
              "items": [
                {
                  "text": "Ezk 40:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo muntu avuye aho arikw aragenda yerekeye i burasirazuba, yar’ afise umugozi mu ntoke; awugeresha amatambge igihumbi ahwanye n’ay’ ukuboko uciriye mu nkokora; maz’ anjabutsa ayo mazi, amazi andenga ibirenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.3",
            "verseOrgIds": [
              "EZK.47.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 47:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arongera agera amatambge igihumbi, anjabutsa ayo mazi, amazi angera mu mavi. Arongera agera igihumbi, arayanjabutsa, amazi angera mu rukenyerero. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.4",
            "verseOrgIds": [
              "EZK.47.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma agera ikindi gihumbi, aba uruzi ntashobora kujabuka: kukw amazi yari yuzuye, yar’ asigaye ar’ ayo kujabukwa n’uwoga, uruzi ntirwari rukijabukwa igihagararo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 47:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.5",
            "verseOrgIds": [
              "EZK.47.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 47:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambaza, ati Mwana w’umuntu, mbeg’ ivyo urabibonye? Maz’ arangarukana, tujana inkombe y’uruzi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.6",
            "verseOrgIds": [
              "EZK.47.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 47:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Ivyah 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkiriko ndagenda, ngize ntya mbona ku nkombe y’uruzi har’ ibiti vyinshi cane hakurya no hakuno. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.7",
            "verseOrgIds": [
              "EZK.47.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 47:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.17"
              },
              "items": [
                {
                  "text": "Gus 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambarira, at’ Aya mazi atembera i burasirazuba, azomanuka mu kiyaya Araba, arinde ashika mu kiyaga c’umunyu; ni yashika mur’ ico kiyaga, azokiza amazi yo muri co. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.8",
            "verseOrgIds": [
              "EZK.47.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 47:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ah’ urwo ruzi ruzoshika hose ikintu cose kizima gikunda kunyogomba mu mazi kizobona uko kibaho; kandi hazobamwo n’isinzi ry’amafi ryinshi kukw ayo mazi ashitseyo, kand’ amazi yo mu kiyaga azokira, ikintu cose kizima kibone uko kibaho ah’ urwo ruzi ruzoshika hose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.9",
            "verseOrgIds": [
              "EZK.47.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 47:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.34.6"
              },
              "items": [
                {
                  "text": "Guh 34:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abarovyi bazohagarara ku nkombe zaco; uhereye kuri Eni‐gedi ugashitsa kuri Enegulayimu hazoba aho gutera insenga; hazobamw’ amafi y’uburyo bginshi, nk’amafi yo mu kiyaga kinini, kand’ azoba ari menshi cane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.10",
            "verseOrgIds": [
              "EZK.47.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 47:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyondo n’ibishanga vyo ku nkengēra yaco ntibizokira, bizoheberwa umunyu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.11",
            "verseOrgIds": [
              "EZK.47.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 47:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.1.3"
              },
              "items": [
                {
                  "text": "Zab 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.17.8"
              },
              "items": [
                {
                  "text": "Yer 17:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.2"
              },
              "items": [
                {
                  "text": "Ivyah 22:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ku nkombe z’urwo ruzi, hakurya no hakuno, hazomera igiti cose cama ibiribga; ibibabi vyavyo nta ho bizokabirana, kandi n’ivyo vyama nta ho bizobura: bizohora vyera bijana n’ukwezi uko gutashe, kukw amazi abitunga ava ahēra h’urusengero: ivyo vyama bizoba ivyo kurya, n’ibibabi vyavyo bizoba umuti wo kuvūra.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.47.12",
            "verseOrgIds": [
              "EZK.47.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
