                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti Mwana w’umuntu, uz’ urye ivyo kurya vyawe uhinda agashitsi, kand’ uz’ unywe amazi yawe uri mu gatengo uhagaritse umutima; ",
          "type": "text",
          "attrs": {
