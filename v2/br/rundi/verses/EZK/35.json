            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.137.7"
              },
              "items": [
                {
                  "text": "Zab 137:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.11"
              },
              "items": [
                {
                  "text": "Am 1:11",
