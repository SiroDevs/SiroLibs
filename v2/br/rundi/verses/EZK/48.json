            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzoba uw’ abaherezi bejejwe bo muri bene Sadoki, bāsigaye bitondera ivyo nabajeje, ntibazimire igihe Abisirayeli bāzimira, nk’ukw Abalewi bāzimiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.11",
            "verseOrgIds": [
              "EZK.48.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 48:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzobabera ishamvu ikūwe ku mugabane washikanywe usatuwe ku gihugu, ishamvu yera cane ijanye ku rugabano rw’Abalewi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.12",
            "verseOrgIds": [
              "EZK.48.12"
            ]
          }
        }
      ]
    },
