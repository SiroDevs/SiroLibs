              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ amarembo y’igisagara azokwitiranywa n’amazina y’imiryango y’Abisirayeli; ahahera i burārūko amarembo azoba atatu: rimwe rizoba irembo rya Reyubeni, irindi ribe irya Yuda, irindi ribe irya Lewi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.31",
            "verseOrgIds": [
              "EZK.48.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 48:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ruhande rw’i burasirazuba uburebure buzoba amatambge ibihumbi bine n’amajana atanu nyene, amarembo na yo azoba atatu: rimwe rizoba irembo rya Yosefu, irindi ribe irya Benyamini, irindi ribe irya Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.32",
            "verseOrgIds": [
              "EZK.48.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 48:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ruhande rw’i bumanuko uburebure buzoba amatambge ibihumbi bine n’amajana atanu nyene, amarembo na yo azoba atatu: rimwe rizoba irembo rya Simeyoni, irindi ribe irya Isakari, irindi ribe irya Zebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
        {
