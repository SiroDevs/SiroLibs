          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 48:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ujanye ku rugabano rwa Benyamini, uhereye i burasirazuba ugashitsa i burengerazuba hazoba umugabane wa Simeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.24",
            "verseOrgIds": [
              "EZK.48.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 48:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ujanye ku rugabano rwa Simeyoni, uhereye i burasirazuba ugashitsa i burengerazuba hazoba umugabane wa Isakari. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.25",
            "verseOrgIds": [
              "EZK.48.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 48:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ujanye ku rugabano rwa Isakari, uhereye i burasirazuba ugashitsa i burengerazuba hazoba umugabane wa Zebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.26",
            "verseOrgIds": [
              "EZK.48.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 48:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ujanye ku rugabano rwa Zebuloni, uhereye i burasirazuba ugashitsa i burengerazuba hazoba umugabane wa Gadi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.27",
            "verseOrgIds": [
              "EZK.48.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 48:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ujanye ku rugabano rwa Gadi, ku rubibe rw’i bumanuko rurābana n’i bumanuko, urugabano ruzovuduka i Tamari, ruce ku mazi y’i Meribati‐Kadeshi, rujane uruzi rwa Egiputa, rushike ku kiyaga kinini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.28",
            "verseOrgIds": [
              "EZK.48.28"
            ]
          }
        },
        {
