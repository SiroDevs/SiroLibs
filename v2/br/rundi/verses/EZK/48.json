          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ku vy’imiryango isigaye: uhereye i burasirazuba ugashitsa i burengerazuba hazoba umugabane wa Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.23",
            "verseOrgIds": [
              "EZK.48.23"
            ]
          }
        },
        {
          "name": "verse",
