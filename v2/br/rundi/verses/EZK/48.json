          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ruhande rw’i burengerazuba uburebure buzoba amatambge ibihumbi bine n’amajana atanu nyene, hamwe n’amarembo yaho ukw ar’ atatu: rimwe rizoba irembo rya Gadi, irindi ribe irya Asheri, irindi ribe irya Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
            "verseOrgIds": [
              "EZK.48.34"
            ]
          }
