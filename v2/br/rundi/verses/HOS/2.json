                "loc": "ISA.50.1"
              },
              "items": [
                {
                  "text": "Yes 50:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwite barumuna banyu, Bantubanje, na bashiki banyu, ba Inambabazi.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.1",
            "verseOrgIds": [
              "HOS.2.1"
            ]
          }
        }
