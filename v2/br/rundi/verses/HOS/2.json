        },
        {
          "text": "Kandi kur’ uwo musi nzokwitaba ijuru, ni jewe Uhoraho mbivuze, na ryo ryitabe isi, ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.2.21",
