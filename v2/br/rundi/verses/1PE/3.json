              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni nde yobagirira nabi, ni mwagira ishaka ry’ivyiza? ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.13",
            "verseOrgIds": [
              "1PE.3.13"
            ]
          }
        },
