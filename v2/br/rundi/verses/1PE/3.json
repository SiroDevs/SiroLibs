          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko handitswe,",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.10",
            "verseOrgIds": [
              "1PE.3.10"
            ]
          }
        }
