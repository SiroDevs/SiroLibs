              "items": [
                {
                  "text": "Imig 3:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk’uko Sara yumvira Aburahamu, akamwita umwami wiwe; namwe mur’ abana b’uwo, ni mwahora mukora neza, mudaterwa ubgoba n’icobaca ivutu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.6",
            "verseOrgIds": [
              "1PE.3.6"
            ]
          }
        }
