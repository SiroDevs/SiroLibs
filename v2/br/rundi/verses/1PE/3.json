                "loc": "GEN.18.12"
              },
              "items": [
                {
                  "text": "Ita 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.25"
