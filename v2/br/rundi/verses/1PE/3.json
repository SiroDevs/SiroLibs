            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.2.9"
              },
              "items": [
                {
                  "text": "1 Tim 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugushaza kwanyu ntikube ukwo ku rukoba kwo gutsiba umushatsi, cank’ ukwo kwambara izahabu cank’ ukwo kwambara impuzu nziza; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.3",
            "verseOrgIds": [
              "1PE.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1PE 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko kube ukw’ umuntu ahishijwe wo mu mutima, ugushaza kudashira, ni kwo mutima w’ubugwaneza utekereje, ni kwo kw’ igiciro kinini imbere y’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.4",
            "verseOrgIds": [
              "1PE.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1PE 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni kw abagore bera bizigira Imana bāshaza kera, bagamburukira abagabo babo, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.5",
            "verseOrgIds": [
              "1PE.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
