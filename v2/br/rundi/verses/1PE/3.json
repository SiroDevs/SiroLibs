                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyoba vyiza n’uko mwobabazwa muhōwe gukora ivyiza, ari co Imana igomvye, hako muhōrwa gukora ibibi. ",
          "type": "text",
          "attrs": {
