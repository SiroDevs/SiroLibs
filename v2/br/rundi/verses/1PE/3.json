        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.3.18+ISA.3.19+ISA.3.20+ISA.3.21+ISA.3.22+ISA.3.23+ISA.3.24"
              },
              "items": [
                {
                  "text": "Yes 3:18-24",
