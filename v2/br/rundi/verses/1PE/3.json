            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamara naho mwobabazwa muhōwe ukugororoka, mwoba muhiriwe. Ntimuze mutinye ivyo babakangisha, ntimuhagarike imitima, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.14",
            "verseOrgIds": [
              "1PE.3.14"
            ]
          }
        },
        {
