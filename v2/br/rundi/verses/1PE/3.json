              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.12"
              },
              "items": [
                {
                  "text": "1 Pet 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mufise imitima itarimw’ ijwi ribāgiriza ikibi, kugira ngo no ku vyo muvugwa nabi, abatuka ingeso zanyu nziza zo muri Kristo bamāramāre. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.16",
            "verseOrgIds": [
              "1PE.3.16"
            ]
          }
        },
        {
