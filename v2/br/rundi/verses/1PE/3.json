            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisigaye, mwese muhūze umutima, mubabarane, mukundane nk’abavukana, mugiriranire imbabazi, mwicishe bugufi mu mutima; ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.8",
            "verseOrgIds": [
              "1PE.3.8"
            ]
          }
        },
