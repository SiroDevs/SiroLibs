                {
                  "text": "Mat 5:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.5.15"
              },
              "items": [
                {
                  "text": "1 Tes 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.23"
              },
              "items": [
                {
                  "text": "1 Pet 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntimugere ikibi ku kindi, cank’ igitutsi ku kindi; ariko mubigerāne n’umuhezagiro, kukw ico ari co mwahamagariwe, kugira ngo namwe muragwe umugisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.9",
            "verseOrgIds": [
              "1PE.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
