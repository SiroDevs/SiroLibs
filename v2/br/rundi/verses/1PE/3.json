                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko mwubahe Kristo mu mitima yanyu kw ari we Mwami, muhore mwiteguye kwishura umuntu wese ababajije inyanduruko y’ivyizigiro biri muri mwebge, ariko muri n’ubugwaneza, mutinya, ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.3.15",
            "verseOrgIds": [
              "1PE.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1PE 3:16"
          },
