              "items": [
                {
                  "text": "Zab 106:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.6"
              },
              "items": [
                {
                  "text": "Ivyak 18:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze nkunkumura umutamana wanje, nt’ Umuntu wese atazoshitsa iri jambo, Imana iz’ imukunkumure mu nzu yiwe no mu vyiwe; az’ abe ari kw akunkumurwa, asigare agaragara. Nukw ikoraniro ryose riremera, riti Amen; baraheza bahimbaza Uhoraho. Nukw abantu bagumya iryo sezerano.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.13",
            "verseOrgIds": [
              "NEH.5.13"
            ]
          }
        }
      ]
    },
