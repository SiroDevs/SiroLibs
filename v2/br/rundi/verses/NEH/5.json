          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numvise ayo majambo n’amaganya yabo nca ndaraka rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.6",
            "verseOrgIds": [
              "NEH.5.6"
            ]
          }
        },
        {
