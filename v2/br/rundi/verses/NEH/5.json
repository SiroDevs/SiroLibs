          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.22.25"
              },
              "items": [
                {
                  "text": "Kuv 22:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.25.36"
              },
              "items": [
                {
                  "text": "Lew 25:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
