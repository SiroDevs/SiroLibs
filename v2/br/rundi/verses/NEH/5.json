                "loc": "JER.34.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo baravuga, bati Turabibasubiza, kandi nta co tuzobāka kw inyungu; tuzobigenza nk’uk’ uvuze. Ndaheza mpamagaza abaherezi, ndahiriza abo bantu imbere yabo ko bazobikora nk’uko basezeranye. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.5.12",
            "verseOrgIds": [
              "NEH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
