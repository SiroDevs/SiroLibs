                "loc": "1CH.16.36"
              },
              "items": [
                {
                  "text": "1 Ngo 16:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.8.6"
              },
              "items": [
                {
                  "text": "Neh 8:6",
