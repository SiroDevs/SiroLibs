            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku badakomeye nabaye nk’ūdakomeye, kugira ngo ndonke abadakomeye. Kuri bose nabaye vyose kugira ngo nkirishe bamwe‐bamwe uburyo bgose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.22",
            "verseOrgIds": [
              "1CO.9.22"
            ]
          }
        },
        {
