            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Bayuda nabaye nk’Umuyuda, kugira ngo ndonke Abayuda: ku baganzwa n’ivyagezwe nabaye nk’ūganzwa na vyo, nah’ ubganje ntaganzwa na vyo, kugira ngo ndonke abaganzwa n’ivyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.20",
            "verseOrgIds": [
              "1CO.9.20"
            ]
          }
        },
        {
          "name": "verse",
