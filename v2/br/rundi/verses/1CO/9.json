              "items": [
                {
                  "text": "12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Non’ ingero yanje n’inki? N’uk’ ubutumwa, uko mbuvuze, mbuvuga ku buntu, kugira ngo sindwanire ivyo nemerewe mu butumwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.18",
            "verseOrgIds": [
