          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nanje ndiruka, ariko si nk’ūtazi iy’ aja: nkubitana ibipfunsi, ariko si nk’ūhusha; ",
          "type": "text",
          "attrs": {
