            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngenjeje ntyo mbikunze, ndagererwa; ariko ngenjeje ntyo ntabikunze na ho nyene ngōbērwa n’ububgiriza nizigiweko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.17",
