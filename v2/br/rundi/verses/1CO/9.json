                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku bataganzwa n’ivyagezwe, nabaye nk’ūtaganzwa na vyo, kugira ngo ndonke abataganzwa n’ivyagezwe, yamara ku Mana ho sind’ ūtaganzwa n’ivyagezwe, kuko kuri Kristo nganzwa na vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.21",
            "verseOrgIds": [
              "1CO.9.21"
            ]
          }
        },
