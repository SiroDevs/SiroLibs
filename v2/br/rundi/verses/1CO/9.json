              },
              "items": [
                {
                  "text": "22:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega sind’ uwidegemvya? Sind’ intumwa? Sinabonye Yesu Umwami wacu? Namwe ntimur’ igikorwa canje mu Mwami? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.1",
            "verseOrgIds": [
              "1CO.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.2"
              },
              "items": [
                {
                  "text": "2 Kor 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.3.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namba ku bandi ntar’ intumwa, ariko kuri mwebge ndi yo: kuko mur’ ikimenyetso",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "9:2",
              "type": "text"
            },
            {
              "text": "ikimenyetso",
              "type": "text"
            },
            {
              "text": ": rāba Yoh 6:27.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mu Mwami c’uko nd’intumwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.2",
            "verseOrgIds": [
              "1CO.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo nireguza ku bampinyura: ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.3",
            "verseOrgIds": [
              "1CO.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.8"
              },
              "items": [
                {
                  "text": "Luk 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbega ntitwemererwa kurya no kunywa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.4",
            "verseOrgIds": [
              "1CO.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.42"
              },
              "items": [
                {
                  "text": "Yoh 1:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntitwokwemerewe kujana abagore bacu ari bene Data nk’ukw izindi ntumwa zikora, na bene nyina w’Umwami wacu, na Kefa? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.5",
            "verseOrgIds": [
              "1CO.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke jewe na Barunaba ni twebge twenyene tutemererwa kureka gukora? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.6",
            "verseOrgIds": [
              "1CO.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yigeze kwitunga, ar’ umusoda? Ni nde yotera uruzabibu ntarye inzabibu zarwo? Canke ni nde yoragira ubusho, ntabunywe?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.7",
            "verseOrgIds": [
              "1CO.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ivyo mbivuze mu buryo bg’abantu, cank’ ivyagezwe vyo ntibivuga birtyo? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.8",
            "verseOrgIds": [
              "1CO.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.25.4"
              },
              "items": [
                {
                  "text": "Gus 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.18"
              },
              "items": [
                {
                  "text": "1 Tim 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko handitswe mu vyagezwe vya Mose, ngo Ntimuze murumye umunwa w’inka irikw irasekura ingano. Mbeg’ inka ni zo Imana ibabaye? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.9",
            "verseOrgIds": [
              "1CO.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.2.6"
              },
              "items": [
                {
                  "text": "2 Tim 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke se yabivuze kubgacu? Ego me, vyanditswe kubgacu; kuk’ umurimyi akwiye kurima afise ivyizigiro, kand’ umusekuzi akwiye gusekura yizigiye kw azohabgako. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.10",
            "verseOrgIds": [
              "1CO.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.15.27"
              },
              "items": [
                {
                  "text": "Rom 15:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ko twababivyemw’ ivy’ impwemu, none n’ibikomeye ko twokwimbura ivyanyu vy’umubiri? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.11",
            "verseOrgIds": [
              "1CO.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.34"
              },
              "items": [
                {
                  "text": "Ivyak 20:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.13.7"
              },
              "items": [
                {
                  "text": "1 Kor 13:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.11.9"
              },
              "items": [
                {
                  "text": "2 Kor 11:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi namba bāravyemerewe kuri mwebge, mbega ntitubarusha cane? Ariko ntitwarwaniye ivyo twemerewe, yamara twihanganira vyose, kugira ngo ntituzane ikidehesha ubutumwa bgiza bga Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.12",
            "verseOrgIds": [
              "1CO.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.8"
              },
              "items": [
                {
                  "text": "Guh 18:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.1+DEU.18.2+DEU.18.3"
              },
              "items": [
                {
                  "text": "Gus 18:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuzi yukw abakora ibikorwa vy’ivyera barya ivy’ urusengero, kand’ abakora ivy’ igicaniro basangira n’igicaniro? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.13",
            "verseOrgIds": [
              "1CO.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CO 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.7"
              },
              "items": [
                {
                  "text": "Luk 10:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.6"
              },
              "items": [
                {
                  "text": "Gal 6:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’Umwami wacu ni ko yageze kw abavuga ubutumwa bgiza batungwa n’ubutumwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.14",
            "verseOrgIds": [
              "1CO.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
