          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ivyo vyose mbikora kubg’ ubutumwa bgiza, kugira ngo mfatanye n’abandi muri bgo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.23",
