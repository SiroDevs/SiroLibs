              "type": "text"
            }
          ]
        },
        {
          "text": "Naho kuri bose nd’uwidegemvya, nihinduye umugurano wa bose, kugira ngo ndushirize kuronka benshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.9.19",
