          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku vy’ ivyaterekerejwe ibishushanyo vy’ibigirwamana, turazi yuko twese turi n’ubgenge. Ubgenge burakakīsha, arik’ urukundo rurubaka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.1",
            "verseOrgIds": [
              "1CO.8.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
