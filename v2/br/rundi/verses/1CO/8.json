            "number": "5",
            "style": "v",
            "sid": "1CO 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho har’ ivyitwa imana mw ijuru canke mw isi, nk’uko har’ imana nyinshi n’abami benshi,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.5",
            "verseOrgIds": [
              "1CO.8.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
