          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.3"
              },
              "items": [
                {
                  "text": "Gal 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.2",
            "verseOrgIds": [
              "1CO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ūkunda Imana ni we amenywa na yo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.3",
            "verseOrgIds": [
              "1CO.8.3"
            ]
          }
        },
        {
