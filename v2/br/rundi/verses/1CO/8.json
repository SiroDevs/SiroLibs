            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ubgo bgenge ntibufiswe na bose: kuko bamwe bāremariye mu bigirwamana gushitsa n’ubu, barya ikintu bibgira ko caterekerejwe ikigirwamana, kand’ umutima ugahumanywa no kudakomera.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.7",
            "verseOrgIds": [
              "1CO.8.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.27"
              },
              "items": [
                {
                  "text": "1 Kor 10:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.7",
            "verseOrgIds": [
              "1CO.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CO 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyo kurya si vyo bidushikiriza Imana: iyo tutabiriye, nta co duhōmba; cank’ iyo tubiriye, nta co duhōmbōka.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.8",
            "verseOrgIds": [
              "1CO.8.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.17"
              },
              "items": [
                {
                  "text": "Rom 14:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.8",
            "verseOrgIds": [
              "1CO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiyubare, kugira ng’ ubgo bushobozi bganyu bgoye kuba igitsitaza c’abadakomeye na gato.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.9",
            "verseOrgIds": [
              "1CO.8.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.5.13"
              },
              "items": [
                {
                  "text": "Gal 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.9",
            "verseOrgIds": [
              "1CO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umuntu iy’ akubonye, wewe wahawe gutahura, wicaye urīra mu rusengero rw’ikigirwamana, umutima w’uwo, iy’ adakomeye, mbega ntuzorinduka, akarya ivyaterekerejwe ibigirwamana? ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.10",
            "verseOrgIds": [
              "1CO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ ūdakomeye aba aranduwe no gutahura kwawe, kand’ ari we mwene Data Kristo yapfiriye.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.11",
            "verseOrgIds": [
              "1CO.8.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.14.15"
              },
              "items": [
                {
                  "text": "Rom 14:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.11",
            "verseOrgIds": [
              "1CO.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CO 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw iyo mukoreye icaha bene Data murtyo, mugakomeretsa imitima yabo idakomeye, muba mukoreye icaha Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.12",
            "verseOrgIds": [
              "1CO.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CO 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma namb’ ivyo kurya bigwisha mwene Data, sinzopfa nongeye kurya inyama kugira ngo singwishe mwene Data.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.13",
            "verseOrgIds": [
              "1CO.8.13"
            ]
          }
        },
