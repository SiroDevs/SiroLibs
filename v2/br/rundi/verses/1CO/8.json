              },
              "items": [
                {
                  "text": "Gus 6:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.4",
            "verseOrgIds": [
              "1CO.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
