          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko kuri twebge har’ Imana imwe, Data wa twese, yandurukwamwo na vyose, natwe twabesherejweho kuba abayo: kandi har’ Umwami umwe, ni Yesu Kristo, abeshaho vyose, natwe akatubeshaho.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.6",
            "verseOrgIds": [
              "1CO.8.6"
            ]
          }
        },
        {
