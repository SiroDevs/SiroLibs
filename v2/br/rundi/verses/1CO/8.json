          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko, ku vyo kurya ivyaterekerejwe ibigirwamana, turazi yukw igishushanyo atar’ ikintu mw isi, kandi yukw ata mana yindi iriho, atar’ Imwe.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.8.4",
            "verseOrgIds": [
              "1CO.8.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
