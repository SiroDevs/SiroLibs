          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubganje naho ntariho ku mubiri, ariko ndiho mu mpwemu, nahejeje gutsindisha uwakoze ibimeze birtyo nk’aho ndiho,",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.3",
            "verseOrgIds": [
