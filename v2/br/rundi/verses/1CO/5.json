        },
        {
          "text": "Namwe mukīkakīsha, ntimubabare, nk’uko mwari mukwiye, kugira ng’uwakoze ico caha akūrwe muri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.2",
