              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpūriye hehe no gucira urubanza abo hanze? Mbega si mwebge mucira urubanza abo muri mwebge?",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.12",
