          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko burya nabandikiye ko mutivanga n’uwitwa mwene Data, namb’ ar’ umusambanyi, cank’ uwifuza, cank’ ūsenga ibigirwamana, cank’ ūtukana, cank’ ūborerwa, cank’ umunyazi: ūmeze artyo, no gusangira ntimugasangire na we.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.5.11",
            "verseOrgIds": [
              "1CO.5.11"
            ]
          }
        },
