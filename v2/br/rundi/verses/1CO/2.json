              },
              "items": [
                {
                  "text": "1 Kor 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje, bene Data, hamwe nabasanga i wanyu, sinaje nd’agakūra mu majambo canke mu bgenge, mu kubamenyesha ibanga ry’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.1",
            "verseOrgIds": [
              "1CO.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CO 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.14"
              },
              "items": [
                {
                  "text": "Gal 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nagabiye kutagira ico mmenya muri mwebge, atari Yesu Kristo, we yabambge. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.2",
            "verseOrgIds": [
              "1CO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.18.9"
              },
              "items": [
                {
                  "text": "Ivyak 18:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.10.1"
              },
              "items": [
                {
                  "text": "2 Kor 10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nabana namwe mfise intege nke, ndi n’ubgoba, mpinda agashitsi kenshi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.3",
            "verseOrgIds": [
              "1CO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "imvugo yanje n’ukwigisha kwanje ntivyarimw’ amajambo y’ubgenge yo kwemeza abantu, ariko vyaserukamwo Mpwemu n’ubushobozi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.4",
            "verseOrgIds": [
              "1CO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.17"
              },
              "items": [
                {
                  "text": "Ef 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.1.5"
              },
              "items": [
                {
                  "text": "1 Tes 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ng’ukwizera kwanyu ntiguhagarare mu bgenge bg’abantu ariko guhagarare mu bushobozi bg’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.5",
            "verseOrgIds": [
              "1CO.2.5"
            ]
          }
        }
      ]
