                "loc": "ROM.11.34"
              },
              "items": [
                {
                  "text": "Rom 11:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.13"
              },
              "items": [
                {
                  "text": "Yes 40:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde yigeze kumenya ivyiyumviro vy’Uhoraho ngo yigishe Uhoraho? Ariko twebge dufise ivyiyumviro vya Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.2.16",
            "verseOrgIds": [
              "1CO.2.16"
            ]
