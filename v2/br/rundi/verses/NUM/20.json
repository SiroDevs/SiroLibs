              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jana Aroni na Eleyazari umwana wiwe, ubadūgane umusozi Hori: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.25",
            "verseOrgIds": [
