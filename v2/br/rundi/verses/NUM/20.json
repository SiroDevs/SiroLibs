          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abaririra Mose na Aroni ku musozi Hori, ku rubibe rw’igihugu ca Edomu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.23",
