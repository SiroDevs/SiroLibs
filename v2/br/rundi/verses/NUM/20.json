              "items": [
                {
                  "text": "32:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose na Aroni, ati Ko mutanyizeye, ngo mwerekane ukwera kwanje imbere y’Abisirayeli, ntimugishikanye iri koraniro mu gihugu nemeye ko nzobaha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.12",
            "verseOrgIds": [
              "NUM.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo ni yo mazi y’i Meriba,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:13",
              "type": "text"
            },
            {
              "text": "Meriba risobanurwa ngw Intonganya.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kukw Abisirayeli batonganije Uhoraho, akerekanira ukwera kwiwe muri bo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.13",
            "verseOrgIds": [
              "NUM.20.13"
            ]
          }
        }
      ]
    },
