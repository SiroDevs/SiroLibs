              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "uheze wambure Aroni imyambaro yiwe, uyambike Eleyazari umwana wiwe; aho ni ho Aroni aja gupfira, ahamvye ababo.",
          "type": "text",
          "attrs": {
