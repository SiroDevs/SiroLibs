            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishengero ryose ry’Abisirayeli rishika mu bugaragwa bg’i Zini mu kwezi kwa mbere: abo bantu bamara igihe i Kadeshi. Miriyamu agwaho, bamuhamba aho nyene.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.1",
            "verseOrgIds": [
              "NUM.20.1"
            ]
          }
        }
