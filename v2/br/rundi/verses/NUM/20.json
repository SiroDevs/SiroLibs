              "items": [
                {
                  "text": "Guh 16:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo shengero ribura amazi: bakoranira kurwanya Mose na Aroni. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.2",
            "verseOrgIds": [
              "NUM.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.2"
              },
              "items": [
                {
                  "text": "Kuv 17:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.1"
              },
              "items": [
                {
                  "text": "Guh 11:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.11.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.16.49"
              },
              "items": [
                {
                  "text": "16:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bantu batonganya Mose, baramubarira, bat’ Es’ iyo dupfa ca gihe bene wacu bapfira imbere y’Uhoraho! ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.3",
            "verseOrgIds": [
              "NUM.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.3"
              },
              "items": [
                {
                  "text": "Kuv 17:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mwazaniye iki ishengero ry’ Uhoraho mur’ ubu bugaragwa, ngo tubugwemwo, twe n’ivyo dushoreye? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.4",
            "verseOrgIds": [
              "NUM.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwadukūriye iki muri Egiputa, mukatuzana aha hantu habi? S’ahantu harimwa, s’ahantu hamera imisukoni cank’ imizabibu cank’ amakomamanga; kandi ntihagira n’amazi yo kunywa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.5",
            "verseOrgIds": [
              "NUM.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.5",
            "verseOrgIds": [
              "NUM.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni bava imbere y’iryo koraniro, baja ku muryango w’ihema ry’ibonaniro, barapfukama barūnama; maz’ ubgiza bg’ Uhoraho burababonekera. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.6",
            "verseOrgIds": [
              "NUM.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.7",
            "verseOrgIds": [
              "NUM.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.5"
              },
              "items": [
                {
                  "text": "Kuv 17:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.15"
              },
              "items": [
                {
                  "text": "Zab 78:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Abīra ya nkoni, muheze mukoranye iryo shengero, mwe na Aroni mukurwawe, mubaririre igitandara imbere yabo gisendanishe amazi yaco; ubakūrire amazi mur’ ico gitandara, uhe iryo shengero n’ ivyo bashoreye amazi yo kunywa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.8",
            "verseOrgIds": [
              "NUM.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.8",
            "verseOrgIds": [
              "NUM.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose yābīra iyo nkoni, ayikūye imbere y’Uhoraho, uko yamubariye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.9",
            "verseOrgIds": [
              "NUM.20.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.32"
              },
              "items": [
                {
                  "text": "Zab 106:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.33"
              },
              "items": [
                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni bakoraniriza iryo koraniro imbere y’ico gitandara, maze Mose arababarira, ati Ni mwumve, mwa bagarariji mwe! Mbega twebge twobakūrira amazi mur’ iki gitandara? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.10",
            "verseOrgIds": [
              "NUM.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.17.6"
              },
              "items": [
                {
                  "text": "Kuv 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose araheza amanika ukuboko, akubita ico gitandara inkoni yiwe kabiri: amazi menshi aca arasendanisha, iryo shengero riranywa, bo n’ivyo bashoreye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.20.11",
            "verseOrgIds": [
              "NUM.20.11"
            ]
          }
        }
      ]
    },
