                  "text": "Ivyak 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo Munaziri yimoshereze umushatsi wiwe w’ubunaziri ku muryango w’ihema ry’ibonaniro, aheze yābīre uwo mushatsi wo ku mutwe wiwe w’ubunaziri, awushire mu muriro uriko ca kimazi c’ishimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.18",
            "verseOrgIds": [
              "NUM.6.18"
            ]
          }
        },
        {
