                  "text": "Ivyak 21:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co cagezwe co ku Munaziri, igihe arangije imisi y’ubunaziri bgiwe: az’ azanwe ku muryango w’ihema ry’ibonaniro, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.13",
            "verseOrgIds": [
              "NUM.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.3.6"
              },
              "items": [
                {
                  "text": "Lew 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.4.32"
              },
              "items": [
                {
                  "text": "4:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "anzanire ishikanwa ryiwe, jewe Uhoraho: azane isuguru imwe y’intama itarengeje umwaka, itagira agasembga, kw ikimazi co kwoswa, bo n’ishashi imwe y’ intama itarengeje umwaka nyene, itagira agasembga, kw ikimazi co gutangirwa ivyaha, n’impfizi y’intama imwe itagira agasembga kw ikimazi c’ishimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.14",
            "verseOrgIds": [
              "NUM.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.29.2"
              },
              "items": [
                {
                  "text": "Kuv 29:2",
                  "type": "text"
                }
