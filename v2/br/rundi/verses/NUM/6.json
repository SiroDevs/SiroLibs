                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni hagira umuntu agwa bukumbi i ruhande yiwe, akanduza umutwe w’ubunaziri bgiwe, ku musi wo guhumanurwa kwiwe aze yimoshe: ku musi ugira indwi az’ abe ari ho yimosha. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.9",
            "verseOrgIds": [
              "NUM.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.7"
              },
              "items": [
                {
                  "text": "Lew 5:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ku w’umunani az’ azane intunguru zibiri cank’ ivyana vy’inuma bibiri ku muryango w’ihema ry’ibonaniro, abihe umuherezi; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.10",
            "verseOrgIds": [
              "NUM.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ umuherezi atange kimwe kw ikimazi co gutangirwa ivyaha, ikindi agitange kw ikimazi co kwoswa, amutangire impongano y’icaha yazaniwe n’uwo muvyimba, yēze umutwe wiwe kur’ uwo musi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.11",
            "verseOrgIds": [
              "NUM.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.6"
              },
              "items": [
                {
                  "text": "Lew 5:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze yongere anyiyegurire jewe Uhoraho imisi y’ubunaziri bgiwe, azane isuguru y’intama itarengeje umwaka kw ikimazi c’impongano; arikw imisi yiwe ya mbere izoba yapfuye ubusa, kuk’ ubunaziri bgiwe bgahumanye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.12",
            "verseOrgIds": [
              "NUM.6.12"
            ]
          }
        }
      ]
    },
