              "items": [
                {
                  "text": "Guh 15:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.15.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’indumane irimw’ imitsima itambiwe; udutsima twacumbge mw ifu igogōretse, twacumbanywe n’amavuta ya elayo, n’utundi dutsima tutambiwe nyene, tubēhūye, twasutswekw amavuta, bo n’amashikanwa bigendanye, iry’ ifu n’iry’ ibiturire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.15",
            "verseOrgIds": [
              "NUM.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi abizane imbere yanje, jewe Uhoraho, aheze amutangire ikimazi ciwe co gutangirwa ivyaha, n’ikimazi ciwe co kwoswa; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.16",
            "verseOrgIds": [
              "NUM.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "atange na ya mpfizi y’intama kw ikimazi anshikaniye c’ishimwe, ayishikanane na za ndumane z’imitsima itambiwe; kand’ uwo muherezi ashikanane na vyo amashikanwa bigendanye, iry’ ifu n’iry’ ibiturire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.17",
            "verseOrgIds": [
              "NUM.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
