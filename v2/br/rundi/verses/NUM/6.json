            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.13.4"
              },
              "items": [
                {
                  "text": "Abac 13:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.12"
              },
              "items": [
                {
                  "text": "Am 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.15"
              },
              "items": [
                {
                  "text": "Luk 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "aze yitandukanye na vino n’ibiboreza bindi; ntaz’ asome no ku nkarisha ya vino canke ku nkarisha y’ikiboreza kindi, canke ngw asome ku mazi y’inzabibu, canke ngw arye inzabibu mbisi canke zumye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.3",
            "verseOrgIds": [
              "NUM.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu misi yose y’ubunaziri bgiwe ntaz’ arye ikintu na kimwe kiva ku muzabibu, naho koba akabuto cank’ agashishwa. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.4",
            "verseOrgIds": [
              "NUM.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.16.17"
              },
              "items": [
                {
                  "text": "Abac 16:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.1.11"
              },
              "items": [
                {
                  "text": "1 Sam 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu misi yose y’isezerano ryiwe ry’ubunaziri ntihaze hagire urupfuhe rugera ku mutwe wiwe: az’ abe uwera gushitsa ah’ imisi yo kunyiyegurira jewe Uhoraho izoshirira; az’ areke umushatsi wiwe utendere. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.5",
            "verseOrgIds": [
              "NUM.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.11"
              },
              "items": [
                {
                  "text": "Guh 19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.19.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisi yose yo kunyiyegurira kwiwe ntaze yēgēre umuvyimba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.6",
            "verseOrgIds": [
              "NUM.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.1"
              },
              "items": [
                {
                  "text": "Lew 21:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.21.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
