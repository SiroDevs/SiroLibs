              "items": [
                {
                  "text": "Rom 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Barira Abisirayeli, ut’ Umugabo cank’ umugore ni yasezerana isezerano ry’ubunaziri, ngw anyiyegurire jewe Uhoraho; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.6.2",
            "verseOrgIds": [
              "NUM.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 6:3"
          },
