          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubibe rw’i burengerazuba ruze rube ico Kiyaga Kinini nyene: kuri co az’ abe ari ho mugarukira; ico kize kibe urubibe rwanyu ahahera i burengerazuba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.6",
            "verseOrgIds": [
              "NUM.34.6"
            ]
          }
        }
