                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "urubibe rw’aho muzogeza ku ruhande rw’i bumanuko ruze ruhēre mu bugaragwa bg’i Zini, rugende rubangikanye n’igihugu ca Edomu. Urwo rubibe rwanyu rw’i bumanuko ruze ruhēre kw iherezo ry’ Ikiyaga c’Umunyu ahahera i burasirazuba; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.3",
            "verseOrgIds": [
              "NUM.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 34:4"
          },
          "items": [
