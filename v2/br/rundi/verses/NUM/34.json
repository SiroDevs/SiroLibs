            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ruheze rugende rushike i Zifuroni, rugarukire i Hasar‐enani: urwo ruze rube urubibe rwanyu rw’i burārūko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.9",
