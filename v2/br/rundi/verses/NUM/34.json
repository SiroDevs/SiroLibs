            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ umuryango w’ Abareyubeni, nk’ukw amazu ya ba sekuruza ari, n’uw’ Abagadi, nk’ ukw amazu ya ba sekuruza ari, n’igihimba gisigaye c’umuryango w’Abamanase, bamaze guhabga amashamvu yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.14",
            "verseOrgIds": [
              "NUM.34.14"
            ]
          }
        },
        {
