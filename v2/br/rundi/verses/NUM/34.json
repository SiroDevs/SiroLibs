        {
          "text": "Urubibe rwanyu rw’i burārūko ruze rube uru: muhēreye ku Kiyaga Kinini murucishe ku musozi Hori; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.7",
            "verseOrgIds": [
              "NUM.34.7"
