          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "rumanuke rujane Yorodani, rugarukire ku Kiyaga c’ Umunyu. Ico ni co kizoba igihugu canyu, ukw imbibe zaco zigikīkūje impande zose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.12",
