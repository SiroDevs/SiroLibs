              "type": "text"
            }
          ]
        },
        {
          "text": "Urubibe rwanyu rw’i burasirazuba, muhēreye i Hasar‐enani nyene muze murucishe i Shefamu; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.34.10",
