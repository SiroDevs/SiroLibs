          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingabo zāharūwe zabo zar’ ibihumbi mirongwitatu na bibiri n’amajana abiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.21",
            "verseOrgIds": [
              "NUM.2.21"
            ]
          }
        },
