              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Abalewi ntibāharūranwa n’Abisirayeli, biba nk’uk’ Uhoraho yabariye Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.33",
