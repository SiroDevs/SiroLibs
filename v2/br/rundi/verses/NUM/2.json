            "number": "26",
            "style": "v",
            "sid": "NUM 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingabo zāharūwe zabo zar’ ibihumbi mirongwitandatu na bibiri n’amajana ndwi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.26",
            "verseOrgIds": [
              "NUM.2.26"
            ]
          }
        },
        {
          "name": "verse",
