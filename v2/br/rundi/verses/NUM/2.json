          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ umuryango wa Manase abe ari bo bahererana na bo; kand’ umukuru w’Abamanase ni Gamaliyeli mwene Pedasuri: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.20",
            "verseOrgIds": [
              "NUM.2.20"
            ]
          }
        },
        {
