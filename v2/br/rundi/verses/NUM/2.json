            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "I burasirazuba haze hasagaze ab’ ibendera y’igugu rya Yuda, nk’ukw imice yabo iri; umukuru w’Abayuda ni Nahashoni mwene Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.3",
            "verseOrgIds": [
              "NUM.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ingabo zāharūwe zabo zar’ ibihumbi mirongwirindwi na bine n’amajana atandatu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.4",
            "verseOrgIds": [
              "NUM.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ umuryango wa Isakari abe ari bo bahererana na bo; kand’ umukuru w’Abisakari ni Netaneli mwene Suwari: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.5",
            "verseOrgIds": [
              "NUM.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingabo zāharūwe zabo zar’ ibihumbi mirongwitanu na bine n’amajana ane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.6",
            "verseOrgIds": [
              "NUM.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakurikirwe n’umuryango wa Zebuloni; umukuru w’Abazebuloni ni Eliyabu mwene Heloni; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.7",
            "verseOrgIds": [
              "NUM.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingabo zāharūwe zabo zar’ ibihumbi mirongwitanu n’indwi n’amajana ane. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.8",
            "verseOrgIds": [
              "NUM.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.10.14+NUM.10.15+NUM.10.16"
              },
              "items": [
                {
                  "text": "Guh 10:14-16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bose na bose abāharūwe mw igugu rya Yuda bar’ ingabo ibihumbi ijana na mirongumunani na bitandatu n’amajana ane, nk’ukw imice yabo yakurikirana. Abo baze babe ari bo babanza guhaguruka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.9",
            "verseOrgIds": [
              "NUM.2.9"
            ]
          }
        }
      ]
