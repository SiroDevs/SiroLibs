          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’ umuryango wa Asheri abe ari bo bahererana na bo; kand’ umukuru w’Abasheri ni Pagiyeli mwene Okirani: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.27",
            "verseOrgIds": [
              "NUM.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
