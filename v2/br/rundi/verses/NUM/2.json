          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakurikirwe n’umuryango wa Benyamini; umukuru w’Ababenyamini ni Abidani mwene Gideyoni: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.2.22",
