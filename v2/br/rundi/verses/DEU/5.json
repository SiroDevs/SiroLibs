              "items": [
                {
                  "text": "Kuv 20:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti Ba ari wewe wēgēra, wumve ivyo Uhoraho Imana yacu avuga vyose; uheze utubarire ivyo Uhoraho Imana yacu akubarira vyose, natwe tuzovyumvira, tuvyitondere.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
