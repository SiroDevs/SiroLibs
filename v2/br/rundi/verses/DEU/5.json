          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntugapfe kuvuga izina ryanje, jewe Uhoraho Imana yawe, ku vy’ubusābusa, kuk’ uworivuga ku vy’ubusābusa, jewe Uhoraho ntobura kubimuhōra.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        }
      ]
