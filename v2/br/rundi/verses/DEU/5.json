            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Nd’Uhoraho Imana yawe, yagukūye mu gihugu ca Egiputa, mu nzu y’ubuja.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.6",
