            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Imana yacu yasezeranye natwe isezerano kuri Horebu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba sogokuruza si bo Uhoraho yasezeranye na bo iryo sezerano, ariko ni twebge abakiriho, turi hano uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.14"
              },
              "items": [
                {
                  "text": "Guh 14:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.12"
              },
              "items": [
                {
                  "text": "Gus 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yavugiye mu muriro, yivuganira namwe imbonankubone kuri wa musozi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.4",
            "verseOrgIds": [
              "DEU.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.19.16"
              },
              "items": [
                {
                  "text": "Kuv 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.18"
              },
              "items": [
                {
                  "text": "20:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.19"
              },
              "items": [
                {
                  "text": "Gal 3:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje nahagaze hagati y’Uhoraho namwe ico gihe, kugira ngo mbashikirize ijambo ryiwe, kuko mwari mutinye uwo muriro, ntimudūge kur’ uwo musozi. Aravuga,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
