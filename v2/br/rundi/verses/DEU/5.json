              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.4.33"
              },
              "items": [
                {
                  "text": "Gus 4:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muravuga, mut’ Uhoraho Imana yacu kw atweretse ubgiza bgiwe n’ububasha bgiwe, tukumva ijwi ryiwe rivuye hagati mu muriro, uyu musi tubonye yukw Imana ivugana n’umuntu, akabaho ntapfe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "None turinda gupfira iki kandi? kuk’ urya muriro uhambaye uhava utuyogeza, kandi ni twakomeza kwumva ijwi ry’Uhoraho Imana yacu, turapfa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti Ni nde mu baremwe bose yigeze kwumva ijwi ry’Imana nzima rivugira hagati mu muriro, nk’uko twebge turyumvise, agaheza akabaho ntapfe? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.26",
            "verseOrgIds": [
              "DEU.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
