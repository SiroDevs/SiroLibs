          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntukībāzire igishushanyo, cank’ igisa n’ishusho y’ikintu na kimwe kiri hejuru mw ijuru, canke hasi kw isi, canke mu mazi yo mu biyaga; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntuz’ uvyikubite imbere, ntuz’ ubisabe, kuko jewe Uhoraho Imana yawe nd’Imana ifūha, mpōra abana ibigabitanyo vya ba se, nkageza ku runganwe rugira gatatu no ku rugira kane rw’abanyanka, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nkagirira īkigongwe abankunda, bakitondera ivyagezwe vyanje, nkageza ku runganwe rwabo uko ruzogenda rukurikirana gushitsa igihumbi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
