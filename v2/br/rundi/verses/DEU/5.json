            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero muze mwitondere ivyo Uhoraho Imana yanyu yababariye; ntimuze mutambamire i buryo cank’ i bumoso. ",
          "type": "text",
          "attrs": {
