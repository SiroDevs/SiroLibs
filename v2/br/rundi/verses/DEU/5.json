            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ahamagara Abisirayeli bose, arababarira, ati Yemwe Bisirayeli, ni mwumve amabgirizwa n’ivyagezwe mvugira mu matwi yanyu uyu musi, kugira ngo muvyige, muvyitondere, mubishitse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        },
        {
          "name": "verse",
