          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mwumvise ijwi rivuye mur’ uwo mwiza, n’umusozi urik’ urāka umuriro, muza kuri jewe, abakuru mwese bo mu miryango yanyu n’ abashingantahe bo muri mwebge, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.23",
            "verseOrgIds": [
              "DEU.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 5:24"
          },
          "items": [
