            "style": "v",
            "sid": "DEU 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.8",
            "verseOrgIds": [
              "DEU.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose n’abaherezi ari bo Balewi babarira Abisirayeli bose, bati Yemwe Bisirayeli, ni muhore, mwumve: uyu musi muhindutse ihanga ry’Uhoraho Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.9",
            "verseOrgIds": [
              "DEU.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma mukwiye kwumvira Uhoraho Imana yanyu, mukitondera ivyagezwe vyiwe n’amabgirizwa yiwe, ivyo mbagera uyu musi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.10",
            "verseOrgIds": [
              "DEU.27.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
