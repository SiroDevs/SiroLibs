          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose arangije kubgira Abisirayeli bose ayo majambo yose, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
