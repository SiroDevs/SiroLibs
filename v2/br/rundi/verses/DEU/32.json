        },
        {
          "text": "Nuko Mose araza, avugira amajambo yose y’iyo ndirimbo mu matwi y’abantu, afatanije na Yosuwa mwene Nuni. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
