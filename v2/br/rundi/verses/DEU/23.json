              "items": [
                {
                  "text": "Ezr 9:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze murinde mupfa mutabendeje ivy’ amahoro cank’ ivyiza ukw ibihe bizoha ibindi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.6",
            "verseOrgIds": [
              "DEU.23.6"
            ]
