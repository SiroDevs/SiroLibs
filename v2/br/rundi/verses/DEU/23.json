              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihaze habemwo ba maraya mu Bisirayelikazi, canke ngo hagire abagabo bendana mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.17",
