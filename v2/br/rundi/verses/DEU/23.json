                "loc": "LEV.26.12"
              },
              "items": [
                {
                  "text": "Lew 26:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ Uhoraho Imana yanyu agendagenda hagati y’aho mushagaje, kugira ngw abakize, agabure abansi banyu mu maboko yanyu; ni co gituma aho mushagaje hakwiye kuba ahantu hera, kugira ngo ntaz’ ababonemw’ ikintu na kimwe giteye ishishi, akarora irya, akabata.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.14",
            "verseOrgIds": [
              "DEU.23.14"
            ]
          }
        }
      ]
