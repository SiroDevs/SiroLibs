                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamar’ Uhoraho Imana yanyu yanka kwumvira Balamu, arik’ uwo muvumo Uhoraho Imana yanyu awubahindurira umugisha, kuko yabakunda. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.5",
            "verseOrgIds": [
              "DEU.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 23:6"
          },
          "items": [
