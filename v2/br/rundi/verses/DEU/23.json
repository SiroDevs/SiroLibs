          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.15.16"
              },
              "items": [
                {
                  "text": "Lew 15:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri mwebge ni hagira umugabo yagize ivyamubayeko mw ijoro, bikamuhumanya, az’ agende ave aho mushagaje, ntaz’ ahagaruke uwo musi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.10",
            "verseOrgIds": [
              "DEU.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze bugira bugorobe, yiyuhagire; izuba rirenze, abone kugaruka aho mushagaje.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.11",
            "verseOrgIds": [
              "DEU.23.11"
            ]
          }
        }
      ]
    },
    {
