              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mugirire akazīka Abanyedomu, kuko mur’ akara kamwe, kandi ntimugirire akazīka Abanyegiputa, kuko mwar’ inyambukīra mu gihugu cabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.7",
