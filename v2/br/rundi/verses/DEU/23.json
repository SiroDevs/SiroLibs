              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwagenda gutera abansi banyu, mukagira aho mushagaje, muze mwirinde ikintu kitabereye cose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.9",
            "verseOrgIds": [
              "DEU.23.9"
            ]
          }
        },
        {
          "name": "verse",
