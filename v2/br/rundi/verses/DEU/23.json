          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abuzukuru babo bazovuka hanyuma bazoshobora kuja mw ikoraniro ry’Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.23.8",
