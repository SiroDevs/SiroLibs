              },
              "items": [
                {
                  "text": "Gus 4:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta wogereranywa na we kubg’ ibimenyetso n’ibitangaza vyose Uhoraho yamutumye gukorera mu gihugu ca Egiputa, ngw abigirire Farawo n’abamenyekana biwe bose n’igihugu ciwe cose; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.11",
            "verseOrgIds": [
              "DEU.34.11"
            ]
          }
        },
