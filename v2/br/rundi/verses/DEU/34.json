              "items": [
                {
                  "text": "Gus 32:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose ava mu kiyaya c’i Mowabu, adūga umusozi Nebo, ashika ku gatwe Pisiga, aharābana n’i Yeriko. Uhoraho amwereka igihugu cose c’i Gileyadi gushitsa i Dani, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.1",
            "verseOrgIds": [
              "DEU.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ic’ Abanafutali cose, n’ic’ Abefurayimu, n’ic’ Abamanase, n’ic’ Abayuda cose, gushitsa ku kiyaga c’i burengerazuba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.2",
            "verseOrgIds": [
              "DEU.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 34:3"
          },
          "items": [
