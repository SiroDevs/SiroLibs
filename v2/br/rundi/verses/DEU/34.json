              "items": [
                {
                  "text": "Gus 3:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho aramubarira, ati Ngīkirīya igihugu narahiye Aburahamu na Isaka na Yakobo, nti Nzogiha uruvyaro rwanyu. None nguhaye kukirābisha amaso, ariko ntuzojabuka ng’ ujeyo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.4",
            "verseOrgIds": [
              "DEU.34.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
