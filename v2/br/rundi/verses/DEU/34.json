              "items": [
                {
                  "text": "2 Ngo 28:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amwereka n’i Negebu, n’ikiyaya co kuri Yorodani, ari ho haca igihogoro c’i Yeriko, igisagara co mu bigazi, gushitsa i Sowari. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.3",
            "verseOrgIds": [
              "DEU.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 34:4"
          },
          "items": [
