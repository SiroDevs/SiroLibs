            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bamara imisi mirongwitatu baririra Mose, bari mu kiyaya c’i Mowabu; nukw imisi yo kuririra Mose no kumugandarira irarangira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.8",
            "verseOrgIds": [
