            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.48.10"
              },
              "items": [
                {
                  "text": "48:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose yapfuye amaze imyaka ijana na mirongwibiri; kand’ amaso yiwe ntiyaribgarābe ivyijiji, cank’ inkomezi ziwe ngo zigabanuke.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.7",
            "verseOrgIds": [
              "DEU.34.7"
            ]
          }
        }
