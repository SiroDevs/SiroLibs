              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu Bisirayeli ntihigeze kuboncka ūvugishwa n’Imana ahwanye na Mose, uwo Uhoraho yibonanira na we imbonankubone. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.34.10",
            "verseOrgIds": [
              "DEU.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
