        },
        {
          "text": "kand’ Uhoraho Imana yanyu ni yamara kubagabura mu maboko yanyu, mukabatsinda, muze mubarandure. Ntimuze mugire isezerano musezerana na bo, canke ngo mubagirire akagongwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.2",
            "verseOrgIds": [
              "DEU.7.2"
            ]
          }
        },
