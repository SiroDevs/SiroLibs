            "number": "4",
            "style": "v",
            "sid": "DEU 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko bohindura abahungu banyu, ntibagendanire Uhoraho, ariko bagasaba izindi mana; ivyo bigatuma uburake bg’Uhoraho bubaziriringira, agaca abarandura ako kanya. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.4",
            "verseOrgIds": [
              "DEU.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
