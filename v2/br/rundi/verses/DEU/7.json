        {
          "text": "Ntimuze musabiranire na bo, ngw abakobga banyu mubahe abahungu babo, cank’ abahungu banyu mubasabire abakobga babo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.3",
            "verseOrgIds": [
