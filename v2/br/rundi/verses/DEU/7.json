        {
          "text": "Ntimuze mubatinye: muze mwibuke ivyo Uhoraho Imana yanyu yagiriye Farawo n’igihugu cose ca Egiputa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.18",
