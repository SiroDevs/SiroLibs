        {
          "text": "Uhoraho Imana yanyu ni yamara kubashikana mu gihugu mugiye kwegukira, agasohora amahanga menshi ngw ababise, Abaheti n’Abagirugashi n’Abamori n’Abanyakanani n’Abaferizi n’Abahiwi n’Abayebusi, amahanga ndwi abarusha ubginshi n’inkomezi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.7.1",
            "verseOrgIds": [
              "DEU.7.1"
            ]
          }
        },
