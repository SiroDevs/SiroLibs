            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muze mwābīre ku vy’umushuzo vyo mu mirima yanyu, ivyo muzokwimburira mu gihugu Uhoraho Imana yanyu abahaye, umuntu wese abishire mu gisimbo, abijane ha hantu Uhoraho Imana yanyu azoba yātoranije ngw ahashire izina ryiwe ngo rihabe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.2",
            "verseOrgIds": [
              "DEU.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Az’ ashikīre umuherezi azoba ariho mur’ ico gihe, amubarire, at’ Uyu musi Uhoraho Imana yawe ndamwaturiye yuko nashitse mu gihugu yarahiye ba sogokuruza bacu kw azokiduha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.3",
            "verseOrgIds": [
              "DEU.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi amwākīrire ico gisimbo, akijane agitereke imbere y’igicaniro c’ Uhoraho Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.4",
            "verseOrgIds": [
              "DEU.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
