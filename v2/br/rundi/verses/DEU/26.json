                {
                  "text": "Gus 4:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Maz’ Uhoraho adukūra muri Egiputa, adukūzayo ukuboko kw’inkomezi kandi kubanguye, n’ibiteye ubgoba bihambaye, n’ibimenyetso n’ibitangaza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.8",
            "verseOrgIds": [
              "DEU.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.8"
              },
              "items": [
                {
                  "text": "Kuv 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araheza atuzana ino, aduha iki gihugu, ar’ igihugu gitemba amata n’ubūki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.9",
            "verseOrgIds": [
              "DEU.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati None nzanye ku vy’umushuzo vyo mu mirima wampaye, ewe Uhoraho. Ukw az’ abe ari kw abitereka imbere y’Uhoraho Imana yiwe, amusenge. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.10",
            "verseOrgIds": [
              "DEU.26.10"
            ]
          }
        },
        {
          "name": "verse",
