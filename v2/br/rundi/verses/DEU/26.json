            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aheze anezererwe ivyiza vyose Uhoraho Imana yiwe yamuhaye, anezeranwe n’abo mu rugo rwiwe, n’Umulewi n’inyambukīra baba i wabo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.11",
