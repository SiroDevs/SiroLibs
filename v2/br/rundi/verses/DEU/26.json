        },
        {
          "text": "Ni mwamara kwinjira igihugu Uhoraho Imana yanyu abahaye kw ishamvu, mukacegukira, mukakibamwo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.1",
            "verseOrgIds": [
              "DEU.26.1"
            ]
          }
        },
