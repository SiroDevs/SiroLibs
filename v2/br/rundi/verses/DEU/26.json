              "items": [
                {
                  "text": "3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze dutakambira Uhoraho Imana ya ba sogokuruza, Uhoraho yumva ugutakamba kwacu, abona amarushwa yacu, n’ ubucumukure bgacu, n’agahahazo turimwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.7",
            "verseOrgIds": [
              "DEU.26.7"
            ]
          }
        },
        {
