            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa wundi akomeze kwaturira imbere y’Uhoraho Imana yiwe, ati Sogokuruza yar’ Umwaramu w’inyererezi; aramanuka, aja muri Egiputa, babayo ar’ imparūrwa; bahindukirayo ihanga rinini rihambaye, ry’isinzi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.5",
            "verseOrgIds": [
              "DEU.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.11"
              },
              "items": [
                {
                  "text": "Kuv 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.1.14"
              },
