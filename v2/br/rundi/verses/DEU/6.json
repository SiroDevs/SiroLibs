            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Uhoraho atubarira kwitondera ayo mabgirizwa yose, no kumwubaha we ubgiwe, Uhoraho Imana yacu, kugira ngo twame mu mahirwe imisi yose, atuzigame atubesheho, nk’uko biri n’uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.24",
            "verseOrgIds": [
              "DEU.6.24"
            ]
          }
        },
        {
          "name": "verse",
