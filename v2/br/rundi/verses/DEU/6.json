            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimukagerageze Uhoraho Imana yanyu, nk’uko mwamugeragereje i Masa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.16",
            "verseOrgIds": [
              "DEU.6.16"
            ]
          }
        },
        {
          "name": "verse",
