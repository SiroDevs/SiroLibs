                "loc": "DEU.11.18"
              },
              "items": [
                {
                  "text": "Gus 11:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.37.31"
              },
              "items": [
                {
                  "text": "Zab 37:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
