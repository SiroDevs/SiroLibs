                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze mugendanire izindi mana, zo mu mana z’amahanga abakikije: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.14",
            "verseOrgIds": [
              "DEU.6.14"
            ]
          }
