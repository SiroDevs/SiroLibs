                "loc": "PRO.30.8"
              },
              "items": [
                {
                  "text": "Imig 30:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.30.9"
              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muze muheze mwirinde, ntimwibagire Uhoraho, yabakūye mu gihugu ca Egiputa, mu nzu y’ubuja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.12",
            "verseOrgIds": [
              "DEU.6.12"
            ]
          }
        },
        {
