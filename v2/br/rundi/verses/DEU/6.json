              },
              "items": [
                {
                  "text": "Zab 119:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mugire umwete wo kwitondera ivyagezwe vy’Uhoraho Imana yanyu, n’ivyo yababariye, n’amabgirizwa yiwe yabagezeko. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.17",
            "verseOrgIds": [
              "DEU.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muze mukore ivyo Uhoraho abona ko bitunganye kandi kw ari vyiza, kugira ngo mumererwe neza, mubone kwinjira ca gihugu ciza Uhoraho yarahiye ba sogokuruza kw azokibaha, mucegukire, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.18",
            "verseOrgIds": [
              "DEU.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni yaheza kwirukana abansi banyu imbere yanyu, nk’uko yavuze.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.19",
            "verseOrgIds": [
              "DEU.6.19"
            ]
          }
        }
      ]
    },
