        },
        {
          "text": "kuk’ Uhoraho Imana yanyu ari hagati muri mwebge ar’ Imana ifūha; kugira ng’ uburake bg’Uhoraho Imana yanyu bgoye kubaziriringira, akabarandura, akabakūra kw isi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.15",
            "verseOrgIds": [
              "DEU.6.15"
            ]
          }
        }
