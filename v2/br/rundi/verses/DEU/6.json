          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.13"
              },
              "items": [
                {
                  "text": "Gus 24:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni twitondera ivyo vyagezwe vyose imbere y’Uhoraho Imana yacu, nk’uko yabitugeze, bizoduharūrwako nk’ukugororoka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.25",
