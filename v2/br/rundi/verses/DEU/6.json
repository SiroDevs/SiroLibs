          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo vyagezwe n’amatēka ashinzwe, Uhoraho Imana yanyu yangeze kubigisha, kugira ngo muze muvyitondere mushitse mu gihugu mugiye kujabukiramwo ngo mucegukire; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.1",
            "verseOrgIds": [
              "DEU.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.128.1"
              },
              "items": [
                {
                  "text": "Zab 128:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.12.13"
              },
              "items": [
                {
                  "text": "Umus 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo mwubahe Uhoraho Imana yanyu, mwitondere amabgirizwa yiwe yose n’ ivyagezwe vyiwe vyose, ivyo mbagera, mwe n’abana banyu n’ abuzukuru banyu, imisi yose y’ ukubaho kwanyu, kugira ngo mubone kuramba. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.2",
            "verseOrgIds": [
              "DEU.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.15.5"
              },
              "items": [
                {
                  "text": "Ita 15:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.22.17"
              },
              "items": [
                {
                  "text": "22:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, yemwe Bisirayeli, ni muvyumve, muvyitondere; kugira ngo mumererwe neza, mugwire cane, muri mu gihugu gitemba amata n’ ubūki, nk’uk’ Uhoraho Imana ya ba sogokuruza yabasezeraniye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.3",
            "verseOrgIds": [
              "DEU.6.3"
            ]
          }
        }
      ]
    },
