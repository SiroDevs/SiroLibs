              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Imana yanyu, ni yamara kubashikana mu gihugu yarahiye ba sogokuruza banyu kw azokibaha, Aburahamu na Isaka na Yakobo, kirimw’ ibisagara binini‐binini vyiza mutubatse, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.10",
            "verseOrgIds": [
              "DEU.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’amazu yuzuye ivyiza vy’uburyo bgose mutāshizemwo, n’ivyobo vyimbiwe kubīka amazi mutimvye, n’imirima y’imizabibu n’imyelayo mutāteye, mukarya, mukāma mu gahimbo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.6.11",
            "verseOrgIds": [
              "DEU.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 6:12"
          },
          "items": [
