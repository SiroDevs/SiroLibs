              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni mwivuganya mu mitima yanyu, mut’ Ijambo Uhoraho atāvuze tuzorimenya dute? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.21",
