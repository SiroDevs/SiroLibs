            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Umulewi ni yava i wanyu ah’ aba, ah’ ari ho hose muri mwebge Abisirayeli, akaja ahantu Uhoraho azoba yātoranije, ashobora kuza ah’ agombeye hose, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.6",
            "verseOrgIds": [
              "DEU.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akore igikorwa c’ubuherezi mw izina ry’Uhoraho Imana yiwe, nk’ ukw ab’i wabo bose b’Abalewi basanzwe bakora, bahagarara ngaho nyene imbere y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.7",
            "verseOrgIds": [
              "DEU.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.31.4"
              },
              "items": [
                {
                  "text": "2 Ngo 31:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.12.44"
              },
              "items": [
                {
                  "text": "Neh 12:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Az’ agire umugabane ungana n’uw’ abandi ku vyo kurya, ukūye ivyo yaguze itongo yarazwe na se.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.8",
            "verseOrgIds": [
              "DEU.18.8"
            ]
          }
        }
