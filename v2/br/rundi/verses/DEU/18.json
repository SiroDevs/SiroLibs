                "loc": "1CO.9.13"
              },
              "items": [
                {
                  "text": "1 Kor 9:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi, ari bo Balewi, mber’ umuryango wa Lewi wose, ntibaze bagire umugabane cank’ ishamvu mu Bisirayeli: ariko baze batungwe n’ibimazi bizanirwa Uhoraho vyo gutōngōrwa n’umuriro, n’ibindi yagerewe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.1",
            "verseOrgIds": [
              "DEU.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibaze bagire ishamvu mu b’i wabo: Uhoraho ni we shamvu yabo, nk’uko yababariye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.2",
            "verseOrgIds": [
              "DEU.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.7.30+LEV.7.31+LEV.7.32+LEV.7.33+LEV.7.34"
              },
              "items": [
                {
                  "text": "Lew 7:30-34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyu az’ abe ari wo uba umwanya w’abaherezi abantu bakwiye kuzohora babakūrira: ūtanze ikimazi, ar’ inka cank’ intama, az’ ahore akūrira umuherezi igikenye c’ukuboko, n’imisaya yompi, n’ umushīshīto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.3",
            "verseOrgIds": [
              "DEU.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.18.12"
              },
              "items": [
                {
                  "text": "Guh 18:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muze muhore mubaha ku vy’umushuzo, ku mpeke zanyu no kuri vino yanyu no ku mavuta yanyu ya elayo, n’ubgoya bg’ītanguye gukemurwa mu ntama zanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.4",
            "verseOrgIds": [
              "DEU.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.12"
              },
              "items": [
                {
                  "text": "Gus 17:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ari bo Uhoraho Imana yanyu yatoranije mu miryango yanyu yose, kugira ngo baze bahore bakora igikorwa c’ubuherezi mw izina ryiwe, bo n’uruvyaro rwabo, ibihe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.5",
            "verseOrgIds": [
              "DEU.18.5"
            ]
          }
        }
      ]
    },
