            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.29+DEU.12.30+DEU.12.31"
              },
              "items": [
                {
                  "text": "Gus 12:29-31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwamara gushika mu gihugu Uhoraho Imana yanyu abaha, ntimuze mwige gukora ivy’ ibizira ayo mahanga akora. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.9",
            "verseOrgIds": [
              "DEU.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
