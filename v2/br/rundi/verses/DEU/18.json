                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bizoba nk’uko mwabisavye Uhoraho Imana yanyu mur’ i Horebu, kuri wa musi mwari mukoranye, aho mwavuga, muti Ntidusubire kwumva ijwi ry’Uhoraho Imana yacu, no kubona urya muriro uhambaye, ntiduhave dupfa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.18.16",
            "verseOrgIds": [
              "DEU.18.16"
            ]
          }
        },
