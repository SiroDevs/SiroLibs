              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’i Tabera, n’i Masa, n’i Kiburoti‐hatava, mwaharakirije Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.22",
