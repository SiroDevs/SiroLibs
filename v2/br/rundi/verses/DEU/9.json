                "loc": "EXO.32.31"
              },
              "items": [
                {
                  "text": "Kuv 32:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.10.10"
              },
              "items": [
                {
                  "text": "Gus 10:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.23"
              },
              "items": [
                {
                  "text": "Zab 106:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nikubita hasi imbere y’Uhoraho nk’ubga mbere, mmara imisi mirongwine n’amajoro mirongwine, ata co ntamira, ata n’amazi nnywa, mbitewe n’ico caha gikomeye mwakoze, co gukora ico Uhoraho abona kw ari kibi, mukamuratsa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.18",
            "verseOrgIds": [
              "DEU.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.14"
              },
              "items": [
                {
                  "text": "Kuv 32:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko natinya uburake n’ubushangashirwe Uhoraho yar’ abafitiye, vyatuma agomba kubarandura. Arik’ Uhoraho aranyumvira no mur’ ico gihe na co. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.19",
            "verseOrgIds": [
              "DEU.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Uhoraho arakira Aroni cane, bituma agomba kumwica; ariko na we n’uko nca ndamusabira mur’ ico gihe nyene. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.20",
            "verseOrgIds": [
              "DEU.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.20"
              },
              "items": [
                {
                  "text": "Kuv 32:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaheza nābīra bga buyobe bganyu, ya masa mwacuze, ndayiturira, ndayisekura ndayinoza, kugeza icitse ifu; mmēmēra ifu yayo mu kagezi kamanuka kava kuri wa musozi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.21",
            "verseOrgIds": [
              "DEU.9.21"
            ]
          }
        }
