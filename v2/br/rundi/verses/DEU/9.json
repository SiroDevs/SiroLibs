            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngw abo mu gihugu wadukūyemwo boye kuvuga, bat’ Uhoraho vyaramunaniye kubashikana mu gihugu yabasezeraniye, kand’ arabanka; bati Ni co catumye abakūra ino, ngw abatsinde mu bugaragwa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "verse",
