                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukugororoka kwanyu canke gutungana kw imitima yanyu si vyo bizoba bitumye mwinjira igihugu cabo ngo mucegukire; arik’ ukugabitanya kw’ayo mahanga ni kwo kuzoba gutumye Uhoraho Imana yanyu abirukana imbere yanyu, kugira ngw ashitse ijambo yarahiye ba sogokuruza banyu, Aburahamu na Isaka na Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.5",
            "verseOrgIds": [
              "DEU.9.5"
            ]
          }
        },
        {
          "name": "verse",
