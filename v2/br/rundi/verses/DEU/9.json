              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mmara iyo misi ukw ari mirongwine n’amajoro mirongwine nubamye imbere y’Uhoraho, kuk’ Uhoraho yar’ avuze kw azobarandura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.32.11+EXO.32.12+EXO.32.13"
              },
              "items": [
                {
                  "text": "Kuv 32:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsaba Uhoraho, nti Mwami Uhoraho, nturandure abantu bawe, ari bo cibare cawe, abo warokoje ububasha bgawe, ukabakūza muri Egiputa ukuboko kw’inkomezi kandi kuramvuye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wibuke abasavyi bawe, Aburahamu na Isaka na Yakobo; nturābe ukutagondwa kw’aba bantu, cank’ ukugabitanya kwabo, cank’ icaha cabo; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
              "DEU.9.27"
            ]
          }
        },
