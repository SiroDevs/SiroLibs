        },
        {
          "text": "Maz’ Uhoraho arambarira, ati Va hasi, uve hano, umanuke vuba, kuko ba bantu bawe wakūye muri Egiputa bamaze kwononekara; inzira nabageze bayitaye ata n’akanya, bironkeye igishushanyo bakivugutiye mu nkero. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.12",
            "verseOrgIds": [
              "DEU.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
