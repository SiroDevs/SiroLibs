              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi na ca gihe Uhoraho yabarungika ngo muve i Kadeshi‐baruneya, ati Ni mudūge, mwinjire igihugu mbahaye; na ho nyene mwagararije ico Uhoraho Imana yanyu yabagezeko, ntimwamwizera canke ngo mwumvire ijwi ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
