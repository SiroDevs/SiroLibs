              },
              "items": [
                {
                  "text": "Gus 31:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere mwagiye mugarariza Uhoraho, uhereye ku musi natanguriyeko kubamenya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.24",
            "verseOrgIds": [
              "DEU.9.24"
            ]
          }
        }
