              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho arongera arambarira, at’ Abo bantu ndababonye ico barimwo: n’ abantu batagonda izosi; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.13",
            "verseOrgIds": [
