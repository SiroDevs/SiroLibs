            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero mumenye yuk’ ukugororoka kwanyu atari kwo kuzotuma Uhoraho Imana yanyu abaha ico gihugu ciza ngo mucegukire; kuko mur’ abantu batagonda izosi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.6",
