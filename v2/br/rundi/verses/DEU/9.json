            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho araheza ampa ivyo bisate vy’amabuye, vyanditsweko n’urutoke rw’ Imana amajambo yose Uhoraho yababaririye kuri wa musozi, ayavugiye mu muriro, kuri wa musi mwari mukoranye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.10",
            "verseOrgIds": [
              "DEU.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo misi mirongwine n’amajoro mirongwine bishize, ni ho Uhoraho yampaye ivyo bisate vy’amabuye, ari vyo vyarikw iryo sezerano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.11",
            "verseOrgIds": [
              "DEU.9.11"
            ]
