        {
          "text": "pfa kundeka gusa, nzimirize izina ryabo musi y’ijuru, nawe ndaguhindure ihanga rizobarusha inkomezi n’ubginshi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.14",
            "verseOrgIds": [
              "DEU.9.14"
            ]
          }
