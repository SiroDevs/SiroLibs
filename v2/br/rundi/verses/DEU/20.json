                "loc": "DEU.1.30"
              },
              "items": [
                {
                  "text": "Gus 1:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.22"
