          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.4",
            "verseOrgIds": [
              "DEU.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abakuru baze babaze abantu, bati Ni nde ari hano yubatse inzu nsha, akaba atarayinjira? N’agende asubire i muhira, ntahave agwa mu ntambara, uwundi akaba ari we ayinjira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.5",
            "verseOrgIds": [
              "DEU.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni nde ari hano yateye uruzabibu, akaba ataratamira ku nzabibu zarwo? N’agende asubire i muhira, ntahave agwa mu ntambara, uwundi akaba ari we azorya inzabibu zarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.6",
            "verseOrgIds": [
              "DEU.20.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni nde ari hano yasavye umugeni, akaba ataramurongora? N’agende asubire i muhira, ntahave agwa mu ntambara, uwundi akaba ari we azomurongora. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.7",
            "verseOrgIds": [
              "DEU.20.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.7.3"
              },
              "items": [
                {
                  "text": "Abac 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakuru bongere babaze abantu, bati Ni nde ari hano atinye, arandutse umutima? N’agende asubire i muhira, imitima ya bagenzi be ntihave isha cōba nk’uwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.8",
            "verseOrgIds": [
              "DEU.20.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakuru ni bamara kubarira abantu ivyo, baze bashireh’ abagabisha b’ingabo bo kurōngōra abantu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.9",
            "verseOrgIds": [
              "DEU.20.9"
            ]
          }
        }
      ]
