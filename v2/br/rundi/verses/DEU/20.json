                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ Uhoraho Imana yanyu ari we ajanye namwe, ngw abarwanire n’abansi banyu, abahe kunesha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.4",
            "verseOrgIds": [
              "DEU.20.4"
            ]
          }
        }
