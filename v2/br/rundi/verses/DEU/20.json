                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu bisagara vy’aya mahanga y’ino, aho Uhoraho Imana yanyu ibahaye kw ishamvu, ntimuze mukize ikintu na kimwe gihūmēka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.16",
            "verseOrgIds": [
              "DEU.20.16"
            ]
          }
        },
        {
