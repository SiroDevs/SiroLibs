                  "text": "Yos 8:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arikw abagore n’abana, n’amasho, n’ibiri mur’ ico gisagara vyose, iminyago yaho yose n’isahu, muvyitwarire, murye ivyo mwanyaze abansi banyu, ivyo Uhoraho Imana yanyu yabahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.14",
            "verseOrgIds": [
              "DEU.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukw az’ abe ari ko muzogenza ibisagara biri kure yanyu bibītāngūye, bitar’ ivy’ aya mahanga y’ino. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.15",
            "verseOrgIds": [
              "DEU.20.15"
            ]
          }
        },
        {
