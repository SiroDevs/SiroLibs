              "items": [
                {
                  "text": "2 Sam 20:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwashika hafi y’igisagara, mugiye kugitera, muze mubarire abo muri co ngo babakomere amashi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.10",
            "verseOrgIds": [
              "DEU.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.21"
              },
              "items": [
                {
                  "text": "1 Abam 9:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ni bemera kubakomera amashi, bakabūgururira, abari muri co bose muze mubashinge ibikebere, babakorere. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.11",
            "verseOrgIds": [
              "DEU.20.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni banka kubakomera amashi, bakagomba kurwana namwe, muze muziguze ico gisagara; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.12",
            "verseOrgIds": [
              "DEU.20.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.31.7"
              },
              "items": [
                {
                  "text": "Guh 31:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ Uhoraho Imana yanyu ni yakigabura mu maboko yanyu, muze mwicishe inkota uw’ izinamuhungu wese wo muri co; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.20.13",
            "verseOrgIds": [
              "DEU.20.13"
            ]
          }
        },
        {
