            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibiri mw ijuru, ngo muvuge, muti Ni nde yotudūgira mw ijuru, kugira ngw abituzanire, ngo tuvyumvire, tuvyitondere? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.12",
            "verseOrgIds": [
              "DEU.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntibiri hakurya y’ikiyaga, ngo muvuge, muti Ni nde yotujabukira ikiyaga, ngw abituzanire, ngo tuvyumvire, tuvyitondere? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.13",
            "verseOrgIds": [
              "DEU.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.10.8"
              },
              "items": [
                {
                  "text": "Rom 10:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw iryo jambo riri hafi yanyu cane, mbere riri mu kanwa kanyu no mu mitima yanyu, ngo mubone kuryitondera.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.14",
            "verseOrgIds": [
              "DEU.30.14"
            ]
          }
        }
