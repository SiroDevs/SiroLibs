            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe rāba, uyu musi mbashize imbere ubugingo n’amahirwe, bo n’urupfu n’amagorwa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.15",
            "verseOrgIds": [
              "DEU.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuk’ uyu musi mbabariye gukunda Uhoraho Imana yanyu, no kugendera mu nzira ziwe, no kwitondera ivyagezwe vyiwe n’amabgirizwa yiwe n’amatēka yashinze, kugira ngo mubone kubaho, mugasāre, Uhoraho Imana yanyu abahēre umugisha mu gihugu mugiye kwinjira ngo mucegukire. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.16",
            "verseOrgIds": [
              "DEU.30.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 30:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni mwakikama mu mitima yanyu, mukanka kwumvira, mukemera inyosha, mugasenga izindi mana, mukazisaba, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.17",
            "verseOrgIds": [
              "DEU.30.17"
            ]
          }
        },
