            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Uhoraho Imana yanyu azobasesekariza ivyiza mu bikorwa vyanyu vyose, agwize uruvyaro rwo mu nda zanyu, n’urwo mu masho yanyu, n’imirima yo mu ndimiro zanyu; kuk’ Uhoraho azokwongera kunezererwa kubagirira neza, nk’uko yanezererwa ba sogokuruza, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.9",
            "verseOrgIds": [
              "DEU.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "namba muzoba mwumviye Uhoraho Imana yanyu, mukitondera ivyagezwe n’ amabgirizwa vyanditswe mur’ iki gitabo c’ivyagezwe, mukamuhindukirira, mukamurondeza imitima yanyu yose n’ubugingo bganyu bgose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.10",
            "verseOrgIds": [
              "DEU.30.10"
            ]
          }
        }
      ]
