                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mugahindukirira Uhoraho Imana yanyu, mukamwumvira muri vyose, nk’ uko mbibagera uyu musi, mwe n’abana banyu, mumwumvirishije imitima yanyu yose n’ubugingo bganyu bgose; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.2",
            "verseOrgIds": [
              "DEU.30.2"
            ]
          }
        },
        {
