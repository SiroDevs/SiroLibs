            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyo vyagezwe mbageze uyu musi atar’ ivyo kubananira, kand’ atar’ ibiri kure. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.30.11",
