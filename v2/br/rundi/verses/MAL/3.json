              "items": [
                {
                  "text": "Ivyak 7:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye mu bihe vya ba sogokuruza muhora mukevya mugata amabgirizwa yanje, ntimuyitondere. Ni mungarukeko, nanje nzobagarukako, ni k’Uhoraho Nyen’ ingabo agize. Yamara muravuga, muti Twogaruka mu buryo ki? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.10"
              },
              "items": [
                {
                  "text": "Neh 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ umuntu yogunga Imana? Ariko mwebge mwarangunze. Yamara muravuga, muti Twakugunze ibiki? Mwangunze ikigiracumi n’amashikanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muvumo murawuvumwe: kukw ihanga ryose uko mungana mwangunze. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.7.11"
              },
              "items": [
                {
                  "text": "Ita 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.3.9"
              },
              "items": [
                {
                  "text": "Imig 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
