            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw Abadani ni kwo gutwara ivyo Mika yari yarironkeye, bo n’umuherezi yar’ afise, bashika i Layishi, mu bantu bitekerereje ata co bīnona, babīcisha inkota, baturira n’igisagara cabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.27",
            "verseOrgIds": [
              "JDG.18.27"
            ]
          }
        },
        {
