              "type": "text"
            }
          ]
        },
        {
          "text": "Bacita Dani, bacitiranije na sekuruza wabo Dani mwene Isirayeli; arik’ ubga mbere ico gisagara citwa Layishi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.29",
            "verseOrgIds": [
              "JDG.18.29"
            ]
          }
        },
