                {
                  "text": "2 Sam 10:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntihāgira gitabara, kuko hāri kure y’i Sidoni, kand’ abaho ntibāri bīfatanije n’umuntu wundi n’ umwe. Aho hantu hāri mu kiyaya gihereranye n’i Beti‐rehobu. Maz’ Abadani basanura ico gisagara, bakibamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.28",
            "verseOrgIds": [
              "JDG.18.28"
            ]
          }
        },
