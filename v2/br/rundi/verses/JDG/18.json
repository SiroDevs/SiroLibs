                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bantu ukw ari batanu baragenda, bashika i Layishi, bitegereza abantu baho, babona ingene bīrāye nk’ukw ab’ i Sidoni basanzwe bamera, bitekerereje ata co bīnona, ata co babuze mur’ ico gihugu, bifitiye ubutunzi; babona n’ingene baba kure y’ab’i Sidoni, n’ingene batifatanya n’umuntu wundi n’umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.7",
            "verseOrgIds": [
              "JDG.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo batasi bahindukiye mu b’i wabo i Sora n’i Eshitayoli, barababaza, bati Muzanye inkuru ki? ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.18.8",
            "verseOrgIds": [
              "JDG.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.14.7"
              },
              "items": [
                {
                  "text": "Guh 14:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.2.23"
              },
              "items": [
                {
                  "text": "Yos 2:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
