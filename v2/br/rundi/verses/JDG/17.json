                "loc": "1SA.15.13"
              },
              "items": [
                {
                  "text": "1 Sam 15:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarira nyina, ati Za shekeli z’ifeza igihumbi n’ijana wari wibge, nkumva uvumana, ni jewe nazitwaye, ndazifise. Nyina aravuga, at’ Uragahezagirwa n’ Uhoraho, mwana wanje! ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.2",
            "verseOrgIds": [
              "JDG.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.4"
              },
              "items": [
                {
                  "text": "Kuv 20:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.17"
              },
              "items": [
                {
                  "text": "34:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.4"
              },
              "items": [
                {
                  "text": "Lew 19:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw asubiza nyina izo shekeli z’ ifeza igihumbi n’ijana; nyina aravuga, at’ Izi feza ndazēguriye Uhoraho ngo zibe izera, kugira ng’ uzironderemw’ igishushanyo kibājwe n’igishushanyo kivugutiye mu nkero, mwana wanje: none rero ndaziguhaye. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.3",
            "verseOrgIds": [
              "JDG.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.46.6"
              },
              "items": [
                {
                  "text": "Yes 46:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw amaze gusubiza nyina izo feza, nyina ahitanamw’ amajana abiri, aziha umucuzi, azikūramw’ igishushanyo kibājwe n’igishushanyo kivugutiye mu nkero; babishira mu nzu ya Mika. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.4",
            "verseOrgIds": [
              "JDG.17.4"
            ]
          }
        },
