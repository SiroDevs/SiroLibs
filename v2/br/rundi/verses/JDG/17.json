            }
          ]
        },
        {
          "text": "Uwo mugabo Mika yar’ afise akanyabugoro k’ibigirwamana; arondeza umwambaro witwa efodi na terafimu,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.5",
            "verseOrgIds": [
              "JDG.17.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "17:5",
              "type": "text"
            },
            {
              "text": "Terafimu cār’ igihēko c’urugo.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yirobanurira umwe mu bahungu biwe ngw amubere umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.5",
            "verseOrgIds": [
              "JDG.17.5"
            ]
          }
        },
        {
