            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mur’ iyo misi Abisirayeli nta mwami bāribgagire: umuntu wese yakora ico yigombeye.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.17.6",
