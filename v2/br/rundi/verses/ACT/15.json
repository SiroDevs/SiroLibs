        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ intumwa n’abakuru, bo n’ishengero ryose, bashima gutoranya abagabo muri bo, ni Yuda ari we Barusaba, na Sila, abantu bakuru muri bene Data, no kubatumana muri Antiyokiya na Paulo na Barunaba: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.22",
            "verseOrgIds": [
              "ACT.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "bandika icete, barakibarungikana, canditswe girtya, ngw Intumwa na bene Data bakuru turabatasha mwebge bene Data bo mu banyamahanga bari muri Antiyokiya n’i Siriya n’i Kilikiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.23",
            "verseOrgIds": [
              "ACT.15.23"
            ]
          }
        },
