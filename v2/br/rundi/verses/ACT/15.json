                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashize imisi, Paulo abgira Barunaba, at’ Ingo dusubire ha handi tugendere bene Data mu gisagara cose aho twāvuze ijambo ry’Umwami Yesu, tumenye uko bameze. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.36",
            "verseOrgIds": [
              "ACT.15.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
