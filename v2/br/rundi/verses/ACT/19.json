              "ACT.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.14.3"
              },
              "items": [
                {
                  "text": "Ivyak 14:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Imana ikoresha amaboko ya Paulo ibitangaza vy’agaheta: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.11",
            "verseOrgIds": [
              "ACT.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.15"
              },
              "items": [
                {
                  "text": "Ivyak 5:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "vyatuma bashīra abarwaye ibitambara n’ivyambazo bivuye ku mubiri wiwe, bagakira indwara zabo, impwemu zihumanye zikabavamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.12",
            "verseOrgIds": [
              "ACT.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.49"
              },
              "items": [
                {
                  "text": "Luk 9:49",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw inyererezi zimwe zo mu Bayuda zāsenda impwemu zihumanye zīgerera kuvugira izina ry’Umwami Yesu hejuru y’abatewe n’impwemu zihumanye, ziti Tubarahiye Yesu, uwo Paulo avuga. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.13",
            "verseOrgIds": [
              "ACT.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hārih’ abahungu ndwi b’Umuyuda yitwa Sikewa, umwe mu baherezi bakuru, bāgenza bartyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.14",
            "verseOrgIds": [
              "ACT.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.34"
              },
              "items": [
                {
                  "text": "Mrk 1:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.41"
              },
              "items": [
                {
                  "text": "Luk 4:41",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Impwemu ihumanye irabishura, iti Yesu ndamuzi, na Paulo ndamuzi, ariko mweho muri ba nde? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.15",
            "verseOrgIds": [
              "ACT.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu arimw’ impwemu ihumanye abagurukirako bompi, arabanesha, arababirika, bahunga mur’ iyo nzu bambaye ubusa bakomeretse. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.16",
            "verseOrgIds": [
              "ACT.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.5"
              },
              "items": [
                {
                  "text": "Ivyak 5:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bimenyekana mu Bayuda no mu Bagiriki bose baba muri Efeso, bose baterwa n’ubgoba, izina ry’Umwami Yesu rishirwa hejuru. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.17",
            "verseOrgIds": [
              "ACT.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi benshi mu bari barizeye baraza, bātura ivyo bākoze, barabiserura. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.18",
            "verseOrgIds": [
              "ACT.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benshi no mu bakora ivy’ ubupfumu bakoranya ibitabo vyabo vy’ubupfumu, babituririra mu maso ya bose: baharūra igiciro cavyo, basanga gishitse ku ntete z’ifeza ibihumbi mirongwitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.19",
            "verseOrgIds": [
              "ACT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.7"
              },
              "items": [
                {
                  "text": "Ivyak 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.12.24"
              },
              "items": [
                {
                  "text": "12:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni kw ijambo ry’Umwami Yesu ryagwiriye cane, rigira ububasha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.20",
            "verseOrgIds": [
              "ACT.19.20"
            ]
          }
        }
      ]
    },
