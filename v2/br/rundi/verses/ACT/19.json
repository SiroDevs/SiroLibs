              "items": [
                {
                  "text": "Rom 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bishize Paulo agabira mu mutima wiwe guca i Makedoniya no muri Akaya aja i Yerusalemu, ati Ni namara gushikayo, nkwiye kuja kurāba n’i Roma na ho. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.21",
            "verseOrgIds": [
              "ACT.19.21"
            ]
          }
        },
        {
