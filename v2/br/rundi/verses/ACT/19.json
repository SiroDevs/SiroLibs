              },
              "items": [
                {
                  "text": "1 Kor 4:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuma abāgenda bamukorera babiri, Timoteyo na Erasito, ngo baje i Makedoniya; ariko we, atebera muri Asiya imisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.19.22",
            "verseOrgIds": [
              "ACT.19.22"
            ]
          }
        }
      ]
