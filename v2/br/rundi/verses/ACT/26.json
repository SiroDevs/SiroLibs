              "items": [
                {
                  "text": "Ivyak 25:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agiripa abarira Fesito, at’ Uyu muntu aba arekuwe, iy’ ataba yar’ agomvye kuzokwitwara kuri Kayisari.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.32",
