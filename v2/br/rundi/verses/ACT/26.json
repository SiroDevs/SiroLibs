          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.30"
              },
              "items": [
                {
                  "text": "Ivyak 21:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.31"
              },
              "items": [
                {
                  "text": "31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye Abayuda bamfatira mu rusengero, bakageza kunyica. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.21",
            "verseOrgIds": [
              "ACT.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.44+LUK.24.45+LUK.24.46+LUK.24.47"
              },
              "items": [
                {
                  "text": "Luk 24:44-47",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None nabonye gutabarwa kwavuye ku Mana, ndacahagaze kugeza n’ubu, nshingira intahe aboroshe n’abahambaye, nta kindi mvuga atar’ ivy’ abāvugishwa n’Imana na Mose bāvuze ko bizoba, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.22",
            "verseOrgIds": [
              "ACT.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.20"
              },
              "items": [
                {
                  "text": "1 Kor 15:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yuko Kristo atazobura kubabazwa, kandi kw ari we azobanza kuzuka mu bapfuye, no kubgira ubgoko bgacu n’abanyamahanga ubutumwa bg’umuco.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.23",
            "verseOrgIds": [
              "ACT.26.23"
            ]
          }
        }
      ]
