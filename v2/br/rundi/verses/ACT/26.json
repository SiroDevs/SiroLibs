                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko va hasi, hagarara n’ibirenge vyawe: kukw igitumye nkwiyereka, ar’ukugira ngo ngutoranye nkugire umukozi wanje n’icabona co gushingira intahe ivy’ umbonanye, n’ivyo nzokwiyerekeramwo; ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.16",
            "verseOrgIds": [
              "ACT.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
