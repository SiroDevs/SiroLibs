          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.3.8"
              },
              "items": [
                {
                  "text": "Mat 3:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nabanje kubgira ab’i Damasiko hanyuma ab’i Yerusalemu, n’abo mu gihugu cose c’i Yudaya, n’abanyamahanga na bo, yuko bakwiye kwihana, no guhindukirira Imana, bakore ibikorwa bikwiranye n’ukwihana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.20",
            "verseOrgIds": [
              "ACT.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
