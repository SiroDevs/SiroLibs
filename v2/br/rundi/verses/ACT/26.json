                "loc": "JER.1.7"
              },
              "items": [
                {
                  "text": "Yer 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.16.35"
              },
              "items": [
                {
                  "text": "1 Ngo 16:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndagukize abo mur’ ubu bgoko bo n’abanyamahanga, ni bo ngutumyeko, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.26.17",
            "verseOrgIds": [
              "ACT.26.17"
            ]
          }
        },
