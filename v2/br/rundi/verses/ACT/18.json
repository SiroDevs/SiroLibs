              "items": [
                {
                  "text": "Ivyah 3:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo yari yigishijwe inzira y’Umwami wacu, acānīrwa mu mutima n’umwete, yavuga yigisha ivya Yesu avyitondeye, yar’ azi umubatizo wa Yohana gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.25",
            "verseOrgIds": [
              "ACT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
