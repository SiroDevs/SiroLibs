            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afashe i Kayisariya, aradūga aja i Yerusalemu, aramutsa ishengero, aramanuka, aja muri Antiyokiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
