          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amazey’ imisi avayo, aca mu gihugu c’i Galatiya n’i Furugiya, aja mu bisagara uko bikurikirana, aremesha abigishwa bose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
