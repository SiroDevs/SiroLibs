              "items": [
                {
                  "text": "Yak 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw asezerana na bo, ati Nzogaruka ikindi gihe, Imana ni yabigomba. Avuduka muri Efeso ari mu bgato.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
            "verseOrgIds": [
              "ACT.18.21"
            ]
          }
        }
