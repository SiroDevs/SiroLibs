              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agomvye kujabuka ngw aje muri Akaya, bene Data baramuremesha, bandikira abigishwa ngo bamwākīre. Na we ashitseyo, ubuntu bg’Imana bumutera gufasha cane abizeye: ",
          "type": "text",
          "attrs": {
