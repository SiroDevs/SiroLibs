            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ashika i Derube n’i Lusitira; hāriy’ umwigishwa yitwa Timoteyo, umwana w’Umuyudakazi umugore yizeye, ariko se yar’ Umugiriki: ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.3"
              },
              "items": [
                {
                  "text": "Ivyak 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yashimwa na bene Data b’i Lusitira no muri Ikoniyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uyo, Paulo agomba ko bajana, aramwābīra aramukeba, kubg’ Abayuda bo mur’ izo ntāra, kuko bose bāri bazi yuko se yar’ Umugiriki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.3",
            "verseOrgIds": [
              "ACT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.23+ACT.15.24+ACT.15.25+ACT.15.26+ACT.15.27+ACT.15.28+ACT.15.29"
              },
              "items": [
                {
                  "text": "Ivyak 15:23-29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bariko baraca mu bisagara, bagenda bababgira ivyo intumwa n’abakuru b’i Yerusalemu bāshinze, ngo bavyitondere. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw amashengero akomerezwa mu kwizera, agenda yunguka ibitigiri imisi yose.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
