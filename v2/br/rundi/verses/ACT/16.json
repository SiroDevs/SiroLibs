          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba shebuja babonye yukw ico bazigakw inyungu kivuyeho, bafata Paulo na Sila, barabakwega babajana mu kaguriro imbere y’abashingantahe, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.19",
            "verseOrgIds": [
              "ACT.16.19"
            ]
          }
        },
        {
