              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyo bishavuza Yona cane, araraka. ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.1",
            "verseOrgIds": [
              "JON.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
