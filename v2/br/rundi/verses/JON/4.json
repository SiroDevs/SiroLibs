                "loc": "JON.3.7"
              },
              "items": [
                {
                  "text": "Yon 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "none jewe sinari nkwiye kugirira ikibabarwe Ninewe, ico gisagara kinini, kirimw’ abantu ibihumbi ijana na mirongwibiri basāga, batazi gutandukanya ukuryo n’ukumoso; hakabamwo n’ibitunzwe vyinshi?",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
