              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo Yosefu Umunyarimataya, yar’ umwigishwa wa Yesu, ariko mu mpisho, kubgo gutinya Abayuda, yaka Pilato ikiziga ca Yesu ngw akijane: Pilato aremera; nukw araza ajana ikiziga ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.38",
            "verseOrgIds": [
              "JHN.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
