                "loc": "PSA.34.20"
              },
              "items": [
                {
                  "text": "Zab 34:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyo vyabayeho kugira ngw icanditswe gishike, ngo Nta n’igufa ryiwe rizovunwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.36",
            "verseOrgIds": [
              "JHN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 19:37"
          },
          "items": [
