              "items": [
                {
                  "text": "Zab 22:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo Yesu amenye yuko noneho vyose birangiye, kugira ngw icanditswe gishike, aravuga, ati Mfise inyota. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.28",
            "verseOrgIds": [
              "JHN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.69.21"
              },
              "items": [
                {
                  "text": "Zab 69:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu hari hateretse inkono yuzuye inkarisha, nuko bashira sipongo",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:29",
              "type": "text"
            },
            {
              "text": "sipongo n’ikintu kimeze nk’icangwe, ni co gikuyabeza.",
              "type": "text"
            }
          ]
        },
        {
          "text": " yuzuyemw’ inkarisha kw irenga, bayirungika ku munwa wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.29",
            "verseOrgIds": [
              "JHN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amaze kuyihabga, aravuga, ati Birarangiye. Araheza ajondamika umutwe, umutima uraca.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.30",
            "verseOrgIds": [
              "JHN.19.30"
            ]
          }
        }
      ]
