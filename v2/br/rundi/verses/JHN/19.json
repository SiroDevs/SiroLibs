                "loc": "EXO.12.46"
              },
              "items": [
                {
                  "text": "Kuv 12:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.9.12"
              },
              "items": [
                {
                  "text": "Guh 9:12",
                  "type": "text"
                }
              ]
