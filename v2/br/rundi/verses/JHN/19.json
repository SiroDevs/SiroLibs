              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.12.10"
              },
              "items": [
                {
                  "text": "Zek 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.1.7"
              },
              "items": [
                {
                  "text": "Ivyah 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi har’ ikindi canditswe, kivuga ngo Bazobona uwo bācumise.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.37",
            "verseOrgIds": [
              "JHN.19.37"
            ]
          }
        }
