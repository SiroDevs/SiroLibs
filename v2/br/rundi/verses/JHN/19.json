              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.2"
              },
              "items": [
                {
                  "text": "Yoh 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.2.11"
              },
              "items": [
                {
                  "text": "Mat 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi haza na Nikodemo, umwe yaza kuri Yesu mw ijoro ubga mbere, azana ikivange c’isenga n’imbazi nk’ibilo mirongwitanu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.39",
            "verseOrgIds": [
