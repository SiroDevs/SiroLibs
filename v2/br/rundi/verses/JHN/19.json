              "JHN.19.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.17.7"
              },
              "items": [
                {
                  "text": "Ivyak 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye aho Pilato arondera uburyo bg’uko yomurekura, arikw Abayuda barasemerera, bati Ni warekura uyo, ntuzoba ucuzura na Kayisari, kuk’ uwīgira umwami wese aba agararije Kayisari. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.12",
            "verseOrgIds": [
              "JHN.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Pilato yumvise ayo magambo, asohora Yesu, yicara ku ntebe y’imanza, yar’ ahantu hitwa Musezero w’amabuye, mu Giheburayo hitwa Gabata. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.13",
            "verseOrgIds": [
              "JHN.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "War’ umusi wo kwitegurira Pasika, hari nk’isaha zitandatu. Abgira Abayuda, at’ Ehe rāba umwami wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.14",
            "verseOrgIds": [
              "JHN.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.19.6"
              },
              "items": [
                {
                  "text": "Yoh 19:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo barasemerera, bati Mukūreho, mukūreho, umubambe. Pilato arababaza, ati Mbambe umwami wanyu? Abaherezi bakuru bati Nta mwami dufise, atari Kayisari. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.19.15",
            "verseOrgIds": [
              "JHN.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.31+MAT.27.32+MAT.27.33+MAT.27.34+MAT.27.35+MAT.27.36+MAT.27.37+MAT.27.38+MAT.27.39+MAT.27.40+MAT.27.41+MAT.27.42+MAT.27.43+MAT.27.44+MAT.27.45+MAT.27.46+MAT.27.47+MAT.27.48+MAT.27.49+MAT.27.50"
              },
              "items": [
                {
                  "text": "Mat 27:31-50",
