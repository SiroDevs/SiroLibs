          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.26"
              },
              "items": [
                {
                  "text": "Yoh 14:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.27"
              },
              "items": [
                {
                  "text": "1 Yoh 2:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uwo Mpwemu w’ukuri ni yaza, azobarōngōra abashitse ku kuri kwose, kukw atazovuga ivyo yigeneye, arikw ivy’ azokwumva vyose ni vyo azovuga, kand’ azobamenyesha ibigira bize. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.13",
            "verseOrgIds": [
              "JHN.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo azoshimagiza jewe, kukw azokwābīra ku vyanje, akabibamenyesha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.14",
            "verseOrgIds": [
              "JHN.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.10"
              },
              "items": [
                {
                  "text": "Yoh 17:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo Data afise vyose n’ivyanje, ni co gitumye mvuga, nti Yābīra ku vyanje, akabibamenyesha.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.15",
            "verseOrgIds": [
              "JHN.16.15"
            ]
          }
        }
