            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivy’ ukugororoka, kuko nja kwa Data, kandi namwe muzoba mutakimbona, ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.10",
            "verseOrgIds": [
              "JHN.16.10"
            ]
          }
