          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuye kwa Data, nza mw isi; ikindi, isi ndiko ndayivamwo, nje kwa Data.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.28",
