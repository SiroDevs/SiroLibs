            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo mbibabgiriye mu migani, arikw igihe kizoza sinzoba ngisubira kuvuganira namwe mu migani, mugabo nzobabgira ivya Data mbifoboye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.25",
            "verseOrgIds": [
