              "items": [
                {
                  "text": "Yoh 15:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugeza ubu nta co mwasavye mw izina ryanje; musabe muzohabga, ng’umunezero wanyu wuzuzwe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.24",
