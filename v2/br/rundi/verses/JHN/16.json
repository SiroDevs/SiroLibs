              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa biwe baravuga, bat’ Ubuho urabifoboye, nta mugani uduciriye. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.29",
