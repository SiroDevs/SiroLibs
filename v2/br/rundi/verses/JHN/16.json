            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko jewe ndababgira ukuri: Ikizogira ico kibamarira, n’uko jewe ngenda; kuko ni ntagenda, Umwitsa ntazoza kuri mwebge: ariko ni nagenda nzomubarungikira. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.7",
            "verseOrgIds": [
              "JHN.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
