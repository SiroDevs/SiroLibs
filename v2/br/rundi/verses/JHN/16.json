            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nari ngifise vyinshi vyo kubabgira, ariko ntimushobora kuvyihanganira ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.12",
            "verseOrgIds": [
              "JHN.16.12"
            ]
          }
        },
