                "loc": "JHN.14.30"
              },
              "items": [
                {
                  "text": "14:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivy’ amateka, kuk’ umwami w’iyi si yaciriwekw iteka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.11",
            "verseOrgIds": [
              "JHN.16.11"
            ]
          }
        }
      ]
