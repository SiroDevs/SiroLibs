              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubuho tumenye k’uzi vyose, kandi ko kubgawe utarinda ko hogira ūkubaza; ni co gituma twizera ko waturutse ku Mana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.30",
            "verseOrgIds": [
