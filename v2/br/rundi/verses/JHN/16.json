        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.14.24"
              },
              "items": [
                {
                  "text": "1 Kor 14:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
