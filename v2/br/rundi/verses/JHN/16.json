              },
              "items": [
                {
                  "text": "Yoh 14:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Data na we ubgiwe abakunda, kuko mwankunze kandi mwizeye ko naturutse ku Mana. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.16.27",
            "verseOrgIds": [
              "JHN.16.27"
            ]
          }
        },
