                "loc": "1CO.5.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ akwiye gushingirwa intahe neza n’abo hanze, kugira ngo ntatembere mu mugayo no mu mutego wa wa Murwanizi.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.7",
            "verseOrgIds": [
              "1TI.3.7"
            ]
          }
        }
      ]
