              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkwandikiye ivyo, nizigiye ko nzoza i wawe vuba: ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.14",
            "verseOrgIds": [
              "1TI.3.14"
            ]
          }
        },
