            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ni naba ngitevye n’ukugira ng’uz’ umenye uko bikwiye kugenzwa mu ngoro y’Imana, ni yo shengero ry’Imana nzima, vyongeye ni yo nkingi ishigikiye ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.15",
            "verseOrgIds": [
              "1TI.3.15"
            ]
          }
