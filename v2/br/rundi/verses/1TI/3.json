              "items": [
                {
                  "text": "Ivyak 6:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abakozi b’ishengero na bo nyene, bakwiye kuba inyankamugayo batavuga indimi zibiri, kandi ntibabe abatwawe na vino nyinshi, cank’ abifuza inyungu mbi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.8",
            "verseOrgIds": [
              "1TI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bagumye ibanga ry’ukwizera, bafise imitima itarimw’ ijwi ribāgiriza ikibi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.9",
            "verseOrgIds": [
              "1TI.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abo babanze kugezwa, maze ni batābonekak’ umugayo babone gukora igikorwa c’ibango ryabo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.10",
            "verseOrgIds": [
              "1TI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.3"
              },
              "items": [
                {
                  "text": "Tit 2:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’abagore nyene babe inyankamugayo, batarementaniriza abandi, batarenza urugero, bizigirwa muri vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.11",
            "verseOrgIds": [
              "1TI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukozi w’ishengero wese abe umugabo afise umugore umwe gusa, aganza neza abana biwe n’abo mu rugo rwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.12",
            "verseOrgIds": [
              "1TI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw abākoze neza ico gikorwa c’ibango ryabo bīronkera igishingo ciza n’ubushizi bg’amanga bginshi mu kwizera Kristo Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.3.13",
            "verseOrgIds": [
              "1TI.3.13"
            ]
          }
        }
      ]
    },
