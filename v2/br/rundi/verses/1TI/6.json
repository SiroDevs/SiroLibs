              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibihāri bidashira vy’abantu bononekaye ubgenge, bakūwekw ivy’ ukuri, bibgira yuko kwubaha Imana ar’ ukwironkera inyungu.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.5",
            "verseOrgIds": [
              "1TI.6.5"
