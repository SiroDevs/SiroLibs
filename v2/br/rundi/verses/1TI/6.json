                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yigisha ukundi, ntiyemere amajambo mazima, ari yo majambo y’Umwami wacu Yesu Kristo, n’inyigisho zihūra n’ukwubaha Imana; ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.3",
            "verseOrgIds": [
              "1TI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "azoba yikakishije, ata co azi, arwaye ibihāri, n’intambara z’amagambo, zivamw’ igono, no gutongana, n’ibitutsi, n’ikēkwe ribi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.4",
            "verseOrgIds": [
              "1TI.6.4"
            ]
          }
        },
        {
