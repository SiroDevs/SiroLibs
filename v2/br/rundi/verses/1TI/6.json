              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.4.7"
              },
              "items": [
                {
                  "text": "2 Tim 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "wame urwana intambara nziza yo kwizera, ucakire ubugingo budashira, ubgo wahamagariwe, ukabgaturira ukwatura kwiza mu maso y’ivyabona vyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.12",
            "verseOrgIds": [
              "1TI.6.12"
            ]
          }
        },
        {
