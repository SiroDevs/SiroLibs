              "items": [
                {
                  "text": "19:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakubgiririza mu nyonga z’Imana ibeshaho vyose, no mu za Kristo Yesu yashingishije intahe ukwatura kwiza imbere ya Pontiyo Pilato, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.13",
            "verseOrgIds": [
              "1TI.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "witondere icagezwe, ntugire agasembga, ntubek’ umugayo, gushitsa ku guseruka kw’ Umwami wacu Yesu Kristo, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.14",
            "verseOrgIds": [
              "1TI.6.14"
            ]
          }
