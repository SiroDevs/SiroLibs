        },
        {
          "text": "Abagurano bose bari mu buja ni biyumvire ba shebuja ko bakwiye kwubahwa rwose, ngw izina ry’Imana n’ukwigisha ntibitukwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.1",
            "verseOrgIds": [
              "1TI.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHM.1.16"
              },
              "items": [
                {
                  "text": "Flm 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abafise ba shebuja bizera, boye kubagayishwa n’ukw ari bene Data, ariko barushirize kubakorera, kukw abagirirwa ico kimazi ar’ abizera n’abakundwa. Uze wigishe ivyo, ubibahanūre.",
          "type": "text",
          "attrs": {
            "verseId": "1TI.6.2",
            "verseOrgIds": [
              "1TI.6.2"
            ]
          }
        }
      ]
    },
