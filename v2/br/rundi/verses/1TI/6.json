                "loc": "1CO.9.25"
              },
              "items": [
                {
                  "text": "1 Kor 9:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.26"
              },
              "items": [
                {
                  "text": "26",
