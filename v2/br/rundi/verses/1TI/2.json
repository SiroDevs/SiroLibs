                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abagore nyene, ndagomba ko bambara imyambaro biberanye, bagendane isoni badahugumba kandi badashazisha gutsiba umushatsi, cank’ izahabu, cank’ imaragarita,",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:9",
              "type": "text"
            },
            {
              "text": "imaragarita",
              "type": "text"
            },
            {
              "text": ": rāba Mat 7:6.",
              "type": "text"
            }
          ]
        },
        {
          "text": " cank’ impuzu z’igiciro kinini, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.9",
            "verseOrgIds": [
              "1TI.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TI 2:10"
