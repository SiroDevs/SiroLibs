                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko sinkundira umugore ko yigisha canke kw aganza umugabo, arikw atekereze. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.12",
            "verseOrgIds": [
              "1TI.2.12"
            ]
          }
