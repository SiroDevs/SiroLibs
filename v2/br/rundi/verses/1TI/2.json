                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Adamu si we yahenzwe, arik’ umugore ni we yahenzwe, agwa mu bicumuro. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.14",
            "verseOrgIds": [
              "1TI.2.14"
            ]
          }
        },
