        {
          "text": "Nuko ndagomba kw abagabo basenga hose, batarika amaboko yera, bataratse, batagira ibihāri. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.8",
            "verseOrgIds": [
              "1TI.2.8"
            ]
