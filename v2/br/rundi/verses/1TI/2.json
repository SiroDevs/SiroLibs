                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugore yige atekereje agamburuka rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.11",
            "verseOrgIds": [
              "1TI.2.11"
            ]
