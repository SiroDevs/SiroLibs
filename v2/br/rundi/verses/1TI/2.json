            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igomba kw abantu bose bakizwa bagashika ku kumenya ivy’ ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.4",
            "verseOrgIds": [
              "1TI.2.4"
            ]
