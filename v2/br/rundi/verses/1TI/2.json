            "number": "2",
            "style": "v",
            "sid": "1TI 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi cane‐cane abami n’abashizwe hejuru bose, kugira ngo twame mu mahoro dutekereje, twubaha Imana tur’ inyankamugayo rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.2",
            "verseOrgIds": [
              "1TI.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
