            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo vyiza vyemerwa mu nyonga z’Imana Umukiza wacu, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.2.3",
            "verseOrgIds": [
              "1TI.2.3"
            ]
          }
        },
