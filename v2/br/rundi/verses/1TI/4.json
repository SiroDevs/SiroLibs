              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wibutsa bene Data ivyo, uzoba ur’ umukozi mwiza wa Kristo Yesu, yarerewe mu majambo y’ukwizera n’ay’ inyigisho nziza wakurikiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.6",
            "verseOrgIds": [
              "1TI.4.6"
            ]
          }
        },
        {
          "name": "verse",
