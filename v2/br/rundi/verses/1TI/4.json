              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.10",
            "verseOrgIds": [
              "1TI.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TI 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wame ubgiriza ivyo kand’ uvyigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.11",
            "verseOrgIds": [
              "1TI.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TI 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "TIT.2.15"
              },
              "items": [
                {
                  "text": "Tit 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntihakagire ūkugayira ubusore, arik’ ubere abizera icitegererezo mu vy’uvuga, no mu ngeso zawe, no mu rukundo, no mu kwizera, no ku mutima utanduye. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.12",
            "verseOrgIds": [
              "1TI.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TI 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gushitsa aho nzozira wame ugira umwete wo gusomera abantu no kubahanūra no kubigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.13",
            "verseOrgIds": [
              "1TI.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TI 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.5.22"
              },
              "items": [
                {
                  "text": "1 Tim 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TI.1.6"
              },
              "items": [
                {
                  "text": "2 Tim 1:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.6.6"
