            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baziza kwābīrana, baziza n’ivyo kurya, kand’ ari vyo Imana yaremye kugira ngw abizera, bakamenya ivy’ ukuri, babirye bashima. ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.3",
            "verseOrgIds": [
              "1TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TI 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
