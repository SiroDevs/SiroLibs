          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bavugisha uburyarya bg’abanyabinyoma, bokejwe icapa mu mitima yabo ibāgiriza ikibi, ",
          "type": "text",
          "attrs": {
            "verseId": "1TI.4.2",
            "verseOrgIds": [
              "1TI.4.2"
            ]
          }
