              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega twapfuye iki, ga yemwe ab’i Tiro n’i Sidoni, namwe ababa mu ntāra zose z’i Bufilisitiya? None har’ ico munyīhōra? Erega namba mugomba kunyīhōra, ukwo kwīhōra kwanyu nzonyarutsa vuba kukubasubiza ku mitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.4",
            "verseOrgIds": [
              "JOL.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOL 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.16"
              },
              "items": [
                {
                  "text": "2 Ngo 21:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.21.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko mwāsahuye amafeza yanje n’amazahabu yanje, ibintu vyanje vyiza vy’igikundiro mukabijana mu nsengero zanyu z’ibigirwamana; ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.5",
            "verseOrgIds": [
              "JOL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ abantu b’i Buyuda n’ab’i Yerusalemu ko mwābaguze n’Abagiriki, kugira ngo mubakūreho, baje kure y’igihugu cabo: ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.6",
            "verseOrgIds": [
              "JOL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ehe nanje nzobavyutsa, mbakūre ahantu iyo mwābaguriye, kandi kwa kunyīhōra kwanyu nzokubasubiza ku mitwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.7",
            "verseOrgIds": [
              "JOL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namwe abahungu banyu n’abakobga banyu nzobagura n’ab’i Buyuda, na bo bazobagura n’abantu b’i Sheba, ihanga rya kure: kukw ari jewe Uhoraho mbivuze.",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.8",
            "verseOrgIds": [
              "JOL.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
