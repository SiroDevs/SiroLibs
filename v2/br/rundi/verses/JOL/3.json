                "loc": "JHN.4.35"
              },
              "items": [
                {
                  "text": "Yoh 4:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.15+REV.14.16+REV.14.17+REV.14.18+REV.14.19+REV.14.20"
              },
              "items": [
                {
                  "text": "Ivyah 14:15-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni musohore imihoro, kukw iyimbura rigeze! Ni muze mugane, kuk’ ubgato bguzuye, kand’ amāto akaba abōgabōga; kukw ibibi vyabo ari vyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.13",
            "verseOrgIds": [
              "JOL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.1.15"
              },
              "items": [
                {
                  "text": "Yow 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.10"
              },
              "items": [
                {
                  "text": "2:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe masinzi n’amasinzi ari mu kiyaya kizorundurirwamw’ imanza! Kuk’ umusi w’ Uhoraho uri hafi, ah’ imanza zizorundurirwa mu kiyaya! ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.14",
            "verseOrgIds": [
              "JOL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izuba rizocura umwiza, bo n’ukwezi, kandi n’inyenyeri zizoca zireka kwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOL.3.15",
            "verseOrgIds": [
              "JOL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.4"
              },
              "items": [
                {
                  "text": "Yes 25:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.30"
              },
              "items": [
                {
                  "text": "Yer 25:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.11"
              },
              "items": [
                {
                  "text": "Yow 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho azokwivugira i Siyoni, arangurure ijwi ar’ i Yerusalemu; ijuru n’isi bizotigita: arik’ Uhoraho azobera abantu biwe ubuhungiro, Abisirayeli ababere igihome co kubakingira. ",
