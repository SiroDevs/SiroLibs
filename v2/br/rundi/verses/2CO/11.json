                "loc": "1CO.9.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Canke mbega naracumuye kuko nicishije bugufi ngo mushirwe hejuru, mbabgiye ubutumwa bgiza bg’Imana ku busa? ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.7",
            "verseOrgIds": [
              "2CO.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.10"
              },
              "items": [
                {
                  "text": "Flp 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.4.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasahuye ayandi mashengero ndayāka ingero, kugira ngo nkorere mwebge, ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.8",
            "verseOrgIds": [
              "2CO.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.12.13"
              },
              "items": [
                {
                  "text": "2 Kor 12:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ aho nari kumwe namwe ngakena, sinagize uwo ngōra: kuko bene Data bavuye i Makedoniya bāmmaze ubukene. Muri vyose nirinda kubagora, kandi nzoshishikara kuvyirinda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.9",
            "verseOrgIds": [
              "2CO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.9.15"
              },
              "items": [
                {
                  "text": "1 Kor 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uk’ ukuri kwa Kristo kuri muri jewe, nta wuzombuza kwirata ntyo mu ntāra zo muri Akaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.10",
            "verseOrgIds": [
              "2CO.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ku ki? N’uko ntabakunda? Bizi Imana.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.11",
            "verseOrgIds": [
              "2CO.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
