              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.11",
            "verseOrgIds": [
              "2CO.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ivyo nkora nzoshishikara kubikora, kugira ngo mbuze inyanduruko abagomba inyanduruko yo kuboneka nkatwe mu vyo birata. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.12",
            "verseOrgIds": [
              "2CO.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.2.17"
              },
              "items": [
                {
                  "text": "2 Kor 2:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.3.2"
              },
              "items": [
                {
                  "text": "Flp 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abameze bartyo n’intumwa z’ibinyoma, n’abakozi bagunga, bīgira intumwa za Kristo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.13",
            "verseOrgIds": [
              "2CO.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CO 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ivyo ntibitangaza, kuko na Satani yīgira umumarayika w’umuco. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.14",
            "verseOrgIds": [
              "2CO.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CO 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko s’ikigoye kw abakozi biwe na bo bīgira nk’abakozi b’ukugororoka: iherezo ryabo rizohwana n’ibikorwa vyabo.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.15",
            "verseOrgIds": [
              "2CO.11.15"
            ]
          }
        }
      ]
    },
