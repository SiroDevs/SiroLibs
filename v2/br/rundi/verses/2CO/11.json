                  "text": "2 Kor 12:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nongere kubivuga: Ntihagire ūnyiyumvira ko nd’ igipfu. Ariko ni mwaramuka munyiyumviriye murtyo, munyemere nk’igipfu, kugira ngo nanje nirate gatoya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.16",
            "verseOrgIds": [
              "2CO.11.16"
            ]
          }
        },
