                "loc": "1CO.2.1"
              },
              "items": [
                {
                  "text": "1 Kor 2:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.2"
              },
              "items": [
                {
                  "text": "2",
