                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.2.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.3.4"
              },
              "items": [
                {
                  "text": "Ef 3:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho nd’umutungu mu majambo, sind’ umutungu mu bgenge, kand’ ivyo twarabiberetse muri vyose no mu maso ya bose.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.11.6",
            "verseOrgIds": [
              "2CO.11.6"
            ]
          }
        }
      ]
