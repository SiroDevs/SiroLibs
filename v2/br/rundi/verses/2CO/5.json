          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma uhereye none tutakigira uwo tumenya ku vyo ku rukoba; naho twari tuzi Kristo mu vy’ umubiri, ariko none ntitukimumenya durtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.16",
            "verseOrgIds": [
              "2CO.5.16"
            ]
          }
        },
        {
