                "loc": "2CO.1.22"
              },
              "items": [
                {
                  "text": "2 Kor 1:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.13"
              },
              "items": [
                {
                  "text": "Ef 1:13",
