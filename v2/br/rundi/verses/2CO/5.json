            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyaturoranije kubg’ ico nyene n’Imana, iyatugwatirije Mpwemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.5.5",
            "verseOrgIds": [
              "2CO.5.5"
            ]
