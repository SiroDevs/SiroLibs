          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.4.14"
              },
              "items": [
                {
                  "text": "Heb 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyari bitubereye kugira umuherezi mukuru ameze artyo, yera, atagira ubugunge, atanduye, yatandukanijwe n’abanyavyaha, yashizwe hejuru y’amajuru, ",
          "type": "text",
          "attrs": {
