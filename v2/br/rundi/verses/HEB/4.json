              "items": [
                {
                  "text": "Ivyah 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ijambo ry’Imana ari rizima, rifise ubukuba, rifise ubugi buruta ubg’ inkota zose, rikinjira n’aho ritanya ubugingo n’impwemu, rigatanya ingingo n’umusokōro, risuzuma ivyo umutima wiyumvira, ukagabira. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.12",
            "verseOrgIds": [
              "HEB.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ imbere yayo nta caremwe gihishijwe, ariko vyose vyambaye ubusa, biragaragara, imbere y’inyonga z’Iyizotubaza ivyo twakoze.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.4.13",
            "verseOrgIds": [
              "HEB.4.13"
            ]
          }
        }
      ]
    },
