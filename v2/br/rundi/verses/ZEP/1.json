            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokwanzura rwose ibintu vyose biri kw isi, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.2",
            "verseOrgIds": [
              "ZEP.1.2"
            ]
          }
        },
