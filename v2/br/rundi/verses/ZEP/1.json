                {
                  "text": "Hos 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokwanzura abantu n’amatungo, nzokwanzura ibiguruka mu kirēre n’amafi yo mu kiyaga, n’abanyakibi nzobatega urutsiburira; eka nzorandura abantu bose kw isi, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.3",
            "verseOrgIds": [
              "ZEP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
