          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi nzohana abasimba urwinjiriro rw’urusengero",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.9",
            "verseOrgIds": [
              "ZEP.1.9"
            ]
          }
        },
