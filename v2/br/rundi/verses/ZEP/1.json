            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kur’ uwo musi w’ikimazi canje jewe Uhoraho, nzohana abaganwa n’abana b’umwami, n’abambaye imyambaro y’inyamahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.8",
            "verseOrgIds": [
              "ZEP.1.8"
            ]
          }
        },
