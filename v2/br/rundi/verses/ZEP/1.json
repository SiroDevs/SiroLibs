            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobangurira ukuboko kwanje Abayuda n’ababa i Yerusalemu bose; nzorandura amasigarira ya Bayali aho hantu, n’izina ry’ibishegu hamwe n’abaherezi; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.4",
            "verseOrgIds": [
              "ZEP.1.4"
            ]
          }
        },
        {
          "name": "verse",
