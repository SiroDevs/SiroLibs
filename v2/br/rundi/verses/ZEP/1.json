            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kur’ uwo musi, ni k’Uhoraho agize, hazokwumvikana induru kw irembo ryitwa iry’ Amafi, n’umuborogo mu gice c’igisagara ca kabiri, n’ugusenyerana gukomeye kuzokwumvikana mu misozi. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.10",
            "verseOrgIds": [
              "ZEP.1.10"
            ]
          }
        },
