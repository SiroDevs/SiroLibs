              "type": "text"
            }
          ]
        },
        {
          "text": "N’uhwekerere imbere y’Umwami Uhoraho: kuk’ umusi w’ Uhoraho uri hafi; Uhoraho yiteguye ikimazi, kandi yejeje abatumire biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.7",
            "verseOrgIds": [
              "ZEP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
