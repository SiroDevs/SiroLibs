                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’abasenga inyenyeri, ari zo ngabo zo kw ijuru, būriye hejuru ku mazu; n’abasenga bandahira jewe Uhoraho bagatako bakarahira na Milikomu; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.5",
            "verseOrgIds": [
              "ZEP.1.5"
            ]
          }
        },
        {
