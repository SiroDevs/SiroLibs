          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwiyegereze Imana, na yo izobēgēra. Yemwe banyavyaha, ni mukarabe: yemwe ab’ imitima ibiri, ni mwiyeze imitima.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.8",
