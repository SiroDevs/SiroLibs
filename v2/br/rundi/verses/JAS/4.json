          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubabare, muboroge, murire; ibitwengo vyanyu bihinduke amaborogo, umunezero uhinduke umubabaro. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.9",
            "verseOrgIds": [
              "JAS.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JAS 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwicishe bugufi imbere y’Umwami Imana, na yo izobashira hejuru.",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.10",
