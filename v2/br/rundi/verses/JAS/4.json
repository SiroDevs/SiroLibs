        },
        {
          "text": "Bene Data, ntimuvuganane nabi. Ūvuga nabi mwene Se, cank’ ūhinyurira mwene Se ku mutima, aba avuze nabi ivyagezwe, ni vyo aba ahinyuye. Arikw iy’ uhinyura ivyagezwe, ntuba uvyitondera, uba ubaye umucamanza wavyo. ",
          "type": "text",
          "attrs": {
            "verseId": "JAS.4.11",
            "verseOrgIds": [
              "JAS.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
