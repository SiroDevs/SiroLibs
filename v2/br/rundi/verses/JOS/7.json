              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akani yishura Yosuwa, ati N’ivy’ ukuri nacumuye k’Uhoraho Imana y’Abisirayeli; kand’ uko vyagenze n’uku: ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.20",
