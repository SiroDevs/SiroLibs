          ]
        },
        {
          "text": "Nuko Yosuwa azinduka kare mu gatondo, ahamagaza Abisirayeli, umuryango umwe‐umwe ukwawo; umuryango wa Yuda urafatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.16",
            "verseOrgIds": [
              "JOS.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamagaza amazu ya ba Yuda, inzu ya ba Zerahi irafatwa; ahamagaza ab’ inzu ya Zerahi, ben’ amarembo umwe‐umwe, Zabudi arafatwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.17",
            "verseOrgIds": [
              "JOS.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahamagaza abo mu rugo rwiwe, umugabo umwe‐umwe; hafatwa Akani mwene Karami, umwuzukuru wa Zabudi, Zabudi mwene Zerahi, wo mu muryango wa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.18",
            "verseOrgIds": [
              "JOS.7.18"
            ]
          }
        }
