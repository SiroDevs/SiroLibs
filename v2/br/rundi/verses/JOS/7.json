          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babikūrayo, babizanira Yosuwa n’Abisirayeli bose, babirambika ngaho imbere y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.23",
