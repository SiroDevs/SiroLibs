              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa atuma abantu bava i Yeriko ngo baje i Hayi; hari hafi y’i Betaveni, ku ruhande rw’i Beteli rw’i burasirazuba; arababarira, ati Ni mudūge, muje gutata ico gihugu. Nukw abo bantu baradūga, baja gutata Hayi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.2",
            "verseOrgIds": [
              "JOS.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagaruka aho Yosuwa ari, baramubgira, bat’ Abantu bose ntibarinde kudūgayo; ni hagende nk’ibihumbi bibiri canke bitatu, babe ari bo bahatera. Ntiwirirwe ugorera abantu bose ubusa ngo badūgeyo, kukw abaho ari bake. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.3",
            "verseOrgIds": [
              "JOS.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.26.17"
              },
              "items": [
                {
                  "text": "Lew 26:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.28.25"
              },
              "items": [
                {
                  "text": "Gus 28:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mu bantu havamwo nk’ibihumbi bitatu, badūgayo: arikw abantu b’i Hayi barabirukana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.4",
            "verseOrgIds": [
              "JOS.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ab’i Hayi babīcamw’ abantu nka mirongwitatu na batandatu, barabakinagiza, babahanuye kw irembo ry’igisagara babashitsa i Shebarimu, bagenda barabīcira ku mumanuko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.5",
            "verseOrgIds": [
              "JOS.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ imitima y’abantu ishongera mu nda zabo, icika nk’amazi; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.5",
            "verseOrgIds": [
              "JOS.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
