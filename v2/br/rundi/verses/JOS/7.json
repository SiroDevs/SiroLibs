            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.22.20"
              },
              "items": [
                {
                  "text": "Yos 22:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw Abisirayeli bacumura mu vyagizwe inyegu y’Uhoraho; Akani mwene Karami, Karami wa Zabudi, Zabudi wa Zerahi, wo mu muryango wa Yuda, ni we yasotōye ku vyagizwe inyegu; maz’ uburake bg’Uhoraho buziriringira Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.7.1",
            "verseOrgIds": [
              "JOS.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
