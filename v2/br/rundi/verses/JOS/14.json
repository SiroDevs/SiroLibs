            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.21.2"
              },
              "items": [
                {
                  "text": "Yos 21:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’ uk’ Uhoraho yari yarabariye Mose, ni kw Abisirayeli bābigenjeje, mu kugabura igihugu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.14.5",
            "verseOrgIds": [
              "JOS.14.5"
            ]
          }
        }
