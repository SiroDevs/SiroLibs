                "loc": "ROM.6.13"
              },
              "items": [
                {
                  "text": "Rom 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yesu aramubgira, ati Nkurikira, reka abapfuye bahambe abapfuye babo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.22",
            "verseOrgIds": [
              "MAT.8.22"
            ]
          }
        }
