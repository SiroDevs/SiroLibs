                "loc": "MAT.9.30"
              },
              "items": [
                {
                  "text": "Mat 9:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.36"
              },
              "items": [
                {
                  "text": "Mrk 7:36",
