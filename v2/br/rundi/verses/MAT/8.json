            }
          ]
        },
        {
          "text": "Ashitse i Kaperinawumu, haza umugabisha w’abasoda ijana, aramwinginga,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.5",
            "verseOrgIds": [
              "MAT.8.5"
            ]
          }
        },
        {
