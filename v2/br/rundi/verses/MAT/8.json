            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atambukira mu bgato, abigishwa biwe baramukurikira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.23",
            "verseOrgIds": [
              "MAT.8.23"
