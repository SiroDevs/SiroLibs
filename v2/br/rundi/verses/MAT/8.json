            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndababgira yuko benshi bazoza, bavuye i burasirazuba n’i burengerazuba, bazokwicarana na Aburahamu na Isaka na Yakobo mu bgami bgo mw ijuru; ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.11",
            "verseOrgIds": [
              "MAT.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
