          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amukora ku kuboko, umururumbo urazima; aravyuka, aramuzimana. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.15",
            "verseOrgIds": [
              "MAT.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku kagoroba, bamuzanira benshi binjiwemwo n’abadayimoni; izo mpwemu mbi azirukanisha ijambo, akiza abāri barwaye bose, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.16",
            "verseOrgIds": [
              "MAT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
