              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abonye ishengero ryinshi rimukikije, agera ko bajabuka hakurya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.18",
            "verseOrgIds": [
