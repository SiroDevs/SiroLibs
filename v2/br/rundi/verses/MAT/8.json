            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bun’ aca akira imibembe yiwe. Yesu aramubgira, ati Wirinde, ntugire uwo ubgira, ariko genda wiyereke umuherezi, utange ishikanwa ryagezwe na Mose, ribe ikimenyetso kibabere icabona.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.4",
            "verseOrgIds": [
              "MAT.8.4"
            ]
          }
        }
      ]
