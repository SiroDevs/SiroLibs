            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.15.28"
              },
              "items": [
                {
                  "text": "15:28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abgira uwo mugabisha, at’ Igīre, bikubere nk’uko wizeye. Nuko wa muhungu akira uno mwanya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.13",
            "verseOrgIds": [
              "MAT.8.13"
            ]
          }
        }
      ]
