                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afashe hakurya mu gihugu c’Abagadareni, babiri binjiwemwo n’abadayimoni baramusanganira bava mu masenga y’imva, bari bakaze cane, bituma ata wushobora guhita mur’ iyo nzira. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.28",
            "verseOrgIds": [
              "MAT.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.41"
              },
              "items": [
                {
                  "text": "Luk 4:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2PE.2.4"
              },
              "items": [
                {
                  "text": "2 Pet 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barasemerera, bati Duhuriye hehe ga Mwana w’Imana? Uje hano kutubabaza agashinyaguro igihe cacu kitarashika? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.29",
            "verseOrgIds": [
              "MAT.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kure yabo hār’ umukuku w’ingurube nyinshi zirisha. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.30",
            "verseOrgIds": [
              "MAT.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abadayimoni baramwinginga, bati Namb’ udusenda, uturungike mur’ uriya mukuku w’ingurube. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.31",
            "verseOrgIds": [
              "MAT.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababgira, ati Ni mugende. Babasokorokamwo, baragenda, baja mur’ izo ngurube. Wa mukuku wose wirukira ku gatembge, zīsuka mu kiyaga, zihonera mu mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.32",
            "verseOrgIds": [
              "MAT.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abāziragira barahunga; bashitse mu gisagara bavuga ivyo babonye vyose n’ivy’ abāri binjiwemwo n’abadayimoni. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.33",
            "verseOrgIds": [
              "MAT.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MAT 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo mur’ ico gisagara bose baja gusanganira Yesu. Bamubonye, baramwinginga ngw ave mu ntāra yabo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.34",
            "verseOrgIds": [
              "MAT.8.34"
            ]
          }
        }
