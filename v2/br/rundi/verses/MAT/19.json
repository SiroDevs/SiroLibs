              "items": [
                {
                  "text": "Gus 5:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "wubahe so na nyoko, kand’ ukunde mugenzawe nk’uko wikunda. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.19",
            "verseOrgIds": [
              "MAT.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa musore aramubgira, at’ Ivyo vyose naravyitondeye; har’ ikindi mpajije? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.20"
              },
              "items": [
                {
                  "text": "Mat 6:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.12.33"
              },
              "items": [
                {
                  "text": "Luk 12:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubgira, at’ Asangw’ ugomba kuba agahore, genda ushōre ivyo utunze, ugabire aboro, ni ho uzogira itunga mw ijuru, utek’ uze, unkurikire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.62.10"
              },
              "items": [
                {
                  "text": "Zab 62:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musore yumvise iryo jambo, agenda ababaye, kuko yar’ afise itunga ryinshi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        }
      ]
