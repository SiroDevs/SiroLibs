              "items": [
                {
                  "text": "Zek 8:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabītegereza, arababgira, ati Kubg’ abantu ico ntigishoboka, ariko ku Mana vyose birashoboka.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        }
