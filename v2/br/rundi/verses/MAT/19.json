              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arababgira, ati Ndababgira ukuri yuko mwebge abankurikiye, ah’ Umwana w’umuntu azovyagirira ku ntebe y’ubgiza bgiwe, igihe co kuvyarwa ukundi gusha, namwe muzokwicara ku ntebe cumi na zibiri, mucire imanza imiryango cumi n’ibiri y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.28",
            "verseOrgIds": [
              "MAT.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 19:29"
          },
          "items": [
