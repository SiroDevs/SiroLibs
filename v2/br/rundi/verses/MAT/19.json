              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno Petero aramubaza, ati Mbega twebge ko twaretse vyose tukagukurikira; none tuzohabga iki? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        },
        {
