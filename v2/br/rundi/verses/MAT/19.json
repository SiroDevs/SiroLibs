                {
                  "text": "Mat 20:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.13.30"
              },
              "items": [
                {
                  "text": "Luk 13:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko benshi b’imbere bazoba ab’ inyuma, kand’ ab’ inyuma bazoba ab’ imbere.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
