              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwumvīre uwundi mugani: Hābaye nyen’ urugo yateye uruzabibu; aruzitirira uruzitiro, yimbamw’ ubgato bg’ikinogo, yubakamw’ umutara, arusigarana abarimyi, aja mu mahanga.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.33",
            "verseOrgIds": [
              "MAT.21.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
