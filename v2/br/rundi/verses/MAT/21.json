            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bageze hafi y’i Yerusalemu, bashikira i Betifage ku musozi wa Elayono, Yesu atuma abigishwa babiri, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.1",
            "verseOrgIds": [
              "MAT.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababarira, ati Mugende mur’ iriya mihana ir’ imbere yanyu, muca mubona indogoba iziritseho n’inyana yayo; muziziture, muzinzanire. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.2",
            "verseOrgIds": [
              "MAT.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.18"
              },
              "items": [
                {
                  "text": "Mat 26:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni hagira ūbabaza, mumubgire, muti Databuja ni we azigomba. Aca azirungika. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.3",
            "verseOrgIds": [
              "MAT.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyabayeho ngw ivyavuzwe n’uwavugishwa n’Imana bishike,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        }
      ]
    },
