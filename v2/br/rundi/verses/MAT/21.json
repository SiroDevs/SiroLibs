              },
              "items": [
                {
                  "text": "Mrk 11:27-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.20.1+LUK.20.2+LUK.20.3+LUK.20.4+LUK.20.5+LUK.20.6+LUK.20.7+LUK.20.8"
              },
              "items": [
                {
