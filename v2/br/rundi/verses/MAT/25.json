          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.29"
              },
              "items": [
                {
                  "text": "Yoh 5:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.12.2"
              },
              "items": [
                {
                  "text": "Dan 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bazoja mu gihano kidashira, arikw abagororotsi bazoja mu bugingo budashira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.25.46",
            "verseOrgIds": [
              "MAT.25.46"
            ]
          }
        }
