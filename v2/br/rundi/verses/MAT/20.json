                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Ehe turadūze i Yerusalemu, kand’ Umwana w’umuntu azoshirwa mu maboko y’abaherezi bakuru n’abanyabgenge b’ivyanditswe, bazomucira urubanza rwo gupfa, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.18",
            "verseOrgIds": [
              "MAT.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi bazomuha abanyamahanga ngw ashinyagurirwe, atonagurwe, abambge, kandi ku musi ugira gatatu azozurwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.19",
            "verseOrgIds": [
              "MAT.20.19"
            ]
          }
        }
      ]
    },
