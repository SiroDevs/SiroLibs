              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu agira adūge i Yerusalemu, yihererana na ba bigishwa cumi na babiri, maze bari mu nzira arababgira, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.17",
            "verseOrgIds": [
              "MAT.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
