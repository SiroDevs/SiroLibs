              "type": "text"
            }
          ]
        },
        {
          "text": "Buno nyina wa bene Zebedayo aza kuri we, ari kumwe n’abahungu biwe, aramupfukamira, amusaba ijambo.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.20",
            "verseOrgIds": [
