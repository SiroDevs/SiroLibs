                "loc": "MRK.9.35"
              },
              "items": [
                {
                  "text": "Mrk 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ūgomba kuba uw’ imbere az’ abe umuja wanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.20.27",
            "verseOrgIds": [
              "MAT.20.27"
            ]
          }
        },
