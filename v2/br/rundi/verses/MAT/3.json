              "items": [
                {
                  "text": "Ivyak 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’ukuri jeho ndababatiza mu mazi ngo mwihane; arik’ ūzoza hanyuma yanje andusha ubushobozi, ntibimbereye no kumutwaza inkweto. Uyo azobabatiza muri Mpwemu Yera no mu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.11",
            "verseOrgIds": [
              "MAT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.30"
              },
              "items": [
                {
                  "text": "Mat 13:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urutaro rwiwe ruri mu kuboko kwiwe, kand’ azokubūra imbuga yiwe neza, yimburire ingano ziwe mu kigega, maz’ umuguruka awuturire mu muriro utazima.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.12",
            "verseOrgIds": [
              "MAT.3.12"
            ]
          }
        }
      ]
