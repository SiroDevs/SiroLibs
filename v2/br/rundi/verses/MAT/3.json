            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abonye benshi bo mu Bafarisayo no mu Basadukayo bazanywe no kugira ngw ababatize, arababaza, ati Mwa bana b’inzoka mwe, ni nde yababūriye ngo muhunge uburake buzoza? ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.7",
            "verseOrgIds": [
              "MAT.3.7"
            ]
          }
        },
        {
          "name": "verse",
