                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw incabiti igenekerejwe ku bitsina vy’ibiti; nuko rer’ igiti cose kitāma ivyiza kiracibga, kigatererwa mu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.10",
            "verseOrgIds": [
              "MAT.3.10"
            ]
          }
        },
