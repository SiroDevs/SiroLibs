            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Buno rer’ ijwi riva mw ijuru, rit’ Uyu ni we Mwana wanje nkunda, akampimbara.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.3.17",
            "verseOrgIds": [
              "MAT.3.17"
            ]
          }
