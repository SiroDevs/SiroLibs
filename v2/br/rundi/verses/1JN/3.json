        },
        {
          "text": "Ico ni co kizotumenyesha ko tur’ ab’ ukuri, kandi tuzoshitsa umutima mu nda imbere yayo, ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.19",
            "verseOrgIds": [
