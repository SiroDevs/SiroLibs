                {
                  "text": "15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ubu ari bgo butumwa mwumvise uhereye mbere na mbere, ngo dukundane; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.11",
            "verseOrgIds": [
              "1JN.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.4.8"
              },
              "items": [
                {
                  "text": "Ita 4:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntiduse na Kayini, yar’ uwa wa Mubi, akica murumuna we. Kand’ icatumye amwica n’iki? N’ukw ibikorwa vyiwe vyari bibi, ivya murumuna we bikaba vyiza.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.12",
            "verseOrgIds": [
              "1JN.3.12"
            ]
          }
        }
      ]
    },
