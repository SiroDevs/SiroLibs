        {
          "text": "Bana bato, ntidukundane mu majambo canke ku rurimi, ariko dukundane mu vyo dukora no mu kuri.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.18",
            "verseOrgIds": [
              "1JN.3.18"
            ]
