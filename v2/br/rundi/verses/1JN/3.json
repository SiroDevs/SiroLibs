              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co kitumenyesha urukundo, n’uk’ uwo yatanze ubugingo bgiwe kubgacu: natwe dukwiye gutanga ubugingo bgacu kubga bene Data. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.16",
            "verseOrgIds": [
              "1JN.3.16"
            ]
          }
        },
