            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ico dusaba cose tugihabga na yo, kuko twitondera ivyagezwe vyayo, tugakora ibishimwa imbere yayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.22",
