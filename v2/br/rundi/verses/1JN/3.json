              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, ntimutangazwe n’ukw ab’ isi babanka. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.13",
            "verseOrgIds": [
              "1JN.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.11"
              },
              "items": [
                {
                  "text": "1 Yoh 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.5.24"
              },
              "items": [
                {
                  "text": "Yoh 5:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twebge turazi yuko twavuye mu rupfu, twashitse mu bugingo, kuko dukunda bene Data. Ūdakundana yama mu rupfu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.14",
            "verseOrgIds": [
              "1JN.3.14"
            ]
          }
        },
        {
