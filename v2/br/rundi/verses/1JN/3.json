            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nkunda, imitima yacu iy’ itadutsindishije, turashira ubgoba imbere y’Imana; ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.21",
            "verseOrgIds": [
              "1JN.3.21"
            ]
          }
