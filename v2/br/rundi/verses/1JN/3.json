              },
              "items": [
                {
                  "text": "Kuv 34:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo nkunda, none tur’ abana b’Imana, arik’ uko tuzomera ntikurahishurwa; ico tuzi, n’uko Yesu ni yahishurwa tuzosa na we, kuko tuzomurāba ukw ari. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.2",
            "verseOrgIds": [
              "1JN.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umuntu wese amuzigakw ivyo, ariyeza, nk’uk’ uwo ar’ uwera.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.3",
            "verseOrgIds": [
              "1JN.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
