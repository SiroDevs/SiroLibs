              "type": "text"
            }
          ]
        },
        {
          "text": "Uwanka mwene Data wundi n’umwicanyi; kandi murazi yukw ata mwicanyi yogira ubugingo budashira ngo bugume muri we. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.15",
