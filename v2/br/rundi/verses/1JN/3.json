              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ūfise ibintu vyo mw isi, akabona mwene Data wundi akennye, akazitira imbabazi ziwe kur’ uyo, mbeg’ ugukunda Imana kwoguma muri we gute? ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.17",
            "verseOrgIds": [
