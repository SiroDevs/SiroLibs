            }
          ]
        },
        {
          "text": "Murābe urukundo uko rungana Data wa twese yatugiriye, ko twitwa abana b’Imana; kandi ni ko turi. Ni co gituma ab’ isi batatuzi, kuko batayimenye. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.1",
            "verseOrgIds": [
              "1JN.3.1"
            ]
          }
        },
