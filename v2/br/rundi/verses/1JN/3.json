          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu vy’ imitima yacu idutsindisha vyose, kukw Imana iruta imitima yacu, kand’ izi vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.20",
            "verseOrgIds": [
              "1JN.3.20"
            ]
