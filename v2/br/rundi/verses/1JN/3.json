              },
              "items": [
                {
                  "text": "Mat 7:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese akora icaha akora ivy’ ubugarariji; kand’ icaha ni co mugararizo. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.4",
            "verseOrgIds": [
              "1JN.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.4"
              },
              "items": [
                {
                  "text": "Yes 53:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1PE.2.24"
              },
              "items": [
                {
                  "text": "1 Pet 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi murazi yuk’ uwo yahishuwe kugira ngw akūreh’ ivyaha, kand’ ata caha kiri muri we. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.5",
            "verseOrgIds": [
              "1JN.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.14"
              },
              "items": [
                {
                  "text": "Rom 6:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese aguma muri we ntakora ivyaha; ūkora ivyaha wese ntiyamubonye kandi ntiyamumenye. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.6",
            "verseOrgIds": [
              "1JN.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.2.29"
              },
              "items": [
                {
                  "text": "1 Yoh 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bana bato, ntihakagire ūbazimiza: ūkora ibigororotse ni we agororoka, nk’uk’ uwo agororoka. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.7",
            "verseOrgIds": [
              "1JN.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.8.44"
              },
              "items": [
                {
                  "text": "Yoh 8:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūkora ivyaha n’uwa wa Murwanizi, kuk’ uhereye ubga mbere na mbere uwo Murwanizi yamye akora ivyaha. Icatumye Umwana w’Imana ahishurwa ngiki: n’ukugira ngw asangangure ibikorwa vy’Umurwanizi. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.8",
            "verseOrgIds": [
              "1JN.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1JN.5.18"
              },
              "items": [
                {
                  "text": "1 Yoh 5:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese yavyawe n’Imana ntakora ivyaha, kukw imbuto yayo iguma muri we; kandi ntashobora gukora ivyaha, kuko yavyawe n’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.9",
            "verseOrgIds": [
              "1JN.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co kimenyekanisha abana b’Imana n’abana b’Umurwanizi: ūdakora ibigororotse wese s’uw’ Imana, cank’ ūdakunda mwene Data wundi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.10",
            "verseOrgIds": [
              "1JN.3.10"
            ]
          }
        }
      ]
    },
