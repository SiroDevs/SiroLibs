                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igikōko cose cank’ igitunzwe mu vyo mwemererwa kurya, hagize igipfuye, uwokora ku muvyimba waco yoba ahumanye gushitsa ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi horamuka har’ ūriye ku muvyimba waco, az’ amesure impuzu ziwe, akomeze kuba ūhumanye gushitsa ku mugoroba; n’uwoterura umuvyimba waco, na we az’ amesure impuzu ziwe, akomeze kuba ūhumanye gushitsa ku mugoroba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
