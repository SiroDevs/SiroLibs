            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n’uwogira ico aterura co ku muvyimba wavyo, az’ amesure impuzu ziwe, akomeze kuba ūhumanye gushitsa ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.25",
            "verseOrgIds": [
              "LEV.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigenda gifise inzāra ziri n’imyanya hagati cose, arikw inzāra zitari kubiri rwose, kigatako nticūze, n’igihumanya kuri mwebge; uwogikorako wese yoba ahumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.26",
            "verseOrgIds": [
              "LEV.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigendesha amajanja cose co mu bigenza amaguru ane vyose, n’igihumanya kuri mwebge; uwokora ku muvyimba wavyo yoba ahumanye gushitsa ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.27",
            "verseOrgIds": [
              "LEV.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’ uwogira ico aterura co ku muvyimba wavyo, az’ amesure impuzu ziwe, akomeze kuba ūhumanye gushitsa ku mugoroba: ivyo n’ ibihumanya kuri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.28",
            "verseOrgIds": [
              "LEV.11.28"
            ]
          }
        }
      ]
    },
