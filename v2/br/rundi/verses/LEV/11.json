                "loc": "ISA.66.17"
              },
              "items": [
                {
                  "text": "Yes 66:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo bihumanya kuri mwebge mu binyonyera bigenda hasi: igikara, n’imbeba, bo n’imburu nk’ukw amoko yazo ari; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.29",
            "verseOrgIds": [
              "LEV.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ icūgu, n’ikivumbura, n’umuserebanyi, n’agacamano, n’uruvu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.30",
            "verseOrgIds": [
              "LEV.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyose n’ibihumanya kuri mwebge mu binyonyera vyose; uwokora ku gipfuye muri vyo yoba ahumanye gushitsa ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.31",
            "verseOrgIds": [
              "LEV.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.15.12"
              },
              "items": [
                {
                  "text": "Lew 15:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ikintu cose cokorokerwako n’umuvyimba w’ico muri vyo coba gihumanye; kandi naho coba ikintu cose cabājwe mu giti, cank’ umwambaro, cank’ urusato, cank’ igunira, cank’ ikindi kintu iyo kiva kikagera gikoreshwa mu buryo ubg’ ari bgo bgose, gikwiye kwinikwa mu mazi, kibe igihumanye gushitsa ku mugoroba; aho ni ho kizoba gihumanutse. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.32",
            "verseOrgIds": [
              "LEV.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ikibumbano cose cokorokerwamwo na kimwe muri vyo, ivyoba muri co vyose vyoba bihumanye, na co ubgaco mwoba mukwiye kukimena. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.33",
            "verseOrgIds": [
              "LEV.11.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibirībga vyose vyosukwakw amazi yo muri co, vyoba bihumanye: kand’ ico kunywa cose coba mu kintu ben’ ico cose coba gihumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.34",
            "verseOrgIds": [
              "LEV.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikintu cose cokorokerwako n’icavuye ku muvyimba wavyo coba gihumanye; ar’ iziko cank’ amashiga, coba gikwiye kumenagurwa; ivyo n’ ibihumanya, kandi bizoba ibihumanya kuri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.35",
            "verseOrgIds": [
              "LEV.11.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo icokorokera mw isōko canke mu rwobo rwimbiwe kubīkamw’ amazi, akadengēramwo, yo ntiyoba ahumanye; arik’ uwokora ku muvyimba wavyo wakorokeyemwo yoba ahumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.36",
            "verseOrgIds": [
              "LEV.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni hagira ico ku muvyimba wavyo cogwa mu mbuto zo kubibga iz’ ari zo zose, zo ntizoba zihumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.37",
            "verseOrgIds": [
              "LEV.11.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko namb’ izo mbuto zīnitswe mu mazi, icavuye ku muvyimba wavyo kikazigwamwo, zizoba igihumanya kuri mwebge.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.38",
            "verseOrgIds": [
              "LEV.11.38"
            ]
          }
        }
      ]
