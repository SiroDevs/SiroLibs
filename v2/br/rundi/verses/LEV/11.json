              "items": [
                {
                  "text": "1 Pet 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nd’ Uhoraho Imana yanyu: ni mwiyeze rero, mube abera, kuko nanje nd’ uwera; kandi ntimuze mwiyandurishe akanyonyera k’uburyo bgose kagendera hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.44",
            "verseOrgIds": [
