        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.23",
            "verseOrgIds": [
              "LEV.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ibi ni vyo vyobahumanya: uwokora ku muvyimba wavyo yoba ahumanye gushitsa ku mugoroba; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.24",
            "verseOrgIds": [
              "LEV.11.24"
            ]
          }
        },
