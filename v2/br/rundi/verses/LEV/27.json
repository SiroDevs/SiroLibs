          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umuntu ni yagomba gucungura ikigiracumi ciwe mur’ ivyo, ico agicunguje akigerekekw ikingana n’ikigiragatanu caco. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
