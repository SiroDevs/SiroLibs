              "type": "text"
            }
          ]
        },
        {
          "text": "Mu vyeze mu gihugu, vyaba ivyo mu ndimiro, cank’ ivyamye ku biti, ikigiracumi c’ivyo vyose n’icanje, jewe Uhoraho: n’icera canje. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
