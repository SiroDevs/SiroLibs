            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mu masho no mu mikuku, uko zigenda ziharūzwa inkoni, ikigiracumi co mur’ izo zose kize kibe icera canje, jewe Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
