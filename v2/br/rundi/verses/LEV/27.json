                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ic’ uburiza co mu bitunzwe, ntihaze hagire umuntu akirobanura ngw agitange, kuko na kare ivy’ uburiza vyari bisanzwe ar’ ivyanje; ar’ inka cank’ intama, n’iyanje. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ho ni caba ico mu bitunzwe bizira, uwo muntu az’ agicungure nk’uko waciriye, akigerekeko n’ikingana n’ikigira gatanu caco; ariko ni kitacungurwa, kize kigurwe nk’uko waciriye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
