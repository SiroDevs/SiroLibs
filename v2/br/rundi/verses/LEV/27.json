              "type": "text"
            }
          ]
        },
        {
          "text": "arikw iyo ndimiro ni yakomōrwa n’umwaka wa yubile, izoba icitse iyera yanje, nk’iyatanzwe kuba inyegu yanje; izokwegukira umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
