              "items": [
                {
                  "text": "Guh 19:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ urusato rw’iyo masa, n’inyama zayo zose, hamwe n’umutwe wayo, n’ibikenye vy’amaguru, n’amara yayo, n’amayezi yayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.11"
              },
              "items": [
                {
                  "text": "Lew 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.11"
              },
              "items": [
                {
                  "text": "Heb 13:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivy’ iyo masa vyose iyo biva bikagera, abijane inyuma y’aho mushagaje, ahantu hadahumanye, aho basēsa umunyota, abigereke ku nkwi, abiturire; ah’ umunyota usēswa abe ari ho bituririrwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        }
      ]
