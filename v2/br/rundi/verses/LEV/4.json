          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aheze ajane ivy’ iyo masa inyuma y’aho mushagaje, abiturire nk’uko yaturiye ivy’ imasa ya mbere: ico kizoba ar’ ikimazi gitangiwe ivyaha vy’ ishengero.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        }
      ]
