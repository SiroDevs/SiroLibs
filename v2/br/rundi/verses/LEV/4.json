              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni yaramuka azanye umwana w’intama kw ishikanwa ry’ikimazi co gutangirwa ivyaha, az’ azane ishashi itagira agasembga. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.32",
            "verseOrgIds": [
              "LEV.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arambike ikiganza mu ruhanga rw’ico kimazi co gutangirwa ivyaha, agikererere aho bakererera ikimazi co kwosa, kibe ikimazi gitangiwe ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.33",
            "verseOrgIds": [
              "LEV.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi aheze yābirize urutoke ku maraso y’ico kimazi, ayasīge ku mahembe y’igicaniro co kwoserezakw ibimazi, ayandi maraso yaco yose ayavyagize hasi hambavu y’igicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.34",
            "verseOrgIds": [
              "LEV.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
