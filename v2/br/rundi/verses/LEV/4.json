            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "namb’ ar’ umuherezi yarobanujwe amavuta aramutse akoze icaha, agacumuza ubgo bgoko, az’ atangire ico caha ciwe yakoze imasa y’umukangara itagira agasembga: ayinzanire kw ikimazi co gutangirwa ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azane iyo masa ku muryango w’ihema ry’ibonaniro imbere yanje, arambike ikiganza mu ruhanga rwayo, ayikererere imbere yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.9"
              },
              "items": [
                {
                  "text": "Lew 5:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.16.14"
              },
              "items": [
                {
                  "text": "16:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
