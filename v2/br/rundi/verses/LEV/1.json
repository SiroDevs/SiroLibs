                {
                  "text": "Luk 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ikimazi ciwe co kwoswa azompa ni caba ar’ inyoni, az’ atange intunguru cank’ ivyana vy’ inuma. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.8"
              },
              "items": [
                {
                  "text": "Lew 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi az’ akizane ku gicaniro, akinuse umutwe, awosereze ku gicaniro; amaraso yaco amiminukire ku gicaniro ku ruhande rwaco rumwe; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
              "LEV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.6.10"
              },
              "items": [
                {
                  "text": "Lew 6:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "agikūrekw agatorero kaco n’amoya yaco,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
            "verseOrgIds": [
              "LEV.1.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:16",
              "type": "text"
            },
            {
              "text": "n’amoya yaco,",
              "type": "text"
            },
            {
              "text": "canke: n’imyanda yo muri ko.",
              "type": "text"
            }
          ]
        },
        {
          "text": " abiterere hambavu y’igicaniro ahahera i burasirazuba, ku gikuburiro c’umunyota. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
            "verseOrgIds": [
              "LEV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
