                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Barira Abisirayeli, uti Ni haramuka hagize ūmuha ikimazi, muze mukūre ivyo bimazi mu vyo mutunze, ari mu masho canke mu mikuku.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
