                "loc": "EXO.29.10"
              },
              "items": [
                {
                  "text": "Kuv 29:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.4.4"
              },
              "items": [
                {
