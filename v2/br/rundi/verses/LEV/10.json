              "items": [
                {
                  "text": "21:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntimutirimuke ngo muve ku muryango w’ihema ry’ibonaniro, kugira ngo ntimupfe: kukw amavuta y’Uhoraho mwarobanujwe akiri kuri mwebge; nuko babigenza nk’uko Mose avuze.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.7",
            "verseOrgIds": [
              "LEV.10.7"
            ]
          }
        }
