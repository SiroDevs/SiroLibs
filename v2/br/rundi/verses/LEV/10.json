                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo mubone uko mutandukanya ivyera n’ibitar’ ivyera, n’ibihumanya n’ ibidahumanya, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.10.10",
            "verseOrgIds": [
              "LEV.10.10"
            ]
          }
        },
