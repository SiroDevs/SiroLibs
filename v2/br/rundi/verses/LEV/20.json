              "items": [
                {
                  "text": "Lew 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yaryamana n’umugore akiri mu muhango wiwe, akamwambika ubusa, azoba yambitse ubusa isōko yiwe, na wa mugore azoba atwikuruye iyo sōko y’amaraso yiwe: bompi baze barandurwe mu bgoko bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.18",
            "verseOrgIds": [
              "LEV.20.18"
            ]
          }
        },
        {
