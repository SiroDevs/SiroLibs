                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko mwiyeze, mube abera, kuko nd’ Uhoraho Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.7",
            "verseOrgIds": [
              "LEV.20.7"
            ]
