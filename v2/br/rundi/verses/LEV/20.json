                  "text": "Lew 18:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yābīra umukobga na nyina, kizoba icaha gikomeye: az’ atabge mu muriro, ubgiwe na bo; kugira ngo ntihaze hagire icaha gikomeye kiba muri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.14",
            "verseOrgIds": [
              "LEV.20.14"
            ]
          }
        },
