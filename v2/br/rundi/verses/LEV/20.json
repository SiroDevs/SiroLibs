              "items": [
                {
                  "text": "Lew 18:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugabo yenze uwundi mugabo bga mugore, bompi bazoba bakoze ikizira: ntibaze babure kwicwa: amaraso yabo ni bo azokora. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.13",
            "verseOrgIds": [
              "LEV.20.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
