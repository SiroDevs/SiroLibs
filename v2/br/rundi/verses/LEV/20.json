              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje nzohoza igitsūre kur’ uwo muntu, ndamurandure mu bgoko bgabo, ndamuhōye gushikanira Moleki uwo mu bana biwe, akanduza Ahēra hanje, agatukisha izina ryanje ryera. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.3",
            "verseOrgIds": [
              "LEV.20.3"
            ]
          }
        },
        {
