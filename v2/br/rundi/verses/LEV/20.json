            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muze mwitondere amabgirizwa yanje, muyashitse: jewe Uhoraho ni jewe mbeza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.8",
            "verseOrgIds": [
              "LEV.20.8"
            ]
          }
        },
