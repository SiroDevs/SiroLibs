            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu ni yaryamana na muka se wabo, azoba yambitse ubusa se wabo: bazogībgako n’icaha cabo: bazopfa ar’ imponnyi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.20",
