        },
        {
          "text": "Umuntu ni yasambana n’ umugore w’uwundi, agasambana na muka mugenzi we, uwo musambanyi n’uwo musambanyikazi ntibaze babure kwicwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.10",
            "verseOrgIds": [
              "LEV.20.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
