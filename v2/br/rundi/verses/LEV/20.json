              "items": [
                {
                  "text": "34:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "jewe ubganje nzohoza igitsūre kur’ uwo muntu, no ku muryango wiwe, ndabarandurane mu bgoko bgabo n’abābīgānye mur’ ubgo bumaka bgo guhurumbira Moleki.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.5",
            "verseOrgIds": [
              "LEV.20.5"
            ]
          }
        }
