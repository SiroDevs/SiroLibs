              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abantu bo mur’ ico gihugu ni birengagiza uwo muntu yashikaniye Moleki uwo mu bana biwe, ntibamwice; ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.20.4",
            "verseOrgIds": [
              "LEV.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
