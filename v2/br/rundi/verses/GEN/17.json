                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntucitwa Aburamu ukundi, arik’ uzokwitwa Aburahamu; kuko nkugize sekuruza w’amahanga menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.5",
            "verseOrgIds": [
              "GEN.17.5"
