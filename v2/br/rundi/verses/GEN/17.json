                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūmaze imisi munani avutse az’ akebge, izinamuhungu wese, ukw ibihe vy’urunganwe rwanyu bizogenda bikurikirana, ar’ ūvukiye mu rugo rwawe, ar’ uwo waguze n’umunyamahanga amahera, atākomōtse mu ruvyaro rwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.12",
            "verseOrgIds": [
              "GEN.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūvukiye mu rugo rwawe n’ uwo waguze amahera, bakwiye gukebga; kand’isezerano ryanje rizoba ku mibiri yanyu, ribe isezerano ridashira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.13",
            "verseOrgIds": [
              "GEN.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ni hagira izinamuhungu atākebge ku munwa w’ico yambariye, az’ arandurwe mu bgoko bgabo: kukw azoba yishe isezerano ryanje.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.14",
            "verseOrgIds": [
              "GEN.17.14"
            ]
          }
        }
      ]
    },
