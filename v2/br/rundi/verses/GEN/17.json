                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi no ku vya Ishimayeli ndakwumviye: rāba ndamuhaye umugisha, kandi nzomuha kurondoka, ndamugwize cane; azovyara abatware cumi na babiri, kandi nzomuhindura ubgoko bukomeye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.20",
            "verseOrgIds": [
              "GEN.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
