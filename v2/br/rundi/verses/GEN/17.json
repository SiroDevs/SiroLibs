              "items": [
                {
                  "text": "Ita 18:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.21.2"
              },
              "items": [
                {
                  "text": "21:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana iramwishura, it’ Oya, ariko kuri Sara umugore wawe ni ho uzovyara umwana. Kand’ uz’ umwite Isaka; nanje nzokomeza isezerano ryanje na we, ngo ribe isezerano ridashira ku ruvyaro rwiwe ruzovuka hanyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.19",
            "verseOrgIds": [
              "GEN.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
