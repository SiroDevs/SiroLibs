                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ihejeje kuvugana na we, ica iradūga, iva aho Aburahamu ari.",
          "type": "text",
