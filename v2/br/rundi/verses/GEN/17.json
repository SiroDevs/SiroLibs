            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.2+GEN.26.3+GEN.26.4+GEN.26.5"
              },
              "items": [
                {
                  "text": "26:2-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, isezerano ryanje nzorikomeza na Isaka, uwo muzovyarana na Sara mu gihe nk’iki c’ umwaka utaha. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.21",
            "verseOrgIds": [
              "GEN.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 17:22"
          },
          "items": [
