            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nshinze isezerano ryanje ngusezeraniye, wewe n’uruvyaro rwawe ruzovuka hanyuma, ukw ibihe vy’urunganwe rwabo bizogenda bikurikirana, ribe isezerano ridashira, kugira ngo nkubere Imana, wewe n’uruvyaro rwawe ruzovuka hanyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.7",
            "verseOrgIds": [
              "GEN.17.7"
            ]
          }
        },
        {
