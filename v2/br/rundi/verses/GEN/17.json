              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ibarira Aburahamu, iti Sarayi umugore wawe ntube ukimwita Sarayi ukundi, arik’ uz’ umwite Sara. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.15",
            "verseOrgIds": [
              "GEN.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.18.10"
              },
              "items": [
                {
                  "text": "Ita 18:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.35.11"
              },
              "items": [
                {
                  "text": "35:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzomuha umugisha, nteko nguhe umwana kuri we: ni koko nzomuha umugisha, kand’azoba inakuruza w’amahanga; abami b’amoko bazokomōka kuri we. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.17.16",
