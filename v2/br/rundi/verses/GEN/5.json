              "type": "text"
            }
          ]
        },
        {
          "text": "Imisi yose Adamu yamaze yabaye imyaka amajana cenda na mirongwitatu: araheza arapfa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.5",
