        },
        {
          "text": "Nuko Adamu amaze imyaka ijana na mirongwitatu avyara umuhungu afise ishusho yiwe, asa na we, amwita Seti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.3",
            "verseOrgIds": [
              "GEN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu amaze kuvyara Seti, amara imyaka amajana munani, ayivyaramw’ abahungu n’abakobga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.5.4",
            "verseOrgIds": [
              "GEN.5.4"
            ]
          }
        },
        {
