              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi twazanye n’ayandi mahera yo gusumisha. Ariko ntituzi uwashubije ayo mahera yacu mu magunira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.22",
            "verseOrgIds": [
