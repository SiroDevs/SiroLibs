          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batunganya za ngemurano, kugira ngo bazishikirize Yosefu ah’ azira ku murango, kuko bari bumvise yuko bariburīre aho.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.25",
