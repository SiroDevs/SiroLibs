              },
              "items": [
                {
                  "text": "37:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Se Isirayeli arababgira, at’ Enda ko bimeze birtyo, ni mugenze murtya: mujane mu magunira yanyu ibiba mur’ iki gihugu birusha ibindi kuba vyiza, mubishīre uwo mugabo kw ingemurano: umuti wo gusomōra ugeze, n’ ubūki bugeze, n’imibavu, n’isenga, n’ibiyoba, na shakedi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.11",
            "verseOrgIds": [
              "GEN.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.25"
              },
              "items": [
                {
                  "text": "Ita 42:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.35"
              },
              "items": [
                {
                  "text": "35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ku mahera ya mbere mugerekekw ayandi angana cabugerwe, kugira ngo musubiraney’ amwe yagaruka mu magunira yanyu: kumbure babaye kubiyoberwa; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.12",
            "verseOrgIds": [
              "GEN.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "muheze mujane murumuna wanyu, muhaguruke, musubire kuri wa mugabo; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.13",
            "verseOrgIds": [
              "GEN.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.36"
              },
              "items": [
                {
                  "text": "Ita 42:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.1.11"
              },
              "items": [
                {
                  "text": "Neh 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana Ishobora vyose ibahe guhāngazwa na we, ngw abarekurire mwene nyoko wundi, arekure na Benyamini. Nanje namba nzoba nyakamara, mbe ko!",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.14",
            "verseOrgIds": [
              "GEN.43.14"
            ]
          }
        }
      ]
    },
    {
