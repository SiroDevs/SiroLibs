            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko wa mugabo yinjiza abo bantu mu nzu ya Yosefu, abaha amazi, boga ibirenge, agaburira n’ indogoba zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.24",
            "verseOrgIds": [
