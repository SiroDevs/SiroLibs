          ]
        },
        {
          "text": "bat’ Udutunge mugenzi, mbere twaramanutse tuje gusuma; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.20",
            "verseOrgIds": [
              "GEN.43.20"
            ]
