            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "hanyuma rero dutāhūtse, dushitse ku ndāro, dutekurura amagunira yacu, maz’ umuntu wese asanga amahera yiwe ari mu munwa w’ igunira ryiwe, amahera yacu uko yakanganye kwose: none turayagarukanye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.21",
            "verseOrgIds": [
              "GEN.43.21"
            ]
          }
        },
        {
