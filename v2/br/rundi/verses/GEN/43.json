                "loc": "GEN.41.57"
              },
              "items": [
                {
                  "text": "Ita 41:57",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigoyi kirushiriza kuba cinshi mu gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.1",
            "verseOrgIds": [
              "GEN.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze za mpeke bakuye muri Egiputa, se arababgira, at’ Enda ni musubireyo, mudusumire utwo kurya. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.2",
            "verseOrgIds": [
              "GEN.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.20"
              },
              "items": [
                {
                  "text": "Ita 42:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda aramwishura, ati Wa mugabo yararenzwe, avuga ko tutazomugaruka mu maso tutajanye na murumuna wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.3",
            "verseOrgIds": [
              "GEN.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni waturungikana na murumuna wacu turamanukayo, tugusumire; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.4",
            "verseOrgIds": [
              "GEN.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko n’utamuturungikana, ntitumanukayo: kuk’ uwo mugabo yatubariye, ati Ntimuzongaruka mu maso mutazananye na murumuna wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.5",
            "verseOrgIds": [
              "GEN.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isirayeli arababaza, ati N’iki catumye mungirira nabi murtyo, mukabarira uwo mugabo ko mufise uwundi muvukana? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.6",
            "verseOrgIds": [
              "GEN.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura, bat’ Uwo mugabo yaratubazaguje ku vyacu, no ku vya bene wacu, ati Mbega so aracariho? Har’ uwundi muvukana? Tumwishura nk’uko yatubajije: twari gushobora dute kumenya kw atubarira kumanukana murumuna wacu? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.7",
            "verseOrgIds": [
              "GEN.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.2"
              },
              "items": [
                {
                  "text": "Ita 42:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda abarira se Isirayeli, ati Rekura uwo muhungu ajane nanje, duheze tuve hasi, tugende; tubone kubaho, twoye gupfa, twe nawe n’abana bacu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.8",
            "verseOrgIds": [
              "GEN.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.42.37"
              },
              "items": [
                {
                  "text": "Ita 42:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe ndamwishinze, abe ari jewe uzomubaza: ni ntamukugarukanira, ngo mmugushikirize, nzoba ngukoreye icaha kitazomvako gushitsa ibihe bidashira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.9",
            "verseOrgIds": [
              "GEN.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ iyo tudateba, none tuba tugarutse ubga kabiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.43.10",
            "verseOrgIds": [
              "GEN.43.10"
            ]
          }
        }
      ]
    },
