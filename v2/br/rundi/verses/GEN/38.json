              "items": [
                {
                  "text": "1 Sam 24:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda yemera kw ar’ ivyiwe, at’ Arantsinze, kuko ntamuhaye Shela umwana wanje. Nuko Yuda ntiyongera kumwegera ukundi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.26",
            "verseOrgIds": [
              "GEN.38.26"
            ]
          }
        }
