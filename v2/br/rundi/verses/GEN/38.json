                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahise amezi nk’atatu, babarira Yuda, bati Tamari umukazana wawe yarasambanye, mber’ afise n’inda. Yuda arababgira, ati Ni mugende mumusohokane, mumute mu muriro. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.24",
            "verseOrgIds": [
              "GEN.38.24"
