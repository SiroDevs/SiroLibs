          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.38.18"
              },
              "items": [
                {
                  "text": "Ita 38:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakimusohokana, atuma kuri sebukwe, ati Nyen’ ibi bintu ni we yanteye inda; kand’ ati Ndakwinginze, itegereze ivyo, inavyo uw’ari we: iyo mpeta irikw ikimenyetso, n’imigozi yayo, n’iyo nkoni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.38.25",
            "verseOrgIds": [
              "GEN.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
