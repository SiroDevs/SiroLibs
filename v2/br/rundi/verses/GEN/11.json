          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arupakisadi amaze kuvyara Shela, amara imyaka amajana ane n’iyindi itatu, ayivyaramw’ abahungu n’abakobga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.13",
