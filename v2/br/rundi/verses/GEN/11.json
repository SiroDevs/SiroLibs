        },
        {
          "text": "Arupakisadi amaze imyaka mirongwitatu n’itanu avyara Shela: ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.12",
            "verseOrgIds": [
              "GEN.11.12"
