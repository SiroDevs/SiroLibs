              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo ruvyaro rwa Tera: Tera yavyaye Aburamu na Nahori na Harani; Harani yavyaye Loti. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.27",
            "verseOrgIds": [
              "GEN.11.27"
            ]
          }
