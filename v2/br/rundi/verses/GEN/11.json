              "type": "text"
            }
          ]
        },
        {
          "text": "Uru ni rwo ruvyaro rwa Shemu. Shemu amaze imyaka ijana avyara Arupakisadi, wa mwuzure umaze imyaka ibiri uhavuye. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.10",
            "verseOrgIds": [
              "GEN.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu amaze kuvyara Arupakisadi, amara imyaka amajana atanu, ayivyaramw’ abahungu n’ abakobga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.11",
            "verseOrgIds": [
              "GEN.11.11"
            ]
          }
        }
