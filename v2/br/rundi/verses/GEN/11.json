          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Harani apfira mu gihugu yavukiyemwo, ahitwa Uri i Bukaludaya, se Tera akiriho. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.28",
            "verseOrgIds": [
