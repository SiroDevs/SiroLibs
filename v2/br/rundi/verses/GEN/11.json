              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aburamu na Nahori bararongora: muka Aburamu yitwa Sarayi, muka Nahori yitwa Miluka, mwene Harani, Harani se wa Miluka na Yisika. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.11.29",
