        },
        {
          "text": "Ūzovisha amaraso y’ umuntu, n’ayiwe azovishwa n’abandi: kuk’ umuntu namuremye mw ishusho yanje, jewe Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.6",
            "verseOrgIds": [
              "GEN.9.6"
            ]
          }
        },
        {
          "name": "verse",
