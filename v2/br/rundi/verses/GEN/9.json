              "items": [
                {
                  "text": "Ita 6:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "iti Rāba jewe ubganje nshinze isezerano mbasezeraniye, mwe n’uruvyaro rwanyu ruzobakomōkako, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.9",
            "verseOrgIds": [
              "GEN.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibifise ubugingo vyose biri kumwe namwe, ibiguruka n’ibitungano n’ibikōko vyo kw isi muri kumwe: ek’ ibisohotse mu bgato vyose, ibikōko vyose vyo kw isi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.10",
            "verseOrgIds": [
              "GEN.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.54.9"
              },
              "items": [
                {
                  "text": "Yes 54:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nshinze isezerano mbasezeraniye: ibifise umubiri vyose ntibizosubira kurandurwa n’amazi y’umwuzure ukundi, kandi ntihazobah’ umwuzure wo gutikiza isi ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.11",
            "verseOrgIds": [
              "GEN.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana iravuga, it’ Iki ni co kimenyamenya c’isezerano mbasezeraniye, mwe n’ibifise ubugingo vyose muri kumwe, uk’ urunganwe rwanyu ruzogenda rukurikirana gushitsa ibihe vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.12",
            "verseOrgIds": [
              "GEN.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.1.28"
              },
              "items": [
                {
                  "text": "Ezk 1:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.4.3"
              },
              "items": [
                {
                  "text": "Ivyah 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nshize umuheto wanje ku gicu, ni wo munywamazi, uzoba ikimenyamenya c’isezerano nsezeraniye isi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.13",
            "verseOrgIds": [
              "GEN.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uko nzozana igicu hejuru y’isi, uwo muheto w’umunywamazi uzobonekera kuri co, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.14",
            "verseOrgIds": [
              "GEN.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 9:15"
          },
