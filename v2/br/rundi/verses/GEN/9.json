                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibikōko vyose vyo mw isi n’ibiguruka mu kirere vyose muzobitera ubgoba, bizobatinya; murabihawe, bo n’ibinyagara kw isi vyose, n’amafi yose yo mu kiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.2",
            "verseOrgIds": [
              "GEN.9.2"
            ]
          }
        },
        {
