          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shemu na Yafeti bābīra umwambaro, bawukika ku bitugu vyabo bompi, bagenza imigongo, bapfuka ubgambure bga se: kand’ amaso yabo, kuko yar’ aroye irya, ntibabona ubgambure bga se. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.23",
            "verseOrgIds": [
              "GEN.9.23"
            ]
          }
        },
