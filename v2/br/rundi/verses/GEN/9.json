            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ amaraso yanyu, ari bgo bugingo bganyu, sinzobura kuyahōra: ar’ igikōko cose, ar’ umuntu, nzoyabihōra: ubugingo bg’umuntu nzobuhōra mugenzi we wese yabikoze. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.5",
            "verseOrgIds": [
              "GEN.9.5"
            ]
          }
        },
