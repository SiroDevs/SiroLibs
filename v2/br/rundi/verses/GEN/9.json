                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanje nzokwibuka iryo sezerano ryanje nshize hagati yanje namwe bo n’ibiri n’ ubugingo vyose bifise umubiri: kand’ amazi ntazokwongera ukundi kuba umwuzure wo guhonnya ibifise umubiri vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.15",
            "verseOrgIds": [
