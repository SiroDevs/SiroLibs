          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adamu yongera kubana n’ umugore wiwe, avyara umuhungu, amwita Seti, ati Kukw Imana inshumbushije urundi ruvyaro mu gishingo ca Abeli, kuko Kayini yamwishe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.25",
            "verseOrgIds": [
              "GEN.4.25"
            ]
          }
        },
