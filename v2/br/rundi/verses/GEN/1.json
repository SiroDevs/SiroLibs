            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana iravuga, iti Ni habeh’ itāzānure hagati y’amazi, ritandukanye amazi n’ayandi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.6",
            "verseOrgIds": [
              "GEN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana iraritāzānura, itandukanya amazi yo musi y’itāzānure n’ayo hejuru yaryo: biba kuno. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.7",
            "verseOrgIds": [
              "GEN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ iryo tāzānure Imana iryita Ijuru. Buragoroba, buraca: uwo n’umusi ugira kabiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.1.8",
            "verseOrgIds": [
              "GEN.1.8"
            ]
          }
        }
