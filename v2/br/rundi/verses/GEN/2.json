          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urwo rubavu Uhoraho Imana akūye mur’ uwo muntu, arukūramw’ umugore, amuzanira uwo muntu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.22",
