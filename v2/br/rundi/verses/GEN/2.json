              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho Imana asinziriza uwo muntu ubutikoma, arasinzira: amukūramw’ urubavu rumwe, ahōmeka inyama mu gishingo carwo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.2.21",
            "verseOrgIds": [
              "GEN.2.21"
            ]
