              "items": [
                {
                  "text": "27:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ava i Beri‐sheba, agenda atumbereye i Harani. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.10",
            "verseOrgIds": [
              "GEN.28.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ashika ahantu araharāra, kukw izuba ryari ricokeye: yābīra ibuye mu mabuye yaho, araryisegura, aryama aho hantu arasinzira. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.11",
            "verseOrgIds": [
              "GEN.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.33.15"
              },
              "items": [
                {
                  "text": "Yob 33:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.33.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.51"
              },
              "items": [
                {
                  "text": "Yoh 1:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ararota, abona icuririzo gishinzwe hasi, umutwe waco ugashika mw ijuru: abona abamarayika b’ Imana bakidūgako, bakimanukako. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.12",
            "verseOrgIds": [
              "GEN.28.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
