            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.24.3+GEN.24.4+GEN.24.5+GEN.24.6"
              },
              "items": [
                {
                  "text": "Ita 24:3-6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Isaka ahamagara Yakobo, aramuhezagira, aramwihanikiriza, ati Ntuz’ usabe Umunyakananikazi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.1",
            "verseOrgIds": [
              "GEN.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.20"
              },
              "items": [
                {
                  "text": "Ita 25:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Va hasi, uje i Padan‐aramu kwa Betuweli sogokuru; uz’ usabey’ umugeni mu bakobga ba Labani nyokorome. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.2",
            "verseOrgIds": [
              "GEN.28.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.1"
              },
              "items": [
                {
                  "text": "Ita 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Imana Ishobora vyose iguhe umugisha, iguhe kurondoka, ikugwize, kugira ng’uhindukemw’ isinzi ry’amahanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.3",
            "verseOrgIds": [
              "GEN.28.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.2"
              },
              "items": [
                {
                  "text": "Ita 12:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.12.3"
              },
              "items": [
                {
                  "text": "3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.17.8"
              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iguhe umugisha yahaye Aburahamu, wewe n’uruvyaro rwawe na rwo, kugira ngo wegukire iki gihugu wabayemwo kitār’ icanyu, ico Imana yemereye guha Aburahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.4",
            "verseOrgIds": [
              "GEN.28.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.12.12"
              },
              "items": [
                {
                  "text": "Hos 12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Isaka arungika Yakobo: aragenda, aja i Padan‐aramu kwa Labani mwene Betuweli Umwaramu, musaza wa Rebeka, nyina wa Yakobo na Esau.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.5",
            "verseOrgIds": [
              "GEN.28.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Esau abona yuko Isaka ahezagiye Yakobo, akamurungika i Padan‐aramu gusabay’ umugeni; kandi ko yamwihanikirije akimuhezagira, ati Ntuz’ usabe Umunyakananikazi; ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.6",
            "verseOrgIds": [
              "GEN.28.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ko Yakobo yumviye se na nyina, akaja i Padan‐aramu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.7",
            "verseOrgIds": [
              "GEN.28.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.26.35"
              },
              "items": [
                {
                  "text": "Ita 26:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Esau abonye yukw Abanyakananikazi batanezereye se wiwe Isaka, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.8",
            "verseOrgIds": [
              "GEN.28.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.13"
              },
              "items": [
                {
                  "text": "Ita 25:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.3"
              },
              "items": [
                {
                  "text": "36:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "aca aja kwa Ishimayeli, asabayo Mahalati mushiki wa Nebayoti, umukobga wa Ishimayeli, Ishimayeli mwene Aburahamu, amuharika ba bagore yar’asanganywe.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.28.9",
            "verseOrgIds": [
              "GEN.28.9"
            ]
          }
        }
      ]
    },
