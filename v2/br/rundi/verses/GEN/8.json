              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ibarira Nowa, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.15",
            "verseOrgIds": [
              "GEN.8.15"
            ]
          }
        },
        {
