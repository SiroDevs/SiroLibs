              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.23"
              },
              "items": [
                {
                  "text": "Rom 6:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ko bimeze birtyo, nk’ukw icaha cazanywe mw isi n’umuntu umwe, urupfu rukazanwa n’icaha, ni k’urupfu rushika ku bantu bose, kuko bose bākoze ivyaha: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.12",
            "verseOrgIds": [
              "ROM.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.4.15"
              },
              "items": [
                {
                  "text": "Rom 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyagezwe bitarabaho, icaha cari mw isi, arikw abantu ntibāharūrwakw icaha, ivyagezwe bitariho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.13",
            "verseOrgIds": [
              "ROM.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.21"
              },
              "items": [
                {
                  "text": "1 Kor 15:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.22"
              },
              "items": [
                {
                  "text": "22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.45"
              },
              "items": [
                {
                  "text": "45",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.55"
              },
              "items": [
                {
                  "text": "55",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ uhereye kuri Adamu, ukageza kuri Mose, urupfu rwaganza n’abatākoze icaha gisa n’igicumuro ca Adamu, yar’ igishushanyo c’uwagira az’ aze.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.14",
            "verseOrgIds": [
              "ROM.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ingabire y’Imana ntimera nka ca gicumuro. Kw igicumuro c’umwe catumye abenshi bapfa, ubuntu bg’Imana n’ingabire y’ubuntu bg’umuntu umwe Yesu Kristo vyarushirije gusāguka kuri benshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.15",
            "verseOrgIds": [
              "ROM.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iyo ngabire ntiyaje nk’icazanywe n’igicumuro c’umuntu umwe: kuko gucirwa urubanza kwavuye ku muntu umwe, kugatera gutsindwa, ariko ya ngabire yavuye mu bicumuro vyinshi, izana gutsindanishirizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.16",
            "verseOrgIds": [
              "ROM.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kw igicumuro c’umwe catumye urupfu rushirwa ku ngoma n’umwe, abākīra ubuntu n’ingabire yo kugororoka bisēsekaye bazorushiriza gushirwa ku ngoma mu bugingo n’umwe, Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.5.17",
            "verseOrgIds": [
              "ROM.5.17"
            ]
          }
        }
      ]
