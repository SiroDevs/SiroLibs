                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko tuvuge iki? Mbeg’ ivyagezwe n’icaha? Eka na mba. Ariko simba naramenye icaha, iyo ntakimenyeshwa n’ivyagezwe; kuko ntaba naramenye ukwifuza, iy’ ivyagezwe bitavuga ngo Ntukifuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.7",
            "verseOrgIds": [
              "ROM.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.13"
              },
              "items": [
                {
                  "text": "Rom 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw icaha kibonye urwitwazo mu vyagezwe, gikorera muri jewe ukwifuza kw’uburyo bgose: kukw icaha kiba gipfuye, ivyagezwe bitariho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.8",
            "verseOrgIds": [
              "ROM.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje kera nariho, ntafise ivyagezwe: maz’ icagezwe kije, icaha kirarabūka, nanje ndapfa; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.9",
            "verseOrgIds": [
              "ROM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JAS.1.15"
              },
              "items": [
                {
                  "text": "Yak 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lew 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ico cagezwe co kuzana ubugingo nakibona kinzanira urupfu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.10",
            "verseOrgIds": [
              "ROM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.3.13"
              },
              "items": [
                {
                  "text": "Heb 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw icaha campendahenze, kibonye urwitwazo mu cagezwe, kandi kigitera kunyica. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.11",
            "verseOrgIds": [
              "ROM.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.1.8"
              },
              "items": [
                {
                  "text": "1 Tim 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rer’ ivyagezwe n’ivyera, kand’ ibgirizwa n’iryera, rigororotse, ryiza.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.12",
            "verseOrgIds": [
              "ROM.7.12"
            ]
          }
        }
      ]
    },
