          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw iciza ngomba atari co nkora, arikw ikibi ntagomba akaba ari co nkora. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.19",
            "verseOrgIds": [
              "ROM.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
