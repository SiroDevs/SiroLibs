            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.5.20"
              },
              "items": [
                {
                  "text": "Rom 5:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ iciza cambereye urupfu? Eka na mba! Arikw icaha ni co cārubaye, ngo kimenyekane kw ar’ icaha, kuko canyicishije iciza, ngw icagezwe gitume icaha kirushiriza kuba kibi.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.13",
            "verseOrgIds": [
              "ROM.7.13"
            ]
          }
        }
      ]
    },
