                "loc": "ROM.6.2"
              },
              "items": [
                {
                  "text": "6:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.4"
              },
              "items": [
                {
                  "text": "4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneho ntitukiganzwa n’ivyagezwe, kuko twapfuye ku camye kidufashe, ni co gituma tuba abagurano, dukorera Mpwemu adukoresha uburyo busha, tudakoreshwa bga buryo bga kera bg’inyuguti.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.6",
            "verseOrgIds": [
              "ROM.7.6"
            ]
          }
        }
      ]
    },
