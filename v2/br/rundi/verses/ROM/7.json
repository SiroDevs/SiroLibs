            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "COL.2.14"
              },
              "items": [
                {
                  "text": "Kol 2:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero namwe, bene Data, gukoranywa n’umubiri wa Kristo kwatumye mucika abapfuye ku vyagezwe, kugira ngo mwābīrwe n’uwundi, ni we yazutse mu bapfuye, twamire Imana imbuto. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.4",
            "verseOrgIds": [
              "ROM.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.6.21"
              },
              "items": [
                {
                  "text": "Rom 6:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukiganzwa n’akameremere kacu, ukwifuza kw’ivyaha kw’uburyo bginshi kwazanywe n’ivyagezwe kwakorera mu mibiri yacu, kugira ngo twamire urupfu imbuto. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.5",
            "verseOrgIds": [
              "ROM.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.1"
              },
              "items": [
                {
                  "text": "Rom 8:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.8.2"
              },
