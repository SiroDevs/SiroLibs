          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ko nkora ico ntagomba, si jewe nkigikora, ariko n’icaha kimbamwo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.7.20",
            "verseOrgIds": [
              "ROM.7.20"
            ]
          }
        }
