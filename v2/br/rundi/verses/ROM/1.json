          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nk’uko banse kumenya Imana mu mitima yabo, ni kw Imana yabahevye ngo bagire imitima y’akāhebge, bakore ibitabereye; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.28",
            "verseOrgIds": [
              "ROM.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "buzuye ukugabitanya kwose, no kugira nabi, no kwifuza, n’urwanko rw’ubusa: buzuye n’igono, n’ubgicanyi, no gutongana, n’ubugunge, no kwitamba ku muvyimba; n’abaneguranira mu vyongorerano, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.29",
            "verseOrgIds": [
              "ROM.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ROM 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’abavuga abandi nabi, n’abanka Imana, n’abatukana, n’abībona, n’abīrārīra, n’abīgenera ibibi, n’abatumvira abavyeyi, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.30",
            "verseOrgIds": [
              "ROM.1.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ROM 1:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibipfu, n’abava mw isezerano, n’abadakunda n’ababo, n’imburakigongwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.31",
            "verseOrgIds": [
              "ROM.1.31"
            ]
          }
        },
