          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye Imana ibaheba ngo bifuze ivyonona: kukw abagore babo ic’ imibiri yabo yaremewe bāgihinduye ukundi, itāremewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.26",
            "verseOrgIds": [
              "ROM.1.26"
            ]
          }
        },
        {
