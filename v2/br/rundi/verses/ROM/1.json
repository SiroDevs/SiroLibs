              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndabandikiye mwese mur’ i Roma mukundwa n’Imana, mwahamagariwe kuba abera. Ubuntu bube muri mwebge n’amahoro, biva ku Mana, Data wa twese, no ku Mwami Yesu Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.7",
            "verseOrgIds": [
              "ROM.1.7"
            ]
          }
