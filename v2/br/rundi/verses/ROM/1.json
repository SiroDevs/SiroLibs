              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye Imana ibaheba ngo bakore ibiteye isoni, bumvire ivy’ imitima yabo yifuza, bonone imibiri yabo, ",
          "type": "text",
          "attrs": {
