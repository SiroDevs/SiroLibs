              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we yaduhesheje ubuntu no kuba intumwa kubg’ izina ryiwe, kugira ngo mu mahanga yose habemw’ abumvira Imana, babiheshwa no kwizera: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.5",
            "verseOrgIds": [
              "ROM.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi namwe muri muri bo, mwahamagariwe kuba aba Yesu Kristo: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.6",
            "verseOrgIds": [
              "ROM.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
