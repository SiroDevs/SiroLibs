        },
        {
          "text": "Paulo, umugurano wa Yesu Kristo, nahamagariwe kuba intumwa, narobanuriwe ubutumwa bgiza bg’Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.1",
