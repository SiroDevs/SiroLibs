            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Irya mbere, mwese mbashimiye Imana yanje muri Yesu Kristo, kukw inkuru y’ukwizera kwanyu ikwiye mw isi yose. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.8",
            "verseOrgIds": [
              "ROM.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
