                  "text": "1 Kor 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’abagabo n’uko, bāretse kugirira abagore ivy’ imibiri yabo yaremewe, bashuha babengukana, abagabo bagirira abandi bagabo ibiteye isoni, kandi mu mibiri yabo bahabga ingero zikwiranye n’ubuzimire bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.27",
            "verseOrgIds": [
              "ROM.1.27"
            ]
          }
        },
        {
          "name": "verse",
