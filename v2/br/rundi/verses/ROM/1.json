              },
              "items": [
                {
                  "text": "Tit 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.16.25"
              },
              "items": [
                {
                  "text": "Rom 16:25",
