                {
                  "text": "2 Tim 2:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "buvuga ivy’ Umwana wayo, yavutse mu ruvyaro rwa Dawidi mu buryo bg’umubiri, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.3",
            "verseOrgIds": [
              "ROM.1.3"
            ]
          }
        },
        {
