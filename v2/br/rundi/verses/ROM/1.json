        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PHP.1.8"
              },
              "items": [
                {
                  "text": "Flp 1:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EPH.1.16"
              },
              "items": [
                {
                  "text": "Ef 1:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana, nkorera mu mutima wanje mvuga ubutumwa bgiza bg’Umwana wayo, ni yo ntanzekw icabona yuko mbahoza mu kanwa ubudasība, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.9",
            "verseOrgIds": [
              "ROM.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 1:10"
          },
          "items": [
