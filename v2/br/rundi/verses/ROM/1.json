                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "yerekanywe kw ar’ Umwana w’Imana mu buryo bga Mpwemu Yera, ukuzuka kwiwe kwavyerekanishije ubushobozi, ni we Yesu Kristo Umwami wacu. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.1.4",
            "verseOrgIds": [
              "ROM.1.4"
            ]
          }
        },
        {
