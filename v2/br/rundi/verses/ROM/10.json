    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ROM 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bene Data, ivyohimbara umutima wanje n’ivyo nsengera Abisirayeli ku Mana, n’ukugira ngo bakizwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.1",
            "verseOrgIds": [
              "ROM.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ROM 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.22.3"
              },
              "items": [
                {
                  "text": "Ivyak 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabashingira intahe yuko bafise ishaka ry’Imana, ariko si mu buryo bg’ubgenge. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.2",
            "verseOrgIds": [
              "ROM.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ROM 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.31"
              },
              "items": [
                {
                  "text": "Rom 9:31",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.9.32"
              },
              "items": [
                {
                  "text": "32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko batari bazi ukugororoka kuva ku Mana bakarondera kwishingira ukugororoka kwabo ubgabo, ntibāganjwe n’ukuva ku Mana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.3",
            "verseOrgIds": [
              "ROM.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.5.17"
              },
              "items": [
                {
                  "text": "Mat 5:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.18"
              },
              "items": [
                {
                  "text": "Yoh 3:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.8.13"
              },
              "items": [
                {
                  "text": "Heb 8:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Kristo ari we ivyagezwe bishikirako, kugira ngw aheshe uwizera wese ukugororoka.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ROM 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.4",
            "verseOrgIds": [
              "ROM.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ROM 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lew 18:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.3.12"
              },
              "items": [
                {
                  "text": "Gal 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose yanditse, at’ Ūshishikara ukugororoka kuva ku vyagezwe ni kwo kuzomubeshaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.5",
            "verseOrgIds": [
              "ROM.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ROM 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.12"
              },
              "items": [
                {
                  "text": "Gus 30:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.13"
              },
              "items": [
                {
                  "text": "13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ ukugororoka kuva ku kwizera kuvuga gurtya, ngo Ntiwibaze, uti Ni nde azodūga, ngw aje mw ijuru? (risobanurwa ngo kumanukana Kristo), ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.6",
            "verseOrgIds": [
              "ROM.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ROM 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "cank’ uti Ni nde azomanuka i kuzimu? (risobanurwa ngo kudūgana Kristo, amukūye mu bāpfuye). ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.7",
            "verseOrgIds": [
              "ROM.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ROM 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.14"
              },
              "items": [
                {
                  "text": "Gus 30:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko kwavuze gute? Kwavuze kut’ Ijambo riri hafi yawe, riri mu kanwa kawe no mu mutima wawe; ni ryo jambo ryo kwizera, iryo tubigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.8",
            "verseOrgIds": [
              "ROM.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ROM 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CO.4.5"
              },
              "items": [
                {
                  "text": "2 Kor 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ni wāturisha akanwa yuko Yesu ar’ Umwami, ukizera mu mutima yukw Imana yamuzuye imukūye mu bapfuye, uzokizwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.9",
            "verseOrgIds": [
              "ROM.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ROM 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umutima ari wo umuntu yizeresha, akaronka ukugororoka: kand’ akanwa akaba ari ko yāturisha, akaronka agakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.10",
            "verseOrgIds": [
              "ROM.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ROM 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.28.16"
              },
              "items": [
                {
                  "text": "Yes 28:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyanditswe bivuga, ng’ Ūmwizera wese ntazoterwa n’isoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.11",
            "verseOrgIds": [
              "ROM.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ROM 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.10.34"
              },
              "items": [
                {
                  "text": "Ivyak 10:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.15.9"
              },
              "items": [
                {
                  "text": "15:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta tandukaniro ry’Umuyuda n’Umugiriki: kuk’ Umwami umwe ar’ Umwami wa bose, ni we afise ubutunzi bukwiye abamwambaza bose; ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.12",
            "verseOrgIds": [
              "ROM.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.32"
              },
              "items": [
                {
                  "text": "Yow 2:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko, Umuntu wese azokwambaza izina ry’Uhoraho azokizwa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.13",
            "verseOrgIds": [
              "ROM.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ROM 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "None bazokwambaza bate uwo batarizera? Kandi bazokwizera bate uwo batarumva? Kandi bazokwumva bate, ata wabasiguriye ivyiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.14",
            "verseOrgIds": [
              "ROM.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ROM 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.52.7"
              },
              "items": [
                {
                  "text": "Yes 52:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bazosigura ivyiwe bate, batātumwe? Nk’uko handitswe, ngw Ewe kuntu ibirenge vy’abazanye ubutumwa bg’ivyiza ari vyiza! ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.15",
            "verseOrgIds": [
              "ROM.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ROM 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.53.1"
              },
              "items": [
                {
                  "text": "Yes 53:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw abumviye ubutumwa bgiza si bose. Kuko Yesaya yavuze, ati Mwami, ni nde yemeye ivyo twumvise? ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.16",
            "verseOrgIds": [
              "ROM.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.17.20"
              },
              "items": [
                {
                  "text": "Yoh 17:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ ukwemera kuva ku kwumva, n’ukwumva kuzanwa n’ijambo rya Kristo.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ROM 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.17",
            "verseOrgIds": [
              "ROM.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ROM 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ndabaza: Mbega ntibumvise? Ego, bārumvise.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.10.18",
            "verseOrgIds": [
              "ROM.10.18"
            ]
          }
        }
      ]
    }
  ],
