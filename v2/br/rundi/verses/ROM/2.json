              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ko witwa Umuyuda, ukishimira ivyagezwe, ukirata Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.17",
            "verseOrgIds": [
