          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abākoze ivyaha bose, batazi ivyagezwe, bazohona ivyagezwe bitarinze kwiyumvirwa; kand’ abākoze ivyaha bose bazi ivyagezwe bazotsindishwa n’ivyagezwe: ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.12",
            "verseOrgIds": [
              "ROM.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ROM 2:13"
