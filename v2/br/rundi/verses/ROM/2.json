                "loc": "PSA.62.12"
              },
              "items": [
                {
                  "text": "Zab 62:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.24.12"
              },
              "items": [
                {
                  "text": "Imig 24:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.27"
              },
              "items": [
                {
                  "text": "Mat 16:27",
