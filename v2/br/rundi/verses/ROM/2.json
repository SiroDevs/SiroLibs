            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ukamenya ivy’ igomba, ukarobanura ibidahwana, kuko wigishijwe ivy’ ivyagezwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.2.18",
            "verseOrgIds": [
