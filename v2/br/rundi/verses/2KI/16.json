              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igicaniro c’umuringa car’ imbere y’Uhoraho, agikūra aho cari kiri imbere y’ingoro y’Uhoraho, hagati y’ico gicaniro ciwe n’iyo ngoro, agitereka i ruhande y’ico gicaniro ciwe ahahera i burārūko. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
