        },
        {
          "text": "Mu mwaka ugira icumi n’ indwi Peka mwene Remaliya ari ku ngoma, ni ho Ahazi mwene Yotamu, umwami w’i Buyuda, yima. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
