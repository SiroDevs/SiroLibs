        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.21"
              },
              "items": [
                {
                  "text": "2 Ngo 28:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.5"
              },
              "items": [
                {
                  "text": "Am 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.9.7"
              },
              "items": [
                {
                  "text": "9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’i Ashuri aramwemerera, aradūga atera i Damasiko, arahatsinda; abaho abajana ar’ inyagano i Kiri, kandi yica Rezini.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
