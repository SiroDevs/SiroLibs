            }
          ]
        },
        {
          "text": "Bukeye Rezini umwami w’i Siriya, na Peka mwene Remaliya umwami w’Abisirayeli, baradūga batera i Yerusalemu; basugereza Ahazi, ariko ntibashobora kumunesha. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.14.22"
              },
              "items": [
                {
                  "text": "2 Abam 14:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Rezini umwami w’i Siriya, akūra Abayuda i Elati arabirukana, Elati asubira kuhagarura i Siriya, maz’ Abasiriya baza i Elati, bagerērayo na bugingo n’ ubu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
