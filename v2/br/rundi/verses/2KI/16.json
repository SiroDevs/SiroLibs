          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.1+2CH.28.2+2CH.28.3+2CH.28.4"
              },
              "items": [
                {
                  "text": "2 Ngo 28:1-4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yar’ amaze imyaka mirongwibiri igihe yima, amara imyaka cumi n’itandatu i Yerusalemu ari ku ngoma. Mugabo ntiyakora ivyo Uhoraho Imana yiwe abona kw ari vyiza, nk’uko sekuruza Dawidi yakora; ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
