            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami Ahazi abarira Uriya umuherezi, ati Kur’ iki gicaniro kinini abe ari ho uzohora wosereza ikimazi c’ukwoswa co mu gatondo, n’ishikanwa ry’ amafu ryo ku mugoroba, bo n’ ikimazi canje ubganje c’ukwoswa, n’ishikanwa ryanje ry’amafu, hamwe n’ikimazi c’ukwoswa c’igihugu cose, n’ishikanwa ryabo ry’ amafu, n’amashikanwa yabo y’ibiturire, ukimijeko n’amaraso yose y’ikimazi c’ukwoswa, n’amaraso yose y’ibindi bimazi; na co igicaniro c’umuringa kizoba ico nzohora nsigurizako Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Uriya umuherezi yagenza nk’uk’ umwami Ahazi yamubariye kwose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
