                "loc": "1KI.14.23"
              },
              "items": [
                {
                  "text": "1 Abam 14:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yatanga ibimazi akosereza imibavu mu bitabo no ku mpinga z’imisozi no musi y’igiti cose gitotahaye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
