              },
              "items": [
                {
                  "text": "Hag 1:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Elisa yari yarabariye wa mugore yazurira umwana, at’ Enda genda, mwe n’abo mu rugo rwawe, urondere ah’ usuhukira, kuk’ Uhoraho arekuye inzara, kand’ izomara imyaka ndwi mu gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.1.1"
              },
              "items": [
                {
                  "text": "Rus 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo mugore aragenda, agira nk’uk’ uwo muntu w’Imana yavuze, ajana n’abo mu rugo rwiwe, asuhukira mu gihugu c’Abafilisitiya, amaray’ imyaka ndwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo myaka ndwi ishize, uwo mugore arasuhukuruka, ava mu gihugu c’Abafilisitiya; araheza araza atakambira umwami, yitwarira urugo rwiwe n’itongo ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.3",
            "verseOrgIds": [
              "2KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.12"
              },
              "items": [
                {
                  "text": "2 Abam 4:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uwo mwanya umwami yarikw arabonana na Gehazi, wa musuku wa wa muntu w’Imana, amubaza, at’ Enda mbarira ibintu bikomeye Elisa yakoze vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.4",
            "verseOrgIds": [
              "2KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.4.35"
              },
              "items": [
                {
                  "text": "2 Abam 4:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw akirikw arīgānira umwami ingene yazuye uwapfuye, ako kanya nya mugore yazuriye umwana arashika; atakambira umwami yitwarira urugo rwiwe n’itongo ryiwe. Gehazi aca aravuga, ati Mwami wanje nyen’ ingoma, nguyu wa mugore navuga, nguyu na wa mwana wiwe Elisa yazura. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami abibaza uwo mugore, na we arabimudondera. Umwami aca amuha umushikiriza, ati Genda umushikirize ibintu vyiwe vyose, n’ivyahimbuwe vyose uhereye ku musi yahaviriye ugashitsa n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
