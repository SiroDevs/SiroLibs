          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Yehoramu, n’ivyo yakoze vyose, none ntivyanditswe mu gitabo c’ivyo ku ngoma z’ abami b’Abayuda? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
