        },
        {
          "text": "Bukeye Elisa aja i Damasiko; ico gihe Beni‐hadadi umwami w’i Siriya yar’ arwaye; baramubarira, bati Wa muntu w’Imana yaje ar’ ino. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.7",
            "verseOrgIds": [
              "2KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
