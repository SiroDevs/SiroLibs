              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni kw Abanyedomu bīkūye ku Bayuda gushitsa na bugingo n’ubu. Ico gihe ab’ i Libuna na bo baramugarariza. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        },
        {
          "name": "verse",
