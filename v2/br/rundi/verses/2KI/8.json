                "loc": "1SA.9.7"
              },
              "items": [
                {
                  "text": "1 Sam 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.15"
              },
              "items": [
                {
                  "text": "1 Abam 19:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.19.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.1.2"
              },
              "items": [
                {
                  "text": "2 Abam 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami abarira Hazayeli, at’ Enda abīra ingemu, uje guhūra n’uyo muntu w’Imana, umubarire ansigurize Uhoraho yuko nzokira iyi ndwara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hazayeli aja guhūra na we atwaye ingemu zo ku vyiza‐vyiza vyose vy’i Damasiko, abiremētse ingamiya mirongwine; nukw arashika ahagarara imbere yiwe, aramubarira, at’ Umwana wawe Beni‐hadadi, umwami w’i Siriya, arantumye, ngo Mbeg’ ubona azokira iyo ndwara yiwe? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa aramwishura, ati Genda umubarire, uti Gukira uzokira; ariko rer’ Uhoraho anyeretse kw azopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araheza amushinga ijisho, kugeza aho Hazayeli yagiriye isoni. Uwo muntu w’Imana arahava ararira. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.11",
            "verseOrgIds": [
              "2KI.8.11"
            ]
          }
        },
        {
