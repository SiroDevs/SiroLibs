                {
                  "text": "15:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo Uhoraho yanka guhonnya Abayuda kubga Dawidi umusavyi wiwe, nk’uko yari yaramusezeraniye kuzomuha itara rizokwama ryaka mu ruvyaro rwiwe ibihe vyose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
