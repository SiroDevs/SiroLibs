                "loc": "2SA.21.17"
              },
              "items": [
                {
                  "text": "2 Sam 21:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.11.36"
              },
              "items": [
                {
                  "text": "1 Abam 11:36",
