              },
              "items": [
                {
                  "text": "Luk 17:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma agarukana n’abantu biwe bose kur’ uwo muntu w’ Imana, araza ahagarara imbere yiwe, aramubarira, ati Noneho ndamenye kw ata yindi Mana iriho mw isi yose, atari mu Bisirayeli; enda rero ni wābīre ingemu nguhaye jewe umusavyi wawe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.15",
            "verseOrgIds": [
              "2KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.14.23"
              },
              "items": [
                {
                  "text": "Ita 14:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa aramwishura, ati Nkurahiye uguhoraho kw’Uhoraho, uwo nsavye, nta kintu na kimwe nshobora kwābīra. Aramugōbēra ngw avyābīre, arikw aranka. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.16",
            "verseOrgIds": [
              "2KI.5.16"
            ]
          }
        },
