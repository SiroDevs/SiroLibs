              },
              "items": [
                {
                  "text": "Luk 4:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namani, umugabisha w’ingabo z’umwami w’i Siriya, yar’ atonnye kuri shebuja, kandi yar’ umunyacubahiro, kukw ari we Uhoraho yaha inganji yatuma Abasiriya banesha; yar’ umuhizi w’inkomezi, ariko yar’ umunyamibembe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.1",
            "verseOrgIds": [
              "2KI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.6.23"
              },
              "items": [
                {
                  "text": "2 Abam 6:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abasiriya bāri baragiye kunyaga ar’ ibitero; mur’ ukwo kunyaga banyaga umwigeme mutoya mu gihugu c’Abisirayeli; araheza acorekera muka Namani. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.2",
            "verseOrgIds": [
              "2KI.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye abarira inabuja, at’ Icompa databuja akaja k’ūvugishwa n’Imana aba i Samariya! Yomukiza iyo mibembe yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.3",
            "verseOrgIds": [
              "2KI.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Namani aja kubarira shebuja; at’ Umwigeme yavuye mu gihugu c’Abisirayeli yavuze artya n’artya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.4",
            "verseOrgIds": [
              "2KI.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JDG.14.12"
              },
              "items": [
                {
                  "text": "Abac 14:12",
