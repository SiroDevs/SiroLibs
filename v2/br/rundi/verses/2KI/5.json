              },
              "items": [
                {
                  "text": "9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami w’i Siriya aramubarira, ati Shirak’ ugende, nanje ndandikira umwami w’Abisirayeli icete. Nukw aragenda, ajana amafeza italanto cumi n’amazahabu shekeli ibihumbi bitandatu n’imyambaro cumi yo gukūranya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.5",
            "verseOrgIds": [
              "2KI.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ashīra umwami w’Abisirayeli ico cete, cāvuga, ngw Ico cete ni cagushikīra, urabona ko nkurungikiye umusavyi wanje Namani ng’ umukize imibembe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.6",
            "verseOrgIds": [
              "2KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.30.2"
              },
              "items": [
                {
                  "text": "Ita 30:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.44.13"
              },
              "items": [
                {
                  "text": "44:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.32.39"
              },
              "items": [
                {
                  "text": "Gus 32:39",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.20.7"
              },
              "items": [
                {
                  "text": "1 Abam 20:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami w’Abisirayeli asomye ico cete, yitantamurirakw impuzu ziwe, aravuga, ati Mbega jewe nd’ Imana, ngo ntume umuntu apfa canke ngw abeho, k’uyo mugabo andungikiye umuntu ngo ndamukize imibembe? Ehe rāba ingen’ anyigenzako, muheze muvyiyumvire!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.7",
            "verseOrgIds": [
              "2KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
