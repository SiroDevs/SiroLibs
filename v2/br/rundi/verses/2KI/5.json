              "2KI.5.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.5"
              },
              "items": [
                {
                  "text": "Ezk 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Elisa wa muntu w’Imana yumvise k’umwami w’Abisirayeli yitantamuriyekw impuzu ziwe, amutumako, uti N’iki gitumye witantamurirakw impuzu zawe? N’aze i wanje, aramenya yuko mu Bisirayeli harih’ ūvugishwa n’ Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.8",
            "verseOrgIds": [
              "2KI.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Namani araza, azana n’amafarasi yiwe n’imikogote yiwe, ahagarara ku muryango w’inzu ya Elisa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.9",
            "verseOrgIds": [
              "2KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.9.7"
              },
              "items": [
                {
                  "text": "Yoh 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa araheza amutumako, uti Genda wiyuhagire muri Yorodani ibihetangabo ndwi, umubiri uraca usubira uko wahora, nawe uzoba uhumanutse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.10",
            "verseOrgIds": [
              "2KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Namani aca araraka, arivumbura, ati Nahoze ngira ngw arasohoka ahagarare, atakambire izina ry’Uhoraho Imana yiwe, azungagize ukuboko hejuru y’ aho ndwaye, ankize imibembe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.11",
            "verseOrgIds": [
              "2KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ inzūzi z’i Damasiko, Abana na Farupari, ntiziruta amazi yose y’i Bgisirayeli? Sinoshobora kuziyuhagiramwo ngahumanuka? Nukw arahindukira, agenda aratse. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.12",
            "verseOrgIds": [
              "2KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu biwe baramwēgēra, baramubarira, bati Mbega mutungwa, iyaba uyo muvugishwa n’Imana akurangiye ikintu kigoye, ntiwari kugikora? Nkanswe kukubarira, ngw Iyuhagire uhumanuke? ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.13",
            "verseOrgIds": [
              "2KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.33.25"
              },
              "items": [
                {
                  "text": "Yob 33:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.4.27"
              },
              "items": [
                {
                  "text": "Luk 4:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw aramanuka, yībira muri Yorodani ibihetangabo ndwi, nk’uk’ uwo muntu w’Imana yari yamubariye. Ako kanya umubiri wiwe uhinduka nk’uw’ umwana mutoya, arahumanuka.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.14",
            "verseOrgIds": [
              "2KI.5.14"
            ]
          }
        }
      ]
    },
