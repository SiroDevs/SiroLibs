              "attrs": {
                "loc": "HEB.1.5"
              },
              "items": [
                {
                  "text": "Heb 1:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riti Ni we azokwubakira izina ryanje ingoro; riti Kand’ azoba umwana wanje, nanje nzoba se; riti Kandi nzohamangira intebe yiwe mu Bgisirayeli ibihe vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mwana wanje, Uhoraho abane nawe; aguhe kugira ikiganza ciza, wubake ingoro y’ Uhoraho Imana yawe, nk’uko yabikuvuzeko. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.9"
              },
              "items": [
                {
                  "text": "1 Abam 3:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.3.12"
              },
              "items": [
                {
                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.1"
              },
              "items": [
                {
                  "text": "Zab 72:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho aguhe ubgenge n’ugutahura, kugira ngo ni yagushikiriza Abisirayeli uz’ ubone kwitondera ivyagezwe vyiwe, Uhoraho Imana yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
