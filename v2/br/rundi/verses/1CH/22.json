              "items": [
                {
                  "text": "1 Ngo 28:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni k’uzogira ubuhirwe, ni wagira umwete ukitondera amabgirizwa n’amatēka Uhoraho yashingiye Abisirayeli, akabishikiriza Mose. Nuko shikama, ushire amanga, ntutinye kandi nturanduke umutima. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.4"
              },
              "items": [
                {
                  "text": "1 Ngo 29:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba mu bucumukure bganje niteguriye ingoro y’Uhoraho italanto z’izahabu ibihumbi ijana, n’iz’ ifeza ibihumbi igihumbi, niteguye n’imiringa n’ ivyuma bitogerwa, kukw ar’ isinzi; kandi niteguye n’ibiti n’amabuye; nawe uze wiyongererekw ibindi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uri n’abakozi benshi cane, ababāji b’amabuye, n’abubatsi, n’ababāji b’ibiti, n’ abahinga b’uburyo bgose bazi gukora igikorwa ic’ ari co cose. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba amazahabu n’amafeza n’imiringa n’ivyuma ntibigira uko vyoharūrika. None rero shirako, ukore, kand’ Uhoraho abane nawe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        }
