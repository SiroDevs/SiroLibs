          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ahamagara umuhungu wiwe Salomo, amubarira kuzokwubakira ingoro Uhoraho Imana y’ Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.17"
              },
              "items": [
                {
                  "text": "1 Abam 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.1"
              },
              "items": [
                {
                  "text": "1 Ngo 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.17.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.132.1+PSA.132.2+PSA.132.3+PSA.132.4+PSA.132.5"
              },
              "items": [
                {
                  "text": "Zab 132:1-5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubarira, ati Mwana wanje, nari mbisanganywe mu mutima kuzokwubakira ingoro izina ry’Uhoraho Imana yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.3"
              },
              "items": [
                {
                  "text": "1 Abam 5:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.28.3"
              },
              "items": [
                {
                  "text": "1 Ngo 28:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw ijambo ry’Uhoraho rinzako, riti Wavishije amaraso menshi, kandi warwanye intambara zihambaye: riti None ntuzokwubakira ingoro izina ryanje, kuko wavishije amaraso menshi kw isi imbere yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.12.24"
              },
              "items": [
                {
                  "text": "2 Sam 12:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.4.25"
              },
              "items": [
                {
                  "text": "1 Abam 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.5.4"
              },
              "items": [
                {
                  "text": "5:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.22.18"
              },
              "items": [
                {
                  "text": "1 Ngo 22:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Riti Rāba uzovyara umwana w’umuhungu, azoba umunyamahoro, riti Kandi nzomuha kuba impore hagati y’abansi biwe bose bamukikije; kukw izina ryiwe azokwitwa Salomo;",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "22:9",
              "type": "text"
            },
            {
              "text": "Salomo risobanurwa ngo Mahoro.",
              "type": "text"
            }
          ]
        },
        {
          "text": " riti Kandi nzoha Ubgisirayeli amahoro n’umutēkāno ku ngoma yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.7.13"
              },
              "items": [
                {
                  "text": "2 Sam 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
