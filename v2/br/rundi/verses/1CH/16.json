        {
          "text": "Maze kur’ iyo sandugu y’isezerano ry’Uhoraho ahisiga Asafu na bagenzi be, kugira ngo baze bame bashitsa igikorwa cabo imbere yayo na ntaryo, nk’ukw igikorwa gikwiye gukorwa uko bukeye; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.37",
            "verseOrgIds": [
              "1CH.16.37"
            ]
          }
        },
