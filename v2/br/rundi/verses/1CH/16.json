        {
          "text": "kandi hamwe na bo ashiraho Hemani na Yedutuni n’abandi bātowe, bavuzwe amazina, kugira ngo bashimire Uhoraho yukw imbabazi ziwe zamah’ ibihe bidashira. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.41",
            "verseOrgIds": [
              "1CH.16.41"
            ]
          }
        },
