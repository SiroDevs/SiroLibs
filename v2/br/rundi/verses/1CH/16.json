            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Sadoki umuherezi, n’abaherezi bagenzi be, abashira kw ihema ry’Uhoraho riri ku mpinga y’umusozi Gibeyoni, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.39",
            "verseOrgIds": [
