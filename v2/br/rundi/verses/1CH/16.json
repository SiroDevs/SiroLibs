              "type": "text"
            }
          ]
        },
        {
          "text": "ahasiga na Obed‐edomu na bagenzi be mirongwitandatu n’ umunani; ahasiga na Obed‐edomu mwene Yedutuni na Hosa ngo bayishibamire. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.38",
            "verseOrgIds": [
