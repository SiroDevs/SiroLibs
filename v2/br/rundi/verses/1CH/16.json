          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi Dawidi ni ho yatanguriye gushinga ko Asafu na bagenzi be ari bo baririmba batazira Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.7",
            "verseOrgIds": [
