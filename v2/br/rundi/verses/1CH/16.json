          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Hemani na Yedutuni abo bāri n’ inzumbete n’ivyitwa matowazi vyo kuvuza, n’ibindi vyo kuvuza bijana n’indirimbo z’Imana. Kand’ ashiraho bene Yedutuni ngo barinde irembo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.16.42",
            "verseOrgIds": [
              "1CH.16.42"
            ]
          }
        }
