              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.7"
              },
              "items": [
                {
                  "text": "Yos 17:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.17.11"
              },
              "items": [
                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ugashitsa no ku rubibe rw’Abamanase, i Beti‐sheyani n’i Tanaki n’i Megido n’i Dori, bo n’ibisagara bigenda bihakūkira. Mur’ ivyo bisagara uruvyaro rwa Yosefu mwene Isirayeli ni ho rwāba.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.29",
            "verseOrgIds": [
              "1CH.7.29"
            ]
          }
        }
