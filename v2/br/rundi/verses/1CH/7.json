              "type": "text"
            }
          ]
        },
        {
          "text": "uwa Elishama ni Nuni, uwa Nuni ni Yosuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.27",
            "verseOrgIds": [
              "1CH.7.27"
            ]
          }
        },
        {
