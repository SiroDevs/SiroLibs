        },
        {
          "text": "Bene Isakari ni Tola na Puwa na Yashubu na Shimuroni ukw ari bane. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.1",
            "verseOrgIds": [
              "1CH.7.1"
            ]
          }
        },
