          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amashamvu yabo aho bāba n’i Beteli n’ibisagara bihakūkira; ah’ i burasirazuba n’i Narani, ah’ i burengerazuba bāhēra i Gezeri n’i Shekemu, ukarinda ushitsa i Aza, bo n’ibisagara bigenda bihakūkira; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.28",
            "verseOrgIds": [
              "1CH.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
