            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Sauli yatanze, azize ibicumuro vyiwe yacumuye k’ Uhoraho, kukw atitondeye ijambo ryiwe, kandi kuko yaraguje umuntu azi guhamagara imizimu, ngw amusigurize, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
