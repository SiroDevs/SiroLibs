            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.13"
              },
              "items": [
                {
                  "text": "1 Ngo 23:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngaba abakuru bo mu Balewi bandi: mu ba Amuramu ni Shubayeli, mu ba Shubayeli ni Yehodeya; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.20",
            "verseOrgIds": [
              "1CH.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.17"
              },
              "items": [
                {
                  "text": "1 Ngo 23:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku vya Rehebiya, mu bana biwe Ishiya ni we yar’ umukuru; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.21",
            "verseOrgIds": [
              "1CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.18"
              },
              "items": [
                {
                  "text": "1 Ngo 23:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Isuhari ni Shelomoti; mu ba Shelomoti ni Yahati; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.22",
            "verseOrgIds": [
              "1CH.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.23.19"
              },
              "items": [
                {
                  "text": "1 Ngo 23:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu ba Heburoni, uwa mbere ni Yeriya, uwa kabiri ni Amariya, uwa gatatu ni Yahaziyeli, uwa kane ni Yekameyamu; ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
            "verseOrgIds": [
              "1CH.24.23"
            ]
          }
        },
