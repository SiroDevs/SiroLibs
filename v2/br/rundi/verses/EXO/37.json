              "EXO.37.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.31+EXO.25.32+EXO.25.33+EXO.25.34+EXO.25.35+EXO.25.36+EXO.25.37+EXO.25.38+EXO.25.39"
              },
              "items": [
                {
                  "text": "Kuv 25:31-39",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ico guterekakw amatara mw izahabu iramuye; ico gitereko cose, hamwe n’intebe yaco n’umutumba waco, cār’ igicurano; ibikombe vyaco, bigizwe bga mapfundo apfundikiyekw amashurwe, vyari bicuriwe kuri co, vyari kimwe na co. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.17",
            "verseOrgIds": [
              "EXO.37.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cari gifise amashami atandatu mu mbavu zaco: mu ruhande rumwe rw’ico gitereko hār’ amashami atatu, mu rundi ruhande rwaco hāri yandi atatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.18",
            "verseOrgIds": [
              "EXO.37.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 37:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishami rimwe ryari rifise ibikombe bitatu bisa n’amashurwe y’igiti citwa shakedi, igikombe cose cari kigizwe bga pfundo ripfundikiyekw ishurwe; n’irindi shami n’uko: amashami yose ukw ar’ atandatu ashamitse kur’ ico gitereko ni ko yar’ ameze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.19",
            "verseOrgIds": [
              "EXO.37.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 37:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umutumba w’ico gitereko warikw ibikombe bine, bisa n’ayo mashurwe ya shakedi nyene; vyari bigizwe bga mapfundo apfundikiyekw amashurwe; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.20",
            "verseOrgIds": [
              "EXO.37.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 37:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "aho amashami ashamikiye kur’ ico gitereko hose ukw ar’atandatu, hār’ ipfundo ahahera musi aho amashami ahūrira, bicuriwe kuri co, vyari kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.21",
            "verseOrgIds": [
              "EXO.37.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 37:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amapfundo yaco n’amashami yaco vyari bicuriwe kuri co, vyari kimwe na co: cose hamwe cār’ igicurano gicuzwe mw izahabu iramuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.22",
            "verseOrgIds": [
              "EXO.37.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 37:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Araheza agicurira amatara ndwi, n’imakasi zaco zo gutunganya urutambi, n’ udusahani two gushirwak’ umunyota warwo, abicuze mw izahabu iramuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gitereko, bo n’ibintu vyaco vyose, yabikoze mw izahabu iramuye, inganya kuriba n’italanto imwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "37:24",
              "type": "text"
            },
            {
              "text": "Italanto ni nk’ibilo 55.",
              "type": "text"
            }
          ]
        }
      ]
    },
