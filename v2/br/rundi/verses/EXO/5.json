              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi nyene Farawo abarira abakoresha abo bantu, n’abarōngōzi babo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.6",
            "verseOrgIds": [
              "EXO.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ati Ntimwongere guha abantu ibiganogano vyo kubumbana n’amatafari nka mbere: ni bagende bavyironderere ubgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.7",
            "verseOrgIds": [
              "EXO.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ igitigiri c’amatafari basanzwe babumba, bakigumeko; ntimubagabanye na makeya: kukw ar’ abanebge, ni co kibatakisha ngo ni bagende, bashikanire Imana yabo ibimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.8",
            "verseOrgIds": [
              "EXO.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bantu ni babazigire ku bikorwa bikomeye, abe ari vyo bitwaririka, boye gushira imitima ku magambo y’ibinyoma.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.9",
            "verseOrgIds": [
              "EXO.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.9",
            "verseOrgIds": [
              "EXO.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakoresha ubgo bgoko barasohoka, bo n’abarōngōzi babo, babarira abantu, bati Farawo agize ngo ntakibaha ibiganogano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.10",
            "verseOrgIds": [
              "EXO.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mugende ubganyu, mwironderere ibiganogano aho mwobibona hose; kandi ntimuzogabanywa igitigiri mwaciriwe na gatoya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.11",
            "verseOrgIds": [
              "EXO.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abantu bakwiragira mu gihugu cose ca Egiputa kwironderera udushingweshingwe mu mwanya w’ibiganogano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.12",
            "verseOrgIds": [
              "EXO.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ababakoresha barabasunika, bati Mushitse ibikorwa vyanyu, ivyo mwagerewe vy’imisi yose, nk’uko mwari musanzwe mukora mukibona ibiganogano. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.13",
            "verseOrgIds": [
              "EXO.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarōngōzi b’Abisirayeli, bāshizweho kurōngōra n’abakoresha ba Farawo, barakubitwa, barababaza, bati N’iki catumye mudashitsa ivyo mwagerewe ejo n’ uyu musi, ngo mukwize amatafari nk’uko mwahora?",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.14",
            "verseOrgIds": [
              "EXO.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abo barōngōzi b’Abisirayeli baragenda batakambira Farawo, bati Mbeg’ uduhoye iki, twebge abasavyi bawe? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.15",
            "verseOrgIds": [
              "EXO.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta biganogano duhabga, maze bakatubgira ngo ni tubumbe amatafari: kandi none rāba, twebge abasavyi bawe turakubitwa; ariko ni mwebge mugiriye nabi abantu bawe! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.16",
            "verseOrgIds": [
              "EXO.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Mur’ abanebge, mur’ abanebge! Ni co kibatera kuvuga ngo mugende gushikanira Uhoraho ibimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.17",
            "verseOrgIds": [
              "EXO.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ni mugende mukore: ariko nta biganogano muzohabga: yamara ntimuzobura gushitsa igitigiri c’amatafari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.18",
            "verseOrgIds": [
              "EXO.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.18",
            "verseOrgIds": [
              "EXO.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo barōngōzi b’Abisirayeli bamenya ko babonye ibara, kuko babariwe kutazohaza itafari na rimwe ku yo baciriwe ku musi n’ umusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.19",
            "verseOrgIds": [
              "EXO.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakiva kwa Farawo, basanga Mose na Aroni babategereje mu nzira; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.20",
            "verseOrgIds": [
              "EXO.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.6.9"
              },
              "items": [
                {
                  "text": "Kuv 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "barababarira, bat’ Uhoraho n’arābe ico mudukoreye, abahane, kuko mutumye Farawo n’abantu biwe batwanka urunuka, mukabaha inkota yo kutwica.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.5.21",
            "verseOrgIds": [
              "EXO.5.21"
            ]
          }
        }
      ]
