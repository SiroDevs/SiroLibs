        {
          "text": "Farawo ni kwo guhamagaza Mose na Aroni vuba; arababarira, ati Nacumuye k’Uhoraho Imana yanyu no kuri mwebge. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.16",
            "verseOrgIds": [
              "EXO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.8.8"
              },
              "items": [
                {
                  "text": "Kuv 8:8",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.6"
              },
              "items": [
                {
                  "text": "1 Abam 13:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ndakwinginze, icaha canje ukimparire iri rimwe gusa, munyingingire Uhoraho Imana yanyu, ankūrek’ uru rupfu iri rimwe gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.17",
            "verseOrgIds": [
              "EXO.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.8.30"
              },
              "items": [
                {
                  "text": "Kuv 8:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose arasohoka, ava imbere ya Farawo, atakambira Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.18",
            "verseOrgIds": [
              "EXO.10.18"
            ]
          }
        },
        {
