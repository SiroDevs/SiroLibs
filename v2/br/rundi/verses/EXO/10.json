                {
                  "text": "Yow 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kugira ngo nawe uz’ udondere umwana wawe n’umwuzukuru wawe ukuntu namāramāje Abanyegiputa, n’ibimenyetso vyanje nakoreye hagati muri bo; mumenye yuko nd’ Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.21.29"
              },
              "items": [
                {
                  "text": "1 Abam 21:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.7.14"
              },
              "items": [
                {
                  "text": "2 Ngo 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.34.27"
              },
              "items": [
                {
                  "text": "34:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni baja kwa Farawo, baramubgira, bat’ Uku ni k’ Uhoraho, Imana y’Abaheburayo, agize, ng’ Uzogeza ryari kwanka kwicisha bugufi imbere yiwe? Ngo Reka abantu biwe, bagende bamusabe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.3",
            "verseOrgIds": [
              "EXO.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.30.27"
              },
              "items": [
                {
                  "text": "Imig 30:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.9.3"
              },
              "items": [
                {
                  "text": "Ivyah 9:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo Na ho ni wanka kubarekura, ejo ngw azorekura inzige, zihēre ku rubibe rwawe, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.4",
            "verseOrgIds": [
              "EXO.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.9.32"
              },
              "items": [
                {
                  "text": "Kuv 9:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "zizimanganye igihugu, umuntu ntashobore kubona hasi: zizorya ivyasigaye vyakize, ivyo rwa rubura rwabasigarije, zirye n’igiti canyu cose cameze ku gahinga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.5",
            "verseOrgIds": [
              "EXO.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.9"
              },
              "items": [
                {
                  "text": "Yow 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zizokwuzura ingoro zawe, n’inzu z’abanyarugo bawe bose, n’iz’ Abanyegiputa bose: izo ba so na ba sogokuru batigeze kubona, uhereye igihe babereyeho, ukageza n’ubu. Nuko Mose arahindukira, ava imbere ya Farawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.6",
            "verseOrgIds": [
              "EXO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu ba Farawo baramubaza, bati Mbeg’ uriya azogeza ryari kutubera icago? Reka abo bantu bagende, baje gusaba Uhoraho Imana yabo: aho nturabona ko Egiputa hapfuye? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.7",
            "verseOrgIds": [
              "EXO.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagarura Mose na Aroni kuri Farawo; arababgira, ati Ni mugende, muje gusaba Uhoraho Imana yanyu: arikw abazogenda n’abaki n’abaki? ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.8",
            "verseOrgIds": [
              "EXO.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.5.1"
              },
              "items": [
                {
                  "text": "Kuv 5:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramwishura, ati Tuzojana n’abana n’abatāma, n’abahungu bacu n’ abakobga, mbere n’imikuku yacu n’amasho tuzobijana: kuko dukwiye kugirira Uhoraho umusi mukuru. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura, ati Yemwe ga ye, Uhoraho abane namwe nkabarekura, ngo mujane n’abana banyu! Ni mwiyubare, kukw ivyo mugabiye ari bibi! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ntibishoboka; mwebge abagabo ni mugende, muje gusaba Uhoraho, kukw ar’ ico murondera! Babirukana imbere ya Farawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        }
      ]
    },
    {
