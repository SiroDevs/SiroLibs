          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.20"
              },
              "items": [
                {
                  "text": "Yow 2:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho ahindura umuyaga uva i burengerazuba, w’igihuhuta gikomeye cane, utwara za nzige, uzisuka mu Kiyaga Gitukura: ntihasigara na rumwe mu gihugu cose ca Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 10:20"
