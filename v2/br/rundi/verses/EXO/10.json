                "loc": "EXO.10.5"
              },
              "items": [
                {
                  "text": "10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho abarira Mose, ati Ramvura ukuboko kwawe hejuru y’igihugu ca Egiputa, haze inzige, zize mu gihugu ca Egiputa, zirye icameze cose mu gihugu, mber’ ivyo rwa rubura rwasize vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.12",
            "verseOrgIds": [
              "EXO.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose atunga ya nkoni yiwe hejuru y’igihugu ca Egiputa, Uhoraho azana umuyaga mur’ ico gihugu uvuye i burasirazuba, wiriza umusi ukesha ijoro; bukeye, uwo muyaga uvuye i burasirazuba uzana inzige. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.78.46"
              },
              "items": [
                {
                  "text": "Zab 78:46",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.34"
              },
              "items": [
                {
                  "text": "105:34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.2.2"
              },
              "items": [
                {
                  "text": "Yow 2:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zirasenyuka ziza mu gihugu ca Egiputa hose, zigwa mu gihugu iyo kiva kikagera; zar’ icago gikomeye cane: uhereye kera hose ntihigeze kubah’ inzige nk’izo, kandi ntihazokwongera kuboneka izingana na zo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.14",
            "verseOrgIds": [
              "EXO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.105.35"
              },
              "items": [
                {
                  "text": "Zab 105:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zizimanganya igihugu cose, bituma igihugu gicura umwiza; zirya icameze cose mu gihugu, n’ivyamye ku biti vyose, ivyo rwa rubura rwashigaje: mu gihugu cose ca Egiputa ntihasigara ikintu na kimwe gitotahaye, naho coba igiti cank’ ikindi cose cameze ku gahinga.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.15",
            "verseOrgIds": [
              "EXO.10.15"
            ]
          }
        }
      ]
    },
