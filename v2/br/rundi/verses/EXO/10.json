            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ati Ja kwa Farawo; kuko nkomantaje umutima wiwe, n’iy’ abantu biwe, kugira ngo nerekanire ibi bimenyetso vyanje hagati muri bo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.1",
            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
