              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.4.21"
              },
              "items": [
                {
                  "text": "Kuv 4:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamar’ Uhoraho akomantaza umutima wa Farawo, ntiyarekura Abisirayeli ngo bagende.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.20",
            "verseOrgIds": [
              "EXO.10.20"
            ]
          }
        }
