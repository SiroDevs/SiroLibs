            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.9"
              },
              "items": [
                {
                  "text": "Luk 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
