                "loc": "MAT.17.24"
              },
              "items": [
                {
                  "text": "Mat 17:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi abe ari yo ncungu batanga, umuntu wese ukw arēngāna ashirwa mu gitigiri c’abaharūwe, atange ikigabane ca shekeli yagezwe kuri shekeli ir’ Ahēra: shekeli imwe irimwo gera mirongwibiri; ikigabane ca shekeli kize kibe ari co banshikanira. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.13",
            "verseOrgIds": [
              "EXO.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese arēngāna agashirwa mu gitigiri c’abaharūwe, amaze imyaka mirongwibiri cank’ isāga, az’ anshikanire iryo shikanwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.14",
            "verseOrgIds": [
              "EXO.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatunzi ntibarenze aho, n’aboro ntibagabanye, kur’ ico kigabane ca shekeli, ni banshikanira iryo shikanwa ryo kuba impongano y’ ubugingo bgabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.15",
            "verseOrgIds": [
              "EXO.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.25+EXO.38.26+EXO.38.27+EXO.38.28"
              },
              "items": [
                {
                  "text": "Kuv 38:25-28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uze wake Abisirayeli ayo mahera y’ impongano, uyakoreshe ibikorwa vy’ihema ry’ibonaniro, abere Abisirayeli icibutso kizotuma mpora mbibuka, abe impongano y’ubugingo bgabo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.16",
            "verseOrgIds": [
              "EXO.30.16"
            ]
          }
        }
      ]
