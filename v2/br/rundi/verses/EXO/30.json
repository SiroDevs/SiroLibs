        },
        {
          "text": "Iyo bagiye kwinjira mw ihema ry’ibonaniro, baze bakarabe, boge, kugira ngo ntibapfe, n’iyo bagiye kwegera igicaniro guhereza, ngo banyosereze ibimazi bitōngōrwa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.20",
            "verseOrgIds": [
              "EXO.30.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 30:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.21"
              },
              "items": [
                {
                  "text": "Kuv 27:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko baze bakarabe, boge ibirenge, kugira ngo ntibapfe: bize bibere Aroni n’uruvyaro rwiwe icagezwe c’intahava ukw ibihe vy’ urunganwe rwabo bizogenda bikurikirana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.21",
            "verseOrgIds": [
              "EXO.30.21"
            ]
          }
        }
      ]
    },
    {
