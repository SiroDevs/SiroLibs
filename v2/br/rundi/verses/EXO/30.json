              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abarira Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.11",
            "verseOrgIds": [
              "EXO.30.11"
            ]
          }
        },
