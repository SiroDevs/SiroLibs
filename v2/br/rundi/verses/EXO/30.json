          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "at’ Uz’ ucure ikigārigāri mu miringa co gukaraba, kigire n’intebe y’ umuringa nyene; uz’ ugishire hagati y’ihema ry’ibonaniro n’ igicaniro, ugisukemw’ amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.18",
            "verseOrgIds": [
              "EXO.30.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 30:19"
          },
          "items": [
