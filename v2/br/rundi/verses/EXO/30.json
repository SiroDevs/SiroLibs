                "loc": "PSA.26.6"
              },
              "items": [
                {
                  "text": "Zab 26:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni n’abana biwe az’ abe ari ho bahora bakaraba, boge ibirenge. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.30.19",
            "verseOrgIds": [
              "EXO.30.19"
            ]
          }
        },
