              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abe ari wewe ubigisha amabgirizwa n’ivyagezwe, no kubereka inzira bakwiye gucamwo, n’ibikorwa bakwiye gukora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.20",
            "verseOrgIds": [
              "EXO.18.20"
            ]
