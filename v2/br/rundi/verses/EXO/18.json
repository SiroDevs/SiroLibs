            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DAN.2.47"
              },
              "items": [
                {
                  "text": "Dan 2:47",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.51"
              },
              "items": [
                {
                  "text": "Luk 1:51",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noneho mmenye yuk’ Uhoraho aruta izindi mana zose, ko yatsinze Abanyegiputa bāhora babihayagizako. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.11",
            "verseOrgIds": [
              "EXO.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.7"
              },
              "items": [
                {
                  "text": "Gus 12:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.26"
              },
              "items": [
                {
                  "text": "14:26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.22"
              },
              "items": [
                {
                  "text": "1 Ngo 29:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yetiro, sebukwe wa Mose, ajana ikimazi co kwosa n’ibindi bimazi vyo gushikanira Imana: Aroni n’abakuru bose b’Abisirayeli baraza, ngo basangirire na sebukwe wa Mose imbere y’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.12",
            "verseOrgIds": [
              "EXO.18.12"
            ]
          }
        }
      ]
    },
    {
