              },
              "items": [
                {
                  "text": "3:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yetiro umuherezi w’i Midiyani, sebukwe wa Mose, yumva ivyo Imana yakoreye Mose n’Abisirayeli abantu bayo, kandi n’ingen’ Uhoraho yakūye Abisirayeli muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.1",
            "verseOrgIds": [
              "EXO.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.21"
              },
              "items": [
                {
                  "text": "Kuv 2:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yetiro sebukwe wa Mose azana Zipora muka Mose, uwo Mose yari yarashubije i wabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.2",
            "verseOrgIds": [
              "EXO.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.2.22"
              },
              "items": [
                {
                  "text": "Kuv 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.29"
              },
              "items": [
                {
                  "text": "Ivyak 7:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’abahungu biwe bompi; umwe muri bo se yari yamwise Gerushomu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:3",
              "type": "text"
            },
            {
              "text": "Gerushomu risobanurwa, ngw Inyambukīra y’aho hantu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuko yavuga, ati Nabaye inyambukīra mu gihugu kitar’ icacu; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.3",
            "verseOrgIds": [
              "EXO.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwundi yamwise Eliyezeri,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "18:4",
              "type": "text"
            },
            {
              "text": "Eliyezeri risobanurwa ngw Imana yanje n’umutabazi.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuko yavuga, at’ Imana ya data yabaye umutabazi wanje, inkiza inkota ya Farawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.4",
            "verseOrgIds": [
              "EXO.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yetiro sebukwe wa Mose aza aho Mose ari, amuzaniye abana n’umugore, amusanga muri bga bugaragwa, aho yar’ ashinze ihema, ku musozi w’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.5",
            "verseOrgIds": [
              "EXO.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atuma ngo baje kubibarira Mose yuko sebukwe Yetiro aje, amuzaniye umugore wiwe n’abana biwe bompi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.6",
            "verseOrgIds": [
              "EXO.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
