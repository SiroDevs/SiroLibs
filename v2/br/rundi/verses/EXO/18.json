                  "text": "12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibizobura kuguca intege, mwe n’aba bantu muri kumwe; kukw ivyo bikurengeye, n’ivyo utoshobora gukora wenyene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.18.18",
            "verseOrgIds": [
              "EXO.18.18"
            ]
          }
        },
