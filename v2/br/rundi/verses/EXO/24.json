            }
          ]
        },
        {
          "text": "babona Imana y’ Abisirayeli; musi y’ibirenge vyayo hameze nk’umusezero w’amabuye yitwa safiro, usa n’ijuru ubgaryo iyo ryiharanguye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.10",
            "verseOrgIds": [
              "EXO.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ba bakuru b’Abisirayeli ntihagira ico ibagira; nuko bīrābira Imana, bararya, baranywa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.24.11",
            "verseOrgIds": [
              "EXO.24.11"
            ]
          }
