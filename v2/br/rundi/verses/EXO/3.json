            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ndazi yuk’ umwami wo muri Egiputa atazobakundira ko mugenda, shit’ ukuboko kw’inkomezi kumugondoje. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.19",
