                {
                  "text": "Gus 33:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho abonye yukw akīkamishwa no kubirāba, Imana imuhamagara iri hagati mur’ ico gisaka, iti Mose, Mose! Aritaba, ati Sabge! ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.4",
            "verseOrgIds": [
              "EXO.3.4"
            ]
          }
        },
        {
