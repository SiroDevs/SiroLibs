            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndavuga, nti Nzobakūra mu marushwa barimwo muri Egiputa, mbadūgane mu gihugu c’ Abanyakanani, n’Abaheti, n’Abamori, n’Abaferizi, n’Abahiwi, n’ Abayebusi, igihugu gitemba amata n’ubūki. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.17",
            "verseOrgIds": [
