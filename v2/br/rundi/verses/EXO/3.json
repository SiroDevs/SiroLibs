            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umumarayika w’Uhoraho amubonekerera mu rubeya rw’umuriro uva hagati mu gisaka c’amahwa: aritegereza, abona ico gisaka cakamw’ umuriro, ariko nticatemuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.2",
            "verseOrgIds": [
              "EXO.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose arīvuganya, ati Hinge nkīkame ndābe karya katābonetse, mmenye igituma igisaka kidatemutse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.3.3",
            "verseOrgIds": [
              "EXO.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 3:4"
          },
          "items": [
