          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "bajisha n’ igitambara co kuzingīra mu mutwe mu nyuzi zera derere nziza, n’udukofero dushajije na two nyene mu nyuzi zera derere nziza, bo n’amabutura mu nyuzi zera derere nziza zihinzwe neza, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
              "EXO.39.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 39:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ umukanda mu nyuzi zera derere nziza zihinzwe neza, no mu z’ amasufe n’iz’ amashigisha n’izisa n’agahama, wajererenzwekw amabara n’abahinga bavyo, nk’uk’ Uhoraho yabariye Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.29",
            "verseOrgIds": [
              "EXO.39.29"
            ]
          }
        }
      ]
