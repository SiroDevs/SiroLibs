              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bajishira Aroni n’ abana biwe amakanzo mu nyuzi zera derere nziza, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
            "verseOrgIds": [
              "EXO.39.27"
            ]
          }
        },
        {
