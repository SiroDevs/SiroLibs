              "type": "text"
            }
          ]
        },
        {
          "text": "Za nyuzi z’amasufe n’iz’ amashigisha n’izisa n’agahama bazijishamw’ imyambaro ijishitse neza yo kwambara mu gukora Ahēra, ni yo myambaro yejejwe yo kwambara Aroni, nk’uk’ Uhoraho yabariye Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.1",
            "verseOrgIds": [
              "EXO.39.1"
            ]
          }
        }
      ]
    },
