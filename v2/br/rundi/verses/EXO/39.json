            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bacura akabāte, ni co gitsibo cera, mw izahabu iramuye, bakandikakw amajambo mu buryo bgo guca amagarwe ku kabuyenge ko kudoma ikimenyetso, ngo YEREJWE UHORAHO. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.30",
            "verseOrgIds": [
              "EXO.39.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 39:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagapfundikakw akagozi ko mu nyuzi z’amasufe, ko kugafatisha hejuru kuri ca gitambara co kuzingīra mu mutwe, nk’uk’ Uhoraho yabariye Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.31",
            "verseOrgIds": [
              "EXO.39.31"
            ]
          }
        }
      ]
    },
