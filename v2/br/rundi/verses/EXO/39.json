            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko barangije gukora ivy’ iryo hema vyose, ari ryo hema ry’ibonaniro; Abisirayeli bākoze vyose, nk’uk’ Uhoraho yabariye Mose: uko ni ko bābikoze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        }
