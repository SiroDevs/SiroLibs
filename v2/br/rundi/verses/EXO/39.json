              "items": [
                {
                  "text": "Kuv 28:6-12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besaleli ajishisha umwambaro witwa efodi intahe z’izahabu, n’ inyuzi z’amasufe, n’iz’ amashigisha, n’izisa n’agahama, n’izera derere nziza zihinzwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.2",
            "verseOrgIds": [
              "EXO.39.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacura amazahabu kugeza abaye uduhuhwa, badukebaguramw’intahe zo kujererenga mur’ izo nyuzi z’amasufe n’iz’amashigisha n’izisa n’agahama n’izera derere nziza, abahinga bavyo baba ari bo babikora. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.3",
            "verseOrgIds": [
              "EXO.39.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakora ibizāna vy’uwo mwambaro, babitēra kuri wo; babitēra ku nzāno zawo zompi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.4",
            "verseOrgIds": [
              "EXO.39.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusipi ujishwe n’abahinga, ujishiwe kuri wo, wo kuwukenyeza, uba kimwe na wo, wajishwe nka wo; bawujishishije intahe z’izahabu n’inyuzi z’amasufe n’iz’ amashigisha n’izisa n’agahama n’ izera derere nziza zihinzwe neza, nk’uk’ Uhoraho yabariye Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.5",
            "verseOrgIds": [
              "EXO.39.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batunganya utubuyenge twitwa shohamu, baturumya mu tugenegene tw’izahabu, batwandikakw amazina y’abana ba Isirayeli mu buryo bgo guca amagarwe, nk’ abaca amagarwe ku kabuyenge ko kudoma ikimenyetso. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.6",
            "verseOrgIds": [
              "EXO.39.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Besaleli adutēra ahahera ku bitugu ku bizāna vya efodi, kugira ngo tubere Abisirayeli utubuyenge two kwibukwako, nk’uk’ Uhoraho yabariye Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.7",
            "verseOrgIds": [
              "EXO.39.7"
            ]
          }
        }
      ]
    },
    {
