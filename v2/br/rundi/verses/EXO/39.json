          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "asatura urwano muri wo hagati, nk’urw’ ikanzo y’icuma,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.23",
            "verseOrgIds": [
              "EXO.39.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:23",
              "type": "text"
            },
            {
              "text": "Ikanzo y’icuma",
              "type": "text"
            },
            {
              "text": ": rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.28.32"
              },
              "items": [
                {
                  "text": "Kuv 28:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " arutērakw akandi kajishano kameze nk’ umusōzo karukīkūje, kugira ngo ntiruze rucike. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.23",
            "verseOrgIds": [
              "EXO.39.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 39:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mubuga w’uwo mwambaro bawutērak’ udusa n’amakomamanga dukozwe mu nyuzi z’amasufe n’iz’ amashigisha n’izisa n’agahama, n’izera derere zihinzwe neza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.24",
            "verseOrgIds": [
              "EXO.39.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 39:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacura imidende mw izahabu iramuye, bayitēra hagati y’ayo makomamanga ku mubuga w’uwo mwambaro impande zose, babirobekeranije, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.25",
            "verseOrgIds": [
              "EXO.39.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 39:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyo midende bayirobekeranya n’ayo makomamanga, bikīkūza umubuga w’uwo mwinjiro impande zose, uba uwo kwambarwa mu guhereza, nk’uk’ Uhoraho yabariye Mose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.26",
            "verseOrgIds": [
              "EXO.39.26"
            ]
          }
        }
      ]
