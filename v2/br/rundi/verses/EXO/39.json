            "style": "v",
            "sid": "EXO 39:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.32",
            "verseOrgIds": [
              "EXO.39.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 39:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazanira Mose iryo hema ry’imbere, n’ihema ryo hejuru, n’ibintu vyaryo vyose, n’uturinda twaryo, n’imbaho zaryo, n’ ibiti vy’intumba vyaryo, n’inkingi zaryo, n’ibitereko vyo kuzirokezamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.33",
            "verseOrgIds": [
              "EXO.39.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 39:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ico kurenza hejuru yaryo cakozwe mu nsāto z’amapfizi y’intama zazizwe mu gahama, n’ikindi co kurenza hejuru yaco cakozwe mu nsāto z’ ibikōko vyitwa tahashi,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "39:34",
              "type": "text"
            },
            {
              "text": "Tahashi",
              "type": "text"
            },
            {
              "text": ": rāba",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.25.5"
              },
              "items": [
                {
                  "text": "Kuv 25:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": " n’igihuzu co gukingīra Ahēra cane; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.34",
            "verseOrgIds": [
              "EXO.39.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 39:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ isandugu y’Ibishinga intahe, n’ iminiho yayo, n’umutemere wo guhongerako; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.35",
            "verseOrgIds": [
              "EXO.39.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "EXO 39:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ameza, n’ ibintu vyayo vyose, n’imitsima y’ibiterekerwa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.36",
            "verseOrgIds": [
              "EXO.39.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "EXO 39:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’igiterekwakw amatara c’izahabu iramuye, n’ amatara yaco nyene, ari yo matara yo gushirwa kuri co, n’ibintu vyaco vyose, n’amavuta y’ayo matara; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.37",
            "verseOrgIds": [
              "EXO.39.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "EXO 39:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’igicaniro cacuzwe mw izahabu, n’amavuta yo kurobanuza abahabga ibango n’imibavu itāmirana, n’igihuzu co gukinga ku muryango w’ihema; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.38",
            "verseOrgIds": [
              "EXO.39.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "EXO 39:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’igicaniro cacuzwe mu miringa, n’ikintu caco c’insobane cacuzwe mu miringa nyene, n’iminiho yaco, n’ibintu vyaco vyose; n’ ikigārigāri, n’intebe yaco; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.39",
            "verseOrgIds": [
              "EXO.39.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 39:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ impuzu zo kubamba ngo zibe urugo, n’ibirimbi vyarwo, n’ibitereko vyo kubinegamwo, n’impuzu yo gukinga mw irembo ry’ urwo rugo, n’imigozi yarwo, n’ imambo zarwo, n’ibintu vyose vyo gukoresha mur’ iryo hema, ari ryo hema ry’ibonaniro; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.40",
            "verseOrgIds": [
              "EXO.39.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 39:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ imyambaro ijishitse neza yo kwambara mu gukora Ahēra, ni yo myambaro yejejwe yo kwambara Aroni umuherezi, n’imyambaro y’ abana biwe, yo kwambara mu gukora igikorwa c’ubuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.41",
            "verseOrgIds": [
              "EXO.39.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "EXO 39:42"
          },
          "items": [
