              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umwinjiro wo kwambarirwako efodi Besaleli awujisha mu nyuzi z’amasufe gusa; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.22",
            "verseOrgIds": [
