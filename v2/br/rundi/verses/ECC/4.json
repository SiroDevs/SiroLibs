                "loc": "ECC.9.15"
              },
              "items": [
                {
                  "text": "Umus 9:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.9.16"
              },
              "items": [
                {
                  "text": "16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.12.12"
              },
              "items": [
                {
                  "text": "12:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhungu mworo w’umunyabgenge aruta umwami ashāje akaba igipfu, atacemera guhanūrwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.13",
            "verseOrgIds": [
              "ECC.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.14"
              },
              "items": [
                {
                  "text": "Ita 41:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.41.41+GEN.41.42+GEN.41.43"
              },
              "items": [
                {
                  "text": "41-43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yavuye mw ibohero ngw abe umwami; mbere yavutse mu bgami bgiwe ari mworo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.14",
            "verseOrgIds": [
              "ECC.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitegereje abariho bose bagendagenda musi y’izuba, mbona bikumiye ku ruhande rwa wa musore umwe yakurikiye umwami ku ngoma, akamusubirira mu gishingo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.15",
            "verseOrgIds": [
              "ECC.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bantu bose yaganza, ubginshi bgabo ntibgagira uko bungana: yamar’ abazobaho hanyuma ntibazomunezererwa. N’ ukuri ivyo na vyo n’ubusa, no guhahamira umuyaga.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.16",
            "verseOrgIds": [
              "ECC.4.16"
            ]
          }
        }
      ]
    }
