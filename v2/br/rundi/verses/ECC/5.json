              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inkunzi y’amahera ntizohāzwa n’amahera; bo n’ūkunda ibitayega ntazohāzwa n’inyungu: ivyo na vyo nyene n’ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.10",
            "verseOrgIds": [
              "ECC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iy’ ibintu bigwiriye ababirya baragwira: kandi nyenevyo bimumarira iki, atar’ ugupfa kubirābisha amaso? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.11",
            "verseOrgIds": [
              "ECC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agatiro k’umunyabikorwa kararyoha, n’iy’ ariye bike canke vyinshi: ariko gufunereza kw’umutunzi kumubuza gusinzira.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 5:12"
          },
          "items": [
            {
