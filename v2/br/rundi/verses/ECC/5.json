                "loc": "PRO.15.8"
              },
              "items": [
                {
                  "text": "Imig 15:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urinde ikirenge cawe iy’ uja mu ngoro y’Imana; kuko kwēgēra ngo wumve kuruta gutanga ibimazi kw’ibipfu, kuko batazi ko bakora ibizira. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.1",
            "verseOrgIds": [
              "ECC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.6.7"
              },
              "items": [
                {
                  "text": "Mat 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanwa kawe ntikagire ico gatuntumukana, kand’ umutima wawe woye gushushudikanya kw ijambo na rimwe imbere y’Imana; kukw Imana iri mw ijuru, nawe ukaba kw isi: nuko rer’ amajambo yawe abe make. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.2",
            "verseOrgIds": [
              "ECC.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw inzozi ziterwa n’ibikorwa vyinshi, kand’ ijwi ry’igipfu rimenyekanira ku magambo menshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.3",
            "verseOrgIds": [
              "ECC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.30.2"
              },
              "items": [
                {
                  "text": "Guh 30:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.21"
              },
              "items": [
                {
                  "text": "Gus 23:21",
                  "type": "text"
