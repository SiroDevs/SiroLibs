            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.3.16"
              },
              "items": [
                {
                  "text": "Umus 3:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni wabona umworo ahahazwa, kand’ urubanza n’ibiroranye vyicwa ku manyama mu gihugu, ntibize bigutangaze: kukw Iyirusha abakuru ubukuru ivyitegereza, kandi har’ ubukuru bubarengeye. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.8",
            "verseOrgIds": [
              "ECC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikigirira ikimazi igihugu muri vyose, n’umwami kwubahwa mu gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.9",
            "verseOrgIds": [
              "ECC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 5:9"
          },
          "items": [
            {
