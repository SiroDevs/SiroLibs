              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.12",
            "verseOrgIds": [
              "ECC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Har’ ikibi gikomeye nabonye musi y’izuba, n’umuntu gutunga itunga rikazomwica: ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.13",
            "verseOrgIds": [
              "ECC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "maz’ iryo tunga rikazotikizwa n’ikibi kirikorokeye; kand’ asanzwe yaravyaye, umwana wiwe azoba asigaye ata co afise mu ntoke. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.14",
            "verseOrgIds": [
              "ECC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.1.21"
              },
              "items": [
                {
                  "text": "Yob 1:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.6.7"
              },
              "items": [
                {
                  "text": "1 Tim 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nk’uko yavuye mu nda ya nyina ari gusa, azogenda artyo nk’uko yaje, adatwaye ikintu na kimwe kivuye mu butame bgiwe yojana mu ntoke. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.15",
            "verseOrgIds": [
              "ECC.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.11.29"
              },
              "items": [
                {
                  "text": "Imig 11:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.3"
              },
              "items": [
                {
                  "text": "Umus 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ iki na co n’ikibi gikomeye, yuk’ uko yaje kwose ari kw azogenda: non’ afise inyungu ki mu buruhe yaruhiye umuyaga? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.16",
            "verseOrgIds": [
              "ECC.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisi yiwe yose arīra mu mwiza, kand’ akagira umubabaro, akagira indwara n’umwikomo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.5.17",
            "verseOrgIds": [
              "ECC.5.17"
            ]
          }
        }
      ]
    },
