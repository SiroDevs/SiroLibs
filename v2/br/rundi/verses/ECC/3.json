                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihe co gutabura n’igihe co kubarīra; igihe co gucereza n’ igihe co kuvuga; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.7",
            "verseOrgIds": [
              "ECC.3.7"
            ]
          }
