                  "text": "Umus 1:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ūkora aronka inyungu ki mu vyamutamije? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.9",
            "verseOrgIds": [
              "ECC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.1.13"
              },
              "items": [
                {
                  "text": "Umus 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nitegereje umuruho Imana yahaye abana b’ abantu ng’ ubaruhishe. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.10",
            "verseOrgIds": [
              "ECC.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
