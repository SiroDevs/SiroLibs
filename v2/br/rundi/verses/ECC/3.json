            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihe co kurira n’igihe co gutwenga; igihe co kuboroga n’igihe co kuvyina; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.4",
            "verseOrgIds": [
              "ECC.3.4"
            ]
          }
        },
