                {
                  "text": "Luk 14:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihe co gukundana n’igihe co kwankana; igihe c’intambara n’igihe c’impore. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.8",
