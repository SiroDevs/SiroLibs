          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.2.24"
              },
              "items": [
                {
                  "text": "Umus 2:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ ikindi, yuk’ ubuntu bg’Imana ar’ uk’ umuntu wese yorya, akanywa, akanezererwa ivyiza mu butame bgiwe bgose. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.13",
            "verseOrgIds": [
              "ECC.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 3:14"
          },
          "items": [
