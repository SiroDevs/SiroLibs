                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Navuze mu mutima, nt’ Imana izocira imanza umugororotsi n’umunyakibi: kuko kuri yo ari ho har’ igihe c’ikibaho cose n’igikorwa cose. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.17",
            "verseOrgIds": [
              "ECC.3.17"
            ]
          }
        },
