              "items": [
                {
                  "text": "Ita 1:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ECC.8.17"
              },
              "items": [
                {
                  "text": "Umus 8:17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ROM.11.33"
              },
              "items": [
                {
                  "text": "Rom 11:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikintu cose yakiremye ari ciza mu gihe caco: kandi yashize ivyiyumviro vy’ibihoraho mu mitima yabo, nah’ umuntu adashobora guserangura igikorwa Imana yakoze uhereye kw itanguriro ugashitsa kw iherezo. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.11",
            "verseOrgIds": [
              "ECC.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndazi yukw ata kintu kibagirira ikimazi kuruta kunezerwa no gukora ivyiza imisi yose bakiriho; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.12",
            "verseOrgIds": [
              "ECC.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
