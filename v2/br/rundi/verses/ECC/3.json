            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "igihe co gushibura amabuye n’igihe co kurunda amabuye; igihe co kugumbirana n’igihe co kwirinda kugumbirana; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.5",
            "verseOrgIds": [
              "ECC.3.5"
            ]
          }
        },
        {
