              "attrs": {
                "loc": "HEB.9.27"
              },
              "items": [
                {
                  "text": "Heb 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "har’ igihe co kuvuka n’igihe co gupfa; igihe co gutera n’igihe co kurandura ivyatewe; ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.3.2",
            "verseOrgIds": [
              "ECC.3.2"
            ]
          }
        },
        {
