            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ibimenyetso bizokwama biboneka ku bizera n’ibi: bazosenda abadayimoni mw izina ryanje; bazovuga indimi nsha; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.17",
