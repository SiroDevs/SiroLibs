            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira, ati Mugende muje mu bihugu vyose, mubgire abāremwe bose ubutumwa bgiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.15",
            "verseOrgIds": [
              "MRK.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
