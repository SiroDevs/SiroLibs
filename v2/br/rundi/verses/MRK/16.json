                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu amaze kuzuka mu mutwenzi ku wa mbere w’imisi ndwi, abanza kwiyereka Mariya Magadalene, uwo yasenzemw’ abadayimoni ndwi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.9",
            "verseOrgIds": [
              "MRK.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo aragenda, abibarira abābana na we, asanga bababaye barira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.10",
            "verseOrgIds": [
              "MRK.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bumvise kw ari muzima, kandi ko yamwiboneye, ntibāvyemera. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.11",
            "verseOrgIds": [
              "MRK.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.24.13+LUK.24.14+LUK.24.15+LUK.24.16+LUK.24.17+LUK.24.18+LUK.24.19+LUK.24.20+LUK.24.21+LUK.24.22+LUK.24.23+LUK.24.24+LUK.24.25+LUK.24.26+LUK.24.27+LUK.24.28+LUK.24.29+LUK.24.30+LUK.24.31+LUK.24.32+LUK.24.33+LUK.24.34+LUK.24.35"
              },
              "items": [
                {
                  "text": "Luk 24:13-35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo yiyereka babiri muri bo, afise iyindi shusho, bagenda baja mu misozi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.12",
            "verseOrgIds": [
              "MRK.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo nyene baragenda, babibgira abasigaye, maze ntibābemerera na bo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.13",
            "verseOrgIds": [
              "MRK.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.15.5"
              },
              "items": [
                {
                  "text": "1 Kor 15:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma yiyereka bamwe cumi n’umwe, bicaye bariko bararya, abagaya ukutizera kwabo no gukomantara kw’imitima yabo, kuko batemereye abāmubonye, amaze kuzuka.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.14",
            "verseOrgIds": [
              "MRK.16.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
