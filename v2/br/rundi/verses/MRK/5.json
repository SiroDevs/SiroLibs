                {
                  "text": "Mat 8:28-34",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.26+LUK.8.27+LUK.8.28+LUK.8.29+LUK.8.30+LUK.8.31+LUK.8.32+LUK.8.33+LUK.8.34+LUK.8.35+LUK.8.36+LUK.8.37+LUK.8.38+LUK.8.39+LUK.8.40"
              },
              "items": [
                {
                  "text": "Luk 8:26-40",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafata hakurya y’ikiyaga mu gihugu c’Abageraseni. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.1",
            "verseOrgIds": [
              "MRK.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Avuye mu bgato, umuntu yinjiwemwo n’impwemu ihumanye ava mu masenga y’imva, aca aramusanganira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.2",
            "verseOrgIds": [
              "MRK.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MRK 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yaba mur’ ayo masenga, ntihāgira ūba akibona ico ashobora kumubohesha, n’iyo woba umunyororo: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.3",
            "verseOrgIds": [
              "MRK.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko bāmubohesheje iminyororo ku maguru no ku maboko kenshi, iy’ amaboko akayicagagura, iy’ amaguru akayivutagura: ntihāgira umuntu afise inkomezi zomutururuza. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.4",
            "verseOrgIds": [
              "MRK.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MRK 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ imisi yose ku murango no mw ijoro yama mur’ ayo masenga no ku misozi, ataka, yikebesha amabuye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.5",
            "verseOrgIds": [
              "MRK.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MRK 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abonye Yesu akiri kure, arirukanga, arunama, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.6",
            "verseOrgIds": [
              "MRK.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MRK 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.24"
              },
              "items": [
                {
                  "text": "Mrk 1:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "asemerera n’ijwi rirenga, ati Duhūriye hehe ga Yesu Mwana w’Imana isumba vyose? Ndakurahiye Imana, ntumbabaze agashinyaguro. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.7",
            "verseOrgIds": [
              "MRK.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MRK 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko yar’ amubariye, ati Va mu muntu, wa mpwemu ihumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.8",
            "verseOrgIds": [
              "MRK.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MRK 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramubaza, ati Witwa nde? Aramwishura, ati Gitero ni ryo zina ryanje kuko turi benshi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.9",
            "verseOrgIds": [
              "MRK.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MRK 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwinginga cane ngo ntazirukane mur’ ico gihugu. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.10",
            "verseOrgIds": [
              "MRK.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo musozi hār’ umukuku mwinshi w’ingurube zirisha: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.11",
            "verseOrgIds": [
              "MRK.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ziramwinginga, ziti Turungike muri ziriya ngurube, tuzinjiremwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.12",
            "verseOrgIds": [
              "MRK.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MRK 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arazemerera. Izo mpwemu zihumanye zimusokorotsemwo, zinjira muri nya ngurube, umukuku wirukira ku gatembge, zisuka mu kiyaga, zāri nk’ibihumbi bibiri, amazi araziniga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.13",
            "verseOrgIds": [
              "MRK.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abāziragira barahunga, babivuga mu gisagara no mu misozi: na bo baza kurāba ibibaye ivy’ ari vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.14",
            "verseOrgIds": [
              "MRK.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashika aho Yesu ari, basanga uwari yinjiwemwo n’abadayimoni yicaye, yambaye, ubgenge bgāgarutse, umwe nyene yari yinjiwemwo na ca gitero; baratinya. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.15",
            "verseOrgIds": [
              "MRK.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abābibonye babadondera ivy’ uwari yinjiwemwo n’abadayimoni n’ivy’ ingurube. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.16",
            "verseOrgIds": [
              "MRK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batangura kumwinginga ngw ave mu ntāra yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.17",
            "verseOrgIds": [
              "MRK.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw aratambukira mu bgato, uwari yinjiwemwo n’abadayimoni aramwinginga ngw agume kuri we. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.18",
            "verseOrgIds": [
              "MRK.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiyamukundira, arikw aramubarira, ati Ja i muhira i wawe mu b’i wanyu, ubabarire ivyo Umwami Imana igukoreye vyose, kand’ ingen’ ikugiriye ikigongwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.19",
            "verseOrgIds": [
              "MRK.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.31"
              },
              "items": [
                {
                  "text": "Mrk 7:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.4.25"
              },
              "items": [
                {
                  "text": "Mat 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aragenda, atangura gukwiza i Dekapoli ivyo Yesu yamukoreye vyose, abantu bose baratangara.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.20",
            "verseOrgIds": [
              "MRK.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yesu agenda mu bgato, asubira hakurya, ishengero ryinshi rikoranira kuri we; yar’ i ruhande y’ikiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.21",
            "verseOrgIds": [
              "MRK.5.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.9.18+MAT.9.19+MAT.9.20+MAT.9.21+MAT.9.22+MAT.9.23+MAT.9.24+MAT.9.25+MAT.9.26"
              },
              "items": [
                {
                  "text": "Mat 9:18-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.41+LUK.8.42+LUK.8.43+LUK.8.44+LUK.8.45+LUK.8.46+LUK.8.47+LUK.8.48+LUK.8.49+LUK.8.50+LUK.8.51+LUK.8.52+LUK.8.53+LUK.8.54+LUK.8.55+LUK.8.56"
              },
              "items": [
                {
                  "text": "Luk 8:41-56",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza umwe mu bakuru b’isinagogi, yitwa Yayiro, amubonye amwitembagaza imbere y’ibirenge, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.22",
            "verseOrgIds": [
              "MRK.5.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.7.32"
              },
              "items": [
                {
                  "text": "Mrk 7:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "aramwinginga cane, at’ Akana kanje k’agakobga kari ku mpfiro, ndakwinginze, n’uze se, umurambikekw ibiganza, akire, abeho. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.23",
            "verseOrgIds": [
              "MRK.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aragenda, ajana na we. Ishengero ryinshi riramukurikira rimubanda.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.24",
            "verseOrgIds": [
              "MRK.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ umugore arwaye ubutinyanka yar’ abimaranye imyaka cumi n’ibiri, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.25",
            "verseOrgIds": [
              "MRK.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "yababajwe cane n’abavūzi benshi bamumarisha ibintu vyiwe vyose abitangamw’ ingemu, ntihāgira ico bamumarira, mber’ arushiriza kurwara; ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.26",
            "verseOrgIds": [
              "MRK.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "yumvise ivya Yesu, araza, aca hagati y’ishengero, amuturuka inyuma, akora ku mpuzu yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.27",
            "verseOrgIds": [
              "MRK.5.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yari yibgiye, ati N’iyo nokora ku mpuzu ziwe gusa, nokira. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.28",
            "verseOrgIds": [
              "MRK.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MRK 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwanya isōko y’amaraso irakama, amenya mu mubiri wiwe yukw akize ico cago. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.29",
            "verseOrgIds": [
              "MRK.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MRK 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.6.19"
              },
              "items": [
                {
                  "text": "Luk 6:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ako kanya Yesu yumva muri we ubushobozi bumuvamwo, ahindukira abāndana n’ishengero, arababaza, ati Ni nde akoze ku mpuzu zanje? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.30",
            "verseOrgIds": [
              "MRK.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MRK 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa biwe baramwishura, bat’ Ubone abantu bariko barakubānda, nawe ukagira uti Ni nde ankozeko? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.31",
            "verseOrgIds": [
              "MRK.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MRK 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aberaguzamw’ amaso, ngw abone ūmukozeko. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.32",
            "verseOrgIds": [
              "MRK.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MRK 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mugore aratinya, ahinda agashitsi, kukw azi ikimubayeko, araza amwikubita imbere, amubarira ivy’ ukuri vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.33",
            "verseOrgIds": [
              "MRK.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubgira, ati Mwana wanje, ukwizera kwawe kuragukijije, genda amahoro, ukire rwose icago cawe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "MRK 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.34",
            "verseOrgIds": [
              "MRK.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MRK 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akivuga, haza abavuye kwa wa mukuru w’isinagogi, bati Wa mwana wawe aracīkānye, uracagorera iki Umwigisha? ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.35",
            "verseOrgIds": [
              "MRK.5.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MRK 5:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yesu ntiyashira umutima kw ijambo rivuzwe, abarira uwo mukuru w’isinagogi, ati Ntutinye, wizere gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.36",
            "verseOrgIds": [
              "MRK.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "MRK 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiyakundira uwundi muntu kujana na we, atari Petero na Yakobo na Yohana mwene nyina wa Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.37",
            "verseOrgIds": [
              "MRK.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "MRK 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse ku nzu y’uwo mukuru w’isinagogi, asanga bariko barakoma induru barira baboroga cane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.38",
            "verseOrgIds": [
              "MRK.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "MRK 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.11.11"
              },
              "items": [
                {
                  "text": "Yoh 11:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yinjiye arababaza, ati N’iki gitumye mukoma induru murira? Umwana ntahwereye, arikw arasinziriye. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.39",
            "verseOrgIds": [
              "MRK.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "MRK 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramutwenga bamushinyagurira. Arabakumīra bose, ajana se w’umwana na nyina n’abāri kumwe na we, yīgira haruguru ah’ ikiziga kiri, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.40",
            "verseOrgIds": [
              "MRK.5.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "MRK 5:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.7.14"
              },
              "items": [
                {
                  "text": "Luk 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "afata ukuboko kw’ikiziga, arakibarira, ati Talisa kumi; bisobanurwa ngo Gakobga, ndakubariye, nti Vyuka. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.41",
            "verseOrgIds": [
              "MRK.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "MRK 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umukobga aca avyuka uwo mwanya, aragendagenda, kuko yar’ amaze imyaka cumi n’ibiri avutse: baca baratangara cane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.42",
            "verseOrgIds": [
              "MRK.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "MRK 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.44"
              },
              "items": [
                {
                  "text": "Mrk 1:44",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabihanikiriza cane, ngo ntihagire umuntu n’umwe abimenya, arababarira ngo bamugaburire.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.5.43",
            "verseOrgIds": [
              "MRK.5.43"
            ]
          }
        }
      ]
    }
