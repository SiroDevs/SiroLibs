        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo, uburake bg’ umwami Ahasuwerusi buhwamye, yibuka ivya Vashiti n’ ivyo yakoze, n’ivyashinzwe kubgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.1",
            "verseOrgIds": [
              "EST.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.1.2"
              },
              "items": [
                {
                  "text": "1 Abam 1:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abāsukurira umwami baramubgira, bati Mwami, ni bakuronderere abigeme b’ inkumi beza‐beza; ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.2",
            "verseOrgIds": [
              "EST.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n’ ushireh’ abantu mu bihugu vyawe vyose, mwami, ngo bakoranirize hamwe abigeme bose b’inkumi beza‐beza ku murwa i Shushani, bashirwe mu nzu y’abigeme, babashikirize Hegayi inkone y’umwami, asanzwe arinda abigeme, bahabge ivyo kwisīga ngo bayagayage mu maso. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.3",
            "verseOrgIds": [
              "EST.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwigeme uzoshima az’ abe umwamikazi mu gishingo ca Vashiti. Nuk’ umwami ashima iyo nama, abigenza artyo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.2.4",
            "verseOrgIds": [
              "EST.2.4"
            ]
          }
        }
      ]
    },
    {
