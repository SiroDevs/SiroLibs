            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ni ko nyene mugiriranira na bene Data bose b’i Makedoniya hose. Ariko bene Data turabahanūra ngo murushirize kugira rwinshi. ",
          "type": "text",
          "attrs": {
