                {
                  "text": "Zab 94:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ng’umuntu wese ntarenge ibikwiye, kandi ntagunge mwene Data wundi kur’ ivyo, kuk’ Umwami wacu ar’ umuhōzi kur’ ivyo vyose, nk’uko twababūriye tubishimikiye. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.6",
            "verseOrgIds": [
              "1TH.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 4:7"
