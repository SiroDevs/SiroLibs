            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bene Data, ibisigaye, turabinginga tubahanūra mu Mwami Yesu, nk’uko mwize kuri twebge ingene mukwiye kugenda no kunezereza Imana (kandi ni ko mugenda), murushirize cane kugenza murtyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.1",
            "verseOrgIds": [
              "1TH.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Murazi ivyagezwe twahawe n’Umwami Yesu kubabarira ivy’ ari vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.2",
            "verseOrgIds": [
              "1TH.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 4:3"
