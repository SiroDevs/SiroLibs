            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma ūvyanka ataba yanse umuntu arikw aba yanse Imana, kand’ ari yo ibaha Mpwemu wayo Yera.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.8",
