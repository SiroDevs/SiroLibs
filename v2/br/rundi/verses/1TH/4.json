                "loc": "PSA.79.6"
              },
              "items": [
                {
                  "text": "Zab 79:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "atari mu buryo bgo kwāngāza umutima mu vyifuzo, nk’ukw abanyamahanga batazi Imana bagira; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.5",
            "verseOrgIds": [
              "1TH.4.5"
            ]
          }
        },
