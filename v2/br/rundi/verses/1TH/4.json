        {
          "text": "Arikw ivyo gukunda bene Data ntimurinda kuvyandikirwa, kuk’ ubganyu mwigishijwe n’Imana gukundana; ",
          "type": "text",
          "attrs": {
            "verseId": "1TH.4.9",
