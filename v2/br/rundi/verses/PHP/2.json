                {
                  "text": "33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kand’ umuntu wese ntiyiyumvire ivyiwe gusa, ariko yiyumvire n’ivy’ abandi.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.4",
            "verseOrgIds": [
              "PHP.2.4"
