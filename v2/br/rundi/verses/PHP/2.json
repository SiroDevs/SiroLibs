          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gitumye ngira umwete wo kumurungika, kugira ngo ni mwongera kumubona muze munezerwe, nanje ngabanuke umubabaro. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.28",
