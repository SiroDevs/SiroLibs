        },
        {
          "text": "Nuko namba har’ ukuremeshwa muri Kristo, namba har’ ukwirurwa kuva mu rukundo, namba har’ ugusangira Mpwemu, namba har’ imbabazi n’ikigongwe, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.1",
            "verseOrgIds": [
              "PHP.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mwuzuze umunezero wanje muhwanije imitima, musangiye urukundo rumwe, muhūje umutima n’inama. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.2.2",
            "verseOrgIds": [
              "PHP.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
