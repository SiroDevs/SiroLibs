                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakebge ku musi ugira umunani, nd’ uwo mu bgoko bga Isirayeli, nd’ uwo mu muryango wa Benyamini, mu Baheburayo nd’ Umuheburayo, ku vyo gushimikira ivyagezwe, nd’ Umufarisayo; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.5",
            "verseOrgIds": [
              "PHP.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku vy’ ishaka nahama ishengero; ku vy’ ukugororoka kuzanwa n’ivyagezwe nta wobonye ic’ angaya.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.6",
            "verseOrgIds": [
              "PHP.3.6"
            ]
          }
        }
      ]
