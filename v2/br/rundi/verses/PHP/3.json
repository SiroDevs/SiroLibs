            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo kumbure nshike ku kuzuka kw’abapfuye. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.11",
            "verseOrgIds": [
              "PHP.3.11"
            ]
