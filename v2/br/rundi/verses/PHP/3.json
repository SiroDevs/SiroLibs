              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GAL.6.16"
              },
              "items": [
                {
                  "text": "Gal 6:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo rero, ukuri dushitsemwo, abe ari kwo tugenderamwo.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.16",
            "verseOrgIds": [
              "PHP.3.16"
            ]
