                "loc": "ACT.26.5"
              },
              "items": [
                {
                  "text": "Ivyak 26:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.1.59"
