                  "text": "Gal 6:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo ndamumenye, mmenye n’ubushobozi bg’ukuzuka kwiwe, n’ugufatanya na we imibabaro yiwe, nshushanywe n’urupfu rwiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.10",
            "verseOrgIds": [
              "PHP.3.10"
            ]
          }
        },
        {
