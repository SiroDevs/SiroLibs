                {
                  "text": "Rom 2:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko tweho tur’ abākebge, dusenga Imana mu buryo bga Mpwemu, tukirata Kristo Yesu, ntitwishimire ivy’ umubiri; ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.3.3",
            "verseOrgIds": [
              "PHP.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 3:4"
          },
          "items": [
