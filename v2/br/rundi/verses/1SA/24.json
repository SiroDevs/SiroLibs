              "type": "text"
            }
          ]
        },
        {
          "text": "Abarira Dawidi, at’ Undushije kugororoka, kuk’ ungiriye neza, nanje jeho nakugiriye nabi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.17",
            "verseOrgIds": [
