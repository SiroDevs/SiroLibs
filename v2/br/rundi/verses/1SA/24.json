            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi rero ndazi k’utazobura kuba umwami, kandi kw ari wewe uzotuma ingoma y’Abisirayeli ihangama. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.20",
            "verseOrgIds": [
              "1SA.24.20"
            ]
          }
