                  "text": "1 Sam 26:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi amaze kubarira Sauli ayo majambo, Sauli aravuga, at’ Ah’ iryo jwi n’iryawe, ga mwana wanje Dawidi? Maze Sauli araturikisha ararira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.16",
            "verseOrgIds": [
              "1SA.24.16"
            ]
          }
        },
