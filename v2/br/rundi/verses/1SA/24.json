                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.43.1"
              },
              "items": [
                {
                  "text": "43:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.119.154"
              },
              "items": [
                {
                  "text": "119:154",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.50.34"
              },
              "items": [
                {
                  "text": "Yer 50:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rer’ Uhoraho n’abe umucamanza, aducīre urubanza twe nawe, n’avyitegereze, ambūrane, ankūre mu maboko yawe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.15",
            "verseOrgIds": [
              "1SA.24.15"
            ]
          }
        }
      ]
    },
