          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uyu musi werekanye k’ungiriye neza, kuk’ Uhoraho yari yangabuye mu maboko yawe, ntunyice. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.18",
            "verseOrgIds": [
              "1SA.24.18"
            ]
          }
        },
