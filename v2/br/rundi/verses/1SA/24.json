            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ umuntu yobona umwansi wiwe, agaheza agapfa kumureka akīgīra? Uragahabga ingororano nziza n’Uhoraho, ku vy’ unkoreye uyu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.24.19",
            "verseOrgIds": [
              "1SA.24.19"
            ]
          }
        },
        {
