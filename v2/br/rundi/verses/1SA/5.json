                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatāpfuye batērērwa ibihute; induru z’ico gisagara zishika mw ijuru.",
          "type": "text",
          "attrs": {
