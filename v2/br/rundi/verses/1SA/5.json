            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.46.2"
              },
              "items": [
                {
                  "text": "2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye mu mavyuka ya kare Abanyashidodi basanga Dagoni yatemvye yubamye imbere y’isandugu y’Uhoraho; barayegura, bayisubiza ahantu hayo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
