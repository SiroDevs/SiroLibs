              },
              "items": [
                {
                  "text": "Mik 1:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye bgaho, mu mavyuka ya kare nyene, basanga Dagoni yongeye gutemba yubamye imbere y’isandugu y’Uhoraho, kand’ umutwe n’ibikonjo vyayo vyahimbaguritse vyayivuyeko, bitembagara mu rwinjiriro; hari hasigaye umutumba wayo gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.1.9"
              },
              "items": [
                {
                  "text": "Zef 1:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma abaherezi ba Dagoni n’uwinjira mu ngoro yayo wese, bitonda kudakandagira mu rwinjiriro rw’ ingoro ya Dagoni yo muri Ashidodi gushitsa n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
