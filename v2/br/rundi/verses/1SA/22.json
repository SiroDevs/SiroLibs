              "items": [
                {
                  "text": "1 Sam 15:34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Sauli yumva ko Dawidi n’abo bari kumwe har’ abababonye; kandi yar’ avyāgiye musi y’igiti c’umwesheli ku gatwe k’ umusozi i Gibeya; yar’ afise icumu mu minwe, kand’ abagendanyi biwe bose bari bahagaze bamukikije. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.6",
            "verseOrgIds": [
              "1SA.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.8.14"
              },
              "items": [
                {
                  "text": "1 Sam 8:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli abaza abo bagendanyi biwe bamuhagaze irya n’ino, ati Yemwe mwa Babenyamini! Aho mwene Isayi uwo azoha umuntu wese muri mwebge amatongo n’imizabibu? Kandi mwese azobagira abagaba ibihumbi n’abagaba amajana, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.7",
            "verseOrgIds": [
              "1SA.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.3"
              },
              "items": [
                {
                  "text": "1 Sam 18:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.22.13"
              },
              "items": [
                {
                  "text": "22:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo bitume mwese mungarariza? Kw ata n’umwe yarushe ammenyesha k’umwana wanje yasezeranye na mwene Isayi, ntihagire n’ūmbabara n’umwe, cank’ ūmmenyesha k’umwana wanje yangararishirije umuntu akamugira umwansi wanje, nk’uko bimeze n’ubu!",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.8",
            "verseOrgIds": [
              "1SA.22.8"
            ]
          }
        }
      ]
    },
