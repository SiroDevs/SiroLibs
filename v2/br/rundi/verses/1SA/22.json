            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye ūvugishwa n’Imana Gadi abarira Dawidi, ati Reka gukomeza kuba mur’ iryo senga; rivemwo, uje mu ntāra y’i Buyuda. Nuko Dawidi avayo, aja mu kibira c’i Hereti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.5",
            "verseOrgIds": [
              "1SA.22.5"
            ]
          }
        }
