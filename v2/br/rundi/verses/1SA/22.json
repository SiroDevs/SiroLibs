                  "text": "Rus 4:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Dawidi aja i Misipa h’i Mowabu, asaba umwami w’i Mowabu, ati Ndakwinginze, wemerere data na mama bimukire ino, babe i wawe gushitsa aho nzomenyera ico Imana izongirira. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.3",
            "verseOrgIds": [
              "1SA.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abashikiriza umwami w’i Mowabu; baba i we igihe cose Dawidi yamaze mw isenga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.4",
            "verseOrgIds": [
              "1SA.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 22:5"
          },
