            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dowegi w’Umunyedomu, yar’ ahagararanye n’abo bagendanyi ba Sauli, yishura umwami, ati Narabonye mwene Isayi uwo aza i Nobu kwa Ahimeleki mwene Ahitubu; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.9",
            "verseOrgIds": [
              "1SA.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 22:10"
          },
          "items": [
