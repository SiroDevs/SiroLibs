              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "na we amusiguriza Uhoraho, kand’ amuha impamba, amuha na ya nkota yar’ iya Goliyati Umufilisitiya.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.10",
