              },
              "items": [
                {
                  "text": "Guh 27:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.6"
              },
              "items": [
                {
                  "text": "1 Sam 21:6",
