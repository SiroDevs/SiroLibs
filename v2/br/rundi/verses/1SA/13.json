              },
              "items": [
                {
                  "text": "Abac 5:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma umusi intambara yarumanako, mu bantu bāri kumwe na Sauli na Yonatani ata n’umwe yar’ afise inkota cank’ icumu, ukūye Sauli na Yonatani umuhungu wiwe: ni bo bāri babifise. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.13.22",
            "verseOrgIds": [
              "1SA.13.22"
            ]
          }
        },
