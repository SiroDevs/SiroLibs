                {
                  "text": "1 Sam 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze barangije kurya no kunywa aho bāri bari i Shilo, Hana ava hasi. Kandi Eli umuherezi yari yicaye ku ntebe yiwe ku gishimaryango mu rusengero rw’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.9",
            "verseOrgIds": [
              "1SA.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.7.11"
              },
              "items": [
                {
                  "text": "Yob 7:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOB.10.1"
              },
              "items": [
                {
                  "text": "10:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hana asenga Uhoraho afise intuntu, arira cane, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.10",
            "verseOrgIds": [
              "1SA.1.10"
            ]
          }
        },
