          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe kiragera, Hana asama inda, avyara umwana w’umuhungu, amwita Samweli, ati Kuko namusavye Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.20",
