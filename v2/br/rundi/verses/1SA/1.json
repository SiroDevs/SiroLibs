                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muntu yama ava mu gisagara c’i wabo uk’ umwaka utashe, akadūga i Shilo gusenga no gushikanira Uhoraho Nyen’ ingabo ibimazi. Kandi bene Eli bompi, Hofuni na Finehasi, bār’ abaherezi b’Uhoraho aho hantu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.3",
            "verseOrgIds": [
              "1SA.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.17"
              },
              "items": [
                {
                  "text": "Gus 12:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.18"
              },
              "items": [
                {
                  "text": "18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi Elukana yatangakw ikimazi, yahakw imitigiri Penina umugore wiwe, n’abahungu biwe n’abakobga biwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.4",
            "verseOrgIds": [
              "1SA.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko Hana yamuha umutigiri ungana n’iyabo kabiri, kuko yamukunda; arik’ Uhoraho yari yaramuzivye inda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.5",
            "verseOrgIds": [
              "1SA.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.16.4"
              },
              "items": [
                {
                  "text": "Ita 16:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mukēba we yama amushinyagurira, akamutera intuntu, kuk’ Uhoraho yamuzivye inda. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.6",
            "verseOrgIds": [
              "1SA.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko vyāgenda, uk’ umwaka utashe: uko Hana yadūga aja mu ngoro y’Uhoraho, ni ko mukēba we yamushinyagurira. Ni co cātuma arira, akanka kurya. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.7",
            "verseOrgIds": [
              "1SA.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "RUT.4.15"
              },
              "items": [
                {
                  "text": "Rus 4:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umugabo wiwe Elukana aramubaza, at’ Urizwa n’iki ga Hana? N’iki kikubuza kurya? Ubabajwe n’iki? Mbega sinkurutira abahungu cumi wovyaye?",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.8",
            "verseOrgIds": [
              "1SA.1.8"
            ]
          }
        }
      ]
    },
