                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hār’ umuntu w’i Ramatayimu‐sofimu, mu mugamba w’Abefurayimu, yitwa Elukana; yari mwene Yerohamu, Yerohamu wa Elihu, Elihu wa Tohu, Tohu wa Sufu, w’Umwefurayimu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.1",
            "verseOrgIds": [
              "1SA.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yar’ afise abagore babiri, umwe yitwa Hana, uwundi Penina; Penina ni we yavyara, ariko Hana yar’ ingumba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.2",
            "verseOrgIds": [
              "1SA.1.2"
            ]
          }
        }
      ]
    },
