          "text": "Uyu mwana ni we nasaba, kand’ Uhoraho yampaye ico namusavye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
