              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw akomeje artyo gusengera imbere y’Uhoraho, Eli yitegereza umunwa wiwe; ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.12",
            "verseOrgIds": [
              "1SA.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko Hana yavugira mu mutima, akubita umunwa gusa, arikw ijwi ryiwe ritumvikana; ni co catumye Eli yiyumvira kw aborewe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.13",
            "verseOrgIds": [
              "1SA.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Eli aramubaza, at’ Uzogeza hehe kwama uborewe? Genda uhebe iyo vino yawe! ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.14",
            "verseOrgIds": [
              "1SA.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
