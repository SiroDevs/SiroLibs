                {
                  "text": "Int 2:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Hana aramwishura, at’ Oyaye mwami wanje, nd’ umuntu yabonye amahano! Nta vino nanyoye cank’ ikindi kiboreza, ariko nariko ndasuka amajojwa yanje imbere y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.15",
            "verseOrgIds": [
              "1SA.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
