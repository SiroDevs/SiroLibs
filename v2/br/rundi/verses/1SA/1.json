              "items": [
                {
                  "text": "48",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "asezerana isezerano, at’ Ewe Uhoraho Nyen’ ingabo, ni warāba umubabaro wanje incoreke yawe, ukanyibuka, ntunyibagire jewe incoreke yawe, ukantabaza umwana w’umuhungu, nanje nzomuguha, Uhoraho, abe uwawe kuzorinda apfa, kandi nta rupfuhe ruzomugera ku mutwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.11",
            "verseOrgIds": [
              "1SA.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
