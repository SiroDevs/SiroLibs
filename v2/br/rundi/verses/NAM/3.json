              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyose vyatewe n’ubusambanyi burenze urugero bga maraya ateye igomwe, umurozikazi w’umuhanga, aresha amahanga kubg’ ubusambanyi bgiwe, n’imiryango kubg’ uburozi bgiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.4",
            "verseOrgIds": [
              "NAM.3.4"
            ]
          }
        },
        {
