            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humvikana inyobozo, n’uguhinda kw’amakurudumu abomborana, n’imirindi y’amafarasi agenda yiginagura, n’uguhinda kw’imikogote y’intambara isimbagurika; ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.2",
            "verseOrgIds": [
              "NAM.3.2"
            ]
          }
        },
        {
          "name": "verse",
