                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abazokurāba bose bazoguhunga, bati Ninewe harageseye! Ni nde azoharirira? Nokūra hehe abo kukwirura?",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.7",
            "verseOrgIds": [
              "NAM.3.7"
            ]
          }
        }
