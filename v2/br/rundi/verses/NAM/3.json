        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.6.13"
              },
              "items": [
                {
                  "text": "Ivyah 6:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaboma yawe yose azoba nk’ibiti vy’imisukoni, birikw insukoni z’isega: iyo binyiganyigijwe zigahungurukira mu kanwa k’ umuryi. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.12",
            "verseOrgIds": [
              "NAM.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NAM 3:13"
          },
          "items": [
