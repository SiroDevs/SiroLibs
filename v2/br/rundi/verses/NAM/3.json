                  "text": "Yes 22:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enda ni wivomere amazi azomara igihe uzoba wugarijwe; amaboma yawe n’uyakomeze; ja mw ibumba, ukāte urwondo; fata iforoma ry’amatafari. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.14",
            "verseOrgIds": [
              "NAM.3.14"
            ]
          }
