            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isinzi ry’Abanyetiyopiya n’ Abanyegiputa ni bo bār’ inkomezi zaho; Abaputi n’Abalubimu bār’ abatabazi baho. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.9",
            "verseOrgIds": [
              "NAM.3.9"
            ]
          }
        },
        {
