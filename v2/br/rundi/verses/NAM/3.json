                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe n’uko, uzoborerwa, uje kwinyegeza; kand’ uzokwironderera ubuhungiro kubg’ abansi. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.11",
            "verseOrgIds": [
              "NAM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
