            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngutere ivyatsi, nguhindure agashinyo, nkugire akabarore. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.6",
            "verseOrgIds": [
              "NAM.3.6"
            ]
