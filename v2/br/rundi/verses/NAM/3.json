                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe nzohigūra nawe, ni k’ Uhoraho Nyen’ ingabo agize; nzogukūrakw impuzu, mfate ku musozo ndenze ku mutwe wawe, nereke amahanga ubgambure bgawe, n’ibihugu ndavyereke ibiteye isoni vyawe, ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.5",
            "verseOrgIds": [
              "NAM.3.5"
            ]
          }
        },
        {
