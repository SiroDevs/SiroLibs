              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega har’ ico urusha No‐Amona, hāba hagati y’inzūzi, amazi akahubakira nk’urugo, kand’ ikiyaga kikahahindukira uruzitiro? ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.8",
            "verseOrgIds": [
              "NAM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
