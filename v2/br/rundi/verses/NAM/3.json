              },
              "items": [
                {
                  "text": "Yes 19:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.51.30"
              },
              "items": [
                {
                  "text": "Yer 51:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ abantu bawe bari muri wewe bameze bga bagore; amarembo y’igihugu cawe yugururiwe abansi bawe: umuriro watōngōye imyugariro yawe. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.13",
            "verseOrgIds": [
              "NAM.3.13"
            ]
          }
        },
        {
