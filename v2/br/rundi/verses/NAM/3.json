              "items": [
                {
                  "text": "Yow 3:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko hāranyazwe, hajanwa ar’ inyagano; n’ibibondo vyaho vyāhondaguriwe mu mayirabiri yose: n’abanyacubahiro baho bābagabanganishije ubupfindo, n’abahambaye baho bābabohesheje iminyororo. ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.10",
            "verseOrgIds": [
              "NAM.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
