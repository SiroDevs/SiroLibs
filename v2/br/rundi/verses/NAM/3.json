            "number": "3",
            "style": "v",
            "sid": "NAM 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwisuka mu rugamba ari kw ifarasi, inkota ziravya indimi, amacumu aca ibibatsi, abishwe n’indiri, har’ ibirundo vy’imirambararo, imivyimba ntiyoharūrika, ingabo zitsitara ku mivyimba yabo! ",
          "type": "text",
          "attrs": {
            "verseId": "NAM.3.3",
            "verseOrgIds": [
              "NAM.3.3"
            ]
          }
        },
        {
