                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mw ibūrana ryanje rya mbere nta wanyikije, ariko bose barantaye: icompa ntibabiharūrweko. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.16",
