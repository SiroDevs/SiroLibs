                  "text": "Kol 4:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dema yarantaye, kukw akunze iyi si ya none, yīgīra i Tesalonike: Keresikenti yagiye i Galatiya: Tito yagiye i Dalumatiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.10",
