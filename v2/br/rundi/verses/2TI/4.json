                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Luka gusa ni we twasigaranye. Hitana Mariko, umuzane, kukw angirira ikimazi mu gikorwa c’ibango ryanje. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.11",
            "verseOrgIds": [
