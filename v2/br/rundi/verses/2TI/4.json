            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alekisandero umucuzi yangiriye inabi nyinshi. Umwami wacu azomwishura ibikwiranye n’ivyo yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.14",
            "verseOrgIds": [
              "2TI.4.14"
            ]
          }
