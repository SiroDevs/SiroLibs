              "items": [
                {
                  "text": "2 Tes 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi bazokwiziba amatwi, ngo ntibumve ukuri, bazozimira bakurikire imigani y’ibinyoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.4",
            "verseOrgIds": [
              "2TI.4.4"
            ]
          }
        },
