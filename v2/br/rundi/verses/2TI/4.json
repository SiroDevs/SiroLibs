            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Tukiko namurungitse muri Efeso. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.12",
            "verseOrgIds": [
              "2TI.4.12"
