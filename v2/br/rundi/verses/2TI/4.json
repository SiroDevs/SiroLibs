              "items": [
                {
                  "text": "2 Tim 1:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TI.4.1"
              },
              "items": [
                {
                  "text": "1 Tim 4:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw igihe kizoza, batazokwemera kwumva ukwigisha kuzima; ariko kukw amatwi abarya yifuza kwumva ibibanezereza, bazokwirundaniriza abigisha bahūje n’ukwifuza kwabo, ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.3",
            "verseOrgIds": [
              "2TI.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2TI 4:4"
          },
          "items": [
