                "loc": "1TI.4.7"
              },
              "items": [
                {
                  "text": "1 Tim 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.11"
