                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uvuge ijambo ry’Imana, uhore ugavye mu gihe gikwiye no mu kidakwiye, uhane, wihanize, uhanūre, mu kwihangana kwose no mu kwigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.2",
            "verseOrgIds": [
              "2TI.4.2"
            ]
          }
        },
