                "loc": "EPH.4.11"
              },
              "items": [
                {
                  "text": "Ef 4:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko weho, wirinde muri vyose, wihanganire imibabaro, ukore igikorwa c’umuvuzi w’ubutumwa bgiza, ushitse igikorwa c’ibango ryawe.",
          "type": "text",
          "attrs": {
            "verseId": "2TI.4.5",
            "verseOrgIds": [
              "2TI.4.5"
            ]
          }
        }
