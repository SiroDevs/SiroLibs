        {
          "text": "Ni co gituma ata n’akame ijuru rikibarekurira, n’isi ikabima ivyimburo vyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.10",
            "verseOrgIds": [
              "HAG.1.10"
            ]
