              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hagayi, intumwa y’Uhoraho, abgira abantu ubutumwa batumweko n’Uhoraho, at’ Uhoraho agize ngw Ari kumwe namwe. ",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.13",
