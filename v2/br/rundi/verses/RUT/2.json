          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        },
        {
