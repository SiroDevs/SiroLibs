        },
        {
          "text": "Kandi Nawomi yar’ afise mwene wabo w’umugabo wiwe, umuntu akomeye w’umutunzi, wo mu muryango wa Elimeleki, yitwa Bowazi. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.1",
            "verseOrgIds": [
              "RUT.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "RUT 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.19.9"
              },
              "items": [
                {
                  "text": "Lew 19:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.22"
              },
              "items": [
                {
                  "text": "23:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.19"
              },
              "items": [
                {
                  "text": "Gus 24:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rusi wa Munyamowabukazi abarira Nawomi, ati Ndekura ngende mu bibuba mpūmbe uduhūmbga, nkurikire uwongirira ubuntu. Aramwishura, ati Genda, mukobga wanje. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.2",
            "verseOrgIds": [
              "RUT.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "RUT 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aragenda, ahūmba mu kibuba akurikiye abagenyi: kand’ umurima yarengutseko war’ uwo mw itongo rya Bowazi, wo mu muryango wa Elimeleki.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.3",
            "verseOrgIds": [
              "RUT.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
