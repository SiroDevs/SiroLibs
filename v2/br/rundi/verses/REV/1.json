          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.7"
              },
              "items": [
                {
                  "text": "Ivyah 22:7",
                  "type": "text"
                }
