              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uguhishura kwa Yesu Kristo, ukwo yahawe n’Imana ngo yereke abagurano biwe ibigira bibeho vuba, agatuma umumarayika wiwe akabimenyesha umugurano wiwe Yohana, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
