              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe ndi Alufa na Omega",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
