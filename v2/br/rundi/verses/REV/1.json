          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:8",
              "type": "text"
            },
            {
              "text": "Alufa ni yo nyuguti ya mbere yo mu Kigiriki, Omega ni yo iheruka.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", ni k’Umwami Imana igize, iriho, kandi yamyeho, kand’ igira ize, ni yo ishobora vyose.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
