        },
        {
          "text": "Jewe Yohana ndabandikiye mwebge abo mu mashengero ndwi yo muri Asiya. Ubuntu bube muri mwebge n’amahoro biva kur’ Iyo, iriho, kandi yamyeho, kand’ igira ize, biva no ku Mpwemu ndwi zir’ imbere y’intebe yayo, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "no kuri Yesu Kristo, icabona co kwizigirwa, imfura y’abari barapfuye, ūganza abami bo mw isi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
      ]
    },
