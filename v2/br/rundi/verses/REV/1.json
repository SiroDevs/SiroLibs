              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe Yohana, mwene So, musangiye amarushwa n’ubgami n’ukwihangana biri muri Yesu, nari ku kizinga Patimo co mu kiyaga, bampōra ijambo ry’Imana no gushingira intahe Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi w’Imana nari muri Mpwemu, numva inyuma yanje ijwi rirenga nk’iry’ inzamba, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
