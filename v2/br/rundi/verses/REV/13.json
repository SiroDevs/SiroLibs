              "type": "text"
            }
          ]
        },
        {
          "text": "Mbona igikōko ciburuka kiva mu kiyaga, gifise amahembe cumi n’imitwe ndwi: ku mahembe yaco hārih’ imigāra cumi, no ku mitwe yaco hārih’ amazina y’amarogotano.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.1",
            "verseOrgIds": [
              "REV.13.1"
            ]
          }
        },
