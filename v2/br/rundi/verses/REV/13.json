                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gihabga guha ico gishushanyo c’igikōko guhūmēka, ngw ico gishushanyo c’igikōko kivuge, kandi cicishe abatazogisenga bose. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.15",
            "verseOrgIds": [
              "REV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 13:16"
          },
          "items": [
