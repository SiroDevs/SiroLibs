              "items": [
                {
                  "text": "Ivyah 19:20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kigera ko bose, aboroshe n’abahambaye, n’abatunzi n’aboro, n’abidegemvya n’abagurano, bashirwakw ikimenyetso ku kiganza c’i buryo canke mu ruhanga: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.16",
            "verseOrgIds": [
              "REV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ko hatagira umuntu yemererwa kugira ic’ agura cank’ ic’ ashōra, atar’ ūfise ico kimenyetso, ni co zina rya ca gikōko cank’ igitigiri c’izina ryaco. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
