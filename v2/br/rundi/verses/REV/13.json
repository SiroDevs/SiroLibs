              },
              "items": [
                {
                  "text": "17:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ ababa kw isi bose bazogisenga, umuntu wese atanditswe izina mu gitabo c’ubugingo c’Umwagazi w’Intama yatanzwe kw ikimazi uhereye ku kuremwa kw’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.8",
            "verseOrgIds": [
              "REV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namba har’ umuntu ari n’ugutwi ni yumve. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.9",
            "verseOrgIds": [
              "REV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.2"
              },
              "items": [
                {
                  "text": "Yer 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.26.52"
              },
              "items": [
                {
                  "text": "Mat 26:52",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.12"
              },
              "items": [
                {
                  "text": "Ivyah 14:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namb’ umuntu yagerewe gufatwa mpiri azofatwa mpiri; namb’ umuntu yicisha inkota akwiye kuzokwicishwa inkota. Aho ni ho ukwihangana kw’abera guserukira bo n’ukwizera kwabo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.10",
            "verseOrgIds": [
              "REV.13.10"
            ]
          }
        }
