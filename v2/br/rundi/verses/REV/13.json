              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi gikora ibimenyetso bihambaye, kimanura umuriro uva mw ijuru utibukira kw isi mu maso y’abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.13",
