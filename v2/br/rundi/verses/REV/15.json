              "type": "text"
            }
          ]
        },
        {
          "text": "Kimwe muri vya binyabugingo bine giha bano bamarayika ndwi inzavya ndwi z’izahabu, zuzuye uburake bg’Imana ibaho ibihe bitazoshira. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
