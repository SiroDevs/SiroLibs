              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo mbona huguruka urusengero rw’ihema ry’Ibishinga intahe rwo mw ijuru, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
