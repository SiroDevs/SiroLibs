          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe muri ba bakuru arambaza, at’ Aba bambaye imvune zera ni ba nde, kandi bavuye hehe? ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.13",
            "verseOrgIds": [
              "REV.7.13"
            ]
          }
        },
        {
