              },
              "items": [
                {
                  "text": "Yes 49:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibazoba bakigira inzara ukundi, kandi ntibazoba bakigira inyota ukundi, kand’ izuba ntirizobarabika cank’ indugumba yose, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.16",
            "verseOrgIds": [
              "REV.7.16"
            ]
          }
        },
