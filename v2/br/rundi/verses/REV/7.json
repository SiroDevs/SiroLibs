              },
              "items": [
                {
                  "text": "Ivyah 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo mbona ishengero ryinshi, ata woshobora kuriharūra, bo mu mahanga yose n’imiryango yose n’amoko yose n’indimi zose, bahagaze imbere y’iyo ntebe n’imbere y’Umwagazi w’Intama, bambaye imvune zera, bari n’amashami y’ibigazi mu minwe: ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.9",
            "verseOrgIds": [
              "REV.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.10"
              },
              "items": [
                {
                  "text": "Ivyah 12:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "basemerera n’ijwi rirenga, bat’ Agakiza n’ak’ Imana yacu ivyagiye kur’ irya ntebe n’ak’ Umwagazi w’Intama. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.7.10",
            "verseOrgIds": [
              "REV.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
