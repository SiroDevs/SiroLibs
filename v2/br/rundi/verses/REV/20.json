                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapfuye bandi ntibaba bazima iyo myaka igihumbi itarashira. Ukwo ni kwo kuzuka kwa mbere. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.5",
            "verseOrgIds": [
              "REV.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
