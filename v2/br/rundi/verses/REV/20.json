                "loc": "2TH.2.9"
              },
              "items": [
                {
                  "text": "2 Tes 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2TH.2.10"
              },
              "items": [
                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "agikororera i kuzimu, arahadadira, ashirakw ikimenyetso kikirumanya, kugira ngo nticongere kuzimiza amahanga, gushitsa ah’ iyo myaka igihumbi izoshirira: ni yashira gikwiye kubohorwa ngo kimare igihe gito.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.3",
            "verseOrgIds": [
              "REV.20.3"
            ]
          }
        }
