              "items": [
                {
                  "text": "Yes 61:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.5.10"
              },
              "items": [
                {
                  "text": "Ivyah 5:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ūri mu mugabane wo kuzuka kwa mbere arahiriwe kandi n’uwera. Urupfu rwa kabiri ntirugira ububasha ku bameze bartyo, ariko bazoba abaherezi b’Imana na Kristo, kandi bazofatanya na we kuganza, iyo myaka igihumbi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.6",
            "verseOrgIds": [
              "REV.20.6"
            ]
