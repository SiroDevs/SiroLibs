            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afata ca gisato, ni co ya nzoka ya mbere, ni yo Murwanizi irindi ni Satani, akiboha ngo kimare imyaka igihumbi, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.20.2",
