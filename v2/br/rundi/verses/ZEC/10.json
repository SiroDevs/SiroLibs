              },
              "items": [
                {
                  "text": "Mik 7:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokwongera mbatārūre no mu gihugu ca Egiputa, mbakoranye mbakūre muri Ashuri: maze mbashitse mu gihugu c’i Gileyadi n’i Lebanoni: mbere ntibazohakwirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.10",
            "verseOrgIds": [
              "ZEC.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.11.15"
              },
              "items": [
                {
                  "text": "Yes 11:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.30.13"
              },
              "items": [
                {
                  "text": "Ezk 30:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoca mu kiyaga kigoye, akubite imipfunda yo mu kiyaga, kand’ uruzi rwa Nili muri nyina hose hazokama: ubgibone bga Ashuri buzocishwa bugufi, n’icumu ry’ umwami wa Egiputa rizovaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.11",
            "verseOrgIds": [
              "ZEC.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.4.5"
              },
              "items": [
                {
                  "text": "Mik 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobaha gukomezwa nanje Uhoraho, na bo bazogendagendera mw izina ryanje, ni k’Uhoraho agize.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.12",
            "verseOrgIds": [
              "ZEC.10.12"
            ]
          }
        }
