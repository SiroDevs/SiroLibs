                {
                  "text": "11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobahamagaza uruhwa mbakoranye, kuko nabacunguye; kandi bazogwira nk’uko bamye bagwira. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.8",
            "verseOrgIds": [
              "ZEC.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.30.1+DEU.30.2+DEU.30.3"
              },
              "items": [
                {
                  "text": "Gus 30:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.6.9"
              },
              "items": [
                {
                  "text": "Ezk 6:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobabiba mu mahanga, kandi bazonyibuka bari mu bihugu vya kure; bazorera abana babo, kandi bazogaruka. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.9",
            "verseOrgIds": [
              "ZEC.10.9"
            ]
          }
        },
        {
