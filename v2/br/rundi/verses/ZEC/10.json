              "items": [
                {
                  "text": "Hab 2:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ibigirwamana vyitwa terafimu bivuga ubusa, n’abapfumu bakaragura ibinyoma; bavōvōta inzozi z’ibihumbagurano, bakaremeshereza abantu ubusa: ni co gituma abantu bazimira nk’intama, bakagorwa, kuko batagira umwungere. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.2",
            "verseOrgIds": [
              "ZEC.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.34.10"
              },
              "items": [
                {
                  "text": "Ezk 34:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
