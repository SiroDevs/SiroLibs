                "loc": "EZK.34.17"
              },
              "items": [
                {
                  "text": "17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uburake bganje buziriringiye abungere, kandi nzohana impfizi z’impene: kuk’ Uhoraho Nyen’ ingabo aje kugendera umukuku wiwe, ni wo nzu ya Yuda, kand’ azobahindura nk’ifarasi yiwe nziza yo mu ntambara. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.3",
            "verseOrgIds": [
              "ZEC.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.22"
              },
              "items": [
                {
                  "text": "Zab 118:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.23"
              },
              "items": [
                {
                  "text": "Yes 22:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri Yuda hazokomōka ibuye rigumya imfuruka, muri we hazokomōka urumambo rugumya ihema; muri we hazokomōka umuheto w’intambara, kandi hamwe n’ivyo muri we hazokomōka umugabisha w’ ingabo wese. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.4",
            "verseOrgIds": [
              "ZEC.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bazomera nk’abahizi mu rugamba, basiribangira abansi babo mu vyondo vyo mu nzira; bazorwana, kuk’ Uhoraho ari kumwe na bo: kand’ abagendera ku mafarasi bazomāramāra. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.5",
            "verseOrgIds": [
              "ZEC.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.14.1"
              },
              "items": [
                {
                  "text": "Yes 14:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzokomeza inzu ya Yuda, nkize n’inzu ya Yosefu; nzobagarukana, kuko mbagiriye ikigongwe; bazomera nk’aho ntigeze kubaca, kuko jewe nd’Uhoraho Imana yabo, kandi nzobumva. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.6",
            "verseOrgIds": [
              "ZEC.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abefurayimu bazomera nk’umuhizi, imitima yabo igire akaneza nk’agatewe na vino; mber’ abana babo bazobirāba bagire akaneza, imitima yabo izonezererwa Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.10.7",
            "verseOrgIds": [
              "ZEC.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 10:8"
          },
          "items": [
