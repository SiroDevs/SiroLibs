              },
              "items": [
                {
                  "text": "Ivyah 22:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abantu bazohagerēra, kandi nta muvumo uzoba ukiriho; ariko Yerusalemu hazokwibēra amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.11",
            "verseOrgIds": [
              "ZEC.14.11"
            ]
          }
        }
