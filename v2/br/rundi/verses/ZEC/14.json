                {
                  "text": "12:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu cose kizohinduka ikiyaya, uhereye i Geba ugashitsa i Rimoni ahahera i bumanuko bg’ i Yerusalemu: kandi Yerusalemu hazoshirwa hejuru habe aho hāhoze, uhereye kw irembo ry’igisagara ryitwa irya Benyamini, ugashitsa ah’ irembo rya mbere ryāhoze, ugashitsa no kw irembo ryo ku nkokora, kand’ uhereye ku munara w’amabuye wa Hananeli ugashitsa ku māto yimbge hasi baganiramwo vino z’i bgami. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.10",
            "verseOrgIds": [
              "ZEC.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.6"
              },
              "items": [
                {
                  "text": "Yer 23:6",
