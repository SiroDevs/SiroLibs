          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico kizoba igihano Egiputa hazohanwa, n’amahanga yose atadūga kumara imisi mikuru y’insago. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.19",
