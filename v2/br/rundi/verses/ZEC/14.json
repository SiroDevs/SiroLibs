            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi kur’ uwo musi amazi y’ubugingo azova i Yerusalemu; amazi amwe azotembera mu kiyaga c’i burasirazuba, ayandi mu kiyaga c’i burengerazuba. Bizoba birtyo mu ci no mu mvura. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.8",
            "verseOrgIds": [
              "ZEC.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
