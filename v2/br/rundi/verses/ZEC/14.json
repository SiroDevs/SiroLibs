              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi n’ihanga rya Egiputa ni ritadūga ngo rize, rizoterwa n’icago Uhoraho azoteza amahanga atadūga kumara imisi mikuru y’insago. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.18",
            "verseOrgIds": [
              "ZEC.14.18"
            ]
          }
