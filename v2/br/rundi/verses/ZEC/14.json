                "loc": "EPH.4.5"
              },
              "items": [
                {
                  "text": "Ef 4:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
