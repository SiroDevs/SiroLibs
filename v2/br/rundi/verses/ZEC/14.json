              },
              "items": [
                {
                  "text": "Yow 1:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ umusi uraje, umusi w’ Uhoraho, aho bazogabanganira iminyago yawe hagati muri wewe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.1",
            "verseOrgIds": [
              "ZEC.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.13.16"
              },
              "items": [
                {
                  "text": "Yes 13:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LAM.5.11"
              },
              "items": [
                {
                  "text": "Int 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOL.3.2"
              },
              "items": [
                {
                  "text": "Yow 3:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.21.24"
              },
              "items": [
                {
                  "text": "Luk 21:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nzoba nkoranije amahanga yose ngw atere i Yerusalemu; umurwa uzotsindwa, amazu asahurwe, bafate abagore babende ku kagōbēro; igihimba c’abo ku murwa bazojanwa ar’ inyagano, arikw amasigarira ntazokūrwa kur’ uwo murwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.2",
            "verseOrgIds": [
              "ZEC.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho azokwisidukira, arwane n’ayo mahanga, nk’uko yahora arwana mu ntambara. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.3",
            "verseOrgIds": [
              "ZEC.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.11.23"
              },
              "items": [
                {
                  "text": "Ezk 11:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi azohagarika ibirenge ku musozi Elayono werekeye i Yerusalemu ahahera i burasirazuba; uwo musozi Elayono uzotemukamwo kubiri uhereye aherekeye i burasirazuba ugashitsa aherekeye i burengerazuba; uzocikamw’ uruhomoka runini cane; igihimba c’uwo musozi kizokwikumira i burārūko, ikindi cikumire i bumanuko. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.4",
            "verseOrgIds": [
              "ZEC.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.1"
              },
              "items": [
                {
                  "text": "Am 1:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.27"
              },
              "items": [
                {
                  "text": "Mat 16:27",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.13"
              },
              "items": [
                {
                  "text": "1 Tes 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzohunga muce mu ruhomoka rwo mu misozi yanje; kuk’ uruhomoka rwo mur’ iyo misozi ruzoshika no kuri Azeli: mbere muzohunga nk’uko mwāhunze hamwe isi yatigita ku ngoma ya Uziya umwami w’i Buyuda; maz’ Uhoraho Imana yanje azoza azananye n’abera bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.5",
            "verseOrgIds": [
              "ZEC.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi ntihazoba har’ umuco utamanzuye, ntihazoba n’ ikibūnda: ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.6",
            "verseOrgIds": [
              "ZEC.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.36"
              },
              "items": [
                {
                  "text": "Mat 24:36",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.21.25"
              },
              "items": [
                {
                  "text": "Ivyah 21:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "arik’ uzoba umusi umwe rudende uzwi n’Uhoraho, atar’ umurango ntube n’ijoro; ariko hageze mu kagoroba hazoba umuco. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.14.7",
            "verseOrgIds": [
              "ZEC.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 14:8"
          },
          "items": [
            {
