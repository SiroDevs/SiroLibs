                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abagabisha bose b’ingabo bari bakwiragiye mu misozi, bo n’ingabo zabo, bumvise yuk’ umwami w’i Babuloni yashizeho Gedaliya mwene Ahikamu kuganza igihugu, kandi ko yamuragije abagabo n’abagore n’abana, n’abo muri ba nyarucari batambukanywe kw inyagano i Babuloni; ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.7",
            "verseOrgIds": [
              "JER.40.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 40:8"
          },
          "items": [
            {
              "text": "8",
