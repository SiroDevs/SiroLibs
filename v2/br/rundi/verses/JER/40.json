            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yohanani mwene Kareya, n’abagabisha bose b’ingabo bāri bakwiragiye mu misozi, baza kuri Gedaliya i Mizipa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.13",
            "verseOrgIds": [
              "JER.40.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 40:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.41.10"
              },
              "items": [
                {
                  "text": "Yer 41:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "baramubgira, bati Mbeg’ urazi yuko Bayalisi umwami w’Abamoni yatumye Ishimayeli mwene Netaniya kukwica? Ariko Gedaliya mwene Ahikamu ntiyavyemera. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.14",
            "verseOrgIds": [
              "JER.40.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 40:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yohanani mwene Kareya abaririra Gedaliya mu mpisho i Mizipa, ati Ndekura ndakwinginze, nje kwica Ishimayeli mwene Netaniya; nta muntu azobimenya: mbega yokwicira iki, Abayuda bose batororokaniye kuri wewe bagasubira gusanzara, amasigarira y’i Buyuda agahona? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.15",
            "verseOrgIds": [
              "JER.40.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 40:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Gedaliya mwene Ahikamu abarira Yohanani mwene Kareya, ati Ntuz’ ukore ikintu kimeze girtyo: kuk’ ubeshera Ishimayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.40.16",
            "verseOrgIds": [
              "JER.40.16"
            ]
          }
        }
      ]
