                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Erega mama, mbonye ibara, kuko wamvyaye nd’ umutēzi w’ intambara, nd’ umutēzi w’amahane mw isi yose! Nta we nagurāniye kuzohabga ay’ inyungu, kandi nta bāngurānye ngo nze mbahe ay’ inyungu: arik’ umuntu wese muri bo aramvuma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.10",
            "verseOrgIds": [
              "JER.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho arambarira, ati N’ukuri nzogukomeza umere neza; n’ukuri nzotuma abansi bagukomera ibōbo mu gihe c’ivyago no mu gihe c’amagorwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.11",
            "verseOrgIds": [
              "JER.15.11"
            ]
          }
        }
      ]
    },
