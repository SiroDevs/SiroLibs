                  "text": "Mat 3:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabagosoje urutaro ku marembo y’igihugu; nabakūyekw ibibondo, mponnya abantu banje: ariko ntibāhindukira ngo bave mu nzira zabo mbi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.7",
            "verseOrgIds": [
              "JER.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abapfakazi babo baragwiriye kurusha umusenyi wo ku kiyaga imbere yanje: nabagomoreye abanyazi ku murango w’amashōka, ngomoreye nyina w’abahungu; namusutseko giturumbuka umubabaro n’ ibiteye ubgoba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.8",
            "verseOrgIds": [
              "JER.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.2.5"
              },
              "items": [
                {
                  "text": "1 Sam 2:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.8.9"
              },
              "items": [
                {
                  "text": "Am 8:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugore yavyaye ndwi arahondobereye, aregutse; izuba ryiwe ryacokeye hakiri ku murango; aratēterewe, aramāramāye; amasigarira yabo nzoyagaburira inkota imbere y’ abansi babo, ni jewe Uhoraho mbivuze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.9",
            "verseOrgIds": [
              "JER.15.9"
            ]
          }
        }
      ]
    },
