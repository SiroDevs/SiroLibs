              "type": "text"
            }
          ]
        },
        {
          "text": "mbere nzobatanga batererekanywe irya n’ino mu bihugu vy’abami bose bo mw isi, ngo mbagirire nabi; bazoba igitutsi n’iciro ry’imigani n’agatwengo n’ ibivume, ahantu hose aho nzobirukanira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.9",
            "verseOrgIds": [
              "JER.24.9"
            ]
          }
        },
        {
