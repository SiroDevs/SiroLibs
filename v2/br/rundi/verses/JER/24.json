        },
        {
          "text": "Kuko nzobashirakw ijisho kugira ngo mbagirire neza, kandi nzosubira kubagarukana mur’ iki gihugu: nzobubaka, sinzobasambura; nzobatēragira, sinzobarandura. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.6",
            "verseOrgIds": [
              "JER.24.6"
            ]
          }
        },
