              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzobaha umutima wo kummenya yuko nd’ Uhoraho: bazoba abantu banje, nanje nzoba Imana yabo, kuko bazongarukanak’ umutima wabo wose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.24.7",
            "verseOrgIds": [
              "JER.24.7"
            ]
          }
        },
