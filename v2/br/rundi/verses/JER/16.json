            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nuko rero ngw Azobirukana abakūre mur’ iki gihugu, muje mu gihugu mutigeze kumenya, mwebge canke ba sogokuruza banyu; muzohasabira izindi mana ku murango no mw ijoro; ngo Kukw atazobahangaza na gatoya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.13",
            "verseOrgIds": [
              "JER.16.13"
            ]
          }
        }
      ]
    },
