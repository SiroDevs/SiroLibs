            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Uhoraho agize, ngw Imisi izoza ntibazoba bakirahira uguhoraho kwanje jewe Uhoraho ko nakūye Abisirayeli mu gihugu ca Egiputa, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.16.14",
            "verseOrgIds": [
              "JER.16.14"
            ]
          }
        },
        {
