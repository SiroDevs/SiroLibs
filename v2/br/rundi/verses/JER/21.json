          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.32.5"
              },
              "items": [
                {
                  "text": "Yer 32:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.37.10"
              },
              "items": [
                {
                  "text": "37:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "mut’ Uku ni k’Uhoraho agize, ni we Mana y’Abisirayeli, at’ Ehe nzobakubiranya hamwe n’ibirwanishwa biri mu maboko yanyu, ivyo murwanisha umwami w’i Babuloni n’Abakaludaya babugarije, muriko murabarwanisha inyuma y’inzitiro z’iki gisagara, mbakoranirize hamwe hagati muri co. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.4",
            "verseOrgIds": [
              "JER.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 21:5"
          },
          "items": [
