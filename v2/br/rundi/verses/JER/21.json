              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yeremiya arabishura, at’ Uku abe ari ko mubarira Zedekiya: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.3",
            "verseOrgIds": [
              "JER.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
