            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "muti Basigurize Uhoraho; kuko Nebukadineza umwami w’i Babuloni ateye: kumbure Uhoraho yotugirira nk’ukw ibikorwa vyiwe vyose vy’igitangaza bimeze, agatuma asubira inyuma akatureka.",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.2",
            "verseOrgIds": [
              "JER.21.2"
            ]
