        },
        {
          "text": "Kandi nanje ubganje nzobarwanya, mbarwanishe ukuboko kubānguye n’ukuboko kw’inkomezi, ndi n’ishavu n’ubushangashirwe n’uburake bg’inkazi. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.21.5",
            "verseOrgIds": [
              "JER.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
