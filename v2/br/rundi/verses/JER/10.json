              },
              "items": [
                {
                  "text": "Zab 42:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ Uhoraho ni we Mana y’ukuri; ni we Mana nzima, n’Umwami yamaho ibihe bidashira: uburake bgiwe buhindisha isi agashitsi, kand’ amahanga ntashobora kwihanganira ubushangashirwe bgiwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.10",
            "verseOrgIds": [
              "JER.10.10"
            ]
          }
        }
