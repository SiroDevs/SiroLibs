              "type": "text"
            }
          ]
        },
        {
          "text": "Ben’ ivyo bishushanyo bisa n’ibikanganyoni bishinzwe mu mirima, bitazi kuvuga: bikwiye guterurwa kuko bidashobora kwijana. Ntimukabitinye; kuko bidashobora gukora ikibi, canke ngo bibashe gukora iciza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.5",
            "verseOrgIds": [
              "JER.10.5"
            ]
          }
        },
        {
          "name": "verse",
