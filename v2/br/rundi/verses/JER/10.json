              "type": "text"
            }
          ]
        },
        {
          "text": "Nta gihwanye nawe, Uhoraho, kuk’ uhambaye, kand’ izina ryawe rikaba irihambaye kubg’ ububasha bgawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.6",
            "verseOrgIds": [
              "JER.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
