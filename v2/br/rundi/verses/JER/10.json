                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe jewe ndagowe, ndatonekaye! Uruguma rwanje rurambabaje: maze ndavuga, nt’ Ereg’ aya n’amagorwa nyene, nkwiye gupfa kuyihanganira. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.19",
            "verseOrgIds": [
