            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho, nzi yukw inzira umuntu yogenderamwo atari we ashobora kuyigaba; ntibiri mu muntu agenda kwitunganiriza intambuko ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.23",
            "verseOrgIds": [
