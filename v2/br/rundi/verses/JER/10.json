            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihema ryanje rirononekaye, imigozi yose iracitse; abana banje bamvuyeko, ntibakiriho: nta wugisigaye wo kwagura ihema ryanje, ngw abambe ibihuzu vyaryo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.20",
            "verseOrgIds": [
              "JER.10.20"
            ]
          }
        },
