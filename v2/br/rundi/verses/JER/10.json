            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho, umpane, ariko bitarenze urugero: ntumpanane ishavu, ng’ uhave unzimiriza. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.24",
