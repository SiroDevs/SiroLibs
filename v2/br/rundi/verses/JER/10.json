                "loc": "ISA.40.19"
              },
              "items": [
                {
                  "text": "Yes 40:19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.40.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
