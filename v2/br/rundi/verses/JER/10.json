        },
        {
          "text": "Ni mwumve ijambo Uhoraho ababgira, yemwe ab’ inzu ya Isirayeli: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.1",
            "verseOrgIds": [
              "JER.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "uku ni k’Uhoraho agize, ati Ntimukige ingeso z’amahanga, ntimugahagarikwe imitima n’ivyitwa imbitsi ziboneka mw ijuru, kukw ari zo zihagarika amahanga imitima. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.2",
            "verseOrgIds": [
              "JER.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 10:3"
          },
          "items": [
