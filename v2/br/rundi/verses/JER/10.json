            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoresha ifeza zātabatabge zavuye i Tarushishi, n’izahabu zavuye i Ufazi, ibikorwa vy’umuhinga, n’ivy’ amaboko y’umucuzi w’izahabu; bavyambika impuzu z’amasufe n’iz’ inyambarabami; vyose n’ibikorwa vy’abahinga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.9",
            "verseOrgIds": [
              "JER.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 10:10"
