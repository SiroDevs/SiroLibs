          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.22"
              },
              "items": [
                {
                  "text": "Yer 5:22",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.15.4"
              },
              "items": [
                {
                  "text": "Ivyah 15:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde atogutinya ga Mwami w’amahanga? kuko bikubereye; kuko mu banyabgenge bose bo mu mahanga, uko bāgatsindaje kwose nk’abami, ata wuhwanye nawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.7",
            "verseOrgIds": [
              "JER.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bose uko bangana n’ibiyingiyingi n’ibipfu; ukwigisha kw’igishushanyo guhwanye n’igiti buti. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.8",
            "verseOrgIds": [
              "JER.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
