              },
              "items": [
                {
                  "text": "41:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw imigenzo y’amahanga ar’ iy’ ubusa: baca igiti co mu kibira, amaboko y’umuhumbizi akagitunganisha incabiti. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.3",
            "verseOrgIds": [
              "JER.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagisakara ifeza n’izahabu; bakagikomeresha imisumari n’inyundo, ngo coye kunyiganyiga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.4",
            "verseOrgIds": [
              "JER.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
