            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ ukw ari k’Uhoraho agize, at’ Eh’ ababa mu gihugu iki gihe nzobashiburira kure, nzobababaza kugira ngo bibonereko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.10.18",
            "verseOrgIds": [
