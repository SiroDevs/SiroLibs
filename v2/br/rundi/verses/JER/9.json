                {
                  "text": "12:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngira ndirire imisozi ndayiborogere, ncurire akanihiro amātsi yo mu biyaya, kuko haturiwe, ata wukihaca, kand’ ata wucumva kwābagirana kw’amasho; inyoni zo mu kirēre bo n’ibikōko birahunze, biragiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.10",
            "verseOrgIds": [
              "JER.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 9:11"
          },
          "items": [
