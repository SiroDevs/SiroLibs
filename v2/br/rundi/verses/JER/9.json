                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.34.22"
              },
              "items": [
                {
                  "text": "34:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ i Yerusalemu nzohahindura ibirundo vy’amasakamburira, n’i wabo w’imbgebge; kandi n’ibisagara vy’i Buyuda nzobihindura amatongo, ata wukihaba. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.11",
            "verseOrgIds": [
              "JER.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.107.43"
              },
              "items": [
                {
                  "text": "Zab 107:43",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.23.18"
              },
              "items": [
                {
                  "text": "Yer 23:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.14.9"
              },
              "items": [
                {
                  "text": "Hos 14:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde munyabgenge yotahura ivyo? Kandi ni nde yabibariwe n’akanwa kanje, jewe Uhoraho, kugira ngw avyamamaze? N’iki gitumye igihugu cononekara kigasha uburimbi nk’ubugaragwa, ntihabe hakigira ūhaca?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        }
      ]
    },
