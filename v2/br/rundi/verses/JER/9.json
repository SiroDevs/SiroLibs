                  "text": "Yer 3:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko bakagendera mu budadarare bg’imitima yabo, bagakurikira Bayali, nk’uko ba sekuruza bābigishije: ",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.14",
            "verseOrgIds": [
              "JER.9.14"
            ]
          }
