          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.25.2"
              },
              "items": [
                {
                  "text": "Yes 25:2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.10.22"
              },
              "items": [
                {
                  "text": "Yer 10:22",
