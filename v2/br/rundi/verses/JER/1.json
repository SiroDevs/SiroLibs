                {
                  "text": "10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntuz’ ugire ubgoba kubgabo, kuko nzoba ndi kumwe nawe ngo nkurokore, ni jewe Uhoraho mbivuze. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.8",
            "verseOrgIds": [
              "JER.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.6.7"
              },
              "items": [
                {
                  "text": "Yes 6:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.2.9"
              },
              "items": [
                {
                  "text": "Ezk 2:9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ Uhoraho arāmvura ukuboko ankora ku munwa; Uhoraho arambarira, at’ Ehe nshize amajambo yanje mu kanwa kawe. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.9",
            "verseOrgIds": [
              "JER.1.9"
            ]
          }
        },
        {
