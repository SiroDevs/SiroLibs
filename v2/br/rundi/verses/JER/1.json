            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rāba uyu musi ngushizeho kugira ubushobozi ku mahanga no ku bihugu vy’abami, bgo kurandura no gusangangura, guhonnya no gukomvomvora, bo n’ukwubaka no guteragira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
