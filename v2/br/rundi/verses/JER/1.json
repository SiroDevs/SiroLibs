                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ ijambo ry’Uhoraho rinzako ubugira kabiri, rit’ Ubonye iki? Ndavuga, nti Mbona inkono ibiragira; kand’ umuhuro w’imbere werekeye i burārūko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ Uhoraho arambarira, at’ I burārūko hazoturuka ivyago bizoza biziye ababa mu gihugu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
