              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw ijambo ry’Uhoraho rinzako, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.4",
            "verseOrgIds": [
              "JER.1.4"
            ]
          }
        },
        {
