                {
                  "text": "Yer 32:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amajambo ya Yeremiya mwene Hilukiya, wo mu baherezi bāba muri Anatoti mu ntāra ya Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Abam 22:1—23:30",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.3"
              },
              "items": [
                {
                  "text": "Yer 25:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’Uhoraho riza kuri we mu mwaka ugira icumi na gatatu Yosiya mwene Amoni, umwami w’i Buyuda, ari ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Abam 23:34—24:6; 24:17—25:11",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.25.1"
              },
              "items": [
                {
                  "text": "Yer 25:1",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.39.2"
              },
              "items": [
                {
                  "text": "39:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ryongera kuza no ku ngoma ya Yehoyakimu mwene Yosiya, umwami w’i Buyuda, gushitsa no kw iherezo ry’umwaka ugira icumi na rimwe Zedekiya mwene Yosiya, umwami w’i Buyuda, ari ku ngoma; rishitsa n’igihe ab’ i Yerusalemu bājanywe kw inyagano mu kwezi kwa gatanu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
    {
