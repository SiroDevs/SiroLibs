            "sid": "LUK 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatozakori bose n’abanyavyaha bāriko baramwēgēra, ngo bamwumve. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.1",
            "verseOrgIds": [
              "LUK.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.5.30"
              },
              "items": [
                {
                  "text": "Luk 5:30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo n’abanyabgenge b’ivyanditswe barīdodomba, bat’ Uyo yiyegereza abanyavyaha, agasangira na bo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.15.2",
            "verseOrgIds": [
              "LUK.15.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 15:2"
          },
          "items": [
            {
              "text": "2",
