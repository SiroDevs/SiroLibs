          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi hāriho Ana, uwavugishwa n’Imana, umukobga wa Fanuweli, wo mu muryango wa Asheri, yar’ umutāmakazi wa kera, yabanye n’umugabo wiwe imyaka ndwi, uhereye ku kurongorwa kwiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.36",
            "verseOrgIds": [
              "LUK.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
