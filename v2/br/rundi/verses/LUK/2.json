                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ uno mwana arakura, agwiza inkomezi, yuzuzwa ubgenge, ubuntu bg’Imana bgari kuri we.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.40",
