              "items": [
                {
                  "text": "49:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muri Yerusalemu hār’ umuntu yitwa Simeyoni; uyo yar’ umuntu agororotse kandi yubaha Imana, yar’ arorereye uguhumurizwa kw’Abisirayeli, Mpwemu Yera yari kuri we. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.25",
            "verseOrgIds": [
              "LUK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yari yarabgiwe na Mpwemu Yera yukw atazopfa, atarabona Kristo w’Umwami Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.26",
            "verseOrgIds": [
              "LUK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ajanwa na Mpwemu mu rusengero; abavyeyi bajanye uwo mwana Yesu ngo bamugenze nk’uk’ umugenzo w’ivyagezwe war’ uri, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.27",
            "verseOrgIds": [
              "LUK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "aramwākira, aramukikira, ashima Imana,",
          "type": "text",
          "attrs": {
