            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.13.15"
              },
              "items": [
                {
                  "text": "15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nk’uko vyanditswe mu vyagezwe n’Umwami Imana, ng’ Umuhungu wese w’ubuzibūra aze yitwe uwera k’Uhoraho; ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.23",
            "verseOrgIds": [
              "LUK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.5.11"
              },
              "items": [
                {
                  "text": "Lew 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.12.8"
              },
              "items": [
                {
                  "text": "12:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi ngo batange ikimazi, nk’uko vyavuzwe mu vyagezwe n’Umwami Imana, ngw Intunguru zibiri cank’ ivyana vy’inuma bibiri.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.24",
            "verseOrgIds": [
              "LUK.2.24"
            ]
          }
        }
