                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ imisi munani ishitse ngw akebge, bamwita YESU, rya zina ryavuzwe n’umumarayika, atarasamwa inda.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.21",
