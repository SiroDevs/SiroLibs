          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Banonosoye vyose nk’ukw ivyagezwe n’Umwami Imana bivuga, basubira i Galilaya mu gisagara cabo i Nazareti. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.39",
            "verseOrgIds": [
              "LUK.2.39"
            ]
          }
        },
        {
          "name": "verse",
