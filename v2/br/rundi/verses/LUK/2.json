                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisi ishize yo guhumanurwa kwabo, nk’ukw ivyagezwe vya Mose biri, bamujana i Yerusalemu kumushikanira Umwami Imana, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.22",
            "verseOrgIds": [
              "LUK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
