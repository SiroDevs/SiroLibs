          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.16",
            "verseOrgIds": [
              "LUK.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
