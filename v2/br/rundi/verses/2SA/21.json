              "2SA.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Abafilisitiya bongera gutera Abisirayeli. Dawidi amanukana n’ingabo ziwe, arwanya Abafilisitiya; arateba araruha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.15",
            "verseOrgIds": [
              "2SA.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ishubi‐benobu, umwe wo mu bana b’Abarefa, yagomba kwica Dawidi; kand’ icumu ryiwe ryar’ iry’ umuringa ririvye shekeli amajana atatu, yari yambaye n’inkota nsha. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.16",
            "verseOrgIds": [
              "2SA.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 21:17"
