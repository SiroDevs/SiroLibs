              },
              "items": [
                {
                  "text": "2 Sam 9:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arik’ umwami Dawidi arēngāna Mefibosheti mwene Yonatani umwuzukuru wa Sauli, kubg’ indahiro bārahiriye imbere y’ Uhoraho, bo na Yonatani nyene, mwene Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.7",
            "verseOrgIds": [
              "2SA.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.18.19"
              },
              "items": [
                {
                  "text": "1 Sam 18:19",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.3.7"
              },
              "items": [
                {
                  "text": "2 Sam 3:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami afata abahungu babiri ba Risipa umukobga wa Aya, yavyaranye na Sauli, Arumoni na Mefibosheti, bo n’abahungu batanu ba Merabu umukobga wa Sauli, yavyaranye na Aduriyeli mwene Baruzilayi Umumeholati; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.8",
            "verseOrgIds": [
              "2SA.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "abagabura mu maboko y’ab’i Gibeyoni; babamanika ku musozi imbere y’ Uhoraho; bose ukw ar indwi bagwa hamwe, bicwa mw ishuza ry’ igenya, batanguye kugenya sayiri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.9",
            "verseOrgIds": [
              "2SA.21.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Risipa umukobga wa Aya ahitana amagunira, ayīsasira ku gitandara, ahēra mw ishuza ry’ igenya, ashitsa ku mutasuro, imvura iguye kur’ iyo mivyimba; ku murango ntiyakundira ibisīga vyo mu kirēre ko biyigwako, canke mw ijoro kw ibikōko vyo mw ishamba biyēgēra. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.10",
            "verseOrgIds": [
              "2SA.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze babarira Dawidi ivyo Risipa yakoze, umukobga wa Aya, incoreke Sauli yari yaragize umugore. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.11",
            "verseOrgIds": [
              "2SA.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.31.10+1SA.31.11+1SA.31.12+1SA.31.13"
              },
              "items": [
                {
                  "text": "1 Sam 31:10-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.2.4"
              },
              "items": [
                {
                  "text": "2 Sam 2:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi araheza aragenda yaka abantu b’i Yabeshi‐gileyadi amagufa ya Sauli n’aya Yonatani umuhungu wiwe, ayo bāri bārīvye mu kibuga c’i Beti‐shani, ah’ Abafilisitiya bari barayamanitse, kuri wa musi bātsinda Sauli i Gilibowa. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.12",
            "verseOrgIds": [
              "2SA.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akūray’ ayo magufa yabo, maze bakoranya n’amagufa ya ba bandi bamanitswe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.13",
            "verseOrgIds": [
              "2SA.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.24.25"
              },
              "items": [
                {
                  "text": "2 Sam 24:25",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bahamba ayo magufa ya Sauli na Yonatani umuhungu wiwe i Sela mu gihugu c’Ababenyamini, mu mva ya Kishi se wa Sauli; nuko bashitsa ivy’ umwami yababariye vyose. Hanyuma y’ivyo Imana ibona guhangaza ico gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.14",
            "verseOrgIds": [
              "2SA.21.14"
            ]
          }
        }
      ]
    },
    {
