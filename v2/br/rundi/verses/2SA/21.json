            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.11.4"
              },
              "items": [
                {
                  "text": "11:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni muduhe abantu ndwi mu bahungu biwe, tubamanike imbere y’Uhoraho i Gibeya, ahāri kwa Sauli uwo Uhoraho yatoranije. Umwami arabishura, ati Nzobabaha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.21.6",
            "verseOrgIds": [
              "2SA.21.6"
            ]
          }
        }
