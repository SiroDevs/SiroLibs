                  "text": "Ita 24:67",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.37.35"
              },
              "items": [
                {
                  "text": "37:35",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma umwami Dawidi amugirira inkumbu nyinshi, kuko yar’ amaze gushira umubabaro w’urupfu rwa Amunoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.39",
