                  "text": "2 Sam 18:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Abusalomu yari yahunze. Maz’ umuhungu yar’ ashibamye, yunamuye amaso, abona haje abantu benshi, baturutse mu nzira iva i Horonayimu ikikamanye umusozi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.34",
            "verseOrgIds": [
              "2SA.13.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 13:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yonadabu abarira umwami, at’ Eh’ abana bawe baraje; nk’uko jewe umusavyi wawe nabivuze, ni ko bibaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.35",
            "verseOrgIds": [
              "2SA.13.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 13:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akirangiza kuvuga, abana b’ umwami barashika, maze baraturikisha bararira; n’umwami na we nyene n’abantu biwe bose bararira baraboroga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.13.36",
            "verseOrgIds": [
              "2SA.13.36"
            ]
          }
        }
      ]
    },
