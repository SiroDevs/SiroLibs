        },
        {
          "text": "Kandi Dawidi yimye amaze imyaka mirongwitatu avutse; amara imyaka mirongwine ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.4",
            "verseOrgIds": [
