            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:1",
              "type": "text"
            },
            {
              "text": "Mu Giheburayo ngo Tur’ igufa ryawe n’umubiri wawe.",
              "type": "text"
            }
