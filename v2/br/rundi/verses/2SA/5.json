          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "na Ibuhari na Elishuwa na Nefegi na Yafiya, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.15",
            "verseOrgIds": [
              "2SA.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
