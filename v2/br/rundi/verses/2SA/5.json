            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi yābīrira i Yerusalemu abandi bamikazi, ahagirira n’izindi ncoreke zimeze bga bagore, amaze kwimukirayo avuye i Heburoni, yongera kuvyara abandi bana b’abahungu n’abakobga. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.13",
