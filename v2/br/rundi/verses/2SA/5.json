            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye Hiramu umwami w’i Tiro atuma intumwa kuri Dawidi, arungika n’ibiti vy’amasederi n’ ababāji n’abubatsi, bubakira Dawidi ingoro. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.5.11",
            "verseOrgIds": [
              "2SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
