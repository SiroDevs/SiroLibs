        },
        {
          "text": "Bukeye Dawidi arabaza, ati Mbega har’ agasigarira mu nzu ya Sauli koba kakiriho, kugira ngo ndamugirire neza kubga Yonatani? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
