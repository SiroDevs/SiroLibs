                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwa kane ni Adoniya, uwo yavyaye kuri Hagita; uwa gatanu ni Shefatiya, uwo yavyaye kuri Abitali; ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
