              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe c’intambara y’ab’ inzu ya Sauli n’ab’ iya Dawidi, Abuneri yari yīgize agakomeye mu rugo rwa Sauli. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
