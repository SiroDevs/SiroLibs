          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwa gatandatu ni Itureyamu, uwo yavyaye ku wundi mugore wiwe yitwa Egila. Abo ni bo Dawidi yavyariye i Heburoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
