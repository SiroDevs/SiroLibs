              "items": [
                {
                  "text": "1 Abam 11:37",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Abuneri abarira Dawidi, ati Hinge ngende, ngagamure Abisirayeli bose baze ah’ uri, mwami wanje nyen’ ingoma, kugira ngo basezerane nawe, ubone kubaganza bose nk’uk’ ugomba. Nuko Dawidi arekura Abuneri, agenda amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
