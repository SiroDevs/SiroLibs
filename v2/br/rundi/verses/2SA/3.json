                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.22"
              },
              "items": [
                {
                  "text": "1 Abam 2:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Sauli yar’ afise incoreke yari yaragize umugore, yitwa Risipa, umukobga wa Aya; bukeye Ishibosheti abaza Abuneri, ati N’iki catumye winjirana muka data? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.17.43"
              },
              "items": [
                {
                  "text": "1 Sam 17:43",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo majambo ya Ishibosheti ashavuza Abuneri cane; aramwishura, ati Mbeg’ ugira ngo nd’imbga y’i Buyuda? Ko nagiriye neza ab’ inzu ya so Sauli na bene wabo n’abakunzi biwe, nawe sinkugabure mu maboko ya Dawidi; non’ ugapfa kunyagiriza icaha ku mugore gusa? ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
