                "loc": "JDG.20.1"
              },
              "items": [
                {
                  "text": "Abac 20:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngakūra ingoma mu nzu ya Sauli, nkayegurira Dawidi, ngatuma ingoma yiwe ihangama mu Bisirayeli no mu Bayuda, uhereye i Dani ugashitsa i Beri‐sheba. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ishibosheti ntiyaronka irindi na rimwe yishura Abuneri, kuko yamutinya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        }
