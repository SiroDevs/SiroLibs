              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo mugabo wiwe aramuherekeza, agenda ararira inzira yose, arinda amushikana i Bahurimu. Ashitseyo, Abuneri aramubarira, ati Hogi subira inyuma; nukw aca asubira inyuma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
