          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abuneri bamuhamba i Heburoni, umwami araturikisha aririra ku mva ya Abuneri; abantu bose bararira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
