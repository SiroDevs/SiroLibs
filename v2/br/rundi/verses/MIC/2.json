            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewe Yakobo! Sinzobura gukoraniriza abawe bose hamwe, kandi sinzobura kwegeranya amasigarira y’Abisirayeli; nzobakumakumira hamwe nk’intama z’i Bosira; bazohūrīra nk’umukuku uri mwinshi mu canya cawo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.12",
            "verseOrgIds": [
              "MIC.2.12"
            ]
          }
        },
