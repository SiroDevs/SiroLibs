              "items": [
                {
                  "text": "Am 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bavuga, ngo Ntimukavugishwe! Bati Ntihaze hagire abavugishwa ben’ ivyo! Yamar’ ibimāramāza ntibizovaho. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.6",
            "verseOrgIds": [
              "MIC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe ab’ inzu ya Yakobo, vyoshoboka kuvugwa, ngo Mbega Mpwemu w’Uhoraho yoba ikirandamuke? Ugira ngw ivyo yobikora? Mbeg’ amajambo yanje ntafitiye ikimazi ūgenda atunganye? ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.7",
            "verseOrgIds": [
              "MIC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.28.8"
              },
              "items": [
                {
                  "text": "2 Ngo 28:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mur’ ibi bihe abantu banje mumpagurukiye nk’abansi: abagenda ata co bīnona, batagomba intambara, mubakiza imitamana basēsa hejuru y’izindi. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.8",
            "verseOrgIds": [
              "MIC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagore bo mu bantu banje mubirukana mu mazu yabo bakunda; abana babo bato icubahiro nabahaye mwakibakūyeko gushitsa ibihe bidashira. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.9",
            "verseOrgIds": [
              "MIC.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.25"
              },
              "items": [
                {
                  "text": "Lew 18:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.12.9"
              },
              "items": [
                {
                  "text": "Gus 12:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HEB.13.14"
              },
              "items": [
                {
                  "text": "Heb 13:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni muhaguruke, mugende; kukw aha atar’ uburuhukiro bganyu, kubg’ ibihumanya bizana gutikira kw’agahebuza. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.10",
            "verseOrgIds": [
              "MIC.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.5.13"
              },
              "items": [
                {
                  "text": "Yer 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.2.12"
              },
              "items": [
                {
                  "text": "Am 2:12",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ereg’ umuntu agendana impwemu y’ ikinyoma, akabesha, ati Nkuboneye vino n’ibinyobga; ni we yoba umuvugishwa kur’ ubu bgoko!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.2.11",
            "verseOrgIds": [
              "MIC.2.11"
            ]
          }
        }
      ]
    },
