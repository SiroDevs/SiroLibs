              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ati Kandi mubarire uwo mwami w’i Buyuda yabatumye gusiguza Uhoraho, mut’ Uku ni k’Uhoraho Imana y’ Abisirayeli agize, ngo Ku vy’ ayo majambo wumvise, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
