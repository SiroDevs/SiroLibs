          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo Kuko watsinzwe mu mutima wawe, ukicisha bugufi imbere yiwe, ari yo Mana, igihe wumva amajambo yavuze ku vy’ aha hantu bo n’ abahaba, ng’ Ukicisha bugufi imbere yiwe, ukītantamurirakw impuzu zawe, ukaririra imbere yiwe, ngo Na we arakwumvise; ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
