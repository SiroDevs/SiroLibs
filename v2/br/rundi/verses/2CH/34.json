              "2CH.34.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.22.3+2KI.22.4+2KI.22.5+2KI.22.6+2KI.22.7+2KI.22.8+2KI.22.9+2KI.22.10+2KI.22.11+2KI.22.12+2KI.22.13+2KI.22.14+2KI.22.15+2KI.22.16+2KI.22.17+2KI.22.18+2KI.22.19+2KI.22.20"
              },
              "items": [
                {
                  "text": "2 Abam 22:3-20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu mwaka ugira icumi n’umunani ari ku ngoma, ahejeje gutunganya igihugu n’urusengero, arungika Shafani mwene Asaliya, na Mayaseya umukuru w’umurwa, na Yowa mwene Yowahazi umwanditsi w’ivyaja biraba, ngo baje gusanisha ingoro y’Uhoraho Imana yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.35.8"
              },
              "items": [
                {
                  "text": "2 Ngo 35:8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashikīra Hilukiya umuherezi mukuru, bamushikiriza amahera yazanywe mu ngoro y’ Imana, ayo Abalewi b’abakumirizi bari barakoranije mu Bamanase no mu Befurayimu no mu masigarira yose y’Abisirayeli, no mu Bayuda bose no mu Babenyamini no mu baba i Yerusalemu; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayaha abāshinzwe gukoresha ibikorwa vyo ku ngoro y’Uhoraho, na bo bayahemba abakozi bakora iyo ngoro, kugira ngo bayisanure bayikomeze; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayaha ababāji n’ abubatsi kugira ngo bagure amabuye abājwe n’ibiti vy’imyaro n’ ivy’ ibishoro vyo gusanura inyubako abami b’i Buyuda bononye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nukw abo bantu bakora ico gikorwa ar’ abizigirwa; abābarāba n’aba: Yahati na Obadiya, Abalewi bo mu ba Merari, na Zekariya na Meshulamu bo mu ba Kohati, ni bo bābakoresha; kand’ abandi Balewi bose b’abahinga bazi ivyo kuvuza, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni bo bāgenda barāba ivy’ abikorezi, bagakoresha n’ abandi bose bakora igikorwa ic’ ari co cose; kand’ Abalewi bamwe bār’ abakarani n’abashingantahe n’abakumirizi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bariko barasohora amahera yazanywe mu ngoro y’Uhoraho, Hilukiya umuherezi arenguka ku gitabo c’ivyagezwe vy’ Uhoraho, ivyo Mose yazanye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilukiya abarira Shafani umukarani, ati Ntoye igitabo c’ivyagezwe mu ngoro y’Uhoraho. Hilukiya araheza agiha Shafani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shafani ajana ico gitabo, agishīra umwami, amudondera uko vyagenze, at’ Ivyo abasavyi bawe bāgezweko vyose, bābikoze; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi bābiriye amahera yari mu ngoro y’Uhoraho, bayashikirije abakoresha ibikorwa n’abakozi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mukarani Shafani yongera kubarira umwami, ati Kand’ umuherezi Hilukiya andungikanye igitabo. Nuko Shafani agisomera umwami.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami yumvise amajambo yo mu vyagezwe, yitantamurirakw impuzu ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.26.24"
              },
              "items": [
                {
                  "text": "Yer 26:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami araheza atuma Hilukiya na Ahikamu mwene Shafani na Abudoni mwene Mika n’uwo mukarani Shafani nyene na Asaya umumenyekana wiwe, ",
          "type": "text",
          "attrs": {
