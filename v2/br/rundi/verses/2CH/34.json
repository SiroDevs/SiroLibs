                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umwami atuma gukoraniriza hamwe abakuru bose b’i Buyuda n’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami araheza aradūga, aja ku ngoro y’Uhoraho, bo n’abashingantahe b’i Buyuda bose n’ ababa i Yerusalemu, bo n’abaherezi n’Abalewi n’abantu bose, abahambaye n’aboroshe; abasomera amajambo yose yo mur’ ico gitabo c’isezerano bātoye mu ngoro y’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
