                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.12.15"
              },
              "items": [
                {
                  "text": "2 Ngo 12:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.13.22"
              },
              "items": [
                {
                  "text": "13:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyose vyadonzwe kuri Salomo, uhereye ku ca mbere ugashitsa ku c’imperēra, mbega ntivyanditswe mu vyo Natani uwavugishwa n’Imana yadonze, no mu vyo Ahiya w’i Shilo yavugishijwe, no mu vyo Ido kamenyi yabonye kuri Yerobowamu mwene Nebati? ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo yamaze imyaka mirongwine ari ku ngoma aganza Abisirayeli bose ar’ i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo ahamvya ba sekuruza, bamuhamba ku murwa wa se Dawidi; maz’ umwana wiwe Rehobowamu asubira ku ngoma yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
      ]
