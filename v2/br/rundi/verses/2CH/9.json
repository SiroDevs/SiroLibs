              "2CH.9.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.8.18"
              },
              "items": [
                {
                  "text": "2 Ngo 8:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abantu ba Huramu bo n’aba Salomo bāhora bazana amazahabu bayakūye i Ofiru, bāzanana n’ibiti vyitwa alumugi n’ utubuyenge tw’igiciro kinini. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo biti vya alumugi umwami ni vyo yabājemw’ ivyuririzo vy’ ingoro y’Uhoraho n’ivy’ ingoro yiwe ubgiwe; yabibājemwo n’ inanga n’amakembe vy’abaririmvyi; ntihāri hārīgeze kuboneka ibiti vya alumugi nk’ivyo mu gihugu c’i Buyuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ umwami Salomo aha uwo mwami w’i Sheba ivyo yagomba vyose n’ico amwatse cose, udashizemw’ ivyo yamushubirije mu nkōko ku vyo yamugemuriye. Bukeye uwo mwami arahaguruka, aragenda, asubira mu gihugu ciwe, bo n’abantu biwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
