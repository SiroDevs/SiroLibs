              },
              "items": [
                {
                  "text": "1 Abam 10:1-13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.42"
              },
              "items": [
                {
                  "text": "Mat 12:42",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami w’umugore yaganza i Sheba yumvise ingene Salomo yabaye rurangiranwa, aza azanywe no kumugerageresha ibibazo bigoye; nukw ashika i Yerusalemu agendaniwe n’abantu benshi b’isinzi, afise n’ingamiya zīremētse imibavu n’amazahabu y’itīti, n’utubuyenge tw’igiciro kinini; ashitse kwa Salomo amudondorera ivyari mu mutima wiwe vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Salomo amusobanurira ivyo amubajije vyose; nta kintu na kimwe cāmunaniye kw amusobanurira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuk’ uwo mwami w’i Sheba abonye ingene Salomo ar’ umunyabgenge, n’ ingoro yubatse ukw imeze, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ ivyo kurya vyo ku meza yiwe ukuntu vyari, n’abo mu rugo rwiwe uko bīfata, n’abasuku biwe uko bahēreza, n’ukuntu bambaye, bo n’abakevyi biwe bamuhēreza igiturire, n’ukuntu bambaye, n’ ibimazi vyo kwosa yatanga mu ngoro y’Uhoraho, arajorerwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarira umwami, at’ Inkuru numvise ndi mu gihugu canje z’ ibikorwa vyawe n’ubgenge bgawe, zar’ iz’ ukuri. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko sinari navyemeye gushitsa nīyiziye, nkavyibonera n’amaso yanje. Ereg’ ivyo bāmbariye vy’ingen’ ufise ubgenge buhebuje ntibishika n’ agace k’ivyo mbonye: ivyawe bisumba uko navyumvise. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hahirwa abantu bawe, hahirwa n’aba bagendanyi bawe bama imbere yawe bakumva ubgenge bgawe! ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.23"
              },
              "items": [
                {
                  "text": "1 Ngo 29:23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.2.11"
              },
              "items": [
                {
                  "text": "2 Ngo 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho Imana yawe ahimbazwe, yagushimye akagushira ku ngoma yiwe, ng’ ube umwami, umutwarire. Imana yawe ko yakunze Abisirayeli, ikabakomeza gushitsa ibihe vyose, ni co catumye ikwimika ng’ ube umwami wabo, kugira ng’ uce izibereye n’ iziroranye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ aha umwami izahabu italanto ijana na mirongwibiri, amuha n’imibavu myinshi y’isinzi, n’utubuyenge tw’ igiciro kinini; ntihongeye kuboneka imibavu isa n’iyo uwo mwami w’i Sheba yahaye umwami Salomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
