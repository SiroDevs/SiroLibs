              "items": [
                {
                  "text": "1 Pet 1:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mugende mwubaha Uhoraho, mwiyubare mu vyo mukora; kuk’ Uhoraho Imana yacu ata kugabitanya kuri muri we, canke gutinya ijunja ry’umuntu, canke kurya ingurire.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.7",
            "verseOrgIds": [
              "2CH.19.7"
            ]
          }
        }
