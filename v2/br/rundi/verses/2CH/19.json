                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze basubiye i Yerusalemu, Yehoshafati ahashira bamwe mu Balewi n’abaherezi n’abakuru bo mu mazu ya ba sekuruza b’Abisirayeli, ngo babe abo guca imanza mw izina ry’Uhoraho no gutātūra abantu mu vyo bapfa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.8",
            "verseOrgIds": [
              "2CH.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.23.3"
              },
              "items": [
                {
                  "text": "2 Sam 23:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.8.61"
              },
              "items": [
                {
                  "text": "1 Abam 8:61",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arababgira, ati Muze mugenze murtyo, mwubashe Uhoraho, mur’ abizigirwa, mufise imitima itunganye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.9",
            "verseOrgIds": [
              "2CH.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi bagenzi banyu baba mu bisagara vyabo, ni babagīsha inama zikoma ku vy’uwishe uwundi, canke ku vyagezwe canke ku mabgirizwa canke ku vyashinzwe canke ku matēka, muze mubereke uko bakwiye kubigenza, kugira ngo ntibaze bacumure k’ Uhoraho, mukīhamagarira uburake, mwe n’abo bagenzi banyu. Nuko muze mugenze murtyo, kugira ngo ntimucumure. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.10",
            "verseOrgIds": [
              "2CH.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.6.11"
              },
              "items": [
                {
                  "text": "1 Ngo 6:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu manza zose zikoma ku vy’Uhoraho, Amariya umuherezi mukuru ni we azoba kamaramagambo muri mwebge, na zo mu manza zose zikoma ku vy’igihugu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "19:11",
              "type": "text"
            },
            {
              "text": "ku vy’igihugu",
              "type": "text"
            },
            {
              "text": ": mu Giheburayo handitswe, ngo Ku vy’umwami.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kamaramagambo ni Zebadiya mwene Ishimayeli, umukuru wo mu muryango wa Yuda; kand’ Abalewi bazoba abashingantahe banyu. Nuko ni mukovye, mukore, kand’ Uhoraho az’ abane n’ūca iziroranye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.11",
            "verseOrgIds": [
              "2CH.19.11"
            ]
          }
        }
