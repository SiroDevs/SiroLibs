              "items": [
                {
                  "text": "Ezr 7:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugabo harih’ ivyiza bimwe bikubonekako, kuko wakūye mu gihugu inkingi zāshingiwe Ashera, ugashira umutima ku kurondera Imana.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.3",
            "verseOrgIds": [
              "2CH.19.3"
            ]
          }
        }
      ]
    },
    {
