            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yehu mwene Hanani kamenyi aja kumusanganira; abaza umwami Yehoshafati, at’ Aho war’ ukwiye gutabara abanyakibi, ugakunda abanka Uhoraho? Kubg’ ivyo wikwegeye uburake bg’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.19.2",
            "verseOrgIds": [
              "2CH.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 19:3"
          },
