            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.11.1+2KI.11.2+2KI.11.3"
              },
              "items": [
                {
                  "text": "2 Abam 11:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Ataliya nyina wa Ahaziya abonye k’umwana wiwe Ahaziya apfuye, arahaguruka ageseza abo mu nda y’ingoma y’i Buyuda bose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.10",
            "verseOrgIds": [
              "2CH.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yehoshabeyati umukobga w’umwami afata Yowasi mwene Ahaziya, amukūra mu bana b’umwami bariko baricwa, amushira mu cumba kibīkwamw’ amariri, hamwe n’umurezi wiwe. Uko ni ko Yehoshabeyati, umukobga w’umwami Yehoramu, muka Yehoyada umuherezi, mushiki wa Ahaziya, yamunyegeje Ataliya, kugira ngo ntamwice. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.11",
            "verseOrgIds": [
              "2CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ amarana na bo imyaka itandatu, anyegejwe mu ngoro y’ Imana; Ataliya na we aba ari we aganza igihugu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.12",
            "verseOrgIds": [
              "2CH.22.12"
            ]
          }
        }
      ]
