              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Ahaziya kuja kurāba Yoramu vyari bivuye ku Mana, kugira ngw agweyo; kukw ashitseyo yajanye na Yoramu kuja guhūra na Yehu mwene Nimushi, uwo Uhoraho yari yimikishije amavuta, kugira ngw ahenebereze inzu ya Ahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.7",
            "verseOrgIds": [
              "2CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.10.11+2KI.10.12+2KI.10.13+2KI.10.14"
              },
              "items": [
                {
                  "text": "2 Abam 10:11-14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ igihe Yehu yarikw arashitsa itēka ryāciriwe inzu ya Ahabu, asanga abaganwa b’i Buyuda bājeho, n’abahungwabo ba Ahaziya bāmugendako, arabica. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.8",
            "verseOrgIds": [
              "2CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.27"
              },
              "items": [
                {
                  "text": "2 Abam 9:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.17.4"
              },
              "items": [
                {
                  "text": "2 Ngo 17:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arondera Ahaziya, bamufatira aho yari yinyegeje i Samariya, bamushīra Yehu, baramwica; baraheza baramuhamba, kuko bāvuga, bati N’ umwuzukuru wa Yehoshafati yarondeza Uhoraho umutima wiwe wose. Maze mu nzu ya Ahaziya ntihāsigaramwo ūshoboye kuganza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.22.9",
            "verseOrgIds": [
              "2CH.22.9"
            ]
          }
        }
      ]
    },
