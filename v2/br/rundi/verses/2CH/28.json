                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ahazi ahamvya ba sekuruza, bamuhamba ku murwa w’i Yerusalemu, kuko batāmuhamvye mu mva z’abami b’i Buyuda;",
          "type": "text",
          "attrs": {
