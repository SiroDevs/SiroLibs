                "loc": "2KI.16.7"
              },
              "items": [
                {
                  "text": "2 Abam 16:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.8"
              },
              "items": [
                {
                  "text": "8",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe umwami Ahazi atuma ku mwami w’i Ashuri ngw amutabare, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.16",
            "verseOrgIds": [
              "2CH.28.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 28:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukw Abanyedomu bāri bongeye gutera i Buyuda, bakahanesha, bakajana abaho ar’ inyagano. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.17",
            "verseOrgIds": [
              "2CH.28.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 28:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi n’Abafilisitiya na bo bāri bateye ibisagara vyo mu kiyaya, n’ivy’ i Buyuda bg’i bumanuko, bafata i Beti‐shemeshi, n’i Ayaloni, n’i Gederoti, n’i Sokoho, n’ibisagara bihakūkira, n’i Timuna n’ibisagara bihakūkira, n’i Gimuzo na ho nyene n’ibisagara bihakūkira; baca barahinjira. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.18",
            "verseOrgIds": [
              "2CH.28.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 28:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhoraho yari yacishije Abayuda bugufi, abahōye Ahazi umwami wabo,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "28:19",
              "type": "text"
            },
            {
              "text": "wabo",
              "type": "text"
            },
            {
              "text": ": mu Giheburayo handitswe ngo w’Abisirayeli, ariko n’ukuvuga ubgoko s’ukuvuga igihugu.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kuko yakoze ivy’ isoni nke mu Buyuda, agacumura k’Uhoraho bitangaje. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.19",
            "verseOrgIds": [
              "2CH.28.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 28:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.16.7+2KI.16.8+2KI.16.9"
              },
              "items": [
                {
                  "text": "2 Abam 16:7-9",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Tigulati‐pileseri umwami w’i Ashuri aza kuri we; ariko mu gishingo co kumuremesha amurandura umutima. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.20",
            "verseOrgIds": [
              "2CH.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko Ahazi yābiriye ibintu bimwe vyo mu ngoro y’Uhoraho, no mu ngoro yiwe ubgiwe, no mu mazu y’ abaganwa, akabishikanira umwami w’i Ashuri; ariko ntivyagira ico bimumarira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.21",
            "verseOrgIds": [
              "2CH.28.21"
            ]
          }
        }
      ]
    },
