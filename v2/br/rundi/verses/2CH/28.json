                  "text": "30:14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Ahazi akoranya ibintu vyose vy’imbombovu vyo mu ngoro y’Imana, arabijanjagura, yugara inzugi z’iyo ngoro y’Uhoraho; yiyubakira ibicaniro ahantu hose h’i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.24",
            "verseOrgIds": [
              "2CH.28.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 28:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "No mu gisagara cose c’i Buyuda atabamw’ ibitabo vy’aho kwosereza imibavu izindi mana, atera umwikomo Uhoraho Imana ya ba sekuruza.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.25",
            "verseOrgIds": [
              "2CH.28.25"
            ]
          }
        }
