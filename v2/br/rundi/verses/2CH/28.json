              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ uwo mwami Ahazi nyene, igihe aburaniwe arushiriza kuja imbere gucumura k’ Uhoraho, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.22",
            "verseOrgIds": [
