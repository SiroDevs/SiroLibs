                "loc": "MAT.5.44"
              },
              "items": [
                {
                  "text": "Mat 5:44",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.33"
              },
              "items": [
                {
                  "text": "Luk 10:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.10.34"
              },
              "items": [
                {
                  "text": "34",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ abo bantu bavuzwe amazina barahaguruka, bābīra abo bantu b’inyagano; abāri bambaye ubusa bose bo muri bo babambika ivyo bakūye mu masahu, babaha impuzu n’ inkweto, barabagaburira, babaha n’ivyo kunywa, babasiga amavuta; abananiwe bose muri bo babashira ku ndogoba, babashikana mu b’i wabo i Yeriko, igisagara c’ibigazi; baraheza basubira i Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.28.15",
            "verseOrgIds": [
              "2CH.28.15"
            ]
          }
        }
      ]
    },
    {
