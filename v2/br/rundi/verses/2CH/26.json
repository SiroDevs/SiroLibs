              "2CH.26.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.13"
              },
              "items": [
                {
                  "text": "Neh 3:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.3.19"
              },
              "items": [
                {
                  "text": "19",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uziya yubaka iminara i Yerusalemu kw irembo ryo ku mfuruka y’uruzitiro rwaho rw’ amabuye, no kw irembo rija ku mwonga, no ku yindi mfuruka y’ uruzitiro nyene; iyo minara arayigumya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.9",
            "verseOrgIds": [
              "2CH.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi yubaka iminara no mu bugaragwa, yimbisha n’ivyobo vyinshi vyo kubīka amazi, kuko yar’ afise amasho menshi mu gihugu gishashe no mu biyaya; yar’ afise n’abarimyi n’abazi gutunganya imizabibu mu misozi no mu matongo amera cane, kuko yar’ umurimyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.10",
            "verseOrgIds": [
              "2CH.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi Uziya yar’ afise ingabo z’abarwanyi, bāja kurwana bīcīye ibitero, nk’ukw ibitigiri vyabo vyashinzwe, uko bāharūwe na Yeyeli umukarani na Mayaseya umwanditsi, bāgabga na Hananiya, umwe mu bagabisha b’umwami. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.11",
            "verseOrgIds": [
              "2CH.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitigiri cose c’abakuru b’ amazu ya ba sekuruza, abantu b’ abahizi, bar’ ibihumbi bibiri n’ amajana atandatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.12",
            "verseOrgIds": [
              "2CH.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.25.5"
              },
              "items": [
                {
                  "text": "2 Ngo 25:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abo bāgaba ingabo zigishijwe kurwana, ibihumbi amajana atatu n’ ibihumbi ndwi n’amajana atanu, bārwanana ubuhizi bginshi, barwanira umwami ngo ntāneshwe n’abansi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.13",
            "verseOrgIds": [
              "2CH.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uziya aronderera izo ngabo zose inkinzo n’amacumu, n’inkofero z’ivyuma, n’amakoti y’ivyuma, n’imiheto, n’amabuye atereshwa umugozi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:14",
              "type": "text"
            },
            {
              "text": "Uwo mugozi ni yo mange.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.14",
            "verseOrgIds": [
              "2CH.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ i Yerusalemu ahakoreshereza ibintu vy’intambara vyigenewe n’ abahinga, bifise imishibuka irasa imyampi ikavundereza amabuye manini‐manini, vyo gushirwa ku minara no hejuru ku mfuruka z’ uruzitiro. Izina ryiwe riba rurangiranwa, rirāmāmara, kuko yafashijwe bitangaje, gushitsa aho yabereye agahambaye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.15",
            "verseOrgIds": [
              "2CH.26.15"
            ]
          }
        }
      ]
    },
