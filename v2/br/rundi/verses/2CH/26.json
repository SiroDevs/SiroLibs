                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arikw amaze kuba agahambaye, yishira hejuru mu mutima wiwe, bituma akora ivyo kugabitanya, acumura k’Uhoraho Imana yiwe; kuko yinjiye mu rusengero rw’Uhoraho ngo yosereze imibavu ku gicaniro ihora yoserezwako. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.16",
            "verseOrgIds": [
              "2CH.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Azariya umuherezi aca arinjira amukurikiye, ari kumwe n’abandi baherezi b’Uhoraho mirongumunani, abantu b’abahizi; ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.26.17",
            "verseOrgIds": [
              "2CH.26.17"
            ]
          }
        },
        {
