            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1TH.3.11+1TH.3.12+1TH.3.13"
              },
              "items": [
                {
                  "text": "1 Tes 3:11-13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, Umwami wacu Yesu Kristo ubgiwe, n’Imana Data wa twese, yadukunze, ikaduha kwirurwa imibabaro guhoraho, bo n’ivyizigiro vyiza biheshwa n’ubuntu bgayo, ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.2.16",
            "verseOrgIds": [
              "2TH.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibirure mu mitima yanyu, iyikomeze mu gikorwa cose ciza, n’ijambo ryose ryiza.",
          "type": "text",
          "attrs": {
