            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzoshira ikimenyetso muri bo, abarokotse muri bo nzobatuma mu mahanga, i Tarushishi n’i Puli n’i Ludi mu bafozi b’imiheto, n’i Tubali n’i Yavani, mu baba ku kiyaga kure, aho bataribgumve ko ndi rurangiranwa, ntibabone n’icubahiro canje; maze bazokwīgānira amahanga icubahiro canje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
