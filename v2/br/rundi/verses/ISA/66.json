            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ Uhoraho azocira abantu bose amateka, ayacishe umuriro n’inkota yiwe, kand’ abazokwicwa n’Uhoraho bazoba ari benshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abiyeza bakiyuhagira kugira ngo baje mu bigabiro barōngōye, abarya inyama z’ ingurube n’iz’ ivyikwega hasi n’ imbeba, abo bose bazoshirira icarimwe, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
