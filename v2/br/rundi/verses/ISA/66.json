                  "text": "Zek 14:16",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nzi ibikorwa vyabo n’ ivyiyumviro vyabo. Igihe kigiye kuza nzokoranya amahanga yose n’ab’ indimi zose; bazoza babone ubgiza bganje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        },
        {
          "name": "verse",
