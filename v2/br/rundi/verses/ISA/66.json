            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nk’ukw ijuru risha n’isi nsha, ivyo nzorema, bizohorah’ imbere yanje, ni k’ uruvyaro rwawe n’izina ryawe bizohoraho, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
