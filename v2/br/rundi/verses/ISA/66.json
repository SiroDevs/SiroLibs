            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzorobanuramwo bamwe mbagire abaherezi n’Abalewi, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
