                "loc": "ACT.17.24"
              },
              "items": [
                {
                  "text": "17:24",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, at’ Ijuru ni ryo ntebe yanje y’ubgami, isi na yo n’indava y’ ibirenge vyanje: muzonyubakira inzu ki, kandi n’ahantu ki hombera uburuhukiro? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.14"
              },
              "items": [
                {
                  "text": "1 Ngo 29:14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.34.18"
              },
              "items": [
                {
                  "text": "Zab 34:18",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.15"
              },
              "items": [
                {
                  "text": "Yes 57:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw ivyo vyose intoke zanje ari zo zabiremye, bikabaho vyose, ni k’ Uhoraho agize; arik’ umuntu w’impahazwa afise umutima umenetse, agahindishwa agashitsi n’ ijambo ryanje, uwo ni we nzohozakw ijisho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
