                "loc": "LUK.1.33"
              },
              "items": [
                {
                  "text": "Luk 1:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ho intebe y’ubgami izoshimangirwa n’imbabazi, kandi hazobah’ ūzoyivyagirako mu kuri, mu nzu ya Dawidi, ar’ umucamanza ashishikara izibereye, akabanguka gukora ivy’ ukugororoka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.5",
            "verseOrgIds": [
              "ISA.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
