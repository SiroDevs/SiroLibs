                "loc": "JER.48.30"
              },
              "items": [
                {
                  "text": "30",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twumvise ubgībone bg’i Mowabu, ko hībona cane: twumvise n’ukwishira hejuru kwaho n’ubgībone bgaho n’agakēngērwe kaho: arik’ ukwīrārīra kwaho n’ukw’ ubusa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.6",
            "verseOrgIds": [
              "ISA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo bizotuma Abanyamowabu baborogera Mowabu, umuntu wese azoboroga: muzorizwa n’amarobe y’inzabibu y’i Kiri‐hareseti mwihebuye rwose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.7",
            "verseOrgIds": [
              "ISA.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.32"
              },
              "items": [
                {
                  "text": "Yer 48:32",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kukw imirima y’i Heshiboni iravye, bo n’uruzabibu rw’i Sibuma; abami b’amahanga bāvunaguye amashami yarwo meza‐meza: yar’ ashitse n’i Yazeri, agakakariza mu bugaragwa; amashami yarwo yaragasaye ajabuka n’ikiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.8",
            "verseOrgIds": [
              "ISA.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubg’ ivyo nzoririra uruzabibu rw’i Sibuma, nk’ukw ab’ i Yezeri baruririra. Nzogutotesha amosozi yanje, yewe Heshiboni, nawe Eleyale: kukw akarūru k’intambara kavugiye ku vyeze vyawe vyo mu ci no ku vyimburwa vyawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.9",
            "verseOrgIds": [
              "ISA.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.48.33"
              },
              "items": [
                {
                  "text": "Yer 48:33",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akanyamuneza n’ibihimbaro bīkūwe mw itongo rimera cane; nta kuririmba kuzoba mu ruzabibu, cank’ ijwi ry’umunezero; nta mukānyi azokānyira vino mu bgato: akayego k’abakānyi ndakajibije. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.10",
            "verseOrgIds": [
              "ISA.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umutima wanje ucurira intimba Mowabu nk’inanga, no mu nda yanje har’ intimba y’i Kiri‐heresi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.11",
            "verseOrgIds": [
              "ISA.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.18.29"
              },
              "items": [
                {
                  "text": "1 Abam 18:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.15.2"
              },
              "items": [
                {
                  "text": "Yes 15:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ Abanyamowabu ni barasuka, bakaja kwigorera mu bitabo, bakaja mu bigabiro ngo basenge, nta co bizobamarira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.16.12",
            "verseOrgIds": [
              "ISA.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
