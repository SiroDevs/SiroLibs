                "loc": "JER.48.29"
              },
              "items": [
                {
                  "text": "Yer 48:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
