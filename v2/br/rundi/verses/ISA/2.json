            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu misi y’iherezo umurwa wubatswekw ingoro y’Uhoraho uzogasara ku mpinga z’imisozi, uzoshirwa hejuru y’iyindi mirambi; kand’ amahanga yose azosendanisha aja kuri wo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        },
        {
