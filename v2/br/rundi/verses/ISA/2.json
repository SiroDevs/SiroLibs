                "loc": "ZEC.8.20+ZEC.8.21+ZEC.8.22+ZEC.8.23"
              },
              "items": [
                {
                  "text": "Zek 8:20-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
