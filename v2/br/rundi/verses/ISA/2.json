            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoko menshi azojayo, abarirane, ati Ni muze tudūge, tuje ku murwa w’Uhoraho, ku ngoro y’Imana ya Yakobo, kugira ngw itwigishe ivy’ inzira zayo, natwe tuzigenderemwo; kukw i Siyoni ari ho hazova ivyagezwe, n’i Yerusalemu hakava ijambo ry’Uhoraho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.72.7"
              },
              "items": [
                {
                  "text": "Zab 72:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.10"
              },
              "items": [
                {
                  "text": "Zek 9:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azocira imanza amahanga, atātūre amoko menshi; inkota zabo bazozivunjamw’ amasuka, n’amacumu bazoyavunjamw’ inkero;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:4",
              "type": "text"
            },
            {
              "text": "inkero ni zo nyabuhoro.",
              "type": "text"
            }
          ]
        },
        {
          "text": " nta hanga rizobangurira irindi hanga inkota, kandi ntibazokwiga kurwana ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe ab’ inzu ya Yakobo, ni muze tugendere mu muco w’Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
