            "number": "25",
            "style": "v",
            "sid": "ISA 37:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.25",
            "verseOrgIds": [
              "ISA.37.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega ntiwumvise uko nabigenjeje kera, mbigabiye mu bihe vyashize? None narabishikije, kugira ng’ uhonnye ibisagara vyubakiwe inzitiro, ubihindure ibirundo vy’amasakamburira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.26",
            "verseOrgIds": [
              "ISA.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye abābibamwo baba imburamaboko, bagacika ivutu, bakamāramāra; bagacika nk’ubgatsi bgo ku gahinga, nk’ubgatsi bg’urumerera, nk’ivyatsi vyimejeje ku nzu, nk’ingano zirumvye zikir’ ibironge. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.27",
            "verseOrgIds": [
              "ISA.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ndazi imyicarire yawe, n’ amaja n’amaza yawe, n’ingene wanshangashiriwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.28",
            "verseOrgIds": [
              "ISA.37.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.30.28"
              },
              "items": [
                {
                  "text": "Yes 30:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.4.2"
              },
              "items": [
                {
                  "text": "Am 4:2",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero kubg’ ubushangashirwe wangiriye, n’uko numvise ivy’ agashamango kawe, nzogutūngīra umurinda wanje mu mazuru, n’umujiginya wanje mu kanwa, ngusubize mu nzira wazananye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.29",
            "verseOrgIds": [
              "ISA.37.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
