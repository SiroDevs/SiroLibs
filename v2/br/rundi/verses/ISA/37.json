          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ISA 37:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uti Ni co gitumye Uhoraho avuga ivy’ umwami w’i Ashuri, ati Ntazoruha agera mur’ iki gisagara, canke ngw aharase n’umwampi, canke ngw ahatumbereze n’inkinzo, canke ngw aharunde ikirundo co kwūririrako. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.33",
            "verseOrgIds": [
              "ISA.37.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ISA 37:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ut’ Inzira yazananye ni yo nyene izomusubizayo; ntazoruha agera mur’ iki gisagara, ni k’Uhoraho agize. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.34",
            "verseOrgIds": [
              "ISA.37.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ISA 37:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.20.6"
              },
              "items": [
                {
                  "text": "2 Abam 20:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.31.5"
              },
              "items": [
                {
                  "text": "Yes 31:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ut’ Arik’ Uhoraho ngw Azozigama uyu murwa kugira ngw awukize, abikoze kubgiwe no kubg’ umusavyi wiwe Dawidi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.35",
            "verseOrgIds": [
              "ISA.37.35"
            ]
          }
        }
      ]
