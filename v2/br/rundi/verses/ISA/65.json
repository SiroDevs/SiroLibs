                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nzohimbarwa n’i Yerusalemu, nnezerwe n’abantu banje: kand’ ijwi ryo kurira ntirizohumvikana ukundi, cank’ ijwi ryo kuboroga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.19",
            "verseOrgIds": [
              "ISA.65.19"
            ]
          }
        },
