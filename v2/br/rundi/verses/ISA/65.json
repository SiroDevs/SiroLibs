              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.15"
              },
              "items": [
                {
                  "text": "Hos 2:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ i Sharoni hazoba icanya c’intama, kand’ ikiyaya c’i Akori kizoba ivyagiro ry’ inka, n’uburuhukiro bg’abantu banje bandondeye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.10",
            "verseOrgIds": [
              "ISA.65.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
