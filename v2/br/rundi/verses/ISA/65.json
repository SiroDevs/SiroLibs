                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko munezerwe, muze muhore muhimbawe n’ivyo ndema; kuko rāba, ndema Yerusalemu ngo mpagire umunezero, n’abantu baho ngo ndabagire akanyamuneza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.18",
            "verseOrgIds": [
              "ISA.65.18"
            ]
          }
        },
        {
