            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibazoruhira ubusa, kandi ntibazovyara abo kugesezwa, kuko bazoba ar’ uruvyaro jewe Uhoraho nahezagiye, bo n’abazobakomokako. ",
          "type": "text",
          "attrs": {
