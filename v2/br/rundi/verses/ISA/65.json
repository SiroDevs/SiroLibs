                {
                  "text": "66:17",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "N’abantu bahora banshinyaguriza imbonankubone, bagatangira ibimazi mu bigabiro, bakosereza imibavu ku bicaniro vyubakishijwe amatafari; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.3",
            "verseOrgIds": [
              "ISA.65.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 65:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakicara hagati y’imva, bakarāra mu bitabo ahihishije; bakarya inyama z’ingurube, kandi mu nzavya zabo hakabamw’ umufa w’inyama z’ibizira; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.4",
            "verseOrgIds": [
              "ISA.65.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 65:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.9.18"
              },
              "items": [
                {
                  "text": "Yes 9:18",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "bakavuga, bati Hagarara ukwawe, ntunyegēre, kuko jewe nkurusha kuba uwejejwe. Ben’ abo bambera umwotsi wo mu mazuru, n’umuriro wīriza umusi waka. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.5",
            "verseOrgIds": [
              "ISA.65.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 65:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.50.3"
