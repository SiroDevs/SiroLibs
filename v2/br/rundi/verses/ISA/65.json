              "items": [
                {
                  "text": "Yer 17:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eh’ ivyo biranditswe imbere yanje, sinzohora, ariko nzobibasubizako, mbere nzobasubiriza mu nkōko. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.6",
            "verseOrgIds": [
              "ISA.65.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 65:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.5"
              },
              "items": [
                {
                  "text": "Kuv 20:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.27"
              },
              "items": [
                {
                  "text": "Ezk 20:27",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.20.28"
              },
              "items": [
                {
                  "text": "28",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibigabitanyo vyanyu ubganyu, ni k’ Uhoraho agize, nzobibasubirizakw icarimwe n’ibigabitanyo vya ba sogokuruza banyu, bosereza imibavu ku misozi, bakantukira ku turambi: ni co gituma nzobasubiriza mu nkōko ibikwiranye n’ ibikorwa vyabo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.7",
            "verseOrgIds": [
              "ISA.65.7"
            ]
          }
        }
      ]
    },
