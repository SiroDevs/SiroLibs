        },
        {
          "text": "Nabaririkijwe n’abatānyibaza; nabonywe n’abatāndondeye; nabariye ihanga ritāmbaje izina ryanje, nt’ Ehe rāba, ndi hano. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.1",
            "verseOrgIds": [
              "ISA.65.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 65:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nirirwa ntegeye amaboko ihanga rigarariza, bagendera mu nzira zitari nziza, bakurikira ivyabo vyiyumviro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.2",
            "verseOrgIds": [
              "ISA.65.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
