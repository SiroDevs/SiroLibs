              "items": [
                {
                  "text": "Yos 24:20",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.23.41"
              },
              "items": [
                {
                  "text": "Ezk 23:41",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CO.10.21"
              },
              "items": [
                {
                  "text": "1 Kor 10:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mwebge abantaye jewe Uhoraho, mukibagira umusozi wanje wera, mugatereka Gadi, mugaturiraniriza Meni; ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.11",
            "verseOrgIds": [
              "ISA.65.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 65:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.66.4"
              },
              "items": [
                {
                  "text": "Yes 66:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.13"
              },
              "items": [
                {
                  "text": "Yer 7:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "nanje nzobashirirah’ inkota, mwese muzokwunamira kwicwa: kukw igihe nahamagara mutitavye, n’igihe navuga mutumvise; ariko mugakora ivyo mbona kw ari bibi, mukitoraniriza ibitannezera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.12",
            "verseOrgIds": [
              "ISA.65.12"
            ]
          }
        }
      ]
