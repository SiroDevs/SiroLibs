                  "text": "Ezk 28:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokwubaka amazu bayīberemwo, kandi bazotera uruzabibu, bīrīre inzabibu zarwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.21",
            "verseOrgIds": [
              "ISA.65.21"
            ]
          }
        },
