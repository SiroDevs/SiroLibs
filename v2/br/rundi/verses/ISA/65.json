              "items": [
                {
                  "text": "Zab 22:26",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Uhoraho Imana agize, ati Rāba, abasavyi banje bazorya, ariko mweho muzokwicwa n’inzara; abasavyi banje bazonywa, ariko mweho muzokwicwa n’inyota; abasavyi banje bazonezerwa, ariko mweho muzomāramāra: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.13",
            "verseOrgIds": [
              "ISA.65.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 65:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.5.11"
              },
              "items": [
                {
                  "text": "Zab 5:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "rāba, abasavyi banje bazoririmbishwa n’ umunezero wo mu mitima, ariko mweho muzorizwa n’intuntu yo mu mitima, muborozwe n’ukw imitima yanyu isābijwe n’umubabaro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.14",
            "verseOrgIds": [
              "ISA.65.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
