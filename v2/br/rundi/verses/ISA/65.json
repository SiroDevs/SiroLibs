                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, ati Nk’ukw ihando ry’umuzabibu riboneka ko ririmw’ umutobe, bakavuga, bati Ntuwurandure, kuk’ ugifise ikimazi, uko ni ko nanje nzogira, kubg’ abasavyi banje, noye kubarandura bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.8",
            "verseOrgIds": [
              "ISA.65.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 65:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.27.6"
              },
              "items": [
                {
                  "text": "Yes 27:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzokwironkera uruvyaro muri Yakobo, n’ūzoragwa imisozi yanje muri Yuda; abo nitoranirije bazoharagwa, n’abasavyi banje bazohaba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.65.9",
            "verseOrgIds": [
              "ISA.65.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
