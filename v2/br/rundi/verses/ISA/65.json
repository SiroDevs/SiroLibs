              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.1.29"
              },
              "items": [
                {
                  "text": "Yes 1:29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.57.3+ISA.57.4+ISA.57.5+ISA.57.6"
              },
              "items": [
                {
                  "text": "57:3-6",
                  "type": "text"
                }
              ]
