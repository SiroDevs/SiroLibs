                {
                  "text": "Yes 63:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kand’ abona yukw ata muntu ariho, atangazwa n’ukw ata wo kubahagarikira; ni co catumye ukwiwe kuboko ari kwo yizanishirije agakiza, kand’ ukugororoka kwiwe ni kwo yishimikije. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.16",
            "verseOrgIds": [
              "ISA.59.16"
            ]
          }
        },
        {
          "name": "verse",
