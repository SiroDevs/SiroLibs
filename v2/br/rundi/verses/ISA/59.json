          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni koko, ukuri kurakamanganye; kand’ ūhunze ibibi aba yinyagishije. Uhoraho yarabibonye, biramubabaza, kukw ata biroranye biriho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.15",
            "verseOrgIds": [
              "ISA.59.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 59:16"
          },
          "items": [
            {
