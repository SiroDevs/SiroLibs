            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yambara ukugororoka nk’icuma gikīngira igikiriza, no ku mutwe inkofero y’agakiza; yambara impuzu zo guhōra ngo zimubere imyambaro, yiyambika ishaka nk’umutamana. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.59.17",
            "verseOrgIds": [
              "ISA.59.17"
            ]
          }
