                "loc": "MIC.5.13"
              },
              "items": [
                {
                  "text": "Mik 5:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.5.14"
              },
              "items": [
                {
                  "text": "14",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi ntazotumbera ibicaniro, ivyo yubatse n’amaboko yiwe, ntazoshira amaso ku vyo intoke ziwe zakoze, canke ku nkingi bashingira Ashera n’izo bashingira izuba. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.8",
            "verseOrgIds": [
              "ISA.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kur’ uwo musi ibisagara vyiwe bikomeye bizoba nk’imisaka isigaye mw ishamba no ku mpinga z’imisozi, aho bātuze bahunga Abisirayeli: hazosigara ar’ amatongo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.9",
            "verseOrgIds": [
              "ISA.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.106.21"
              },
              "items": [
                {
                  "text": "Zab 106:21",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko wibagiye Imana y’agakiza kawe, ntiwibuke igitandara c’inkomezi zawe; ico ni co catumye uteragira interwa zo kwinezereza, ukishingira imizabibu y’ikigirwamana c’akavantara. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.10",
            "verseOrgIds": [
              "ISA.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi wabiteyeko warabizitiriye, bukeye utuma ivyo wateye bishurika: arikw ivyimburwa bizobura ku musi w’umubabaro n’akabonge k’ubgihebe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.11",
            "verseOrgIds": [
              "ISA.17.11"
            ]
          }
        }
      ]
    },
