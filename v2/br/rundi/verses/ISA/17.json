              },
              "items": [
                {
                  "text": "83:13",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.22.23"
              },
              "items": [
                {
                  "text": "Imig 22:23",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoko azosūma nk’ugusūma kw’amazi menshi: arikw Imana izoyakankamira, na yo azohungira kure, nk’ ibishingwe vyo ku misozi iyo bijanwa n’umuyaga, nk’ifurufumbi y’ umukungugu ir’ imbere y’igihuhuta. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.13",
            "verseOrgIds": [
              "ISA.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mugoroba haba gucika ivutu, maze bugira buce bakaba batakiriho. Uwo ni wo mugabane w’abatunyaga, kandi ni yo ngero y’abatwambura.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.14",
            "verseOrgIds": [
              "ISA.17.14"
            ]
          }
        }
