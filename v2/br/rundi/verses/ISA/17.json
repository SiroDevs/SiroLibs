            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbūri yo kuri Damasiko. Rāba Damasiko hakūweho, ntihacitwa umurwa, hazoba ibirundo vy’amasakamburira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.1",
            "verseOrgIds": [
              "ISA.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisagara vyo muri Aroweri bicitse imisaka; hazoba ah’ imikuku, ni yo izohagandagaza, nta kizoyikanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.2",
            "verseOrgIds": [
              "ISA.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.4.21"
              },
              "items": [
                {
                  "text": "1 Sam 4:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.16"
              },
              "items": [
                {
                  "text": "Yes 7:16",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.8.4"
              },
              "items": [
                {
                  "text": "8:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibihome bizoshira muri Efurayimu, n’ubgami bushire i Damasiko, bo n’amasigarira y’i Siriya; bizoba nk’ukw icubahiro c’Abisirayeli cabaye, ni k’Uhoraho Nyen’ ingabo agize.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.17.3",
            "verseOrgIds": [
              "ISA.17.3"
            ]
          }
        }
      ]
    },
    {
