                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sohora impumyi zifise amaso, n’ibipfamatwi bifise amatwi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.8",
            "verseOrgIds": [
              "ISA.43.8"
            ]
          }
        },
        {
