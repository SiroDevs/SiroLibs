              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, Umucunguzi wanyu, Uwera w’ Abisirayeli, ati Natumye i Babuloni kubganyu, nzomanura abaho bose ar’ impunzi, ni bo Bakaludaya, mu māto bishimira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.14",
            "verseOrgIds": [
              "ISA.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe Uhoraho, Uwera wanyu, Umuremyi wa Isirayeli, Umwami wanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.15",
            "verseOrgIds": [
              "ISA.43.15"
            ]
          }
        },
