                "loc": "ISA.41.1"
              },
              "items": [
                {
                  "text": "Yes 41:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.41.21"
              },
              "items": [
                {
                  "text": "21",
                  "type": "text"
                }
