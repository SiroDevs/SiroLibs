              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko none, uku ni k’Uhoraho agize, uwakuremye, yewe Yakobo, kand’ akakubumba, yewe Isirayeli, ati Ntutinye, kuko nagucunguye, naguhamagaye izina, ur’ uwanje. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.1",
            "verseOrgIds": [
              "ISA.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 43:2"
          },
          "items": [
            {
