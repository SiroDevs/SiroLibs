              "items": [
                {
                  "text": "Yoh 8:58",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eka ndi yo, uhereye no ku musi w’itanguriro; kandi nta woshobora kugira ico arokora ngw agikūre mu kuboko kwanje. Jewe ico nkora, ni nde yokibuza?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.43.13",
            "verseOrgIds": [
              "ISA.43.13"
            ]
          }
        }
      ]
    },
