              "ISA.36.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "\n",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZR.4.7"
              },
              "items": [
                {
                  "text": "Ezr 4:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Eliyakimu na Shebuna na Yowa bishura Rabushake, bat’ Enda se turakwinginze, utubarire mu Gisiriya, kuko tucumva; ariko nta co utubaririra mu Kiyuda mu matwi y’aba bantu bari hejuru ku ruzitiro rw’amabuye. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.11",
            "verseOrgIds": [
              "ISA.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Rabushake arabishura, ati Mbega mugira ngo databuja yantumye kuri shobuja namwe gusa kubabgira aya majambo? Ntiyantumye kur’ aba bagabo bicaranye namwe hejuru ku ruzitiro, kugira ngo barīre amavyi yabo hamwe n’ayo basōvye?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.12",
            "verseOrgIds": [
              "ISA.36.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.12",
            "verseOrgIds": [
              "ISA.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Rabushake arahagarara, avuga n’ijwi rirenga mu rurimi rw’Ikiyuda, ati Ni mwumve amajambo y’umwami ahambaye, ni we mwami w’i Ashuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.13",
            "verseOrgIds": [
              "ISA.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.37.10"
              },
              "items": [
                {
                  "text": "Yes 37:10",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’umwami agize, ngo Hezekiya ntabahende; ngo Kukw atazoshobora kubakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.14",
            "verseOrgIds": [
              "ISA.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo Kandi Hezekiya ntabizigize Uhoraho, ababarira, ng’ Uhoraho ntazobura kubakiza, kandi ng’ Uyu murwa ntuzotangwa ng’ukorokere mu maboko y’umwami w’i Ashuri. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.15",
            "verseOrgIds": [
              "ISA.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimwumvire Hezekiya: kuk’ ukw ari k’umwami w’i Ashuri agize, ngo Kunda mwuzure na we, musokoroke muje iy’ ari, umuntu wese ngw abone kurya ku muzabibu wiwe no ku musukoni wiwe, no kunywa ku mazi yo mw ivomo ryiwe, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.16",
            "verseOrgIds": [
              "ISA.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.11"
              },
              "items": [
                {
                  "text": "2 Abam 18:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo Gushitsa igihe azozira akabajana mu gihugu gihwanye n’icanyu, igihugu c’ingano na vino, igihugu c’indya n’inzabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.17",
            "verseOrgIds": [
              "ISA.36.17"
            ]
          }
        },
