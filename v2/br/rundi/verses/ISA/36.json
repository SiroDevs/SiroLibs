                {
                  "text": "2 Ngo 32:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira icumi na kane umwami Hezekiya ari ku ngoma, Senakeribu umwami w’i Ashuri yaradūze, atera ibisagara vyose vyubakiwe inzitiro vy’i Buyuda, arabitsinda. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.1",
            "verseOrgIds": [
              "ISA.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.9"
              },
              "items": [
                {
                  "text": "2 Ngo 32:9",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.7.3"
              },
              "items": [
                {
                  "text": "Yes 7:3",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye umwami w’i Ashuri atuma Rabushake ava i Lakishi ajanye ingabo nyinshi, aja i Yerusalemu, ku mwami Hezekiya. Ashitseyo ahagarara ku mugende wo ku kidengeri co haruguru, ku nzira yo ku kibuga c’umumesuzi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.2",
            "verseOrgIds": [
              "ISA.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.15"
              },
              "items": [
                {
                  "text": "Yes 22:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.22.20"
              },
              "items": [
                {
                  "text": "20",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ umuzezwarugo Eliyakimu mwene Hilukiya, n’umukarani Shebuna, n’umwanditsi w’ivyaja biraba yitwa Yowa mwene Asafu, barenga irembo baramusanganira. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.3",
            "verseOrgIds": [
              "ISA.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rabushake arababarira, ati Ni mubarire Hezekiya, mut’ Uku ni k’umwami ahambaye, ni we mwami w’i Ashuri, agize: ngo Mbeg’ ivyo vyizigiro wizigiye n’ibiki? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.4",
            "verseOrgIds": [
              "ISA.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngw Inama yawe n’ inkomezi zo kurwana, erega n’ amajambo y’impfagusa. Ngo Mbeg’ uwo wishimiye ni nde, yatumye umugarariza? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.5",
            "verseOrgIds": [
              "ISA.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.6"
              },
              "items": [
                {
                  "text": "Ezk 29:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.29.7"
              },
              "items": [
                {
                  "text": "7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngw Erega wishimiye ya nkoni y’ irenga rivunitse, ni ryo Egiputa, umuntu yoryishimikiza ryomutobekeranya ikiganza. Ng’ Uko ni ko Farawo umwami wa Egiputa amerera abamwishimiye bose. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.6",
            "verseOrgIds": [
              "ISA.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.18.4"
              },
              "items": [
                {
                  "text": "2 Abam 18:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho mwomubarira ko mwishimiye Uhoraho Imana yanyu: none si yo Hezekiya yakūyeh’ ibitabo vyayo n’ibicaniro vyayo, akabarira Abayuda n’ab’ i Yerusalemu, ati Muze musengere imbere y’iki gicaniro? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.7",
            "verseOrgIds": [
              "ISA.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti None rero, enda shinga na shebuja umwami w’i Ashuri, muti Na we Rabushake araguha amafarasi ibihumbi bibiri, namba nawe ubgawe woshobora kuronka abo uyūriza. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.8",
            "verseOrgIds": [
              "ISA.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.31.1"
              },
              "items": [
                {
                  "text": "Yes 31:1",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti None se woshobora ute gukora mu maso y’umugabisha n’umwe wo mu basavyi ba shebuja bo hanyuma y’abandi, mut’ Asangw’ ar’ ukwishimira Abanyegiputa kw ari bo bazoguha imikogote ikwegwa n’ amafarasi n’abo kuyagenderako? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.9",
            "verseOrgIds": [
              "ISA.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.5"
              },
              "items": [
                {
                  "text": "Yes 10:5",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.10.6"
              },
              "items": [
                {
                  "text": "6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muti Mbega yadūze gutera iki gihugu no kukirandura, atari kubg’ Uhoraho? Mut’ Ereg’ Uhoraho ni we nyene yamubariye, ati Dūga utere ico gihugu, ukirandure.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.10",
            "verseOrgIds": [
              "ISA.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
