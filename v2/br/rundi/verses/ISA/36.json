              "type": "text"
            }
          ]
        },
        {
          "text": "Maze barihorera, ntibamwishura ijambo na rimwe, kukw ijambo ry’umwami ryari ryavuze, ngo Ntimugire ico mumwishura. ",
          "type": "text",
          "attrs": {
