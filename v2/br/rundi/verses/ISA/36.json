              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.32.15"
              },
              "items": [
                {
                  "text": "2 Ngo 32:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngo N’izihe mu mana zose zo mur’ ivyo bihugu zākijije igihugu cazo ngo ntigikorokere mu maboko yiwe, ng’ Uhoraho na we akize Yerusalemu ngo ntihakorokere mu maboko yiwe?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.20",
            "verseOrgIds": [
              "ISA.36.20"
            ]
          }
        }
