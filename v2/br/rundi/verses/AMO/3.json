            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko batazi gukora ibitunganye, ni k’Uhoraho agize, birundaniriza umuryano n’ubgambuzi mu ngoro zabo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.10",
            "verseOrgIds": [
              "AMO.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
