            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuk’ umusi nzohanakw Abisirayeli ibigabitanyo vyabo, nzohana n’ibicaniro vy’i Beteli; kand’ amahembe y’igicaniro azocibga atsindwe hasi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.14",
