              "items": [
                {
                  "text": "Yes 39:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, uku ni k’Umwami Uhoraho agize, ati Hazoza abansi, bazota igihugu hagati; bazocobogoza ubuhizi bgawe, ingoro zawe zisahurwe. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.11",
            "verseOrgIds": [
              "AMO.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
