              "items": [
                {
                  "text": "Kuv 22:13",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni k’Uhoraho agize, ati Nk’uk’ umwungere yaka intambge amaguru abiri cank’ igice c’ugutwi mu kanwa kayo, ni ko n’Abisirayeli bazorokorwa, bībereye i Samariya bīdibamiye ku misezero, no ku misego y’amahariri ku buriri. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.12",
            "verseOrgIds": [
              "AMO.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
