          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.50.7"
              },
              "items": [
                {
                  "text": "Zab 50:7",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwumve, mwagirize inzu ya Yakobo, ni k’Umwami Uhoraho agize, ni we Mana Nyen’ ingabo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.3.13",
            "verseOrgIds": [
              "AMO.3.13"
            ]
          }
        },
