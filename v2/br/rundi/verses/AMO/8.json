              "type": "text"
            }
          ]
        },
        {
          "text": "mukavuga, muti Mbeg’ imboneko z’ukwezi zizoshira ryari, ngo tubone kwishōrera amahonda, cank’ isabato, ngo tubone gutundurura ingano ngo tugure, ngo dutūvye ingero yitwa efa, tugwize shekeli, duhendanishe iminzane y’ibinyoma; ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.5",
            "verseOrgIds": [
              "AMO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
