                "loc": "AMO.2.6"
              },
              "items": [
                {
                  "text": "Am 2:6",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngo dushōre ifeza twigurire abarushwa, dushōre n’inkweto twigurire abakene, ngo dushōre n’ibihumbga vy’ ingano? ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.6",
            "verseOrgIds": [
              "AMO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 8:7"
          },
          "items": [
            {
