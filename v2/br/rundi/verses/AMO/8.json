            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maz’ arambaza, at’ Ubonye iki ga Amosi? Nti Mbonye igisimbo c’amatunda ahīshiye. Maz’ Uhoraho arambgira, at’ Amateka y’abantu banje b’Abisirayeli arahīshishijwe; kandi sinzosubira kwirengagiza ivyabo ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.2",
            "verseOrgIds": [
              "AMO.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 8:3"
