        },
        {
          "text": "Kur’ uwo musi indirimbo zo mu ngoro zizohinduka umuborogo, ni k’Umwami Uhoraho agize; imivyimba izoba myinshi: ahantu hose bazoyishiburira hanze mu gacerere. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.3",
            "verseOrgIds": [
              "AMO.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 8:4"
          },
          "items": [
