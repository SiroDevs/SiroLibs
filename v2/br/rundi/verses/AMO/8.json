        },
        {
          "text": "Ibi ni vyo Umwami Uhoraho yanyeretse: ngize ntya, mbona igisimbo c’amatunda ahīshiye. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.1",
