                {
                  "text": "Zab 14:4",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni mwumve ibi, yemwe abagomba gusiribanga abakene, no kumara impahazwa zo mu gihugu, ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.4",
            "verseOrgIds": [
              "AMO.8.4"
            ]
          }
        },
