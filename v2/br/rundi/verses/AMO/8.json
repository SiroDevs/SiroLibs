                "loc": "ISA.3.24"
              },
              "items": [
                {
                  "text": "Yes 3:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.6.26"
              },
              "items": [
                {
                  "text": "Yer 6:26",
