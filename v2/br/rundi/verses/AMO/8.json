                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abarahira ubuyobe bg’i Samariya, bati Nk’ ukw imana yawe ihoraho, ewe Dani; kandi bati Nk’uko bga bgirukiro bgawe bur’ aho, ewe Beri‐sheba: na bo nyene bazogwaho, ntibasubire kuvyuka ukundi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.14",
            "verseOrgIds": [
              "AMO.8.14"
            ]
