                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.2.11"
              },
              "items": [
                {
                  "text": "Hos 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imisi mikuru yanyu nzoyihindura umuborogo, n’indirimbo zanyu zose zicike agacurantimba; kandi bose nzobakenyeza amagunira, imitwe yose imobge inkomvorera; kandi nzobatera umuborogo nk’uwo baborogera umwana w’umuhungu w’ ikinege, amaherezo yavyo abe umusi w’akabonge.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.10",
            "verseOrgIds": [
              "AMO.8.10"
            ]
          }
        }
      ]
