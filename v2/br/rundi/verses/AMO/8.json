          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "HOS.4.3"
              },
              "items": [
                {
                  "text": "Hos 4:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.10.11"
              },
              "items": [
                {
                  "text": "Zek 10:11",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbeg’ ivyo ntibizotuma igihugu gihinda agashitsi, abari muri co bose bagacura umuborogo? Kizoteragurwa rwose nk’uko rwa Ruzi rwiteragura; gisimbagurike, gisubire gihwāmīre nka rwa Ruzi rwo muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.8",
            "verseOrgIds": [
              "AMO.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MIC.3.6"
              },
              "items": [
                {
                  "text": "Mik 3:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.24.29"
              },
              "items": [
                {
                  "text": "Mat 24:29",
                  "type": "text"
                }
              ]
            },
            {
              "text": ".",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kur’ uwo musi, ni k’Umwami Uhoraho agize, nzorengesha izuba mu mashōka, nzane ubgirakabiri kw isi hakiri ku murango. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.8.9",
            "verseOrgIds": [
              "AMO.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
