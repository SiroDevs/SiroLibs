          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira kabiri umwami Dariyusi ari ku ngoma, ku musi wa mbere w’ukwezi kugira gatandatu, ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        },
        {
          "text": " ryaciye ku wuvugishwa n’Imana Hagayi ribwirwa Zerubabeli mwene Sheyalutiyeli, umukuru w’intara y’i Buyuda, na Yosuwa mwene Yehozadaki, umuherezi mukuru.",
          "type": "text",
          "attrs": {
            "verseId": "HAG.1.1",
            "verseOrgIds": [
              "HAG.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
