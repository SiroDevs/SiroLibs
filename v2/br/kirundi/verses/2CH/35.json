        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.22",
            "verseOrgIds": [
              "2CH.35.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
