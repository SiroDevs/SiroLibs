              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Yosiya n’ibikorwa vyiwe vy’ubwizigirwa, nk’uko vyanditswe mu Vyagezwe vy’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.26",
            "verseOrgIds": [
