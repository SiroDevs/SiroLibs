          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeremiya yandika amajambo yo gucura intimba ku bwa Yosiya, kandi gushika n’ubu abagabo n’abagore b’abaririmvyi bose bama bibuka Yosiya mu gucura intimba. Ivyo vyabaye umugenzo mu Bisirayeli kandi vyanditswe mu ndirimbo zo gucura intimba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.25",
            "verseOrgIds": [
              "2CH.35.25"
            ]
          }
        }
      ]
    },
