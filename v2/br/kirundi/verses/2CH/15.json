            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta ntambara yasubiye kuba gushika ku mwaka wa mirongo itanu na gatanu wo ku ngoma ya Asa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.15.19",
            "verseOrgIds": [
              "2CH.15.19"
            ]
          }
        }
