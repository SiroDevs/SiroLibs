        },
        {
          "text": "Maze Salomo avuga ati: “Ewe ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "text": ", wavuze ko uba mu gicu c’umwijima w’umuzitanya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko jewe nakwubakiye Ingoro y’igitangaza, ikibanza uzokwiberamwo ibihe vyose.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
