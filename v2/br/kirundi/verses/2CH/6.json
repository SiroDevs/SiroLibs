          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo ahagarara imbere y’igicaniro c’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "text": " n’imbere y’ikoraniro ryose ry’Abisirayeli agorora amaboko yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo yari yarubatse hagati na hagati muri rwa rugo, ahantu hataramutse ho guhagarara mu butare bw’umwakaka, hangana n’ingero z’igice c’ukuboko zitanu z’uburebure n’ubwaguke, hakagira n’ingero z’igice c’ukuboko zitatu z’igihagararo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:13",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 2,3 z’uburebure n’ubwaguke, n’imetero 1,4 z’igihagararo.",
              "type": "text"
            }
          ]
        },
        {
          "text": ". Ahagararaho, araheza apfukama imbere y’ikoraniro ryose ry’Abisirayeli agorora amaboko ayerekeje mw’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
