        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowahazi yari afise imyaka mirongo ibiri n’itatu igihe yimikwa ngo abe umwami, aca aganza amezi atatu ari i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.2",
            "verseOrgIds": [
              "2CH.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami wa Egiputa amukura ku ngoma i Yerusalemu aca ategeka Abayuda ko batanga amashikanwa yo kwisaba angana n’italanto ijana",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:3",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 3.750.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza n’italanto imwe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:3",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 34.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’inzahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.3",
            "verseOrgIds": [
              "2CH.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami wa Egiputa yimika Eliyakimu avukana na Yehowahazi, ngo abe umwami w’i Buyuda n’i Yerusalemu; ahindura izina ryiwe amwita Yehoyakimu. Ariko Neko atwara Yehowahazi umuvukanyi wa Eliyakimu amumanukana muri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.4",
            "verseOrgIds": [
              "2CH.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakimu yari afise imyaka mirongo ibiri n’itanu igihe yaba umwami, aganza imyaka cumi n’umwe ari i Yerusalemu, akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "text": " Imana yiwe abona ko ari bibi mu nyonga ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.5",
            "verseOrgIds": [
              "2CH.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza umwami w’i Babiloni aramutera amubohesha iminyororo y’umwakaka amujana i Babiloni. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.6",
            "verseOrgIds": [
              "2CH.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nebukadineza yongera atwara i Babiloni ibikoresho vyari mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "text": " abishira mu ngoro yiwe i Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.7",
            "verseOrgIds": [
              "2CH.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Yehoyakimu, ibibi vy’ubuyobe yakoze n’ivyamubayeko vyose, vyanditswe mu gitabu c’ivyabaye ku ngoma z’abami b’Abisirayeli n’Abayuda. Maze Yehoyakini umuhungu wiwe aba ari we amusubirira ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.8",
            "verseOrgIds": [
              "2CH.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakini yari afise imyaka cumi n’umunani igihe yimikwa ngo abe umwami, aganza amezi atatu n’imisi cumi ari i Yerusalemu. Akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.9",
            "verseOrgIds": [
              "2CH.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ntango z’umwaka, umwami Nebukadineza amutumako ngo bamuzane i Babiloni, hamwe n’ibikoresho vy’agaciro vyari mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        },
        {
          "text": ", aca yimika Zedekiya sewabo wa Yehoyakini, ngo abe umwami w’i Buyuda n’i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.10",
            "verseOrgIds": [
              "2CH.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zedekiya yari afise imyaka mirongo ibiri n’umwe igihe yaba umwami, aganza imyaka cumi n’umwe ari i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.11",
            "verseOrgIds": [
              "2CH.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "text": " Imana yiwe abona ko ari bibi mu nyonga ziwe, kandi ntiyicisha bugufi imbere y’uwavugishwa n’Imana Yeremiya, yavuga ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.12",
            "verseOrgIds": [
              "2CH.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera agarariza umwami Nebukadineza, yari yaramurahije mw’izina ry’Imana. Yigira ntagondwa akomantaza umutima kandi ntiyahindukirira ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "text": ", Imana y’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.13",
            "verseOrgIds": [
              "2CH.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyongeye, abakuru mu baherezi n’abantu bose barushaho gukora ibibi, bakurikira ivy’ubuyobe vy’ayandi mahanga mu guhumanya Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "text": ", iyo yari yaratoranije ngo ibe i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.14",
            "verseOrgIds": [
              "2CH.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
        {
          "text": ", Imana ya ba sekuruza, abatumako intumwa nyinshi, kuko yari agiriye akagongwe abantu biwe n’Ingoro yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.15",
            "verseOrgIds": [
              "2CH.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bakengera izo ntumwa, bakengera n’amajambo yiwe, bahindura agatwengo abavugishwa na we gushika aho uburake bw’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "text": " bwaziriringiye ku bantu biwe ku buryo ata wari kuba agishobora kubakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.16",
            "verseOrgIds": [
              "2CH.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abateza umwami w’i Babiloni, na we yicisha inkota urwaruka rwabo, mbere no mu Ngoro abicirayo, ntiyasigaza n’umwe yaba umusore canke inkumi, uwukuze canke umutama. Imana ibatanga mu maboko ya Nebukadineza. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.17",
            "verseOrgIds": [
              "2CH.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atwara i Babiloni ibintu vyose vyo mu Ngoro y’Imana, binini na bito, n’ubutunzi bwose bwari mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "text": " n’ubutunzi bw’umwami n’abaganwa biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.18",
            "verseOrgIds": [
              "2CH.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baturira Ingoro y’Imana kandi basenyurira hasi uruzitiro rw’i Yerusalemu; baturira ibirimba vyose, basambura n’ikintu cose c’agaciro cariyo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.19",
            "verseOrgIds": [
              "2CH.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abasigaye bacitse kw’icumu abajana nk’inyagano i Babiloni, baba abo kumukorera we n’abahungu biwe kugeza ubwami bw’Abaperesi bugiye ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.20",
            "verseOrgIds": [
              "2CH.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu kiruhuka akaruhuko k’Isabato. Igihe cose camaze ari umusaka, cararuhutse, kugeza imyaka mirongo indwi iheze nk’uko ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        },
        {
          "text": " ryari ryaravugiye muri Yeremiya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.36.21",
            "verseOrgIds": [
              "2CH.36.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
