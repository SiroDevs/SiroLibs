          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ibona ibikorwa vyabo, ingene bahindukiye bakava mu nzira zabo mbi, maze irigarura ntiyabahanisha igihano yari yabateguriye.",
          "type": "text",
          "attrs": {
            "verseId": "JON.3.10",
