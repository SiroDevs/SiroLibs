            "sid": "JON 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.9",
            "verseOrgIds": [
              "JON.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JON 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "text": " aca avuga ati: “Ko ubabajwe n’igiterwa utakoreye canke ngo utume gikura, cakuze mw’ijoro rimwe bukeye kikuma, ",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.10",
            "verseOrgIds": [
              "JON.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JON 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbega jewe sinari nkwiye kugirira ikigongwe Ninewe, igisagara kinini kibamwo abantu barenga ibihumbi ijana na mirongo ibiri badashobora gutandukanya iciza n’ikibi, hamwe n’ibitungano vyaho vyinshi?”",
          "type": "text",
          "attrs": {
            "verseId": "JON.4.11",
            "verseOrgIds": [
              "JON.4.11"
            ]
          }
        }
