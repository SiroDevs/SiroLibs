            "sid": "MAT 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze kujabuka, bashika hakurya ahitwa Genezareti. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.34",
            "verseOrgIds": [
              "MAT.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "MAT 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu baho bamenye ko ari Yesu, baca babimenyesha abo muri ako karere bose, na bo bamuzanira ababo bagwaye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.35",
            "verseOrgIds": [
              "MAT.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "MAT 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwinginga ngo yemerere abagwaye bapfume bakora no ku musozo w’impuzu yiwe, kandi abamukorako bose baca bakira.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.36",
            "verseOrgIds": [
              "MAT.14.36"
            ]
          }
        }
      ]
