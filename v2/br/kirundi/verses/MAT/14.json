        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aca amubwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero ava mu bwato, atangura kugendagenda ku mazi aja iyo Yesu ari. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abonye ko umuyaga ari mwinshi, agira ubwoba bwinshi. Atanguye kudobera mu mazi, arasemerera ati: “Mwami, ntabara!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.30",
            "verseOrgIds": [
              "MAT.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
