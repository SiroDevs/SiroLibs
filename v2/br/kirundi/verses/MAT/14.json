            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yesu arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
