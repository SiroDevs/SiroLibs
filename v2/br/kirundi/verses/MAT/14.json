              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.30",
            "verseOrgIds": [
              "MAT.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo nyene, Yesu atuma ukuboko aramufata, amubwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze baca batambukira mu bwato, umuyaga uca urahagarara. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.32",
            "verseOrgIds": [
              "MAT.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abari mu bwato bose bamuha icubahiro, bavuga bati: “Ni ukuri uri Umwana w’Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        }
      ]
    },
