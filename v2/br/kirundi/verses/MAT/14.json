            "number": "28",
            "style": "v",
            "sid": "MAT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero aca avuga ati: “Mwami, nimba ari wewe, mbwira nze aho uri, ngendagenda ku mazi.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.28",
            "verseOrgIds": [
              "MAT.14.28"
            ]
          }
        }
      ]
    },
