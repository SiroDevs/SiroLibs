        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abimenye aca ava ngaho, maze abantu benshi baramukurikira, akiza abagwaye bose bari muri bo, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.15",
            "verseOrgIds": [
              "MAT.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko arabihanikiriza ngo ntihagire abandi babwira uwo ari we. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.16",
            "verseOrgIds": [
              "MAT.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyabaye kugira ngo ivyo uwavugishwa n’Imana Yesaya yavuze bishike, aho yavuze ati:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.17",
            "verseOrgIds": [
              "MAT.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
