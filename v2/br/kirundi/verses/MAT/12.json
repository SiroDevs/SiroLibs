          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma aca abwira uwo muntu ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        },
        {
          "text": " Akugoroye guca kurakira neza kumera nk’ukundi. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.13",
            "verseOrgIds": [
              "MAT.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo baca baragenda baja kugira inama y’ingene bokwica Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.14",
            "verseOrgIds": [
              "MAT.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
