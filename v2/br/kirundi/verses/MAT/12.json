          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arabishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.11",
            "verseOrgIds": [
              "MAT.12.11"
            ]
          }
