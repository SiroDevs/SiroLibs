        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma bamuzanira umuntu aboshwe n’umudayimoni amutera kutabona n’uburagi. Nuko Yesu akiza uwo muntu, aca aravuga kandi arabona. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.22",
            "verseOrgIds": [
              "MAT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abantu benshi bari aho baratangara cane, baca batangura kubazanya bati: “Mbega uwu yoba ari wa Mwana wa Dawidi?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.23",
            "verseOrgIds": [
              "MAT.12.23"
            ]
          }
        }
      ]
    },
