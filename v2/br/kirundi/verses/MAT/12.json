          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo, Yesu aragenda aca mu mirima y’ingano kandi hari ku musi w’Isabato. Abigishwa biwe bari bashonje, baca batangura guca imitwe y’ingano zeze, barazivungura, bakuramwo intete barazirya. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.1",
            "verseOrgIds": [
              "MAT.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo babibonye, baramubwira bati: “Ehe raba abigishwa bawe bariko bakora ikizira ku musi w’Isabato!”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.2",
            "verseOrgIds": [
              "MAT.12.2"
            ]
          }
        }
      ]
    },
