              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Abafarisayo bavyumvise baca bavuga bati: “Uwo nta kindi kimushoboza kwirukana abadayimoni atari Beyelizebuli, umukuru w’abadayimoni.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.12.24",
            "verseOrgIds": [
              "MAT.12.24"
            ]
          }
        }
