              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ahejeje gusigurira neza abigishwa biwe cumi na babiri igikorwa abatumye, ava ngaho aja kwigisha no kuvuga Ubutumwa Bwiza mu bisagara vy’i Galilaya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
