              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohana ari mw’ibohero, yumva ibikorwa Kristo akora, hanyuma amutumako abigishwa biwe kumubaza bati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mbega woba uri umwe yategerezwa kuza, canke twitege uwundi?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        }
