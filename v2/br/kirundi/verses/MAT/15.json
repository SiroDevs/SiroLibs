        },
        {
          "text": "Hanyuma Abafarisayo n’abigisha b’ivyagezwe bava i Yerusalemu baja iyo Yesu ari, baramubaza bati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.15.1",
            "verseOrgIds": [
