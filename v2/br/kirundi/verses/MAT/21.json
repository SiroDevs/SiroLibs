          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nitwavuga tuti: ‘Wavuye ku bantu,’ dukwiye guca twirinda abantu, kuko bose baremera ko Yohana yari uwuvugishwa n’Imana.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.26",
            "verseOrgIds": [
              "MAT.21.26"
            ]
          }
        }
      ]
