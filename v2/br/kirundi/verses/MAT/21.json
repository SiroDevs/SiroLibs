              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyabaye kugira ngo ijambo ry’uwavugishwa n’Imana rishike; ryavuga ngo:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.4",
            "verseOrgIds": [
              "MAT.21.4"
            ]
          }
        }
