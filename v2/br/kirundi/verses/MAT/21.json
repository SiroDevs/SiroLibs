              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baravugana hagati yabo bati: “Nitwavuga tuti: ‘Wavuye mw’ijuru,’ ahava atubaza ati: ‘None ni kuki mutizeye ivyo Yohana yavuze?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.25",
            "verseOrgIds": [
              "MAT.21.25"
            ]
          }
        },
        {
          "name": "verse",
