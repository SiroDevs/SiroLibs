          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yesu yinjira mu rusengero, yirukana abadandaza n’abariko barabagurira bose. Ahenagura imeza z’abavunja amahera hamwe n’intebe z’abadandaza inuma. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.12",
            "verseOrgIds": [
              "MAT.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
