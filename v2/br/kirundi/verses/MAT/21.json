            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa biwe babibonye, baratangara cane. Baca babaza Yesu bati: “Ko uwo musukoni wumye ningoga?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.20",
            "verseOrgIds": [
              "MAT.21.20"
            ]
