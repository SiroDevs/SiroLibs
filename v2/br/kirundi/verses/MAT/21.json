          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze impumyi n’abacumbagira baraza baramwegera mu rusengero, arabakiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.14",
            "verseOrgIds": [
              "MAT.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, abaherezi bakurubakuru n’abigisha b’ivyagezwe bamaze kubona ibitangaza bihebuje akoze n’ingene abana baguma basemerera mu rusengero bavuga bati: “Hozana mwana wa Dawidi!” Baca barashavura cane.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.15",
            "verseOrgIds": [
              "MAT.21.15"
            ]
          }
        }
      ]
    },
