          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.10",
            "verseOrgIds": [
              "MAT.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bakishura bati: “Ni Yesu, umuvugishwa w’i Nazareti mu ntara ya Galilaya.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.21.11",
            "verseOrgIds": [
              "MAT.21.11"
            ]
          }
        }
      ]
    },
    {
