          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mugoroba, bazanira Yesu abantu benshi baboshwe n’abadayimoni. Yirukana izo mpwemu mbi mu kuzitegeka, azikura mu bantu kandi akiza abagwaye bose. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.16",
            "verseOrgIds": [
              "MAT.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo yabikoze kugira ngo ijambo uwavugishwa n’Imana Yesaya yavuze rishike, aho yavuze ati:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.17",
            "verseOrgIds": [
              "MAT.8.17"
            ]
          }
        }
      ]
    },
