          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu avyumvise aratangara cane, abwira abariko baramukurikira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.10",
            "verseOrgIds": [
              "MAT.8.10"
