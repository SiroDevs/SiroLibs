            "sid": "MAT 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe mu bigisha b’ivyagezwe aca aramwegera, amubwira ati: “Mwigisha, nditeguye kugukurikira aho uja hose.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.19",
            "verseOrgIds": [
              "MAT.8.19"
            ]
          }
        }
