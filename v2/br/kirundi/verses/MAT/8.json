          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abonye isinzi ry’abantu baje kumushengerera, aca abwira abigishwa biwe ngo bajabuke, baje hakurya y’ikiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.8.18",
            "verseOrgIds": [
