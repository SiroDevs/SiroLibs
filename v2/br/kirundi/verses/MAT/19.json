        },
        {
          "text": "Yesu ahejeje kuvuga ivyo, aca ava i Galilaya, amanuka mu ntara ya Yudaya, hakurya y’uruzi Yorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.1",
            "verseOrgIds": [
