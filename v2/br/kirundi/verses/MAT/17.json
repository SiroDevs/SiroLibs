            "number": "18",
            "style": "v",
            "sid": "MAT 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aca akankamira iyo dayimoni, iva muri uwo mwana, aca akira ako kanya nyene.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.18",
            "verseOrgIds": [
              "MAT.17.18"
            ]
          }
        }
      ]
    },
    {
