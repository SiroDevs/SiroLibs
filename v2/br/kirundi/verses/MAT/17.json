              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.17",
            "verseOrgIds": [
              "MAT.17.17"
            ]
          }
        },
        {
