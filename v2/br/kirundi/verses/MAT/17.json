            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe, bakoraniye i Galilaya, Yesu abwira abigishwa biwe ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.22",
            "verseOrgIds": [
              "MAT.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " Maze ivyo birabababaza cane.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.17.23",
            "verseOrgIds": [
              "MAT.17.23"
            ]
          }
        }
      ]
    },
