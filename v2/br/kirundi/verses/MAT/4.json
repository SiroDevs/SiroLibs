            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Satani yongera kumujana ku musozi muremure cane amwereka ubwami bwose bwo mw’isi n’ubwiza bwabwo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.8",
            "verseOrgIds": [
              "MAT.4.8"
            ]
          }
        },
        {
