            "sid": "MAT 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "amubwira ati: “Niwaba uri Umwana w’Imana, niwikororere hasi, kuko handitswe ngo:",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.6",
            "verseOrgIds": [
              "MAT.4.6"
            ]
          }
        }
      ]
