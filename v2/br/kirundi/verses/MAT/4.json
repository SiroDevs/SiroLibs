            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Yesu aca ajanwa na Mpwemu mu bugaragwa kugira ngo ageragezwe na Satani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.1",
            "verseOrgIds": [
              "MAT.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze imisi mirongo ine n’amajoro mirongo ine ata co arya kandi ata co anywa, yumva arashonje. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.2",
            "verseOrgIds": [
              "MAT.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugeragezi aca aramwegera, amubwira ati: “Niwaba uri Umwana w’Imana, bwira aya mabuye ahinduke imikate.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.3",
            "verseOrgIds": [
              "MAT.4.3"
            ]
          }
        }
      ]
    },
