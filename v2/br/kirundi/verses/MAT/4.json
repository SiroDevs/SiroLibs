            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma wa mubi amujana i Yerusalemu, igisagara cera, amuhagarika ku rusengero ahantu hataramutse, ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.5",
            "verseOrgIds": [
              "MAT.4.5"
            ]
          }
        },
        {
