        },
        {
          "text": "Ariko Abiyatari, mwene Ahimeleki, Ahimeleki mwene Ahitubu, arashobora kunyegera ahungira kwa Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.22.20",
