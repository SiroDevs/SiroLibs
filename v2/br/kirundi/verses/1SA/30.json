              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi arabishura ati: “Oyaye, bavukanyi, ntimukore uko ku vyo ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "text": " yaduhaye. Yaturinze yongera agabura mu maboko abari baje kudutera. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.23",
            "verseOrgIds": [
              "1SA.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
