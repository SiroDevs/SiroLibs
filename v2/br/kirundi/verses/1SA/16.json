          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Isayi afata indogoba ayiremeka imikate, umukuza w’umuvinyu n’ishashi y’impene abirungikana umuhungu wiwe Dawidi kwa Sawuli.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.20",
            "verseOrgIds": [
              "1SA.16.20"
            ]
          }
        }
      ]
