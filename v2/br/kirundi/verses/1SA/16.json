          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Sawuli arungika intumwa kwa Isayi amutumako ati: “Ndungikira umuhungu wawe Dawidi, aragira intama.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.19",
            "verseOrgIds": [
              "1SA.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
