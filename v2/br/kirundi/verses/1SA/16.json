            "verseId": "1SA.16.6",
            "verseOrgIds": [
              "1SA.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "text": " aramubwira ati: “Nturabe akaranga n’uburebure, uwo namwanse. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "text": " ntaraba ku vyo abantu baraba. Abantu baraba ku biboneka, ariko ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        },
        {
          "text": " araba mu mutima.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.7",
            "verseOrgIds": [
              "1SA.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
