            "sid": "1SA 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samweli yakira rya hembe ry’amavuta ayamusukako bakuru biwe babona, kandi kuva uwo musi n’inyuma y’aho Mpwemu w’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        },
        {
          "text": " yama aza kuri Dawidi azananye ubushobozi. Nuko Samweli asubira i Rama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.13",
            "verseOrgIds": [
              "1SA.16.13"
            ]
          }
        }
      ]
    },
