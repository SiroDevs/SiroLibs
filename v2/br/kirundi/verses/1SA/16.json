          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe, Mpwemu w’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "text": " yari amaze kuva kuri Sawuli, maze impwemu mbi itumwe n’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
          }
        },
        {
          "text": " ikaza ikamubuza amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.14",
            "verseOrgIds": [
              "1SA.16.14"
            ]
