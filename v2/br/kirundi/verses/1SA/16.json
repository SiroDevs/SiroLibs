            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe cose ya mpwemu yatumwe n’Imana yaza kuri Sawuli, Dawidi yaca afata inanga yiwe akayivuza. Maze Sawuli agaca amererwa neza, kandi iyo mpwemu na yo igaca imuvako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.16.23",
