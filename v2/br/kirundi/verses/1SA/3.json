          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli asubira kuryama gushika mu gitondo aca yugurura imyango y’inzu y’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "text": ", ariko aratinya kubwira Eli ivyo yabwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.15",
            "verseOrgIds": [
              "1SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Eli aramuhamagara amubwira ati: “Samweli mwana wanje.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.16",
            "verseOrgIds": [
              "1SA.3.16"
            ]
          }
        }
      ]
    },
