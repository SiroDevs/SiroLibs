            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        },
        {
          "text": " asubira guhamagara ati: “Samweli!” Maze Samweli aravyuka aja iyo Eli ari aravuga ati: “Ndi hano; wampamagaye?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
