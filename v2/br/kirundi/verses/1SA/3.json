          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli aramwishura ati: “Mwana wanje, sinaguhamagaye; subira kuryama.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.6",
            "verseOrgIds": [
              "1SA.3.6"
            ]
          }
        }
