            ]
          }
        },
        {
          "text": " ahamagara Samweli ubugira gatatu, maze Samweli aravyuka aja iyo Eli ari aravuga ati: “Ndi hano; wampamagaye?”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.3.8",
