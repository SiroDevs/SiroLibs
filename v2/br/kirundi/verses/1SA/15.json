          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samweli ntiyigeze asubira kubonana na Sawuli kugeza apfuye, naho yagandaye kubera umubabaro w’ivyabaye kuri Sawuli. Kandi ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.35",
            "verseOrgIds": [
              "1SA.15.35"
            ]
          }
        },
        {
          "text": " yaricujije icatumye yimika Sawuli ngo abe umwami w’Abisirayeli.",
          "type": "text",
          "attrs": {
