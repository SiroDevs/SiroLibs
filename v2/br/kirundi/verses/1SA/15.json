          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Samweli aravuga ati: “Nzanira Agagi umwami w’Abamaleki.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.32",
            "verseOrgIds": [
