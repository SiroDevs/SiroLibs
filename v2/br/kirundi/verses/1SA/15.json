          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sawuli aramwishura ati: “Ni vyo nacumuye. Ariko ndakwinginze ntera iteka imbere y’aba bakuru b’abantu banje n’imbere y’Abisirayeli; garuka tujane, kugira ngo nsenge ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "text": " Imana yawe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.15.30",
            "verseOrgIds": [
              "1SA.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
