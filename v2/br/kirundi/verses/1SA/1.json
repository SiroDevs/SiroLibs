            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hana ntiyashoboye kujana na bo. Nuko abwira umugabo wiwe ati: “Uwu muhungu niyacuka, nzomujana ndamushikanire ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        },
        {
          "text": ", na we azoba imbere y’Uhoraho ibihe vyose.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
