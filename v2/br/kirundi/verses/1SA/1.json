        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.22",
            "verseOrgIds": [
              "1SA.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elukana umugabo wiwe aramubwira ati: “Uze ukore ikizokubera ciza. Guma ngaha gushika umucukije; kimwe gusa ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        },
        {
          "text": " ashitse ijambo ryiwe.” Nuko uwo mugore aguma i muhira arera umuhungu wiwe gushika aho yamucukirije.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.23",
            "verseOrgIds": [
              "1SA.1.23"
            ]
          }
        }
      ]
    },
