          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nariko ndasaba uwu mwana, none ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
          "text": " yampaye ico namusavye. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.27",
            "verseOrgIds": [
              "1SA.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "None ubu ndamushikaniye ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "text": ". Ubuzima bwiwe bwose azoba ari uw’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "text": ".” Maze bapfukamira ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
              "1SA.1.28"
            ]
          }
        },
        {
          "text": " baramusenga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.28",
            "verseOrgIds": [
