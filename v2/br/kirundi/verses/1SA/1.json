          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaze kumucutsa, ajana wa muhungu, naho yari akiri muto, n’ishuri imaze imyaka itatu, n’ifu ingana n’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "1:24",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 16.",
              "type": "text"
            }
          ]
        },
        {
          "text": " n’umukuza w’umuvinyu, amujana mu nzu y’",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
        {
          "text": " i Shilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.24",
            "verseOrgIds": [
              "1SA.1.24"
            ]
          }
        },
