          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamaze gutanga ya shuri kw’ikimazi, bazanira Eli wa muhungu, ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.25",
            "verseOrgIds": [
              "1SA.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "nyina wiwe aramubwira ati: “Nyakwubahwa, urakaramba! Ndi wa mugore nahagarara i ruhande yawe nsenga ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.1.26",
            "verseOrgIds": [
              "1SA.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
