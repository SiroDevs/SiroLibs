          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiriko aravuga, haza uwundi avuga ati: “Umuriro w’Imana watibutse uvuye mw’ijuru, uturira intama zose n’abungere bazo. Ni jewe jenyene nje kukubwira iyi inkuru narokotse!”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.16",
            "verseOrgIds": [
              "JOB.1.16"
            ]
          }
        }
