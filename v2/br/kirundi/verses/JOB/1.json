            "number": "13",
            "style": "v",
            "sid": "JOB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe abahungu n’abakobwa ba Yobu bari mu misi mikuru, barya bongera banywa umuvinyu i muhira ku muhungu mukuru, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.13",
            "verseOrgIds": [
              "JOB.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "maze haza umuntu abwira Yobu ati: “Inka zariko zirarima n’indogoba zariko zirarisha hafi yazo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.14",
            "verseOrgIds": [
              "JOB.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "hanyuma haza Abasabeyani barazitwara zose. Abakozi bose babicishije inkota. Ni jewe jenyene nje kukubwira iyi inkuru narokotse!”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.15",
            "verseOrgIds": [
              "JOB.1.15"
            ]
          }
        }
      ]
    },
