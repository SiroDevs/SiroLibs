          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we nyene akiriko aravuga, haza uwundi avuga ati: “Abakaludaya baje bari mu mice itatu, batwara ingamiya zawe zose. Abungere bazo bose babicishije inkota. Ni jewe jenyene nje kukubwira iyi inkuru narokotse!”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        }
      ]
    },
