            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Satani yishura ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "text": " ati: “Erega Yobu ntiyubaha Imana ku busa gusa. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.9",
            "verseOrgIds": [
              "JOB.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wamubereye nk’igihome kimukingira impande zose, we n’umuryango wiwe wose. Wahezagiye ibikorwa vy’amaboko yiwe, bituma ibitungwa vyiwe vyuzura mu gihugu cose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.10",
            "verseOrgIds": [
              "JOB.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko hamwe woramvura ukuboko kwawe, ukamwaka ivyo afise vyose, nta nkeka yoca akuvuma imbonankubone.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.11",
            "verseOrgIds": [
              "JOB.1.11"
            ]
          }
        }
      ]
    },
