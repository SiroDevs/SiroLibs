        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        },
        {
          "text": " abaza Satani ati: “Mbe wabonye umusavyi wanje Yobu? Nta muntu n’umwe ameze nka we kw’isi. Ntagira umugayo kandi ni umugororotsi; ni umuntu yubaha Imana akanka ikibi cose.”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.8",
            "verseOrgIds": [
              "JOB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 1:8"
          },
          "items": [
            {
