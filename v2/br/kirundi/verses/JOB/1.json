            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we nyene akiriko aravuga, haza uwundi avuga ati: “Abahungu bawe n’abakobwa bawe bari mu misi mikuru barya bongera banywa umuvinyu mu rugo rw’umuhungu mukuru, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "hanyuma haza umuyaga w’igihuhusi ukomeye cane uturutse mu bugaragwa, unyiganyiza inzu ku mpande zayo zose. Yabaguyeko none bapfuye bose. Ni jewe jenyene nje kukubwira iyi inkuru narokotse!”",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.19",
            "verseOrgIds": [
              "JOB.1.19"
            ]
          }
        }
      ]
