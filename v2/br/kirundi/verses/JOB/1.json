            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        },
        {
          "text": " abarira Satani ati: “Ehe nshize ivyo atunze vyose mu maboko yawe, ariko ubuzima bwiwe ntubukozeko n’urutoke.” Nuko Satani ava imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        },
        {
          "text": ", aragenda.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.12",
            "verseOrgIds": [
              "JOB.1.12"
            ]
          }
        }
      ]
