        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.38",
            "verseOrgIds": [
              "1CO.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1CO 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero bene Data, mwipfuze kuvugishwa n’Imana, kandi ntimubuze abavugishwa n’Imana mu ndimi zitamenyekana. ",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.39",
            "verseOrgIds": [
              "1CO.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1CO 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko vyose bikorwe mu buryo bubereye, kandi mu rutonde.",
          "type": "text",
          "attrs": {
            "verseId": "1CO.14.40",
            "verseOrgIds": [
              "1CO.14.40"
            ]
          }
        }
