            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze: ati: “Nk’uko nafashe ingingo yo kubateza ivyago no kutabagirira akagongwe igihe ba sogokuruza banyu bandatsa,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze, ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.14",
            "verseOrgIds": [
              "ZEC.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ZEC 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ni ko n’ubu mfashe ingingo yo gusubira kugirira neza Yerusalemu n’i Buyuda. Ntimutinye. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.15",
            "verseOrgIds": [
              "ZEC.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ZEC 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo mukwiye gukora: muvugane ukuri na bagenzi banyu, kandi muce imanza z’ukuri kandi zibereye mu bucamanza bwanyu; ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.16",
            "verseOrgIds": [
              "ZEC.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ZEC 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntimugire inama zo kugirira bagenzi banyu nabi, kandi ntimukunde kurahira ibinyoma. Ivyo ndavyanka,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        },
        {
          "text": " avuze.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.17",
            "verseOrgIds": [
              "ZEC.8.17"
            ]
          }
        }
      ]
    },
