        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        },
        {
          "text": " avuze: “Nzogaruka i Siyoni mbe muri Yerusalemu. Maze Yerusalemu hazokwitwa igisagara co kwizigirwa, kandi umusozi w’",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        },
        {
          "text": " Mushoboravyose uzokwitwa Umusozi Wera.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.3",
            "verseOrgIds": [
              "ZEC.8.3"
            ]
          }
        }
      ]
