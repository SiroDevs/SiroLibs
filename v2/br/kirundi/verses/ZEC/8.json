              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze: “Nzokiza abantu banje ndabakure mu bihugu vyo mu buseruko n’ivyo mu burengero. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.7",
            "verseOrgIds": [
              "ZEC.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzobagarukana ngo babe i Yerusalemu; bazoba abantu banje, nanje nzoba umwizigirwa n’umugororotsi kuko ndi Imana yabo.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.8",
            "verseOrgIds": [
              "ZEC.8.8"
            ]
          }
        }
      ]
    },
    {
