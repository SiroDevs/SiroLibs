            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze: “Abatama n’abatamakazi bazosubira kandi kugendagenda mu mabarabara y’i Yerusalemu, umwe wese yitwaje inkoni kubera ubusaza. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.4",
            "verseOrgIds": [
              "ZEC.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amayira y’igisagara azokwuzura abahungu n’abakobwa bakiniraho.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.5",
            "verseOrgIds": [
              "ZEC.8.5"
            ]
          }
        }
      ]
    },
