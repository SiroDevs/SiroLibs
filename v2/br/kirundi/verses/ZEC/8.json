        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze: “None rero nimwumve aya majambo: amaboko yanyu nakomere, mwubake urusengero. Ibi ni vyo nyene abavugishwa n’Imana bavuze igihe itanguriro ry’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "text": " Mushoboravyose ryashirwaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.9",
            "verseOrgIds": [
              "ZEC.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere y’aho nta muntu yatanga impembo y’umukozi yo ku musi canke ngo akoteshe inka. Nta n’umwe yaja ku bikorwa vyiwe ngo agaruke amahoro kubera abansi, kandi kuko nari nahinduye umwe wese ngo abe umwansi wa mugenziwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.10",
            "verseOrgIds": [
              "ZEC.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ubu nzogirira amasigarira y’ubu bwoko nk’uko nabagirira kera,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.11",
            "verseOrgIds": [
              "ZEC.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
