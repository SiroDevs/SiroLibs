            "verseOrgIds": [
              "ZEC.8.2"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze: “Mfise ipfuhe ryinshi ku bwa Siyoni; ndahafitiye ipfuhe rirurumba muri jewe kurya kw’umuriro.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.8.2",
