          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mbaza uwo mumarayika nti: “Ibi biti vy’imyelayo bibiri kimwe i buryo ikindi i bubamfu bw’igiterekwako amatara bisigura iki?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.11",
            "verseOrgIds": [
              "ZEC.4.11"
            ]
          }
        }
      ]
    },
