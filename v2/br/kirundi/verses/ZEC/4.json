          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uri nde wewe wubahuka kugaya ibintu kuko bikiri bito biri mu ntango? Nayo arya matara indwi yerekana inyonga z’",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        },
        {
          "text": " zigendagenda mw’isi yose, kandi azonezerwa abonye karisho mu kuboko kwa Zerubabeli?”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.10",
            "verseOrgIds": [
              "ZEC.4.10"
            ]
          }
        }
      ]
    },
