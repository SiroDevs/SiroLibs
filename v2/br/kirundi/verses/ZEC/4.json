              "ZEC.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa musozi munini we, uri iki? Imbere ya Zerubabeli uzohinduka ikiyaya. Maze na we azozana ibuye rya nyuma rigumya imfuruka, kandi abantu na bo bazosemerera bavuga bati: ‘Mana rihezagire! Mana rihezagire!’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.7",
            "verseOrgIds": [
              "ZEC.4.7"
            ]
          }
        }
      ]
    },
