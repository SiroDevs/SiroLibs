          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda bumvise ayo majambo, baca basubira gucanamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.19",
            "verseOrgIds": [
              "JHN.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Benshi muri bo bavuga bati: “Aboshwe n’umudayimoni kandi arasara. Ni kuki mumwumviriza?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.20",
            "verseOrgIds": [
              "JHN.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.20",
            "verseOrgIds": [
              "JHN.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abandi bavuga bati: “Aya majambo si ay’umuntu aboshwe n’umudayimoni. Mbega umudayimoni yohumura amaso y’impumyi?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.10.21",
            "verseOrgIds": [
              "JHN.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
