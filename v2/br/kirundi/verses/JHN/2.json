              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ari i Yerusalemu ku Musi mukuru wa Pasika, abantu benshi baramwizeye babonye ibitangaza akora. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.2.23",
            "verseOrgIds": [
