          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiyari akeneye ko bamubwira uko umuntu ameze, kuko yari azi ibiri mu mutima w’umuntu wese.",
          "type": "text",
          "attrs": {
