          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petero na we ati: “Mwami, nimba ari uko rero ntunyoze ibirenge gusa, unyoze n’ibiganza n’umutwe na vyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.9",
            "verseOrgIds": [
              "JHN.13.9"
            ]
          }
        }
      ]
