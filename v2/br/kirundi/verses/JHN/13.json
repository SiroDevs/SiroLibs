          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko mu bariko barasangira na we nta n’umwe yamenye igituma amubwiye ayo majambo. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.28",
            "verseOrgIds": [
              "JHN.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubera Yuda ari we yari ajejwe ikigega, bamwe bibajije ko Yesu amusavye kugura ibikenewe vy’umusi mukuru, canke kugira ico aha abakene. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.29",
            "verseOrgIds": [
              "JHN.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda agiheza kurya wa mukate, aca arasohoka kandi hari mw’ijoro.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.30",
            "verseOrgIds": [
              "JHN.13.30"
            ]
          }
        }
