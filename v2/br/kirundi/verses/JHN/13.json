              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ahejeje kuvuga ayo majambo, agira uruhagarara mu mutima wiwe, maze abivuga icese, ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.21",
