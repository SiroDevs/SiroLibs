              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simoni Petero amuvunira akagohe, amubwira ati: “Mubaze uwo ari we.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.24",
            "verseOrgIds": [
              "JHN.13.24"
            ]
