            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramwishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
        {
          "text": " Yesu ahejeje kuwukoza mw’isahani awuha Yuda, mwene Simoni Isikariyote. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.26",
            "verseOrgIds": [
              "JHN.13.26"
            ]
          }
        },
