          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda amaze kurya uwo mukate, Satani aca amwinjiramwo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.27",
            "verseOrgIds": [
              "JHN.13.27"
            ]
          }
        }
