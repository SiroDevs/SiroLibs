          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu yari azi uwugiye kumugurisha, ni co gituma yavuze ko batari batunganye bose.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.11",
