            "number": "22",
            "style": "v",
            "sid": "JHN 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigishwa barabana mu maso, bibaza uwo ariko aravuga. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.22",
            "verseOrgIds": [
              "JHN.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe muri bo, uwo Yesu yakunda, yari yegamiye mu gikiriza ca Yesu bari ku meza. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.13.23",
            "verseOrgIds": [
              "JHN.13.23"
            ]
          }
        },
