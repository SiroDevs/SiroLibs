          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.33",
            "verseOrgIds": [
              "JHN.9.33"
            ]
          }
