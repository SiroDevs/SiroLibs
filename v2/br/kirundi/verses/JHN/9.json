          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muntu aramubaza ati: “Yoba ari nde ga nyakwubahwa, kugira ngo ndamwizere?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.36",
            "verseOrgIds": [
              "JHN.9.36"
            ]
          }
        }
