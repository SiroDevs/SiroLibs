          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baramwishura bati: “Wewe wavukiye mu vyaha wongera ubikuriramwo, none uriko uratwigisha!” Nuko baca baramwirukana mu rusengero.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.9.34",
            "verseOrgIds": [
              "JHN.9.34"
            ]
          }
        }
      ]
    },
