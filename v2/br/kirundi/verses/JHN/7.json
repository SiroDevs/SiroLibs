            "number": "32",
            "style": "v",
            "sid": "JHN 7:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.32",
            "verseOrgIds": [
              "JHN.7.32"
            ]
          }
        },
        {
