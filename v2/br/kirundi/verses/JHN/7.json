              "JHN.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 7:8"
          },
          "items": [
            {
              "text": "8",
