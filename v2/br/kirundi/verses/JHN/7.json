          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 7:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
