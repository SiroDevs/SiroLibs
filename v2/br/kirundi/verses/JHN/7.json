          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.9",
            "verseOrgIds": [
              "JHN.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bene nyina bamaze kugenda ku musi mukuru, Yesu na we aragenda ariko ntiyajayo ku mugaragaro, agenda yinyegeje. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.10",
            "verseOrgIds": [
              "JHN.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo musi mukuru, abakuru b’Abayuda bariko bararondera Yesu, babazanya bati: “Ari he?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.11",
            "verseOrgIds": [
              "JHN.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi mw’isinzi ry’abantu bari ngaho, hari urusaku rwinshi bavugana ku vya Yesu. Bamwe bavuga bati: “Ni umuntu mwiza.”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abandi bakavuga bati: “Oya, ni umuntu azimiza abantu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.12",
            "verseOrgIds": [
              "JHN.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nta n’umwe yubahuka kuvuga ivyiwe ku mugaragaro kuko batinya Abayuda.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.13",
            "verseOrgIds": [
              "JHN.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
