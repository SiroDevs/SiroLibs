              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.6",
            "verseOrgIds": [
              "JHN.7.6"
            ]
