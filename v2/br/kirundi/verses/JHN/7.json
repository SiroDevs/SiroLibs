          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi mukuru ugeze hagati, Yesu yinjira mu rusengero atangura kwigisha. ",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.14",
            "verseOrgIds": [
              "JHN.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abayuda bamwumvise baratangara, barabazanya bati: “Uwo mugabo azi vyinshi cane kandi atize. Ivyo bishoboka gute?”",
          "type": "text",
          "attrs": {
            "verseId": "JHN.7.15",
            "verseOrgIds": [
              "JHN.7.15"
            ]
          }
        }
