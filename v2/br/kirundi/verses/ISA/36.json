          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abari ngaho baguma banumye, ntihagira ico bishura, kuko umwami yari yabihanikirije ati: “Ntihagire na kimwe mumwishura.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.36.21",
            "verseOrgIds": [
              "ISA.36.21"
            ]
          }
        }
      ]
