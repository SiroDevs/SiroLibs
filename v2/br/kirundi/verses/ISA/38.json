              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "riti: “Genda ubwire Hezekiya uti: uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "text": ", Imana ya sogokuruza Dawidi avuze: ‘Numvise ugusenga kwawe, kandi nabonye n’amarira yawe; ndakwongeye iyindi myaka cumi n’itanu yo kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.5",
            "verseOrgIds": [
              "ISA.38.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi iki gisagara nzogikura mu maboko y’umwami w’i Ashuri. Iki gisagara nzokigwanira.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.6",
            "verseOrgIds": [
              "ISA.38.6"
            ]
          }
        }
