            "style": "v",
            "sid": "ISA 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzosubiza inyuma amatambwe cumi; igitutu cazanywe n’izuba, mpereye ku ngazi ya Ahazi.’ ” Ca gitutu gisubira inyuma amatambwe cumi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
