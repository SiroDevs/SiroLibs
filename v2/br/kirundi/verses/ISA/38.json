              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni yo majambo Hezekiya, umwami w’i Buyuda yanditse, amaze gukira ingwara yari agwaye.",
          "type": "text",
          "attrs": {
