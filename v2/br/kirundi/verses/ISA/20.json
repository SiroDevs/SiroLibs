            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "text": " aravuga ati: “Nk’uko umusavyi wanje Yesaya amaze imyaka itatu agenda ari gusa, ata n’ibirato yambaye, akabera Abanyegiputa n’Abanyetiyopiya imburi, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.3",
            "verseOrgIds": [
              "ISA.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ko umwami wa Ashuri azotwara Abanyegiputa nk’abanyagano, n’Abanyetiyopiya nk’imbohe, bari gusa, batambaye n’ibirato, ata co bakenyeye, kugira ngo Egiputa hamaramare. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.4",
            "verseOrgIds": [
              "ISA.20.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi abari bizigiye Etiyopiya, bakishimira Egiputa, bazotinya, baterwe n’isoni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.5",
            "verseOrgIds": [
              "ISA.20.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo musi, ababa muri iki kiyaya cegereye ikiyaga bazovuga bati: ‘Nimurabe ivyashikiye abo twari twishimiye, abo twari twahungiyeko ngo badukize umwami wa Ashuri. Mbega none tumukira gute?’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.6",
            "verseOrgIds": [
              "ISA.20.6"
            ]
          }
        }
      ]
