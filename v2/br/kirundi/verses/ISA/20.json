              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka kizigenza mu ntwaramiheto yarungikwa na Sarugoni, umwami wa Ashuri, gutera muri Ashidodi akahafata, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.1",
            "verseOrgIds": [
              "ISA.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ho ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        },
        {
          "text": " yavugisha Yesaya mwene Amozi, amubwira ati: “Niwambure ayo magunira, ukure n’ibirato wambaye.” Na we abigenza gutyo, maze agendagenda ari gusa, ata n’ibirato yambaye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.20.2",
            "verseOrgIds": [
              "ISA.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
