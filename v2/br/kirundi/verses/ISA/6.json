          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe mu baserafi aca aguruka aza aho ndi afise ikara ryaka mu ntoke, yokoje icuma cokora amakara ku gicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.6",
            "verseOrgIds": [
              "ISA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arinkoza ku munwa avuga ati: “Ehe raba iri kara rikoze ku munwa wawe, ukugabitanya kwawe ugukuweko, n’ivyaha vyawe urabihariwe.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.7",
            "verseOrgIds": [
              "ISA.6.7"
            ]
          }
        }
      ]
    },
