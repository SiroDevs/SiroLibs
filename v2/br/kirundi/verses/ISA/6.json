            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje nca ndishura nti: “Ndi hano ntuma!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
