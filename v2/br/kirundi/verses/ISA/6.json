          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nca numva ijwi ry’Imana ribaza riti: “Ni nde notuma? Ni nde yogenda mu gishingo cacu?”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.8",
            "verseOrgIds": [
              "ISA.6.8"
            ]
          }
        }
      ]
