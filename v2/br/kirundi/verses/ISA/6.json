              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka Uziya yapfa, nabonye Imana yicaye ku ntebe y’inganji ishizwe hejuru, imisozo y’ikanzu yayo yuzuye Ingoro. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.1",
            "verseOrgIds": [
              "ISA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaserafi bari hejuru yayo, umwumwe wese afise amababa atandatu. Amababa abiri bayipfukisha mu maso, yandi abiri bakayapfukisha amaguru yabo, ayandi abiri bakayagurukisha. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.2",
            "verseOrgIds": [
              "ISA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bahamagarana bavuga bati:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.3",
            "verseOrgIds": [
              "ISA.6.3"
            ]
          }
        }
      ]
    },
