              "ISA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nca ndatakamba nti: “Yewe jewe ndagowe, kuko iminwa yanje yanduye, kandi mba mu bantu bafise iminwa yanduye, none amaso yanje akaba abonye Umwami, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        },
        {
          "text": " Mushoboravyose!”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.6.5",
            "verseOrgIds": [
              "ISA.6.5"
            ]
          }
        }
      ]
    },
    {
