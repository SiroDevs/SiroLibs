          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nk’uko ijuru rishasha n’isi nshasha nzorema bizokwamaho, ni ko izina ryanyu n’uruvyaro rwanyu bizoramba,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
            "verseOrgIds": [
              "ISA.66.22"
            ]
          }
        },
        {
          "text": " avuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.22",
            "verseOrgIds": [
              "ISA.66.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 66:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuva mu mboneko z’ukwezi kumwe gushika mu z’ukundi, no kuva kw’Isabato kugeza ku yindi, abantu bose bazoza bampfukamire,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.23",
            "verseOrgIds": [
              "ISA.66.23"
            ]
          }
        },
        {
          "text": " avuze. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.23",
            "verseOrgIds": [
              "ISA.66.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ISA 66:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bazosohoka baje kuraba imivyimba y’abangararije; inyo zabo ntizizopfa, kandi umuriro wabo ntuzozima, kandi bazotera ishishi abantu bose.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.24",
            "verseOrgIds": [
              "ISA.66.24"
            ]
          }
        }
      ]
    }
