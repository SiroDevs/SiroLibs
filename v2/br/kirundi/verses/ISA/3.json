          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "amahereni, imiringa yo ku maboko, hamwe n’imyitwikiro, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.19",
            "verseOrgIds": [
              "ISA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ingori, imigufu yo ku maguru, uducupa tw’ibimota neza, utugirwamana, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.20",
            "verseOrgIds": [
              "ISA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "impeta zo ku ntoke n’izo ku mazuru, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.21",
            "verseOrgIds": [
              "ISA.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ISA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "amakanzu mezameza, impuzu zo kurenza hejuru n’udusaho, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.22",
            "verseOrgIds": [
              "ISA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
