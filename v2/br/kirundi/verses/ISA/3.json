              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri uwo musi Imana izokuraho ubwiza bw’ivyambarwa vyabo: ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.3.18",
            "verseOrgIds": [
              "ISA.3.18"
            ]
          }
        },
        {
