              "ISA.22.14"
            ]
          }
        },
        {
          "text": " Mushoboravyose yampishuriye ibi nanje ndiko ndumviriza: “No gushika ku musi muzopfirako, ico caha ntikizoharirwa,” ni ko Umwami, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.22.14",
            "verseOrgIds": [
              "ISA.22.14"
            ]
          }
        },
        {
          "text": " Mushoboravyose, avuze.",
