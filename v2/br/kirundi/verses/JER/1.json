          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe, uwu musi ndagutumye ku mahanga no ku bwami kurandura no gusambura, gutikiza no gusangangura, kwubaka no guteragira.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.10",
            "verseOrgIds": [
              "JER.1.10"
            ]
          }
        }
