            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni amajambo ya Yeremiya mwene Hilukiya, umwe mu baherezi baba ahantu hitwa Anatoti mu ntara ya Benyamini. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.1",
            "verseOrgIds": [
              "JER.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "text": " ryatumwe kuri we mu mwaka ugira cumi na gatatu Yosiya mwene Amoni umwami w’i Buyuda ari ku ngoma, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.2",
            "verseOrgIds": [
              "JER.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "no ku ngoma ya Yehoyakimu mwene Yosiya umwami w’i Buyuda. Ryongeye gutumwa kuri we mu kwezi kwa gatanu kw’umwaka ugira icumi na rimwe Zedekiya mwene Yosiya umwami w’i Buyuda ari ku ngoma, kandi ico gihe ni ho abantu b’i Yerusalemu batwarwa ari inyagano mu mahanga.",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.3",
            "verseOrgIds": [
              "JER.1.3"
            ]
          }
        }
      ]
    },
