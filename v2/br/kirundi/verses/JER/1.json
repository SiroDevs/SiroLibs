              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndishura nti: “Mbona ishami ry’igiti ca alumonde.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.11",
            "verseOrgIds": [
              "JER.1.11"
