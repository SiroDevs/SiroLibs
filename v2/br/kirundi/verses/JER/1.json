          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngira mpamagare amahanga yose y’abami bo mu buraruko,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.15",
            "verseOrgIds": [
              "JER.1.15"
            ]
          }
        },
