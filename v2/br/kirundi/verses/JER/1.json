            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
          "text": " arambwira ati: “Reka kuvuga uti: ‘Ndacari muto.’ Uzoja ku wo nzogutumako umubwire ico nzogutuma cose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.7",
            "verseOrgIds": [
              "JER.1.7"
            ]
          }
        },
        {
