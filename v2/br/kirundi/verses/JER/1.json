            "verseOrgIds": [
              "JER.1.14"
            ]
          }
        },
        {
          "text": " ambwira ati: “Ivyago bizoza bivuye mu buraruko bije ku baba muri iki gihugu bose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.14",
            "verseOrgIds": [
              "JER.1.14"
            ]
