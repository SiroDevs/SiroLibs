              "type": "text"
            }
          ]
        },
        {
          "text": "Ndishura nti: “Mbona inkono iriko irabira, iri ku ruhande rwo mu buraruko.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.1.13",
            "verseOrgIds": [
              "JER.1.13"
            ]
