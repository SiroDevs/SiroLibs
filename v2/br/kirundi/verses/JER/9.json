              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni nde w’umunyabwenge ashobora gutahura ibi? Ni nde yigishijwe n’",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        },
        {
          "text": " ku buryo ashobora kubisobanura? Ni kuki igihugu casambuwe kigahinduka umusaka nk’ubugaragwa ata wokwubahuka gucamwo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.9.12",
            "verseOrgIds": [
              "JER.9.12"
            ]
          }
        }
      ]
