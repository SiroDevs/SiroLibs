            ]
          }
        },
        {
          "text": " avuze: “Nimba abatari bakwiye kunywa ku gikombe bategerezwa kukinywako, ni kuki mwogenda mudahanywe? Ntimuzogenda mudahanywe, ariko muzotegerezwa kukinywako. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.12",
            "verseOrgIds": [
              "JER.49.12"
            ]
