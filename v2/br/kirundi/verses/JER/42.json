          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.18",
            "verseOrgIds": [
              "JER.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yemwe masigarira ya Yuda, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "text": " arababwiye ati: “Ntimuje muri Egiputa.” Nimumenye ibi mudakekeranya: ndababuriye uwu musi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.19",
            "verseOrgIds": [
              "JER.42.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko mwakoze ikosa ry’agacamutwe igihe mwantuma k’",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "text": " Imana yanyu mukavuga muti: “Dusengere k’",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "text": " Imana yawe; utubwire ivyo aza kuvuga vyose kugira ngo natwe tubikore.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.20",
            "verseOrgIds": [
              "JER.42.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 42:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndababwiye uwu musi, ariko n’ubu ntimurumvira ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "text": " Imana yanyu mu vyo yantumye kubabwira vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.21",
            "verseOrgIds": [
              "JER.42.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 42:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko rero, mumenye ibi mudakekeranya: muzopfa mwishwe n’inkota, ikigoyi n’ikiza muri aho mugomba kuja kuba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.42.22",
            "verseOrgIds": [
              "JER.42.22"
            ]
          }
        }
      ]
    }
