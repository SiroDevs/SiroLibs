          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo nca ndikangura nderaguza hirya no hino. Itiro ryanje ryari riryoshe cane.",
          "type": "text",
          "attrs": {
            "verseId": "JER.31.26",
            "verseOrgIds": [
              "JER.31.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
