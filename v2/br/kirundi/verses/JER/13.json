          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashize imisi ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "text": " arambwira ati: “Ubu na ho genda i Perati maze uzane wa mukanda nakubwira ngo ugende unyegezeyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.6",
            "verseOrgIds": [
              "JER.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nja i Perati nzura wa mukanda ndawukura aho nari narawunyegeje, ariko wari wononekaye rwose ata woshobora kuwukoresha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.13.7",
            "verseOrgIds": [
              "JER.13.7"
            ]
          }
        }
      ]
    },
    {
