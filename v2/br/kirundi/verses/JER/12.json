          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "text": " avuze: “Ku babanyi banje babi bafashe ishamvu nahaye abantu banje b’Abisirayeli, nzobarandura ndabakure mu bihugu vyabo ndandure n’inzu ya Yuda ndayikure hagati muri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.14",
            "verseOrgIds": [
              "JER.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ninamara kubarandura, nzosubira ndabagirire imbabazi ngarukane umwe wese wo muri bo mw’ishamvu yiwe no mu gihugu ciwe bwite. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.15",
            "verseOrgIds": [
              "JER.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nibiga neza inzira z’abantu banje bakarahira mw’izina ryanje, bavuga bati: ‘Ni ukuri nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "text": " ari muzima,’ naho babanje kwigisha abantu banje ngo barahire mw’izina rya Bayali, nuko bazoronka ikibanza mu bantu banje. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.16",
            "verseOrgIds": [
              "JER.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nihagira ihanga na rimwe ritumvira, nzorirandura rwose kandi ndariherengeteze,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        },
        {
          "text": " avuze.",
          "type": "text",
          "attrs": {
            "verseId": "JER.12.17",
            "verseOrgIds": [
              "JER.12.17"
            ]
          }
        }
      ]
    }
