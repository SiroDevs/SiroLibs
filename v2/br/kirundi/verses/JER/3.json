          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jewe ubwanje navuze nti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
