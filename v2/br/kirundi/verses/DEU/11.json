        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe raba uwu musi mbashize imbere imigisha n’imivumo, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "imihezagiro mu gihe mwemeye kwumvira aya mabwirizwa y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "text": " Imana yanyu, ayo ndabahaye uno musi, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "imivumo nimwanka kwumvira aya mabwirizwa y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "text": " Imana yanyu, mukava mu nzira yabategetse kugenderamwo, mugasenga izindi mana mutari bwabone. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imana yanyu niyabashikana muri ico gihugu mukagifata, muzokwaturire imigisha ku musozi Gerizimu, imivumo na yo muzoyivugire ku musozi Ebalu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo misozi yose iri hakurya ya Yorodani, mu ntara y’Abanyakanani, amaja mu burengero, hafi y’ibiti vya More, mu ntara y’Abanyakanani baba muri Araba hafi y’igisagara ca Gilugali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehe mugira mujabuke Yorodani mufate igihugu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "text": " Imana yanyu abahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwagishikamwo mukakibamwo, muzoshire imitima yanyu ku gukurikiza amategeko n’ivyagezwe ndabahaye uwu musi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
            "verseOrgIds": [
              "DEU.11.32"
            ]
          }
        }
      ]
