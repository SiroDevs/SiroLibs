  "reference": "Gusubiramwo 11",
  "verseCount": 32,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "DEU 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukunde ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "text": " Imana yanyu, mukurikize ivyo ababwiye, amategeko, amabwirizwa n’ivyagezwe vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.1",
            "verseOrgIds": [
              "DEU.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uno musi, mwibuke ko atari abana banyu babonye kandi baronse indero y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "text": " Imana yanyu ikoresheje icubahiro cayo, ukuboko kwayo kw’ubushobozi kandi kuramvuye; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.2",
            "verseOrgIds": [
              "DEU.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "si bo babonye ibimenyetso n’ibitangaza yakoreye hagati muri Egiputa, kuri Farawo umwami no ku gihugu ciwe cose ca Egiputa; ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.3",
            "verseOrgIds": [
              "DEU.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "text": " yakoreye ingabo zose za Egiputa, amafarasi n’imikogote vyabo, ingene yabisutse mu Kiyaga Gitukura, igihe bariko barabakurikira, n’ingene yabagesheje ubutakivayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.4",
            "verseOrgIds": [
              "DEU.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Si abana banyu babonye ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
        {
          "text": " yabakoreye kuva igihe mwari mu bugaragwa kugeza mushitse muri iki kibanza, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.5",
            "verseOrgIds": [
              "DEU.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "si bo babonye ivyo yakoreye Datani na Abiramu, bene Eliyabu wo mu muryango wa Reyubeni, igihe isi yasama hagati mu Bisirayeli ikabamirana n’abo mu nzu zabo bose, amahema yabo n’ikintu cabo cose gihumeka. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.6",
            "verseOrgIds": [
              "DEU.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko, amaso yanyu ni yo yiboneye ivyo bitangaza vyose ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        },
        {
          "text": " yakoze.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.7",
            "verseOrgIds": [
              "DEU.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero mwirinde, kugira ngo muzokurikize amabwirizwa ndabahaye uwu musi, kugira ngo muronke inkomezi zo kujabuka Yorodani no kwinjira muri ico gihugu mukagifata, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.8",
            "verseOrgIds": [
              "DEU.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo muzoshobore kurambira muri ico gihugu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.9",
            "verseOrgIds": [
              "DEU.11.9"
            ]
          }
        },
        {
          "text": " yarahiye ba sogokuruza ko azokibaha hamwe n’uruvyaro rwabo, igihugu gitemba amata n’ubuki. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.9",
            "verseOrgIds": [
              "DEU.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu mugiye kwinjiramwo mukacegukira ntikimeze nka Egiputa mwahoramwo, aho mwaruha muvomera ibiterwa vyose nk’uwuvomera imboga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.10",
            "verseOrgIds": [
              "DEU.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko igihugu mugiye kwinjiramwo mukacegukira ni igihugu c’imisozi n’ibiyaya kivomererwa n’imvura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.11",
            "verseOrgIds": [
              "DEU.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni igihugu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        },
        {
          "text": " Imana yanyu we nyene yitaho, inyonga ziwe zama kuri co kuva ku ntango y’umwaka gushika mu mpera yawo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.12",
            "verseOrgIds": [
              "DEU.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rero nimwumvira mugakurikiza ivyo amabwirizwa ndabahaye uwu musi avuga, ni ukuvuga gukunda ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "text": " Imana yanyu no kumukorera n’imitima yanyu yose n’imishaha yanyu yose, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.13",
            "verseOrgIds": [
              "DEU.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na we, azorungika imvura mu gihe cayo, iy’agatasi n’iy’impeshi, kugira ngo mushobore kwimbura ingano, imivinyu n’amavuta ya elayo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.14",
            "verseOrgIds": [
              "DEU.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azotanga ubwatsi mu buragiro bw’ibitungwa vyanyu, kandi namwe muzoronka ivyo murya muhage.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
            "verseOrgIds": [
              "DEU.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.15",
            "verseOrgIds": [
              "DEU.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko rero mwirinde, mwoye guhendwa mu mitima yanyu ngo muve k’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.16",
            "verseOrgIds": [
              "DEU.11.16"
            ]
          }
        },
        {
          "text": " Imana yanyu, mukorere izindi mana mwongere muzisenge. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.16",
            "verseOrgIds": [
              "DEU.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwabikora, uburake bw’Imana buzoziriringa kuri mwebwe, hanyuma azokwugara ijuru ntiribe rigitanga imvura, kandi isi ntizoba ikimera ibiterwa. Namwe muzotikirira muri ico gihugu ciza cane ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "text": " abahaye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.17",
            "verseOrgIds": [
              "DEU.11.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya majambo yanje muyashire mu mitima yanyu no mu bwenge bwanyu, muyabohere ku maboko no mu ruhanga nk’ivyibutso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.18",
            "verseOrgIds": [
              "DEU.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzoyigishe abana banyu, muyaganireko iyo mwicaye i muhira n’iyo muri ku rugendo, iyo mugiye kuryama n’iyo muvyutse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.19",
            "verseOrgIds": [
              "DEU.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzovyandike ku bishimaryango vy’amazu yanyu, no ku nzugi z’amarembo yanyu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.20",
            "verseOrgIds": [
              "DEU.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo mwe n’abana banyu muzorambire muri ico gihugu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        },
        {
          "text": " yarahiye ba sogokuruza ko azokibaha, gushika igihe ijuru rizoba rikiri hejuru y’isi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwakurikiza neza amabwirizwa mbahaye uno musi, ari yo gukunda ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "text": " Imana yanyu, kugendera mu nzira ziwe zose no kwifatanya na we, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " na we azokwirukana ayo mahanga yose imbere yanyu, naho ari maninimanini cane, akomeye cane kubarusha, kandi muzoyigarurira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.23",
            "verseOrgIds": [
              "DEU.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho muzohonyoza ikirenge hose hazoba bahaye ahanyu. Imbibe zanyu zizova ku bugaragwa bw’i Libani, no ku ruzi Efurate zishike ku Kiyaga Mediterane co mu burengero. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta muntu n’umwe azoshobora kubahagarara imbere ngo abagwanye, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "text": " Imana yanyu azogwisha abantu igihumura kubera mwebwe, aho muzoja hose, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "text": " yabibasezeraniye.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
