          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bazokwishura bati: ‘Ni kubera abantu bataye isezerano ry’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
        {
          "text": ", Imana ya ba sekuruza, isezerano yabagiriye igihe yabakura muri Egiputa. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.25",
            "verseOrgIds": [
              "DEU.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barayitaye basenga izindi mana, barazunamira, imana batari bwigere babona, imana zitari zivuye k’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.26",
            "verseOrgIds": [
              "DEU.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co catumye uburake bw’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        },
        {
          "text": " bururumbira iki gihugu, maze agishitsako imivumo yose yanditse muri iki gitabu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.27",
            "verseOrgIds": [
              "DEU.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
