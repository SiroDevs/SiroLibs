          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " yabaranduranye uburake bwinshi, abakura mu gihugu cabo, abirukanira mu kindi gihugu iyo bari gushika n’ubu.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.28",
            "verseOrgIds": [
              "DEU.29.28"
            ]
          }
