          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amahanga yose azobaza ati: ‘Ni kubera iki ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        },
        {
          "text": " yakoreye ibi iki gihugu? Ni kubera iki yagisutseko ubu burake bw’inkazi?’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.24",
            "verseOrgIds": [
              "DEU.29.24"
            ]
          }
        }
      ]
