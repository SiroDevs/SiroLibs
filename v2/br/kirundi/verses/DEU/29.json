    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni yo majambo y’isezerano ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "text": " yatumye Mose ngo asezerane n’Abisirayeli mu gihugu c’i Mowabu, isezerano ryiyongera ku ryo yari yaragiranye na bo ku musozi Horebu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.1",
            "verseOrgIds": [
              "DEU.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akoranya Abisirayeli bose, arababwira ati: “Amaso yanyu yariboneye ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.2"
            ]
          }
        },
        {
          "text": " yakoze muri Egiputa, abikoreye Farawo, abatware biwe n’igihugu cose.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.2",
            "verseOrgIds": [
              "DEU.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaso yanyu yariboneye ivyo bigeragezo bikomeye, ivyo bimenyetso n’ivyo bitangaza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.3",
            "verseOrgIds": [
              "DEU.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko gushika uno musi ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.4",
            "verseOrgIds": [
              "DEU.29.4"
            ]
          }
        },
        {
          "text": " ntiyabahaye ubwenge butahura, amaso abona canke amatwi yumva. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.4",
            "verseOrgIds": [
              "DEU.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu myaka mirongo ine nabarongoye mu bugaragwa, impuzu zanyu n’ibirato vyanyu ntivyigeze bishira. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.5",
            "verseOrgIds": [
              "DEU.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta mukate mwariye, nta muvinyu canke ibindi binyobwa bituriranije mwanyoye. Ivyo nabibakoreye kugira ngo mumenye ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.6"
            ]
          }
        },
        {
          "text": " Imana yanyu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.6",
            "verseOrgIds": [
              "DEU.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe mwashika muri iki gihugu, Sihoni umwami wa Heshiboni na Ogi umwami w’i Bashani baje kubatera, ariko turabanesha. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.7",
            "verseOrgIds": [
              "DEU.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twafashe igihugu cabo tugiha umuryango wa Reyubeni nk’iragi ryawo, uwa Gadi hamwe n’igice c’umuryango wa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.8",
            "verseOrgIds": [
              "DEU.29.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.8",
            "verseOrgIds": [
              "DEU.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero muzokwitondere ibigize iri sezerano kugira ngo muzotere imbere mu vyo muzokora vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.9",
            "verseOrgIds": [
              "DEU.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwese muhagaze ngaha imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.10"
            ]
          }
        },
        {
          "text": " Imana yanyu: abakuru b’imiryango, abatware, namwe bagabo b’Abisirayeli mwese, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.10",
            "verseOrgIds": [
              "DEU.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "muri kumwe n’abana banyu, abagore banyu, muri kumwe kandi n’abanyamahanga baba mu makambi yanyu, babasenyera bakabavomera. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.11",
            "verseOrgIds": [
              "DEU.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhagaze ngaha kugira ngo mugiranire isezerano n’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "text": " Imana yanyu; iryo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "text": " agira agirane namwe uwu musi arishigikije indahiro, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.12",
            "verseOrgIds": [
              "DEU.29.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 29:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo abagire abantu biwe, na we abe Imana yanyu nk’uko yabirahiye ba sogokuruza banyu Aburahamu, Isaka na Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.13",
            "verseOrgIds": [
              "DEU.29.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 29:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri sezerano rishigikijwe indahiro sindarigiranye namwe muhagararanye natwe hano uwu musi imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.14",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        },
        {
          "text": " Imana yacu gusa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.14",
            "verseOrgIds": [
              "DEU.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko ndarigiranye n’urundi runganwe rutari hano uwu musi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.15",
            "verseOrgIds": [
              "DEU.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwanyu murazi ingene twabaye muri Egiputa n’ukuntu twarenganye ibihugu vyinshi kugira ngo dushike hano. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.16",
            "verseOrgIds": [
              "DEU.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwarabonye ibishushanyo vyabo biteye isoni, ibigirwamana vyabo bibajwe mu biti no mu mabuye hamwe n’ibicuzwe mu nzahabu no mw’ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.17",
            "verseOrgIds": [
              "DEU.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mwirinde ntihaze hagire umugabo, umugore, inzu canke umuryango n’umwe wo muri mwebwe uzokura umutima k’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "text": " Imana yanyu ngo basenge imana z’ayo mahanga. Muze mwirinde ntihaze hagire umuzi umera ukazana imbuto irura y’uburozi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.18",
            "verseOrgIds": [
              "DEU.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abumvise amajambo y’iyi ndahiro, ntimuzopfe kwiyaturako iyo migisha muvuga muti: ‘Tuzoba impore n’aho twokwigumira mu nzira zacu.’ Ivyo bizozanira guhona isi ibomvye co kimwe n’iyumye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.19",
            "verseOrgIds": [
              "DEU.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ntazobababarira, uburake bwiwe n’ishaka ryiwe bizobaziriringira. Imivumo yose yanditswe muri iki gitabu izobakurikirana, kandi ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "text": " azozimanganya amazina yabo musi y’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.20",
            "verseOrgIds": [
              "DEU.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " azobatandukanya n’iyindi miryango y’Abisirayeli, abarundeko imivumo yose iri mw’isezerano riri muri iki gitabu c’Ivyagezwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.21",
            "verseOrgIds": [
              "DEU.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uruvyaro rwanyu ruzokwaruka mu nyuma hamwe n’abanyamahanga bazoza bavuye mu bihugu vya kure bazobona ivyago vyashikiye igihugu canyu n’ingwara ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "text": " yagiteje. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.22",
            "verseOrgIds": [
              "DEU.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihugu canyu cose kizoba nk’ikiyigira gitongojwe umunyu n’ibizuku, nta kizosubira kuhaterwa, nta kizomera, nta bizosubira kuhakura. Hazoba agatikizo nk’akabaye i Sodomu, n’i Gomora, Adima na Zeboyimu, ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
            "verseOrgIds": [
              "DEU.29.23"
            ]
          }
        },
        {
          "text": " yasutseko uburake bwiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.23",
