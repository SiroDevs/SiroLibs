        {
          "text": "Ibikiri mw’ibanga ni ivy’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.29.29",
            "verseOrgIds": [
              "DEU.29.29"
            ]
          }
        },
        {
          "text": " Imana yacu, ariko ibintu bimaze guhishurwa ni ivyacu hamwe n’abana bacu ibihe vyose, kugira ngo dukurikize amajambo y’ibi Vyagezwe.",
          "type": "text",
