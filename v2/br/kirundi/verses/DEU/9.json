          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Napfukamiye ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "text": " ndamutakambira muri iyo misi mirongo ine n’amajoro mirongo ine, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "text": " yari yamaze gufata ingingo yo kubarandura. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.25",
            "verseOrgIds": [
              "DEU.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nasenze ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "text": " mvuga nti: “",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "text": " Nyeninganji, nturandure abantu bawe, ubwoko wiharije, abo wacunguje ububasha bwawe ukabakuza muri Egiputa ukuboko kwawe kw’inkomezi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.26",
            "verseOrgIds": [
              "DEU.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwibuke abasavyi bawe Aburahamu, Isaka na Yakobo, maze wirengagize ubugarariji bw’ubu bwoko, wirengagize ibibi n’ivyaha vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.27",
            "verseOrgIds": [
              "DEU.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwabarandura, Abanyegiputa bazovuga bati: ‘",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "text": " vyaramunaniye gushikana abantu biwe mu gihugu yabasezeraniye, kandi kubera abanka, yabakuye ino kugira ngo aje kubatikiriza mu bugaragwa.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.28",
            "verseOrgIds": [
              "DEU.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ni abantu bawe, ni inyegu yawe wakuje muri Egiputa ububasha bwawe n’ukuboko kwawe kw’inkomezi.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.29",
            "verseOrgIds": [
              "DEU.9.29"
            ]
          }
        }
      ]
