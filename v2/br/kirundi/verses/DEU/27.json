        },
        {
          "text": "‘Haravumwe umuntu azokwibazira ikigirwamana, ikintu gisesema ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
              "DEU.27.15"
            ]
          }
        },
        {
          "text": "; igikorwa c’amaboko y’umucuzi, akagishinga mu mpisho.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.27.15",
            "verseOrgIds": [
