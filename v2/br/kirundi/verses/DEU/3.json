              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko kubera mwebwe ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "text": " yari yarandakiye, ntiyemera no kunyumviriza. Yavuze ati: “Geza aho, ivyo birakwiye. Singomba kuzosubira kukwumva umbarira ikintu na kimwe kuri ivyo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.26",
            "verseOrgIds": [
              "DEU.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haguruka uduge ku musozi Pisiga, urabe mu burengero, mu buraruko, mu buseruko no mu bumanuko, wihweze ico gihugu n’amaso yawe, kuko utazojabuka Yorodani. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.27",
            "verseOrgIds": [
              "DEU.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko tegura Yosuwa, umutere intege kandi umukomeze, kuko ari we azorongora aba bantu, akabajabukana Yorodani akabafasha kwegukira ico gihugu uzobona.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.28",
            "verseOrgIds": [
              "DEU.3.28"
            ]
          }
        },
