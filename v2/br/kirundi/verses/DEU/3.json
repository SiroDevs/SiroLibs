          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ewe ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "text": " Nyeninganji, weretse abasavyi bawe ubukuru bwawe n’inkomezi z’ukuboko kwawe. Mbega ni iyihe Mana yindi mw’ijuru no mw’isi yokora ibikorwa bihambaye nk’ivyo ukora? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.24",
            "verseOrgIds": [
              "DEU.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndeka njabuke nshike hakurya mbone ubwiza bwa kiriya gihugu co hakurya ya Yorodani, kirya gihugu ciza c’imisozi miremire hamwe na Libani.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.25",
            "verseOrgIds": [
              "DEU.3.25"
            ]
          }
        }
