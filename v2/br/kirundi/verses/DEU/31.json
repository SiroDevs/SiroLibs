        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose yongera abwira Abisirayeli ati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.1",
            "verseOrgIds": [
              "DEU.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ehe raba maze imyaka ijana na mirongo ibiri, singishoboye kubarongora. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "text": " yambwiye ati: ‘Ntuzojabuka Yorodani.’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.2",
            "verseOrgIds": [
              "DEU.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " Imana yanyu ubwiwe azobagendera imbere. Azorandura amahanga yose ariyo, maze namwe mubanyage igihugu cabo. Yosuwa azobajabukana nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "text": " yabisezeranye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.3",
            "verseOrgIds": [
              "DEU.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " azogirira ayo mahanga nk’uko yagiriye Sihoni na Ogi abami b’Abamori, abo yaranduranye n’igihugu cabo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.4",
            "verseOrgIds": [
              "DEU.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " azobarekurira mu maboko yanyu, maze namwe muzobagire nk’uko yabategetse. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.5",
            "verseOrgIds": [
              "DEU.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushikame, mushire ubwoba. Ntimuzotinye ngo mucike intege kubera ayo mahanga, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        },
        {
          "text": " Imana yanyu azojana namwe. Ntazobaheba, ntazobata.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.6",
            "verseOrgIds": [
              "DEU.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose ahamagara Yosuwa, ahagarara imbere y’Abisirayeli, amubwira ati: “Shikama ushire ubwoba, kuko ari wewe uzotwara ubu bwoko mu gihugu ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "text": " yarahiye ba sekuruza babo ko azokibaha, kandi uzokibagaburire nk’iragi. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.7",
            "verseOrgIds": [
              "DEU.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " wenyene azogendera imbere yanyu. Ntazobata, ntazobaheba. Ntutinye kandi ntucike intege.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.8",
            "verseOrgIds": [
              "DEU.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose yandika ivyo Vyagezwe vyose mu gitabu, abiha abaherezi, ari bo bahungu ba Lewi, barerura Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "text": ", agiha n’abatware b’Abisirayeli bose. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.9",
            "verseOrgIds": [
              "DEU.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose ababarira ati: “Ku mpera y’umwaka wose ugira indwi, ari wo mwaka wo guheberanira imyenda, mu misi mikuru y’insago, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.10",
            "verseOrgIds": [
              "DEU.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "mu gihe Abisirayeli bazoba bakoraniye imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "text": " Imana yanyu mu kibanza azoba yaratoranije, muzosomere imbere y’Abisirayeli bose ibi Vyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.11",
            "verseOrgIds": [
              "DEU.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muzobakoranye bose: abagabo, abagore, abana n’abanyamahanga bazoba baba mu bisagara vyanyu, kugira ngo bumvirize bongere bige gutinya ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "text": " Imana bifatanije no kuyubaha, bongere bitondere aya majambo yose y’ibi Vyagezwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.12",
            "verseOrgIds": [
              "DEU.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abana babo batazi ibi vyagezwe bazovyumvirize bongere bige gutinya ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        },
        {
          "text": " Imana yanyu bifatanije no kuyubaha. Muzokwame mugenza gutyo ibihe vyose muzoba muri ico gihugu mugiye kujabuka Yorodani ngo mucinjire.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.13",
            "verseOrgIds": [
              "DEU.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Igihe cawe co gupfa kirageze. Hamagara Yosuwa muzanane mw’Ihema ry’Ibonaniro, kugira ngo ndamushikirize igikorwa.” Nuko Mose ajana na Yosuwa, binjira mw’ihema ry’ibonaniro.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.14",
            "verseOrgIds": [
              "DEU.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "text": " aza mu nkingi y’igicu, ahagarara mu rwinjiriro rw’Ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.15",
            "verseOrgIds": [
              "DEU.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " abarira Mose ati: “Ugiye kuruhuka, uhamvye ba sogokuruza. Niwamara kugenda, aba bantu bazokwigenza nka maraya mu kuja gusenga imana z’inyamahanga, imana zo muri iki gihugu bagira binjiremwo. Bazonta, barenge kw’isezerano nabagiriye. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.16",
            "verseOrgIds": [
              "DEU.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje uburake buzobaziriringira ndabate, ndabanyegeze mu nyonga hanje, kandi bazorandurwa. Ivyago vyinshi n’amagorwa menshi bizobashikako, kandi ico gihe bazovuga bati: ‘Ubwo ibi vyago ntibiriko bidushikako kuko Imana itari kumwe natwe?’ ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.17",
            "verseOrgIds": [
              "DEU.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe nanje koko nzobanyegeza mu nyonga hanje kubera ikibi bazoba bakoze mu guhindukirira izindi mana bakazisenga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.18",
            "verseOrgIds": [
              "DEU.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero niwandike aya majambo y’iyi ndirimbo, uyibigishe bayiririmbe, kugira ngo izombere icabona ku bwoko bw’Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.19",
            "verseOrgIds": [
              "DEU.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ninamara kubazana mu gihugu gitemba amata n’ubuki, igihugu nasezeranishije indahiro ba sogokuruza, bazotunga, barye, bahage, bavyibuhe. Ariko bazohindukira, basenge izindi mana, bante, barenge isezerano ryanje. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.20",
            "verseOrgIds": [
              "DEU.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyago n’amagorwa nivyabashikako, iyi ndirimbo izobabera icabona, kuko ntizokwigera yibagirwa mu ruvyaro rwabo. N’imbere y’uko ndabashikana mu gihugu nabasezeraniye ndahiye, ndazi ivyo biteguriye kuzokora.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.21",
            "verseOrgIds": [
              "DEU.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose yandika iyo ndirimbo aca ayigisha Abisirayeli kuri uwo musi nyene.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.22",
            "verseOrgIds": [
              "DEU.31.22"
            ]
          }
        }
      ]
    },
