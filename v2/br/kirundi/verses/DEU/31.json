      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.23",
            "verseOrgIds": [
              "DEU.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose amaze kwandika Ivyagezwe vyose mu gitabu, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.24",
            "verseOrgIds": [
              "DEU.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "aca aha icagezwe Abalewi barerura Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "text": " ati: ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.25",
            "verseOrgIds": [
              "DEU.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Akira iki Gitabu c’Ivyagezwe mugishire i ruhande y’Isandugu y’Isezerano, ry’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "text": " Imana yanyu. Kizokwame ngaho nk’icabona kuri mwebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.26",
            "verseOrgIds": [
              "DEU.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ndazi ko muri ubwoko bw’abagarariji n’intagondwa. Nimba mwagararije ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "text": " nkiri kumwe namwe, mbega ntimuzorushiriza kugarariza ninamara gupfa? ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.27",
            "verseOrgIds": [
              "DEU.31.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimunkoranirize abakuru b’imiryango yose hamwe n’abatware banyu kugira ngo aya majambo yose ndayavuge bumva, nongere ntore n’isi n’ijuru nk’ivyabona kuri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.28",
            "verseOrgIds": [
              "DEU.31.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 31:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko nzi neza ko ninamara gupfa muzokwononekara, mukava mu nzira nabategetse gucamwo. Mu bihe bizoza, ivyago bizobagwako kuko muzoba mwakoze ibibi imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        },
        {
          "text": ", ibikorwa vy’amaboko yanyu bikamutera kuraka.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.31.29",
            "verseOrgIds": [
              "DEU.31.29"
            ]
          }
        }
      ]
    },
