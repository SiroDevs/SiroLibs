          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko barabishitsa, barungikira imfashanyo zabo abakuru b’ishengero ry’i Yerusalemu, zijanwa na Baranaba na Sawuli.",
          "type": "text",
          "attrs": {
