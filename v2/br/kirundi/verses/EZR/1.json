            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyongeye, umwami Kuro asohora ibikoresho vyakora mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "text": ", ivyo Nebukadineza yari yaranyaze abikuye i Yerusalemu akabishira mu ngoro y’ikigirwamana ciwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.7",
            "verseOrgIds": [
              "EZR.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuro umwami w’i Buperesi yari yarabitumye Mitiredati umuzezwabintu, na we arabiharura abishikiriza Sheshubazari umuganwa w’i Buyuda.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.8",
            "verseOrgIds": [
              "EZR.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
