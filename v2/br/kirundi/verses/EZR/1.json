          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sheshubazari azana ivyo vyose ari kumwe n’abavuye mu kinyago batashe bavuye i Babiloni baja i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.11",
            "verseOrgIds": [
              "EZR.1.11"
            ]
          }
        }
