              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka wa mbere Kuro ari umwami w’Ubuperesi, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        },
        {
          "text": " kugira ngo ashitse ijambo yari yaravuze aciye kuri Yeremiya, akangura umutima wa Kuro umwami w’Ubuperesi na we atanga mu bwami bwiwe itegeko ryanditswe rivuga ngo:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.1",
            "verseOrgIds": [
              "EZR.1.1"
            ]
          }
        }
      ]
    },
