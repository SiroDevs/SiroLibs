            "sid": "EZR 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abakuru b’imiryango y’Abayuda n’Ababenyamini, n’abaherezi hamwe n’Abalewi, n’umuntu wese Imana yakoze ku mutima, bitegurira kuduga ngo bubake Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "text": " i Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.5",
            "verseOrgIds": [
              "EZR.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ababanyi babo bose babafashisha ibikoresho vy’ifeza, vy’inzahabu, ubundi butunzi n’imikuku, n’izindi ngabire z’agaciro, vyiyongera ku mashikanwa abantu batanze n’umutima ubikunze.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.1.6",
            "verseOrgIds": [
              "EZR.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
