          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Numvise ivyo, nitabagurirako umwambaro wanje n’ikoti, nishikura umushatsi n’ubwanwa, hanyuma nicara hasi mbabaye cane. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.3",
            "verseOrgIds": [
              "EZR.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose bajugumizwa n’amajambo y’Imana y’Abisirayeli baza aho ndi barankikuza kubera ico kibi abagarutse bava mu kinyago bakoze. Maze nguma ngaho nicurikiriye kugeza igihe co gutanga ikimazi co ku mugoroba.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.9.4",
            "verseOrgIds": [
              "EZR.9.4"
            ]
          }
        }
      ]
    },
