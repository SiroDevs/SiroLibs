              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rehumu umukuru w’ingabo na Shimushayi umunyamabanga bandikira umwami Aritazeruzi ikete ryo kwagiriza ab’i Yerusalemu rivuga riti:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.8",
