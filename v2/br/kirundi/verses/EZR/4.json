          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe Ahasuwerusi yari akija ku ngoma, abansi b’Abayuda banditse ikete ryo kwagiriza Abayuda n’ab’i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.6",
            "verseOrgIds": [
              "EZR.4.6"
            ]
          }
        }
