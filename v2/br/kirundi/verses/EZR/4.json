            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Zerubabeli, Yesuwa n’abandi bose bo mu bakuru b’imiryango y’Abisirayeli babishura bati: “Nta co dusangiye mu kwubaka Ingoro y’Imana yacu. Ni twebwe twenyene tuzoyubakira ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        },
        {
          "text": ", Imana y’Abisirayeli, nk’uko umwami Kuro, umwami w’i Buperesi, yadutegetse.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.3",
            "verseOrgIds": [
              "EZR.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
