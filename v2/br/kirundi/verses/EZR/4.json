          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko amahanga yari abakikije akura hasi ngo ace intege Abayuda abatera n’ubwoba ngo ntibashishikare kwubaka. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.4",
            "verseOrgIds": [
              "EZR.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barondera abakozi b’ubwo bwami babaha impera kugira ngo babagwanye. Ivyo vyatumye imigambi yabo idatera imbere mu gihe cose umwami Kuro w’i Buperesi yamaze ari ku ngoma gushika no ku ngoma y’umwami Dariyusi w’i Buperesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.5",
            "verseOrgIds": [
              "EZR.4.5"
            ]
          }
        }
      ]
    },
    {
