            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abansi b’Abayuda n’Ababenyamini bumvise ko abahora ari inyagano bariko barubaka Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "text": ", Imana y’Abisirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.1",
            "verseOrgIds": [
              "EZR.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "baraza bashikira Zerubabeli n’abakuru baserukira imiryango bababwira bati: “Reka tubafashe kwubaka kuko na twebwe dusenga Imana yanyu, kandi twamye tuyishikanira ibimazi kuva mu gihe ca Esaruhadoni umwami w’i Ashuri, ari we yatuzanye hano.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.2",
            "verseOrgIds": [
              "EZR.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
