              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze mu misi ya Ahasuwerusi umwami w’i Buperesi, Bishulamu, Mituredati, Tabeyeli n’abandi bari bafatanije bandikira Ahasuwerusi. Iryo kete ryari ryanditswe mu rurimi rw’Icarameya hanyuma bararisobanurira umwami.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.4.7",
            "verseOrgIds": [
              "EZR.4.7"
            ]
          }
        }
