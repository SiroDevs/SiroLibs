            "number": "24",
            "style": "v",
            "sid": "EZR 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ntoranya abaherezi icumi na babiri bo kuturongora, bari kumwe na Sherebiya, Hashabiya n’abandi icumi bo muri benewabo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.24",
            "verseOrgIds": [
              "EZR.8.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZR 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndabapimira za feza n’inzahabu zo gushikana na vya bikoresho umwami, abahanuzi biwe, abatware biwe n’Abisirayeli bose bari ngaho bari batangiye Ingoro y’Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.25",
            "verseOrgIds": [
              "EZR.8.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZR 8:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndabapimira italanto amajana atandatu na mirongo itanu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:26",
              "type": "text"
            },
            {
              "text": "Ni nk’amatoni 24.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza, ibikoresho bikozwe mw’ifeza bingana n’italanto ijana",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:26",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 3.750.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", n’izindi ijana z’inzahabu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.26",
            "verseOrgIds": [
              "EZR.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZR 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibikombe mirongo ibiri vy’inzahabu vy’agaciro kangana n’ingero dariki igihumbi",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "8:27",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 8,4.",
              "type": "text"
            }
          ]
        },
        {
          "text": ", n’ibikoresho bikozwe mu mwakaka usenye neza bifise agaciro nk’inzahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.27",
            "verseOrgIds": [
              "EZR.8.27"
            ]
          }
        }
      ]
    },
    {
