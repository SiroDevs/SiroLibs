          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZR 8:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndababwira nti: “Mwebwe n’ibi bikoresho mwejerejwe ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "text": ". Ifeza n’inzahabu ni ishikanwa ryahawe ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "text": ", Imana ya ba sogokuruza n’umutima ubikunze. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.28",
            "verseOrgIds": [
              "EZR.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZR 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mubizigame neza kugeza mubipimye mugeze mu vyumba vy’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "text": " i Yerusalemu imbere y’abakuru b’abaherezi n’Abalewi n’abakuru b’imiryango y’Abisirayeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.29",
            "verseOrgIds": [
              "EZR.8.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZR 8:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abaherezi n’Abalewi bakira izo feza n’inzahabu n’ivyo bikoresho vyejejwe vyari vyateguriwe kujanwa mu Ngoro y’Imana yacu i Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.30",
            "verseOrgIds": [
              "EZR.8.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
