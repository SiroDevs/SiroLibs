            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.32",
            "verseOrgIds": [
              "EZR.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZR 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira kane, mu Ngoro y’Imana yacu, dupima za feza n’inzahabu na vya bikoresho vyejejwe tubiha Meremoti mwene Uriya, umuherezi. Eliyazeri mwene Finehasi yari kumwe na we, hamwe n’Abalewi Yozabadi mwene Yesuwa na Nowadiya mwene Binuwi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.33",
            "verseOrgIds": [
              "EZR.8.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EZR 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyose vyarapimwe biraharurwa, maze ibipimo vyose birandikwa muri ico gihe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.34",
            "verseOrgIds": [
              "EZR.8.34"
            ]
          }
        }
      ]
    },
