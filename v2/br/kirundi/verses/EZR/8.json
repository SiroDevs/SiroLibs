            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.8.23",
            "verseOrgIds": [
              "EZR.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
