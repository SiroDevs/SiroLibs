        },
        {
          "text": "Bamaze gushika ku Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.68",
            "verseOrgIds": [
              "EZR.2.68"
            ]
          }
        },
        {
          "text": " i Yerusalemu, bamwe bo mu bakuru b’imiryango batanga amashikanwa bavyishakiye kugira ngo aze yubake Ingoro y’Imana aho yahora. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.68",
            "verseOrgIds": [
              "EZR.2.68"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "69",
            "style": "v",
            "sid": "EZR 2:69"
          },
          "items": [
            {
              "text": "69",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakurikije uburyo bafise, batanze mu bubiko bw’iki gikorwa ingero dariki ibihumbi mirongo itandatu n’imwe",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:69",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 500.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’inzahabu, ingero mina ibihumbi bitanu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:69",
              "type": "text"
            },
            {
              "text": "Ni nk’amatoni 3.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza, n’impuzu z’abaherezi ijana.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.2.69",
            "verseOrgIds": [
              "EZR.2.69"
