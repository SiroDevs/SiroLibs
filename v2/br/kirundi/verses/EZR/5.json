          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raporo bamurungikiye ni yo y’iyi:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.7",
            "verseOrgIds": [
              "EZR.5.7"
            ]
