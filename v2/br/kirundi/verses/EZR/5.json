              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri ico gihe Hagayi na Zakariya mwene Ido, abavugishwa n’Imana, baravugishwa babwira Abayuda bari i Buyuda n’i Yerusalemu mw’izina ry’Imana y’Abisirayeli, ari yo yari ibarongoye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.1",
            "verseOrgIds": [
              "EZR.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Zerubabeli mwene Sheyalutiyeli na Yesuwa mwene Yozadaki barahaguruka ngo bongere gusanura Ingoro y’Imana y’i Yerusalemu. Kandi abavugishwa b’Imana bari kumwe na bo, ngo babafashe.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.2",
            "verseOrgIds": [
              "EZR.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
