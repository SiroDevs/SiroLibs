          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyi ni ikopi y’ikete Tatenayi, umukuru w’intara yo mu burengero bw’uruzi Efurate, na Shetari Bozenayi n’abari kumwe na bo, abakuru bo mu burengero bw’uruzi Efurate, barungikiye umwami Dariyusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.5.6",
            "verseOrgIds": [
              "EZR.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
