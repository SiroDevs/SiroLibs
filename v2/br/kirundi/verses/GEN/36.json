        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.5",
            "verseOrgIds": [
              "GEN.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Esawu afata abagore biwe, abahungu n’abakobwa biwe hamwe n’abo yari atunze mu rugo rwiwe, n’imikuku yiwe n’ibindi bikoko yari atunze; n’ivyo yari yararonkeye i Kanani; aragenda aja mu gihugu ca Seyiri, kure ya mwene nyina Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.6",
            "verseOrgIds": [
              "GEN.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bari batunze vyari vyinshi cane ku buryo bitakunda ko bagumana; igihugu bari bagerereyemwo nticari kubakwira kuko bari bafise umikuku n’amasho vyinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.7",
            "verseOrgIds": [
              "GEN.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Esawu, ari we Edomu, aja kuba mu misozi ya Seyiri.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.8",
            "verseOrgIds": [
              "GEN.36.8"
            ]
