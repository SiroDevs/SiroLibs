          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
