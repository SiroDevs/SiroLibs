          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esawu yarongoye abakobwa bo mu gihugu c’i Kanani: Ada umukobwa wa Eloni, Umuheti na Oholibama, umukobwa wa Ana, akaba n’umwuzukuru wa Zibeyoni Umuhiwi, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.2",
            "verseOrgIds": [
              "GEN.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe na Basemati, umukobwa wa Ishimayeli, mushiki wa Nebayoti.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.36.3",
            "verseOrgIds": [
              "GEN.36.3"
            ]
          }
        }
      ]
    },
