              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ati: “Banza undahire.” Nuko Esawu arahira Yakobo ko amuhebeye uburenganzira kwo kuba samuragwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
