            "number": "15",
            "style": "v",
            "sid": "GEN 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.15",
            "verseOrgIds": [
              "GEN.20.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abwira Sara ati: “Musazawe ndamuhaye shekeli igihumbi",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.16",
            "verseOrgIds": [
              "GEN.20.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "20:16",
              "type": "text"
            },
            {
              "text": "Ni nk’ibiro 12.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza. Ni ikimenyetso c’uko ata co wagirizwa imbere y’abari kumwe nawe bose. Kandi usubijwe iteka ryawe imbere ya bose.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.16",
            "verseOrgIds": [
              "GEN.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.16",
            "verseOrgIds": [
              "GEN.20.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aburahamu asenga Imana, na yo ikiza Abimeleki, umugore wiwe n’abagurano b’abagore biwe kugira ngo bashobore kuvyara, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.17",
            "verseOrgIds": [
              "GEN.20.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.18",
            "verseOrgIds": [
              "GEN.20.18"
            ]
          }
        },
        {
          "text": " yari yamaze gutuma abagore bose bo mu nzu ya Abimeleki baba ingumba ku bwa Sara, umugore wa Aburahamu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.20.18",
            "verseOrgIds": [
              "GEN.20.18"
            ]
          }
        }
      ]
    }
