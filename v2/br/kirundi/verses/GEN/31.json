              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ya Aburahamu n’Imana ya Nahori, ari yo Mana ya sewabo, ize itubere umucamanza.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.31.53",
