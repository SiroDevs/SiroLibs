        },
        {
          "text": "Nuko Yakobo yegera aho se Isaka ari. Amukozeko aravuga ati: “Ijwi ni irya Yakobo, ariko amaboko ni aya Esawu!” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.22",
            "verseOrgIds": [
              "GEN.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiyashoboye kumumenya kuko amaboko yiwe yari afise ubwoya nk’aya mukuruwe Esawu. Imbere yo kumuhezagira ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.23",
            "verseOrgIds": [
              "GEN.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "aramubaza ati: “Vy’ukuri uri Esawu umwana wanje?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
          }
        }
      ]
    },
