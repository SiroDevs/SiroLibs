      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
