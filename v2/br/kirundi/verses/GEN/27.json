            "verseOrgIds": [
              "GEN.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka arajugumira cane, maze aramubaza ati: “None ni nde yagiye guhiga hanyuma akanzanira inyama? Nafunguye kandi namaze kumuhezagira, kandi umuhezagiro namuhaye uzomufata.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.33",
            "verseOrgIds": [
              "GEN.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
