          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aramwishura ati: “Egome ni jewe.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.24",
            "verseOrgIds": [
              "GEN.27.24"
            ]
