          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isaka aramubwira ati: “Mwana wanje, ngaburira kuri za nyama uvuye guhiga. Mpejeje kurya ndaheza ndaguhezagire.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yakobo arazimuzanira, arafungura. Yongera amuzanira n’umuvinyu aranywa. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.25",
            "verseOrgIds": [
              "GEN.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Isaka abwira Yakobo ati: “Nyegera mwana wanje ungumbire.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.27.26",
            "verseOrgIds": [
              "GEN.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
