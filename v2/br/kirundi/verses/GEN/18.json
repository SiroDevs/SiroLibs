          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "text": " abwira Aburahamu ati: “Urwamo rwagiriza Sodomu na Gomora ni rwinshi cane kandi ivyaha vyabo birateye ubwoba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manutse kuraba ko ivyo bakoze bijanye n’urwamo rwanshikiriye, biba vyo bitaba vyo, ndabimenya.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        }
      ]
