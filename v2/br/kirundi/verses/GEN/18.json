        },
        {
          "text": "Aburahamu arabandanya ati: “Umpangaze, nubahutse kuvugana n’Imana kandi ndi umukungugu n’umunyota. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
