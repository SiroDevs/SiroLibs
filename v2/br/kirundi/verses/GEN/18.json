          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega hamwe wosanga ari mirongo ine na batanu, badashika mirongo itanu, na ho nyene worandura igisagara cose kubera abo batanu babuze?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
