        {
          "text": " aramwishura ati: “Ninasanga hari abagororotsi mirongo itanu i Sodomu, igisagara cose ndagihangaza ku bwabo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
