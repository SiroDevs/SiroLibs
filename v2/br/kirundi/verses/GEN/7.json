            "sid": "GEN 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.23",
            "verseOrgIds": [
              "GEN.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi umwuzure wamaze imisi mirongo itanu urengeye isi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.7.24",
            "verseOrgIds": [
              "GEN.7.24"
            ]
          }
        }
      ]
    }
