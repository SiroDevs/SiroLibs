          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosefu aramwishura ati: “Nzobikora nk’uko ubivuze.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        }
      ]
