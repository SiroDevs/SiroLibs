        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.47.30",
            "verseOrgIds": [
              "GEN.47.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
