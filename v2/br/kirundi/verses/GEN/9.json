          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imana ibwira Nowa iti: “Iki ni co kimenyetso c’isezerano ngiraniye namwe hamwe n’ivyaremwe vyose biri kw’isi.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.17",
