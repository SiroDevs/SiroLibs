          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’umwuzure, Nowa yabayeho iyindi myaka amajana atatu na mirongo itanu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.28",
            "verseOrgIds": [
              "GEN.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imyaka yose Nowa yabayeho ni amajana icenda na mirongo itanu, hanyuma arapfa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.29",
            "verseOrgIds": [
              "GEN.9.29"
            ]
          }
        }
