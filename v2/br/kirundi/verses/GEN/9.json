        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.19",
            "verseOrgIds": [
              "GEN.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’umwuzure, Nowa yabaye umurimyi maze atera uruzabibu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.20",
            "verseOrgIds": [
              "GEN.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe Nowa anywa umuvinyu yari yaganye, araborerwa maze aryama atambaye mw’ihema ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.21",
            "verseOrgIds": [
              "GEN.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamu, sekuruza wa Kanani, abonye ko se ari gusa, arasohoka abibwira abavukanyi biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.22",
            "verseOrgIds": [
              "GEN.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Shemu na Yafeti bafatira impuzu ku bitugu vyabo, bagenza umugongo binjira mw’ihema, bapfuka se. Binjiye bagenza umugongo kugira ngo ntibabone ubwambure bwa se.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.23",
            "verseOrgIds": [
              "GEN.9.23"
            ]
          }
        }
      ]
    },
