          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowa yikanguye atakiborewe akamenya ivyo umuhererezi wiwe yakoze, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.9.24",
            "verseOrgIds": [
              "GEN.9.24"
            ]
          }
        },
        {
          "name": "verse",
