          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Moridekayi aca aragenda akora nk’uko Esiteri yamubwiye.",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.17",
            "verseOrgIds": [
              "EST.4.17"
            ]
          }
        }
      ]
