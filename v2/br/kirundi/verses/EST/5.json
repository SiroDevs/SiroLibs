            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umugore wiwe Zereshi n’abagenzi biwe bose baca bamubwira bati: “Shinga igiti c’ingero z’igice c’ukuboko mirongo itanu",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:14",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 23.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure, uce usaba umwami kumanika Moridekayi kuri ico giti. Hanyuma ubone kugenda ku mazimano hamwe n’umwami unezerewe.” Iyo mpanuro inezera Hamani, maze ashinga ico giti.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        }
      ]
