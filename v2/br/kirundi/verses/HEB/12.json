              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi bisigura ko ibishobora kunyiganyizwa vyose bizokurwaho, kugira ngo ibidashobora kunyiganyizwa bigumeho.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.12.27",
            "verseOrgIds": [
              "HEB.12.27"
            ]
