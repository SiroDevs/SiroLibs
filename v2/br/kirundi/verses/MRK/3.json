        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigisha b’ivyagezwe bari baje bava i Yerusalemu bavuga bati: “Akoreshwa n’ububasha bwa Beyelizebuli! Umukuru w’abadayimoni ni we amushoboza kwirukana abadayimoni.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.3.22",
            "verseOrgIds": [
              "MRK.3.22"
            ]
          }
        }
      ]
