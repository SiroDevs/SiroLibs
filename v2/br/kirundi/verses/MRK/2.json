            "number": "18",
            "style": "v",
            "sid": "MRK 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikindi gihe, abigishwa ba Yohana n’Abafarisayo bari bisonzesheje. Maze abantu baza aho Yesu ari baramubaza bati: “Ni kuki abigishwa ba Yohana Umubatizi n’abigishwa b’Abafarisayo bisonzesha, ariko abigishwa bawe ntibisonzeshe?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.18",
            "verseOrgIds": [
              "MRK.2.18"
            ]
          }
        }
