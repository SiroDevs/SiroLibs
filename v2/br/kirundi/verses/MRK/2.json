          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe, ku musi w’Isabato, Yesu yariko aca mu mirima y’ingano ari kumwe n’abigishwa biwe. Bariko bararengana, abigishwa biwe bagenda baraca imitwe y’ingano zeze. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abafarisayo baramubaza bati: “Ni kuki abigishwa bawe bakora ikizira ku musi w’Isabato?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
      ]
    },
