          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MRK 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ariko arasohoka ava mu rusengero, umwe mu bigishwa biwe aramubwira ati: “Mwigisha, ehe raba izi nyubakwa n’amabuye azubatse ingene biteye igomwe!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.1",
            "verseOrgIds": [
              "MRK.13.1"
            ]
          }
        }
      ]
    },
    {
