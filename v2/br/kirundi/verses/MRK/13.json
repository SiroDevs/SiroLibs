          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.2",
            "verseOrgIds": [
              "MRK.13.2"
            ]
