          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Yesu yicaye ku Musozi wa Elayono aharabana n’urusengero, Petero, Yakobo, Yohana na Andereya baramubaza biherereye bati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.3",
            "verseOrgIds": [
              "MRK.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MRK 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tubwire, ivyo bizoshika ryari, kandi ni ikihe kimenyetso kizokwerekana ko bigiye gushika?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.13.4",
            "verseOrgIds": [
              "MRK.13.4"
            ]
          }
        }
      ]
    },
