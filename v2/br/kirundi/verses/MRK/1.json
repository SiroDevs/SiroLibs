          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho guhora, wa muntu aca aragenda atangura kuvuga no gukwiragiza iyo nkuru. Ivyo vyatumye Yesu adasubira kuja mu gisagara ku mugaragaro, ahubwo aca aguma inyuma yaco ahantu hihishije. Ariko na ho nyene abantu barahamusanga bavuye mu mihingo myinshi.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.45",
            "verseOrgIds": [
              "MRK.1.45"
            ]
          }
        }
