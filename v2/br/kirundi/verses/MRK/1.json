          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu agwaye imibembe araza apfukama imbere yiwe, aramwinginga ati: “Ubishatse, woshobora kunkiza ngahumanuka.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.1.40",
            "verseOrgIds": [
              "MRK.1.40"
            ]
          }
        }
