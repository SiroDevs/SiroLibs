        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.14",
            "verseOrgIds": [
              "MRK.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ashitse i Yerusalemu, yinjira mu rusengero atangura kwirukana abadandaza n’abariko barabagurira. Ahenagura imeza z’abavunja amahera hamwe n’intebe z’abadandaza inuma, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.15",
            "verseOrgIds": [
              "MRK.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MRK 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ntiyemerera umuntu n’umwe kwinjiza ibidandazwa mu rusengero. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.16",
            "verseOrgIds": [
              "MRK.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko aca arabigisha ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.17",
            "verseOrgIds": [
              "MRK.11.17"
            ]
          }
        },
