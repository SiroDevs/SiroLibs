          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi bakurubakuru n’abigisha b’ivyagezwe bavyumvise baca batangura kurondera ingene bomwica. Ariko baramutinya kuko abantu bakunda cane inyigisho ziwe.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.18",
            "verseOrgIds": [
