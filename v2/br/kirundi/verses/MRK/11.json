          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye mu gitondo, bariko baragenda, babona ca giti c’umusukoni Yesu yavuma cumye kuva mu mizi. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.20",
            "verseOrgIds": [
              "MRK.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petero aca aravyibuka maze abwira Yesu ati: “Mwigisha, ehe ca giti wavuma cumye!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.21",
            "verseOrgIds": [
              "MRK.11.21"
            ]
          }
        }
