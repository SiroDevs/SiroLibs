            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bariko baregereza i Yerusalemu, Yesu n’abigishwa biwe bashika ahitwa Betifage n’i Betaniya ku Musozi wa Elayono. Yesu atuma babiri mu bigishwa biwe, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.1",
            "verseOrgIds": [
              "MRK.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MRK 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.2",
            "verseOrgIds": [
              "MRK.11.2"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.11.2",
            "verseOrgIds": [
              "MRK.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
