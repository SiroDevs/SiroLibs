        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MRK 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Yesu ahejeje kubabwira ivyo, aca aduzwa mw’ijuru, yicara mu kibanza c’icubahiro i buryo bw’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.19",
            "verseOrgIds": [
              "MRK.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MRK 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abigishwa baca baja mu mihingo yose bavuga Ubutumwa Bwiza, kandi Umwami Yesu akorana na bo, ashingira intahe Ijambo ryiwe biciye mu bitangaza vyarikurikira.]",
          "type": "text",
          "attrs": {
            "verseId": "MRK.16.20",
            "verseOrgIds": [
              "MRK.16.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "16:9-20",
              "type": "text"
            },
            {
              "text": "Mu nzandiko zimwezimwe za Bibiliya aya majambo ntarimwo.",
              "type": "text"
            }
          ]
