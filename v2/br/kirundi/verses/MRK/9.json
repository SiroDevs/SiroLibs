          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MRK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.11",
            "verseOrgIds": [
              "MRK.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MRK 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu arabishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.12",
            "verseOrgIds": [
              "MRK.9.12"
            ]
          }
