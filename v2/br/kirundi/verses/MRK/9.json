            "number": "21",
            "style": "v",
            "sid": "MRK 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we arishura ati: “Kuva akiri umwana muto cane. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.21",
            "verseOrgIds": [
              "MRK.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenshi iyo mpwemu imuta mu muriro canke mu mazi, ikagerageza kumwica. Nimba woshobora kugira ico ukoze, utugirire impuhwe udufashe.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.22",
            "verseOrgIds": [
              "MRK.9.22"
            ]
          }
        }
      ]
