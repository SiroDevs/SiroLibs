          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.27",
            "verseOrgIds": [
              "MRK.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nyuma y’ivyo, Yesu yinjiye mu nzu, abigishwa biwe baramubaza biherereye bati: “Ni kuki twebwe vyatunaniye kwirukana irya dayimoni?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.28",
            "verseOrgIds": [
              "MRK.9.28"
            ]
          }
        }
      ]
    },
