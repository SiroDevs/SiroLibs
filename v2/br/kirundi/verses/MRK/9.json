          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bamuzanira uwo mwana. Ya mpwemu mbi ikibona Yesu, itangura kumujegeza cane, agwa hasi, arikumbagaza, abira ifuro mu kanwa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.20",
            "verseOrgIds": [
              "MRK.9.20"
            ]
          }
        }
      ]
    },
