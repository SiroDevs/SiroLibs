            "sid": "MRK 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo nyene se w’uwo mwana arasemerera ati: “Ndizera! Ariko mfasha neshe ukutizera kwanje!”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.24",
            "verseOrgIds": [
              "MRK.9.24"
            ]
          }
        }
