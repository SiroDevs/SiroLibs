          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko yashaka kugumana n’abigishwa biwe ngo abigishe. Arababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.31",
            "verseOrgIds": [
              "MRK.9.31"
            ]
          }
        },
