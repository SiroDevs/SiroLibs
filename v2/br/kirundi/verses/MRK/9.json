          ]
        },
        {
          "text": "Nuko bashika i Kaperinawumu. Ashitse mu nzu abaza abigishwa biwe ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.33",
            "verseOrgIds": [
