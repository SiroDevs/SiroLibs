          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arabishura ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.29",
            "verseOrgIds": [
              "MRK.9.29"
            ]
          }
        }
