        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.16",
            "verseOrgIds": [
              "MRK.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MRK 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe muri ba bantu arishura ati: “Mwigisha, nakuzaniye umuhungu wanje, kuko aboshwe n’impwemu mbi ituma atavuga. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.17",
            "verseOrgIds": [
              "MRK.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MRK 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishobora kumufatira aho ari hose, ikamutura hasi, akabira ifuro mu kanwa, agahekenya amenyo, hanyuma umubiri wiwe ukadadarara.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.18",
            "verseOrgIds": [
              "MRK.9.18"
            ]
          }
        }
      ]
    },
