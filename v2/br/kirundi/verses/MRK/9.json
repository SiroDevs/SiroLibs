            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abaza se w’uwo mwana ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.21",
            "verseOrgIds": [
              "MRK.9.21"
            ]
          }
        }
