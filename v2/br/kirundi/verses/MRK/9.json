          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bava aho hantu baca i Galilaya. Yesu ntiyashaka ko hagira uwumenya aho bari, ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.30",
