          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abandanya ababwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.1",
            "verseOrgIds": [
              "MRK.9.1"
            ]
          }
        }
