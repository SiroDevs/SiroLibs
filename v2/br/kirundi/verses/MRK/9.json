          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abonye ko abantu benshi baje biruka batumbereye aho bari, ategeka ya mpwemu ihumanye ati: ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.25",
            "verseOrgIds": [
              "MRK.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.25",
            "verseOrgIds": [
