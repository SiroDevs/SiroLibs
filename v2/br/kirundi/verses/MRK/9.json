          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MRK 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagarutse aho abandi bigishwa bari, babona abantu benshi babakikije kandi bamwe mu bigisha b’ivyanditswe ni ho bari bari, baharira na bo. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.14",
            "verseOrgIds": [
              "MRK.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MRK 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bantu bose babonye Yesu aserutse baratangara cane, biruka baja kumuramutsa.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.15",
            "verseOrgIds": [
              "MRK.9.15"
            ]
          }
        }
      ]
    },
