            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mpwemu ihumanye ivuza induru, ijegeza cane wa mwana, hanyuma imuvamwo. Uwo mwana aca amera nk’uwupfuye, kandi benshi bavuga bati: “Arapfuye.” ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.26",
            "verseOrgIds": [
              "MRK.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Yesu amufata ukuboko aramuhagurutsa, maze wa mwana arahagarara.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.27",
            "verseOrgIds": [
              "MRK.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
