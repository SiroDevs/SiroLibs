          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntibatahura ico ababwiye, kandi batinya no kugira ico babimubazako.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.9.32",
            "verseOrgIds": [
              "MRK.9.32"
            ]
          }
        }
