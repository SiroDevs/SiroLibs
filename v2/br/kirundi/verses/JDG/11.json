              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we amwishura ati: “Data, nimba hari ico wasezeraniye ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "text": ", ngira uko wasezeranye kuko ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "text": " aguhaye intsinzi nini ku bansi bawe, ari bo Bamoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
