          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefuta asubira kurungika intumwa ku mwami w’Abamoni ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.14",
            "verseOrgIds": [
              "JDG.11.14"
            ]
          }
        },
