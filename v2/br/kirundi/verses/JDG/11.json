          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.9",
            "verseOrgIds": [
              "JDG.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba batware bamwishura bati: “",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.10",
            "verseOrgIds": [
              "JDG.11.10"
            ]
          }
        },
        {
          "text": " ni we cabona cacu. Turemeye ko tuzobikora uko nyene ubivuze.” ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.10",
            "verseOrgIds": [
              "JDG.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yefuta ajana n’abo batware b’i Gileyadi, bamugira umugabisha w’ingabo zose. Ageze i Misipa imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        },
        {
          "text": " Yefuta asubiramwo ya majambo yose yavugana n’abatware.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefuta arungikira intuma umwami w’Abamoni, amubaza ati: “Mbega uturonderako iki ko uteye igihugu cacu?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.12",
            "verseOrgIds": [
              "JDG.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.12",
            "verseOrgIds": [
              "JDG.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami w’Abamoni na we yishura intumwa ya Yefuta ati: “Igihe Isirayeli yaduga iva muri Egiputa, banyaze intara yanje kuva ku ruzi Arunoni gushika kuri Yaboki, ukabandanya no gushika kuri Yorodani. None rero nimuhansubize mu mahoro n’umutekano.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.13",
            "verseOrgIds": [
              "JDG.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
