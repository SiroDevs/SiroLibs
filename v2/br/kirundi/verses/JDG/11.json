            "sid": "JDG 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yefuta aja kugwanya Abamoni, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "text": " amuha intsinzi kuri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asambura ibisagara mirongo ibiri kuva Aroweri gushika mu bisagara vya Miniti no muri Abeli-Keramimu. Maze Abisirayeli banesha Abamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        }
      ]
    },
    {
