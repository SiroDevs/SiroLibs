          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko unyemerere iki kimwe gusa: umpe amezi abiri, nduge mu mitumba nje kurirana n’abagenzi banje kuko nzopfa ntarongowe.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.37",
            "verseOrgIds": [
              "JDG.11.37"
            ]
          }
        }
