              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amubonye yitaburirako impuzu, asemerera ati: “Ewe mwana wanje urakankoreye! Urankwegeye amahano! Kuko nasezeraniye ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        },
        {
          "text": " kandi sinisubirako.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        }
