          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amezi abiri aheze, aca agaruka kwa se, na we amugira nk’uko yari yarasezeranye. Yapfuye ari inkumi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
