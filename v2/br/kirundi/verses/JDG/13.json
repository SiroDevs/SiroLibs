              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
            "verseOrgIds": [
              "JDG.13.21"
            ]
          }
        },
        {
          "text": " ntiyabaye agisubira kwiyereka Manowa n’umugore wiwe, Manowa aca aratahura ko yari umumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.21",
            "verseOrgIds": [
              "JDG.13.21"
            ]
          }
        },
