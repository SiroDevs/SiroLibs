            }
          ]
        },
        {
          "text": "Manowa aca afata umwagazi w’impene hamwe n’ishikanwa ry’ifu, abishikanira ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
          "text": " ku gitandara. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        },
        {
          "text": " aca akora igitangaza Manowa n’umugore wiwe babona: ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
