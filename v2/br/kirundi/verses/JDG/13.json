          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbeya ziriko zirarabagirana ziduga mu kirere, wa mumarayika aca aduga muri izo mbeya. Manowa n’umugore wiwe babibonye, baca bakubita amavi hasi barunama. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.20",
            "verseOrgIds": [
              "JDG.13.20"
            ]
          }
        },
