          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Gidiyoni ahitana abakozi biwe icumi, abikora nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        },
        {
          "text": " yari yabimubwiye. Ariko yabikoze mw’ijoro kuko yatinya abo mu muryango wiwe hamwe n’abandi bo mu gisagara cabo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.27",
            "verseOrgIds": [
              "JDG.6.27"
            ]
          }
        }
      ]
