              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidiyoni asenga Imana avuga ati: “Nimba uza gukirisha Abisirayeli ukuboko kwanje nk’uko wabisezeranye, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.36",
