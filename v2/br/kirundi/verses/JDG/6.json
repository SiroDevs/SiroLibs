          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        },
        {
          "text": " aramwishura ati: “Egome genda, ndakurindira gushika ugarutse.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
