          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barabazanya bati: “Ni nde yakoze ibi?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.29",
            "verseOrgIds": [
              "JDG.6.29"
            ]
          }
        }
