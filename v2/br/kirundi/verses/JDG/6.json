            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo Abamidiyani, Abamaleki, n’abandi bo mu buseruko baja hamwe ngo bagwanye Isirayeli, bajabuka Yorodani, bashinga amahema yabo mu kiyaya ca Yezireyeli. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.33",
            "verseOrgIds": [
              "JDG.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mpwemu w’",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "text": " aza kuri Gidiyoni, aca avuza inzamba ihamagarira abantu mu ntambara, maze abo mu muryango wa Abiyezeri baramukurikira. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.34",
            "verseOrgIds": [
              "JDG.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aca arungika intumwa ku bo mu miryango ya Manase, Asheri, Zebuloni na Nafutali, abahamagarira kuja ku rugamba, na bo baramukurikira.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.35",
            "verseOrgIds": [
              "JDG.6.35"
            ]
          }
        }
      ]
    },
