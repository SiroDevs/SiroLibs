          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        },
        {
          "text": " aramuhumuriza ati: “Tekana, ntutinye. Nta co uba!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.23",
            "verseOrgIds": [
              "JDG.6.23"
            ]
          }
        }
