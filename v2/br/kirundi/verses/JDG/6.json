              "JDG.6.16"
            ]
          }
        },
        {
          "text": " aramubarira ati: “Nzoba ndi kumwe nawe, kandi Abamidiyani uzobarandura nk’uwugwanya umuntu umwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        }
