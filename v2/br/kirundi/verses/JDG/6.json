          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu Gidiyoni aca ahubakira ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "text": " igicaniro, acita Yahwe Shalomu, bisobanura ngo ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        },
        {
          "text": " ni we Mahoro. Ico gicaniro kiracahagaze muri Ofura mu Babiyezeri gushika n’ubu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.24",
            "verseOrgIds": [
              "JDG.6.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
