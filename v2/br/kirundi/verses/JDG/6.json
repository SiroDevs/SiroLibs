            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidiyoni yinjira mu nzu, ategura umwagazi w’impene, atora n’ingero efa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "6:19",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 16.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ifu mu giseke, acumba imikate itagira umwambiro. Aca ashira za nyama n’umufa wazo mu gakono, azishikanira wa mumarayika aho yari yicaye musi y’igiti kinini.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        }
      ]
