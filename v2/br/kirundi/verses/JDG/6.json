            "number": "19",
            "style": "v",
            "sid": "JDG 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.19",
            "verseOrgIds": [
              "JDG.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
