    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.16",
            "verseOrgIds": [
              "JDG.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gidiyoni yishura ati: “Nimba nagiriwe ubuntu mu nyonga zawe, nyereka ikimenyetso kinyemeza koko ko ari ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "text": " avuganye nanje. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.17",
            "verseOrgIds": [
              "JDG.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndakwinginze undindire gushika ngaruke, nzane ishikanwa ndagushikanire.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.6.18",
            "verseOrgIds": [
              "JDG.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
