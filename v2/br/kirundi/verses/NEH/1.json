    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kwezi kwa Kisilevu mu mwaka ugira mirongo ibiri, umwami Aritazeruzi ari ku ngoma, nari ku mugwa i Suza. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanani, umwe mu bo tuvukana, aza avuye i Buyuda ari kumwe n’abandi bagabo bamwe, maze ndababaza amakuru y’amasigarira y’Abayuda batashe bavuye mu kinyago, n’ivyerekeye Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
