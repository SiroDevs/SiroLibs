          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ndavuga nti:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        }
