              "type": "text"
            }
          ]
        },
        {
          "text": "Aya ni amajambo ya Nehemiya mwene Hakaliya:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        }
