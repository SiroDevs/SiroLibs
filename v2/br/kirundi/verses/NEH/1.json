              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze kwumva ivyo, nicara hasi ndarira. Mara imisi ngandaye nisonzesheje kandi nsenga Imana yo mw’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.4",
            "verseOrgIds": [
              "NEH.1.4"
            ]
          }
        },
        {
          "name": "verse",
