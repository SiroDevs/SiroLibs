              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barambwira bati: “Abarokotse mu bari barajanywe ari inyagano, bakaba baragarutse mu ntara y’iwabo i Buyuda, bari mu mibabaro myinshi no mu biteterwe. Uruzitiro rw’i Yerusalemu rwarasenyutse, kandi n’amarembo yaho yatongojwe umuriro.”",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
