          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.16",
            "verseOrgIds": [
              "2TH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2TH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jewe Pawulo, ndabandikiye ndabatasha n’ukuboko kwanje, ni co kimenyetso cerekana ko amakete ari ayanje. Uku ni ko nandika.",
          "type": "text",
          "attrs": {
            "verseId": "2TH.3.17",
            "verseOrgIds": [
              "2TH.3.17"
            ]
          }
        }
      ]
    },
