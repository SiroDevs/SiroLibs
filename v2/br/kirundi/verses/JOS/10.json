          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa n’Abisirayeli bose bava muri Eguloni, baduga i Heburoni, barahatera. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.36",
            "verseOrgIds": [
              "JOS.10.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 10:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafata ico gisagara bacisha inkota abantu bose, harimwo umwami waho, imihana yaho n’abayibamwo bose. Nta n’umwe basigaje. Kandi nk’uko yari yabigize muri Eguloni yica abantu bose bahaba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.37",
            "verseOrgIds": [
              "JOS.10.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
