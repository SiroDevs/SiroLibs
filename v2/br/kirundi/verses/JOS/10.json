            "style": "v",
            "sid": "JOS 10:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.39",
            "verseOrgIds": [
              "JOS.10.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 10:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko Yosuwa yafashe ivyo bihugu vyose vyo mu karere k’imisozi miremire, i Negebu, mu biyaya vyo mu burengero biri musi y’imisozi hamwe n’imimanuko yayo, abifatana n’abami baho. Ntiyasize n’umwe. Yatikije igihumeka cose nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "text": " Imana y’Abisirayeli yari yarabimubwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.40",
            "verseOrgIds": [
              "JOS.10.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 10:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa arabarandura bose uhereye i Kadeshi Baruneya gushika i Gaza, no mu ntara yose kuva i Gosheni gushika i Gibeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.41",
            "verseOrgIds": [
              "JOS.10.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 10:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bihugu n’abo bami bose Yosuwa abafata mu gitero kimwe yagize kuri bo, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        },
        {
          "text": " Imana y’Abisirayeli ari yo yabagwanira.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.10.42",
            "verseOrgIds": [
              "JOS.10.42"
            ]
          }
        }
      ]
    },
