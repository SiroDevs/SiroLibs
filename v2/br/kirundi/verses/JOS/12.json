            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba ni bo bami n’ibice vy’igihugu abo bami batwara aho Yosuwa n’Abisirayeli bafashe, mu burengero bwa Yorodani, kuva i Bayali-Gadi mu kiyaya ca Libani, gushika ku musozi Halaki, uduga utumbereye i Seyiri, Yosuwa yagaburiye ico gihugu imiryango y’Abisirayeli ngo kibe icabo bazokwamana. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.7",
            "verseOrgIds": [
              "JOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri ico gihugu, hariho ahari imisozi miremire, ahari imisozi migufimigufi yo mu burengero, hakaba ikiyaya Araba, imimanuko y’imisozi, ubugaragwa bw’i Negebu, hamwe n’ibihugu vy’Abaheti, Abamori, Abanyakanani, Abaperizi, Abahiwi n’Abayebusi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.8",
            "verseOrgIds": [
              "JOS.12.8"
            ]
          }
        }
      ]
