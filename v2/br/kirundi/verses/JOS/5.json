          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.14",
            "verseOrgIds": [
              "JOS.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mugabisha w’ingabo z’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        },
        {
          "text": " aramwishura ati: “Ambura ibirato vyawe, kuko aha hantu uhagaze ari ahera.” Nuko Yosuwa yambura ibirato vyiwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.5.15",
            "verseOrgIds": [
              "JOS.5.15"
            ]
          }
        }
      ]
