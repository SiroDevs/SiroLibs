          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "text": " aha Isirayeli igihugu yari yararahiye ko azogiha ba sekuruza, baragifata kiba icabo, bakibamwo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.43",
            "verseOrgIds": [
              "JOS.21.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 21:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " abaha akaruhuko aho bari hose, nk’uko yari yarabirahiye ba sekuruza babo. Nta mwansi wabo n’umwe yashoboye kubahagarara imbere, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "text": " yagumye atanga abansi babo mu maboko yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.44",
            "verseOrgIds": [
              "JOS.21.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 21:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta sezerano ryiza na rimwe ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        },
        {
          "text": " yari yarasezeraniye Isirayeli ritashitse; ivyo yasezeranye vyose yarabishikijije.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.45",
            "verseOrgIds": [
              "JOS.21.45"
            ]
          }
        }
      ]
