            }
          ]
        },
        {
          "text": "Abakuru b’umuryango w’Abalewi begera umuherezi Eliyazeri, na Yosuwa mwene Nuni, hamwe n’abakuru b’iyindi miryango ya Isirayeli, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.1",
            "verseOrgIds": [
              "JOS.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "bari i Shilo mu gihugu c’i Kanani, bababwira bati: “",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        },
        {
          "text": " yategetse Mose ko muzoduha ibisagara tubamwo, n’uburagiro bw’ibitungwa vyacu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.21.2",
            "verseOrgIds": [
              "JOS.21.2"
            ]
          }
        }
      ]
    },
