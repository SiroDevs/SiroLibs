          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na bo bishura Yosuwa bati: “Haba na mba! Tuzokorera ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.21",
            "verseOrgIds": [
              "JOS.24.21"
            ]
          }
        }
      ]
    },
    {
