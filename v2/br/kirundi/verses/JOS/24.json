              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa arababwira ati: “Nuko rero nimukure imana z’abanyamahanga ziri muri mwebwe, imitima yanyu muyegurire ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.23",
            "verseOrgIds": [
              "JOS.24.23"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli.”",
          "type": "text",
          "attrs": {
