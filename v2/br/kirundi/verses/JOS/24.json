              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Yosuwa aca arabarungika basubira iwabo, umwe wese aja mu ntara bahawe nk’iragi ryabo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.28",
