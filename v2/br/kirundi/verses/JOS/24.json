          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.18",
            "verseOrgIds": [
              "JOS.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yosuwa arababarira ati: “Mwebwe ntimushoboye gukorera ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
          }
        },
        {
          "text": ", kuko ni Imana itunganye kandi ipfuha. Ntizokwihanganira ubugarariji n’ivyaha vyanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.19",
            "verseOrgIds": [
              "JOS.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwava k’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        },
        {
          "text": " mugakorera izindi mana, azobateza ivyago bibatikize bibamare, inyuma y’ivyiza vyose yabagiriye.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.20",
            "verseOrgIds": [
              "JOS.24.20"
            ]
          }
        }
      ]
    },
    {
