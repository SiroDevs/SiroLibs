          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa ababwira ati: “Iri buye ni icabona hagati yacu. Ryumvise ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
        },
        {
          "text": " yatubwiye vyose. Rizobacira urubanza nimwava ku Mana yanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.27",
            "verseOrgIds": [
              "JOS.24.27"
            ]
          }
