              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo vyose, Yosuwa mwene Nuni, umusavyi w’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "text": ", arahwera amaze imyaka ijana na cumi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
