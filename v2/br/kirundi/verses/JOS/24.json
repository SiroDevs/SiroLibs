          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bamuhamba mw’itongo yahawe i Timunati-Sera, mu ntara y’imisozi ya Efurayimu, haruguru y’umusozi Gayashi.",
          "type": "text",
          "attrs": {
