            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
          "text": " mu gihe cose Yosuwa yari akiriho no mu gihe c’abatware bakoranye na we, abo yasize amaze gupfa, hamwe n’abandi bose bari barabonye ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
          "text": " yari yarakoreye Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
