            "number": "26",
            "style": "v",
            "sid": "JOS 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Yosuwa aca yandika ivyo vyose mu gitabu c’ivyagezwe vy’Imana. Afata n’ibuye rinini ry’icibutso, arishira musi y’igiti kinini kiri hafi y’ihema ry’ibonaniro ry’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.26",
            "verseOrgIds": [
              "JOS.24.26"
            ]
          }
        },
