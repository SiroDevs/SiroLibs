            "sid": "JOS 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hakiri kare mu gitondo, Yosuwa n’Abisirayeli barahaguruka bava i Shitimu baja kuri Yorodani, bashingaho amahema imbere yo kujabuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.1",
            "verseOrgIds": [
              "JOS.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haheze imisi itatu, abatware banyuragira muri mahema babamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.2",
            "verseOrgIds": [
              "JOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "babwira abantu bati: “Nimwabona Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.3",
            "verseOrgIds": [
              "JOS.3.3"
            ]
          }
        },
        {
          "text": " Imana yanyu, mukabona n’abaherezi ari bo Balewi bayireruye, bagiye, namwe muce muva aho muri muyikurikire. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.3",
            "verseOrgIds": [
              "JOS.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kubera iyi nzira mutari bwayicemwo, bazobarongora, babaje imbere. Ariko mugendere nko ku ngero z’igice c’ukuboko ibihumbi bibiri",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:4",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 900.",
              "type": "text"
            }
          ]
        },
        {
          "text": " inyuma yabo, ntimuze muyegere.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
