            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa yongera abarira abaherezi ati: “Fata Isandugu y’Isezerano muje imbere y’abandi mu kujabuka.” Nuko baterura iyo Sandugu, baja imbere baragenda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.6",
            "verseOrgIds": [
              "JOS.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.6",
            "verseOrgIds": [
              "JOS.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.7",
            "verseOrgIds": [
              "JOS.3.7"
            ]
          }
        },
        {
          "text": " abarira Yosuwa ati: “Uyu musi ngira ntangure kugushira hejuru imbere y’Abisirayeli, kugira ngo bamenye ko ndi kumwe nawe nk’uko nari kumwe na Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.7",
            "verseOrgIds": [
              "JOS.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Barira abaherezi bareruye Isandugu y’Isezerano uti: ‘Nimwashika ku nkengera y’uruzi Yorodani, muce murutambukiramwo muruhagararemwo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.8",
            "verseOrgIds": [
              "JOS.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa abwira Abisirayeli ati: “Egera hino mwumvirize amajambo y’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
              "JOS.3.9"
            ]
          }
        },
        {
          "text": " Imana yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.9",
            "verseOrgIds": [
              "JOS.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co kizobamenyesha ko Imana nzima iri muri mwebwe, kandi ko izokwirukana imbere yanyu Abanyakanani, Abaheti, Abahiwi, Abaperizi, Abagirugashi, Abamori n’Abayebusi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.10",
            "verseOrgIds": [
              "JOS.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Raba Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.11",
            "verseOrgIds": [
              "JOS.3.11"
            ]
          }
        },
        {
          "text": " nyene isi yose igiye kuri Yorodani imbere yanyu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.11",
            "verseOrgIds": [
              "JOS.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, nimutoranye abagabo icumi na babiri mu miryango y’Abisirayeli, umwumwe mu muryango. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.12",
            "verseOrgIds": [
              "JOS.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi bareruye Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        },
        {
          "text": " nyene isi yose nibamara guhonyoza ibirenge muri Yorodani, ruzocikamwo kabiri, amazi ntasubire gutemba, ahagarare nk’uruhome.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.13",
            "verseOrgIds": [
              "JOS.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abantu bose bamaze kuzinga amahema yabo kugira ngo bajabuke Yorodani, abaherezi baca barerura Isandugu y’Isezerano, babaja imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.14",
            "verseOrgIds": [
              "JOS.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe hari mu gihe c’iyimbura, kandi Yorodani rwari rwarengeye inkombe zarwo. Ariko ba baherezi bari bareruye Isandugu y’Isezerano bamaze guhonyoza ibirenge mu mazi yo ku nkengera y’urwo ruzi, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.15",
            "verseOrgIds": [
              "JOS.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "amazi yo haruguru aca arahagarara ntiyasubira gutemba. Yiyegeraniriza hamwe kure y’aho bari, mu gisagara ca Adamu, hafi y’i Zaretani, ayo hepfo na yo abandanya amanuka aja mu kiyaga ca Araba, ari co Kiyaga c’Umunyu gushika akamye. Nuko abantu baca barajabuka hakurya bashika ahegereye Yeriko. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.16",
            "verseOrgIds": [
              "JOS.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe abaherezi bari bareruye Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        },
        {
          "text": " bari bahagaze bemye kw’isi yumye hagati muri Yorodani, Abisirayeli na bo bariko barajabuka gushika ihanga ryose rijabutse rica kw’isi yumutse.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.17",
            "verseOrgIds": [
              "JOS.3.17"
            ]
          }
        }
      ]
    }
