        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.4",
            "verseOrgIds": [
              "JOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosuwa abarira abantu ati: “Mwiyeze kuko ejo ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        },
        {
          "text": " azokora ibitangaza bikomeye muri mwebwe.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.3.5",
            "verseOrgIds": [
              "JOS.3.5"
            ]
          }
        }
      ]
    },
    {
