              "type": "text"
            }
          ]
        },
        {
          "text": "Narongeye kandi ndaraba mbona agacinyizo kose gakorerwa musi y’izuba:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.4.1",
            "verseOrgIds": [
