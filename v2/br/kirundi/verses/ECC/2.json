{
  "id": "ECC.2",
  "number": "2",
  "bookId": "ECC",
  "reference": "Umusiguzi 2",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
