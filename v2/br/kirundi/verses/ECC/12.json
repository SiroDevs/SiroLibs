            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusiguzi ntiyari umunyabwenge gusa, ariko kandi yigishije abantu ukumenya. Yaragerageje kurondera maze ashira ku rutonde imigani myinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.9",
            "verseOrgIds": [
              "ECC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusiguzi yarondeye gushiraho amajambo atunganye, kandi ivyo yanditse vyari bigororotse kandi ari ivy’ukuri.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.12.10",
            "verseOrgIds": [
              "ECC.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
