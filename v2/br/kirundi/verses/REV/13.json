          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.17",
            "verseOrgIds": [
              "REV.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gutahura ibi bisaba ubwenge. Uwufise ubwenge arashobora gutahura ivy’ico giharuro c’ico gikoko, kuko ni igiharuro gihagarariye izina ry’umuntu. Ico giharuro ni 666.",
          "type": "text",
          "attrs": {
            "verseId": "REV.13.18",
            "verseOrgIds": [
              "REV.13.18"
            ]
          }
        }
      ]
