          ]
        },
        {
          "text": "Inyuma y’ivyo nca numva amajwi asamirana mw’ijuru ameze nk’ay’abantu amasinzi n’amasinzi, asemerera ati:",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
