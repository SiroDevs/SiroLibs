              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwiza n’icubahiro vy’amahanga bizozanwa muri co. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.26",
            "verseOrgIds": [
              "REV.21.26"
