          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho niyatanga ikimazi c’ishimwe kivuye mu bitungwa bitobito nk’ikimazi ashikaniye ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "text": ", kizobe ari isuguru canke iyivyara, ariko itagira agasembwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.6",
            "verseOrgIds": [
              "LEV.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyatanga intama, aze ayijane imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "text": ", ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.7",
            "verseOrgIds": [
              "LEV.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ashire ikiganza ku mutwe wayo imbere y’ihema ry’ibonaniro, hanyuma ayikererereho. Maze abaherezi bene Aroni baze bamijagire amaraso yayo ku mpande zose z’igicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.8",
            "verseOrgIds": [
              "LEV.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuri ico kimazi c’ishimwe aze ashikanire ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "text": " ishikanwa ryo guturira ku gicaniro rigizwe n’ibi bikurikira: ibinure vyaco, umurizo wose uko bazoba bawukuye ku ruti rw’umugongo, ibinure vyose bifatanye n’ivyo mu nda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.9",
            "verseOrgIds": [
              "LEV.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "amafyigo yompi n’ibinure biri kuri yo n’ivyo mu mbavu, n’igice gipfutse igitigu, ico azokurirako rimwe n’amafyigo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.10",
            "verseOrgIds": [
              "LEV.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi aze abituririre ku gicaniro nk’imfungurwa zituriwe n’umuriro zishikaniwe ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.11",
            "verseOrgIds": [
              "LEV.3.11"
            ]
          }
        }
      ]
    },
