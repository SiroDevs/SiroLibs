          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico kimazi nicaba ari impene, aze akizane imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.12",
            "verseOrgIds": [
              "LEV.3.12"
            ]
          }
        },
        {
