          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.16",
            "verseOrgIds": [
              "LEV.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyacumura ku cagezwe na kimwe c’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "text": ", naho atoba yabimenye, azoba ari uwo gutsindwa n’urubanza kandi azobihanirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.17",
            "verseOrgIds": [
              "LEV.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze ashire umuherezi impfizi y’intama akuye mu mukuku, itagira agasembwa kandi ifise igiciro gikwiye nk’uko bitegerezwa. Umuherezi aze amutangire ico kimazi c’indishi muri ubwo buryo, na we azobabarirwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.18",
            "verseOrgIds": [
              "LEV.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kizoba ari ikimazi c’indishi, kuko azoba yatsinzwe n’urubanza mu gucumura k’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.5.19",
            "verseOrgIds": [
              "LEV.5.19"
            ]
          }
        }
      ]
    }
