              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo vyagezwe bigenga ibimazi vyo guturirwa, ibimazi vy’ifu, ibimazi vy’ivyaha, ibimazi vy’indishi, ikimazi co kurobanura n’ikimazi c’ishimwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        },
        {
          "text": " yahaye Mose ku musozi Sinayi igihe yategeka Abisirayeli gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        },
        {
          "text": " ibimazi vyabo, mu bugaragwa bw’i Sinayi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
