            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        },
        {
          "text": " ahamagara Mose ari mw’Ihema ry’Ibonaniro, aramubwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.1",
            "verseOrgIds": [
              "LEV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Vugana n’Abisirayeli ubabwire uti: ‘Umuntu wese muri mwebwe azogomba gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        },
        {
          "text": " ishikanwa, azomushikanire igitungwa akuye mu bitungwa bininibinini canke bitobito.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.2",
            "verseOrgIds": [
              "LEV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico kimazi nicaba ari ico guturirwa kivuye mu bitungwa bininibinini, gitegerezwa kuba ari ishuri itagira agasembwa. Aze akijane imbere y’ihema ry’ibonaniro kugira ngo ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
        {
          "text": " amwemere. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.3",
            "verseOrgIds": [
              "LEV.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze arambike ikiganza ciwe ku mutwe w’ico kimazi co guturirwa, hanyuma ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.4",
            "verseOrgIds": [
              "LEV.1.4"
            ]
          }
        },
        {
          "text": " azokwemera ko gipfuye mu gishingo ciwe ngo kibe impongano y’ivyaha vyiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.4",
            "verseOrgIds": [
              "LEV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Azoce akererera iyo shuri imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "text": ", maze abaherezi bene Aroni baze bazane amaraso yayo bayamije ku mpande zose z’igicaniro imbere y’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.5",
            "verseOrgIds": [
              "LEV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma azoce akura urusato kuri ico kimazi, agicemwo ibihimba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.6",
            "verseOrgIds": [
              "LEV.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahungu ba Aroni umuherezi bazoce bacana umuriro ku gicaniro bashireko inkwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.7",
            "verseOrgIds": [
              "LEV.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma abo baherezi bene Aroni baze bashire vya bihimba vyose kuri za nkwi ziri ku gicaniro, harimwo umutwe n’ibinure vyaco. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.8",
            "verseOrgIds": [
              "LEV.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze yogeshe amazi ivyo mu nda n’amaguru, hanyuma umuherezi abituririre vyose ku gicaniro, nk’ikimazi co guturirwa, gitanzwe biciye mu guturirwa, ishikanwa rimota neza rinezera ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.9",
            "verseOrgIds": [
              "LEV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico kimazi nicaba ari ico guturirwa kivuye mu mukuku, ari impene canke intama, aze atange isuguru itagira agasembwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.10",
            "verseOrgIds": [
              "LEV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze ayikererere ku ruhande ruherereye mu buraruko bw’igicaniro imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        },
        {
          "text": ", hanyuma abaherezi bene Aroni baze bamijagire amaraso y’iyo suguru ku mpande zose z’igicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.11",
            "verseOrgIds": [
              "LEV.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze ayihimbaguremwo ibihimba, hanyuma umuherezi abitondeke ku nkwi ziriko zirakira ku gicaniro, harimwo umutwe n’ibinure vyayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.12",
            "verseOrgIds": [
              "LEV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze yogeshe amazi ivyo mu nda n’amaguru, hanyuma umuherezi abituririre vyose ku gicaniro, nk’ikimazi co guturirwa, gitanzwe biciye mu guturirwa, ishikanwa rimota neza rinezereza ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.13",
            "verseOrgIds": [
              "LEV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico kimazi co gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "text": " nicaba ari ico guturirwa kivuye mu biguruka, aze atange inuma canke intunguru ikiri nto. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.14",
            "verseOrgIds": [
              "LEV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi aze ayizane ku gicaniro, ayihotore izosi, ayice umutwe, awuturirire ku gicaniro, hanyuma areke amaraso yayo atembere ku ruhande rumwe rw’igicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.15",
            "verseOrgIds": [
              "LEV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze akureko agatorero n’ibirimwo vyose agaterere ku ruhande rwo mu buseruko bw’igicaniro, ahari umunyota. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.16",
            "verseOrgIds": [
              "LEV.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze asaturemwo kubiri iyo nyoni, ayisaturire hagati y’amababa mu gukwega umubiri wayo, ariko ntaze atandukanye ivyo bice bibiri, hanyuma umuherezi aze ayituririre ku nkwi ziriko zirakira ku gicaniro, nk’ikimazi co guturirwa, gitanzwe biciye mu guturirwa, ishikanwa rimota neza rinezereza ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.17",
            "verseOrgIds": [
              "LEV.1.17"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.1.17",
            "verseOrgIds": [
              "LEV.1.17"
            ]
          }
        }
      ]
    }
