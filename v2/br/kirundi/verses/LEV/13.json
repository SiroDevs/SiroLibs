              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "text": " abarira Mose na Aroni ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.1",
            "verseOrgIds": [
              "LEV.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Umuntu niyaba afise ikibibi canke igisekera canke ikivyimba ku mubiri wiwe gishobora kuvamwo imibembe, baze bamushire Aroni canke umwe mu bana biwe azoba ari umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.2",
            "verseOrgIds": [
              "LEV.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi aze asuzume ico kintu kiri ku mubiri, niyasanga ubwoya buri muri ico kibibi bwahindutse bukera kandi n’ico kibibi na co nyene cimburutse, izoba ari imibembe. Uwo muherezi amaze kumusuzuma aze amenyeshe ko uwo muntu acitse uwuhumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.3",
            "verseOrgIds": [
              "LEV.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico kibibi nicaba cera ariko kitimburutse kandi ubwoya buri muri co ntibwere, uwo muherezi aze ashire uwo muntu ahantu ha wenyene ahamare imisi indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.4",
            "verseOrgIds": [
              "LEV.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira indwi uwo muherezi aze asubire amusuzume, niyasanga ico kibibi kitahindutse kandi kitagutse, aze asubire amushire ahantu ha wenyene iyindi misi indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.5",
            "verseOrgIds": [
              "LEV.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira indwi aze asubire kandi amusuzume. Ico kibibi nicaba cagabanutse nticiyongere ku mubiri, uwo muherezi aze amenyeshe ko uwo muntu adahumanye; kizoba ari ikibibi gisanzwe. Uwo muntu aze amesure impuzu ziwe, aheze abe ahumanuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.6",
            "verseOrgIds": [
              "LEV.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ico kibibi niciyongera ku mubiri inyuma y’uko umuherezi azoba yamaze kumenyesha ko adahumanye, aze agaruke kubonana n’umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.7",
            "verseOrgIds": [
              "LEV.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi aze amusuzume, ico kibibi nicaba caragutse, aze amenyeshe ko ahumanye; izoba ari imibembe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.8",
            "verseOrgIds": [
              "LEV.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese azoba agwaye ingwara yo ku rukoba, baze bamushire umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.9",
            "verseOrgIds": [
              "LEV.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi aze amusuzume, niyasanga ahari ikibibi hera kandi n’ubwoya bwo muri ico kibibi bwahindutse bukera hakaba hanavyimvye, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.10",
            "verseOrgIds": [
              "LEV.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "izoba ari imibembe yamufashe. Umuherezi azoce amenyesha ko ahumanye. Ntaze arinde kumushira ahantu ha wenyene ngo amusuzume, kuko azoba yari asanzwe amaze guhumana.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.11",
            "verseOrgIds": [
              "LEV.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ngwara niyaba yakwiye umubiri wose, aho umuherezi agarukiriza amaso hose, kuva ku mutwe gushika ku birenge, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.12",
            "verseOrgIds": [
              "LEV.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo muherezi aze amusuzume, asanze iyo ngwara ikwiye umubiri wiwe wose, aze amenyeshe ko iyo ngwara idatuma umuntu aba uwuhumanye, hanyuma amenyeshe ko uwo muntu adahumanye. Kuko umubiri wiwe wose wahindutse ukera, azoba adahumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.13",
            "verseOrgIds": [
              "LEV.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko igihe habonetse igisebe gishasha kuri we, azoba ahumanye. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.14",
            "verseOrgIds": [
              "LEV.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi niyabona ico gisebe gishasha, aze yihute kumenyesha ko ahumanye kuko igisebe kiba gihumanye; azoba agwaye imibembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.15",
            "verseOrgIds": [
              "LEV.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gisebe nicahinduka kikera, azoce aja ku muherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.16",
            "verseOrgIds": [
              "LEV.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi aze amusuzume, niyasanga ico gisebe cahindutse kikera, uwo muherezi azoce amenyesha ko adahumanye; azoba ahumanutse.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.17",
            "verseOrgIds": [
              "LEV.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyagira igisebe ku mubiri kigakira, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.18",
            "verseOrgIds": [
              "LEV.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "hanyuma ahari ico gisebe hakaboneka ikivyimba cera canke igishunduri cera canke gishaka gutukura, aze yiyereke umuherezi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.19",
            "verseOrgIds": [
              "LEV.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muherezi aze ahasuzume, niyasanga himburutse kandi ubwoya bwaho bwahindutse bukera, uwo muherezi aze ace amenyesha ko uwo muntu ahumanye; izoba ari imibembe yadutse muri ya nkovu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.20",
            "verseOrgIds": [
              "LEV.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umuherezi niyahasuzuma agasanga ubwoya bwaho ntibwera kandi ntihimburutse kandi humye, uwo muherezi aze amushire ahantu ha wenyene imisi indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.21",
            "verseOrgIds": [
              "LEV.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aho hantu nihakomeza kuba hanini, umuherezi aze amenyeshe ko uwo muntu ahumanye; izoba ari imibembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.22",
            "verseOrgIds": [
              "LEV.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nihaba ata cahindutse kandi hatabandanije kuba hanini, izoba ari inkovu gusa ivuye ku gisebe, umuherezi aze amenyeshe ko uwo muntu adahumanye.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.23",
            "verseOrgIds": [
              "LEV.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyagira ubushe ku mubiri wiwe maze hakaboneka ibara ryera canke ryera rishaka gusa n’agahama, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.24",
            "verseOrgIds": [
              "LEV.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "umuherezi aze ahasuzume, niyasanga ubwoya bwaho bwahindutse bukera, kandi himburutse, izoba ari imibembe izoba yafatiye muri ya nkovu y’ubushe. Uwo muherezi aze amenyeshe ko uwo muntu ahumanye; izoba ari imibembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.25",
            "verseOrgIds": [
              "LEV.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niyamusuzuma agasanga ubwoya bwaho butera, hatimburutse kandi humye, uwo muherezi azoce amushira ahantu ha wenyene imisi indwi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.26",
            "verseOrgIds": [
              "LEV.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira indwi umuherezi aze amusuzume. Niyasanga habandanije haba hanini, uwo muherezi azoce amenyesha ko uwo muntu ahumanye; izoba ari imibembe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.27",
            "verseOrgIds": [
              "LEV.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko niyasanga ata cahindutse kandi hatabaye hanini ariko humye, izoba yari inkovu y’ubushe gusa, uwo muherezi aze amenyeshe ko uwo muntu adahumanye; izoba yari inkovu gusa y’ubushe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.13.28",
            "verseOrgIds": [
              "LEV.13.28"
            ]
          }
        }
      ]
    },
