        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.1",
            "verseOrgIds": [
              "LEV.4.1"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.1",
            "verseOrgIds": [
              "LEV.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Abisirayeli uti: ‘Umuntu niyacumura atabiteguye, agakora ibinyuranye n’ivyagezwe vy’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        },
        {
          "text": ", uku ni ko bizohora bigenda:",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.2",
            "verseOrgIds": [
              "LEV.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaye ari umuherezi yarobanujwe amavuta yacumuye, akazanira abantu gutsindwa n’urubanza, aze ashikanire ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "text": " ishuri itagira agasembwa kw’ikimazi atangiye icaha yakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.3",
            "verseOrgIds": [
              "LEV.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze azane iyo shuri mu rwinjiriro rw’Ihema ry’Ibonaniro imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "text": ", arambike ikiganza ciwe ku mutwe wayo hanyuma ayikererere imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.4",
            "verseOrgIds": [
              "LEV.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma uwo muherezi yarobanujwe amavuta aze afate igice c’amaraso y’iyo shuri ayatware mw’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.5",
            "verseOrgIds": [
              "LEV.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze akoze urutoke rwiwe muri ayo maraso aheze ayamijagire incuro indwi imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "text": ", imbere y’igihuzu gikingiriye ahera ho mw’ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.6",
            "verseOrgIds": [
              "LEV.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi aze yongere afate ikindi gice c’amaraso ayasige ku mahembe y’igicaniro baturirirako ibimota neza kiri imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "text": " mw’ihema ry’ibonaniro. Amaraso asigaye y’iyo shuri aze ayasuke i ruhande y’igicaniro co guturirirako ibimazi kiri mu rwinjiriro rw’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.7",
            "verseOrgIds": [
              "LEV.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze akureko ibinure vyose kuri iyo shuri itangiwe ivyaha: ibinure vyose bifatanye n’ivyo mu nda, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.8",
            "verseOrgIds": [
              "LEV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "amafyigo yompi n’ibinure biri kuri yo n’ibifatanye n’imbavu, igice kiri hejuru y’igitigu, ico azokuranamwo n’amafyigo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.9",
            "verseOrgIds": [
              "LEV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nka kurya ibinure bikurwa ku mpfizi itangwa kw’ikimazi c’ishimwe. Umuherezi aze abituririre ku gicaniro co guturirirako ibimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.10",
            "verseOrgIds": [
              "LEV.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko urusato rw’iyo shuri, inyama zayo, umutwe, amaguru, ivyo mu nda vyose n’insogi, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.11",
            "verseOrgIds": [
              "LEV.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ukuvuga ibisigaye vyose vyo kuri yo; aze abifate abijane inyuma y’aho mucumbitse mu kibanza gihumanuwe, ahatabwa umunyota, abiturire n’umuriro ku nkwi zigeretse ku kirundo c’umunyota.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.12",
            "verseOrgIds": [
              "LEV.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe Abisirayeli bose ari bo bazoba bacumuye ariko batabishaka, bagakora ibinyuranye n’ivyagezwe vy’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        },
        {
          "text": ", naho abantu bose batomenya ko bacumuye, bazoba ari abo gutsindwa n’urubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.13",
            "verseOrgIds": [
              "LEV.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibamara gutahura icaha bakoze, Abisirayeli bose baze bazane ishuri kw’ikimazi c’ivyaha bayishikane imbere y’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.14",
            "verseOrgIds": [
              "LEV.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru bo mu Bisirayeli baze barambike ibiganza vyabo ku mutwe w’iyo shuri imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "text": ", hanyuma iyo shuri ikerererwe imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.15",
            "verseOrgIds": [
              "LEV.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuherezi yarobanujwe amavuta aze afate igice c’amaraso y’iyo shuri ayajane mw’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.16",
            "verseOrgIds": [
              "LEV.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze akoze urutoke rwiwe muri ayo maraso aheze ayamijagire incuro indwi imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.17",
            "verseOrgIds": [
              "LEV.4.17"
            ]
          }
        },
        {
          "text": ", imbere y’igihuzu gikingiriye ahera ho mw’ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.17",
            "verseOrgIds": [
              "LEV.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze asige igice c’ayo maraso ku mahembe y’igicaniro kiri imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.18",
            "verseOrgIds": [
              "LEV.4.18"
            ]
          }
        },
        {
          "text": " mw’ihema ry’ibonaniro. Amaraso asigaye aze ayasese hasi i ruhande y’igicaniro co guturirirako ibimazi kiri mu rwinjiriro rw’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.18",
            "verseOrgIds": [
              "LEV.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze akureko ibinure vyose kuri ico kimazi aheze abituririre ku gicaniro, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.19",
            "verseOrgIds": [
              "LEV.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "hanyuma ibisigaye abikore nk’uko bikorwa kw’ishuri y’ikimazi gitangirwa ivyaha. Uko ni ko umuherezi azotangira impongano ikoraniro ry’Abisirayeli, kandi bazoharirwa ivyaha vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.20",
            "verseOrgIds": [
              "LEV.4.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma aze afate ibice bisigaye vy’iyo shuri abikure aho bakoraniye, abiturire nk’uko bikorwa kw’ishuri itangirwa umuherezi yarobanujwe amavuta. Ico ni ikimazi gitangirwa ivyaha vy’ikoraniro ry’Abisirayeli ryose.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.21",
            "verseOrgIds": [
              "LEV.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwurongoye abandi mu Bisirayeli niyacumura atabishaka, agakora ibinyuranye n’ivyagezwe vy’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "text": " Imana yiwe, ariko we ntamenye ko yacumuye, na ho nyene azoba ari uwo gutsindwa n’urubanza. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.22",
            "verseOrgIds": [
              "LEV.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyamara gutahura icaha yakoze, aze azane ikimazi c’isuguru y’impene itagira agasembwa, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.23",
            "verseOrgIds": [
              "LEV.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "hanyuma arambike ikiganza ciwe ku mutwe wayo, ace ayikererera aho bakererera ibimazi bituririrwa imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "text": ". Ico ni ikimazi c’ivyaha. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.24",
            "verseOrgIds": [
              "LEV.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma umuherezi aze afate igice c’amaraso y’ico kimazi c’ivyaha ayasigishe urutoke ku mahembe y’igicaniro co guturirirako ibimazi hanyuma asese ayasigaye hasi i ruhande y’igicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.25",
            "verseOrgIds": [
              "LEV.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze aturirire ibinure vyayo vyose ku gicaniro nk’uko baturira ibinure vy’ikimazi c’ishimwe. Uko ni ko umuherezi azotanga impongano y’icaha c’uwo mukuru mu Bisirayeli, kandi na we azoharirwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.4.26",
            "verseOrgIds": [
              "LEV.4.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
