          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira igikoko mu vyo mwemerewe kurya gipfa, umuntu wese azokora ku muvyimba waco azoba ahumanye gushika ku mugoroba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.39",
            "verseOrgIds": [
              "LEV.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese azorya kuri uwo muvyimba aze amesure impuzu ziwe, kandi aze agume ahumanye gushika ku mugoroba. Uwuzoterura uwo muvyimba aze amesure impuzu ziwe, kandi aze agume ahumanye gushika ku mugoroba.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.40",
            "verseOrgIds": [
              "LEV.11.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
