          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayo ni yo mategeko agenga ibikoko, inyoni, ikintu cose gihumeka kigendagenda mu mazi n’ikigendagenda kw’isi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.46",
            "verseOrgIds": [
              "LEV.11.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 11:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze mutandukanye ibizira n’ibitazira, ivyemewe kuribwa mu bihumeka n’ibitemewe kuribwa.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.11.47",
