        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.21",
            "verseOrgIds": [
              "LEV.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aroni aterura amaboko ayarabisha ku bantu bose arabahezagira. Amaze gutanga ikimazi c’ivyaha, ico guturirwa n’ic’amahoro, arururuka ava ku gicaniro.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.9.22",
            "verseOrgIds": [
              "LEV.9.22"
            ]
          }
        }
      ]
    },
