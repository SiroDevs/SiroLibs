              "2SA.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "text": " yinjiye mu Gisagara ca Dawidi, Mikali umukobwa wa Sawuli abirabira mw’idirisha. Abonye umwami Dawidi atamba yiginagura, amugayira mu mutima.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.16",
            "verseOrgIds": [
              "2SA.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze bazana ya Sandugu y’Uhoraho bayinjiza muri rya hema Dawidi yari yayishingiye, hanyuma batanga ibimazi biturirwa n’umuriro hamwe n’ivy’ishimwe imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.17",
            "verseOrgIds": [
              "2SA.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahejeje gutanga ivyo bimazi biturirwa n’umuriro n’ivy’ishimwe, ahezagira abantu mw’izina ry’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "text": " Mushoboravyose. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.18",
            "verseOrgIds": [
              "2SA.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma aca agaburira umuntu wese mw’isinzi ry’Abisirayeli bari ngaho, abagabo n’abagore umwe wese akamuha umukate, inyama hamwe n’agakate gacumbwe mu nzabibu zumye. Ivyo biheze, bose baca barataha iwabo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.19",
            "verseOrgIds": [
              "2SA.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi asubiye iwe guhezagira abo mu nzu yiwe na bo, Mikali umukobwa wa Sawuli araza ngo amuhe ikaze, hanyuma aca amubwira ati: “Mbega icubahiro c’umwami w’Abisirayeli cari hehe, umuntu yiyambura impuzu imbere y’abaguranokazi bashumbiye abagurano biwe, nk’umuntu ata co amaze!”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.20",
            "verseOrgIds": [
              "2SA.6.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
