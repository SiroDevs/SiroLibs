    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi asubira kwegeranya ingabo zigizwe n’abahizi b’Abisirayeli, bashika ibihumbi mirongo itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.1",
            "verseOrgIds": [
              "2SA.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwiwe n’ingabo ziwe zose baragenda baja i Bayala h’i Buyuda kugira ngo bakureyo isandugu y’Imana, yitirirwa rya Zina, ari ryo zina ry’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "text": " Mushoboravyose, avyagiye hagati y’abakerubi bari kuri iyo sandugu. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.2",
            "verseOrgIds": [
              "2SA.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashira ya sandugu y’Imana ku mukogote mushasha bayitwara bayikuye mu nzu kwa Abinadabu yari hejuru ku musozi. Uza na Ahiyo bene Abinadabu, ni bo bayobora inka zikwega uwo mukogote mushasha ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.3",
            "verseOrgIds": [
              "2SA.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "utwaye iyo Sandugu y’Imana, kandi Ahiyo ni we yayigendera imbere. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.4",
            "verseOrgIds": [
              "2SA.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi n’Abisirayeli bose bariko bariginagura imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "text": ", baririmba bavuza inanga, amakembe, udushako tw’ingoma n’ibindi bicurarangisho.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.5",
            "verseOrgIds": [
              "2SA.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse ku mbuga yo kugosorerako ya Nakoni, Uza agorora ukuboko afata iyo sandugu y’Imana ngo ntihenuke, kuko impfizi zikwega uwo mukogote zari zitsitaye. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.6",
            "verseOrgIds": [
              "2SA.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "text": " ashavurira cane Uza kuko akoze ibitari vyo. Nuko Imana iramukubita aca arapfa, agwa ngaho nyene i ruhande y’isandugu y’Imana.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.7",
            "verseOrgIds": [
              "2SA.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi arashavura kuko ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "text": " yarakiye Uza. Aca yita aho hantu Perezi-Uza, bisigura “gushavurira Uza”, kandi ni ko hacitwa kugeza n’uno musi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.8",
            "verseOrgIds": [
              "2SA.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi aca atinya ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "text": " kuri uwo musi, maze arabaza ati: “Mbega Isandugu y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "text": " yoza iwanje gute?” ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.9",
            "verseOrgIds": [
              "2SA.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntiyemera gutwara Isandugu y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "text": " ngo ibe aho asanzwe aba mu Gisagara ca Dawidi, ariko aca ayikebereza mu nzu kwa Obedi-Edomu w’i Gati. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.10",
            "verseOrgIds": [
              "2SA.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isandugu y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "text": " iguma mu nzu kwa Obedi-Edomu w’i Gati kumara amezi atatu, kandi ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "text": " aramuhezagira hamwe n’abo mu nzu yiwe bose.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.11",
            "verseOrgIds": [
              "2SA.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze babarira umwami Dawidi bati: “",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "text": " yarahezagiye abo mu nzu kwa Obedi-Edomu n’ivyo atunze vyose, kubera ya Sandugu y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "text": ".” Nuko Dawidi aramanuka aja kudugana iyo Sandugu y’Imana ayikura mu nzu kwa Obedi-Edomu ayijana mu Gisagara ca Dawidi bari mu munezero mwinshi. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.12",
            "verseOrgIds": [
              "2SA.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abareruye iyo Sandugu y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "text": " bamaze kugira intambuko zitandatu, yaca atanga ikimazi c’ishuri n’inyana ivyibushe. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.13",
            "verseOrgIds": [
              "2SA.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi yari yambaye efodi yera, atambira imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "text": " n’inkomezi ziwe zose. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.14",
            "verseOrgIds": [
              "2SA.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Dawidi n’Abisirayeli bose, badugana Isandugu y’",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        },
        {
          "text": " batera akamo k’umunezero, bavuza n’inzamba.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.6.15",
            "verseOrgIds": [
              "2SA.6.15"
            ]
          }
        }
      ]
    },
