          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani amaze gutaha, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "text": " atuma wa mwana muka Uriya yavyarana na Dawidi agwara. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi asabira uwo mwana ku Mana kugira ngo amureke abeho. Arisonzesha, aja mu nzu yiwe amara amajoro yitembagaza hasi yambaye amagunira. ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru b’umuryango wiwe bahagarara i ruhande yiwe ngo bamwinginge ave hasi, ariko aranka, kandi ntiyagira ico afungurana na bo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.17",
            "verseOrgIds": [
              "2SA.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
