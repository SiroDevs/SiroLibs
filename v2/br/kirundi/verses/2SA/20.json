              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu aramwishura ati: “Ntibikabe ko norota nsambura igisagara canyu! ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.20",
            "verseOrgIds": [
              "2SA.20.20"
            ]
          }
        },
        {
          "name": "verse",
