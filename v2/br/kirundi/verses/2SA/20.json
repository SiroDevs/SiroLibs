              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mugore abwira Yowabu ati: “Umutwe wiwe barawuguterera bawucishije hejuru y’uruzitiro.”",
          "type": "text",
          "attrs": {
            "verseId": "2SA.20.21",
