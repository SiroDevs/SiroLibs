              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo, Dawidi asiguza ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.2.1",
            "verseOrgIds": [
              "2SA.2.1"
            ]
          }
        },
        {
          "text": ". Amubaza ati: “Nduge nje mu gisagara kimwe c’i Buyuda?”",
          "type": "text",
