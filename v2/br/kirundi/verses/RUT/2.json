          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Rusi abwira inabukwe nyene aho hantu yakoreye. Aravuga ati: “Izina ry’uwo mugabo nyene umurima nakoreyemwo uno musi ni Bowazi.”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
    },
