          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawomi abwira umukazana wiwe ati: “",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        },
        {
          "text": " amuhezagire. Ntiyigeze ahagarika kugirira neza twebwe abazima n’abahisi.” Arongerako ati: “Urya mugabo ni incuti yacu ya hafi; ni umwe mu bacunguzi bacu.”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.20",
            "verseOrgIds": [
              "RUT.2.20"
            ]
          }
        }
