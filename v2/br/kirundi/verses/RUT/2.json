              "type": "text"
            }
          ]
        },
        {
          "text": "Inabukwe aramubaza ati: “Mbega watoratoye he uwu musi? Wakoreye he? Uwo mugabo yakwitayeho aragahezagirwa!”",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
    },
    {
