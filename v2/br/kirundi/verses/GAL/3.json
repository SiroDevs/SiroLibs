              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwese muri abana b’Imana kubera kwizera Kristo Yesu, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
              "GAL.3.26"
            ]
          }
        },
        {
