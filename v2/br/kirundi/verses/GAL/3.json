          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta Muyuda canke Umugiriki, nta mugurano canke uwidegemvya, nta mugore canke umugabo, mwese muri umwe muri Kristo Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
