          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbere yuko ukwo kwizera kuza, twari imbohe z’ivyagezwe, twari tuboshwe gushika ukwizera guhishurwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
            "verseOrgIds": [
              "GAL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ukuvuga ko, ivyagezwe vyari nk’umurezi aturera gushika Kristo aje kugira ngo twemerwe n’Imana nk’abagororotsi tubihawe no kwizera. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero ko ukwizera kwabonetse, ntitukirezwe n’ivyagezwe.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        }
      ]
