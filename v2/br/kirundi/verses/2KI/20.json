        },
        {
          "text": "Hezekiya amwishura ati: “Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.19",
            "verseOrgIds": [
              "2KI.20.19"
            ]
          }
        },
        {
          "text": " uvuze ni ryiza.” Aho rero ni kubera yibwira mu mutima ati: “Kazima mu gihe nzoba nkiriho hazoba hari amahoro.”",
          "type": "text",
          "attrs": {
