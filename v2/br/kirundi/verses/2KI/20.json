            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
