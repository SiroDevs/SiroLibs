            "sid": "2KI 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri iyo misi, Hezekiya aragwara, ashika ku mpfiro. Umuvugishwa Yesaya mwene Amozi aja kumuraba, amubwira ati: “",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        },
        {
          "text": " avuze ngo: ‘Tunganya ivyo mu rugo rwawe, kuko ugiye gupfa, ntuzokira.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.1",
            "verseOrgIds": [
              "2KI.20.1"
            ]
          }
        }
      ]
    },
    {
