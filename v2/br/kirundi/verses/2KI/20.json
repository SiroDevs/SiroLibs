          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuvugishwa Yesaya aragenda abaza umwami Hezekiya ati: “Abo bantu bakubwiye iki, kandi baje bava he?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya amwishura ati: “Baje bava mu gihugu ca kure; bavuye i Babiloni.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
