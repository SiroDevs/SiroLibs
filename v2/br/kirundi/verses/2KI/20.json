              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya abwira Hezekiya ati: “Niwumve ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.16",
            "verseOrgIds": [
              "2KI.20.16"
            ]
          }
