          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.14",
            "verseOrgIds": [
              "2KI.20.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesaya aramubaza ati: “Babonye iki ku kirimba iwawe?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya amwishura ati: “Babonye ibintu vyose biri mu ngoro yanje. Nta na kimwe c’ubutunzi bwanje ntaberetse.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.20.15",
            "verseOrgIds": [
              "2KI.20.15"
            ]
          }
        }
      ]
    },
