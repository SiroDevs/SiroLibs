              "2KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusi umwe umwami wa Isirayeli yariko aragendagenda ku ruzitiro, yumva umugore asemerera avuga ati: “Ntabara se mwami nyeningoma!”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.26",
            "verseOrgIds": [
              "2KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami amwishura ati: “Nimba ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "text": " atagutabaye, jewe nokura he ico kugufashisha? Nta kintu na kimwe gisigaye. Ku mbuga yo gukubitirako ingano canke mu bwato bwo kuganiramwo umuvinyu.” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.27",
            "verseOrgIds": [
              "2KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko arongera amubaza ati: “Ufise ingorane nki?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na we amwishura ati: “Uyu mugore yambwiye ati: ‘Zana umuhungu wawe tumurye uwu musi, ejo na ho tuzorya uwanje.’ ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.28",
            "verseOrgIds": [
              "2KI.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko uwiwanje turamuteka turamurya. Bukeye ndamubwira nti: ‘Zana umuhungu wawe na we tumurye.’ Ariko aca aramunyegeza.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.29",
            "verseOrgIds": [
              "2KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami yumvise amajambo y’uwo mugore, yitaburirako impuzu. Uko yagendagenda ku ruzitiro, abanyagisagara bose bamurabira hasi, bamubona yambaye igunira ryonyene. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.30",
            "verseOrgIds": [
              "2KI.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aravuga ati: “Imana ibimpanire, kandi bihambaye, uwu musi umutwe wa Elisa mwene Shafati niwarara ugifatanye n’ibitugu vyiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.31",
            "verseOrgIds": [
              "2KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa yari yicaye i muhira iwe, ari kumwe n’abatware. Umwami aca arungika intumwa imbere yiwe, ariko bataranashika, Elisa abarira ba batware ati: “Murabona ingene uwu mwicanyi arungitse umuntu kunca umutwe! Niyashika muce mwugara umuryango, mumwugaranire hanze. Ibirenge vya shebuja ntimuvyumva inyuma yiwe?” ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.32",
            "verseOrgIds": [
              "2KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akiriko arababwira ivyo, ya ntumwa iba irabashikiriye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aravuga ati: “",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        },
        {
          "text": " ni we aduteye aya magorwa yose. None noba nkimwitezeko iki?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.6.33",
            "verseOrgIds": [
              "2KI.6.33"
            ]
          }
        }
      ]
