              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazayeli umwami w’i Siriya apfuye, umuhungu wiwe Beni-Hadadi aba ari we amusubirira ku ngoma. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.24",
            "verseOrgIds": [
              "2KI.13.24"
            ]
          }
        },
        {
