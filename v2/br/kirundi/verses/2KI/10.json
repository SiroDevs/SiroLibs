          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Yehu, ivyo yakoze n’ivyo yashitseko, vyanditswe mu gitabu c’ivyabaye ku bami ba Isirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.10.34",
            "verseOrgIds": [
              "2KI.10.34"
            ]
          }
        }
