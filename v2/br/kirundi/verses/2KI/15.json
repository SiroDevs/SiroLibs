          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira mirongo itatu n’icenda Azariya ari ku ngoma i Buyuda, Menahemu mwene Gadi ni ho yaba umwami wa Isirayeli, atwarira i Samariya imyaka cumi. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.17",
            "verseOrgIds": [
              "2KI.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.18",
            "verseOrgIds": [
              "2KI.15.18"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe, ntiyava mu vyaha vya Yerobowamu mwene Nebati, ivyo yakoze akanabikwegeramwo Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.18",
            "verseOrgIds": [
              "2KI.15.18"
            ]
          }
        }
      ]
