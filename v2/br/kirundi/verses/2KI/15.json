          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntiyashoboye gukuraho ibibanza vyo gusengeramwo vyo ku mataba y’imisozi; abantu babandanije gushikanirayo ibimazi no gutuririraho ibimota neza. Yotamu ni we yasanuye Irembo ryo Haruguru y’Ingoro y’",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.35",
            "verseOrgIds": [
              "2KI.15.35"
            ]
          }
        }
      ]
