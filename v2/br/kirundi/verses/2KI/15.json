              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Menahemu, n’ivyo yakoze vyose, vyanditswe mu gitabu c’ivyabaye ku ngoma z’abami ba Isirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.21",
            "verseOrgIds": [
              "2KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu arahava ahamvya ba sekuruza, umuhungu wiwe Pekahiya aba ari we amusubirira ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        }
      ]
