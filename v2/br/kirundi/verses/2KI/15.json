          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira mirongo itanu Azariya ari ku ngoma i Buyuda, ni ho Pekahiya mwene Menahemu yaba umwami wa Isirayeli, atwarira i Samariya imyaka ibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.23",
            "verseOrgIds": [
              "2KI.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
