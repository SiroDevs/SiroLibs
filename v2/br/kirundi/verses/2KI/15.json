          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pekahiya akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe, ntiyava mu vyaha vya Yerobowamu mwene Nebati, ivyo yakoze akanabikwegeramwo Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.24",
            "verseOrgIds": [
              "2KI.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwe mu bakuru b’intwazangabo bakuru yitwa Peka, mwene Remaliya, arondera ingene amwica. Ahitana abasoda mirongo itanu i Gileyadi bajana na we, yica Pekahiya, amwicana na Arugobu na Ariyehi abicira mu nzu imwe yo ku kirimba i Samariya. Uko ni ko Peka yishe Pekahiya aca amusubirira ku ngoma nk’umwami w’Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.25",
            "verseOrgIds": [
              "2KI.15.25"
            ]
          }
        }
      ]
