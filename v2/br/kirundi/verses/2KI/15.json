              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.15",
            "verseOrgIds": [
              "2KI.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe Menahemu atera Tifusa n’imihana ihegereye gushika i Tiriza, arahatikiza kuko abantu baho banse kwishikana kuri we. Yica abantu bose, afomoza n’abagore bafise inda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.16",
            "verseOrgIds": [
              "2KI.15.16"
            ]
          }
        }
      ]
    },
