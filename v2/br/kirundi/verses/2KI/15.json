          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Hoseya mwene Ela arondera ingene yica Peka mwene Remaliya. Aramutera aramwica, aca aba ari we amusubirira ku ngoma. Aho hari mu mwaka ugira mirongo ibiri Yotamu mwene Uziya ari ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        }
