            "number": "23",
            "style": "v",
            "sid": "2KI 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mwaka ugira cumi na gatanu Amaziya ari ku ngoma i Buyuda, Yerobowamu mwene Yowashi umwami wa Isirayeli ni ho yaza i Samariya atwarirayo imyaka mirongo ine n’umwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.23",
            "verseOrgIds": [
              "2KI.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe, ntiyava mu vyaha vya Yerobowamu mwene Nebati, ivyo yakoze yongera abikwegeramwo Abisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.24",
            "verseOrgIds": [
              "2KI.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni we yasubijeho imbibe za Isirayeli, kuva i Lebo-Hamati gushika ku kiyaga ca Araba, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli yabivugishije umusavyi wiwe Yona mwene Amitayi, umuvugishwa yava i Gati-Heferi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.25",
            "verseOrgIds": [
              "2KI.14.25"
            ]
          }
        }
      ]
    },
