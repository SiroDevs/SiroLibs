            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "text": " yari yabonye amakuba n’imibabaro Abisirayeli barimwo, baba abagurano canke abidegemvya, ata kibatabara. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.26",
            "verseOrgIds": [
              "2KI.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        },
        {
          "text": " atari yarigeze avuga ko azohanagura izina rya Isirayeli kw’isi, abakirisha ukuboko kwa Yerobowamu mwene Yowashi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.14.27",
            "verseOrgIds": [
              "2KI.14.27"
            ]
          }
        }
      ]
    },
