          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Gehazi aca yoma inyuma Namani. Namani abonye ko ariko araza amukurikira, aca yururuka umukogote, aja guhura na we, aramubaza ati: “Ni amahoro?”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.21",
            "verseOrgIds": [
              "2KI.5.21"
            ]
          }
        }
      ]
    },
