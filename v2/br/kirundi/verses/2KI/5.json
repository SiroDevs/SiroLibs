          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Namani amaze kugenda urugendo rutari ruto, Gehazi umukozi wa Elisa umuntu w’Imana yibwira ati: “Databuja yorohereje cane uwu Musiriya, ntiyari akwiye kwanka kwakira ivyo yamuzaniye. Ndarahiye ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        },
        {
          "text": ", singenda ntamukurikiye ngo ngire ico ndamukuyeko.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.20",
            "verseOrgIds": [
              "2KI.5.20"
            ]
          }
        }
