          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gehazi yishura ati: “Umusavyi wawe nta na hamwe yari yaroye.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.5.25",
            "verseOrgIds": [
              "2KI.5.25"
            ]
          }
        }
