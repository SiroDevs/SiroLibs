          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.8",
            "verseOrgIds": [
              "2KI.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aca arungika umukuru w’abasoda mirongo itanu hamwe n’ingabo ziwe kuja gufata Eliya. Basanga yicaye hejuru ku gasozi. Uwo mukuru w’abasoda amubwira ati: “Muntu w’Imana, umwami avuze ngo nuze tumanukane.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.9",
            "verseOrgIds": [
              "2KI.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliya amwishura ati: “Nimba ndi umuntu w’Imana, umuriro numanuke uvuye mw’ijuru, ubatikize mwese n’abasoda bawe uko ari mirongo itanu!” Ubwo nyene umuriro uca urakoroka uvuye mw’ijuru, utongora uwo mukuru w’abasoda n’abasoda biwe bose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.1.10",
            "verseOrgIds": [
              "2KI.1.10"
            ]
          }
        }
