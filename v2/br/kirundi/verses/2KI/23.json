              "2KI.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Yosiya hamwe n’ivyo yakoze vyanditswe mu gitabu c’ivyabaye ku ngoma z’abami b’i Buyuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya akiri ku ngoma, umwami wa Egiputa yitwa Farawo Neko aduga ku ruzi Efurate gufasha umwami w’i Ashuri. Umwami Yosiya aja kumutegera ngo amugwanye, ariko Neko amwicira i Megido aho bagwaniye. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu biwe bashira ikiziga ciwe mu mukogote, bagikura i Megido, bagitwara i Yerusalemu, bamuhamba mu mva yiwe ubwiwe. Abantu bo muri ico gihugu bafata Yehowahazi mwene Yosiya bamurobanuza amavuta, ngo abe umwami mu gishingo ca se.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowahazi yari afise imyaka mirongo ibiri n’itatu igihe yimikwa ngo abe umwami, aca aganza amezi atatu ari i Yerusalemu. Nyina wiwe yitwa Hamutali, umukobwa wa Yeremiya w’i Libuna. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "text": " abona ko ari bibi mu nyonga ziwe, nk’uko ba sekuruza bakoze. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo Neko amushira mw’ibohero i Ribula mu ntara y’i Hamati kugira ngo ntabandanye aganza i Yerusalemu; aca ategeka Abayuda gutanga amashikanwa yo kwisaba angana n’italanto ijana",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:33",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 3.750.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza n’imwe",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "23:33",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 34.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’inzahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo Neko aca yimika Eliyakimu uwundi muhungu wa Yosiya mu kibanza ca se, amuhindura izina, amwita Yehoyakimu. Nuko Yehowahazi ajanwa muri Egiputa, apfirayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakimu aha Farawo Neko ayo mashikanwa y’ifeza n’inzahabu yaciriye Ubuyuda. Kugira ngo ayegeranye, yatangishije amakori abanyagihugu bose b’i Buyuda, akurikije uko batunze.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
