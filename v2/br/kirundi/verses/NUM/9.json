            "sid": "NUM 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "text": " avugana na Mose mu bugaragwa bw’i Sinayi mu kwezi kwa mbere kw’umwaka ugira kabiri bavuye muri Egiputa. Aramubwira ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.1",
            "verseOrgIds": [
              "NUM.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Abisirayeli baze bahimbaze Pasika mu gihe cashinzwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.2",
            "verseOrgIds": [
              "NUM.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muze muyihimbaze mu gihe cashinzwe, ku mugoroba w’umusi ugira icumi na kane w’uku kwezi, nk’uko amategeko n’ingingo biyigenga bimeze.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.3",
            "verseOrgIds": [
              "NUM.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose abarira Abisirayeli guhimbaza Pasika, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.4",
            "verseOrgIds": [
              "NUM.9.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "na bo barabikora mu bugaragwa bw’i Sinayi ku mugoroba w’umusi ugira icumi na kane w’ukwezi kwa mbere. Abisirayeli bakora vyose nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "text": " yari yabitegetse Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.5",
            "verseOrgIds": [
              "NUM.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko hariho bamwe batashoboye guhimbaza Pasika kuri uwo musi kuko bari bahumanijwe n’uko bakoze ku mivyimba. Nuko baza aho Mose na Aroni bari kuri uwo musi nyene ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.6",
            "verseOrgIds": [
              "NUM.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "babarira Mose bati: “Twahumanijwe n’uko twakoze ku mivyimba. None ntitwemererwa gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        },
        {
          "text": " ikimazi hamwe n’abandi Bisirayeli kandi ari igihe cashinzwe?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.7",
            "verseOrgIds": [
              "NUM.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose arabishura ati: “Rindira nsiguze ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        },
        {
          "text": " kugira ngo menye ico avuga ku biberekeye.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.8",
            "verseOrgIds": [
              "NUM.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.9",
            "verseOrgIds": [
              "NUM.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Bwira Abisirayeli uti: ‘Igihe umuntu wese wo muri mwebwe canke wo mu ruvyaro rwanyu azoba ahumanijwe n’umuvyimba canke afashe urugendo, azoshobora guhimbaza Pasika y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.10",
            "verseOrgIds": [
              "NUM.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baze bayihimbaze ku musi ugira icumi na kane w’ukwezi kwa kabiri ku mugoroba. Baze barye umwagazi, bawukoze imikate itarimwo umwambiro n’imboga zirura. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.11",
            "verseOrgIds": [
              "NUM.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibaze bareke ivyasigaye ngo bishike mu gitondo bukeye canke ngo bavune igufa na rimwe. Igihe bazohimbaza Pasika, baze babikore nk’uko amategeko avuga. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.12",
            "verseOrgIds": [
              "NUM.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko umuntu azoba adahumanye kandi atafashe urugendo atazohimbaza Pasika, uwo muntu aze akurwe mu bwoko bwabo kuko atatanze ikimazi k’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "text": " mu gihe cashinzwe. Uwo muntu azozira icaha ciwe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.13",
            "verseOrgIds": [
              "NUM.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umunyamahanga aba muri mwebwe ashaka guhimbaza Pasika y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        },
        {
          "text": " aze abikore yisunze amateka n’amategeko ayigenga. Mwese muze mugengwe n’amategeko amwe yaba umunyamahanga canke imvukira.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.14",
            "verseOrgIds": [
              "NUM.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ihema ryashingwa, ari ryo Hema ry’Ibonaniro, igicu caciye kiritwikira. Kuva ku mugoroba gushika mu gitondo ico gicu cari kw’Ihema kandi casa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.15",
            "verseOrgIds": [
              "NUM.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uko ni ko vyagumye; ico gicu gipfutse iryo Hema mw’ijoro casa n’umuriro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.16",
            "verseOrgIds": [
              "NUM.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe cose ico gicu cava kw’Ihema, Abisirayeli baca bahaguruka bagafata urugendo; aho ico gicu cahagarara, ni ho baca bashinga amahema bagacumbika. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.17",
            "verseOrgIds": [
              "NUM.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ategetse ngo bimuke baca bimuka, yategeka ngo bacumbike, bagacumbika. Igihe cose ico gicu caguma hejuru ya rya hema, baguma aho bacumbitse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.18",
            "verseOrgIds": [
              "NUM.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo ico gicu kigumye kuri iryo Hema igihe kirekire, Abisirayeli barubaha ico ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "text": " ategetse ntibimuka aho bacumbitse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.19",
            "verseOrgIds": [
              "NUM.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rimwe na rimwe ico gicu camara imisi mikeya hejuru yaryo; ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.20",
            "verseOrgIds": [
              "NUM.9.20"
            ]
          }
        },
        {
          "text": " ategetse ko bacumbika bagashinga amahema, yategeka ko bimuka bakayashingura. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.20",
            "verseOrgIds": [
              "NUM.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hari aho ico gicu caguma hejuru yaryo kuva ku mugoroba gushika mu gitondo gusa, cahaguruka mu gitondo bagaca bahaguruka bakagenda. Haba ku murango canke mw’ijoro, iyo ico gicu kivuye hasi baca bahaguruka bakagenda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.21",
            "verseOrgIds": [
              "NUM.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimba ico gicu kigumye hejuru y’ihema imisi ibiri canke ukwezi canke umwaka, Abisirayeli baguma aho bacumbitse, ntibimuka; ariko igihe kivuye hasi, baca bazinga amahema bakagenda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.22",
            "verseOrgIds": [
              "NUM.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ategetse baca bacumbika, yategeka bakazinga amahema bakagenda. Bumvira itegeko ry’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.23",
            "verseOrgIds": [
              "NUM.9.23"
            ]
          }
        },
        {
          "text": ", nk’uko yari yabibategetse abicishije kuri Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.9.23",
            "verseOrgIds": [
              "NUM.9.23"
            ]
          }
        }
      ]
    }
  ],
