          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.32",
            "verseOrgIds": [
              "NUM.22.32"
            ]
          }
        },
        {
          "text": " aramubaza ati: “Wakubitiye iki iyo ndogoba yawe gatatu kose? Nzanywe no kugutangira kuko inzira uriko urajana itari yo mu maso yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.32",
            "verseOrgIds": [
              "NUM.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Indogoba yambonye ica irakevya gatatu kose. Iyo idakevya, ubu mba nakwishe, ariko yo nkayireka.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.33",
            "verseOrgIds": [
              "NUM.22.33"
            ]
          }
        }
      ]
    },
