              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze wa mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.26",
            "verseOrgIds": [
              "NUM.22.26"
            ]
          }
        },
        {
          "text": " arasubira yigira imbere ahagarara aho inzira yaga ata ho ishobora gukebereza, haba i buryo canke i bubamfu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.26",
            "verseOrgIds": [
              "NUM.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
