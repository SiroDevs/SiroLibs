          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu yishura iyo ndogoba ati: “Wankinishije! Iyo mba mfise inkota, mba ndakwishe ubu nyene!”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.29",
            "verseOrgIds": [
              "NUM.22.29"
            ]
          }
        }
      ]
