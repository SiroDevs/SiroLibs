          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        },
        {
          "text": " abarira Balamu ati: “Jana n’abo bantu, ariko uzovuga ivyo nkubwira gusa.” Nuko Balamu ajana n’abo bakuru ba Balaki.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 22:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.35",
            "verseOrgIds": [
              "NUM.22.35"
            ]
          }
        },
        {
          "name": "verse",
