        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli bagenda berekeye ku kiyaya c’i Mowabu, baca bacumbika ku nkengera y’uruzi Yorodani hakurya y’i Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.1",
            "verseOrgIds": [
              "NUM.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Balaki mwene Zipori abona ivyo Abisirayeli bakoreye Abamori, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.2",
            "verseOrgIds": [
              "NUM.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamowabu baca bagira ubwoba bwinshi kuko Abisirayeli bari benshi. Kandi vy’ukuri Abanyamowabu baciye bihebura kubera Abisirayeli.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.3",
            "verseOrgIds": [
              "NUM.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.3",
            "verseOrgIds": [
              "NUM.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abanyamowabu babarira abatware b’i Midiyani bati: “Iri sinzi ry’aba bantu bagiye kurigata ibintu vyose bidukikuje, baturigate nk’uko inka irisha ubwatsi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Balaki mwene Zipori ari we yari umwami w’i Mowabu muri ico gihe, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.4",
            "verseOrgIds": [
              "NUM.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arungika intumwa guhamagara Balamu mwene Beyori, yari i Petori, hafi y’uruzi Efurate, iyo yavuka. Balaki aravuga ati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.5",
            "verseOrgIds": [
              "NUM.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.6",
            "verseOrgIds": [
              "NUM.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze za ntumwa zari zigizwe n’abakuru b’i Mowabu n’i Midiyani baragenda, batwaye n’ingemu. Bashitse kwa Balamu, bamubarira ivyo Balaki yabatumye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.7",
            "verseOrgIds": [
              "NUM.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.7",
            "verseOrgIds": [
              "NUM.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu ababarira ati: “Nimurare ngaha, nanje nzobabwira inyishu ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        },
        {
          "text": " azompa.” Nuko abo bakuru b’i Mowabu bagumana na we.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.8",
            "verseOrgIds": [
              "NUM.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Imana iraza ibaza Balamu iti: “Abo bantu muri kumwe ni ba nde?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.9",
            "verseOrgIds": [
              "NUM.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.9",
            "verseOrgIds": [
              "NUM.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu yishura Imana ati: “Balaki mwene Zipori, umwami w’i Mowabu, yantumyeko ubutumwa buvuga ngo: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.10",
            "verseOrgIds": [
              "NUM.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Abantu bavuye muri Egiputa buzuye igihugu cose. None nuze ubamvumire. Kumbure noshobora kubagwanya no kubirukana mu gihugu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.11",
            "verseOrgIds": [
              "NUM.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.11",
            "verseOrgIds": [
              "NUM.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Imana ica ibwira Balamu iti: “Ntujane na bo. Ntuze uvume abo bantu kuko bahezagiwe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.12",
            "verseOrgIds": [
              "NUM.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.12",
            "verseOrgIds": [
              "NUM.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bukeye mu gitondo Balamu aravyuka abarira ba bakuru ba Balaki ati: “Nimusubire mu gihugu canyu, kuko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.13",
            "verseOrgIds": [
              "NUM.22.13"
            ]
          }
        },
        {
          "text": " yanse ko njana namwe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.13",
            "verseOrgIds": [
              "NUM.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.13",
            "verseOrgIds": [
              "NUM.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba bakuru b’i Mowabu basubira kuri Balaki baramubwira bati: “Balamu yanse kuzanana natwe.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.14",
            "verseOrgIds": [
              "NUM.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma Balaki atuma abandi bakuru benshi kuruta ba bandi babarusha n’icubahiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.15",
            "verseOrgIds": [
              "NUM.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashika kwa Balamu baramubwira bati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.16",
            "verseOrgIds": [
              "NUM.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.17",
            "verseOrgIds": [
              "NUM.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Balamu arabishura ati: “Naho Balaki yompa inzahabu n’ifeza vyuzuye inzu yiwe, sinokora ikintu na kimwe, caba kinini canke gito, ngo ndenge kw’itegeko ry’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.18",
            "verseOrgIds": [
              "NUM.22.18"
            ]
          }
        },
        {
          "text": " Imana yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.18",
            "verseOrgIds": [
              "NUM.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko nimurare hano nk’uko abandi bagize, nanje menye ico ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        },
        {
          "text": " ari bumbarire.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.19",
            "verseOrgIds": [
              "NUM.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iryo joro Imana iraza ibaza Balamu iti: “Aba bantu ko baje kuguhamagara, jana na bo, ariko uze ukore ico nzokubwira gusa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.20",
            "verseOrgIds": [
              "NUM.22.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.20",
            "verseOrgIds": [
              "NUM.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu avyuka mu gitondo, ategura indogoba yiwe ajana n’abo bakuru b’i Mowabu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.21",
            "verseOrgIds": [
              "NUM.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Imana ishavuzwa cane n’uko Balamu agiye, maze umumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.22",
            "verseOrgIds": [
              "NUM.22.22"
            ]
          }
        },
        {
          "text": " ahagarara mu nzira ngo amutangire. Balamu yari ku ndogoba yiwe, kandi yari kumwe n’abakozi biwe babiri. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.22",
            "verseOrgIds": [
              "NUM.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ndogoba ibona wa mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.23",
            "verseOrgIds": [
              "NUM.22.23"
            ]
          }
        },
        {
          "text": " ahagaze mu nzira afise inkota isokoye mu rwubati, ica irakevya ija mw’ishamba; ariko Balamu arayikubita ayisubiza mu nzira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.23",
            "verseOrgIds": [
              "NUM.22.23"
            ]
          }
        }
      ]
    },
