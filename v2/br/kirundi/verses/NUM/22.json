          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ndogoba ibonye wa mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.27",
            "verseOrgIds": [
              "NUM.22.27"
            ]
          }
        },
        {
          "text": ", ica iryama hasi Balamu akiri kuri yo, na we aca arashavura cane aca arayikubita. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.27",
            "verseOrgIds": [
              "NUM.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        },
        {
          "text": " yugurura akanwa ka ya ndogoba, ibwira Balamu iti: “Mbega nagukoreye iki ko umaze kunkubita gatatu kose?”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.28",
            "verseOrgIds": [
              "NUM.22.28"
            ]
          }
        }
      ]
