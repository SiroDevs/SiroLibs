          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko wa mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.24",
            "verseOrgIds": [
              "NUM.22.24"
            ]
          }
        },
        {
          "text": " ahagarara ahantu inzira yaga hagati y’imizabibu ibiri, hari impome zibiri ku mpande zose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.24",
            "verseOrgIds": [
              "NUM.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ndogoba ibonye wa mumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.25",
            "verseOrgIds": [
              "NUM.22.25"
            ]
          }
        },
        {
          "text": ", igerageza kumuca i ruhande yegera uruzitiro ruri ku nzira, ica ifyondera ikirenge ciwe kuri rwa ruzitiro. Nuko aca arasubira arayikubita.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.25",
            "verseOrgIds": [
              "NUM.22.25"
            ]
          }
        }
      ]
