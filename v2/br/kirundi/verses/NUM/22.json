          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Balamu yishura Umumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.34",
            "verseOrgIds": [
              "NUM.22.34"
            ]
          }
        },
        {
          "text": " ati: “Nacumuye. Sinamenye ko uhagaze mu nzira ngo untangire. Ubu niwaba udashaka ko ngenda, nca nsubira inyuma.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.22.34",
            "verseOrgIds": [
              "NUM.22.34"
            ]
          }
        }
      ]
