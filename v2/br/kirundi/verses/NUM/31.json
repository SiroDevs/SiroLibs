      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.1",
            "verseOrgIds": [
              "NUM.31.1"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.1",
            "verseOrgIds": [
              "NUM.31.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Genda utere Abamidiyani ubahoye ivyo bakoreye Abisirayeli. Inyuma y’aho uzoca uhamvya abanyu.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.2",
            "verseOrgIds": [
              "NUM.31.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose abarira abantu ati: “Nihagire abantu bo muri mwebwe bambara ibigwanisho baje kugwanya Abamidiyani kugira ngo bashitse uguhora kw’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.3",
            "verseOrgIds": [
              "NUM.31.3"
            ]
          }
        },
        {
          "text": " kuri bo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.3",
            "verseOrgIds": [
              "NUM.31.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuryango wose mu Bisirayeli urungike abagabo igihumbi.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.4",
            "verseOrgIds": [
              "NUM.31.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko abagabo ibihumbi cumi na bibiri mu Bisirayeli bambara ibigwanisho bitegurira kuja mu ntambara, umuryango wose urungika abagabo igihumbi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.5",
            "verseOrgIds": [
              "NUM.31.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abarungika mu ntambara, ari igihumbi ku muryango wose, abarungikana Finehasi mwene Eliyazeri, umuherezi, ari we yatwaye ibikoresho vyera vyo mw’ihema hamwe n’inzamba zo gutanga ikimenyetso c’akamo k’intambara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.6",
            "verseOrgIds": [
              "NUM.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.6",
            "verseOrgIds": [
              "NUM.31.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bagwanya Abamidiyani, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.7",
            "verseOrgIds": [
              "NUM.31.7"
            ]
          }
        },
        {
          "text": " yategetse Mose, bica abagabo bose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.7",
            "verseOrgIds": [
              "NUM.31.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu bo bishe harimwo Evi, Rekemu, Zuri, Huri na Reba, abami batanu b’i Midiyani. Bicisha inkota na Balamu mwene Beyori. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.8",
            "verseOrgIds": [
              "NUM.31.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bafata mpiri abagore n’abana b’Abamidiyani batwara n’amasho y’Abamidiyani, n’imikuku n’ibindi vyiza vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.9",
            "verseOrgIds": [
              "NUM.31.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baturira ibisagara vyose Abamidiyani babamwo, n’amakambi yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.10",
            "verseOrgIds": [
              "NUM.31.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batwara ibintu vyose n’abantu ivyo bari bigaruriye vyose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.11",
            "verseOrgIds": [
              "NUM.31.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "babizanira Mose na Eliyazeri umuherezi n’ikoraniro ry’Abisirayeli bose aho bari bacumbitse mu biyaya vy’i Mowabu, ku nkombe ya Yorodani aharabana n’i Yeriko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.12",
            "verseOrgIds": [
              "NUM.31.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose, Eliyazeri umuherezi n’abakuru b’abantu bose baja kubasanganirira hanze y’aho bakoraniye. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.13",
            "verseOrgIds": [
              "NUM.31.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ashavurira abakuru b’ingabo; abarongoye ingabo igihumbi n’abatwara ingabo ijana; bari bavuye mu ntambara.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.14",
            "verseOrgIds": [
              "NUM.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.14",
            "verseOrgIds": [
              "NUM.31.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arababarira ati: “Mbega mwakoze iki ko mwaretse abagore ntimubice? ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.15",
            "verseOrgIds": [
              "NUM.31.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni bo bakurikije inama bagiriwe na Balamu kandi ni bo batumye Abisirayeli bakevya bakava k’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.16",
            "verseOrgIds": [
              "NUM.31.16"
            ]
          }
        },
        {
          "text": " mu vyabaye i Peyori, gushika n’aho ikiza gitera abantu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.16",
            "verseOrgIds": [
              "NUM.31.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubu rero nimwice abahungu bose. Kandi mwice umugore wese yaryamanye n’umugabo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.17",
            "verseOrgIds": [
              "NUM.31.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ariko mwisigarize abakobwa bose batigeze baryamana n’umugabo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.18",
            "verseOrgIds": [
              "NUM.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.18",
            "verseOrgIds": [
              "NUM.31.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 31:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu wese wo muri mwebwe yishe umuntu canke yakoze ku wapfuye agume inyuma y’aho mucumbitse kumara imisi indwi. Ku musi wa gatatu no ku musi w’indwi muze mwihumanure mwebwe n’abanyagano banyu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.19",
            "verseOrgIds": [
              "NUM.31.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muhumanure n’impuzu zose n’ikintu cose gikozwe mu rusato, mu bwoya bw’impene canke mu biti.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 31:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.20",
            "verseOrgIds": [
              "NUM.31.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 31:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Eliyazeri umuherezi abarira ingabo zagiye ku rugamba ati: “Ibi ni vyo Ivyagezwe ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.21",
            "verseOrgIds": [
              "NUM.31.21"
            ]
          }
        },
        {
          "text": " yahaye Mose bivuga: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.21",
            "verseOrgIds": [
              "NUM.31.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 31:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inzahabu, ifeza, imiringa, ivyuma, n’ubundi butare ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.22",
            "verseOrgIds": [
              "NUM.31.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 31:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbere n’ibindi vyose bidashobora gusha bize bishirwe mu muriro, ni ho bizoba bihumanuwe. Ariko kandi bize bihumanurwe n’amazi yo guhumanura. Kandi ikintu cose kidashobora kurinda umuriro, kize gicishwe muri ayo mazi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.23",
            "verseOrgIds": [
              "NUM.31.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi w’indwi muze mumesure impuzu zanyu namwe muzoba muhumanuwe. Ni ho muzoshobora kwinjira aho ducumbitse.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 31:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.24",
            "verseOrgIds": [
              "NUM.31.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 31:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.25",
            "verseOrgIds": [
              "NUM.31.25"
            ]
          }
        },
        {
          "text": " abarira Mose ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.25",
            "verseOrgIds": [
              "NUM.31.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 31:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Wewe na Eliyazeri umuherezi n’abakuru b’imiryango y’ubu bwoko muze muharure abantu n’ibitungwa vyanyazwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.26",
            "verseOrgIds": [
              "NUM.31.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mugaburire ivyanyazwe abagabo bagiye kugwana n’abasigaye bo mw’ikoraniro. ",
