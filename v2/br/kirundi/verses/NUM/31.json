          "attrs": {
            "verseId": "NUM.31.28",
            "verseOrgIds": [
              "NUM.31.28"
            ]
          }
        },
        {
          "text": " ungana n’ikintu kimwe ku bintu amajana atanu, baba ari abantu, amasho, indogoba intama canke impene. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.31.28",
            "verseOrgIds": [
