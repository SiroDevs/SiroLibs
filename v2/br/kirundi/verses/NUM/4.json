        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyazeri mwene Aroni, umuherezi, azoba ajejwe kuraba amavuta yo mu matara, ivyo guturirwa bimota neza, amashikanwa y’ifu atangwa imisi yose n’amavuta yo kurobanura. Azoba ajejwe ahera hose n’ibintu vyose biri ngaho, harimwo n’ibikoresho vyose vy’ahera.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.16",
            "verseOrgIds": [
              "NUM.4.16"
            ]
          }
        }
      ]
    },
