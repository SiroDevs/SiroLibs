      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Andika amazina y’abakomoka mu nzu kwa Merari hamwe n’imiryango y’Abamerari bose bakomoka kuri Lewi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.29",
            "verseOrgIds": [
              "NUM.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uze uharure abagabo bose bakwije imyaka mirongo itatu gushika ku mirongo itanu bakwiye gukora mw’ihema ry’ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.30",
            "verseOrgIds": [
              "NUM.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki ni co gikorwa cabo bazokora mw’ihema ry’ibonaniro: kurerura imbaho zubatse ihema, imitambikwa, inkingi n’ivyo kuziterekamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.31",
            "verseOrgIds": [
              "NUM.4.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "inkingi z’urugo n’ivyo kuziterekamwo, imambo zo gushinga ihema, imigozi, n’ibindi vyose bijanye n’igikorwa cavyo. Uze ugenere umuntu wese ivyo akwiye guterura. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.32",
            "verseOrgIds": [
              "NUM.4.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo bikorwa vy’abakomoka kuri Merari nk’uko bakora mw’ihema ry’ibonaniro barongowe na Itamari mwene Aroni, umuherezi.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.33",
            "verseOrgIds": [
              "NUM.4.33"
            ]
          }
        }
      ]
