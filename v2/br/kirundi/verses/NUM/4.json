        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.14",
            "verseOrgIds": [
              "NUM.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni n’abahungu biwe nibaheza gupfuka ibikoresho vyose vyejejwe, abantu na bo bakaba biteguye kugenda bava aho bahora bacumbitse, Abakohati bazoce baza guterura ivyo bikoresho vyose. Ariko ntibaze bakore kuri vya bikoresho vyejejwe kuko bohava bapfa. Abakohati baze baterure vya bikoresho biri mw’ihema ry’ibonaniro.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.15",
            "verseOrgIds": [
              "NUM.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
