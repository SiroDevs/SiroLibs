          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibi ni vyo bikorwa vy’imiryango y’Abagerishoni: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.24",
            "verseOrgIds": [
              "NUM.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazoba bajejwe guterura ibihuzu bikingira ahera n’ivyo mw’ihema ry’ibonaniro, n’ico gupfuka ahera hamwe n’ibipfuka hanze bikozwe mu nsato, n’ibihuzu bikingira ku muryango w’ihema ry’ibonaniro, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.25",
            "verseOrgIds": [
              "NUM.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ibihuzu bikingira bigize urugo rw’ihema n’igicaniro, igihuzu gikingiriye irembo, imigozi n’ibindi bikoresho bijanye bigize urwo rugo. Abagerishoni baze bakore ibikeneye gukorwa vyo kuri ivyo bintu. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.26",
            "verseOrgIds": [
              "NUM.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni n’abahungu biwe baze bereke Abagerishoni ibikorwa vyose bajejwe vyaba ivyo bakora canke ivyo baterura. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.27",
            "verseOrgIds": [
              "NUM.4.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo ni vyo abakomoka ku nzu ya Gerishoni bazokora mw’ihema ry’ibonaniro. Ivyo bazokora baze babikore barongowe na Itamari mwene Aroni, umuherezi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.4.28",
            "verseOrgIds": [
              "NUM.4.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
