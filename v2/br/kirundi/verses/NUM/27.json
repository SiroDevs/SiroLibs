          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose akora nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "text": " yari yamutegetse. Ajana Yosuwa amuhagarika imbere ya Eliyazeri umuherezi n’ikoraniro ryose. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.22",
            "verseOrgIds": [
              "NUM.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze amurambikako ibiganza aca aramutuma, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        },
        {
          "text": " yari yabitegetse biciye muri Mose.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.23",
            "verseOrgIds": [
              "NUM.27.23"
            ]
          }
        }
