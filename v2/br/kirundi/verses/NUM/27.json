              "NUM.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Jana Yosuwa mwene Nuni, umuntu arimwo Mpwemu, umurambikeko ikiganza. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.18",
            "verseOrgIds": [
              "NUM.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhagarike imbere ya Eliyazeri umuherezi n’ishengero ryose umushikirize ibikorwa imbere yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.19",
            "verseOrgIds": [
              "NUM.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuhe ku bubasha bwawe kugira ngo ishengero ry’Abisirayeli bose baze bamwumvire. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.20",
            "verseOrgIds": [
              "NUM.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aze ahagarare imbere ya Eliyazeri umuherezi, kuko ari we azomushikiriza ingingo zivuye k’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        },
        {
          "text": ", azoronka akoresheje ubupfindo bwa Urimu. Ategetse we n’Abisirayeli bose bazosohoka, ategetse bazokwinjira.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.21",
            "verseOrgIds": [
              "NUM.27.21"
            ]
          }
        }
      ]
    },
