        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.14",
            "verseOrgIds": [
              "NUM.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
