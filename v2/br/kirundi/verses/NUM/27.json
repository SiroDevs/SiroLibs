          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abarira ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.15",
            "verseOrgIds": [
              "NUM.27.15"
            ]
          }
        },
        {
          "text": " ati: ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.15",
            "verseOrgIds": [
              "NUM.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Icompa ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.16",
            "verseOrgIds": [
              "NUM.27.16"
            ]
          }
        },
        {
          "text": ", Imana y’impwemu z’abantu bose, agashiraho umuntu wo kurongora ubu bwoko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.16",
            "verseOrgIds": [
              "NUM.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kugira ngo abaje imbere amaja n’amaza, uwuzobarongora basohotse canke binjira, kugira ngo abantu b’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        },
        {
          "text": " ntibabe nk’intama zitagira umwungere.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.27.17",
            "verseOrgIds": [
              "NUM.27.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
