          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.9",
            "verseOrgIds": [
              "NUM.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igihe igicaniro carobanuzwa amavuta, ba bakuru bazanye ibimazi vyabo vyo kukirobanura barabizana babishira imbere y’igicaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.10",
            "verseOrgIds": [
              "NUM.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " yari yabwiye Mose ati: “Ku musi ku musi umukuru umwe wese aze atange ikimazi ciwe co guhereza Imana ico gicaniro.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.7.11",
            "verseOrgIds": [
              "NUM.7.11"
            ]
          }
        }
      ]
    },
    {
