            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Harura imfura z’Abisirayeli zose z’abahungu bamaze ukwezi n’abakurenza ushire ku rutonde amazina yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.40",
            "verseOrgIds": [
              "NUM.3.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 3:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uce wakira Abalewi ubanzanire mu gishingo c’imfura zose z’Abisirayeli, n’imfura z’ibitungwa vy’Abalewi mu gishingo c’imfura zose z’ibitungwa vy’Abisirayeli. Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.41",
            "verseOrgIds": [
              "NUM.3.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
