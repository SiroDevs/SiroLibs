      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose aha Abagadi, Abareyubeni n’igice c’Abamanase bakomoka kuri Yosefu ubwami bwari ubwa Sihoni umwami w’Abamori n’ubwami bwa Ogi umwami w’i Bashani; igihugu cose n’ibisagara vyaho n’intara zihakikije.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.33",
            "verseOrgIds": [
              "NUM.32.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 32:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagadi basubira kwubaka Diboni, Ataroti, Aroweri, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.34",
            "verseOrgIds": [
              "NUM.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aturoti-Shofani, Yazeri, Yogibeha, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.35",
            "verseOrgIds": [
              "NUM.32.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 32:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti-Nimura n’i Beti-Harani nk’ibisagara bizitijwe inzitiro, kandi bubaka impongore z’ibitungwa vyabo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.36",
            "verseOrgIds": [
              "NUM.32.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 32:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abareyubeni na bo basubira kwubaka i Heshiboni, i Eliyalehi, i Kiriyatayimu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.37",
            "verseOrgIds": [
              "NUM.32.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "i Nebo, i Bayali-Meyoni (aya mazina yarahinduwe) n’i Sibuma. Ibisagara basubiyemwo baciye babiha ayandi mazina.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 32:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.38",
            "verseOrgIds": [
              "NUM.32.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 32:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakomoka mu ruvyaro rwa Makiri mwene Manase baja i Gileyadi, barahafata basohora Abamori bari ngaho. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.39",
            "verseOrgIds": [
              "NUM.32.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 32:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose aha Gileyadi Abamakiri, bakomoka kuri Manase, baca barahaba. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.40",
            "verseOrgIds": [
              "NUM.32.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 32:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yayiro, wo mu ruvyaro rwa Manase, afata ibigwati vyaho aca avyita Havoti Yayiro risobanurwa ngo ibigwati vy’i Yayiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.41",
            "verseOrgIds": [
              "NUM.32.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 32:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Noba afata i Kenati n’ibigwati bihakikije aca ahita Nobati nk’uko izina ryiwe ryari.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.42",
            "verseOrgIds": [
              "NUM.32.42"
            ]
          }
        }
      ]
    }
