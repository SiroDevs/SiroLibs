          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abagadi n’Abareyubeni barishura bati: “Abasavyi bawe tuzokora nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "text": " yavuze. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.31",
            "verseOrgIds": [
              "NUM.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tuzojabuka muri Kanani imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        },
        {
          "text": " kandi twambaye ibigwanisho, ariko umugabane wacu uzoba hakuno ya Yorodani.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.32.32",
            "verseOrgIds": [
              "NUM.32.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
