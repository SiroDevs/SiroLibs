            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Fata ba bakuru bose b’ubu bwoko, ubice ubanikire ku zuba imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        },
        {
          "text": ", kugira ngo ishavu ryanje rive ku Bisirayeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.25.4",
            "verseOrgIds": [
              "NUM.25.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
