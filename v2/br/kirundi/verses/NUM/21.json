              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.31",
            "verseOrgIds": [
              "NUM.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose amaze kurungika abatasi mu gisagara c’i Yazeri, Abisirayeli baca bafata ibigwati bihakikuje basohora Abamori bari muri vyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.32",
            "verseOrgIds": [
              "NUM.21.32"
            ]
          }
