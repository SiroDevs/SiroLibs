          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Abisirayeli baririmba indirimbo ivuga ngo:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.17",
            "verseOrgIds": [
              "NUM.21.17"
            ]
          }
        }
      ]
