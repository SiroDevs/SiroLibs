          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli barungika intumwa kubwira Sihoni umwami w’Abamori bati:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.21",
            "verseOrgIds": [
              "NUM.21.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.22",
            "verseOrgIds": [
              "NUM.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Sihoni ntiyemerera Abisirayeli guca mu gihugu ciwe. Aca akoranya ingabo ziwe zose aja mu bugaragwa gutera Abisirayeli; ashitse i Yahazi, agwana na bo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.23",
            "verseOrgIds": [
              "NUM.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli baramugwanya baramunesha babamarisha inkota bafata n’igihugu ciwe kuva ku ruzi Arunoni gushika kuri Yaboki, gushika ku rubibe rwo mu buseruko bw’Abamoni, kuko urwo rubibe rwari ruzitijwe inzitiro. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.24",
            "verseOrgIds": [
              "NUM.21.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafata ibisagara vyose vy’Abamori, harimwo Heshiboni n’imihana yose ihakikuje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.25",
            "verseOrgIds": [
              "NUM.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heshiboni cari igisagara ca Sihoni umwami w’Abamori, uwo yari yaragwanye n’umwami yahora aganza i Mowabu aca afata ico gihugu ciwe gushika ku ruzi rwa Arunoni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.26",
            "verseOrgIds": [
              "NUM.21.26"
            ]
          }
        }
      ]
    },
