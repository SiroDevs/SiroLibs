          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma abavuga ivyese bavuze ngo:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.21.27",
            "verseOrgIds": [
              "NUM.21.27"
            ]
          }
        }
      ]
    },
    {
