        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.25",
            "verseOrgIds": [
              "NUM.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko hari abagabo babiri, amazina yabo yari Eludadi na Medadi, bari basigaye aho bacumbitse. Bari kuri rwa rutonde rw’abakuru mirongo indwi, ariko ntibasohoka ngo baje kw’ihema. Ariko na bo nyene Mpwemu abazako, kandi bavugishirizwa aho bacumbitse. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.26",
            "verseOrgIds": [
              "NUM.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusore umwe araza yiruka abarira Mose ati: “Eludadi na Medadi bariko baravugishirizwa aho ducumbitse.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.11.27",
            "verseOrgIds": [
              "NUM.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
