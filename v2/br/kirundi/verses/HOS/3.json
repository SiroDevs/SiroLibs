          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndamugura shekeli cumi na zitanu",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:2",
              "type": "text"
            },
            {
              "text": "Ni nk’amagarama 170.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ifeza n’ingero homeru na leteki",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "3:2",
              "type": "text"
            },
            {
              "text": "Ingero homeru na leteki ziri hamwe zapima nk’ibilo 195.",
              "type": "text"
            }
          ]
        },
        {
          "text": " vya sayiri. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.2",
            "verseOrgIds": [
              "HOS.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma nca ndamubwira nti: “Uzobana nanje imisi myinshi; ntuzosubire kuba maraya canke ngo wongere kuryamana n’uwundi mugabo n’umwe, nanje nzobana nawe gutyo nyene.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.3",
            "verseOrgIds": [
              "HOS.3.3"
            ]
          }
        }
      ]
    },
