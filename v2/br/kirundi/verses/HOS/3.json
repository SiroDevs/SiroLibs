          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ukuvuga ko Abisirayeli bazobaho imisi myinshi ata mwami canke umuganwa bafise, ata bimazi canke inkingi, ata efodi canke ibigirwamana. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.4",
            "verseOrgIds": [
              "HOS.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inyuma y’ivyo Abisirayeli bazogaruka biyegurire ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "text": " Imana yabo no kuri Dawidi umwami wabo. Kandi mu misi ya nyuma, bazoza k’",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        },
        {
          "text": " no ku migisha yiwe bahindishwa agashitsi no kugira neza kwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.3.5",
            "verseOrgIds": [
              "HOS.3.5"
            ]
          }
        }
      ]
