        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.27",
            "verseOrgIds": [
              "1KI.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Dawidi arishura ati: “Nimumpamagarire Batisheba!” Nuko Batisheba arinjira ahagarara imbere y’umwami.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        }
      ]
