        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.28",
            "verseOrgIds": [
              "1KI.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami aca asubiramwo ya ndahiro ati: “Ndakurahiye ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "text": ", uwandokoye mu magorwa yose, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.29",
            "verseOrgIds": [
              "1KI.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ko Salomo umuhungu wawe ari we azonsubirira, akicara ku ntebe y’ubwami uhereye uwu musi nyene, nk’uko nari narabikurahiye imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.1.30",
            "verseOrgIds": [
              "1KI.1.30"
            ]
          }
        }
      ]
