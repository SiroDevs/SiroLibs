              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.24",
            "verseOrgIds": [
              "1KI.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Yerobowamu yubaka igisagara c’i Shekemu co mu ntara y’imitumba ya Efurayimu, aba ari ho aba. Hanyuma avayo, yubaka igisagara c’i Peniyeli.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.25",
            "verseOrgIds": [
              "1KI.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobowamu yibwira mu mutima ati: “Nintaba maso, ubwami burasubira mu ruvyaro rwa Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.26",
            "verseOrgIds": [
              "1KI.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aba bantu nibakomeza kwama baja i Yerusalemu gushikanira ibimazi ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        },
        {
          "text": " mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        },
        {
          "text": ", bazohava basubira kugirana isezerano na Rehobowamu umwami w’i Buyuda, baheze banyice, hanyuma bisubirire ku mwami Rehobowamu.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.27",
            "verseOrgIds": [
              "1KI.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo mwami amaze guhanuza, aca acurisha amashuri abiri mu nzahabu. Aca abwira abantu ati: “Yemwe Bisirayeli, birabaruhishije kwama muduga i Yerusalemu. Ng’izi imana zanyu zabakuye muri Egiputa.” ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.28",
            "verseOrgIds": [
              "1KI.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imwe ayishinga i Beteli mu bumanuko, iyindi ayishinga mu buraruko, mu ntara ya Dani. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.29",
            "verseOrgIds": [
              "1KI.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ico kintu gihindukira abantu icaha gikomeye, ku buryo hariho n’abagenda gusenga ic’i Beteli, bagaca bongera bagafata urugendo rurerure baja gusenga ico kindi c’i Dani.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.30",
            "verseOrgIds": [
              "1KI.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yerobowamu yubaka ibibanza vyo gusengeramwo ku misozi, agena n’abaherezi mu miryango yose, naho bataba bava mu Balewi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.31",
            "verseOrgIds": [
              "1KI.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aca ashinga ko ku musi ugira cumi na gatanu w’ukwezi kw’umunani hazohora haba muri Isirayeli umusi mukuru, kugira ngo yigane umusi mukuru w’insago wahimbazwa i Buyuda. Ivyo yabigiriye i Beteli, ashikanira ibimazi iyo shuri yacurishije. I Beteli nyene ahagena n’abaherezi bo mu bibanza vyo gusengeramwo yubatse. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.32",
            "verseOrgIds": [
              "1KI.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku musi ugira cumi na gatanu w’ukwezi kw’umunani, ukwezi yihitiyemwo wenyene, ashikanira ibimazi ku gicaniro yubatse i Beteli. Nuko ashinga uwo musi mukuru kubw’Abisirayeli bose, hanyuma yurira ku gicaniro gutanga ibimazi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.12.33",
            "verseOrgIds": [
              "1KI.12.33"
            ]
          }
        }
      ]
    }
