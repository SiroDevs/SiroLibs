            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu umwami w’i Tiro yumvise ko Salomo yimitswe ngo asubirire se Dawidi, amurungikira intumwa zo kumukeza, kuko yamye akundana na Dawidi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.1",
            "verseOrgIds": [
              "1KI.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo na we arungikira ubutumwa Hiramu, buvuga buti:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.2",
            "verseOrgIds": [
              "1KI.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.6",
            "verseOrgIds": [
              "1KI.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu aronse ubutumwa bwa Salomo, aranezerwa cane avuga ati: “",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "text": " nashimwe kuko uwu musi yahaye Dawidi umuhungu w’ubwenge ngo abe umwami w’ihanga rikomeye rya Isirayeli.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.7",
            "verseOrgIds": [
              "1KI.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiramu yishura Salomo ati:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.8",
            "verseOrgIds": [
              "1KI.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.9",
            "verseOrgIds": [
              "1KI.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Hiramu aha Salomo ibiti vy’amasederi n’ubujwari yari akeneye vyose. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.10",
            "verseOrgIds": [
              "1KI.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo na we aca arungikira Hiramu ingero koru ibihumbi mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:11",
              "type": "text"
            },
            {
              "text": "Ni nk’amatoni 3.600.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ingano zo gutunga abo mu rugo rwiwe, n’ingero batu ibihumbi mirongo ibiri",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "5:11",
              "type": "text"
            },
            {
              "text": "Ni nk’amalitiro 440.000.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’amavuta meza cane ya Elayo. Uko ni ko Salomo yama abikorera Hiramu ku mwaka ku mwaka. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.11",
            "verseOrgIds": [
              "1KI.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " aha ubwenge Salomo, nk’uko yari yarabimusezeraniye. Hiramu na Salomo bagiriranira imigenderanire myiza, bagiranira n’amasezerano y’amahoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.12",
            "verseOrgIds": [
              "1KI.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Salomo aca arondera abakozi ibihumbi mirongo itatu mu basanzwe baca ingero mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.13",
            "verseOrgIds": [
              "1KI.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko arabarungika i Libani, bagenda barakuranwa ari ibihumbi cumicumi ku kwezi kugira ngo umuntu amare ukwezi kumwe i Libani, ayandi abiri na yo ayamare i muhira. Adoniramu ni we yari ajejwe abo bakozi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.14",
            "verseOrgIds": [
              "1KI.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo yari afise abakozi ibihumbi mirongo indwi b’abikorezi, hamwe n’abandi ibihumbi mirongo umunani babaza amabuye ku misozi, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.15",
            "verseOrgIds": [
              "1KI.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "hamwe n’abandi ibihumbi bitatu n’amajana atatu bakoresha abandi, bagacungera ingene ibikorwa biriko biragenda. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.16",
            "verseOrgIds": [
              "1KI.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Umwami ategeka ko bimba amabuye maninimanini ameze neza, ngo bayabaze kugira ngo abe umushinge bazodugirizako mu kwubaka iyo Ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.17",
            "verseOrgIds": [
              "1KI.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abahinga b’abubatsi ba Salomo n’aba Hiramu bategura imbaho n’amabuye yo kwubaka Ingoro, bafadikanije n’abo mu gisagara ca Gebali.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.5.18",
            "verseOrgIds": [
              "1KI.5.18"
            ]
          }
        }
      ]
    }
  ],
