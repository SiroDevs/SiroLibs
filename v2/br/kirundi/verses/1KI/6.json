            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urugo rw’iyo nyubakwa rwari rwubatswe n’imirongo itatu y’amabuye maninimanini, hamwe n’umurongo umwe w’ibiti vy’amasederi bibajwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
