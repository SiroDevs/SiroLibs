              "1KI.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikoraniro ryose ry’Abisirayeli rigihagaze ngaho, umwami arahindukira arabahezagira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.14",
            "verseOrgIds": [
              "1KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze avuga ati:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.15",
            "verseOrgIds": [
              "1KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
