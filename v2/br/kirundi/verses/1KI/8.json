        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.21",
            "verseOrgIds": [
              "1KI.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo ahagarara imbere y’igicaniro c’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.22",
            "verseOrgIds": [
              "1KI.8.22"
            ]
          }
        },
        {
          "text": " n’imbere y’ikoraniro ryose ry’Abisirayeli agorora amaboko ayerekeje mw’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.22",
            "verseOrgIds": [
              "1KI.8.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko aravuga ati:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.23",
            "verseOrgIds": [
              "1KI.8.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
