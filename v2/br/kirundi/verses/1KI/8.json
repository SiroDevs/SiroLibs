          },
          "items": [
            {
              "text": "62",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umwami n’Abisirayeli bose bashikanira ibimazi ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.62",
            "verseOrgIds": [
              "1KI.8.62"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.62",
            "verseOrgIds": [
              "1KI.8.62"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "63",
            "style": "v",
            "sid": "1KI 8:63"
          },
          "items": [
            {
              "text": "63",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo ashikanira ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.63",
            "verseOrgIds": [
              "1KI.8.63"
            ]
          }
        },
        {
          "text": " amashikanwa y’ishimwe agizwe n’impfizi ibihumbi mirongo ibiri na bibiri n’intama ibihumbi ijana na mirongo ibiri. Nuko umwami n’Abisirayeli bose bashikiriza ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.63",
            "verseOrgIds": [
              "1KI.8.63"
            ]
          }
        },
        {
          "text": " iyo Ngoro.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.63",
            "verseOrgIds": [
              "1KI.8.63"
            ]
          }
        }
      ]
    },
