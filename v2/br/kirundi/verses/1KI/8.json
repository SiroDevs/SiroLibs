    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko umwami Salomo aca atumako abakuru b’Abisirayeli, abatware b’imiryango bose n’abaserukira amazu y’Abisirayeli, bakoranira i Yerusalemu kugira ngo bazane Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.1",
            "verseOrgIds": [
              "1KI.8.1"
            ]
          }
        },
        {
          "text": ", bayikure aho yari iri i Siyoni mu Gisagara ca Dawidi, bayijane mu kibanza gishasha kiri muri iyo Ngoro. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.1",
            "verseOrgIds": [
              "1KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli bose bakoranira imbere y’umwami Salomo ku musi mukuru w’insago, hari mu kwezi kw’indwi ari kwo Etanimu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.2",
            "verseOrgIds": [
              "1KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.2",
            "verseOrgIds": [
              "1KI.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abakuru bose b’Abisirayeli bamaze gushika, abaherezi baterura ya sandugu barayidugana, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.3",
            "verseOrgIds": [
              "1KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "badugana Isandugu y’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.4",
            "verseOrgIds": [
              "1KI.8.4"
            ]
          }
        },
        {
          "text": " n’Ihema ry’Ibonaniro, badugana n’ibikoresho vyose vyakoreshwa muri ryo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.4",
            "verseOrgIds": [
              "1KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umwami Salomo n’ikoraniro ryose ry’Abisirayeli bari bakoraniye hamwe na we bari imbere y’iyo sandugu, batanga ibimazi vyinshi vy’intama n’inka bitashoboye kwandikwa canke ngo biharurwe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.5",
            "verseOrgIds": [
              "1KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.5",
            "verseOrgIds": [
              "1KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo baherezi baca bajana iyo Sandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.6",
            "verseOrgIds": [
              "1KI.8.6"
            ]
          }
        },
        {
          "text": " aho yateguriwe mu gice c’imbere mu Ngoro, ari ho hitwa Ahera Cane, baca bayishira musi y’amababa ya ba bakerubi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.6",
            "verseOrgIds": [
              "1KI.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo bakerubi bari bashanje amababa hejuru y’aho iyo sandugu yari iri, agapfuka isandugu hamwe n’imyamba bayireruza. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.7",
            "verseOrgIds": [
              "1KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyo myamba yari miremire ku buryo umuntu ari Ahera yashobora kubona aho igarukira. Ariko umuntu atarashika Ahera, ntivyashoboka ko ayibona; kandi iracariho gushika n’uwu musi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.8",
            "verseOrgIds": [
              "1KI.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta kindi kintu cari muri iyo sandugu kiretse vya bisate vy’amabuye Mose yashiramwo ari i Horebu, aho ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.9",
            "verseOrgIds": [
              "1KI.8.9"
            ]
          }
        },
        {
          "text": " yagiraniye isezerano n’Abisirayeli bamaze kuva muri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.9",
            "verseOrgIds": [
              "1KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.9",
            "verseOrgIds": [
              "1KI.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi bamaze gusohoka bakava muri ico cumba c’Ahera, igicu cakaka kiraza cuzura mu Ngoro y’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.10",
            "verseOrgIds": [
              "1KI.8.10"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.10",
            "verseOrgIds": [
              "1KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abaherezi ntibaba bagishobora gukora igikorwa cabo kubera ico gicu, kuko ubwiza bw’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.11",
            "verseOrgIds": [
              "1KI.8.11"
            ]
          }
        },
        {
          "text": " bwari bwuzuye Ingoro y’Uhoraho.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.11",
            "verseOrgIds": [
              "1KI.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.11",
            "verseOrgIds": [
              "1KI.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Salomo avuga ati: “Ewe ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.12",
            "verseOrgIds": [
              "1KI.8.12"
            ]
          }
        },
        {
          "text": ", wavuze ko uba mu gicu c’umwijima w’umuzitanya. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.12",
            "verseOrgIds": [
              "1KI.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko jewe nakwubakiye vy’ukuri Ingoro y’igitangaza, ikibanza uzokwiberamwo ibihe vyose.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.13",
            "verseOrgIds": [
              "1KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
