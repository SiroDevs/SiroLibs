            "verseId": "1KI.8.53",
            "verseOrgIds": [
              "1KI.8.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "1KI 8:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salomo ahejeje gusenga no kwinginga ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.54",
            "verseOrgIds": [
              "1KI.8.54"
            ]
          }
        },
        {
          "text": " gutyo, aca arahaguruka ava imbere y’igicaniro aho yari apfukamye, ashanje amaboko ayarabishije kw’ijuru. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.54",
            "verseOrgIds": [
              "1KI.8.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "1KI 8:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahezagira ikoraniro ryose rya Isirayeli, avuga n’ijwi rirenga ati:",
          "type": "text",
          "attrs": {
            "verseId": "1KI.8.55",
            "verseOrgIds": [
              "1KI.8.55"
            ]
          }
        }
      ]
    },
