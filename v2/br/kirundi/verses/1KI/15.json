          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akora ivyo ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.34",
            "verseOrgIds": [
              "1KI.15.34"
            ]
          }
        },
        {
