          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibindi vyabaye ku ngoma ya Nadabu hamwe n’ivyo yakoze, vyanditse mu gitabu c’ivyabaye ku bami ba Isirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.31",
            "verseOrgIds": [
              "1KI.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hama hari intambara hagati ya Asa na Bayasha umwami wa Isirayeli igihe cose bamaze bari ku ngoma.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.32",
