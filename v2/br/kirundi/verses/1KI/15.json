          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agishika ku ngoma, yica umuryango wose wa Yerobowamu. Mu muryango wa Yerobowamu, nta n’umwe yasigaye, yarabatikije bose, nk’uko ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "text": " ryari ryabivuze aciye ku musavyi wiwe Ahiya w’i Shilo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.29",
            "verseOrgIds": [
              "1KI.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo vyabaye kuko Yerobowamu yari yakoze ivyaha vyinshi, atuma n’Abisirayeli babikora, ari co catumye uburake bw’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli bumuziriringira.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.15.30",
            "verseOrgIds": [
              "1KI.15.30"
            ]
          }
        }
      ]
    },
