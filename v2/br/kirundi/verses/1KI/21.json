            "verseId": "1KI.21.23",
            "verseOrgIds": [
              "1KI.21.23"
            ]
          }
        },
        {
          "text": " yambwiye ko imbwa zizorira umuvyimba wiwe ku ruzitiro rw’i Yezireyeli.",
