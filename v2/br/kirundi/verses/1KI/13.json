            "style": "v",
            "sid": "1KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.14",
            "verseOrgIds": [
              "1KI.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muvugishwa aramubwira ati: “Ingo dutahane i muhira ndakuzimane.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.15",
            "verseOrgIds": [
              "1KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muntu w’Imana aramwishura ati: “Sinshobora gusubira inyuma ngo njane nawe, kandi sinshobora kugira ico ndya canke nywa aha hantu, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.16",
            "verseOrgIds": [
              "1KI.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        },
        {
          "text": " ryambariye riti: ‘Ntihazogire ico urya canke unywa, kandi ntuzoce mu nzira wajanye mu gusubira inyuma.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.17",
            "verseOrgIds": [
              "1KI.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muvugishwa wa kera aramubarira ati: “Nanje ndi umuvugishwa n’Imana nkawe. Kandi umumarayika yampaye ijambo rivuye k’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "text": " rivuga riti: ‘Genda umugarukane i muhira iwawe, afungure yongere anywe amazi.’ ” Ariko yariko aramubesha. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.18",
            "verseOrgIds": [
              "1KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muntu w’Imana aca asubirana inyuma na we, arira mu nzu y’uwo muvugishwa, yongera anywaho n’amazi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.19",
            "verseOrgIds": [
              "1KI.13.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bacicaye ku meza, ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.20",
            "verseOrgIds": [
              "1KI.13.20"
            ]
          }
        },
        {
          "text": " riza kuri wa muvugishwa wa kera yagarukanye wa muntu w’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.20",
            "verseOrgIds": [
              "1KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arasemerera abarira wa muntu w’Imana yavuye i Buyuda ati: “",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "text": " avuze ati: ‘Wahinduye ubusa ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "text": ", ntiwakurikije itegeko ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "text": " Imana yawe yaguhaye. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.21",
            "verseOrgIds": [
              "1KI.13.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wasubiye inyuma, urira kandi unywera mu kibanza ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        },
        {
          "text": " yakubujije kuriramwo no kunyweramwo. None rero umuvyimba wawe ntuzohambwa mu mva ya ba sogokuruza bawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.22",
            "verseOrgIds": [
              "1KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muntu w’Imana ahejeje kurya no kunywa, wa muvugishwa aca amutegurira indogoba, ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.23",
            "verseOrgIds": [
              "1KI.13.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "wa muntu w’Imana aca asubira gufata urugendo. Ariko akiri mu nzira, ahura n’intare, iramwica. Umuvyimba wiwe uca uguma urambitse ku nzira, ya ndogoba na ya ntare biguma bihagaze i ruhande yawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.24",
            "verseOrgIds": [
              "1KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu barengana babonye uwo muvyimba uryamye hasi, bakabona na ya ntare ihagaze i ruhande yawo, baca baja kubivuga muri ca gisagara wa muvugishwa wa kera yabamwo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.25",
            "verseOrgIds": [
              "1KI.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muvugishwa yari yamugarukanye avyumvise, aravuga ati: “Uwo ni wa muntu w’Imana yahindura ubusa ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "text": " yamurekuriyeko intambwe iramwica nk’uko ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "text": " ryari ryamuburiye.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.26",
            "verseOrgIds": [
              "1KI.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo muvugishwa aca abwira abahungu biwe ati: “Ntegurire indogoba.” Na bo barayimutegurira. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.27",
            "verseOrgIds": [
              "1KI.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko aragenda asanga wa muvyimba urambaraye hasi, na ya ndogoba n’intare bihagaze i ruhande yawo. Iyo ntare ntiyari yariye uwo muvyimba, nta n’ico yagize iyo ndogoba. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.28",
            "verseOrgIds": [
              "1KI.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa muvugishwa aca afata wa muvyimba wa wa muntu w’Imana, awushira ku ndogoba, awuzana mu gisagara c’i Beteli, kugira ngo amugandarire, hanyuma amuhambe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.29",
            "verseOrgIds": [
              "1KI.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko aryamika ico kiziga mu mva yiwe, amuborogera cane avuga ati: “Yo, muvukanyi!”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.30",
            "verseOrgIds": [
              "1KI.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahejeje kumuhamba, abarira abahungu biwe ati: “Ninapfa, muzompambe mu mva urya muntu w’Imana yahambwemwo, amagufa yanje muzoyaryamike i ruhande y’ayiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.31",
            "verseOrgIds": [
              "1KI.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko ijambo ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        },
        {
          "text": " yamubwiye ngo avugire ku gicaniro i Beteli no mu bibanza vyo gusengeramwo ku misozi mu bisagara vy’i Samariya nta nkeka rizoshika.”",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.32",
            "verseOrgIds": [
              "1KI.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko n’inyuma y’ivyo, Yerobowamu ntiyahevye inzira ziwe mbi, ahubwo yasubijeho abaherezi ku mitumba, bava mu bantu abo ari bo bose. Hagize uwumva ashaka kuba umuherezi wese yaca amurobanura, akaba umuherezi muri ivyo bibanza vyo gusengeramwo ku misozi. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.33",
            "verseOrgIds": [
              "1KI.13.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 13:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico cabereye umuryango wa Yerobowamu icaha kinini, catumye ingoma yiwe isenyuka, irazimangana kw’isi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.13.34",
            "verseOrgIds": [
              "1KI.13.34"
            ]
          }
        }
      ]
    }
