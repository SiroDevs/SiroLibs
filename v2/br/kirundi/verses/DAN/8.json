          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibinyoma vyiwe bizotuma ashishikara kuja imbere, bitume yishira hejuru; kandi azokwica abantu benshi giturumbuka yongere agwanye Umwami w’abami, mu nyuma azovunagurwa, ariko bitavuye ku nkomezi z’umuntu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.25",
            "verseOrgIds": [
              "DAN.8.25"
            ]
