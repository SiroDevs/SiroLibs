              "type": "text"
            }
          ]
        },
        {
          "text": "Azokomera cane, ariko bitavuye ku bushobozi bwiwe. Azokwica ibintu vyinshi kandi ivyo agomba gukora vyose azobishikako. Azotikiza abarongozi bakomeye kandi yice abera b’Imana. ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.8.24",
            "verseOrgIds": [
              "DAN.8.24"
            ]
          }
        },
        {
          "name": "verse",
