              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu nyuma Lewi ategurira amazimano Yesu i muhira iwe, atumira n’abatozakori benshi n’abandi bantu, baraza basangira na bo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.5.29",
            "verseOrgIds": [
