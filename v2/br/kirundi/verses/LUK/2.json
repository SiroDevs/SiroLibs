            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.48",
            "verseOrgIds": [
              "LUK.2.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LUK 2:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu aramubaza ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.49",
            "verseOrgIds": [
              "LUK.2.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ntibatahura ico ababwiye.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LUK 2:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.50",
            "verseOrgIds": [
              "LUK.2.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LUK 2:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze baca basubirana na we i Nazareti, kandi yama abumvira. Nuko nyina abika ivyo vyose mu mutima wiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.51",
            "verseOrgIds": [
              "LUK.2.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LUK 2:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu abandanya akura mu gihagararo, agwiza ubwenge, kandi agira ikiganza ciza ku Mana no ku bantu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.2.52",
            "verseOrgIds": [
              "LUK.2.52"
            ]
          }
        }
      ]
    }
