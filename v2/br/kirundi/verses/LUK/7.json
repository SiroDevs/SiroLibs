            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ba bigishwa bamaze kugenda, Yesu aca atangura kuvuga ivyerekeye Yohana Umubatizi, ati: ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.24",
            "verseOrgIds": [
              "LUK.7.24"
            ]
          }
        },
        {
