          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma umugore umwe wo muri ico gisagara yari azwi nk’umunyavyaha yumva ko Yesu ariko afungurira mu nzu y’uwo Mufarisayo. Aca aza azanye icupa ririmwo amavuta amota cane y’igiciro kinini, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.7.37",
            "verseOrgIds": [
