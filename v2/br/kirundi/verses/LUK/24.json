          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubwo nyene baca barahaguruka basubira i Yerusalemu. Bashitseyo, basanga bamwe cumi n’umwe n’abari kumwe na bo bakoraniye hamwe, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.33",
            "verseOrgIds": [
              "LUK.24.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 24:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "bariko bavuga bati: “Ni ukuri Umwami yazutse, kandi yiyeretse Simoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.34",
            "verseOrgIds": [
              "LUK.24.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 24:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abo bigishwa babiri na bo babiganira ivyabaye mu nzira bariko baragenda, n’ukuntu bamumenye amaze kumanyagura umukate.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.35",
            "verseOrgIds": [
              "LUK.24.35"
            ]
          }
        }
      ]
    },
