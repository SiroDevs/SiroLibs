        },
        {
          "text": "Dawidi amaze gushika neza mu ngoro iwe, abwira Natani uwavugishwa n’Imana ati: “Ehe raba, jewe mba mu nzu yubatswe n’ibiti vy’amasederi, nayo Isandugu y’Isezerano y’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        },
        {
          "text": " iba mw’ihema.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.1",
            "verseOrgIds": [
              "1CH.17.1"
            ]
          }
        }
