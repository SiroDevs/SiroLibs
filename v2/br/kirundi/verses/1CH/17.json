          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natani yishura Dawidi ati: “Ivyo wiyumvira gukora vyose, genda ubikore kuko Imana iri kumwe nawe.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.2",
            "verseOrgIds": [
              "1CH.17.2"
            ]
