            "number": "30",
            "style": "v",
            "sid": "1CH 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na ho nyene barakoresheje ubupfindo, nk’uko benewabo bakomoka kuri Aroni babikoze, imbere y’umwami Dawidi na Sadoki, Ahimeleki, n’abakuru b’amazu y’abaherezi n’Abalewi. Inzu zikomoka ku muvukanyi mukuru zafatwa co kimwe n’inzu zikomoka kuri mutoya muri bo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.31",
            "verseOrgIds": [
              "1CH.24.31"
            ]
          }
        }
      ]
    }
