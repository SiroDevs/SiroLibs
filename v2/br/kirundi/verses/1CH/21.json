          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.14",
            "verseOrgIds": [
              "1CH.21.14"
            ]
          }
        },
        {
          "text": " arungika ikiza mu Bisirayeli, abantu ibihumbi mirongo indwi vy’Abisirayeli barapfa. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.14",
            "verseOrgIds": [
              "1CH.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Imana ituma umumarayika ngo arandure Yerusalemu. Ariko igihe uwo mumarayika yariko arabikora, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        },
        {
          "text": " arabiraba ababazwa n’ico cago aca abwira uwo mumarayika yariko aratikiza abantu ati: “Geza aho! Garukana ukuboko kwawe.” Umumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        },
        {
          "text": " yari ahagaze ku mbuga yo kugosorerako ingano ya Orunani Umuyebusi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.15",
            "verseOrgIds": [
              "1CH.21.15"
            ]
          }
        }
      ]
    },
