          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri ico gihe, Dawidi abonye ko ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
              "1CH.21.28"
            ]
          }
        },
        {
          "text": " yishuye isengesho ryiwe kuri ya mbuga yo kugosorerako ingano ya Orunani Umuyebusi, aca atangiraho ibimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.28",
            "verseOrgIds": [
