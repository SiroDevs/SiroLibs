          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu gihe Orunani yariko aragosora ingano, ahindukiye abona wa mumarayika; maze abahungu biwe bane bari kumwe na we biruka kwinyegeza. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.20",
            "verseOrgIds": [
