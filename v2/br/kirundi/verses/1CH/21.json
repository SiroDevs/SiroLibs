          ]
        },
        {
          "text": "Ihema ry’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
              "1CH.21.29"
            ]
          }
        },
        {
          "text": ", iryo Mose yari yarubatse mu bugaragwa, n’igicaniro co guturirirako ibimazi vyari mw’itaba ry’umusozi i Gibeyoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.29",
            "verseOrgIds": [
