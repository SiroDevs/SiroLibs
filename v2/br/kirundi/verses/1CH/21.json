          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Dawidi arashika, Orunani yunamuye amaso aramubona, aca ava kuri ya mbuga yo kugosorerako yunama imbere ya Dawidi, ashika hasi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.21",
            "verseOrgIds": [
              "1CH.21.21"
            ]
          }
        }
