          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dawidi aramubwira ati: “Numpe iki kibanza c’imbuga yawe kugira ngo ndahubakire ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        },
        {
          "text": " igicaniro, maze ikiza kiri mu bantu gihagarare. Ndahakugurira ku giciro bikwiranye.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.22",
            "verseOrgIds": [
              "1CH.21.22"
            ]
          }
        }
      ]
