            "sid": "1CH 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze umumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "text": " ategeka Gadi kubwira Dawidi ngo aduge yubakire ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.18",
            "verseOrgIds": [
              "1CH.21.18"
            ]
          }
        },
        {
          "text": " igicaniro ku mbuga yo kugosorerako ingano ya Orunani Umuyebusi. ",
          "type": "text",
          "attrs": {
