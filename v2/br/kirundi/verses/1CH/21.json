            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.10",
            "verseOrgIds": [
              "1CH.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Gadi aja kwa Dawidi aramubwira ati: “Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.11",
            "verseOrgIds": [
              "1CH.21.11"
            ]
          }
        },
        {
          "text": " avuze: ‘Hitamwo kimwe: ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.11",
            "verseOrgIds": [
              "1CH.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "imyaka itatu y’inzara, amezi atatu uneshwa n’abansi aho inkota y’abansi banyu izobashikako, canke imisi itatu y’inkota y’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        },
        {
          "text": "; imisi y’ikiza mu gihugu, aho umumarayika w’",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        },
        {
          "text": " azokwica abantu mu bice vyose vya Isirayeli.’ None rero, hitamwo hanyuma umbwire ico nishura uwantumye.”",
          "type": "text",
          "attrs": {
            "verseId": "1CH.21.12",
            "verseOrgIds": [
              "1CH.21.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
