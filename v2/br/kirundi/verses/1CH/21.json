            "verseId": "1CH.21.26",
            "verseOrgIds": [
              "1CH.21.26"
            ]
          }
        },
        {
          "text": " na we aramwishura, amanura umuriro uvuye mw’ijuru uza kuri ca gicaniro c’ibimazi vyo guturirwa.",
          "type": "text",
          "attrs": {
