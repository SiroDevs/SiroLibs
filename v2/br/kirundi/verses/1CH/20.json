            "style": "v",
            "sid": "1CH 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.3",
            "verseOrgIds": [
              "1CH.20.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma y’ivyo, havyuka intambara hagati y’Abisirayeli n’Abafilisitiya, ibera ahitwa Gezeri. Muri ico gihe Sibekayi Umuhushati yica Sipayi, umwe mu bakomoka ku Barefayimu, kandi Abafilisitiya baraneshwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.20.4",
            "verseOrgIds": [
              "1CH.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
