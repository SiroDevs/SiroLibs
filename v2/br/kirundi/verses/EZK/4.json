          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.13",
            "verseOrgIds": [
              "EZK.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nanje ndavuga nti: “Ntibikabe, ewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
          "text": " Nyeninganji! Sinigeze nihumanya. Kuva nkiri muto gushika ubu, sinigenze ndya igikoko cipfiriye gutyo, canke icishwe n’inyamaswa. Nta kintu gihumanye cigeze cinjira mu kanwa kanje.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.14",
            "verseOrgIds": [
              "EZK.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        },
        {
          "text": " aravuga ati: “Reka nkureke utekeshe indya zawe igishwemu c’amase mu gishingo c’umwanda mukuru w’abantu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        }
      ]
    },
