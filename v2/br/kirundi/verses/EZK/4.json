            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.15",
            "verseOrgIds": [
              "EZK.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yongera kumbwira ati: “Mwana w’umuntu, ngiye gutuma i Yerusalemu hakena indya. Abantu bazorya ivyokurya bapimiwe bahagaritse umutima. Bazonywa n’amazi bagerewe bihebuye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.16",
            "verseOrgIds": [
              "EZK.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyokurya n’amazi bizokena, kandi bose bazodendebukirwa, bacike intege kubera ivyaha vyabo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.4.17",
            "verseOrgIds": [
              "EZK.4.17"
            ]
          }
        }
      ]
    }
