            "verseId": "EZK.12.14",
            "verseOrgIds": [
              "EZK.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazomenya ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "text": ", ninabashwiragiza mu mahanga no mu bihugu bitandukanye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.15",
            "verseOrgIds": [
              "EZK.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nzokwisigariza bamwe, ndabarinde inkota, inzara n’akaranda, kugira ngo mu mahanga yose bazojamwo bazokwame bicuza ibizira bakoze. Ni ho bazomenya ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.16",
            "verseOrgIds": [
              "EZK.12.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
