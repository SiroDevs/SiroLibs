              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
          "text": " rimbwira riti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.1",
            "verseOrgIds": [
              "EZK.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w’umuntu, uba mu bantu b’abagarariji. Bafise amaso ariko ntibabona, bafise amatwi ariko ntibumva, kuko ari abantu b’abagarariji.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.2",
            "verseOrgIds": [
              "EZK.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.2",
            "verseOrgIds": [
              "EZK.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, mwana w’umuntu, tekera ibintu vyawe kugira uhunge, kandi ugende ku murango, bakubona, uve aho uba wimukire ahandi. Kumbure bazotahura n’aho ari abagarariji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.3",
            "verseOrgIds": [
              "EZK.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhengere ku murango usohore utwawe, ubikore bakubona, usohore ibintu vyawe, utekere kurya kw’uwuhunga. Maze ku mugoroba, usohoke bakuraba, ugende kurya kw’abahunga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.4",
            "verseOrgIds": [
              "EZK.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utobore igihome bakuraba, kibe ari co ucishamwo utwawe. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.5",
            "verseOrgIds": [
              "EZK.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ubishire ku rutugu bakuraba, ubijane hatabona. Witwikire mu maso kugira ngo ntugende uraraba igihugu uvuyemwo, kuko nakugize nk’ikimenyetso ku Bisirayeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.6",
            "verseOrgIds": [
              "EZK.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.6",
            "verseOrgIds": [
              "EZK.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko ndabigenza uko nabwiwe. Mpengera ari ku murango nsohora ibintu vyanje, ndatekera ngo mpunge. Maze ku mugoroba ntobora uruhome n’amaboko, nsohora ibintu vyanje hatabona, ndabishira ku rutugu, ndagenda bandaba.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.7",
            "verseOrgIds": [
              "EZK.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
