              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "text": " rimbwira riti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.21",
            "verseOrgIds": [
              "EZK.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w’umuntu, mbega uwu mugani mufise mu gihugu ca Isirayeli uvuga ngo: ‘Imisi irashira, ivyavugishijwe ntibishike,’ usigura iki? ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.22",
            "verseOrgIds": [
              "EZK.12.22"
            ]
          }
        },
        {
