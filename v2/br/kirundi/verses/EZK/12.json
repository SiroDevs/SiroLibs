          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta ndoto z’ibinyoma canke ubupfumu bwo kuryohereza abantu bizosubira kuvugwa mu Bisirayeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
