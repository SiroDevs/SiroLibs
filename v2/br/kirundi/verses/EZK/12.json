              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        },
        {
          "text": " nzovuga, kandi ivyo nzovuga bizoshika bidatevye. Kuko mu gihe cawe, wewe wa nzu y’ubugarariji, nzoshitsa ivyo navuze vyose, ni ko jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        },
        {
          "text": " Nyeninganji mvuze.’ ”",
