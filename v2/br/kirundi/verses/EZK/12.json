          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ijambo ry’",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "text": " rimbwira riti: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.17",
            "verseOrgIds": [
              "EZK.12.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwana w’umuntu, ivyokurya vyawe ubirye uhinda agashitsi, n’amazi yawe uyanywe ufise ubwoba. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.18",
            "verseOrgIds": [
              "EZK.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo muri iki gihugu ubabwire uti: ‘Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze ku baba i Yerusalemu no mu gihugu ca Isirayeli: bazorya ivyokurya vyabo bahagaritse imitima, amazi yabo bayanywe bihebuye, kuko igihugu kigiye gusangangurwa, kinyagwe ivyo cari gifise vyose, kubera umuryano w’abahaba bose. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.19",
            "verseOrgIds": [
              "EZK.12.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibisagara abantu babamwo bizosigara ari imisaka, igihugu na co gisigare ari agahinga. Aho ni ho muzomenyera ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        },
        {
          "text": ".’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.20",
            "verseOrgIds": [
              "EZK.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
