            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "45:24",
              "type": "text"
            },
            {
              "text": "Ni nk’amalitiro 3,8.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’amavuta ya elayo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.24",
            "verseOrgIds": [
              "EZK.45.24"
            ]
          }
        }
