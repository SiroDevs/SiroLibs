              "EZK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "text": " antumako ijambo ati: ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.18",
            "verseOrgIds": [
              "EZK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwana w’umuntu, shiraho inzira zibiri, izo inkota y’umwami w’i Babiloni izocamwo. Ushire ikimenyetso ku nzira izanana mu gisagara c’i Babiloni, aho yigaburiramwo kabiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.19",
            "verseOrgIds": [
              "EZK.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ushire ikimenyetso ku nzira inkota izocamwo, kimwe ku nzira ija i Raba h’Abamoni, ikindi ku yija i Buyuda mu gisagara kizitiye ari co Yerusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.20",
            "verseOrgIds": [
              "EZK.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuko umwami w’i Babiloni azohagarara ku mayirabiri, aho izo nzira zompi zishamikira, kugira ngo araguze. Azozungagiza imyampi, abaze ibigirwamana, asuzume ibitigu vy’ibikoko vyatanzweko ibimazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.21",
            "verseOrgIds": [
              "EZK.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ikigirwamana kiri i buryo kimwereke Yerusalemu, amarembo yaho azoyasenyaguze ibiti bininibinini, atange itegeko ryo gutikiza, bakome akaruru k’intambara, bubake ibigigira vyo gutera amarembo, arunde ibirundo vy’ivu vyo kwuririrako, ahakikuze kugira ngo ahatere. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.22",
            "verseOrgIds": [
              "EZK.21.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ab’i Yerusalemu bazobifata nk’aho ari indagu y’ikinyoma, kuko bafise isezerano bagiranye na Babiloni. Ariko umwami w’i Babiloni we azobibutsa ivyaha vyabo, aheze abatere, abatware nk’inyagano.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.23",
            "verseOrgIds": [
              "EZK.21.23"
            ]
          }
        }
      ]
    },
