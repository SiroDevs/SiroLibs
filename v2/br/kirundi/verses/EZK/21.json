            "style": "v",
            "sid": "EZK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.5",
            "verseOrgIds": [
              "EZK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "None rero, mwana w’umuntu, boroga! Borogera imbere yabo, wuzuye intimba n’agahinda. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.6",
            "verseOrgIds": [
              "EZK.21.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nibakubaza bati: ‘Ni kubera iki uboroga?’ Ubishure uti: ‘Ni kubera inkuru numvise z’ibigiye gushika. Umutima wose uzoshongeshwa n’ubwoba, n’amaboko yose adendebukirwe; imitima izocika ivutu, amavi yose azoregarega, acike amazi. Bigiye kuza! Nta kabuza bizoshika, ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.21.7",
            "verseOrgIds": [
              "EZK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
