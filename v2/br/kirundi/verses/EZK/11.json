          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
          }
        },
        {
          "text": " Imana ya Isirayeli bwari hejuru yabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.11.22",
            "verseOrgIds": [
              "EZK.11.22"
            ]
