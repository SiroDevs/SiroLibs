          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi nararondeye muri bo umuntu n’umwe yosanasana uruzitiro rw’ubugororotsi, agahagarara imbere yanje ngo azibire igihengeri, agasengera igihugu ngo sindagitikize, ariko nta n’umwe naronse. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.30",
            "verseOrgIds": [
              "EZK.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni co gituma nzogisukako ishavu, ndagitongoze umuriro w’uburake bwanje, ndabashitseko igihano c’ivyaha vyabo, ni jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.31",
            "verseOrgIds": [
              "EZK.22.31"
            ]
          }
        },
        {
          "text": " Nyeninganji ndabivuze.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.31",
            "verseOrgIds": [
              "EZK.22.31"
            ]
          }
        }
