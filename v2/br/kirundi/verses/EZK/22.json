          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abatware baho bameze nk’amabingira atabagura ico yafashe; barasheshe amaraso, bica abantu kugira ngo bashike ku nyungu mbi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.27",
            "verseOrgIds": [
              "EZK.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abavugishwa baho ivyo bikorwa bibi babisiga irangi ryera mu kuvugishwa ibinyoma n’indagu z’ububeshi. Bavuga bati: ‘Uku ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.28",
            "verseOrgIds": [
              "EZK.22.28"
            ]
          }
        },
        {
          "text": " Nyeninganji avuze,’ kandi Uhoraho ata na kimwe yababwiye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.28",
            "verseOrgIds": [
              "EZK.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abo muri ico gihugu bahahaza abandi, bakabambura utwabo; bahahaza aboro n’abakene, bakarenganya ba kavantara, bakanka kubacira imanza ziroranye.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.22.29",
            "verseOrgIds": [
              "EZK.22.29"
            ]
          }
        }
      ]
