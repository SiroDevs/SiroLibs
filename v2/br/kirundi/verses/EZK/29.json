            "number": "20",
            "style": "v",
            "sid": "EZK 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.20",
            "verseOrgIds": [
              "EZK.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gihe nzokwongera inkomezi Abisirayeli, kandi nawe Ezekiyeli, nzoguha ububasha kugira ngo ushobore kuvugana na bo. Ni ho bazomenyera ko jewe ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.21",
            "verseOrgIds": [
              "EZK.29.21"
            ]
          }
        }
      ]
    }
