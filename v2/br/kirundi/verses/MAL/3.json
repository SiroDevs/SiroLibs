              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwamvuzeko amajambo mabi,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.13",
            "verseOrgIds": [
              "MAL.3.13"
            ]
          }
        },
        {
          "text": " avuze. “Ariko murabaza muti: ‘Ni igiki twakuvuzeko kibi?’",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.13",
            "verseOrgIds": [
              "MAL.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.13",
            "verseOrgIds": [
              "MAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwavuze muti: ‘Gukorera Imana nta kamaro bifise. Mbega gukurikiza ivyo idutegeka no mu kwama tuza imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.14",
            "verseOrgIds": [
              "MAL.3.14"
            ]
          }
        },
        {
          "text": " Mushoboravyose tumeze nk’abagandaye, bitumariye iki?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.14",
            "verseOrgIds": [
              "MAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muravuga ngo kuva ubu rero tuzovuga ko abishira hejuru ari bo bahiriwe, ko inkozi z’ibibi ari zo zitera imbere, kandi ko bagerageza Imana ariko ntibagire ico baba.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abubaha ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "text": " baraganira, ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "text": " na we yumviriza ivyo bavuga. Igitabu c’icibutso gica candikirwa imbere yiwe, candikwamwo amazina y’abo bose bubaha ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "text": ", bagahesha icubahiro izina ryiwe.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kuri wa musi, nzocirako imanza,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.17",
            "verseOrgIds": [
              "MAL.3.17"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze, “bazoba ari ubutunzi niharije kandi budasanzwe. Nzobazigamira mu mbabazi zanje nk’uko umuvyeyi agirira impuhwe akazigama umwana wiwe amwubaha. ",
          "type": "text",
