              "MAL.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAL 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndi ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
        {
          "text": " kandi simpindagurika. Ni co gutuma mwebwe urvyaro rwa Yakobo mutararandurwa. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.6",
            "verseOrgIds": [
              "MAL.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uhereye kuva kuri ba sogokuruza, mwamye muta ivyagezwe vyanje, ntimubigenderemwo. Ehe nimungarukeko, nanje nzobagarukako,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ariko muribaza muti: ‘Mbega twokugarukako dute kandi tutigeze tukuvako?’",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAL 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.7",
            "verseOrgIds": [
              "MAL.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbega hari uwokwiba Imana? Ariko mwebwe mwaranyivye.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kandi muribaza muti: ‘Twakwivye gute?’ Mwanyivye ibigiracumi n’amashikanwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAL 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.8",
            "verseOrgIds": [
              "MAL.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAL 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri musi y’umuvumo mwe n’ihanga ryanyu ryose, kuko munyiba. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.9",
            "verseOrgIds": [
              "MAL.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAL 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimuzane ikigiracumi gikwiye mu bubiko bwanje, kugira ngo mu nzu yanje habemwo ivyokurya. Ehe nimubingeragereshe, jewe ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "text": " Mushoboravyose, murabe ko ntugurura imiryango yo mw’ijuru, nkabacuncuburirako imigisha mukabura n’aho muyikwiza. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzozitira inzige n’ingwara ntibitere imirima yanyu, kandi inzabibu zanyu ntizizohunguruka ziteze,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.11",
            "verseOrgIds": [
              "MAL.3.11"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.11",
            "verseOrgIds": [
              "MAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ni ho amahanga yose azobita abahirwe, kuko muzoba igihugu kimpimbara,” ni ko ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        },
        {
          "text": " Mushoboravyose avuze.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
