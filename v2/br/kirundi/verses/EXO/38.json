          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifeza zegeranijwe mw’ikoraniro zangana n’italanto ijana",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "38:25",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 3.750.",
              "type": "text"
            }
          ]
        },
        {
          "text": " na shekeli igihumbi n’amajana indwi na mirongo indwi na zitanu,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "38:25",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 20.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hakoreshejwe ingero shekeli y’Ahera. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.25",
            "verseOrgIds": [
              "EXO.38.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 38:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo feza zatanzwe nk’ikori n’abagabo bose baharuwe, umwe wese agatanga ingero beka imwe, ni ukuvuga igice ca shekeli,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "38:26",
              "type": "text"
            },
            {
              "text": "Ni nk’amagarama 5,7.",
              "type": "text"
            }
          ]
        },
        {
          "text": " hakoreshejwe ingero shekeli y’Ahera. Abagabo batanze ifeza bari ibihumbi amajana atandatu na bitatu n’amajana atanu na mirongo itanu bafise imyaka mirongo ibiri n’iyirenga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.26",
            "verseOrgIds": [
              "EXO.38.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 38:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo talanto ijana z’ifeza zakoreshejwe mu gucura ibitereko vyo gushingamwo inkingi ijana z’Ihema n’iza ca gitambara gikingiriye Ahera. Ibitereko ijana vyavuye mw’italanto ijana, italanto imwe ivamwo igitereko kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.27",
            "verseOrgIds": [
              "EXO.38.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 38:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakoresheje shekeli igihumbi n’amajana indwi na mirongo indwi na zitanu mu gucura imirinda n’ibitambikwa vyo gufatanya inkingi, izindi bazomeka ku mitwe y’inkingi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.28",
            "verseOrgIds": [
              "EXO.38.28"
            ]
          }
        }
      ]
    },
