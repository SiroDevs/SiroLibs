          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ivyateretsweko inkingi zigize urugo rukikuje ihema hamwe n’urwinjiriro rwaryo, n’imambo z’Ihema n’iz’urugo ruyikikuje.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.38.31",
