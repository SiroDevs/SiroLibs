        },
        {
          "text": "Bazobaze ibiti bitanu mu giti c’ikasiya vyo gushira ku mbaho zo ku ruhande rumwe rw’iryo hema, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.26",
            "verseOrgIds": [
              "EXO.26.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 26:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ibindi bitanu vyo ku rundi ruhande, hamwe n’ibindi bitanu vyo ku ruhande rwo mu burengero, ari rwo ruhande rwo hirya rw’ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.27",
            "verseOrgIds": [
              "EXO.26.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 26:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igiti gica hagati y’ibindi kizova ku ntango gishike ku mpera, gice hagati na hagati ku mbaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.28",
            "verseOrgIds": [
              "EXO.26.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 26:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izo mbaho uzozomekeko inzahabu, kandi bazocure ibigombo mu nzahabu vyo gufata vya biti, kandi n’ivyo biti nyene bazovyomekeko inzahabu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.29",
            "verseOrgIds": [
              "EXO.26.29"
            ]
          }
        }
      ]
    },
