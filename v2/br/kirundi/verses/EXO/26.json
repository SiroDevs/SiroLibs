            "number": "31",
            "style": "v",
            "sid": "EXO 26:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baze bajishe igitambara mu nyuzi z’ubururu, izitukura, izitukura cane n’izera derere zihinze neza, kiriko n’ibishushanyo vy’abakerubi, bishizweko n’abahinga karuhariwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.31",
            "verseOrgIds": [
              "EXO.26.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 26:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokimanikishe imisumari ikozwe mu nzahabu ku nkingi zine z’imbaho z’igiti c’ikasiya zometseko inzahabu, zihagaze ku bitereko bine vy’ifeza. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.32",
            "verseOrgIds": [
              "EXO.26.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 26:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ico gitambara bazokimanike bagitumberanije hanyuma bazoshire Isandugu y’Isezerano inyuma y’ico gitambara. Ico gitambara kizotandukanya Ahera n’Ahera Cane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.33",
            "verseOrgIds": [
              "EXO.26.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 26:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wa mupfundikizo wo kwiyezerezako uzowurumishe ya sandugu y’Isezerano iri Ahera Cane ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.34",
            "verseOrgIds": [
              "EXO.26.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 26:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imeza bazoyishire hino y’igitambara ku ruhande ruherereye mu buraruko bw’isandugu bayishireko igiterekwako amatara aharabana n’iyo meza ku ruhande rw’ihema ruraba mu bumanuko.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.35",
            "verseOrgIds": [
              "EXO.26.35"
            ]
          }
        }
      ]
