    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 26:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzokore ihema rifise ibitambara icumi bijishwe mu nyuzi zera, iz’ubururu, izitukura n’izitukura cane, zihinze neza; bijishweko n’ibishushanyo vy’abakerubi bikozwe n’abahinga karuhariwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.1",
            "verseOrgIds": [
              "EXO.26.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 26:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibitambara vyose bizobe bireha, bifise ingero z’igice c’ukuboko mirongo ibiri n’umunani",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:2",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 13.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure, n’ingero z’igice c’ukuboko zine",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:2",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 1,8.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.2",
            "verseOrgIds": [
              "EXO.26.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 26:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibitambara bitanu muzobifatanye ukwavyo, n’ibindi bitanu mubifatanye ukwavyo, gutyo bibe bibiri binini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.3",
            "verseOrgIds": [
              "EXO.26.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 26:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokore utugombo dusa n’ubururu badutere ku ruhande rumwe rw’igitambara kinini, utundi badutere ku ruhande rw’ikindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.4",
            "verseOrgIds": [
              "EXO.26.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 26:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazoshire utugombo mirongo itanu ku ruhande rw’igitambara kinini kimwe, n’utundi mirongo itanu ku ruhande rw’ikindi, utugombo tubiritubiri dutumberane. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.5",
            "verseOrgIds": [
              "EXO.26.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazocure ibikwashu mirongo itanu mu nzahabu babikoreshe mu gufatanya ibitambara kugira ngo Ihema ry’ibonaniro ribe inyubakwa imwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 26:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.6",
            "verseOrgIds": [
              "EXO.26.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 26:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokore n’ibitambara icumi na kimwe mu mpuzu z’ubwoya bw’impene, vyo gupfuka Ihema ry’Ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.7",
            "verseOrgIds": [
              "EXO.26.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 26:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bitambara icumi na kimwe vyose bizobe bireha, bifise ingero z’igice c’ukuboko zine",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:8",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 13,5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure, n’ingero z’igice c’ukuboko zine",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:8",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 1,8.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.8",
            "verseOrgIds": [
              "EXO.26.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 26:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazofatanye ibitambara bitanu ukwavyo bibe kimwe, bafatanye ibindi bitandatu ukwavyo bibe ikindi kimwe. Igitambara ca gatandatu kizozingwemwo kabiri imbere y’Ihema ry’Ibonaniro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.9",
            "verseOrgIds": [
              "EXO.26.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 26:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazokore utugombo mirongo itanu badutere ku mpera imwe y’igitambara kimwe kinini, utundi mirongo itanu ku mpera imwe y’ikindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.10",
            "verseOrgIds": [
              "EXO.26.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 26:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanyuma bazocure ibikwashu mirongo itanu mu butare bw’umwakaka, bavyinjize muri utwo tugombo, bafatanye iryo Hema ricike rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.11",
            "verseOrgIds": [
              "EXO.26.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 26:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igice c’igitambara kizorengako kize kigororokere ku ruhande rw’inyuma rw’Ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.12",
            "verseOrgIds": [
              "EXO.26.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 26:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku mpande zose, hazorengeko ingero y’igice c’ukuboko imwe",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:13",
              "type": "text"
            },
            {
              "text": "Ni nk’isantimetero 45.",
              "type": "text"
            }
          ]
        },
        {
          "text": " kugira ngo gitwikire Ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.13",
            "verseOrgIds": [
              "EXO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hejuru y’ico gitambara baze barenzeko insato z’intama zisize irangi ritukura, bakirenzeko izindi nsato z’agaciro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.14",
            "verseOrgIds": [
              "EXO.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobaze imbaho mu giti c’ikasiya zo guhagarika ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.15",
            "verseOrgIds": [
              "EXO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubaho rumwerumwe ruzogire ingero z’igice c’ukuboko icumi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:16",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 4,5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure, n’ingero y’igice c’ukuboko imwe n’igice",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "26:16",
              "type": "text"
            },
            {
              "text": "Ni nk’isantimetero 68.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ubwaguke, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.16",
            "verseOrgIds": [
              "EXO.26.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 26:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "urubaho rwose ruzogire inkago zibiri zibangabanganywe. Uko abe ari ko muzokwubaka iryo hema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.17",
            "verseOrgIds": [
              "EXO.26.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 26:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobaze imbaho mirongo ibiri zo gushigikira uruhande rwo mu bumanuko, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.18",
            "verseOrgIds": [
              "EXO.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "baze bicurire n’ivyo kuzihagarikako mirongo ine mw’ifeza, bibiribibiri ku rubaho rumwerumwe, kimwe cose mu nkago imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.19",
            "verseOrgIds": [
              "EXO.26.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 26:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ruhande rwo mu buraruko na ho nyene hazobe imbaho mirongo ibiri, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.20",
            "verseOrgIds": [
              "EXO.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ivyo kuziterekako mirongo ine bicuzwe mw’ifeza, bibiribibiri musi y’urubaho rumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.21",
            "verseOrgIds": [
              "EXO.26.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 26:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazobaze n’imbaho zitandatu zo ku ruhande rw’inyuma y’ihema, ari ho mu burengero bwaryo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.22",
            "verseOrgIds": [
              "EXO.26.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 26:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "baze bongere babaze imbaho zibiri z’imfuruka zo hirya. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.23",
            "verseOrgIds": [
              "EXO.26.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 26:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muri izi mfuruka zibiri, hazoshirweyo imbaho zibiri zifatanye kuva hasi gushika hejuru, zishinze mu muringa umwe; hose bizokorwe uko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.24",
            "verseOrgIds": [
              "EXO.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Rero hazoba imbaho umunani n’ivyo zishingwako icumi na bitandatu, bibiribibiri musi y’urubaho rumwerumwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.26.25",
            "verseOrgIds": [
              "EXO.26.25"
            ]
          }
        }
      ]
    },
