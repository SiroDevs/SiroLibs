            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Farawo ntazokwumvira, kugira ngo ibitangaza vyanje bigwire muri Egiputa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na Aroni bakoreye ivyo bitangaza vyose imbere ya Farawo, ariko ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        },
        {
          "text": " akomantaza umutima wa Farawo, ntiyareka Abisirayeli ngo bave mu gihugu ciwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    }
