              "EXO.33.21"
            ]
          }
        },
        {
          "text": " aramubwira ati: “Hagarara ku gitandara aha hafi yanje. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.21",
            "verseOrgIds": [
              "EXO.33.21"
            ]
          }
        },
