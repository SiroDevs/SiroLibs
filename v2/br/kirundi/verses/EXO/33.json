              "EXO.33.17"
            ]
          }
        },
        {
          "text": " yishura Mose ati: “Nzokora ivyo unsavye vyose kuko wagiriwe ubuntu nkakumenya mw’izina.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.17",
            "verseOrgIds": [
