        },
        {
          "text": " aramwishura ati: “Nzojana namwe kandi nzoguha akaruhuko.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.33.14",
            "verseOrgIds": [
              "EXO.33.14"
            ]
          }
