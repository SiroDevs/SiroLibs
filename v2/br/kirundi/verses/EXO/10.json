            ]
          }
        },
        {
          "text": " abarira Mose ati: “Ramvura ukuboko kwawe ukurabishije mu kirere, umwijima w’umuzitanya uca utera Egiputa, umwijima ukomeye kugeza aho umuntu yowukabakaba akawumva.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.21",
            "verseOrgIds": [
              "EXO.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
