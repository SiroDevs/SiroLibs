          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramvurira ya nkoni yiwe kuri Egiputa, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "text": " na we ahuhutisha umuyaga uvuye mu buseruko, uhuhuta mu gihugu cose, ijoro n’umurango. Bukeye mu gatondo, wa muyaga wo mu buseruko wari wazanye za nzige; ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.13",
            "verseOrgIds": [
              "EXO.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "zitera igihugu cose ca Egiputa, zirundana ahantu hose mu gihugu ari nyinshi cane. Ntihari bwigere haba icago c’inzige kimeze nk’ico, nta n’ikizosubira kubaho. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.14",
            "verseOrgIds": [
              "EXO.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zarapfutse isi gushika aho yose yirabura. Zitikiza ivyari vyasigajwe n’urubura, uri imirima, ivyamwa, n’ibiti. Nta citwa icatsi, canke igiti, canke igiterwa cabaye kikirangwa mu gihugu ca Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.15",
            "verseOrgIds": [
              "EXO.10.15"
            ]
          }
        }
      ]
    },
