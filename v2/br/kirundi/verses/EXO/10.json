            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Subira uje kwa Farawo, kuko nakomantaje umutima wiwe n’uw’abatware biwe, kugira ngo mbashe kwerekana ibimenyetso n’ibitangaza vyanje ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.1",
            "verseOrgIds": [
              "EXO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kandi kugira ngo muzobwire abana n’abuzukuru banyu ingene nahanye nivuye inyuma Abanyegiputa, eka n’ibitangaza nakoreye hagati muri bo kugira ngo mumenye ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.2",
            "verseOrgIds": [
              "EXO.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
