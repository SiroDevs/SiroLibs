          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose aramvura ukuboko akurabishije kw’ijuru, umwijima w’umuzitanya uca utwikira igihugu cose ca Egiputa, umara imisi itatu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.22",
            "verseOrgIds": [
              "EXO.10.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 10:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nta washobora kubona uwundi, kandi nta wava aho ari ngo aje ahandi muri iyo misi itatu. Ariko aho Abisirayeli baba hoho hari umuco nk’uko bisanzwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.23",
            "verseOrgIds": [
              "EXO.10.23"
            ]
          }
        }
