              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo aca atumako ningoga Mose na Aroni, ababwira ati: “Nacumuye k’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.16",
            "verseOrgIds": [
              "EXO.10.16"
            ]
          }
        },
        {
          "text": " Imana yanyu no kuri mwebwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.16",
            "verseOrgIds": [
              "EXO.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimusubire mumparire icaha canje, munsabire ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.17",
            "verseOrgIds": [
              "EXO.10.17"
            ]
          }
        },
        {
          "text": " Imana yanyu ankureko iki cago c’urupfu.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.17",
            "verseOrgIds": [
              "EXO.10.17"
            ]
          }
        }
