              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko Mose aramwishura ati: “Twemerere dutware ibimazi vyo guturira mu gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
        {
          "text": " Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.25",
            "verseOrgIds": [
              "EXO.10.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 10:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tugenda tujanye n’ibitungwa vyacu vyose, nta na kimwe dusiga inyuma. Muri vyo ni ho tuzotoramwo ivyo gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        },
        {
          "text": " Imana yacu, kandi tudashitseyo ntituzomenya ivyo tuzokoresha mu gushikanira ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.26",
            "verseOrgIds": [
              "EXO.10.26"
            ]
          }
        }
