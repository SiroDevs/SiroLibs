          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " na we aca ahindukiza wa muyaga, uhuhuta n’inkomezi nyinshi uvuye mu burengero, ugenda ukubuye inzige zose uzisuka mu Kiyaga Gitukura. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.19",
            "verseOrgIds": [
              "EXO.10.19"
            ]
