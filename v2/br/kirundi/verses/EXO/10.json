          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose na we aramwishura ati: “Tuzojana n’abakiri bato n’abakuze, abahungu n’abakobwa bacu, n’ibitungwa vyacu, kuko tuzoba tugiye kwigina ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        },
        {
          "text": ".”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.9",
            "verseOrgIds": [
              "EXO.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
