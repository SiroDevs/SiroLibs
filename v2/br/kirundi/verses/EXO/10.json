          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo arababwira ati: “",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "text": " arabana namwe, ninabareka mukajana n’abagore n’abana banyu! Biraboneka ko mufise intumbero mbi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.10",
            "verseOrgIds": [
              "EXO.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntibikabe! Nimujane n’abagabo gusa, musenge ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        },
        {
          "text": ", kuko ari co mwagumye munsaba.” Nuko Mose na Aroni baca barirukanwa, bava imbere ya Farawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.10.11",
            "verseOrgIds": [
              "EXO.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
