          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimugakorere ikibi umunyamahanga canke ngo mumurenganye, kuko namwe mwigeze kuba abanyamahanga muri Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.21",
            "verseOrgIds": [
              "EXO.22.21"
            ]
          }
        }
