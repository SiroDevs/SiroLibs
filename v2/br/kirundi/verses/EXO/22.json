            "number": "25",
            "style": "v",
            "sid": "EXO 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimwagurana amahera umwe mu bantu banje ari muri mwebwe akenye, ntimuzobikore nk’abadandaza, ntihagire inyungu muzomusaba. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.25",
            "verseOrgIds": [
              "EXO.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwaka mugenzawe umutamana nk’ingwati, izuba ntirizorenge utarawumusubiza, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.26",
            "verseOrgIds": [
              "EXO.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuko uwo mutamana ushobora kuba ari wo wonyene afise wo kwipfuka. Nutawumusubiza azoheza yipfuke iki mw’ijoro? Niyandirira nzokwumva amarira yiwe, kuko ndi umunyembabazi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.27",
            "verseOrgIds": [
              "EXO.22.27"
            ]
          }
        }
      ]
    },
