              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyatira igitungwa kwa mugenziwe hanyuma kigakomereka canke kigapfa nyene co atari ho ari, uwagitiye azokirihe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.14",
            "verseOrgIds": [
              "EXO.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko hagize ico kiba nyene co ari ngaho, uwagitiye ntazokirihe. Nimba igitungwa cari cakoteshejwe, amahera cakoteshejwe azobe ari yo ndishi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.15",
            "verseOrgIds": [
              "EXO.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
