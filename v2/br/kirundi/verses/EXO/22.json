          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimugatuke Imana, canke ngo muvume abaganza ubwoko bwanyu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.28",
            "verseOrgIds": [
              "EXO.22.28"
            ]
          }
        }
