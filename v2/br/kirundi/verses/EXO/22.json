    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira uwiba inka canke intama, akayibaga canke akayigurisha, azorihe inka zitanu zo gushumbusha nyene iyo nka, n’intama zitanu zo gushumbusha nyene iyo ntama.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.1",
            "verseOrgIds": [
              "EXO.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusuma niyicwa ariko aramena inzu y’umuntu, uwumwishe ntazoharurweko amaraso yiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.2",
            "verseOrgIds": [
              "EXO.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko bibaye izuba ryamaze guseruka, uwuzomwica azoharurweko amaraso yiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusuma wese azofatwa azosubize ivyo yivye vyose, niyaba ata co afise co kubiriha, azogurishwe kugira ngo ivyo yivye birihwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.3",
            "verseOrgIds": [
              "EXO.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira uwiba inka canke indogoba canke intama hanyuma akayifatanwa, uwo musuma azobirihe incuro zibiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.4",
            "verseOrgIds": [
              "EXO.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyaragira ibitungwa vyiwe mu mirima yiwe canke mu ruzabibu rwiwe, hanyuma akonesha umurima w’abandi, azorihe ku mwimbu wiwe mwiza wa mbere w’imirima yiwe canke inzabibu ziwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.5",
            "verseOrgIds": [
              "EXO.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira uwuturira ishamba hanyuma umuriro ukarandagata, ugashikira umurima w’uwundi, ugaturira ingano zitekeye canke izihagaze canke umurima wose; uwawudometse azorihe ivyo uzoba waturiye vyose.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.6",
            "verseOrgIds": [
              "EXO.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyabitsa umubanyi wiwe ifeza canke inzahabu kugira ngo abishingure neza hanyuma bikibirwa mu nzu y’uwo mubanyi, uwavyivye niyafatwa azobirihe incuro zibiri. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.7",
            "verseOrgIds": [
              "EXO.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko uwavyivye natafatwa, nyene iyo nzu azorenguke imbere y’Imana kugira ngo basuzume ko atari we yavyivye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.8",
            "verseOrgIds": [
              "EXO.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nihagira abantu bagira amatati bagapfa inka, indogoba, intama, impuzu canke ikindi kintu cose catakaye umwe wese yiyitirira, bompi bazoze imbere y’Imana. Uwuzotsindwa azobirihe mugenziwe incuro zibiri.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.9",
            "verseOrgIds": [
              "EXO.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyabikisha mugenziwe indogoba, inka, intama canke ikindi gitungwa ico ari co cose, hanyuma kigapfa canke kigakomereka, canke kikibwa ata wundi yabibonye, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.10",
            "verseOrgIds": [
              "EXO.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "uwo yari abitunze azorahirire imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "text": ". ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "text": " niyemeza ko uwo mubanyi ata co yivye, nyene co azovyemere, kandi ntaze yake indishi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.11",
            "verseOrgIds": [
              "EXO.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nibasanga yaraciyibishije, azohe indishi nyene co. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.12",
            "verseOrgIds": [
              "EXO.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nimba catabaguwe n’igikoko, azozane ibisigarira kugira ngo bibe ivyemeza: ntazoheza ngo abazwe ico gitungwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.22.13",
            "verseOrgIds": [
              "EXO.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
