      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 36:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.1",
            "verseOrgIds": [
              "EXO.36.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 36:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose aca atumako Bezaleli na Oholiyabu, n’abandi bose ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "text": " yahaye ubuhinga, baza babikunze, baja kuri ico gikorwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.2",
            "verseOrgIds": [
              "EXO.36.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 36:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose abaha amashikanwa yose Abisirayeli batanze ngo yubake ihema, abantu na bo babandanya batanga uko bukeye uko bwije, bivuye ku mutima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.3",
            "verseOrgIds": [
              "EXO.36.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 36:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ba bahinga bahagarika kwubaka, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.4",
            "verseOrgIds": [
              "EXO.36.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "baja kubwira Mose bati: “Abantu bagumye bazana ibikoresho birenze ibikenewe kuri iki gikorwa ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        },
        {
          "text": " yatugeze gukora.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 36:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.5",
            "verseOrgIds": [
              "EXO.36.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 36:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose aca ashinga ko bakwiragira mu makambi yose babwira abantu bati: “Ntihagire umugabo canke umugore asubira kugira ico atanze nk’ishikanwa ryo kwubaka ihema.” Maze abantu ntibaba bagisubira gutangira iryo hema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.6",
            "verseOrgIds": [
              "EXO.36.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bari bamaze gutanga vyari birengeye ivyari bikenewe ku bw’ico gikorwa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.7",
            "verseOrgIds": [
              "EXO.36.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 36:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.7",
            "verseOrgIds": [
              "EXO.36.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 36:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abantu bose b’abahinga bakora ico gikorwa, bubaka ihema, barisakaza ibitambara icumi vyera derere bikozwe mu nyuzi zihinze neza, iz’ubururu, izitukura n’izitukura cane, bijishweko n’ibishushanyo vy’abakerubi, bikozwe n’abahinga karuhariwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.8",
            "verseOrgIds": [
              "EXO.36.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 36:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ivyo bitambara vyose vyarareha: bifise ingero z’igice c’ukuboko mirongo ibiri n’umunani z’uburebure, n’ingero z’igice c’ukuboko zine",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.9",
            "verseOrgIds": [
              "EXO.36.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:9",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 13 z’uburebure n’imetero 1,8 y’ubwaguke.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.9",
            "verseOrgIds": [
              "EXO.36.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 36:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafata ibitambara bitanu barabifatanya ukwavyo, n’ibindi bitanu babifatanya ukwavyo, gutyo biba bibiri binini. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.10",
            "verseOrgIds": [
              "EXO.36.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 36:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Batera utugombo dusa n’ubururu ku ruhande rumwe rw’igitambara kinini, utundi mirongo itanu badutera ku ruhande rw’ikindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.11",
            "verseOrgIds": [
              "EXO.36.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 36:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Utugombo mirongo itanu duteye ku ruhande rw’igitambara kimwe twari dutumberanye na mirongo itanu duteye ku ruhande rw’ikindi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.12",
            "verseOrgIds": [
              "EXO.36.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongera bacura ibikwashu mirongo itanu mu nzahabu babikoresha mu gufatanya vya bitambara kugira ngo Ihema ribe inyubakwa imwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 36:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.13",
            "verseOrgIds": [
              "EXO.36.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 36:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bakora n’ibitambara icumi na kimwe mu mpuzu zikozwe mu bwoya bw’impene, biba ivyo gupfuka Ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.14",
            "verseOrgIds": [
              "EXO.36.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 36:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igitambara cose cari gifise ingero z’igice c’ukuboko mirongo itatu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.15",
            "verseOrgIds": [
              "EXO.36.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:15",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 14.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure n’ingero z’igice c’ukuboko zine",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.15",
            "verseOrgIds": [
              "EXO.36.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:15",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 1,8.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’ubwaguke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.15",
            "verseOrgIds": [
              "EXO.36.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 36:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bafatanya ibitambara bitanu biba kimwe, bafatanya n’ibindi bitandatu na vyo nyene biba igitambara kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.16",
            "verseOrgIds": [
              "EXO.36.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 36:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bajisha utugombo mirongo itanu badutera ku mpera ya vya bindi bitandatu vyafatanijwe, biba igitambara kimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.17",
            "verseOrgIds": [
              "EXO.36.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 36:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baca bacura n’ibikwashu mirongo itanu mu butare bw’umwakaka vyo gufatanya ivyo bitambara vyompi, kugira ngo Ihema ribe rimwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.18",
            "verseOrgIds": [
              "EXO.36.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongera bajisha ikindi co gupfuka Ihema gikozwe mu nsato z’intama zisize irangi ritukura, bakirenzako izindi nsato z’agaciro.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 36:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.19",
            "verseOrgIds": [
              "EXO.36.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 36:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bongera babaza imbaho mu giti c’ikasiya zo guhagarika ihema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.20",
            "verseOrgIds": [
              "EXO.36.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 36:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubaho rumwerumwe rwari rufise ingero z’igice c’ukuboko icumi",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.21",
            "verseOrgIds": [
              "EXO.36.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:21",
              "type": "text"
            },
            {
              "text": "Ni nk’imetero 4,5.",
              "type": "text"
            }
          ]
        },
        {
          "text": " z’uburebure n’ingero y’igice c’ukuboko imwe n’igice",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.21",
            "verseOrgIds": [
              "EXO.36.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "36:21",
              "type": "text"
            },
            {
              "text": "Ni nk’isantimetero 68.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’ubwaguke. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.21",
            "verseOrgIds": [
              "EXO.36.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Urubaho rwose rwari rufise inkago zibiri zibangabanganywe. Uko ni ko bubatse iryo hema. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.22",
            "verseOrgIds": [
              "EXO.36.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Babaza imbaho mirongo ibiri zo gushigikira uruhande rwo mu bumanuko, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.23",
            "verseOrgIds": [
              "EXO.36.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 36:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "bacura n’ivyo kuzihagarikako mirongo ine mw’ifeza, bibiribibiri ku rubaho rumwerumwe, kimwe cose mu nkago imwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.24",
            "verseOrgIds": [
              "EXO.36.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku ruhande rwo mu buraruko na ho bahashize imbaho mirongo ibiri ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.25",
            "verseOrgIds": [
              "EXO.36.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "n’ivyo kuziterekako mirongo ine bicuzwe mw’ifeza, bibiribibiri musi y’urubaho rumwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.36.26",
