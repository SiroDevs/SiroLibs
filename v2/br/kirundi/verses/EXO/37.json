            }
          ]
        },
        {
          "text": "Bakora n’amatara indwi yaco, imikasi yo gutunganya urutambi, utwo gushiramwo umunyota, kandi vyose bicurwa mu nzahabu itavanze. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.23",
            "verseOrgIds": [
              "EXO.37.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 37:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Vyose hamwe vyakozwe mw’italanto",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "37:24",
              "type": "text"
            },
            {
              "text": "Ni nk’ibilo 34.",
              "type": "text"
            }
          ]
        },
        {
          "text": " y’inzahabu itavanze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.37.24",
            "verseOrgIds": [
              "EXO.37.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
