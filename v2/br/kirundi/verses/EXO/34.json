            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "text": " yongera abwira Mose ati: “Andika aya majambo, kuko ahagarariye isezerano ngiranye na wewe hamwe n’Abisirayeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.27",
            "verseOrgIds": [
              "EXO.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
