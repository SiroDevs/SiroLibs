              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntimuze muteke umwagazi w’impene mu mata ya nyina.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.26",
            "verseOrgIds": [
              "EXO.34.26"
