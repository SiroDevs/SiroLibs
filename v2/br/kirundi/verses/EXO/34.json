          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "bama basanga aca ibibatsi. Yaca asubizako wa mwitwikiro ku maso gushika asubiye mw’Ihema kuvugana n’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.35",
            "verseOrgIds": [
              "EXO.34.35"
            ]
          }
