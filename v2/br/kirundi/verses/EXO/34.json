          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose yamaranye ngaho n’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        },
        {
          "text": " imisi mirongo ine n’amajoro mirongo ine, atarya, atanywa, yandika kuri vya bisate vy’amabuye amajambo y’isezerano, ari yo mabwirizwa icumi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.34.28",
            "verseOrgIds": [
              "EXO.34.28"
            ]
          }
        }
