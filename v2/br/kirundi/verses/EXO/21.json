              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyimba ikinogo canke agapfukura ikinogo cari gipfutswe hanyuma ntagipfuke, maze inka canke indogoba ikakigwamwo, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.33",
