          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umuntu niyakubita umugurano wiwe, yaba umuhungu canke umukobwa akamumena ijisho, azoce amureka yidegemvye, maze ico kizomubere inshumbusho ku jisho ryiwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.26",
            "verseOrgIds": [
              "EXO.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naho niyamukubita akamukuramwo iryinyo, na ho nyene azomureke yidegemvye, kimubere inshumbusho ku ryinyo ryiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.21.27",
            "verseOrgIds": [
              "EXO.21.27"
            ]
          }
        }
      ]
