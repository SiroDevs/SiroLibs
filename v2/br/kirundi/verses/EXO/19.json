            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.19",
            "verseOrgIds": [
              "EXO.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "text": " aramanuka ku musozi Sinayi, ahamagara Mose ngo aduge kw’itaba ry’uwo musozi, Mose na we araduga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.20",
            "verseOrgIds": [
              "EXO.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " abarira Mose ati: “Genda wihanize abantu ntibahirahire ngo barengane ka karimbi ngo baduge kuraba ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "text": ", kuko benshi muri bo bopfa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.21",
            "verseOrgIds": [
              "EXO.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbere n’abaherezi bahora baza aho ndi babanze biyeze, kugira ngo jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        },
        {
          "text": " sindabarandure.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.22",
            "verseOrgIds": [
              "EXO.19.22"
            ]
          }
        }
      ]
    },
