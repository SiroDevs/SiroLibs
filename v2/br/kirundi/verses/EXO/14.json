          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
              "EXO.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyegiputa barabakurikira. Abagendera ku mafarasi n’abagendera mu mikogote ba Farawo bose barabakurikira no gushika mu kiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.23",
            "verseOrgIds": [
              "EXO.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko nko mu mutwenzi bugira buce, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.24",
            "verseOrgIds": [
              "EXO.14.24"
            ]
          }
        },
        {
          "text": " yihweza ingabo z’Abanyegiputa ari muri ya nkingi y’umuriro, maze azisukamwo umuvurungano, ",
          "type": "text",
