          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Mose aramvurira ukuboko kwiwe hejuru ya ca kiyaga, maze mu mutwenzi ikiyaga kiraterana, gisubira uko cahora. Abanyegiputa bagerageza guhunga, ariko ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
            "verseOrgIds": [
              "EXO.14.27"
            ]
          }
        },
        {
          "text": " abahonereza mu kiyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.27",
