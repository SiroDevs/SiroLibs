              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.14",
            "verseOrgIds": [
              "EXO.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Ni iki gitumye untakambira? Barira Abisirayeli babandanye urugendo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.15",
            "verseOrgIds": [
              "EXO.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawe manika inkoni yawe uramvurire ukuboko kwawe hejuru y’ikiyaga, ugicemwo kabiri kugira ngo Abisirayeli babone kugicamwo nk’abagendera kw’isi yumutse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.16",
            "verseOrgIds": [
              "EXO.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngira nkomantaze imitima y’Abanyegiputa kugira ngo babakurikire. Ndihesha icubahiro kuri Farawo n’ingabo ziwe, ku mikogote yiwe no ku bagendera ku mafarasi biwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.17",
            "verseOrgIds": [
              "EXO.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyegiputa bazomenya ko ndi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        },
        {
          "text": " ninihesha icubahiro kuri Farawo n’ingabo ziwe, ku mikogote yiwe no ku bagendera ku mafarasi biwe.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.18",
            "verseOrgIds": [
              "EXO.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
