          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwo musi ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.30",
            "verseOrgIds": [
              "EXO.14.30"
            ]
          }
        },
        {
          "text": " akiza Abisirayeli ukuboko kw’Abanyegiputa, Abisirayeli babona imivyimba y’Abanyegiputa yandagaye ku nkengera z’ikiyaga. ",
          "type": "text",
          "attrs": {
