            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.20",
            "verseOrgIds": [
              "EXO.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose aramvurira ukuboko hejuru ya ca kiyaga, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "text": " aca ahuhutisha umuyaga uvuye mu buseruko usubiza ikiyaga inyuma, uca inzira. Uwo muyaga uhuhuta ijoro ryose gushika aho hasi mu kiyaga hasigara ari isi yumutse. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.21",
            "verseOrgIds": [
              "EXO.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abisirayeli baraheza baca mu kiyaga cari cigabuyemwo kabiri, bagendera kw’isi yumutse, amazi ameze nk’ibihome i buryo n’i bubamfu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.22",
            "verseOrgIds": [
              "EXO.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
