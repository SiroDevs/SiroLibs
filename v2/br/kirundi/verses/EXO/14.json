            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
          "text": " abarira Mose ati: “Ramvurira ukuboko kwawe hejuru y’ikiyaga kugira ngo amazi ateranire ku Banyegiputa n’imikogote yabo n’abagendera ku mafarasi.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.14.26",
            "verseOrgIds": [
              "EXO.14.26"
            ]
          }
        },
        {
