            "verseOrgIds": [
              "EXO.31.18"
            ]
          }
        },
        {
          "text": " ahejeje kuvuganira na Mose ku musozi Sinayi, amuhereza ibisate vy’amabuye biriko amabwirizwa, ibisate vy’amabuye Imana yiyandikiyeko n’urutoke rwayo.",
          "type": "text",
          "attrs": {
