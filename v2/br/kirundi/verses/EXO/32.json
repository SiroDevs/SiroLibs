          "attrs": {
            "verseId": "EXO.32.30",
            "verseOrgIds": [
              "EXO.32.30"
            ]
          }
        },
        {
          "text": " ari, hari aho yonyemerera nkabatangira impongano.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.30",
