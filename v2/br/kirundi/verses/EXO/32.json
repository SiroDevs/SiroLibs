              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose asubira aho ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.31",
            "verseOrgIds": [
              "EXO.32.31"
            ]
