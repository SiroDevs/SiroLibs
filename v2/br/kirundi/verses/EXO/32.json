          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose abona ko abantu ata co birinda na kimwe, kandi ko Aroni yabaretse ngo bakore ivyo bishakiye; gutyo baba bahindutse agatwengo mu maso y’abansi babo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.25",
            "verseOrgIds": [
              "EXO.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ko guhagarara mu rwinjiriro rw’aho bari bacumbitse, avuga ati: “Uwuri ku ruhande rw’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        },
        {
          "text": " aze aho ndi.” Maze Abalewi bose bakoranira aho ari.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.26",
            "verseOrgIds": [
              "EXO.32.26"
            ]
          }
        }
