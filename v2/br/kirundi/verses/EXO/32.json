          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko noneho ndakwinginze ubaharire icaha cabo, atari uko na ho uhanagure izina ryanje mu gitabu wanditse.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.32.32",
