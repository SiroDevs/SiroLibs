            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        },
        {
          "text": " aca abarira Mose ati: “Barira Aroni uti: ‘Ramvurira iyo nkoni ufise mu kuboko kwawe hejuru y’inzuzi, imigende n’ibinogo vy’amazi, kugira ngo igihugu ca Egiputa cuzure ibikere.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        }
      ]
    },
    {
