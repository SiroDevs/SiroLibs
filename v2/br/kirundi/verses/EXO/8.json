          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko ico gihe nzosigaza intara ya Gosheni, iyo abantu banje babamwo, nta bibugu bizobayo, kugira ngo umenye ko jewe ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        },
        {
          "text": " ndi muri iki gihugu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.22",
            "verseOrgIds": [
              "EXO.8.22"
            ]
          }
        }
      ]
