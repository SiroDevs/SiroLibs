          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farawo aramwishura ati: “Uzobikore ejo.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose aramwishura ati: “Bizoba uko nyene ubivuze kugira ngo umenye ko ata wuhwanye n’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "text": " Imana yacu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.10",
            "verseOrgIds": [
              "EXO.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ibikere bizova mu kirimba cawe no mu mazu y’abatware bawe n’ay’abantu bawe, hazosigara ibiri mu ruzi Nili gusa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.11",
            "verseOrgIds": [
              "EXO.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
