            "number": "19",
            "style": "v",
            "sid": "EXO 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyamareba ba Farawo baca bamubwira bati: “Uru ni urutoke rw’Imana rukoze ibi.” Ariko Farawo akomantaza umutima yanka kwumvira, nk’uko ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        },
        {
          "text": " yari yabivuze.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.19",
            "verseOrgIds": [
              "EXO.8.19"
            ]
          }
        }
      ]
    },
    {
