              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.5",
            "verseOrgIds": [
              "EXO.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Aroni aramvurira ukuboko hejuru y’amazi ya Egiputa, aca avamwo ibikere vyuzura igihugu cose. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.6",
            "verseOrgIds": [
              "EXO.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ariko abanyamareba baca bakora ibisa nk’ivyo, batuma ibikere biza mu gihugu ca Egiputa.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.7",
            "verseOrgIds": [
              "EXO.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
