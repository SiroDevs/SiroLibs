          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze imibu ikwira mu bantu no mu bitungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.8.18",
            "verseOrgIds": [
              "EXO.8.18"
            ]
          }
        },
