          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko bashika ahitwa Elimu, ahari amariba icumi n’abiri hamwe n’ibigazi mirongo indwi, baca bacumbika aho hafi y’ayo mazi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
