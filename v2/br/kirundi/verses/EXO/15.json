        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze Mose arongora Abisirayeli bava ku Kiyaga Gitukura baja mu bugaragwa bw’i Shuri. Bamara imisi itatu bagenda mu bugaragwa babura amazi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bashitse i Mara, ntibashobora kunywa amazi yaho kuko yarura. Ni co gituma bahita Mara, bisigura ngo “Umururazi”. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maze abantu bidodombera Mose, bavuga bati: “Mbega tunywa iki?”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
            ]
          }
        }
      ]
    },
