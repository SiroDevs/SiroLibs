          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.21",
            "verseOrgIds": [
              "EXO.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nuko Farawo aca atanga itegeko ku bantu bose ati: “Umwana wese azovuka ari umuhungu muze mumuterere mu ruzi Nili, ariko umukobwa muze mumureke abeho.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.22",
            "verseOrgIds": [
              "EXO.1.22"
            ]
          }
        }
      ]
    }
