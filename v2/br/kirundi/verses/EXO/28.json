              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iki kizobe icagezwe kizokwamaho kuri Aroni no ku ruvyaro rwiwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
