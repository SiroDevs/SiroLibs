          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzoshonere Aroni umwambaro usharijwe n’amabara mu gitambara c’inyuzi zera derere, igitambara yambara mu mutwe gikozwe mu nyuzi zera derere, n’igitambara co mw’izosi gikozwe n’abahinga babimenyereye. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.39",
            "verseOrgIds": [
              "EXO.28.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "EXO 28:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzoshoneshereze abahungu ba Aroni imyambaro isharijwe n’amabara n’ibitambara bizunguruka mw’izosi bikagaruka imbere, n’ibitambara vyo kuzingira ku mutwe kugira ngo bibasharize vyongere bibaheshe icubahiro. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.40",
            "verseOrgIds": [
              "EXO.28.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "EXO 28:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niwamara kwambika ivyo vyambarwa mukurwawe Aroni n’abahungu biwe, uzoce ubasiga amavuta, ubarobanure. Uzobeze kugira ngo bankorere igikorwa c’ubuherezi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.41",
            "verseOrgIds": [
              "EXO.28.41"
            ]
          }
        }
