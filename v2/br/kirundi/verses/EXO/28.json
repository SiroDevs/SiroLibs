          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzoshoneshe ikanzu yo kwambarirako efodi mu gitambara kimwe gisa n’ubururu, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.31",
            "verseOrgIds": [
              "EXO.28.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 28:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "bayitoborere hagati na hagati aho Aroni azocisha umutwe. Iyo ntoboro bazoyibaririreko akandi kajishano, kayikikuze kugira ngo ntizohereho itabuka. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.32",
            "verseOrgIds": [
              "EXO.28.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 28:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umusozo wayo wo hepfo bazowutereko udusharizo dusa n’ivyamwa vy’amakomamanga mu nyuzi z’ubururu, izitukura n’izitukura cane; baze bararobekamwo udukengeri tw’inzahabu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.33",
            "verseOrgIds": [
              "EXO.28.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 28:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bazoje barakurakuranya udukengeri n’amakomamanga bikikuje umusozo w’iyo kanzu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.34",
            "verseOrgIds": [
              "EXO.28.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 28:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni azobe ari yo yambara ariko arakora igikorwa c’ubuherezi. Maze udukengeri tuzogenda turavuga uko yinjiye Ahera imbere y’",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        },
        {
          "text": ", n’uko asohotse kugira ngo ntapfe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.35",
            "verseOrgIds": [
              "EXO.28.35"
            ]
          }
        }
      ]
