          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uzosoneshe n’agahuzu ko musi mu gitambara cera, kava mu rukenyerero kagashika ku matako kugira ngo bahishe ubwambure bwabo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.42",
            "verseOrgIds": [
              "EXO.28.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "EXO 28:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aroni n’abahungu biwe azobe ari vyo bazokwambara igihe cose bazoba binjiye mw’Ihema ry’Ibonaniro, canke begereye igicaniro ngo bakorere ibikorwa Ahera, kugira ngo baze baboneke ata gasembwa ntibapfe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.43",
            "verseOrgIds": [
              "EXO.28.43"
            ]
          }
        }
      ]
    },
