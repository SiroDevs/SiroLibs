              "type": "text"
            }
          ]
        },
        {
          "text": "Uzocure agasharizo kabase mu nzahabu itavanze kameze nk’ishurwe, bakandikeko nk’uwandika ku kidodo bati:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.28.36",
