      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:38"
      },
      "items": [
        {
          "text": "pakuti dziko lawo lasanduka chipululu",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:38"
      },
      "items": [
        {
          "text": "chifukwa cha nkhondo ya owazunza",
          "type": "text",
          "attrs": {
