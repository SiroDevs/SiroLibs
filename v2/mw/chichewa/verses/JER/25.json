          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makola awo a nkhosa amene anali pamtendere adzasanduka bwinja",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.37",
            "verseOrgIds": [
              "JER.25.37"
            ]
          }
