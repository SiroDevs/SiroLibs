  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "JER 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Zaka 70 za Ukapolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhula ndi Yeremiya za anthu onse a ku Yuda mʼchaka chachinayi cha ufumu wa Yehoyakimu mwana wa Yosiya mfumu ya ku Yuda, chimene chinali chaka choyamba cha ufumu wa Nebukadinezara mfumu ya ku Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.1",
            "verseOrgIds": [
              "JER.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mneneri Yeremiya anawuza anthu onse a ku Yuda pamodzi ndi onse amene amakhala mu Yerusalemu kuti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.2",
            "verseOrgIds": [
              "JER.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa zaka 23, kuyambira chaka cha 13 cha ufumu wa Yosiya mwana wa Amoni mfumu ya ku Yuda mpaka lero lino, Yehova wakhala akundipatsa mauthenga ake ndipo ine ndakhala ndikuyankhula ndi inu kawirikawiri, koma inu simunamvere.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.3",
            "verseOrgIds": [
              "JER.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ngakhale Yehova kawirikawiri wakhala akukutumizirani atumiki ake onse, aneneri, inuyo simunamvere kapena kutchera khutu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.4",
            "verseOrgIds": [
              "JER.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aneneriwo ankanena kuti, \"Ngati aliyense wa inu abwerere, kusiya njira zake zoyipa ndi machitidwe ake oyipa, ndiye kuti mudzakhala mʼdziko limene Yehova anapereka kwa makolo anu kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.5",
            "verseOrgIds": [
              "JER.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatsatire milungu ina nʼkuyitumikira ndi kuyipembedza. Musapute mkwiyo wanga ndi mafano amene mwapanga ndi manja anu. Mukatero Ine sindidzakuwonongani.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.6",
            "verseOrgIds": [
              "JER.25.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma inu simunandimvere,\" akutero Yehova, \"ndipo munaputa mkwiyo wanga ndi mafano amene munapanga ndi manja anu. Choncho munadziwononga nokha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.7",
            "verseOrgIds": [
              "JER.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Yehova Wamphamvuzonse akuti, \"Chifukwa simunamvere mawu anga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.8",
            "verseOrgIds": [
              "JER.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndidzayitana mafuko onse akumpoto, pamodzi ndi mtumiki wanga Nebukadinezara mfumu ya ku Babuloni,\" akutero Yehova, \"ndipo adzathira nkhondo dziko lino ndi anthu ake pamodzi ndi mitundu yonse ya anthu ozungulira dzikoli. Ndidzawawononga kwathunthu ndi kuwasandutsa chinthu chochititsa mantha ndi chonyozeka, mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.9",
            "verseOrgIds": [
              "JER.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzathetsa mfuwu wachimwemwe ndi wachisangalalo, mawu a mkwati ndi mkwatibwi, phokoso la mphero ndi kuwala kwa nyale.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.10",
            "verseOrgIds": [
              "JER.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko lonse lidzakhala bwinja ndi chipululu, ndipo mitundu ina idzatumikira mfumu ya ku Babuloni kwa 70.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.11",
            "verseOrgIds": [
              "JER.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma zaka 70 zikadzatha, ndidzalanga mfumu ya ku Babuloni pamodzi ndi anthu ake, chifukwa cha zolakwa zawo,\" akutero Yehova, \"ndipo dziko lawo lidzakhala chipululu mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.12",
            "verseOrgIds": [
              "JER.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzachita zinthu zonse zimene ndinayankhula zotsutsa dzikolo, zonse zimene zalembedwa mʼbuku lino, ndiponso zonse zimene Yeremiya analosera zotsutsa anthu amenewa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.13",
            "verseOrgIds": [
              "JER.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo eni adzakhala akapolo a anthu a mitundu yochuluka ndi mafumu amphamvu. Ndidzawabwezera molingana ndi zochita zawo ndi ntchito za manja awo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.14",
            "verseOrgIds": [
              "JER.25.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chikho cha Ukali wa Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova, Mulungu wa Israeli, anandiwuza kuti, \"Tenga chikho ichi chodzaza ndi vinyo wa ukali wanga, ndipo ukamwetse anthu a mitundu yonse kumene ndikukutuma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.15",
            "verseOrgIds": [
              "JER.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akadzamwa adzayamba kudzandira ndi kuchita misala chifukwa cha nkhondo imene ndikuyitumiza pakati pawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.16",
            "verseOrgIds": [
              "JER.25.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ine ndinatenga chikhocho mʼdzanja la Yehova ndipo ndinamwetsa mitundu yonse ya anthu kumene Iye ananditumako:",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.17",
            "verseOrgIds": [
              "JER.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anandituma ku Yerusalemu ndi ku mizinda ya Yuda, kwa mafumu ake ndi nduna zake kuti ndikawasandutse ngati bwinja ndi chinthu chochititsa mantha ndi chonyozeka ndiponso chotembereredwa, monga mmene alili lero lino.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.18",
            "verseOrgIds": [
              "JER.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananditumanso kwa Farao, mfumu ya ku Igupto, kwa atumiki ake, nduna zake ndi kwa anthu ake onse,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.19",
            "verseOrgIds": [
              "JER.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi kwa anthu ena onse a mitundu yachilendo; mafumu onse a ku Uzi; mafumu onse a Afilisti, a ku Asikeloni, ku Gaza, ku Ekroni ndiponso kwa anthu a ku chigwa chotsala cha Asidodi;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.20",
            "verseOrgIds": [
              "JER.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edomu, Mowabu ndi Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.21",
            "verseOrgIds": [
              "JER.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananditumanso kwa mafumu onse a ku Turo ndi ku Sidoni; kwa mafumu a kutsidya la nyanja;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.22",
            "verseOrgIds": [
              "JER.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "ku Dedani, ku Tema, ku Buzi ndi kwa onse ometa chamʼmbali.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.23",
            "verseOrgIds": [
              "JER.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananditumanso kwa mafumu onse a ku Arabiya ndi mafumu onse a anthu achilendo amene amakhala mʼchipululu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.24",
            "verseOrgIds": [
              "JER.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anandituma kwa mafumu onse a ku Zimuri, Elamu ndi Mediya;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.25",
            "verseOrgIds": [
              "JER.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiponso kwa mafumu onse a kumpoto, akufupi ndi kutali omwe, mafumu onse a dziko lapansi. Ndipo potsiriza pake, idzamwenso ndi mfumu Sesaki.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.26",
            "verseOrgIds": [
              "JER.25.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo uwawuze kuti, 'Yehova Wamphamvuzonse, Mulungu wa Israeli akuti: Imwani, ledzerani ndipo musanze, mugwe osadzukanso chifukwa cha nkhondo imene ndikutumiza pakati panu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.27",
            "verseOrgIds": [
              "JER.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati akana kutenga chikhocho mʼdzanja lako ndi kumwa, uwawuze kuti, 'Yehova Wamphamvuzonse akuti: Muyenera kumwa ndithu!' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.28",
            "verseOrgIds": [
              "JER.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, tsopano ndiyamba kulanga mzinda uno umene umadziwika ndi dzina langa. Kodi inu muganiza kuti simudzalangidwa? Ayi, simudzapulumuka chifukwa ndikutumiza nkhondo pa onse okhala pa dziko lapansi, akutero Yehova Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.29",
            "verseOrgIds": [
              "JER.25.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano iwe nenera mawu owatsutsa ndipo uwawuze kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "\" 'Yehova adzabangula kumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "mawu ake adzamveka ngati bingu kuchokera ku malo ake opatulika.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "Adzabangula mwamphamvu kukalipira dziko lake.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "Iye adzafuwula ngati anthu oponda mphesa,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:30"
      },
      "items": [
        {
          "text": "kukalipira onse amene akukhala pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.30",
            "verseOrgIds": [
              "JER.25.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phokoso lalikulu lidzamveka mpaka kumalekezero a dziko lonse lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "chifukwa Yehova adzazenga mlandu anthu a mitundu yonse;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "adzaweruza mtundu wonse wa anthu",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:31"
      },
      "items": [
        {
          "text": "ndipo oyipa adzawapha ndi lupanga,' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.31",
            "verseOrgIds": [
              "JER.25.31"
            ]
          }
        }
      ]
    },
    {
