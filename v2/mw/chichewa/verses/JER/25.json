          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati mkango, Yehova wasiya phanga lake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.38",
            "verseOrgIds": [
              "JER.25.38"
            ]
          }
        }
      ]
