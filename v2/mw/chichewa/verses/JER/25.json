      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:35"
      },
      "items": [
        {
          "text": "atsogoleri a nkhosa adzasowa malo opulumukira.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        }
      ]
    },
