            "number": "33",
            "style": "v",
            "sid": "JER 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku limenelo, onse ophedwa ndi Yehova adzangoti mbwee ponseponse, pa dziko lonse lapansi. Palibe amene adzawalire kapena kusonkhanitsa mitemboyo kuti ikayikidwe mʼmanda, koma idzakhala mbwee ngati ndowe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.33",
            "verseOrgIds": [
              "JER.25.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khetsani misozi ndi kufuwula mwamphamvu, abusa inu;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "gubudukani pa fumbi, inu atsogoleri a nkhosa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "Pakuti nthawi yanu yophedwa yafika;",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 25:34"
      },
      "items": [
        {
          "text": "mudzagwa ndi kuphwanyika ngati mbiya yabwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.34",
            "verseOrgIds": [
              "JER.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abusa adzasowa kothawira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.25.35",
            "verseOrgIds": [
              "JER.25.35"
            ]
          }
        }
      ]
    },
