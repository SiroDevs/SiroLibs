  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "JER 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati munthu asudzula mkazi wake",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "ndipo mkaziyo nʼkuchoka nakakwatiwa ndi mwamuna wina,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "kodi mwamuna woyambayo angathe kumutenganso mkaziyo?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Kodi atatero sindiye kuti dzikolo layipitsidwa kwambiri?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Koma iwe Israeli wachita zadama ndi zibwenzi zambiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "Komabe bwerera kwa ine,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.1",
            "verseOrgIds": [
              "JER.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:1"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tayangʼana ku zitunda zowuma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Kodi aliponso malo ena amene iwe sunachitepo zadama?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Iwe unkakhala mʼmbali mwa njira kumadikira zibwenzi zako,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "ngati Mluya wobisalira anthu mʼchipululu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "Inu mwayipitsa dziko ndi zadama zanu",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:2"
      },
      "items": [
        {
          "text": "ndi ntchito zanu zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.2",
            "verseOrgIds": [
              "JER.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake Yehova wayimitsa mvula,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "ndipo mvula ya nthawi ya masika sinagwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "Komabe uli ndi maonekedwe a mkazi wachiwerewere;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:3"
      },
      "items": [
        {
          "text": "ndipo sukuchita manyazi ndi pangʼono pomwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.3",
            "verseOrgIds": [
              "JER.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi iwe siposachedwa pomwepa pamene wanena",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:4"
      },
      "items": [
        {
          "text": "kuti, 'Abambo anga, Inu bwenzi langa la unyamata wanga,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.4",
            "verseOrgIds": [
              "JER.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi mudzandikwiyira nthawi zonse?",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Kodi ukali wanu udzakhalabe mpaka muyaya?'",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "Umu ndimo mmene umayankhulira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:5"
      },
      "items": [
        {
          "text": "koma umapitirizabe kuchita zoyipa monga momwe umathera.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.5",
            "verseOrgIds": [
              "JER.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kusakhulupirika kwa Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi ya Mfumu Yosiya Yehova anandiwuza kuti, \"Kodi waona zomwe Israeli wosakhulupirika uja wachita? Anakwera pa phiri lililonse lalitali ndi kupita pa tsinde pa mtengo uliwonse wogudira kukapembedza. Choncho anachita za chiwerewere kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.6",
            "verseOrgIds": [
              "JER.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinaganiza kuti atachita zonsezi, adzabwerera kwa Ine, koma sanabwerere, ndipo mlongo wake wosakhulupirika uja, Yuda, anaziona zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.7",
            "verseOrgIds": [
              "JER.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anaona kuti ndinasudzula Israeli wosakhulupirikayo ndi kumupirikitsa chifukwa cha zigololo zake. Komabe Yuda mʼbale wake wosakhulupirika uja sanaope, nayenso anapita kukachita chigololo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.8",
            "verseOrgIds": [
              "JER.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chiwerewere cha Israeli chinali chochititsa manyazi kotero kuti chinayipitsa dziko lonse. Anachita chigololo popembedza mafano a miyala ndi mitengo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.9",
            "verseOrgIds": [
              "JER.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli atachita zonsezi, Yuda mʼbale wake wosakhulupirika uja sanabwerere kwa Ine ndi mtima wake wonse, koma mwachiphamaso chabe,\" akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.10",
            "verseOrgIds": [
              "JER.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiwuza kuti, \"Kusakhulupirika kwa Israeli nʼkochepa kuyerekeza ndi kusakhulupirika kwa Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.11",
            "verseOrgIds": [
              "JER.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pita ukalalikire kumpoto uthenga wakuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "\" 'Israeli wosakhulupirikawe, bwerera,' akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "'Sindidzakukalipira mpaka kalekale,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "pakuti ndine wachifundo,' akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:12"
      },
      "items": [
        {
          "text": "'Sindidzakukwiyira mpaka kalekale.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.12",
            "verseOrgIds": [
              "JER.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungovomera kulakwa kwako",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "kuti unawukira Yehova Mulungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "Vomera kuti unayendayenda kukapembedza milungu yachilendo",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "pansi pa mtengo uliwonse wogudira,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "ndiponso kuti sunandimvere,' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.13",
            "verseOrgIds": [
              "JER.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:13"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Bwererani, ana osakhulupirika, pakuti ndine mbuye wanu,\" akutero Yehova. \"Ndinakusankhani, mmodzimmodzi kuchokera ku mudzi uliwonse ndiponso awiriawiri kuchokera ku banja lililonse.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.14",
            "verseOrgIds": [
              "JER.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndidzakupatsani abusa a pamtima panga amene adzakutsogolerani mwanzeru ndi mwaluntha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.15",
            "verseOrgIds": [
              "JER.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku amenewo mukadzachulukana kwambiri mʼdzikomo, anthu sadzanenanso za 'Bokosi la Chipangano la Yehova' kapena kuliganizira. Sadzalikumbukiranso kapena kulifuna, ndipo sadzapanganso lina,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.16",
            "verseOrgIds": [
              "JER.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:16"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyo adzatcha Yerusalemu Mpando Waufumu wa Yehova, ndipo mitundu yonse ya anthu idzasonkhana mu Yerusalemu pamaso pa Yehova. Sadzawumiriranso kutsata mitima yawo yoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.17",
            "verseOrgIds": [
              "JER.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku amenewo fuko la Yuda lidzaphatikizana ndi fuko la Israeli, onse pamodzi adzachokera ku dziko la kumpoto kupita ku dziko limene ndinapatsa makolo awo, kuti likhale cholowa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.18",
            "verseOrgIds": [
              "JER.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine mwini ndinati,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "\" 'Ndikanakonda bwanji kukukhazikani pakati pa ana anga",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "ndikukupatsani dziko labwino kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "cholowa chokongola kwambiri kuposa cha mitundu ina ya anthu.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "Ndinaganiza kuti mudzanditcha Ine 'Atate'",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:19"
      },
      "items": [
        {
          "text": "ndi kuti simudzaleka kunditsata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.19",
            "verseOrgIds": [
              "JER.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma monga mkazi wosakhulupirika amasiya mwamuna wake,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
              "JER.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:20"
      },
      "items": [
        {
          "text": "momwemonso inu mwakhala osakhulupirika kwa Ine, inu fuko la Israeli,\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.20",
            "verseOrgIds": [
              "JER.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "JER 3:20"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu akumveka pa magomo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:21"
      },
      "items": [
        {
          "text": "Aisraeli akulira ndi kupempha chifundo",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:21"
      },
      "items": [
        {
          "text": "chifukwa anatsata njira zoyipa",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:21"
      },
      "items": [
        {
          "text": "ndi kuyiwala Yehova Mulungu wawo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.21",
            "verseOrgIds": [
              "JER.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mukuti, \"Bwererani, anthu osakhulupirika;",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:22"
      },
      "items": [
        {
          "text": "ndidzachiritsa kubwerera mʼmbuyo kwanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JER 3:22"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:22"
      },
      "items": [
        {
          "text": "\"Inde, tidzabwerera kwa Inu",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:22"
      },
      "items": [
        {
          "text": "pakuti ndinu Yehova Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.22",
            "verseOrgIds": [
              "JER.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu kupembedza pa magomo",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:23"
      },
      "items": [
        {
          "text": "komanso kuchita maphwando pa mapiri zilibe phindu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:23"
      },
      "items": [
        {
          "text": "Zoonadi chipulumutso cha Israeli",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:23"
      },
      "items": [
        {
          "text": "chili mwa Yehova Mulungu wathu basi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.23",
            "verseOrgIds": [
              "JER.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyambira pa ubwana wathu milungu yochititsa manyazi ija yakhala ikutiwonongetsa phindu",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:24"
      },
      "items": [
        {
          "text": "la ntchito za makolo athu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:24"
      },
      "items": [
        {
          "text": "nkhosa ndi ngʼombe zawo,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:24"
      },
      "items": [
        {
          "text": "ana awo aamuna ndi aakazi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.24",
            "verseOrgIds": [
              "JER.3.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tilekeni tigone pansi mwa manyazi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "ndipo kunyozeka kwathu kutiphimbe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "Paja tachimwira Yehova Mulungu wathu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "ife pamodzi ndi makolo athu",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "kuyambira nthawi ya ubwana wathu mpaka lero lino",
          "type": "text",
          "attrs": {
            "verseId": "JER.3.25",
            "verseOrgIds": [
              "JER.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 3:25"
      },
      "items": [
        {
          "text": "sitinamvere Yehova Mulungu wathu.\"",
