  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "GEN 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nowa Atuluka Mʼchombo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "GEN 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mulungu anakumbukira Nowa ndi nyama zonse zakuthengo ndi ziweto zimene anali nazo mu chombo. Yehova anatumiza mphepo pa dziko lapansi ndipo madzi anaphwera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.1",
            "verseOrgIds": [
              "GEN.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "GEN 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono akasupe a madzi ambiri a pansi pa dziko ndi zitseko za madzi a kumwamba zinatsekedwa, ndipo mvula inaleka kugwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.2",
            "verseOrgIds": [
              "GEN.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "GEN 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi amaphwabe pa dziko lapansi. Pakutha pa masiku 150, madzi anatsika,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.3",
            "verseOrgIds": [
              "GEN.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "GEN 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo pa tsiku la 17 la mwezi wachisanu ndi chiwiri, chombo chija chinakakhazikika pa mapiri a Ararati.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.4",
            "verseOrgIds": [
              "GEN.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "GEN 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Madzi anapitirira kuphwa mpaka mwezi wa khumi, ndipo pa tsiku loyamba la mwezi wa khumiwo msonga za mapiri zinayamba kuonekera.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.5",
            "verseOrgIds": [
              "GEN.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "GEN 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita masiku makumi anayi, Nowa anatsekula zenera limene anapanga mʼchombomo",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.6",
            "verseOrgIds": [
              "GEN.8.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "GEN 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "natulutsa khwangwala, koma khwangwalayo ankangowuluka uku ndi uku mpaka madzi anawuma pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.7",
            "verseOrgIds": [
              "GEN.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "GEN 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anatulutsa nkhunda kuti aone ngati madzi aphwa pa dziko.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.8",
            "verseOrgIds": [
              "GEN.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "GEN 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma nkhunda sinapeze poti nʼkutera chifukwa panali madzi ponseponse pa dziko lapansi. Choncho inabwerera kwa Nowa mʼchombo. Nowa anatulutsa dzanja lake kunja ndi kutenga nkhundayo kuyibwezera mʼchombo mmene iye anali.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.9",
            "verseOrgIds": [
              "GEN.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "GEN 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anadikirabe masiku ena asanu ndi awiri ndipo anatulutsanso nkhundayo mʼchombo muja.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.10",
            "verseOrgIds": [
              "GEN.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "GEN 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene nkhunda inabwerera madzulo ake, inali itanyamula tsamba laliwisi la mtengo wa olivi. Motero Nowa anadziwa kuti madzi aphwadi pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.11",
            "verseOrgIds": [
              "GEN.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "GEN 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anadikira masiku ena asanu ndi awiri ndipo anatumizanso nkhunda ija, koma nthawi imeneyi sinabwererenso kwa iye.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.12",
            "verseOrgIds": [
              "GEN.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "GEN 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pofika tsiku loyamba la mwezi woyamba wa chaka chimene Nowa anakwanitsa zaka 601, madzi anawuma pa dziko lapansi. Ndipo Nowa anachotsa denga la chombo ndipo anaona kuti kunja kwawuma.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.13",
            "verseOrgIds": [
              "GEN.8.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "GEN 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pokwana tsiku la 27 la mwezi wachiwiri dziko lapansi linawumiratu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.14",
            "verseOrgIds": [
              "GEN.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "GEN 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mulungu anawuza Nowa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.15",
            "verseOrgIds": [
              "GEN.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe, mkazi wako, ana ako pamodzi ndi akazi awo tulukani mʼchombomo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.16",
            "verseOrgIds": [
              "GEN.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "GEN 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tulutsa zamoyo zonse zili ndi iwe, mbalame, nyama ndi zokwawa zonse kuti ziswane ndi kuchulukana pa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.17",
            "verseOrgIds": [
              "GEN.8.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GEN 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nowa anatuluka pamodzi ndi ana ake aamuna, mkazi wake ndi akazi a ana ake.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.18",
            "verseOrgIds": [
              "GEN.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GEN 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyama zonse, zokwawa zonse, mbalame zonse, chilichonse choyenda pa dziko lapansi, zinatuluka mʼchombo motsogozana monga mwa mitundu yawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.19",
            "verseOrgIds": [
              "GEN.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Nowa anamanga guwa lansembe la Yehova ndipo anatengako mtundu uliwonse wa nyama zoti nʼkudya ndi mbalame zoti nʼkudya naperekapo nsembe yopsereza.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.20",
            "verseOrgIds": [
              "GEN.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova atamva fungo labwino anati mu mtima mwake: \"Sindidzatembereranso nthaka chifukwa cha munthu, ngakhale kuti maganizo a mu mtima mwake ndi oyipa kuyambira ubwana wake. Ndipo sindidzawononganso zolengedwa zonse zamoyo monga ndachitiramu.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.21",
            "verseOrgIds": [
              "GEN.8.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nthawi zonse mmene dziko lapansi lidzakhalire,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "nthawi yodzala ndi nthawi yokolola",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "yozizira ndi yotentha,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "dzinja ndi chilimwe,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "usana ndi usiku,",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "GEN 8:22"
      },
      "items": [
        {
          "text": "sizidzatha.\"",
          "type": "text",
          "attrs": {
            "verseId": "GEN.8.22",
            "verseOrgIds": [
              "GEN.8.22"
            ]
          }
        }
      ]
    }
  ],
