              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abrahamu anadzala mtengo wa bwemba ku Beeriseba, ndipo anapemphera pamenepo mʼdzina la Yehova, Mulungu Wamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.21.33",
