  "verseCount": 43,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "ACT 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutembenuka Mtima kwa Saulo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyi, Saulo ankaopsezabe okhulupirira Ambuye nafuna kuwapha. Iye anapita kwa mkulu wa ansembe,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.1",
            "verseOrgIds": [
              "ACT.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndi kukapempha makalata a chilolezo kuti apite nawo ku masunagoge a ku Damasiko, kuti ngati atakapezeka ena kumeneko otsata Njirayo, kaya ndi amuna kapena amayi, akawamange ndi kuwatenga kubwera nawo ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.2",
            "verseOrgIds": [
              "ACT.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuyandikira ku Damasikoku paulendo wake, mwadzidzidzi kuwala kochokera kumwamba kunamuzungulira iye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.3",
            "verseOrgIds": [
              "ACT.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anagwa pansi ndipo anamva mawu akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.4",
            "verseOrgIds": [
              "ACT.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Saulo, Saulo ukundizunziranji Ine?\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.4",
                "verseOrgIds": [
                  "ACT.9.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo anafunsa kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndinu yani Ambuye?\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.5",
                "verseOrgIds": [
                  "ACT.9.5"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:5"
      },
      "items": [
        {
          "text": "Ambuye anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndine Yesu amene iwe ukumuzunza.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.5",
                "verseOrgIds": [
                  "ACT.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.5",
            "verseOrgIds": [
              "ACT.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tsopano dzuka, lowa mu mzindamo, ndipo udzawuzidwa zoyenera kuchita.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.6",
                "verseOrgIds": [
                  "ACT.9.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu amene anali naye paulendo, anasowa chonena; iwo anamva mawu koma sanaone wina aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.7",
            "verseOrgIds": [
              "ACT.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo anayimirira, ndipo pamene anatsekula maso ake sanathe kuona. Kotero anamugwira dzanja ndi kulowa naye mu Damasiko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.8",
            "verseOrgIds": [
              "ACT.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakhala wosaona kwa masiku atatu ndiponso sanadye kapena kumwa kanthu kalikonse.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.9",
            "verseOrgIds": [
              "ACT.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Damasiko kunali wophunzira wina dzina lake Hananiya. Ambuye anamuyitana mʼmasomphenya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Hananiya!\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.10",
                "verseOrgIds": [
                  "ACT.9.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:10"
      },
      "items": [
        {
          "text": "Iye anayankha kuti, \"Ine Ambuye.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.10",
            "verseOrgIds": [
              "ACT.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye anamuwuza iye kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nyamuka, pita ku nyumba ya Yudasi imene ili pa Njira Yolunjika ndipo ukafunse za munthu wochokera ku Tarisisi dzina lake Saulo, pakuti akupemphera.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.11",
                "verseOrgIds": [
                  "ACT.9.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.11",
            "verseOrgIds": [
              "ACT.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo waona mʼmasomphenya munthu, dzina lake Hananiya atabwera ndi kumusanjika manja kuti aonenso.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.12",
                "verseOrgIds": [
                  "ACT.9.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hananiya anayankha kuti, \"Ambuye, ndinamva zambiri za munthu uyu ndi zonse zoyipa anachitira oyera mtima a ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.13",
            "verseOrgIds": [
              "ACT.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo wabwera kuno ndi ulamuliro wa akulu ansembe kuti adzamange onse amene amayitana pa dzina lanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.14",
            "verseOrgIds": [
              "ACT.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Ambuye anati kwa Hananiya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pita! Munthu uyu ndi chida changa chosankhika chonyamulira dzina langa pamaso pa anthu a mitundu ina ndi mafumu awo ndiponso kwa anthu a Israeli.",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.15",
                "verseOrgIds": [
                  "ACT.9.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.15",
            "verseOrgIds": [
              "ACT.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndidzamuonetsa zowawa zonse zimene ayenera kumva chifukwa cha dzina langa.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.9.16",
                "verseOrgIds": [
                  "ACT.9.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Hananiya ananyamuka ndi kukalowa mʼnyumbayo. Anamusanjika manja Sauloyo ndipo anati, \"Mʼbale Saulo, Ambuye Yesu, amene anakuonekera pa msewu pamene umabwera kuno wandituma kuti uwonenso ndi kudzazidwa ndi Mzimu Woyera.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.17",
            "verseOrgIds": [
              "ACT.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi yomweyo mʼmaso mwa Saulo munachoka zinthu zokhala ngati mamba ansomba, ndipo anayambanso kuona. Iye anayimirira nabatizidwa,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.18",
            "verseOrgIds": [
              "ACT.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo atadya chakudya, anapezanso mphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "ACT 9:19"
      },
      "items": [
        {
          "text": "Saulo Alalikira ku Damasiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 9:19"
      },
      "items": [
        {
          "text": "Saulo anakhala masiku angapo ndi ophunzira a ku Damasiko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.19",
            "verseOrgIds": [
              "ACT.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Posakhalitsa anayamba kulalikira mʼsunagoge kuti Yesu ndiye Mwana wa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.20",
            "verseOrgIds": [
              "ACT.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse amene anamva iye akulalikira anadabwa ndipo anafunsa kuti, \"Kodi uyu si munthu amene anayambitsa kuzunza okhulupirira ku mpingo wa ku Yerusalemu? Kodi siwabwera kuno kuti awamange ndi kuwapereka kwa akulu a ansembe?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.21",
            "verseOrgIds": [
              "ACT.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mphamvu za Saulo zinali kukulirakulira ndipo anathetsa nzeru Ayuda okhala ku Damasiko powatsimikizira kuti Yesu ndi Mpulumutsi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.22",
            "verseOrgIds": [
              "ACT.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita masiku ambiri, Ayuda anapangana zoti aphe Saulo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.23",
            "verseOrgIds": [
              "ACT.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "koma iye anadziwa za chiwembucho. Anthu ankadikirira usana ndi usiku pa zipata za mzindawo kuti amuphe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.24",
            "verseOrgIds": [
              "ACT.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ophunzira ake anamutenga usiku, namutsitsira kunja kwa mpandawo mʼdengu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.25",
            "verseOrgIds": [
              "ACT.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Saulo ku Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo atafika ku Yerusalemu, anayesetsa kulowa mʼgulu la ophunzira koma onse anamuopa chifukwa sanakhulupirire kuti anali wophunziradi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.26",
            "verseOrgIds": [
              "ACT.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Barnaba anamutenga napita naye kwa atumwi. Iye anawafotokozera iwo za mmene Saulo anaonera Ambuye pa njira paja, ndi kuti Ambuye anamuyankhula, ndi momwe analalikira ku Damasiko mʼdzina la Yesu mosaopa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.27",
            "verseOrgIds": [
              "ACT.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Saulo anakhala nawo nayendayenda mwaufulu mu Yerusalemu akulalikira molimba mtima mʼdzina la Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.28",
            "verseOrgIds": [
              "ACT.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anayankhula ndi kutsutsana ndi Ayuda a Chihelene, koma iwo ankafuna kumupha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.29",
            "verseOrgIds": [
              "ACT.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abale atadziwa zimenezi, anamutenga Saulo ndi kupita naye ku Kaisareya, ndipo anamutumiza ku Tarisisi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.30",
            "verseOrgIds": [
              "ACT.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mpingo wa ku Yudeya konse, ku Galileya ndi ku Samariya unakhala pamtendere, unalimbikitsidwa; ndi kupatsidwa mphamvu ndi Mzimu Woyera, unakula mʼchiwerengero, ndi kukhala moopa Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.31",
            "verseOrgIds": [
              "ACT.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eneya ndi Tabita",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Petro amayendera mpingo, anapita kukachezera oyera mtima a ku Luda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.32",
            "verseOrgIds": [
              "ACT.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumeneko anakapeza munthu dzina lake Eneya, wofa ziwalo amene anagona pa mphasa kwa zaka zisanu ndi zitatu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.33",
            "verseOrgIds": [
              "ACT.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro anati kwa iye, \"Eneya, Yesu Khristu akukuchiritsa iwe, dzuka ndipo yalula mphasa yako.\" Nthawi yomweyo Eneya anayimirira.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.34",
            "verseOrgIds": [
              "ACT.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse amene anakhala ku Luda ndi ku Sharoni anamuona ndipo anatembenukira kwa Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.35",
            "verseOrgIds": [
              "ACT.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 9:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Yopa kunali wophunzira wina dzina lake Tabita (mʼChigriki amati Dorika) amene nthawi zonse ankachita zachifundo ndiponso kuthandiza osauka.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.36",
            "verseOrgIds": [
              "ACT.9.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 9:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyi anadwala ndipo anamwalira, anasambitsa thupi lake, namugoneka mʼchipinda chammwamba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.37",
            "verseOrgIds": [
              "ACT.9.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 9:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza ku Yopa kunali pafupi ndi Luda; pamene ophunzira anamva kuti Petro anali ku Luda, anatuma anthu awiri kuti akamudandaulire kuti, \"Chonde bwerani kuno msanga!\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.38",
            "verseOrgIds": [
              "ACT.9.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 9:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro ananyamuka, napita nawo, ndipo atafika anamutengera ku chipinda chammwamba. Amasiye onse anayima momuzungulira akulira ndi kumuonetsa mwinjiro ndi zovala zina zimene Dorika ankapanga akanali moyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.39",
            "verseOrgIds": [
              "ACT.9.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 9:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro anatulutsa anthu onse mʼchipindamo; ndipo anagwada pansi ndi kupemphera. Anatembenukira mtembo uja nati, \"Tabita, dzuka,\" Tabita anatsekula maso ake, ndipo ataona Petro anakhala pansi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.40",
            "verseOrgIds": [
              "ACT.9.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 9:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro anamugwira dzanja, namuyimiritsa. Ndipo anayitana okhulupirira ndi amasiye namupereka wamoyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.41",
            "verseOrgIds": [
              "ACT.9.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 9:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimenezi zinadziwika ku Yopa konse, ndipo anthu ambiri anakhulupirira Ambuye.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.42",
            "verseOrgIds": [
              "ACT.9.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 9:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Petro anakhala ku Yopa kwa masiku ambiri kwa munthu wina, dzina lake Simoni, mmisiri wa zikopa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.9.43",
            "verseOrgIds": [
              "ACT.9.43"
            ]
          }
        }
      ]
    }
  ],
