  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JDG 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita wa ku Giliyadi anali wankhondo wa mphamvu. Iyeyu amayi ake anali mkazi wachiwerewere, ndipo abambo ake anali Giliyadi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.1",
            "verseOrgIds": [
              "JDG.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkazi wake wa Giliyadi anabereka naye ana aamuna. Tsono ana amenewa atakula anapirikitsa Yefita ndi kumuwuza kuti, \"Sudzalandirako cholowa mʼnyumba ya abambo athu chifukwa ndiwe mwana wa mkazi wina.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.2",
            "verseOrgIds": [
              "JDG.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yefita anathawa kuchoka kwa abale ake ndi kukakhala mʼdziko la Tobu. Kumeneko anakakopa ndi kusonkhanitsa anthu achabechabe ndipo anatuluka pamodzi kukasakaza zinthu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.3",
            "verseOrgIds": [
              "JDG.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita nthawi Aamoni anadzachita nkhondo ndi Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.4",
            "verseOrgIds": [
              "JDG.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono pamene Aamoni ankathira nkhondo Aisraeli, akuluakulu a ku Giliyadi anapita kukamutenga Yefita ku dziko la Tobu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.5",
            "verseOrgIds": [
              "JDG.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati kwa iye, \"Bwera ukhale mkulu wathu wankhondo kuti timenyane ndi Amoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.6",
            "verseOrgIds": [
              "JDG.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita anawawuza Agiliyadi kuti, \"Kodi inu suja munkadana nane ndi kundithamangitsa ku nyumba ya abambo anga? Nʼchifukwa chiyani lero mwabwera kwa ine pamene muli pa mavuto?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.7",
            "verseOrgIds": [
              "JDG.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuluakulu a ku Giliyadi aja anamuyankha kuti, \"Chimene tabwerera kwa iwe ndi chakuti upite nafe kukamenyana ndi Aamoni, ndipo udzakhala wolamulira wa onse okhala mu Giliyadi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.8",
            "verseOrgIds": [
              "JDG.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita anawayankha akuluakulu a ku Giliyadi kuti, \"Ngati mundibwezeranso kwathu kuti ndikachite nkhondo ndi Aamoni ndipo Yehova nʼkukandithandiza kuwagonjetsa, ndidzakhaladi wokulamulirani?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.9",
            "verseOrgIds": [
              "JDG.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuluakulu a ku Giliyadi anamuyankha kuti, \"Yehova akhale mboni pakati pa inu ndi ife, ngati sitidzachita monga mwa mawu anu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.10",
            "verseOrgIds": [
              "JDG.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yefita anapita nawo akuluakulu a ku Giliyadi aja, ndipo anthu a kumeneko anamusandutsa kukhala wowalamulira ndi mkulu wankhondo. Tsono Yefita anabwerezanso mawu omwewa pamaso pa Yehova ku Mizipa.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.11",
            "verseOrgIds": [
              "JDG.11.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yefita anatuma amithenga kwa mfumu ya Aamoni ndi funso lakuti, \"Kodi ife takuchimwirani chiyani kuti muzichita nkhondo ndi dziko langa?\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.12",
            "verseOrgIds": [
              "JDG.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfumu ya Aamoni inayankha amithenga a Yefita aja kuti, \"Pamene Israeli amatuluka kuchokera mu Igupto, analanda dziko langa kuyambira ku mtsinje wa Arinoni mpaka ku mtsinje wa Yaboki mpakanso ku mtsinje wa Yorodani. Tsopano mundibwezere dziko langa mwamtendere.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.13",
            "verseOrgIds": [
              "JDG.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita anatumizanso amithenga akewo kwa mfumu ya Aamoni",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.14",
            "verseOrgIds": [
              "JDG.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kukanena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.15",
            "verseOrgIds": [
              "JDG.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "JDG 11:15"
      },
      "items": [
        {
          "text": "Yefita akuti, \"Israeli sanalande dziko la Mowabu kapena dziko la Aamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.15",
            "verseOrgIds": [
              "JDG.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JDG 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene Aisraeli ankachoka ku Igupto anadzera njira ya ku chipululu mpaka ku Nyanja Yofiira nakafika ku Kadesi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.16",
            "verseOrgIds": [
              "JDG.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Israeli anatumiza amithenga kwa mfumu ya ku Edomu kuti, 'Chonde tiloleni kuti tidutse mʼdziko lanu,' Koma mfumu ya ku Edomu sinamvere zimenezo. Aisraeli anatumizanso amithenga kwa mfumu ya ku Mowabu, ndipo iyo inakananso. Choncho Israeli anakhala ku Kadesi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.17",
            "verseOrgIds": [
              "JDG.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pambuyo pake, Aisraeli ananyamuka ulendo kudzera ku chipululu nazungulira dziko la Edomu ndi dziko la Mowabu, ndipo anafika ku mmawa kwa dziko la Mowabu ndi kumanga zinthando zawo ku mbali ina ya mtsinje wa Arinoni. Iwo sanalowe mʼdziko la Mowabu, chifukwa mtsinje wa Arinoni ndiwo unali malire a dziko la Mowabu.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.18",
            "verseOrgIds": [
              "JDG.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JDG 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pambuyo pake Israeli anatumiza amithenga kwa Sihoni mfumu ya Aamori, amene amalamulira ku Hesiboni ndipo anati kwa iye, 'Chonde tiloleni kuti tidutse mʼdziko lanu popita kwathu.'",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.19",
            "verseOrgIds": [
              "JDG.11.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JDG 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Sihoni sanalole Israeli kuti adzere mʼdziko mwake. Mʼmalo mwake Sihoni anasonkhanitsa ankhondo ake onse nakamanga msasa ku Yahazi ndipo anachita nkhondo ndi Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.20",
            "verseOrgIds": [
              "JDG.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JDG 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma Yehova Mulungu wa Israeli anamupereka Sihoni pamodzi ndi anthu ake onse mʼmanja mwa Israeli, ndipo anawagonjetsa. Choncho Aisraeli analanda dziko lonse la Aamori amene amakhala mʼdzikolo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.21",
            "verseOrgIds": [
              "JDG.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JDG 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Analanda dziko lonse kuchokera ku Arinoni mpaka ku Yaboki ndiponso kuchokera ku chipululu mpaka ku mtsinje wa Yorodani.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.22",
            "verseOrgIds": [
              "JDG.11.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JDG 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndiye kuti Yehova Mulungu wa Aisraeli ndiye analanda dziko la Aamori, kuwalandirira anthu ake. Kodi inu mukufuna kutilanda dzikolo?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.23",
            "verseOrgIds": [
              "JDG.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JDG 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanji inu osakhazikika mʼdziko limene Kemosi mulungu wanu anakupatsani, ifenso tikhazikike mʼdziko limene Yehova Mulungu wathu anatipatsa?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.24",
            "verseOrgIds": [
              "JDG.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JDG 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndinu abwino kuposa Balaki mwana wa Zipori, mfumu ya Mowabu? Kodi iye anakanganapo kapena kuchita nkhondo ndi Israeli?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.25",
            "verseOrgIds": [
              "JDG.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JDG 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Aisraeli ankakhala mʼdziko la Hesiboni ndi mʼmidzi yake, mʼdziko la Aroeri ndi midzi yake, komanso mʼmizinda yonse imene ili mʼmbali mwa mtsinje wa Arinoni kwa zaka 300, nʼchifukwa chiyani inu simunalande malowo nthawi imeneyo?",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.26",
            "verseOrgIds": [
              "JDG.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JDG 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ine sindinakuchimwireni. Koma inu mukundilakwira pomenyana nane. Yehova woweruza, ndiye aweruze lero mlandu wa pakati pa Aisraeli ndi Aamoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.27",
            "verseOrgIds": [
              "JDG.11.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JDG 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mfumu ya Aamori, sinasamale mawu amene Yefita anatumiza kwa iyo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.28",
            "verseOrgIds": [
              "JDG.11.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JDG 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mzimu wa Yehova unatsikira pa Yefita. Ndipo iye ananyamuka nadzera ku Giliyadi ndi ku Manase. Anafika ku Mizipa mʼdziko la Giliyadi, ndipo kuchokera kumeneko anapita kukalimbana ndi Aamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.29",
            "verseOrgIds": [
              "JDG.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JDG 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita analumbira kwa Yehova kuti, \"Ngati mupereka Aamoni mʼmanja mwanga,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.30",
            "verseOrgIds": [
              "JDG.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JDG 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "aliyense amene atuluke pa khomo la nyumba yanga kudzandichingamira pobwerera nditagonjetsa Aamoni adzakhala wake wa Yehova, ndipo ndidzamupereka kuti akhale nsembe yopsereza.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.31",
            "verseOrgIds": [
              "JDG.11.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JDG 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yefita anawolokera kwa Aamoni kukamenya nawo nkhondo, ndipo Yehova anawaperekadi mʼmanja mwake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.32",
            "verseOrgIds": [
              "JDG.11.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JDG 11:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawononga mizinda makumi awiri kuchokera ku Ariori mpaka pafupi ndi mzinda wa Miniti. Anapitirira mpaka ku Abeli-Keranimu. Choncho Aisraeli anagonjetsa Aamoni.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.33",
            "verseOrgIds": [
              "JDG.11.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JDG 11:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Yefita anabwerera ku nyumba yake. Tsono anangoona mwana wake wamkazi akutuluka kudzamuchingamira akuyimba ngʼoma ndi kuvina. Uyu anali mwana yekhayo wa Yefita. Analibenso mwana wina wamwamuna kapena wamkazi.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.34",
            "verseOrgIds": [
              "JDG.11.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JDG 11:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita ataona mwana wake uja, anangʼamba zovala zake ndi kulira, \"Kalanga ine! Mwana wanga! Wandivulaza kwambiri ndipo iwe ndi gwero la mavuto anga. Ine ndinalumbira kwa Yehova ndi pakamwa pangapa ndipo sindingathe kubweza malumbiro angawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.35",
            "verseOrgIds": [
              "JDG.11.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JDG 11:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanayo anayankha kuti, \"Abambo, ngati munalonjeza kwa Yehova ndi pakamwa panu, chitani zimene munalonjezera pakuti Yehova wakuthandizani kulipsira adani anu Amowabu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.36",
            "verseOrgIds": [
              "JDG.11.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JDG 11:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatinso kwa abambo ake, \"Ndikupempheni chinthu ichi: Mundilole ndikayendeyende ku mapiri miyezi iwiri ndizikalira pamodzi ndi anzanga chifukwa ndikufa ndikanali namwali wosadziwa mwamuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.37",
            "verseOrgIds": [
              "JDG.11.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JDG 11:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yefita anamuyankha kuti, \"Pita.\" Ndipo anamulola kuti apite miyezi iwiri. Tsono anapita kumapiri ndi atsikana anzake kukalira chifukwa cha unamwali wake.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.38",
            "verseOrgIds": [
              "JDG.11.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JDG 11:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miyezi iwiri itatha iye anabwerera kwa abambo ake, ndipo anachitadi zimene analonjeza.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JDG 11:39"
      },
      "items": [
        {
          "text": "Motero unakhala mwambo wa Aisraeli,",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.39",
            "verseOrgIds": [
              "JDG.11.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JDG 11:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti atsikana a Israeli ankapita chaka chilichonse kukalira maliro a mwana wa mkazi wa Yefita, Mgiliyadi uja masiku makumi anayi pa chaka.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.11.40",
            "verseOrgIds": [
              "JDG.11.40"
            ]
          }
        }
      ]
    }
  ],
