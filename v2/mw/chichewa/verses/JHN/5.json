            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ndi kutuluka. Iwo amene anachita zabwino adzauka ndi kupita ku moyo wosatha ndipo amene anachita zoyipa adzauka ndi kupita ku chilango chamuyaya.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.29",
                "verseOrgIds": [
