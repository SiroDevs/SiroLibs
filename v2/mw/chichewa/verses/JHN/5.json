        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.29",
            "verseOrgIds": [
              "JHN.5.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti sindingathe kuchita kena kalikonse pa ndekha. Ine ndimaweruza molingana ndi zomwe Mulungu wandiwuza ndipo kuweruza kwanga ndi kolungama. Ine sindifuna kudzikondweretsa ndekha koma Iye amene anandituma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.30",
                "verseOrgIds": [
                  "JHN.5.30"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maumboni Onena za Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati ndidzichitira umboni ndekha, umboni wanga si woona.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.31",
                "verseOrgIds": [
                  "JHN.5.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.31",
            "verseOrgIds": [
              "JHN.5.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Alipo wina amene amandichitira umboni wabwino. Ine ndikudziwa kuti umboni wake wonena za Ine ndi woona.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.32",
                "verseOrgIds": [
                  "JHN.5.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inu munatumiza amithenga kwa Yohane ndipo iye anachitira umboni choona.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.33",
                "verseOrgIds": [
                  "JHN.5.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.33",
            "verseOrgIds": [
              "JHN.5.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 5:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sikuti Ine ndikudalira umboni wa munthu; koma ndikunena zimenezi kuti mupulumutsidwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.34",
                "verseOrgIds": [
                  "JHN.5.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.34",
            "verseOrgIds": [
              "JHN.5.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 5:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Yohane anali ngati nyale imene imayaka ndi kuwala, ndipo inu kwa kanthawi munasankha kusangalala ndi kuwala kwakeko.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.35",
                "verseOrgIds": [
                  "JHN.5.35"
                ]
              }
            }
          ]
        }
