          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo wamupatsa Iye ulamuliro woweruza chifukwa ndi Mwana wa Munthu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.27",
                "verseOrgIds": [
                  "JHN.5.27"
                ]
              }
            }
