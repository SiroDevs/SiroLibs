              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma Ine ndili ndi umboni woposa uja wa Yohane. Pakuti ntchito imene Atate andipatsa kuti ndiyikwaniritse ndi imene ndikugwira, ndipo ikundichitira umboni kuti Atate andituma Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.36",
                "verseOrgIds": [
                  "JHN.5.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.36",
            "verseOrgIds": [
              "JHN.5.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 5:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo Atate amene anandituma Ine, Iye mwini wandichitira umboni. Inu simunamvepo mawu ake kapena kuona maonekedwe ake,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.37",
                "verseOrgIds": [
                  "JHN.5.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.37",
            "verseOrgIds": [
              "JHN.5.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 5:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "kapena mawu ake kukhala mwa inu, pakuti simukhulupirira Iye amene anamutuma.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.38",
                "verseOrgIds": [
                  "JHN.5.38"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.38",
            "verseOrgIds": [
              "JHN.5.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 5:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inu mumasanthula malemba chifukwa mumaganiza kuti mʼmalembamo muli moyo wosatha. Awa ndi malemba amene akundichitira umboni.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.39",
                "verseOrgIds": [
                  "JHN.5.39"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.39",
            "verseOrgIds": [
              "JHN.5.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 5:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma inu mukukana kubwera kwa Ine kuti mukhale ndi moyo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.40",
                "verseOrgIds": [
                  "JHN.5.40"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 5:41"
          },
          "items": [
