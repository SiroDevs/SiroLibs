          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Musadabwe ndi zimenezi. Pakuti nthawi ikubwera pamene onse amene ali mʼmanda adzamva mawu ake",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.28",
                "verseOrgIds": [
                  "JHN.5.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.28",
            "verseOrgIds": [
              "JHN.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 5:29"
          },
          "items": [
            {
              "text": "29",
