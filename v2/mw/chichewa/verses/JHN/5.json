              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine sindilandira ulemu kuchokera kwa anthu",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.41",
                "verseOrgIds": [
                  "JHN.5.41"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.41",
            "verseOrgIds": [
              "JHN.5.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 5:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma Ine ndikukudziwani. Ndikudziwa kuti mʼmitima mwanu mulibe chikondi cha Mulungu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.42",
                "verseOrgIds": [
                  "JHN.5.42"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.42",
            "verseOrgIds": [
              "JHN.5.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 5:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndabwera mʼdzina la Atate anga, ndipo inu simukundirandira Ine; koma wina wake akabwera mʼdzina la iye mwini, inu mudzamulandira.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.43",
                "verseOrgIds": [
                  "JHN.5.43"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.43",
            "verseOrgIds": [
              "JHN.5.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 5:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi inu mudzakhulupirira bwanji ngati mumapatsana ulemu wina ndi mnzake, ndipo simufuna kulandira ulemu kuchokera kwa Mulungu yekhayo?",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.44",
                "verseOrgIds": [
                  "JHN.5.44"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 5:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma inu musaganize kuti Ine ndidzakunenezani kwa Atate. Wokunenezani ndi Mose, amene inu mwayikapo chiyembekezo chanu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.45",
                "verseOrgIds": [
                  "JHN.5.45"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.45",
            "verseOrgIds": [
              "JHN.5.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 5:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati mukanakhulupirira Mose, mukanakhulupiriranso Ine, pakuti iye analemba za Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.5.46",
                "verseOrgIds": [
                  "JHN.5.46"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.5.46",
            "verseOrgIds": [
              "JHN.5.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 5:47"
          },
          "items": [
            {
