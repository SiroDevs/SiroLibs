  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "JHN 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Atonthoza Ophunzira Ake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mtima wanu usavutike. Khulupirirani Mulungu; khulupirirani Inenso.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.1",
                "verseOrgIds": [
                  "JHN.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.1",
            "verseOrgIds": [
              "JHN.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mʼnyumba mwa Atate anga muli zipinda zambiri. Kukanakhala kuti mulibemo ndikanakuwuzani. Ine ndikupita kumeneko kukakukonzerani malo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.2",
                "verseOrgIds": [
                  "JHN.14.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.2",
            "verseOrgIds": [
              "JHN.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo ndikapita kukakukonzerani malo, ndidzabweranso kudzakutengani, kuti kumene kuli Ineko, inunso mukakhale komweko.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.3",
                "verseOrgIds": [
                  "JHN.14.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.3",
            "verseOrgIds": [
              "JHN.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inu mukudziwa njira ya kumene Ine ndikupita.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.4",
                "verseOrgIds": [
                  "JHN.14.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Njira ya kwa Atate",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tomasi anati kwa Iye, \"Ambuye ife sitikudziwa kumene Inu mukupita, nanga tingadziwe bwanji njirayo?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.5",
            "verseOrgIds": [
              "JHN.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndine njira, choonadi ndi moyo. Palibe munthu angafike kwa Atate popanda kudzera mwa Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.6",
                "verseOrgIds": [
                  "JHN.14.6"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.6",
            "verseOrgIds": [
              "JHN.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mukanandidziwadi Ine, mukanadziwanso Atate anga. Kuyambira tsopano, mukuwadziwa ndipo mwawaona.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.7",
                "verseOrgIds": [
                  "JHN.14.7"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Filipo anati, \"Ambuye, tionetseni Atatewo ndipo ife tikhutitsidwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.8",
            "verseOrgIds": [
              "JHN.14.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi iwe Filipo, ndakhala pakati panu nthawi yonseyi ndipo iwe sukundidziwabe? Aliyense amene waona Ine, waonanso Atate. Tsono ukunena bwanji kuti, 'Tionetseni Atate?'",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.9",
                "verseOrgIds": [
                  "JHN.14.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.9",
            "verseOrgIds": [
              "JHN.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi sukukhulupirira kuti Ine ndili mwa Atate, ndipo Atate ali mwa Ine? Mawu amene Ine ndiyankhula kwa inu si mawu anga okha koma ndi mawu Atate wokhala mwa Ine, amene akugwira ntchito yake.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.10",
                "verseOrgIds": [
                  "JHN.14.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.10",
            "verseOrgIds": [
              "JHN.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Khulupirirani Ine pamene ndi kuti Ine ndili mwa Atate ndipo Atate ali mwa Ine. Koma ngati si chomwecho, khulupiriranitu Ine chifukwa cha ntchito zanga zodabwitsa.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.11",
                "verseOrgIds": [
                  "JHN.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.11",
            "verseOrgIds": [
              "JHN.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zoonadi, Ine ndikukuwuzani kuti aliyense amene akhulupirira Ine adzachita zimene Ine ndakhala ndikuchita. Iye adzachita ngakhale zinthu zazikulu kuposa zimenezi, chifukwa ndikupita kwa Atate.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.12",
                "verseOrgIds": [
                  "JHN.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.12",
            "verseOrgIds": [
              "JHN.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo Ine ndidzachita chilichonse chimene inu mudzapempha mʼdzina langa kuti Atate alemekezedwe mwa Mwana.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.13",
                "verseOrgIds": [
                  "JHN.14.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.13",
            "verseOrgIds": [
              "JHN.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngati mudzapempha kanthu kalikonse mʼdzina langa, Ine ndidzachita.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.14",
                "verseOrgIds": [
                  "JHN.14.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lonjezo la Mzimu Woyera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati mundikonda Ine, sungani malamulo anga.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.15",
                "verseOrgIds": [
                  "JHN.14.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.15",
            "verseOrgIds": [
              "JHN.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndidzapempha Atate, ndipo adzakupatsani Nkhoswe ina kuti izikhala nanu nthawi zonse.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.16",
                "verseOrgIds": [
                  "JHN.14.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.16",
            "verseOrgIds": [
              "JHN.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nkhosweyo ndiye Mzimu wachoonadi. Dziko lapansi silingalandire Nkhosweyi chifukwa samuona kapena kumudziwa. Koma inu mumamudziwa pakuti amakhala nanu ndipo adzakhala mwa inu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.17",
                "verseOrgIds": [
                  "JHN.14.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.17",
            "verseOrgIds": [
              "JHN.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine sindikusiyani nokha kuti mukhale ana amasiye. Ine ndidzabweranso kwa inu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.18",
                "verseOrgIds": [
                  "JHN.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.18",
            "verseOrgIds": [
              "JHN.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Patsala nthawi yochepa dziko lapansi silidzandionanso koma inu mudzandiona. Popeza kuti Ine ndili ndi moyo, inunso mudzakhala ndi moyo.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.19",
                "verseOrgIds": [
                  "JHN.14.19"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.19",
            "verseOrgIds": [
              "JHN.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Tsiku limenelo inu mudzazindikira kuti Ine ndili mwa Atate, ndipo inu muli mwa Ine, ndipo Ine ndili mwa inu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.20",
                "verseOrgIds": [
                  "JHN.14.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.20",
            "verseOrgIds": [
              "JHN.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye amene amadziwa malamulo anga ndi kuwasunga ndiye amene amandikonda. Wokonda Ine adzakondedwa ndi Atate wanga ndipo Inenso ndidzamukonda ndikudzionetsa ndekha kwa iye.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.21",
                "verseOrgIds": [
                  "JHN.14.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yudasi (osati Yudasi Isikarioti) anati, \"Koma Ambuye, nʼchifukwa chiyani mukufuna kudzionetsa nokha kwa ife, osati ku dziko lapansi?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.22",
            "verseOrgIds": [
              "JHN.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anamuyankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ngati wina aliyense andikonda Ine, adzasunga mawu anga. Atate wanga adzamukonda, ndipo Ife tidzabwera ndi kukhala naye.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.23",
                "verseOrgIds": [
                  "JHN.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.23",
            "verseOrgIds": [
              "JHN.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye amene sandikonda Ine sasunga mawu anga. Mawu awa amene mukumva si anga ndi a Atate amene anandituma Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.24",
                "verseOrgIds": [
                  "JHN.14.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ndayankhula zonsezi ndikanali nanu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.25",
                "verseOrgIds": [
                  "JHN.14.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.25",
            "verseOrgIds": [
              "JHN.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma Nkhosweyo, Mzimu Woyera, amene Atate adzamutumiza mʼdzina langa adzakuphunzitsani zinthu zonse, ndipo adzakukumbutsani zonse zimene ndinakuwuzani.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.26",
                "verseOrgIds": [
                  "JHN.14.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.26",
            "verseOrgIds": [
              "JHN.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndikukusiyirani mtendere. Ndikukupatsani mtendere wanga. Ine sindikukupatsani monga dziko lapansi limaperekera. Mtima wanu usavutike ndipo musachite mantha.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.27",
                "verseOrgIds": [
                  "JHN.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Inu munamva Ine ndikunena kuti, 'Ine ndikupita ndipo ndidzabweranso kwa inu.' Mukanandikonda, mukanasangalala kuti Ine ndikupita kwa Atate, pakuti Atate ndi wamkulu kuposa Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.28",
                "verseOrgIds": [
                  "JHN.14.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.28",
            "verseOrgIds": [
              "JHN.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndakuwuzani tsopano zisanachitike, kuti zikadzachitika mudzakhulupirire.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.29",
                "verseOrgIds": [
                  "JHN.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.29",
            "verseOrgIds": [
              "JHN.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine sindiyankhulanso nanu zambiri nthawi yayitali popeza wolamulira dziko lapansi akubwera. Iye alibe mphamvu pa Ine,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.30",
                "verseOrgIds": [
                  "JHN.14.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.14.30",
            "verseOrgIds": [
              "JHN.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma kuti dziko lapansi lizindikire kuti Ine ndimakonda Atate ndi kuti ndimachita zokhazokha zimene Atate wandilamulira Ine.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.31",
                "verseOrgIds": [
                  "JHN.14.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 14:31"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nyamukani; tizipita.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.14.31",
                "verseOrgIds": [
                  "JHN.14.31"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
