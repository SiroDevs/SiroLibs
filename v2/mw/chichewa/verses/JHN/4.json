  "verseCount": 54,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "JHN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Acheza ndi Mayi wa ku Samariya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JHN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu atazindikira kuti Afarisi amva zoti Iye ankapeza ndi kubatiza ophunzira ambiri kupambana Yohane,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.1",
            "verseOrgIds": [
              "JHN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JHN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "(ngakhale kuti Yesuyo sankabatiza, koma ophunzira ake).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.2",
            "verseOrgIds": [
              "JHN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JHN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachoka ku Yudeya ndi kubwereranso ku Galileya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.3",
            "verseOrgIds": [
              "JHN.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JHN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Iye anayenera kudutsa mu Samariya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.4",
            "verseOrgIds": [
              "JHN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JHN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anafika mʼmudzi wa Asamariya wotchedwa Sukari, pafupi ndi malo amene Yakobo anapatsa mwana wake Yosefe.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.5",
            "verseOrgIds": [
              "JHN.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JHN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitsime cha Yakobo chinali pamenepo ndipo Yesu atatopa ndi ulendo anakhala pansi pambali pa chitsimecho. Nthawi inali pafupifupi ora lachisanu ndi chimodzi masana.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.6",
            "verseOrgIds": [
              "JHN.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JHN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayi wa Chisamariya atabwera kudzatunga madzi, Yesu anati kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.7",
            "verseOrgIds": [
              "JHN.4.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi ungandipatse madzi akumwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.7",
                "verseOrgIds": [
                  "JHN.4.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.7",
            "verseOrgIds": [
              "JHN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JHN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ophunzira ake nʼkuti atapita mʼmudzi kukagula chakudya).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.8",
            "verseOrgIds": [
              "JHN.4.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JHN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anati kwa Iye, \"Inu ndinu Myuda ndipo ine ndine Msamariya. Bwanji mukundipempha madzi akumwa?\" (Popeza Ayuda ndi Asamariya sankayanjana).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.9",
            "verseOrgIds": [
              "JHN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JHN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anamuyankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.10",
            "verseOrgIds": [
              "JHN.4.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Koma iwe ukanadziwa mphatso ya Mulungu ndi Iye amene akukupempha madzi akumwa, ukanamupempha ndipo akanakupatsa madzi amoyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.10",
                "verseOrgIds": [
                  "JHN.4.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JHN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anati, \"Ambuye, Inu mulibe kanthu kotungira madzi ndipo chitsime ndi chakuya. Kodi madzi amoyowo mungawatenge kuti?",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.11",
            "verseOrgIds": [
              "JHN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JHN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Inu ndinu wamkulu kuposa kholo lathu Yakobo, amene anatipatsa chitsimechi ndipo iye ankamwanso monga anachita ana ake ndi ziweto zake?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.12",
            "verseOrgIds": [
              "JHN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JHN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.13",
            "verseOrgIds": [
              "JHN.4.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Aliyense amene amamwa madzi awa amamvanso ludzu,",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.13",
                "verseOrgIds": [
                  "JHN.4.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.13",
            "verseOrgIds": [
              "JHN.4.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JHN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma aliyense amene adzamwa madzi amene Ine ndidzamupatsa sadzamvanso ludzu. Ndithudi, madzi amene ndidzamupatsa adzakhala kasupe wamadzi wotumphukira ku moyo wosatha.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.14",
                "verseOrgIds": [
                  "JHN.4.14"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JHN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anati kwa Iye, \"Ambuye, patseni madzi amenewo kuti ndisadzamvenso ludzu ndi kumabwerabe kuno kudzatunga madzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.15",
            "verseOrgIds": [
              "JHN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JHN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anamuwuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.16",
            "verseOrgIds": [
              "JHN.4.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pita kayitane mwamuna wako ndipo ubwere naye.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.16",
                "verseOrgIds": [
                  "JHN.4.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JHN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Ine ndilibe mwamuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 4:17"
      },
      "items": [
        {
          "text": "Yesu anati kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wakhoza ponena kuti ulibe mwamuna.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.17",
                "verseOrgIds": [
                  "JHN.4.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.17",
            "verseOrgIds": [
              "JHN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JHN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zoona nʼzakuti iwe wakhala pa banja ndi amuna asanu, ndipo mwamuna amene uli naye tsopano si wako. Zimene wanenazi ndi zoona.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.18",
                "verseOrgIds": [
                  "JHN.4.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JHN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anati, \"Ambuye, ine ndazindikira kuti Inu ndinu mneneri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.19",
            "verseOrgIds": [
              "JHN.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JHN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makolo athu ankapembedza mʼphiri ili koma inu Ayuda mumati malo amene tiyenera kupembedzera ali ku Yerusalemu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.20",
            "verseOrgIds": [
              "JHN.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JHN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.21",
            "verseOrgIds": [
              "JHN.4.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mayi inu khulupirira Ine. Nthawi ikubwera pamene inu simudzapembedza Atate mʼphiri ili kapena mu Yerusalemu.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.21",
                "verseOrgIds": [
                  "JHN.4.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.21",
            "verseOrgIds": [
              "JHN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JHN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inu Asamariya mumapembedza chimene simukuchidziwa. Ife timapembedza chimene tikuchidziwa, pakuti chipulumutso nʼchochokera kwa Ayuda.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.22",
                "verseOrgIds": [
                  "JHN.4.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.22",
            "verseOrgIds": [
              "JHN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JHN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma nthawi ikubwera ndipo yafika kale tsopano pamene opembedza woona adzapembedza Atate mu mzimu ndi mʼchoonadi, pakuti opembedza otere ndiwo amene Atate akuwafuna.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.23",
                "verseOrgIds": [
                  "JHN.4.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.23",
            "verseOrgIds": [
              "JHN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JHN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mulungu ndi Mzimu, ndipo omupembedza Iye ayenera kumupembedza mu mzimu ndi mʼchoonadi.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.24",
                "verseOrgIds": [
                  "JHN.4.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JHN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo anati, \"Ine ndikudziwa kuti Mesiya (wotchedwa Khristu) akubwera. Akabwera, Iye adzafotokoza zonse kwa ife.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.25",
            "verseOrgIds": [
              "JHN.4.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JHN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu anamuwuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.26",
            "verseOrgIds": [
              "JHN.4.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amene ndikukuyankhulane, ndine amene.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.26",
                "verseOrgIds": [
                  "JHN.4.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ophunzira Abweranso kwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JHN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi yomweyo ophunzira ake anabwerera ndipo anadabwa kupeza Iye akuyankhula ndi mayi. Koma palibe amene anamufunsa kuti, \"Kodi mukufuna chiyani?\" kapena, \"Nʼchifukwa chiyani mukuyankhula naye?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.27",
            "verseOrgIds": [
              "JHN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JHN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mayiyo anasiya mtsuko wamadzi, nabwerera ku mzinda ndipo anati kwa anthu,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.28",
            "verseOrgIds": [
              "JHN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JHN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tiyeni mukaone munthu amene wandiwuza ine zilizonse zimene ndinazichita. Kodi ameneyu sangakhale Khristu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.29",
            "verseOrgIds": [
              "JHN.4.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JHN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anatuluka mʼmudziwo ndi kupita kumene kunali Iye.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.30",
            "verseOrgIds": [
              "JHN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JHN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyi ndi kuti ophunzira ake akumukakamiza kuti, \"Rabi idyani.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.31",
            "verseOrgIds": [
              "JHN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JHN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Iye anawawuza kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.32",
            "verseOrgIds": [
              "JHN.4.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndili ndi chakudya choti ndidye chimene inu simukuchidziwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.32",
                "verseOrgIds": [
                  "JHN.4.32"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JHN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ophunzira ake anafunsana wina ndi mnzake kuti, \"Kodi alipo wina amene anamubweretsera Iye chakudya?\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.33",
            "verseOrgIds": [
              "JHN.4.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JHN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Chakudya changa ndikuchita chifuniro cha Iye amene anandituma Ine ndi kumaliza ntchito yake.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.34",
                "verseOrgIds": [
                  "JHN.4.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.34",
            "verseOrgIds": [
              "JHN.4.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JHN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kodi inu simunena kuti, 'Kwatsala miyezi inayi ndipo kenaka kukolola?' Ine ndikukuwuzani kuti, tsekulani maso anu ndipo muyangʼane mʼminda! Mbewu zacha kale kuti zikololedwe.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.35",
                "verseOrgIds": [
                  "JHN.4.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.35",
            "verseOrgIds": [
              "JHN.4.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JHN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ngakhale tsopano amene akukolola akulandira malipiro ake, ndipo akututa mbewu ku moyo wosatha kuti wofesa ndi wokolola asangalale pamodzi.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.36",
                "verseOrgIds": [
                  "JHN.4.36"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.36",
            "verseOrgIds": [
              "JHN.4.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JHN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼchifukwa chake mawu akuti, 'Wina amafesa ndipo wina amakolola' ndi woona.",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.37",
                "verseOrgIds": [
                  "JHN.4.37"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.37",
            "verseOrgIds": [
              "JHN.4.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JHN 4:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ine ndinakutumani kukakolola zimene simunagwirire ntchito. Ena anagwira ntchito yolemetsa ndipo inu mwatuta phindu la ntchito yawo.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.38",
                "verseOrgIds": [
                  "JHN.4.38"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asamariya Ambiri Akhulupirira",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JHN 4:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asamariya ambiri ochokera mʼmudziwo anakhulupirira Iye chifukwa cha umboni wa mayiyo wakuti, \"Iye anandiwuza ine zonse ndinazichita.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.39",
            "verseOrgIds": [
              "JHN.4.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JHN 4:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Asamariya atabwera kwa Iye, anamuwumiriza Iye kuti akhale nawo, ndipo Iye anakhala nawo masiku awiri.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.40",
            "verseOrgIds": [
              "JHN.4.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JHN 4:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo chifukwa cha mawu ake, ena ambiri anakhulupirira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.41",
            "verseOrgIds": [
              "JHN.4.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JHN 4:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anati kwa mayiyo, \"Ife sitikukhulupirira chifukwa cha mawu ako okha, koma tsopano ife tadzimvera tokha, ndipo tikudziwa kuti munthu uyu ndithu ndi Mpulumutsi wa dziko lapansi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.42",
            "verseOrgIds": [
              "JHN.4.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu Achiritsa Mwana wa Nduna ya Mfumu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JHN 4:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patatha masiku awiri Iye anachoka napita ku Galileya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.43",
            "verseOrgIds": [
              "JHN.4.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JHN 4:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Tsopano Yesu mwini ananena kale kuti mneneri salandira ulemu mʼdziko lake).",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.44",
            "verseOrgIds": [
              "JHN.4.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JHN 4:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye atafika ku Galileya, Agalileya anamulandira. Iwo anali ataona zonse zimene anazichita mu Yerusalemu pa phwando la Paska, pakuti iwonso anali komweko.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.45",
            "verseOrgIds": [
              "JHN.4.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JHN 4:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakafikanso ku Kana wa ku Galileya, kumene anasanduliza madzi kukhala vinyo. Ndipo kumeneko kunali nduna ina ya mfumu imene mwana wake wamwamuna anali chigonere akudwala ku Kaperenawo.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.46",
            "verseOrgIds": [
              "JHN.4.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JHN 4:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu uyu atamva kuti Yesu wafika ku Galileya kuchokera ku Yudeya, anapita kwa Iye, namupempha kuti apite akachiritse mwana wakeyo, amene anali pafupi kufa.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.47",
            "verseOrgIds": [
              "JHN.4.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JHN 4:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anawawuza iwo kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.48",
            "verseOrgIds": [
              "JHN.4.48"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Anthu inu pokhapokha mutaona zizindikiro zodabwitsa, simudzakhulupirira.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.48",
                "verseOrgIds": [
                  "JHN.4.48"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JHN 4:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nduna ya mfumuyo inati, \"Ambuye tiyeni mwana wanga asanafe.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.49",
            "verseOrgIds": [
              "JHN.4.49"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JHN 4:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.50",
            "verseOrgIds": [
              "JHN.4.50"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Pita. Mwana wako adzakhala ndi moyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.50",
                "verseOrgIds": [
                  "JHN.4.50"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JHN 4:50"
      },
      "items": [
        {
          "text": "Munthuyo anakhulupirira mawu a Yesu ndipo ananyamuka.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.50",
            "verseOrgIds": [
              "JHN.4.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JHN 4:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ali pa njira, antchito ake anakumana naye, namuwuza kuti mwana wanu uja wachira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.51",
            "verseOrgIds": [
              "JHN.4.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JHN 4:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye atafunsa kuti ndi nthawi yanji imene mwana wake anapeza bwino, iwo anati kwa iye, \"Malungo anamusiya iye dzulo pa ora lachisanu ndi chiwiri.\"",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.52",
            "verseOrgIds": [
              "JHN.4.52"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JHN 4:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo bamboyo anazindikira kuti iyi inali nthawi yomweyo imene Yesu anati kwa iye,",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.53",
            "verseOrgIds": [
              "JHN.4.53"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Mwana wako adzakhala ndi moyo.\"",
              "type": "text",
              "attrs": {
                "verseId": "JHN.4.53",
                "verseOrgIds": [
                  "JHN.4.53"
                ]
              }
            }
          ]
        },
        {
          "text": "Choncho iye ndi onse a pa banja lake anakhulupirira.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.53",
            "verseOrgIds": [
              "JHN.4.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JHN 4:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ichi ndiye chinali chizindikiro chodabwitsa chachiwiri chimene Yesu anachita atafika ku Galileya kuchokera ku Yudeya.",
          "type": "text",
          "attrs": {
            "verseId": "JHN.4.54",
            "verseOrgIds": [
              "JHN.4.54"
            ]
          }
        }
      ]
