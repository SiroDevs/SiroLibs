              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaziya anali ndi zaka 22 pamene anakhala mfumu ndipo analamulira mu Yerusalemu chaka chimodzi. Amayi ake anali Ataliya, chidzukulu cha Omiri mfumu ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.26",
            "verseOrgIds": [
              "2KI.8.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 8:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatsatira makhalidwe a banja la Ahabu ndipo anachita zoyipa pamaso pa Yehova, monga linachitira banja la Ahabu, pakuti anali mkamwini wa banja la Ahabu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.27",
            "verseOrgIds": [
              "2KI.8.27"
            ]
          }
        }
      ]
    },
