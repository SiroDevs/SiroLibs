  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "2KI 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mayi wa ku Sunemu Atenganso Munda wake",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Elisa anawuza mayi amene anamuukitsira mwana wake kuti, \"Choka kuno pamodzi ndi banja lako ndipo ukakhale kulikonse ukufuna, chifukwa Yehova akubweretsa njala ya zaka zisanu ndi ziwiri mʼdziko muno.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.1",
            "verseOrgIds": [
              "2KI.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayiyo ananyamuka nachita zimene munthu wa Mulungu ananena. Iye pamodzi ndi banja lake anachoka nakakhala ku dziko la Afilisti zaka zisanu ndi ziwiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.2",
            "verseOrgIds": [
              "2KI.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitatha zaka zisanu ndi ziwirizo anabwera kuchokera ku dziko la Afilisti ndipo anapita kwa mfumu kukafunsa za nyumba yake ndi munda wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.3",
            "verseOrgIds": [
              "2KI.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mfumu inkayankhula ndi Gehazi, mtumiki wa munthu wa Mulungu kuti, \"Tandiwuza zinthu zikuluzikulu zimene Elisa wachita.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.4",
            "verseOrgIds": [
              "2KI.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Gehazi ankayiwuza mfumuyo momwe Elisa anaukitsira anthu akufa, mayi amene mwana wake Elisa anamuukitsa kwa akufayo analowa kudzafunsa mfumu za nyumba yake ndi munda wake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:5"
      },
      "items": [
        {
          "text": "Gehazi anati, \"Mbuye wanga mfumu, mayi wake ndi uyu ndipo mwana wakeyo ndi uyu amene Elisa anamuukitsa kwa akufa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.5",
            "verseOrgIds": [
              "2KI.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inafunsa mayiyo za nkhaniyi ndipo iye anayifotokozera mfumuyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:6"
      },
      "items": [
        {
          "text": "Ndipo mfumu inasankha munthu woti ayendetse nkhani yake ndipo inati, \"Mubwezereni zonse zimene zinali zake, kuphatikizapo phindu lonse lochokera mʼmunda wake, kuyambira tsiku limene anachoka mpaka tsopano lino.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.6",
            "verseOrgIds": [
              "2KI.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hazaeli Apha Beni-Hadadi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anapita ku Damasiko, ndipo Beni-Hadadi mfumu ya ku Aramu ankadwala. Mfumuyo itawuzidwa kuti, \"Munthu wa Mulungu wabwera kuno kuchokera kutali,\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.7",
            "verseOrgIds": [
              "2KI.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "inawuza Hazaeli kuti, \"Tenga mphatso ndipo pita ukakumane ndi munthu wa Mulungu. Ukandifunsire kwa Yehova kudzera mwa iye kuti, 'Kodi ndidzachira matenda angawa?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.8",
            "verseOrgIds": [
              "2KI.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Hazaeli anapita kukakumana ndi Elisa, atasenzetsa ngamira 40 mphatso za zinthu zosiyanasiyana zabwino kwambiri za ku Damasiko. Iye analowa mʼnyumba ya Elisa ndi kuyima pamaso pake, ndipo anati, \"Mwana wanu Beni-Hadadi wandituma kuti ndidzakufunseni kuti, 'Kodi ndidzachira matenda angawa?' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.9",
            "verseOrgIds": [
              "2KI.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anayankha kuti, \"Pita ndipo ukamuwuze kuti, 'Udzachira ndithu,' koma Yehova wandionetsa kuti adzafabe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.10",
            "verseOrgIds": [
              "2KI.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisa anamuyangʼana kwambiri Hazaeli mpaka anachita manyazi. Pamenepo munthu wa Mulungu anayamba kulira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.11",
            "verseOrgIds": [
              "2KI.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazaeli anafunsa kuti, \"Mbuye wanga mukulira chifukwa chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:12"
      },
      "items": [
        {
          "text": "Elisa anayankha kuti, \"Chifukwa ndikudziwa choyipa chimene udzachitira Aisraeli. Udzatentha mizinda yawo ya chitetezo, udzapha anyamata awo ndi lupanga, udzaphwanyitsa pansi makanda awo ndiponso udzatumbula mimba za akazi awo oyembekezera.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.12",
            "verseOrgIds": [
              "2KI.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Hazaeli anati, \"Kodi kapolo wanune, amene ndine wonyozeka ngati galu, ndingathe bwanji kuchita chinthu chachikulu chotere?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 8:13"
      },
      "items": [
        {
          "text": "Elisa anayankha kuti, \"Yehova wandionetsa kuti iwe udzakhala mfumu ya ku Aramu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.13",
            "verseOrgIds": [
              "2KI.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Hazaeli anasiyana ndi Elisa ndi kubwerera kwa mbuye wake. Beni-Hadadi atafunsa kuti, \"Elisa wakuwuza chiyani?\" Hazaeli anayankha kuti, \"Elisa wandiwuza kuti inu mudzachira ndithu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.14",
            "verseOrgIds": [
              "2KI.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mmawa mwake Hazaeli anatenga nsalu yokhuthala ndi kuyiviyika mʼmadzi ndipo anaphimba nayo nkhope ya mfumu, kotero mfumuyo inafa. Hazaeli analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.15",
            "verseOrgIds": [
              "2KI.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoramu Mfumu ya ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chaka chachisanu cha ufumu wa Yoramu mwana wa Ahabu mfumu ya ku Israeli, Yehosafati ali mfumu ya ku Yuda, Yehoramu mwana wake anakhala mfumu ya Ayuda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.16",
            "verseOrgIds": [
              "2KI.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoramu analowa ufumu ali ndi zaka 32, ndipo analamulira mu Yerusalemu zaka zisanu ndi zitatu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.17",
            "verseOrgIds": [
              "2KI.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatsatira khalidwe la mafumu a ku Israeli, monga mmene linachitira banja la Ahabu, popeza iye anakwatira mwana wa Ahabu. Yehoramu anachita zoyipa pamaso pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.18",
            "verseOrgIds": [
              "2KI.8.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 8:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe, chifukwa cha mtumiki wake Davide, Yehova sanafune kuwononga Yuda popeza Yehova analonjeza Davide kuti adzamupatsa nyale pamodzi ndi zidzukulu zake mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.19",
            "verseOrgIds": [
              "2KI.8.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 8:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi ya Yehoramu, Edomu anawukira ulamuliro wa Yuda ndipo anadzisankhira mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.20",
            "verseOrgIds": [
              "2KI.8.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 8:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehoramu anapita ku Zairi pamodzi ndi magaleta ake onse. Ndipo iye anakantha Aedomu amene anamuzungulira pamodzi ndi oyendetsa magaleta ake usiku. Koma ankhondo ake anathawa napita ku misasa yawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.21",
            "verseOrgIds": [
              "2KI.8.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 8:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaka lero lino Edomu ndi wowukira Yuda. Nthawi yomweyo mzinda wa Libina unawukiranso.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.22",
            "verseOrgIds": [
              "2KI.8.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 8:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ntchito zina za Yehoramu ndi zonse zomwe anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.23",
            "verseOrgIds": [
              "2KI.8.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 8:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehoramu anamwalira ndipo anayikidwa mʼmanda pamodzi ndi makolo ake mu Mzinda wa Davide. Ndipo Ahaziya mwana wake analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.24",
            "verseOrgIds": [
              "2KI.8.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahaziya Mfumu ya ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 8:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha khumi ndi chiwiri cha Yoramu mwana wa Ahabu mfumu ya Israeli, Ahaziya mwana wa Yehoramu mfumu ya Yuda anayamba kulamulira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.25",
            "verseOrgIds": [
              "2KI.8.25"
            ]
          }
