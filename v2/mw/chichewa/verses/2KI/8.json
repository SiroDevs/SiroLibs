          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahaziya anapita pamodzi ndi Yoramu mwana wa Ahabu kukachita nkhondo ndi Hazaeli mfumu ya Aramu ku Ramoti Giliyadi. Aaramu anavulaza Yoramu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.28",
            "verseOrgIds": [
              "2KI.8.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 8:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mfumu Yoramu inabwerera ku Yezireeli kuti ikachire mabala ake amene Aaramu anamuvulaza ku Rama pa nkhondo yake ndi Hazaeli mfumu ya Aramu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.8.29",
            "verseOrgIds": [
              "2KI.8.29"
            ]
          }
        }
      ]
