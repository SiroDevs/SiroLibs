          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Senakeribu mfumu ya ku Asiriya anapasula misasa ndi kuchoka. Anabwerera ku Ninive nakakhala kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
