      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2KI 19:29"
      },
      "items": [
        {
          "text": "\"Chaka chino mudzadya tirigu wamphulumukwa,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        }
      ]
    },
