      "attrs": {
        "style": "q2",
        "vid": "2KI 19:29"
      },
      "items": [
        {
          "text": "ndipo chaka chamawa mudzadya tirigu wongodzimerera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        }
      ]
    },
