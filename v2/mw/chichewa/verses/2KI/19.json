              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma iwe Hezekiya, chizindikiro chako chidzakhala ichi:",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        }
