      "attrs": {
        "style": "q2",
        "vid": "2KI 19:32"
      },
      "items": [
        {
          "text": "kapena kuponyamo muvi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
