  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "2KI 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hoseya Mfumu Yotsiriza ya Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka cha 12 cha Ahazi mfumu ya Yuda, Hoseya mwana wa Ela anakhala mfumu ya Israeli mu Samariya ndipo analamulira zaka zisanu ndi zinayi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.1",
            "verseOrgIds": [
              "2KI.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova, koma osafanana ndi mafumu a Israeli amene ankalamulira iye asanalowe ufumuwo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.2",
            "verseOrgIds": [
              "2KI.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salimenezeri mfumu ya ku Asiriya anabwera kudzathira nkhondo Hoseya amene anali pansi pa ulamuliro wake ndipo ankapereka msonkho kwa iyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.3",
            "verseOrgIds": [
              "2KI.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mfumu ya ku Asiriya inazindikira kuti Hoseya akuwukira, pakuti Hoseyayo anali atatumiza nthumwi kwa So mfumu ya Igupto ndiponso analeka kukhoma msonkho kwa mfumu ya ku Asiriya, monga ankachitira chaka ndi chaka. Choncho Salimenezeri anagwira Hoseya ndi kumuyika mʼndende.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.4",
            "verseOrgIds": [
              "2KI.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ya ku Asiriya inapita kukathira nkhondo dziko lonse la Israeli ndipo inapita mpaka ku Samariya ndipo inazinga mzindawo kwa zaka zitatu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.5",
            "verseOrgIds": [
              "2KI.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka chachisanu ndi chinayi cha Hoseya, mfumu ya ku Asiriya inalanda Samariya ndipo inatenga Aisraeli ndi kupita nawo ku Asiriya. Anakawakhazika ku Hala ndi Habori mʼmbali mwa mtsinje wa Gozani ndi mʼmizinda ya Amedi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.6",
            "verseOrgIds": [
              "2KI.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Israeli Apita ku Ukapolo chifukwa cha Tchimo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zonsezi zinachitika chifukwa Aisraeli anachimwira Yehova Mulungu wawo, amene anawatulutsa mʼdziko la Igupto pansi pa ulamuliro wa Farao mfumu ya Igupto. Iwo ankapembedza milungu ina,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.7",
            "verseOrgIds": [
              "2KI.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiponso ankatsatira miyambo ya anthu a mitundu imene Yehova anayichotsa pamene iwo ankafika mʼdzikomo pamodzinso ndi miyambo yonse imene mafumu a Israeli anayambitsa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.8",
            "verseOrgIds": [
              "2KI.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Aisraeli ankachita zoyipa mwamseri kutsutsana ndi Yehova Mulungu wawo. Kuchokera ku nsanja ya alonda mpaka ku mzinda wotetezedwa, mʼmizinda yawo yonse anamangamo malo opembedzeramo mafano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.9",
            "verseOrgIds": [
              "2KI.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anayimika miyala ya chipembedzo ndi mitengo ya mafano a Asera pa phiri lililonse lalitali ndi pansi pa mtengo uliwonse wa masamba ambiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.10",
            "verseOrgIds": [
              "2KI.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa malo aliwonse opembedzera mafano, anthuwa ankafukiza lubani monga momwe ankachitira anthu a mitundu imene Yehova anayichotsa pamene iwo ankafika. Iwo anachita zinthu zoyipa zomwe zinaputa mkwiyo wa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.11",
            "verseOrgIds": [
              "2KI.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iwowo ankapembedza mafano ngakhale Yehova ananena kuti, \"Musadzachite zimenezi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.12",
            "verseOrgIds": [
              "2KI.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anachenjeza Israeli ndi Yuda kudzera mwa aneneri ake onse ndi alosi kuti, \"Lekani mchitidwe wanu woyipawo. Mverani malamulo anga ndi malangizo anga potsatira zonse zolembedwa mʼmalamulo a Mose, zimene ndinalamulira makolo anu kuti azimvere, kudzera mwa aneneri, atumiki anga.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.13",
            "verseOrgIds": [
              "2KI.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthuwa sanamvere ndipo anawumitsa khosi ngati momwe analili makolo awo, amene sanadalire Yehova Mulungu wawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.14",
            "verseOrgIds": [
              "2KI.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakana malangizo ake ndi pangano anachita ndi makolo awo ndipo ananyoza zochenjeza za Yehova. Iwo anatsatira mafano achabechabe nasanduka achabechabe. Anthuwa anatsanzira mitundu ya anthu owazungulira ngakhale kuti Yehova anawalamula kuti, \"Musamachite zomwe iwo amachita,\" koma iwo anachita zomwe Yehova anawaletsa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.15",
            "verseOrgIds": [
              "2KI.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowo anasiya malamulo onse a Yehova Mulungu wawo, nadzipangira mafano awiri osungunula a ana angʼombe ndiponso fano la Asera, napembedza zonse zamlengalenga ndi kutumikira Baala.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.16",
            "verseOrgIds": [
              "2KI.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anadutsitsa mʼmoto ana awo aamuna ndi aakazi. Iwo ankawombeza mawula, namachitanso zanyanga ndipo anadzipereka kuchita zoyipa pamaso pa Yehova namukwiyitsa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.17",
            "verseOrgIds": [
              "2KI.17.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehova anakwiya nawo kwambiri Aisraeli ndipo anawachotsa pamaso pake. Palibe amene anatsala kupatula fuko la Yuda lokha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.18",
            "verseOrgIds": [
              "2KI.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda nayenso sanasunge malamulo a Yehova Mulungu wawo. Iwo ankatsatira machitidwe amene Israeli anayambitsa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.19",
            "verseOrgIds": [
              "2KI.17.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero Yehova anakana Aisraeli onse. Iye anawazunza nawapereka mʼmanja mwa anthu ofunkha mpaka Iye atawachotseratu pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.20",
            "verseOrgIds": [
              "2KI.17.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova atangʼamba Israeli kumuchotsa ku nyumba ya Davide, Aisraeliwo anasankha Yeroboamu mwana wa Nebati kukhala mfumu yawo. Yeroboamu ananyengerera Aisraeli kuti asatsatire Yehova ndipo anawachimwitsa tchimo lalikulu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.21",
            "verseOrgIds": [
              "2KI.17.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisraeli anakakamira machimo onse amene Yeroboamu anachita ndipo sanawasiye",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.22",
            "verseOrgIds": [
              "2KI.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpaka pamene Yehova anawachotsa pamaso pake monga anawachenjezera kudzera mwa atumiki ake onse, aneneri. Choncho Aisraeli anachotsedwa mʼdziko lawo kupita ku ukapolo ku Asiriya ndipo ali komweko mpaka lero lino.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.23",
            "verseOrgIds": [
              "2KI.17.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Anthu Achilendo Akhala mu Samariya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ya ku Asiriya inabweretsa anthu a ku Babuloni, Kuta, Awa, Hamati ndi a ku Sefaravaimu kudzawakhazika mʼmizinda ya Samariya kulowa mʼmalo mwa Aisraeli. Iwo anatenga Samariya ndi kukhala mʼmizinda yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.24",
            "verseOrgIds": [
              "2KI.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo atayamba kukhala kumeneko, sanapembedze Yehova choncho Yehova anatumiza mikango pakati pawo ndipo inapha ena mwa iwo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.25",
            "verseOrgIds": [
              "2KI.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono mfumu ya ku Asiriya inawuzidwa za nkhaniyi kuti, \"Anthu amene munawatumiza ndi kuwakhazika mʼmizinda ya Samariya sakudziwa chimene Mulungu wa dzikolo amafuna. Choncho Iye watumiza mikango pakati pawo imene ikuwapha chifukwa anthuwo sadziwa chimene Mulungu wa dzikolo amafuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.26",
            "verseOrgIds": [
              "2KI.17.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono mfumu ya ku Asiriya inalamula kuti, \"Tengani wansembe mmodzi mwa amene munawagwira ukapolo, mupite naye kumeneko ndipo akakhale komweko nakaphunzitse anthu zimene Mulungu wa dzikolo amafuna.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.27",
            "verseOrgIds": [
              "2KI.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mmodzi mwa ansembe amene anawatenga ku Samariya anabwera kudzakhala ku Beteli ndipo ankaphunzitsa anthuwo kupembedza Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.28",
            "verseOrgIds": [
              "2KI.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mtundu uliwonse wa anthu unkapangabe mafano a milungu yawoyawo mʼmizinda yambiri imene anthuwo ankakhala, ndipo anayika milunguyo mʼnyumba za milungu zimene anthu a ku Samariya anamanga ku malo opembedzera mafano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.29",
            "verseOrgIds": [
              "2KI.17.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Babuloni anapanga Sukoti-Benoti, anthu a ku Kuti anapanga Nerigali, ndipo anthu a ku Hamati anapanga Asima;",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.30",
            "verseOrgIds": [
              "2KI.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aava anapanga Nibihazi ndi Taritaki, ndipo Asefaravaimu ankawotcha ana awo pa moto ngati nsembe kwa Adirameleki ndi Anameleki, milungu ya Asefaravaimu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.31",
            "verseOrgIds": [
              "2KI.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo ankapembedza Yehova, koma ankadzisankhira okha pakati pawo anthu wamba kuti akhale ansembe awo ku nyumba za milungu za ku malo opembedzera mafano.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.32",
            "verseOrgIds": [
              "2KI.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowo ankapembedza Yehova, komanso ankatumikira milungu yawo molingana ndi miyambo ya mitundu ya kumene ankachokera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.33",
            "verseOrgIds": [
              "2KI.17.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaka lero lino iwo akupitirizabe kuchita zimene ankachita poyamba. Sapembedza Yehova kapenanso kutsata malangizo ake ndi malamulo ake, chiphunzitso chake monga mwa malamulo amene Yehova anawapereka kwa zidzukulu za Yakobo, amene anamutcha Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.34",
            "verseOrgIds": [
              "2KI.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Yehova anachita pangano ndi Aisraeli, Iye anawalamula kuti, \"Musapembedze milungu ina kapena kuyigwadira iyo, kuyitumikira kapena kupereka nsembe kwa iyoyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.35",
            "verseOrgIds": [
              "2KI.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova amene anakutulutsani mʼdziko la Igupto ndi dzanja lake lamphamvu ndiye amene muyenera kumupembedza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.36",
            "verseOrgIds": [
              "2KI.17.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Muyenera kusamalitsa nthawi zonse kusunga malangizo anga ndi malemba anga, chiphunzitso ndi malamulo amene anakulemberani. Musapembedze milungu ina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.37",
            "verseOrgIds": [
              "2KI.17.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2KI 17:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musayiwale pangano limene ndinapangana nanu ndipo musamapembedze milungu ina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.38",
            "verseOrgIds": [
              "2KI.17.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2KI 17:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmalo mwake muzipembedza Yehova Mulungu wanu pakuti ndiye amene adzakulanditsani mʼdzanja la adani anu onse.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.39",
            "verseOrgIds": [
              "2KI.17.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2KI 17:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe iwo sanamvere ndipo anapitiriza kuchita zomwe ankachita kale.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.40",
            "verseOrgIds": [
              "2KI.17.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2KI 17:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale anthuwo ankapembedza Yehova, ankatumikiranso mafano awo. Mpaka lero lino ana awo ndi zidzukulu zawo zikupitiriza kuchita zomwe ankachita makolo awo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.17.41",
            "verseOrgIds": [
              "2KI.17.41"
            ]
          }
        }
      ]
    }
  ],
