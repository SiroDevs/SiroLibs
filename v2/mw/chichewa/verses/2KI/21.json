        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase anakhala mfumu ali ndi zaka khumi ndi ziwiri ndipo analamulira mu Yerusalemu zaka 55. Amayi ake anali Hefiziba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.1",
            "verseOrgIds": [
              "2KI.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova, potsatira mchitidwe wonyansa wa mitundu imene Yehova anayipirikitsa pofika Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.2",
            "verseOrgIds": [
              "2KI.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyetu anamanganso malo opembedzera mafano amene Hezekiya abambo ake anawawononga. Anamangira Baala maguwa a nsembe ndi mtengo wa fano la Asera monga anachitira Ahabu mfumu ya Israeli ndipo ankapembedza zolengedwa zonse zamlengalenga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.3",
            "verseOrgIds": [
              "2KI.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anamanga maguwa ansembewa mʼNyumba ya Yehova, mʼmene Yehova ananena kuti, \"Mu Yerusalemu ndidzayikamo Dzina langa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.4",
            "verseOrgIds": [
              "2KI.21.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmabwalo onse awiri a Nyumba ya Yehova, Manase anamangamo maguwa opembedzerapo zinthu zamlengalenga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.5",
            "verseOrgIds": [
              "2KI.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anapsereza mwana wake pa moto ngati nsembe, ankachita za matsenga, ankawombeza mawula, ankapita kwa woyankhula ndi mizimu ya anthu akufa ndiponso ankapembedza mizimu. Iyeyo anachita zoyipa zambiri pamaso pa Yehova ndipo anakwiyitsa Yehovayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.6",
            "verseOrgIds": [
              "2KI.21.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anatenga fano losema la Asera limene analipanga ndi kuliyika mʼNyumba ya Yehova, Nyumba imene Yehova ananena kwa Davide ndi mwana wake Solomoni kuti, \"Mʼnyumba iyi ndi mu Yerusalemu ndiwo malo amene ndasankha pakati pa mafuko onse a Aisraeli kuyikamo Dzina langa kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.7",
            "verseOrgIds": [
              "2KI.21.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sindidzalola kuti Aisraeli achotsedwe mʼdziko lawo limene ndinapatsa makolo awo ngati iwowo adzasamala kuchita zinthu zonse zimene ndinawalamula ndi kusunga malamulo onse amene mtumiki wanga Mose anawapatsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.8",
            "verseOrgIds": [
              "2KI.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthu sanamvere. Manase anawasocheretsa, kotero kuti anachita zoyipa zambiri kupambana anthu a mitundu ina amene Yehova anawawononga pamene Aisraeli ankafika.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.9",
            "verseOrgIds": [
              "2KI.21.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhula kudzera mwa atumiki ake, aneneri kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.10",
            "verseOrgIds": [
              "2KI.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Manase mfumu ya Yuda wachita machimo onyansawa ndipo wachita zoyipa kupambana Aamori amene analipo kale iye asanabadwe ndi kuchimwitsa anthu a ku Yuda ndi mafano ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.11",
            "verseOrgIds": [
              "2KI.21.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehova Mulungu wa Israeli akuti, 'Taonani, ndikubweretsa pa Yerusalemu ndi Yuda mavuto akuti aliyense amene adzawamve adzathedwa nzeru.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.12",
            "verseOrgIds": [
              "2KI.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzalanga Yerusalemu ndi Yuda pogwiritsa ntchito muyeso umene ndinalangira Samariya ndi Ahabu pamodzi ndi nyumba yake. Ndidzayeretsa Yerusalemu monga mmene munthu amachitira popukuta mbale ndipo atayipukuta amayivundikira pansi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.13",
            "verseOrgIds": [
              "2KI.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzawataya anthu otsala amene ndi cholowa changa ndipo ndidzawapereka mʼmanja mwa adani awo. Adzachotsedwa ndipo adaniwo adzawalanda zinthu zonse",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.14",
            "verseOrgIds": [
              "2KI.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "chifukwa anachita zoyipa pamaso panga ndipo akhala akundikwiyitsa kuchokera tsiku limene makolo awo anatuluka mu Igupto mpaka lero lino.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.15",
            "verseOrgIds": [
              "2KI.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwonjezera apo, Manase anakhetsa kwambiri magazi a anthu osalakwa mpaka magaziwo kuyenderera mu Yerusalemu kuyambira mbali ina mpaka mbali ina, kuphatikiza pa kuchimwitsa Yuda, kotero kuti anthu anachita zoyipa pamaso pa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.16",
            "verseOrgIds": [
              "2KI.21.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Manase ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.17",
            "verseOrgIds": [
              "2KI.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase anagona ndi makolo ake ndipo anayikidwa mʼmanda mʼmunda wa Uza, ku nyumba yaufumu. Ndipo Amoni mwana wake analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.18",
            "verseOrgIds": [
              "2KI.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amoni Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni anakhala mfumu ali ndi zaka 22 ndipo analamulira mu Yerusalemu zaka ziwiri. Amayi ake anali Mesulemeti mwana wa Haruzi, wochokera ku Yotiba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.19",
            "verseOrgIds": [
              "2KI.21.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 21:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova monga anachitira Manase abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.20",
            "verseOrgIds": [
              "2KI.21.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 21:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anatsatira makhalidwe onse a abambo ake. Ankapembedza mafano amene abambo akewo ankawapembedza ndipo ankawagwadira.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.21",
            "verseOrgIds": [
              "2KI.21.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 21:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo anasiya Yehova Mulungu wa makolo ake ndipo sanayende mʼnjira ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.22",
            "verseOrgIds": [
              "2KI.21.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 21:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nduna za Amoni zinamuchita chiwembu ndipo zinamupha mʼnyumba yake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.23",
            "verseOrgIds": [
              "2KI.21.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 21:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthu a mʼdzikomo anapha onse amene anachitira chiwembu Mfumu Amoni, nayika Yosiya mwana wake kukhala mfumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.24",
            "verseOrgIds": [
              "2KI.21.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Amoni ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.25",
            "verseOrgIds": [
              "2KI.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayikidwa mʼmanda ake mʼmunda wa Uza. Ndipo Yosiya mwana wake analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.21.26",
            "verseOrgIds": [
              "2KI.21.26"
            ]
          }
        }
      ]
    }
  ],
