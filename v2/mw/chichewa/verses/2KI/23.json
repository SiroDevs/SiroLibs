  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2KI 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosiya Akonzanso Pangano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mfumu inayitanitsa akuluakulu onse a ku Yuda ndi Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumuyo inapita ku Nyumba ya Yehova pamodzi ndi anthu onse a ku Yuda, ndi onse okhala mu Yerusalemu, ansembe ndi aneneri, ndiponso anthu ena onse kuyambira wamngʼono mpaka wamkulu. Mfumuyo inawerenga mawu onse a mʼBuku la Chipangano limene linapezeka mʼNyumba ya Yehova, anthu onse akumva.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inayimirira pambali pa chipilala ndi kuchita pangano pamaso pa Yehova kuti idzatsatira Yehova ndi kusunga malamulo, mawu ndi malangizo ake ndi mtima wonse ndi moyo wonse, kukwaniritsa mawu a mʼpanganoli, olembedwa mʼbukuli. Pamenepo anthu onse anadzipereka kutsatira panganoli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inalamula wansembe wamkulu Hilikiya, ansembe othandizana naye ndi alonda a pa khomo kuti achotse mʼNyumba ya Yehova ziwiya zonse zopembedzera Baala ndi Asera ndiponso mafano a zinthu zamlengalenga. Yosiya anazitentha kunja kwa Yerusalemu, ku minda ya ku Chigwa cha Kidroni ndipo phulusa lake anapita nalo ku Beteli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachotsa ansembe a mafano amene anayikidwa ndi mafumu a Yuda kuti azifukiza lubani ku malo opembedzera mafano a ku mizinda ya ku Yuda ndi kumalo ozungulira Yerusalemu, amene ankafukiza lubani kwa Baala, dzuwa, mwezi, nyenyezi ndi zinthu zonse zamlengalenga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachotsa fano la Asera mʼNyumba ya Yehova napita nalo kunja kwa Yerusalemu, ku Chigwa cha Kidroni, nalitentha kumeneko. Anapera fanolo ndi kukataya phulusa lake pa manda a anthu wamba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anagwetsanso tinyumba ta ochita zachiwerewere, timene tinali mʼNyumba ya Yehova, kumene akazi ankalukirako mikanjo yovala popembedza Asera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya anabweretsanso ansembe onse kuchokera mʼmizinda ya Yuda, nawononga malo opembedzera mafano, kuyambira ku Geba mpaka ku Beeriseba, kumene ansembe ankafukizako lubani. Anagwetsa nyumba za milungu zimene zinali pa chipata cha Yoswa, bwanamkubwa wa mzindawo, kumanzere kwa chipata cha mzinda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale kuti ansembe a ku malo opembedzera mafanowo sanawalole kuti atumikire pa guwa lansembe la Yehova mu Yerusalemu, koma ankadya buledi wopanda yisiti pamodzi ndi ansembe anzawo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Yosiya anawononganso Tofeti, amene anali ku Chigwa cha Hinomu, kuti wina aliyense asagwiritse ntchito malowo popereka mwana wake wamwamuna kapena wamkazi pa moto kwa Moleki.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachotsa pa chipata cholowera ku Nyumba ya Yehova akavalo amene mafumu a Yuda anawapereka ngati nsembe kwa dzuwa. Akavalo anali pafupi ndi bwalo la chipinda cha mkulu wina wotchedwa Natani-Meleki. Ndipo Yosiya anatentha magaleta opembedzera dzuwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anagwetsa maguwa amene mafumu a Yuda anawamanga pa denga pafupi ndi chipinda chapamwamba cha Ahazi, ndiponso maguwa amene Manase anamanga mʼmabwalo awiri a Nyumba ya Yehova. Yosiya anawachotsa kumeneko nawaphwanya ndi kutaya zidutswa zake mʼChigwa cha Kidroni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumuyo inawononga malo opembedzera mafano amene ali kummawa kwa Yerusalemu cha kumpoto kwa Phiri la Chiwonongeko. Maguwawa Solomoni mfumu ya Israeli inamangira Asitoreti, fano lalikazi lonyansa la Asidoni, Kemosi, fano lonyansa la Amowabu, ndi Moleki, fano lonyansa la anthu a ku Amoni.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya anaphwanya miyala ya chipembedzo ndiponso anadula mitengo ya fano la Asera ndipo anakwirira malowo ndi mafupa a anthu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhalenso guwa lansembe la ku Beteli, malo opembedzera mafano amene anapanga Yeroboamu mwana wa Nebati, amene anachimwitsa Israeli, Yosiya anawononga guwalo ndi malo opembedzera mafanowo. Iye anatentha malo opembedzera mafanowo ndi kuwapera ndipo anatenthanso fano la Asera.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yosiya anayangʼanayangʼana ndipo ataona manda amene anali pomwepo, mʼmbali mwa phiri, analamula kuti afukule mandawo ndi kutulutsa mafupa kuti awatenthe paguwapo kuti alidetse, potsatira mawu a Yehova amene munthu wa Mulungu analoseratu za zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inafunsa kuti, \"Kodi chizindikiro cha manda chimene ndikuwaonawo ndi chayani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 23:17"
      },
      "items": [
        {
          "text": "Anthu a mu mzindamo anayankha kuti, \"Ndi chizindikiro cha manda a munthu wa Mulungu wochokera ku Yuda amene ananeneratu zimene inu mwalichita guwa lansembe la Beteli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumuyo inati, \"Alekeni manda amenewo, munthu asachotse mafupa ake.\" Choncho anawasiya mafupa akewo pamodzi ndi mafupa a mneneri wa ku Samariya uja.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga momwe Yosiya anachitira ku Beteli, anachotsa ndi kuwononga nyumba za milungu zonse ndi malo opembedzera mafano amene mafumu anamanga mʼmizinda ya ku Samariya omwe anakwiyitsa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya anapha ansembe onse amene ankatumikira ku malo opembedzera mafano, anawaphera pa maguwa awo ndi kutentha mafupa awo. Kenaka iye anapita ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inalamula anthu onse kuti, \"Chitani Chikondwerero cha Paska kulemekeza Yehova Mulungu wanu, motsatira zomwe zalembedwa mʼBuku la Chipangano.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paska yotere inali isanachitikepo kuyambira nthawi ya oweruza amene anatsogolera Israeli, kapenanso nthawi yonse ya mafumu a Yuda sipanachitikenso Paska ngati imeneyo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mʼchaka cha 18 cha Mfumu Yosiya, Paska imeneyi anachitira Yehova mu Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwonjezera apa, Yosiya anachotsa anthu a mawula, woyankhula ndi mizimu ya anthu akufa, milungu ya mʼnyumba, mafano ndiponso zinthu zonse zonyansa zopezeka mu Yuda ndi Yerusalemu. Iye anachita izi pokwaniritsa lamulo lolembedwa mʼbuku limene Hilikiya analipeza mʼNyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiyayo asanalowe ufumu, ngakhale atamwalira, panalibenso mfumu ina yofanana naye imene inatembenukira kwa Yehova monga anachitira, ndi mtima wake wonse, ndi moyo wake wonse, ndi mphamvu zake zonse, motsatira Malamulo onse a Mose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe Yehova sanachotse mkwiyo wake woopsa, umene anali nawo pa Yuda chifukwa cha zonse zimene anachita Manase poputa mkwiyo wa Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yehova anati, \"Ndidzawachotsanso anthu a ku Yuda pamaso panga monga ndinachotsera anthu a ku Israeli ndipo ndidzawukana mzinda wa Yerusalemu, mzinda umene ndinawusankha, pamodzi ndi Nyumba ino imene ndinati, 'Dzina langa lidzakhala mʼmenemo.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito zina za Yosiya ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya akanali mfumu, Farao wotchedwa Neko, mfumu ya Igupto, anapita ku Mtsinje wa Yufurate kukathandiza mfumu ya ku Asiriya. Mfumu Yosiya anapita kukachita naye nkhondo, koma Neko anakumana naye ndi kumupha ku Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumiki a Yosiyayo ananyamula mtembo wake mu galeta kuchokera ku Megido mpaka ku Yerusalemu ndipo anamuyika mʼmanda akeake. Ndipo anthu a mʼdzikomo anatenga Yehowahazi mwana wa Yosiya namudzoza, ndipo iye analowa ufumu mʼmalo mwa abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehowahazi Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehowahazi anakhala mfumu ali ndi 23 ndipo analamulira mu Yerusalemu miyezi itatu. Amayi ake anali Hamutali, mwana wa Yeremiya wa ku Libina.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova monga momwe anachitira makolo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao Neko anamuyika mʼndende ku Ribula mʼdziko la Hamati kuti asalamulirenso mu Yerusalemu. Farao analamula Yuda kuti azikhoma msonkho wa siliva wolemera makilogalamu 3,400, ndiponso golide wolemera makilogalamu 34.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Farao Neko anayika Eliyakimu mwana wa Yosiya kuti akhale mfumu mʼmalo mwa abambo ake Yosiya, ndipo anasintha dzina lake kukhala Yehoyakimu. Koma iye anatenga Yehowahazi kupita naye ku Igupto ndipo anakafera kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakimu anapereka kwa Farao Neko siliva ndi golide amene anamufuna uja. Koma kuti iye apereke zimenezi, amankhometsa msonkho mʼdziko mwakemo ndipo amalandira siliva ndi golide kuchokera kwa anthu a mʼdzikomo molingana ndi chuma cha munthu aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoyakimu Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 23:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoyakimu anali wa zaka 25 pamene anakhala mfumu ndipo analamulira mu Yerusalemu zaka 11. Amayi ake anali Zebuda, mwana wa Pedaya wa ku Ruma.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.36",
            "verseOrgIds": [
              "2KI.23.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 23:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zoyipa pamaso pa Yehova monga momwe anachitira makolo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.37",
            "verseOrgIds": [
              "2KI.23.37"
            ]
          }
        }
      ]
    }
  ],
