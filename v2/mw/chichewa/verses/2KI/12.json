  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "2KI 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yowasi Akonzanso Nyumba ya Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka chachisanu ndi chiwiri cha Yehu, Yowasi anakhala mfumu, ndipo analamulira mu Yerusalemu zaka makumi anayi. Amayi ake anali Zibiya wa ku Beeriseba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.1",
            "verseOrgIds": [
              "2KI.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowasi anachita zolungama pamaso pa Yehova masiku onse amene wansembe Yehoyada ankamulangiza.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.2",
            "verseOrgIds": [
              "2KI.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe sanachotse malo opembedzerapo mafano ndipo anthu anapitiriza kupereka nsembe ndi kufukiza lubani ku malo opembedzerako mafanowo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.3",
            "verseOrgIds": [
              "2KI.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowasi anati kwa ansembe, \"Tolerani ndalama zonse zimene zimaperekedwa monga chopereka chopatulika ku Nyumba ya Yehova, ndalama zonse zamsonkho wa munthu aliyense, ndalama zomwe munthu amapereka akalonjeza ndiponso ndalama zimene munthu amapereka mwaufulu ku Nyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.4",
            "verseOrgIds": [
              "2KI.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wansembe aliyense alandire ndalamazo kuchokera kwa abwenzi ake, ndipo zigwiritsidwe ntchito yokonzera chilichonse chimene chipezeke kuti ndi chowonongeka mʼnyumbayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.5",
            "verseOrgIds": [
              "2KI.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pofika chaka cha 23 cha ufumu wa Yowasi, ansembewo anali asanakonze nyumbayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.6",
            "verseOrgIds": [
              "2KI.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mfumu Yowasi inayitanitsa wansembe Yehoyada ndi ansembe ena ndipo inafunsa kuti, \"Chifukwa chiyani simukukonza malo owonongeka a mʼnyumbayi? Musasungenso ndalama zina zochokera kwa abwenzi anu, koma muzipereke kuti akonzere nyumbayi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.7",
            "verseOrgIds": [
              "2KI.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ansembe anavomera kuti salandiranso ndalama kuchokera kwa anthu ndipo kuti sindiwo amene ati akonzenso nyumbayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.8",
            "verseOrgIds": [
              "2KI.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma wansembe Yehoyada anatenga bokosi ndipo anabowola chivundikiro chake. Anayika bokosilo pambali pa guwa lansembe, kudzanja lamanja la aliyense amene akulowa mʼNyumba ya Yehovayo. Ansembe amene ankalondera pa khomopo ankaponya mʼbokosi ndalama zonse zimene ankabwera nazo ku nyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.9",
            "verseOrgIds": [
              "2KI.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi zonse akaona kuti mʼbokosimo muli ndalama zambiri, mlembi wa mfumu ndi mkulu wa ansembe ankabwera ndipo ankawerenga ndalama zomwe anthu ankabwera nazo ku Nyumba ya Yehova ndi kuziyika mʼmatumba.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.10",
            "verseOrgIds": [
              "2KI.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ankati akadziwa kuti ndalamazo zilipo zingati, ankazipereka kwa anthu amene ankayangʼanira ntchito yokonza nyumbayo. Ndalamazo ankalipira anthu amene ankagwira ntchito yokonza Nyumba ya Yehova, amisiri a matabwa ndi amisiri omanga nyumba,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.11",
            "verseOrgIds": [
              "2KI.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "amisiri a miyala ndiponso anthu ophwanya miyala. Iwo ankagula matabwa ndi miyala yosema yokonzera Nyumba ya Yehova ndipo ankalipira zinthu zonse zofunika pokonzanso nyumbayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.12",
            "verseOrgIds": [
              "2KI.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndalama zomwe anthu ankabwera nazo ku nyumbayo sanagulire siliva wopangira mabeseni, zozimitsira nyale, mbale zowazira magazi, malipenga kapena ziwiya zina zilizonse zagolide kapena zasiliva za ku Nyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.13",
            "verseOrgIds": [
              "2KI.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalamazi anazipereka kwa anthu antchito amene anazigwiritsa ntchito yokonzera nyumbayo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.14",
            "verseOrgIds": [
              "2KI.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma sanawafunse kuti afotokoze kagwiritsidwe ntchito ka ndalama zolipira amene ankagwira ntchito, chifukwa anthuwo ankagwira ntchitoyo mokhulupirika kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.15",
            "verseOrgIds": [
              "2KI.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndalama zomwe zinkaperekedwa pa nsembe yopepesera machimo ndi nsembe yoperekedwa chifukwa cha tchimo sanabwere nazo ku Nyumba ya Yehova pakuti zinali za ansembe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.16",
            "verseOrgIds": [
              "2KI.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyo, Hazaeli, mfumu ya Aramu anapita kukathira nkhondo mzinda wa Gati nawulanda. Kenaka Hazaeli anatembenuka kupita kukathira nkhondo mzinda wa Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.17",
            "verseOrgIds": [
              "2KI.12.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yowasi mfumu ya Yuda anatenga zinthu zonse zopatulika zomwe anazipatula Yehosafati, Yehoramu, ndi Ahaziya abambo ake, mafumu a Yuda ndi mphatso zonse zomwe iye mwini anazipereka: golide yense amene anapezeka mʼnyumba yosungiramo chuma cha mʼnyumba ya Yehova ndi zomwe zinali mʼnyumba ya mfumu, nazipereka kwa Hazaeli mfumu ya Aramu. Pamenepo iye anachoka ku Yerusalemuko.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.18",
            "verseOrgIds": [
              "2KI.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ntchito zina za Yowasi ndi zonse zimene anachita, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a Yuda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.19",
            "verseOrgIds": [
              "2KI.12.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuluakulu ake anamuchitira chiwembu ndi kumupha ku Beti Milo, pa njira yotsikira ku Silo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
            "verseOrgIds": [
              "2KI.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yozakara mwana wa Simeati ndi Yehozabadi mwana wa Someri atumiki ake anamukantha nafa. Ndipo anamuyika mʼmanda pamodzi ndi makolo ake mu Mzinda wa Davide. Ndipo Amaziya mwana wake analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.21",
            "verseOrgIds": [
              "2KI.12.22"
            ]
          }
        }
      ]
    }
  ],
