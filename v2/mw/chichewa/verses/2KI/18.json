  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2KI 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hezekiya Mfumu ya Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka chachitatu cha Hoseya mwana wa Ela mfumu ya Israeli, Hezekiya mwana wa Ahazi mfumu ya Yuda analowa ufumu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.1",
            "verseOrgIds": [
              "2KI.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakhala mfumu ali ndi zaka 25 ndipo analamulira mu Yerusalemu zaka 29. Amayi ake anali Abi, mwana wa Zekariya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.2",
            "verseOrgIds": [
              "2KI.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anachita zolungama pamaso pa Yehova monga anachitira Davide kholo lake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.3",
            "verseOrgIds": [
              "2KI.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachotsa malo opembedzerako mafano, anaphwanya miyala yachipembedzo ndiponso anadula mafano a Asera. Iye anaphwanya njoka yamkuwa imene Mose anapanga, pakuti mpaka kufikira nthawi imeneyi Aisraeli amafukiza lubani kwa njoka imeneyi. (Imatchedwa Nehusitani).",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.4",
            "verseOrgIds": [
              "2KI.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya anadalira Yehova Mulungu wa Israeli. Kotero panalibe wina wofanana naye pakati pa mafumu onse a Yuda, asanakhale mfumu kapena atakhala kale mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.5",
            "verseOrgIds": [
              "2KI.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakangamira Yehova ndipo sanamusiye koma anasunga malamulo amene Yehova anapatsa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.6",
            "verseOrgIds": [
              "2KI.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anali naye ndipo kulikonse kumene anapita zinthu zinkamuyendera bwino. Iye anagalukira mfumu ya ku Asiriya ndipo sanayitumikirenso.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.7",
            "verseOrgIds": [
              "2KI.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anakantha Afilisti kuyambira ku nsanja ya alonda mpaka ku mzinda wotetezedwa. Anakafika mpaka ku Gaza ndi ku malire ake.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.8",
            "verseOrgIds": [
              "2KI.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka chachinayi cha Mfumu Hezekiya, chimene chinali chaka chachisanu ndi chiwiri cha Hoseya mwana wa Ela mfumu ya Israeli, Salimenezeri, mfumu ya ku Asiriya anabwera kudzathira nkhondo mzinda wa Samariya ndi kuwuzinga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.9",
            "verseOrgIds": [
              "2KI.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiriya analanda mzindawu patatha zaka zitatu. Choncho mzinda wa Samariya unalandidwa chaka chachisanu ndi chimodzi cha Hezekiya, chimene chinali chaka chachisanu ndi chinayi cha Hoseya mfumu ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.10",
            "verseOrgIds": [
              "2KI.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ya ku Asiriya inatenga Aisraeli kupita nawo ku ukapolo ku Asiriya ndipo anakawakhazika ku Hala, ku Habori pafupi ndi mtsinje wa Gozani ndi mʼmizinda ya Amedi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.11",
            "verseOrgIds": [
              "2KI.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi zinachitika chifukwa sanamvere zonena za Yehova Mulungu wawo, koma anaphwanya pangano lake ndi zonse zimene Mose mtumiki wa Yehova anawalamula. Iwo sanamvere malamulowo kapena kuwagwiritsa ntchito.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.12",
            "verseOrgIds": [
              "2KI.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼchaka chakhumi ndi chinayi cha ulamuliro wa Mfumu Hezekiya, Senakeribu mfumu ya ku Asiriya anathira nkhondo mizinda yonse yotetezedwa ya Yuda, nayilanda.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.13",
            "verseOrgIds": [
              "2KI.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Hezekiya mfumu ya Yuda anatumiza uthenga kwa mfumu ya ku Asiriya ku Lakisi wonena kuti, \"Ine ndalakwa. Chokani kuno ndipo ndidzakupatsani chilichonse chimene munene.\" Mfumu ya ku Asiriya inalamula mfumu Hezekiya, mfumu ya Yuda, kuti azipereka makilogalamu a siliva okwana 3,000 ndi makilogalamu a golide 1,000.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.14",
            "verseOrgIds": [
              "2KI.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Hezekiya inapereka siliva yense amene anapezeka mʼNyumba ya Yehova ndi mʼnyumba zosungiramo chuma cha mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.15",
            "verseOrgIds": [
              "2KI.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi imeneyi Hezekiya mfumu ya Yuda anakanganula golide amene anakuta zitseko ndi mphuthu za chipata cha Nyumba ya Yehova namupereka kwa mfumu ya ku Asiriya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.16",
            "verseOrgIds": [
              "2KI.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Senakeribu Aopseza Yerusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu ya ku Asiriya inatuma Taritani, Rabusarisi ndi Rabusake pamodzi ndi gulu lalikulu la ankhondo, kwa Mfumu Hezekiya ku Yerusalemu kuchokera ku Lakisi. Iwo anafika ku Yerusalemu nakayima pafupi ndi ngalande ya madzi yochokera ku Dziwe Lakumtunda, pa msewu waukulu wopita ku malo a Munda wa Mmisiri Wochapa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.17",
            "verseOrgIds": [
              "2KI.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayitana mfumu, ndipo Eliyakimu mwana wa Hilikiya woyangʼanira nyumba ya mfumu, Sebina mlembi wa bwalo ndi Yowa mwana wa Asafu mlembi wa zochitika anapita kwa anthuwo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.18",
            "verseOrgIds": [
              "2KI.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Rabusake anawawuza kuti, \"Kamuwuzeni Hezekiya kuti,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2KI 18:19"
      },
      "items": [
        {
          "text": "\" 'Mfumu yayikulu, mfumu ya ku Asiriya ikunena kuti, 'Kodi chikukulimbitsa mtima ndi chiyani?'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.19",
            "verseOrgIds": [
              "2KI.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ukuti uli ndi luso ndiponso mphamvu pa nkhondo, komatu ukuyankhula mawu opanda pake. Kodi tsono iwe ukudalira yani kuti undiwukire ine?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.20",
            "verseOrgIds": [
              "2KI.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taona tsono, iwe ukudalira Igupto, bango lothyokalo, limene limalasa mʼmanja mwa munthu ngati waliyesa ndodo yoyendera! Umo ndi mmene Farao mfumu ya ku Igupto imachitira aliyense amene akuyidalira.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.21",
            "verseOrgIds": [
              "2KI.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ngati ukunena kwa ine kuti, \"Ife tikudalira Yehova Mulungu wathu.\" Kodi si Mulungu yemweyo amene nyumba zake ndi maguwa ake Hezekiya anachotsa, nawuza anthu a ku Yuda ndi a ku Yerusalemu kuti, \"Muzipembedza pa guwa lansembe ili mu Yerusalemu?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.22",
            "verseOrgIds": [
              "2KI.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ndipo tsopano bwera udzakambirane ndi mbuye wanga, mfumu ya ku Asiriya: ine ndidzakupatsa akavalo 2,000 ngati ungathe kupeza okwerapo!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.23",
            "verseOrgIds": [
              "2KI.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ungathe bwanji kugonjetsa ngakhale mmodzi mwa akazembe angʼonoangʼono a mbuye wanga, pamene ukudalira Igupto kuti akupatse magaleta ndi anthu okwera pa akavalo?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.24",
            "verseOrgIds": [
              "2KI.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwonjezera pamenepa, kodi ine ndabwera kudzathira nkhondo ndi kuwononga malo ano popanda chilolezo cha Yehova? Yehova mwini ndiye anandiwuza kuti ndidzathire nkhondo ndi kuwononga dziko lino.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.25",
            "verseOrgIds": [
              "2KI.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Eliyakimu mwana wa Hilikiya, Sebina ndi Yowa anawuza Rabusakeyo kuti, \"Chonde yankhulani kwa atumiki anufe mʼChiaramu, popeza timachimva. Musayankhule nafe mu Chihebri kuopa kuti anthu onse amene ali pa khomapa angamve.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.26",
            "verseOrgIds": [
              "2KI.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Rabusake anayankha kuti, \"Kodi mbuye wanga wandituma kuti ndidzanene zinthu izi kwa mbuye wanu yekha ndi inu nokha basi? Ayi, komanso kwa anthu amene akhala pa khomawa. Iwowa adzadya chimbudzi chawo chomwe ndi kumwa mkodzo wawo womwe monga momwe mudzachitire inuyonso.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.27",
            "verseOrgIds": [
              "2KI.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Rabusake anayimirira nafuwula mu Chihebri kuti, \"Imvani mawu a mfumu yayikulu, mfumu ya ku Asiriya!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.28",
            "verseOrgIds": [
              "2KI.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene mfumu ikunena ndi izi: 'Musalole kuti Hezekiya akunamizeni. Iye sangakupulumutseni mʼdzanja langa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.29",
            "verseOrgIds": [
              "2KI.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekiya asakukakamizeni kudalira Yehova ndi mawu akuti, 'Ndithu, Yehova adzatipulumutsa; ndipo sadzapereka mzindawu mʼdzanja la mfumu ya ku Asiriya.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.30",
            "verseOrgIds": [
              "2KI.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Musamumvere Hezekiya. Zimene mfumu ya ku Asiriya ikunena ndi izi: Pangani mtendere ndi ine ndipo mutuluke mu mzinda. Mukatero aliyense wa inu adzadya mphesa ndi nkhuyu za mʼmunda mwake ndiponso adzamwa madzi a mʼchitsime chake,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.31",
            "verseOrgIds": [
              "2KI.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpaka nditabwera kudzakutengani kupita ku dziko lofanana ndi lanuli, dziko la tirigu ndi vinyo watsopano, dziko la chakudya ndi minda ya mipesa, dziko la mitengo ya olivi ndi uchi. Sankhani moyo osati imfa!",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 18:32"
      },
      "items": [
        {
          "text": "\"Musamvere zonena Hezekiya, pakuti iye akukusocheretsani ponena kuti, 'Yehova adzatipulumutsa.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.32",
            "verseOrgIds": [
              "2KI.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mulungu wa anthu a mtundu wina uliwonse wapulumutsapo dziko lake mʼdzanja la mfumu ya ku Asiriya?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.33",
            "verseOrgIds": [
              "2KI.18.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 18:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ili kuti milungu ya Hamati ndi Aripadi? Ili kuti milungu ya Sefaravaimu, Hena ndi Ivani? Kodi inapulumutsa Samariya mʼdzanja langa?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.34",
            "verseOrgIds": [
              "2KI.18.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 18:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi ndi milungu iti mwa milungu yonse ya mayiko awa amene anapulumutsa dziko lake mʼdzanja langa? Nanga tsono Yehova adzapulumutsa Yerusalemu mʼdzanja langa motani?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.35",
            "verseOrgIds": [
              "2KI.18.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 18:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthu anakhala chete ndipo sanayankhepo kanthu, chifukwa mfumu inawalamula kuti, \"Musayankhe.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.36",
            "verseOrgIds": [
              "2KI.18.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 18:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo anthu atatu aja Eliyakimu, mwana wa Hilikiya amene ankayangʼanira nyumba ya mfumu, Sebina mlembi wa bwalo ndi Yowa mwana wa Asafu, mlembi wa zochitika anapita kwa Hezekiya atangʼamba zovala zawo ndipo anamuwuza Hezekiya zonse zimene anayankhula Rabusake uja.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.18.37",
            "verseOrgIds": [
              "2KI.18.37"
            ]
          }
        }
      ]
    }
  ],
