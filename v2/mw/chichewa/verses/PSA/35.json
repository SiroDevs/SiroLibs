      "attrs": {
        "style": "q2",
        "vid": "PSA 35:26"
      },
      "items": [
        {
          "text": "achite manyazi ndi kusokonezeka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
