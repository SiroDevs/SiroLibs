      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "akondwere chifukwa cha masautso anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "musalole kuti amene amadana nane popanda chifukwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
