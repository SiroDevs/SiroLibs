            "sid": "PSA 35:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa panga padzayankhula za chilungamo chanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.28",
            "verseOrgIds": [
              "PSA.35.28"
            ]
          }
        }
      ]
