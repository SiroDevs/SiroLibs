          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PSA 35:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onetsani kusalakwa kwanga mwa chilungamo chanu, Inu Yehova Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:24"
      },
      "items": [
        {
          "text": "Musalole kuti akondwere chifukwa cha mavuto anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.24",
            "verseOrgIds": [
              "PSA.35.24"
            ]
          }
        }
      ]
    },
    {
