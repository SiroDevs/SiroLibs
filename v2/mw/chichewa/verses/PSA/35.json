      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:22"
      },
      "items": [
        {
          "text": "Ambuye musakhale kutali ndi ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
