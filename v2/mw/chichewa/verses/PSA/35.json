          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakuyamikani mu msonkhano waukulu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.18",
            "verseOrgIds": [
              "PSA.35.18"
            ]
