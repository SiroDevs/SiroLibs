          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 35:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga anthu osapembedza, iwo anandinyoza mwachipongwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
          }
        }
