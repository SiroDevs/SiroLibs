      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:16"
      },
      "items": [
        {
          "text": "anandikukutira mano awo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.16",
            "verseOrgIds": [
              "PSA.35.16"
            ]
          }
        }
      ]
    },
    {
