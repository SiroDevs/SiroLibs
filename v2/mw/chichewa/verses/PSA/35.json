      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:27"
      },
      "items": [
        {
          "text": "afuwule mwachimwemwe ndi chisangalalo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:27"
      },
      "items": [
        {
          "text": "Nthawi zonse azinena kuti, \"Yehova akwezeke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
