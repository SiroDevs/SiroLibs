      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:21"
      },
      "items": [
        {
          "text": "Ndipo ndi maso athuwa ife taziona.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.21",
            "verseOrgIds": [
              "PSA.35.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
