      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:19"
      },
      "items": [
        {
          "text": "andiyangʼane chamʼmbali mondinyoza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.19",
            "verseOrgIds": [
              "PSA.35.19"
            ]
          }
        }
      ]
    },
