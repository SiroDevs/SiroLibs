          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PSA 35:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzukani, ndipo nyamukani kunditeteza!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.23",
            "verseOrgIds": [
              "PSA.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:23"
      },
      "items": [
        {
          "text": "Mulimbane nawo chifukwa cha ine, Mulungu wanga ndi Ambuye anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.23",
            "verseOrgIds": [
              "PSA.35.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
