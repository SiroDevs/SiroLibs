          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye, mpaka liti mudzakhala mukungoyangʼana?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
