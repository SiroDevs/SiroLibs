      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:17"
      },
      "items": [
        {
          "text": "Landitsani moyo wanga ku chiwonongeko chawo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:17"
      },
      "items": [
        {
          "text": "moyo wanga wopambana ku mikango.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.17",
            "verseOrgIds": [
              "PSA.35.17"
            ]
          }
        }
      ]
    },
    {
