      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:28"
      },
      "items": [
        {
          "text": "ndi za matamando anu tsiku lonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.28",
            "verseOrgIds": [
              "PSA.35.28"
            ]
          }
