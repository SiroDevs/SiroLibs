          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowo sayankhula mwamtendere,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
