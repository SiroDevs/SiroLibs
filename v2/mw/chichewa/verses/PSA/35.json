      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:26"
      },
      "items": [
        {
          "text": "avekedwe manyazi ndi mnyozo ngati zovala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
