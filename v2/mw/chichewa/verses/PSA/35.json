      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:25"
      },
      "items": [
        {
          "text": "Kapena kunena kuti, \"Tamutha ameneyu basi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
      ]
    },
    {
