          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PSA 35:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova mwaona zimenezi; musakhale chete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.22",
            "verseOrgIds": [
              "PSA.35.22"
            ]
          }
        }
      ]
    },
