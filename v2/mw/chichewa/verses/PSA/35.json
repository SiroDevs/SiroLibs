        "style": "q2",
        "vid": "PSA 35:18"
      },
      "items": [
        {
          "text": "pakati pa gulu lalikulu la anthu ndidzakutamandani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.18",
            "verseOrgIds": [
              "PSA.35.18"
            ]
          }
