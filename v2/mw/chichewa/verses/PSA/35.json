          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musalole kuti aganize kuti, \"Amati atani, zachitika monga momwe timafunira!\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.25",
            "verseOrgIds": [
              "PSA.35.25"
            ]
          }
        }
      ]
    },
