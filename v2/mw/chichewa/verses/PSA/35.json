      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 35:26"
      },
      "items": [
        {
          "text": "Onse amene amadzikweza kufuna kundipambana,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.26",
            "verseOrgIds": [
              "PSA.35.26"
            ]
          }
        }
      ]
