          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amandiseka mofuwula ndipo amati, \"Haa! Haa!",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.21",
            "verseOrgIds": [
              "PSA.35.21"
            ]
          }
