      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:20"
      },
      "items": [
        {
          "text": "koma amaganizira zonamizira",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.20",
            "verseOrgIds": [
              "PSA.35.20"
            ]
          }
        }
      ]
    },
