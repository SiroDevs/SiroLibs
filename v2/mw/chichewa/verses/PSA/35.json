          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma amene amakondwera chifukwa chakuti ndine wosalakwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
