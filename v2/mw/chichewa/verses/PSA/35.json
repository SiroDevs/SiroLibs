      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 35:27"
      },
      "items": [
        {
          "text": "Iye amene amakondwera ndi kupeza bwino kwa mtumiki wake.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.35.27",
            "verseOrgIds": [
              "PSA.35.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
