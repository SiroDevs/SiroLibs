  "verseCount": 6,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "PSA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpaka liti Yehova? Kodi mudzandiyiwala mpaka kalekale?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:1"
      },
      "items": [
        {
          "text": "Mpaka liti mudzandibisira nkhope yanu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.1",
            "verseOrgIds": [
              "PSA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzalimbana ndi maganizo anga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "ndi kukhala ndi chisoni mu mtima mwanga tsiku lililonse mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:2"
      },
      "items": [
        {
          "text": "Mpaka liti adani anga adzandipambana?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.2",
            "verseOrgIds": [
              "PSA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndiyangʼaneni ndi kundiyankha, Inu Yehova Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:3"
      },
      "items": [
        {
          "text": "Walitsani maso anga kuti ndingafe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.3",
            "verseOrgIds": [
              "PSA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "mdani wanga adzati, \"Ndamugonjetsa,\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:4"
      },
      "items": [
        {
          "text": "ndipo adani anga adzakondwera pamene ine ndagwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.4",
            "verseOrgIds": [
              "PSA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndikudalira chikondi chanu chosasinthika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:5"
      },
      "items": [
        {
          "text": "mtima wanga umakondwera ndi chipulumutso chanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.5",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzayimbira Yehova",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 13:6"
      },
      "items": [
        {
          "text": "pakuti wandichitira zokoma.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.13.6",
            "verseOrgIds": [
              "PSA.13.6"
            ]
          }
        }
      ]
    }
  ],
