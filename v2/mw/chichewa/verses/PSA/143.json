          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova imvani pemphero langa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "mvetserani kulira kwanga kopempha chifundo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "mwa kukhulupirika kwanu ndi chilungamo chanu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:1"
      },
      "items": [
        {
          "text": "bwerani kudzandithandiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.1",
            "verseOrgIds": [
              "PSA.143.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 143:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musazenge mlandu mtumiki wanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:2"
      },
      "items": [
        {
          "text": "pakuti palibe munthu wamoyo amene ndi wolungama pamaso panu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.2",
            "verseOrgIds": [
              "PSA.143.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 143:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mdani akundithamangitsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "iye wandipondereza pansi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "wachititsa kuti ndikhale mu mdima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:3"
      },
      "items": [
        {
          "text": "ngati munthu amene anafa kale.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.3",
            "verseOrgIds": [
              "PSA.143.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 143:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mzimu wanga ukufowoka mʼkati mwanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:4"
      },
      "items": [
        {
          "text": "mʼkati mwanga, mtima wanga uli ndi nkhawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.4",
            "verseOrgIds": [
              "PSA.143.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 143:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimakumbukira masiku amakedzana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "ndimalingalira za ntchito yanu yonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:5"
      },
      "items": [
        {
          "text": "ndimaganizira zimene manja anu anachita.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.5",
            "verseOrgIds": [
              "PSA.143.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 143:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndatambalitsa manja anga kwa Inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.6",
            "verseOrgIds": [
              "PSA.143.6"
            ]
          }
        }
      ]
    },
