      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:12"
      },
      "items": [
        {
          "text": "wonongani adani anga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
