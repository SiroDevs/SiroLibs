          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova ndiyankheni msanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "mzimu wanga ukufowoka.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "Musandibisire nkhope yanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:7"
      },
      "items": [
        {
          "text": "mwina ndidzakhala ngati iwo amene atsikira ku dzenje.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.7",
            "verseOrgIds": [
              "PSA.143.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 143:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lolani kuti mmawa ubweretse mawu achikondi chanu chosasinthika,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "pakuti ine ndimadalira Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "Mundisonyeze njira yoti ndiyendemo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:8"
      },
      "items": [
        {
          "text": "pakuti kwa Inu nditukulira moyo wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.8",
            "verseOrgIds": [
              "PSA.143.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 143:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pulumutseni kwa adani anga, Inu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:9"
      },
      "items": [
        {
          "text": "pakuti ndimabisala mwa Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.9",
            "verseOrgIds": [
              "PSA.143.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 143:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Phunzitseni kuchita chifuniro chanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "popeza ndinu Mulungu wanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "Mzimu wanu wabwino unditsogolere",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:10"
      },
      "items": [
        {
          "text": "pa njira yanu yosalala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.10",
            "verseOrgIds": [
              "PSA.143.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 143:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sungani moyo wanga Inu Yehova chifukwa cha dzina lanu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 143:11"
      },
      "items": [
        {
          "text": "mwa chilungamo chanu tulutseni mʼmasautso anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.11",
            "verseOrgIds": [
              "PSA.143.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 143:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa chikondi chanu chosasinthika khalitsani chete adani anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.143.12",
            "verseOrgIds": [
              "PSA.143.12"
            ]
          }
        }
      ]
    },
