  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "69",
        "style": "c",
        "sid": "PSA 69"
      },
      "items": [
        {
          "text": "69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 69",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Salimo la Davide. Potsata mayimbidwe a \"Akakombo.\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 69:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pulumutseni Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:1"
      },
      "items": [
        {
          "text": "pakuti madzi afika mʼkhosi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.1",
            "verseOrgIds": [
              "PSA.69.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 69:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndikumira mʼthope lozama",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "mʼmene mulibe popondapo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "Ndalowa mʼmadzi ozama;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:2"
      },
      "items": [
        {
          "text": "mafunde andimiza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.2",
            "verseOrgIds": [
              "PSA.69.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 69:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndafowoka ndikupempha chithandizo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "kummero kwanga kwawuma gwaa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "mʼmaso mwanga mwada",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:3"
      },
      "items": [
        {
          "text": "kuyembekezera Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.3",
            "verseOrgIds": [
              "PSA.69.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 69:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amene amadana nane popanda chifukwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "ndi ochuluka kuposa tsitsi la kumutu kwanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "ambiri ndi adani anga popanda chifukwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "iwo amene akufunafuna kundiwononga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "Ndikukakamizidwa kubwezera",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:4"
      },
      "items": [
        {
          "text": "zomwe sindinabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.4",
            "verseOrgIds": [
              "PSA.69.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 69:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mukudziwa uchitsiru wanga, Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:5"
      },
      "items": [
        {
          "text": "kulakwa kwanga sikuli kobisika kwa Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.5",
            "verseOrgIds": [
              "PSA.69.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 69:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amene amadalira Inu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "asanyozedwe chifukwa cha ine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "Inu Ambuye Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "Iwo amene amafunafuna Inu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "asachititsidwe manyazi chifukwa cha ine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:6"
      },
      "items": [
        {
          "text": "Inu Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.6",
            "verseOrgIds": [
              "PSA.69.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 69:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ndimapirira kunyozedwa chifukwa cha Inu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:7"
      },
      "items": [
        {
          "text": "ndipo manyazi amaphimba nkhope yanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.7",
            "verseOrgIds": [
              "PSA.69.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 69:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndine mlendo kwa abale anga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:8"
      },
      "items": [
        {
          "text": "munthu wakudza kwa ana aamuna a amayi anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.8",
            "verseOrgIds": [
              "PSA.69.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 69:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti changu chochitira nyumba yanu chandiphetsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:9"
      },
      "items": [
        {
          "text": "ndipo chipongwe cha iwo amene amanyoza Inu chandigwera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.9",
            "verseOrgIds": [
              "PSA.69.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 69:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndikulira ndi kusala kudya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:10"
      },
      "items": [
        {
          "text": "ndiyenera kupirira kunyozedwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.10",
            "verseOrgIds": [
              "PSA.69.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 69:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "pomwe ndavala chiguduli,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:11"
      },
      "items": [
        {
          "text": "anthu amandiseweretsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.11",
            "verseOrgIds": [
              "PSA.69.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 69:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amene amakhala pa chipata amandinena,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:12"
      },
      "items": [
        {
          "text": "ndipo ine ndine nyimbo ya zidakwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.12",
            "verseOrgIds": [
              "PSA.69.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 69:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndikupempha kwa Inu Ambuye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "pa nthawi yanu yondikomera mtima;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "mwa chikondi chanu chachikulu",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 69:13"
      },
      "items": [
        {
          "text": "Inu Mulungu, mundiyankhe pondipulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.69.13",
            "verseOrgIds": [
              "PSA.69.14"
