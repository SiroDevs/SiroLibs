          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, mtima wanga siwodzikuza,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "maso anga siwonyada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "sinditengeteka mtima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:1"
      },
      "items": [
        {
          "text": "ndi zinthu zapamwamba ndi zodabwitsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.1",
            "verseOrgIds": [
              "PSA.131.1"
            ]
          }
        }
      ]
    },
    {
