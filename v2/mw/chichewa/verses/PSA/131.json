      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 131:2"
      },
      "items": [
        {
          "text": "ndi kuwukhalitsa chete ngati mwana amene amayi ake amuletsa kuyamwa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
          }
        }
      ]
    },
    {
