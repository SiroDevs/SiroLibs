          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma moyo wanga ndawutontholetsa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.131.2",
            "verseOrgIds": [
              "PSA.131.2"
            ]
