  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "PSA 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Monga mwa \"Mbawala yayikazi ya Mmawa.\" Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu wanga, Mulungu wanga, nʼchifukwa chiyani mwandisiya?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:1"
      },
      "items": [
        {
          "text": "Chifuwa chiyani simukundithandiza ndi pangʼono pomwe?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:1"
      },
      "items": [
        {
          "text": "Nʼchifukwa chiyani simukumva mawu a kudandaula kwanga?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.1",
            "verseOrgIds": [
              "PSA.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Mulungu wanga, ine ndimalira masana, koma simuyankha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:2"
      },
      "items": [
        {
          "text": "usikunso, ndipo sindikhala chete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.2",
            "verseOrgIds": [
              "PSA.22.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu ndinu Woyera, wokhala pa mpando waufumu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:3"
      },
      "items": [
        {
          "text": "ndinu matamando a Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.3",
            "verseOrgIds": [
              "PSA.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa inu makolo athu anadalira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:4"
      },
      "items": [
        {
          "text": "iwo anadalira ndipo Inu munawapulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.4",
            "verseOrgIds": [
              "PSA.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Analirira kwa inu ndipo munawapulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:5"
      },
      "items": [
        {
          "text": "Iwo anakhulupirira Inu ndipo simunawakhumudwitse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.5",
            "verseOrgIds": [
              "PSA.22.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ine ndine nyongolotsi osati munthu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:6"
      },
      "items": [
        {
          "text": "wosekedwa ndi wonyozedwa ndi anthu onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.6",
            "verseOrgIds": [
              "PSA.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onse amene amandiona amandiseka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:7"
      },
      "items": [
        {
          "text": "amandiyankhulira mawu achipongwe akupukusa mitu yawo kunena kuti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.7",
            "verseOrgIds": [
              "PSA.22.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iyeyu amadalira Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "musiyeni Yehovayo amulanditse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "Musiyeni Yehova amupulumutse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:8"
      },
      "items": [
        {
          "text": "popeza amakondwera mwa Yehovayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.8",
            "verseOrgIds": [
              "PSA.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe Inu ndinu amene munandibadwitsa, munanditulutsa mʼmimba mwa amayi anga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "Munachititsa kuti ndizikudalirani",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:9"
      },
      "items": [
        {
          "text": "ngakhale pa nthawi imene ndinkayamwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.9",
            "verseOrgIds": [
              "PSA.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chibadwire ine ndinaperekedwa kwa Inu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:10"
      },
      "items": [
        {
          "text": "kuchokera mʼmimba mwa amayi anga Inu mwakhala muli Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.10",
            "verseOrgIds": [
              "PSA.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musakhale kutali ndi ine,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "pakuti mavuto ali pafupi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:11"
      },
      "items": [
        {
          "text": "ndipo palibe wina wondipulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.11",
            "verseOrgIds": [
              "PSA.22.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngʼombe zazimuna zandizungulira;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:12"
      },
      "items": [
        {
          "text": "ngʼombe zazimuna zamphamvu za ku Basani zandizinga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.12",
            "verseOrgIds": [
              "PSA.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mikango yobangula pokadzula nyama,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:13"
      },
      "items": [
        {
          "text": "yatsekula kwambiri pakamwa pawo kulimbana nane.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.13",
            "verseOrgIds": [
              "PSA.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndatayika pansi ngati madzi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "ndipo mafupa anga onse achoka mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "Mtima wanga wasanduka phula;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:14"
      },
      "items": [
        {
          "text": "wasungunuka mʼkati mwanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.14",
            "verseOrgIds": [
              "PSA.22.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphamvu zanga zauma ngati phale,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:15"
      },
      "items": [
        {
          "text": "ndipo lilime langa lamamatira ku nsagwada;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.22.15",
            "verseOrgIds": [
              "PSA.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 22:15"
      },
      "items": [
        {
