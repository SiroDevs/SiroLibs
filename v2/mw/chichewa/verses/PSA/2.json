    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chiyani anthu a mitundu ina akufuna kuchita chiwembu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:1"
      },
      "items": [
        {
          "text": "Akonzekeranji zopanda pake anthu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.1",
            "verseOrgIds": [
              "PSA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu a dziko lapansi akugwirizana nazo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "ndipo olamulira asonkhana pamodzi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "kulimbana ndi Ambuye",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:2"
      },
      "items": [
        {
          "text": "ndi wodzozedwa wakeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.2",
            "verseOrgIds": [
              "PSA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo akunena kuti, \"Tiyeni timasule magoli awo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:3"
      },
      "items": [
        {
          "text": "ndipo titaye zingwe zawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.3",
            "verseOrgIds": [
              "PSA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wokhala mmwamba akuseka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:4"
      },
      "items": [
        {
          "text": "Ambuye akuwanyoza iwowo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.4",
            "verseOrgIds": [
              "PSA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye awadzudzula mu mkwiyo wake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:5"
      },
      "items": [
        {
          "text": "ndi kuwaopseza mu ukali wake, kunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.5",
            "verseOrgIds": [
              "PSA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndakhazikitsa mfumu yanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:6"
      },
      "items": [
        {
          "text": "pa Ziyoni, phiri langa loyera.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.6",
            "verseOrgIds": [
              "PSA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzalengeza zimene Yehova walamula:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "Iye anati kwa Ine, \"Iwe ndiwe mwana wanga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:7"
      },
      "items": [
        {
          "text": "lero Ine ndakhala Atate ako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.7",
            "verseOrgIds": [
              "PSA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tandipempha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "ndipo ndidzachititsa kuti mitundu ya anthu ikhale cholowa chako;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:8"
      },
      "items": [
        {
          "text": "malekezero a dziko lapansi kuti akhale chuma chako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.8",
            "verseOrgIds": [
              "PSA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iweyo udzawalamulira ndi ndodo yaufumu yachitsulo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:9"
      },
      "items": [
        {
          "text": "udzawaphwanya zidutswazidutswa ngati zowumba zadothi.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.9",
            "verseOrgIds": [
              "PSA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero, inu mafumu, chenjerani;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:10"
      },
      "items": [
        {
          "text": "chenjezedwani, inu olamulira a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.10",
            "verseOrgIds": [
              "PSA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tumikirani Yehova mwa mantha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:11"
      },
      "items": [
        {
          "text": "ndi kukondwerera ulamuliro wake monjenjemera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.11",
            "verseOrgIds": [
              "PSA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpsopsoneni mwanayo kuti angakwiye;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "kuti mungawonongedwe mʼnjira zanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "pakuti ukali wake utha kuuka mʼkanthawi kochepa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 2:12"
      },
      "items": [
        {
          "text": "Odala ndi onse amene amathawira kwa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.2.12",
            "verseOrgIds": [
              "PSA.2.12"
            ]
          }
        }
      ]
    }
  ],
