  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "30",
        "style": "c",
        "sid": "PSA 30"
      },
      "items": [
        {
          "text": "30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 30",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Salimo la Davide. Nyimbo yoyimba popereka Nyumba ya Mulungu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 30:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakukwezani Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:1"
      },
      "items": [
        {
          "text": "chifukwa mwanditulutsa kwakuya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:1"
      },
      "items": [
        {
          "text": "ndipo simunalole kuti adani anga akondwere pa ine.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.1",
            "verseOrgIds": [
              "PSA.30.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova Mulungu wanga ndinapempha kwa Inu thandizo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:2"
      },
      "items": [
        {
          "text": "ndipo Inu munandichiritsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.2",
            "verseOrgIds": [
              "PSA.30.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, munanditulutsa ku manda,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:3"
      },
      "items": [
        {
          "text": "munandisunga kuti ndisatsalire mʼdzenje.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.3",
            "verseOrgIds": [
              "PSA.30.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirani Yehova inu anthu ake okhulupirika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:4"
      },
      "items": [
        {
          "text": "tamandani dzina lake loyera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.4",
            "verseOrgIds": [
              "PSA.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti mkwiyo wake umakhala kwa kanthawi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "koma kukoma mtima kwake ndi kwa moyo wonse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "utha kuchezera kulira usiku wonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:5"
      },
      "items": [
        {
          "text": "koma chimwemwe chimabwera mmawa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.5",
            "verseOrgIds": [
              "PSA.30.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndinaona kuti ndili otetezedwa ndinati,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:6"
      },
      "items": [
        {
          "text": "\"Sindidzagwedezekanso.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.6",
            "verseOrgIds": [
              "PSA.30.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, pamene munandikomera mtima,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:7"
      },
      "items": [
        {
          "text": "munachititsa phiri langa kuyima chilili;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:7"
      },
      "items": [
        {
          "text": "koma pamene munabisa nkhope yanu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:7"
      },
      "items": [
        {
          "text": "ndinataya mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.7",
            "verseOrgIds": [
              "PSA.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa Inu Yehova ndinayitana;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:8"
      },
      "items": [
        {
          "text": "kwa Ambuye ndinapempha chifundo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.8",
            "verseOrgIds": [
              "PSA.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi pali phindu lanji powonongeka kwanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:9"
      },
      "items": [
        {
          "text": "ngati nditsikira ku dzenje?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 30:9"
      },
      "items": [
        {
          "text": "Kodi fumbi lidzakutamandani Inu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:9"
      },
      "items": [
        {
          "text": "Kodi lidzalengeza za kukhulupirika kwanu?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.9",
            "verseOrgIds": [
              "PSA.30.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani Yehova ndipo mundichitire chifundo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:10"
      },
      "items": [
        {
          "text": "Yehova mukhale thandizo langa.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.10",
            "verseOrgIds": [
              "PSA.30.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu munasandutsa kulira kwanga kukhala kuvina;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:11"
      },
      "items": [
        {
          "text": "munachotsa chiguduli changa ndi kundiveka ndi chimwemwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.11",
            "verseOrgIds": [
              "PSA.30.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti mtima wanga uthe kuyimbira Inu usakhale chete.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 30:12"
      },
      "items": [
        {
          "text": "Yehova Mulungu wanga, ndidzapereka kwa Inu mayamiko kwamuyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.30.12",
            "verseOrgIds": [
              "PSA.30.13"
            ]
          }
        }
      ]
    }
  ],
