          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 150:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "Tamandani Mulungu mʼmalo ake opatulika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:1"
      },
      "items": [
        {
          "text": "mutamandeni ku thambo lake lamphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.1",
            "verseOrgIds": [
              "PSA.150.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 150:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutamandeni chifukwa cha machitidwe ake amphamvu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:2"
      },
      "items": [
        {
          "text": "mutamandeni chifukwa cha ukulu wake wopambana.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.2",
            "verseOrgIds": [
              "PSA.150.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 150:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutamandeni poyimba malipenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:3"
      },
      "items": [
        {
          "text": "mutamandeni ndi pangwe ndi zeze.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.3",
            "verseOrgIds": [
              "PSA.150.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 150:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutamandeni ndi matambolini ndi kuvina,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:4"
      },
      "items": [
        {
          "text": "mutamandeni ndi zingwe ndi zitoliro.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.4",
            "verseOrgIds": [
              "PSA.150.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 150:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mutamandeni ndi ziwaya zolira za malipenga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 150:5"
      },
      "items": [
        {
          "text": "mutamandeni ndi ziwaya zolira kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.5",
            "verseOrgIds": [
              "PSA.150.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 150:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chamoyo chilichonse chopuma chitamande Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.150.6",
            "verseOrgIds": [
              "PSA.150.6"
            ]
          }
        }
      ]
