          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 149:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "Imbirani Yehova nyimbo yatsopano,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:1"
      },
      "items": [
        {
          "text": "matamando ake mu msonkhano wa oyera mtima.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.1",
            "verseOrgIds": [
              "PSA.149.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 149:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Israeli asangalale mwa mlengi wake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:2"
      },
      "items": [
        {
          "text": "anthu a ku Ziyoni akondwere mwa Mfumu yawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.2",
            "verseOrgIds": [
              "PSA.149.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 149:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamande dzina lake povina",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:3"
      },
      "items": [
        {
          "text": "ndi kuyimbira Iye nyimbo ndi tambolini ndi pangwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.3",
            "verseOrgIds": [
              "PSA.149.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 149:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova amakondwera ndi anthu ake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:4"
      },
      "items": [
        {
          "text": "Iye amaveka chipulumutso odzichepetsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.4",
            "verseOrgIds": [
              "PSA.149.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 149:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyera mtima asangalale mu ulemu wake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:5"
      },
      "items": [
        {
          "text": "ndi kuyimba mwachimwemwe pa mabedi awo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.5",
            "verseOrgIds": [
              "PSA.149.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 149:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matamando a Mulungu akhale pakamwa pawo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:6"
      },
      "items": [
        {
          "text": "ndi lupanga lakuthwa konsekonse mʼmanja mwawo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.6",
            "verseOrgIds": [
              "PSA.149.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 149:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "kubwezera chilango anthu a mitundu ina,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:7"
      },
      "items": [
        {
          "text": "ndi kulanga anthu a mitundu yonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.7",
            "verseOrgIds": [
              "PSA.149.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 149:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumanga mafumu awo ndi zingwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.8",
            "verseOrgIds": [
              "PSA.149.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:8"
      },
      "items": [
        {
          "text": "anthu awo otchuka ndi unyolo wachitsulo,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.8",
            "verseOrgIds": [
              "PSA.149.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 149:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuchita zimene zinalembedwa zotsutsana nawo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 149:9"
      },
      "items": [
        {
          "text": "Uwu ndi ulemerero wa oyera mtima ake onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 149:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 149:9"
      },
      "items": [
        {
          "text": "Tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.149.9",
            "verseOrgIds": [
              "PSA.149.9"
            ]
          }
        }
