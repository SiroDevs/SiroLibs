              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yamikani Yehova chifukwa ndi wabwino;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.1",
            "verseOrgIds": [
              "PSA.107.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 107:1"
      },
      "items": [
        {
          "text": "pakuti chikondi chake ndi chosatha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.1",
            "verseOrgIds": [
              "PSA.107.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
