          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anamva njala ndi ludzu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.5",
            "verseOrgIds": [
              "PSA.107.5"
            ]
