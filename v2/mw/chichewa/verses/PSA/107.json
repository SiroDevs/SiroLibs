        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 107:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Owomboledwa a Yehova anene zimenezi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.2",
            "verseOrgIds": [
              "PSA.107.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 107:2"
      },
      "items": [
        {
          "text": "amene Iyeyo anawawombola mʼdzanja la mdani,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.2",
            "verseOrgIds": [
              "PSA.107.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
