          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena anayendayenda mʼchipululu mopanda kanthu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.4",
            "verseOrgIds": [
              "PSA.107.4"
            ]
