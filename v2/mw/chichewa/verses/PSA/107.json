      "items": [
        {
          "text": "ndipo miyoyo yawo inafowokeratu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.5",
            "verseOrgIds": [
              "PSA.107.5"
            ]
          }
        }
      ]
    },
