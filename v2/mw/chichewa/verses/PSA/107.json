      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 107:4"
      },
      "items": [
        {
          "text": "osapeza njira yopitira ku mzinda kumene akanakakhazikikako.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.4",
            "verseOrgIds": [
              "PSA.107.4"
            ]
          }
        }
      ]
    },
    {
