            "number": "3",
            "style": "v",
            "sid": "PSA 107:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "iwo amene anawasonkhanitsa kuchokera ku mayiko,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.3",
            "verseOrgIds": [
              "PSA.107.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 107:3"
      },
      "items": [
        {
          "text": "kuchokera kumadzulo ndi kummawa, kuchokera kumpoto ndi kummwera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.107.3",
            "verseOrgIds": [
              "PSA.107.3"
            ]
          }
        }
      ]
    },
    {
