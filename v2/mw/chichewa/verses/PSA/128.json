      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 128:6"
      },
      "items": [
        {
          "text": "Mtendere ukhale ndi Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.128.6",
            "verseOrgIds": [
              "PSA.128.6"
            ]
          }
        }
      ]
