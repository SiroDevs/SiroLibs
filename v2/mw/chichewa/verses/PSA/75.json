  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "75",
        "style": "c",
        "sid": "PSA 75"
      },
      "items": [
        {
          "text": "75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 75",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe, potsata mayimbidwe a \"Musawononge.\" Salimo la Asafu. Nyimbo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 75:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tikuthokoza Inu Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "tikuthokoza, pakuti dzina lanu lili pafupi nafe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:1"
      },
      "items": [
        {
          "text": "anthutu amafotokoza za ntchito zanu zodabwitsa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.1",
            "verseOrgIds": [
              "PSA.75.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 75:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumati, \"Ine ndimayika nthawi yoyenera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:2"
      },
      "items": [
        {
          "text": "ndine amene ndimaweruza mwachilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.2",
            "verseOrgIds": [
              "PSA.75.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 75:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene dziko lapansi ndi anthu ake onse anjenjemera,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:3"
      },
      "items": [
        {
          "text": "ndine amene ndimagwiriziza mizati yake molimba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.3",
            "verseOrgIds": [
              "PSA.75.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 75:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.75.3",
                "verseOrgIds": [
                  "PSA.75.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 75:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa odzitama ndikuti, 'Musadzitamenso,'",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:4"
      },
      "items": [
        {
          "text": "ndipo kwa oyipa, 'Musatukulenso nyanga zanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.4",
            "verseOrgIds": [
              "PSA.75.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 75:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musatukule nyanga zanu motsutsana ndi kumwamba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:5"
      },
      "items": [
        {
          "text": "musayankhule ndi khosi losololoka.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.5",
            "verseOrgIds": [
              "PSA.75.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 75:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kugamula milandu sikuchokera kummawa kapena kumadzulo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:6"
      },
      "items": [
        {
          "text": "kapena ku chipululu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.6",
            "verseOrgIds": [
              "PSA.75.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 75:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndi Mulungu amene amaweruza:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:7"
      },
      "items": [
        {
          "text": "Iyeyo amatsitsa wina, nakwezanso wina.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.7",
            "verseOrgIds": [
              "PSA.75.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 75:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼdzanja la Yehova muli chikho",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "chodzaza ndi vinyo wochita thovu, wosakanizidwa ndi zokometsera;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "Iye amamutsanulira pansi ndipo onse oyipa a dziko lapansi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:8"
      },
      "items": [
        {
          "text": "amamwa ndi senga zake zonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.8",
            "verseOrgIds": [
              "PSA.75.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 75:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kunena za ine, ndidzalengeza izi kwamuyaya;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:9"
      },
      "items": [
        {
          "text": "ndidzayimba matamando kwa Mulungu wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.9",
            "verseOrgIds": [
              "PSA.75.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 75:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzadula nyanga za onse oyipa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 75:10"
      },
      "items": [
        {
          "text": "koma nyanga za olungama zidzakwezedwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.75.10",
            "verseOrgIds": [
              "PSA.75.11"
            ]
          }
        }
      ]
    }
  ],
