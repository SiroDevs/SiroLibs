    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 67",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Pa zoyimbira za zingwe. Salimo.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 67:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova atikomere mtima ndi kutidalitsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:1"
      },
      "items": [
        {
          "text": "achititse kuti nkhope yake itiwalire.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.1",
            "verseOrgIds": [
              "PSA.67.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 67:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti njira zanu zidziwike pa dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:2"
      },
      "items": [
        {
          "text": "chipulumutso chanu pakati pa mitundu yonse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.2",
            "verseOrgIds": [
              "PSA.67.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 67:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitundu ya anthu ikutamandeni Inu Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:3"
      },
      "items": [
        {
          "text": "mitundu yonse ya anthu ikutamandeni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.3",
            "verseOrgIds": [
              "PSA.67.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 67:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitundu yonse ya anthu isangalale ndi kuyimba mwachimwemwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "pakuti inu mumaweruza mitundu ya anthu mwachilungamo",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:4"
      },
      "items": [
        {
          "text": "ndi kutsogolera mitundu ya anthu a dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.4",
            "verseOrgIds": [
              "PSA.67.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 67:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitundu ya anthu ikutamandeni Inu Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.5",
            "verseOrgIds": [
              "PSA.67.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:5"
      },
      "items": [
        {
          "text": "mitundu yonse ya anthu ikutamandeni.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.5",
            "verseOrgIds": [
              "PSA.67.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 67:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthaka yabereka zokolola zake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:6"
      },
      "items": [
        {
          "text": "tidalitseni Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.6",
            "verseOrgIds": [
              "PSA.67.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 67:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu atidalitse",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 67:7"
      },
      "items": [
        {
          "text": "kuti pamenepo malekezero onse a dziko lapansi apembedze Iyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.67.7",
            "verseOrgIds": [
              "PSA.67.8"
            ]
          }
        }
