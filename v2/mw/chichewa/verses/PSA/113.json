              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 113:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 113:1"
      },
      "items": [
        {
          "text": "Mutamandeni, inu atumiki a Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:1"
      },
      "items": [
        {
          "text": "tamandani dzina la Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.1",
            "verseOrgIds": [
              "PSA.113.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 113:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova atamandidwe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:2"
      },
      "items": [
        {
          "text": "kuyambira tsopano mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.2",
            "verseOrgIds": [
              "PSA.113.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 113:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuyambira ku matulukiro a dzuwa mpaka ku malowero ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:3"
      },
      "items": [
        {
          "text": "dzina la Yehova liyenera kutamandidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.3",
            "verseOrgIds": [
              "PSA.113.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 113:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova wakwezeka pa anthu a mitundu yonse,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:4"
      },
      "items": [
        {
          "text": "ulemerero wake ndi woposa mayiko akumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.4",
            "verseOrgIds": [
              "PSA.113.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 113:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani wofanana ndi Yehova Mulungu wathu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:5"
      },
      "items": [
        {
          "text": "Iye amene amakhala mwaufumu mmwamba?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.5",
            "verseOrgIds": [
              "PSA.113.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 113:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "amene amawerama pansi kuyangʼana",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:6"
      },
      "items": [
        {
          "text": "miyamba ndi dziko lapansi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.6",
            "verseOrgIds": [
              "PSA.113.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 113:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amakweza munthu wosauka kuchoka pa fumbi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:7"
      },
      "items": [
        {
          "text": "ndi kutukula munthu wosowa kuchoka pa dzala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.7",
            "verseOrgIds": [
              "PSA.113.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 113:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "amawakhazika pamodzi ndi mafumu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:8"
      },
      "items": [
        {
          "text": "pamodzi ndi mafumu a anthu ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.8",
            "verseOrgIds": [
              "PSA.113.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 113:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amakhazikitsa mayi wosabereka mʼnyumba yake",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 113:9"
      },
      "items": [
        {
          "text": "monga mayi wa ana wosangalala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.113.9",
            "verseOrgIds": [
              "PSA.113.9"
            ]
          }
        }
      ]
    },
