  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "39",
        "style": "c",
        "sid": "PSA 39"
      },
      "items": [
        {
          "text": "39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Salimo 39",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Kwa mtsogoleri wa mayimbidwe. Kwa Yedutuni. Salimo la Davide.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 39:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinati, \"Ndidzasamalira njira zanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "ndipo ndidzasunga lilime langa kuti ndisachimwe;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "ndidzatseka pakamwa panga ndi chitsekerero",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:1"
      },
      "items": [
        {
          "text": "nthawi yonse imene woyipa ali pamaso panga.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.1",
            "verseOrgIds": [
              "PSA.39.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 39:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene ndinali chete",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:2"
      },
      "items": [
        {
          "text": "osanena ngakhale kanthu kalikonse kabwino",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:2"
      },
      "items": [
        {
          "text": "mavuto anga anachulukirabe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.2",
            "verseOrgIds": [
              "PSA.39.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 39:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wanga unatentha mʼkati mwanga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:3"
      },
      "items": [
        {
          "text": "ndipo pamene ndinkalingalira, moto unayaka;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:3"
      },
      "items": [
        {
          "text": "kenaka ndinayankhula ndi lilime langa:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.3",
            "verseOrgIds": [
              "PSA.39.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 39:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova ndionetseni mathero a moyo wanga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:4"
      },
      "items": [
        {
          "text": "ndi chiwerengero cha masiku anga;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:4"
      },
      "items": [
        {
          "text": "mundidziwitse kuti moyo wanga ndi wosakhalitsa motani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.4",
            "verseOrgIds": [
              "PSA.39.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 39:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwachititsa kuti masiku anga akhale ochepa kwambiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "text": "kutalika kwa zaka zanga ndi kopanda phindu pamaso panu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "text": "moyo wa munthu aliyense ndi waufupi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.5",
            "verseOrgIds": [
              "PSA.39.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 39:5"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.39.5",
                "verseOrgIds": [
                  "PSA.39.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 39:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu ali ngati chithunzithunzi chake pamene akuyenda uku ndi uku:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:6"
      },
      "items": [
        {
          "text": "Iye amangovutika koma popanda phindu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:6"
      },
      "items": [
        {
          "text": "amadzikundikira chuma, osadziwa kuti chidzakhala chayani.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.6",
            "verseOrgIds": [
              "PSA.39.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 39:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma tsopano Ambuye kodi ndifunanso chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:7"
      },
      "items": [
        {
          "text": "Chiyembekezo changa chili mwa Inu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.7",
            "verseOrgIds": [
              "PSA.39.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 39:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pulumutseni ku zolakwa zanga zonse;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:8"
      },
      "items": [
        {
          "text": "musandisandutse chonyozeka kwa opusa.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.8",
            "verseOrgIds": [
              "PSA.39.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 39:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinali chete; sindinatsekule pakamwa panga",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:9"
      },
      "items": [
        {
          "text": "pakuti Inu ndinu amene mwachita zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.9",
            "verseOrgIds": [
              "PSA.39.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 39:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chotsani mkwapulo wanu pa ine;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:10"
      },
      "items": [
        {
          "text": "ndagonjetsedwa ndi nkhonya ya dzanja lanu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.10",
            "verseOrgIds": [
              "PSA.39.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 39:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mumadzudzula ndi kulanga anthu chifukwa cha tchimo lawo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:11"
      },
      "items": [
        {
          "text": "mumawononga chuma chawo monga njenjete;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:11"
      },
      "items": [
        {
          "text": "munthu aliyense ali ngati mpweya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.11",
            "verseOrgIds": [
              "PSA.39.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "PSA 39:11"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.39.11",
                "verseOrgIds": [
                  "PSA.39.12"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 39:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Imvani pemphero langa Inu Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "mverani kulira kwanga kopempha thandizo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "musakhale chete pamene ndikulirira kwa Inu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "popeza ndine mlendo wanu wosakhalitsa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:12"
      },
      "items": [
        {
          "text": "monga anachitira makolo anga onse.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.12",
            "verseOrgIds": [
              "PSA.39.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 39:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musandiyangʼane mwaukali, choncho ndidzatha kusangalala",
          "type": "text",
          "attrs": {
            "verseId": "PSA.39.13",
            "verseOrgIds": [
              "PSA.39.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 39:13"
      },
