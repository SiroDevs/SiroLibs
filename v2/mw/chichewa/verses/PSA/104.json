        {
          "text": "Salimo 104",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 104:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamanda Yehova, iwe moyo wanga.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 104:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 104:1"
      },
      "items": [
        {
          "text": "Inu Yehova Mulungu wanga, ndinu wamkulu kwambiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:1"
      },
      "items": [
        {
          "text": "mwavala ulemerero ndi ufumu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.1",
            "verseOrgIds": [
              "PSA.104.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 104:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye wadzifunditsa kuwala ngati chovala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:2"
      },
      "items": [
        {
          "text": "watambasula miyamba ngati tenti",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.2",
            "verseOrgIds": [
              "PSA.104.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 104:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo wayika pa madzi mitanda ya chipinda chake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "Iye amasandutsa mitambo kukhala galeta lake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:3"
      },
      "items": [
        {
          "text": "ndi kuwuluka pa mapiko a mphepo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.3",
            "verseOrgIds": [
              "PSA.104.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 104:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amapanga mphepo kukhala amithenga ake,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:4"
      },
      "items": [
        {
          "text": "malawi amoto kukhala atumiki ake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.4",
            "verseOrgIds": [
              "PSA.104.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 104:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anakhazikitsa dziko lapansi pa maziko ake;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:5"
      },
      "items": [
        {
          "text": "silingasunthike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.5",
            "verseOrgIds": [
              "PSA.104.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 104:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munaliphimba ndi nyanja yozama ngati chovala;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:6"
      },
      "items": [
        {
          "text": "madzi anayimirira pamwamba pa mapiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.6",
            "verseOrgIds": [
              "PSA.104.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 104:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pakudzudzula kwanu madzi anathawa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:7"
      },
      "items": [
        {
          "text": "pa mkokomo wa bingu lanu iwo anamwazika;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.7",
            "verseOrgIds": [
              "PSA.104.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 104:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu munamiza mapiri,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:8"
      },
      "items": [
        {
          "text": "iwo anatsikira ku zigwa",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:8"
      },
      "items": [
        {
          "text": "kumalo kumene munawakonzera.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.8",
            "verseOrgIds": [
              "PSA.104.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 104:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu munayika malire ndipo sangathe kudutsa,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:9"
      },
      "items": [
        {
          "text": "iwo sadzamizanso dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.9",
            "verseOrgIds": [
              "PSA.104.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 104:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye achititsa akasupe kutulutsa madzi kupita ku zigwa;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:10"
      },
      "items": [
        {
          "text": "madziwo amayenda pakati pa mapiri.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.10",
            "verseOrgIds": [
              "PSA.104.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 104:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amapereka madzi kwa zirombo zonse zakuthengo;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:11"
      },
      "items": [
        {
          "text": "abulu akuthengo amapha ludzu lawo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.11",
            "verseOrgIds": [
              "PSA.104.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 104:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbalame zamlengalenga zimayika zisa mʼmbali mwa madzi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:12"
      },
      "items": [
        {
          "text": "zimayimba pakati pa thambo.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.12",
            "verseOrgIds": [
              "PSA.104.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 104:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amathirira mapiri kuchokera ku zipinda zake zapamwamba;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:13"
      },
      "items": [
        {
          "text": "dziko lapansi limakhutitsidwa ndi chipatso cha ntchito yake.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.13",
            "verseOrgIds": [
              "PSA.104.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PSA 104:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amameretsa udzu kuti ngʼombe zidye,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "ndi zomera, kuti munthu azilima",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:14"
      },
      "items": [
        {
          "text": "kubweretsa chakudya kuchokera mʼdziko lapansi:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.14",
            "verseOrgIds": [
              "PSA.104.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PSA 104:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "vinyo amene amasangalatsa mtima wa munthu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "text": "mafuta amene amachititsa nkhope yake kuwala,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:15"
      },
      "items": [
        {
          "text": "ndi buledi amene amapereka mphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.15",
            "verseOrgIds": [
              "PSA.104.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PSA 104:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitengo ya Yehova ndi yothiriridwa bwino,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 104:16"
      },
      "items": [
        {
          "text": "mikungudza ya ku Lebanoni imene Iye anadzala.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.104.16",
            "verseOrgIds": [
              "PSA.104.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PSA 104:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbalame zimamanga zisa zawo;",
          "type": "text",
          "attrs": {
