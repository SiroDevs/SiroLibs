  "verseCount": 50,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "NUM 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kora, Datani ndi Abiramu Awukira Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora mwana wa Izihari, mwana wa Kohati, mwana wa Levi ndi Datani ndi Abiramu ana a Eliabu, pamodzi ndi Oni mwana wa Perezi, ana a Rubeni, anayamba kudzikuza,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.1",
            "verseOrgIds": [
              "NUM.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anawukira Mose. Mʼgulu mwawo munali atsogoleri a Aisraeli 250, anthu otchuka amene anasankhidwa ndi anthu pa msonkhano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.2",
            "verseOrgIds": [
              "NUM.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anasonkhana kudzatsutsana ndi Mose ndi Aaroni nawawuza kuti, \"Mwawonjeza! Anthu onsewa ndi oyera, aliyense wa iwo, ndipo Yehova ali pakati pawo. Chifukwa chiyani mukudzikuza pakati pa gulu lonse la Yehova?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.3",
            "verseOrgIds": [
              "NUM.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose atamva izi, anagwa chafufumimba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.4",
            "verseOrgIds": [
              "NUM.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo iye anawuza Kora ndi anthu onse amene ankamutsatira kuti, \"Yehova mawa mmawa adzasonyeza yemwe ndi wake ndiponso amene ndi woyera mtima. Munthuyo adzabwera pafupi ndi Iye. Munthu amene adzamusankheyo adzamusendeza pafupi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.5",
            "verseOrgIds": [
              "NUM.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe Kora pamodzi ndi onse amene akukutsatira chitani izi: Tengani zofukizira",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.6",
            "verseOrgIds": [
              "NUM.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo mawa muyikemo moto ndi lubani pamaso pa Yehova. Munthu amene Yehova amusankhe ndiye amene ali woyera. Alevi inu mwawonjeza kwambiri!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.7",
            "verseOrgIds": [
              "NUM.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anawuzanso Kora kuti, \"Inu Alevi, tsopano tamverani!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.8",
            "verseOrgIds": [
              "NUM.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi sizinakukwanireni kuti Mulungu wa Israeli anakupatulani pakati pa gulu lonse la Aisraeli ndi kukubweretsani pafupi ndi Iye, kuti muzigwira ntchito ku nyumba ya Yehova ndi kumayima pamaso pa gulu, kumatumikira?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.9",
            "verseOrgIds": [
              "NUM.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakubweretsa iwe pamodzi ndi Alevi anzako kufupi ndi Iye mwini. Koma tsopano ukufuna kutenganso unsembe.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.10",
            "verseOrgIds": [
              "NUM.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkulakwira Yehova kuti iwe ndi gulu lako lonseli mwasonkhana kuti mutsutsane ndi Yehova. Kodi Aaroni ndani kuti muzikangana naye?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.11",
            "verseOrgIds": [
              "NUM.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mose anayitana Datani ndi Abiramu, ana aamuna a Eliabu koma iwo anati, \"Sitibwera!",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.12",
            "verseOrgIds": [
              "NUM.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi sikukwanira kuti unatitulutsa, kutichotsa mʼdziko loyenda mkaka ndi uchi kuti udzatiphe mʼchipululu muno? Kodi tsopano ukufunanso kutilemetsa?",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.13",
            "verseOrgIds": [
              "NUM.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwonjezera apo, sunatilowetse mʼdziko loyenda mkaka ndi uchi kapena kutipatsa malo wolima ndi minda ya mpesa. Kodi ukufuna kuchotsa maso a anthuwa? Ayi, sitibwera!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.14",
            "verseOrgIds": [
              "NUM.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Mose anakwiya kwambiri ndipo anati kwa Yehova, \"Musalandire chopereka chawo. Sindinatenge kalikonse kwa iwo ngakhale bulu, ndiponso sindinalakwire wina aliyense wa iwo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.15",
            "verseOrgIds": [
              "NUM.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anati kwa Kora, \"Iwe ndi okutsatira onse mudzaonekere pamaso pa Yehova mawa, iweyo ndi iwowo pamodzi ndi Aaroni.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.16",
            "verseOrgIds": [
              "NUM.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu aliyense akatenge chofukizira ndi kuyikamo lubani, zofukizira 250 zonse pamodzi ndi kuzibweretsa pamaso pa Yehova. Iwe ndi Aaroni mudzabweretsenso zofukizira zanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.17",
            "verseOrgIds": [
              "NUM.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NUM 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho munthu aliyense anatenga chofukizira chake nayikamo moto ndi lubani, ndipo anayima pamodzi ndi Mose ndi Aaroni pa khomo la tenti ya msonkhano.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.18",
            "verseOrgIds": [
              "NUM.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NUM 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kora atasonkhanitsa omutsatira ake onse amene amatsutsa nawo pa khomo la tenti ya msonkhano, ulemerero wa Yehova unaonekera kwa gulu lonselo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.19",
            "verseOrgIds": [
              "NUM.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "NUM 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anawuza Mose ndi Aaroni kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.20",
            "verseOrgIds": [
              "NUM.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chokani pakati pa gulu ili kuti ndithetse mkanganowu kamodzinʼkamodzi.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.21",
            "verseOrgIds": [
              "NUM.16.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Mose ndi Aaroni anadzigwetsa chafufumimba ndipo analira mokweza, \"Chonde Mulungu, Mulungu wa mizimu ya anthu onse, kodi mudzakwiyira gulu lonse pamene munthu mmodzi yekha ndiye amene wachimwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.22",
            "verseOrgIds": [
              "NUM.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yehova anawuza Mose kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.23",
            "verseOrgIds": [
              "NUM.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uza gulu lonse kuti, 'Khalani kutali ndi matenti a Kora, Datani ndi Abiramu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.24",
            "verseOrgIds": [
              "NUM.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anayimirira napita kwa Datani, Abiramu ndi kwa akuluakulu a Israeli amene ankamutsatira.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.25",
            "verseOrgIds": [
              "NUM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anachenjeza gulu lonse kuti, \"Khalani kutali ndi matenti a anthu oyipawa! Musakhudze kanthu kawo kalikonse, mukatero mudzawonongedwa limodzi nawo chifukwa cha machimo awo.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.26",
            "verseOrgIds": [
              "NUM.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anthuwo anachokadi ku matenti a Kora, Datani ndi Abiramu. Datani ndi Abiramu anali atatuluka nayima pamodzi ndi akazi awo, ana awo ndi makanda awo pa makomo a matenti awo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.27",
            "verseOrgIds": [
              "NUM.16.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mose anati, \"Umu ndi mmene mudzadziwire kuti Yehova ndiye amene anandituma kuti ndichite zinthu zonsezi ndipo kuti si maganizo anga.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.28",
            "verseOrgIds": [
              "NUM.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati anthu awa afa ndi imfa ya chilengedwe ndi kuwachitikira zomwe zimachitikira munthu aliyense, ndiye kuti Yehova sananditume.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.29",
            "verseOrgIds": [
              "NUM.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova akachita china chake chachilendo, nthaka nitsekula pakamwa pake ndi kuwameza iwo pamodzi ndi zonse zimene ali nazo, iwowa nʼkulowa mʼmanda ali moyo, pamenepo mudzazindikira kuti anthu amenewa ananyoza Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.30",
            "verseOrgIds": [
              "NUM.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atangotsiriza kuyankhula zimenezi, nthaka ya pamene anayimapo inagawikana",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.31",
            "verseOrgIds": [
              "NUM.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo dziko linatsekula pakamwa pake ndi kuwameza pamodzi ndi nyumba zawo ndi anthu onse a Kora ndi katundu wawo yense.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.32",
            "verseOrgIds": [
              "NUM.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NUM 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Analowa mʼmanda amoyo pamodzi ndi zonse zimene anali nazo. Nthaka inawatsekera ndi kuwawononga ndipo sanaonekenso.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.33",
            "verseOrgIds": [
              "NUM.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamva kulira kwawo, Aisraeli onse amene anali pafupi ndi anthuwo anathawa akufuwula kuti, \"Nthaka imezanso ife!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.34",
            "verseOrgIds": [
              "NUM.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo moto wochokera kwa Yehova unabwera nʼkunyeketsa anthu 250 amene ankapereka nsembe yofukiza aja.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.35",
            "verseOrgIds": [
              "NUM.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anawuza Mose kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.36",
            "verseOrgIds": [
              "NUM.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Uza Eliezara mwana wa Aaroni, wansembe kuti atenge zofukizirazo pakati pa mitembo yopsererayo ndipo amwazire makalawo kutali chifukwa zofukizirazo nʼzopatulika.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.37",
            "verseOrgIds": [
              "NUM.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NUM 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi ndi zofukizira za anthu omwe anafa chifukwa cha uchimo wawo. Musule zofukizirazo kuti zikhale zophimbira pa guwa lansembe, chifukwa zinaperekedwa kwa Yehova ndipo ndi zopatulika. Zimenezi zikhale chizindikiro kwa Aisraeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.38",
            "verseOrgIds": [
              "NUM.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Eliezara, wansembe, anasonkhanitsa zofukizira zamkuwa zija zomwe anthu opsererawo anabwera nazo ndipo anazisula kuti zikhale zophimbira pa guwa lansembe,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.39",
            "verseOrgIds": [
              "NUM.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "NUM 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "monga momwe Yehova anamulangizira kudzera mwa Mose. Chimenechi chinali chikumbutso kwa Aisraeli kuti munthu wina aliyense, kupatula zidzukulu za Aaroni, sayenera kupsereza lubani pamaso pa Yehova, kuopa kuti munthu woteroyo angakhale ngati Kora ndi omutsatira ake.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.40",
            "verseOrgIds": [
              "NUM.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NUM 16:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lotsatira, gulu lonse la Aisraeli linatsutsana ndi Mose ndi Aaroni. Iwo anati, \"Inu mwapha anthu a Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.41",
            "verseOrgIds": [
              "NUM.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NUM 16:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene anthuwo anasonkhana kuti atsutsane ndi Mose ndi Aaroni, atatembenuka kuyangʼana ku tenti ya msonkhano, mwadzidzidzi mtambo unaphimba tentiyo ndipo ulemerero wa Yehova unaonekera.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.42",
            "verseOrgIds": [
              "NUM.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "NUM 16:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Mose ndi Aaroni anapita patsogolo pa tenti ya msonkhano ija",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.43",
            "verseOrgIds": [
              "NUM.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "NUM 16:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo Yehova anawuza Mose kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.44",
            "verseOrgIds": [
              "NUM.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "NUM 16:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chokani pakati pa gulu la anthuwa kuti ndiwawononge kamodzinʼkamodzi.\" Ndipo iwo anagwa pansi chafufumimba.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.45",
            "verseOrgIds": [
              "NUM.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "NUM 16:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mose anawuza Aaroni kuti, \"Tenga chofukizira chako ndipo ikamo lubani pamodzi ndi moto wochokera pa guwa lansembe, fulumira, pita pa gulu la anthuwo ndipo ukachite nsembe yopepesera machimo awo popeza mkwiyo wa Yehova wafika, mliri wayamba.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.46",
            "verseOrgIds": [
              "NUM.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "NUM 16:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Aaroni anachita monga ananenera Mose, nathamangira mʼkatikati mwa gulu la anthuwo. Pamenepo nʼkuti mliri utayamba kale pakati pa anthu aja ndipo Aaroni anafukiza lubani ndi kupereka nsembe yopepesera machimo awo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.47",
            "verseOrgIds": [
              "NUM.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "NUM 16:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayimirira pakati pa anthu amoyo ndi akufa ndipo mliri unaleka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.48",
            "verseOrgIds": [
              "NUM.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "NUM 16:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe anthu 14, 700 anafa ndi mliriwo, kuwonjezera pa aja amene anafa chifukwa cha Kora.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.49",
            "verseOrgIds": [
              "NUM.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "NUM 16:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Aaroni anabwerera kwa Mose ku khomo la tenti ya msonkhano, chifukwa mliriwo unali utatha.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.16.50",
            "verseOrgIds": [
              "NUM.17.15"
            ]
          }
        }
      ]
    }
  ],
