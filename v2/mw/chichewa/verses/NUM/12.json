  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "NUM 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Miriamu ndi Aaroni Atsutsana ndi Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NUM 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miriamu ndi Aaroni anayamba kuyankhula motsutsana ndi Mose chifukwa cha mkazi wa ku Kusi, popeza Moseyo anakwatira Mkusi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.1",
            "verseOrgIds": [
              "NUM.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwowo anafunsa kuti, \"Kodi Yehova anayankhula kudzera mwa Mose yekha? Kodi sanayankhule kudzeranso mwa ife?\" Ndipo Yehova anamva zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.2",
            "verseOrgIds": [
              "NUM.12.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Koma Mose anali munthu wodzichepetsa kwambiri kuposa munthu aliyense pa dziko lapansi).",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.3",
            "verseOrgIds": [
              "NUM.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi yomweyo Yehova anati kwa Mose, Aaroni ndi Miriamu, \"Bwerani ku tenti ya msonkhano nonse atatu.\" Ndipo atatuwo anapitadi kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.4",
            "verseOrgIds": [
              "NUM.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yehova anatsika mu mtambo, nayima pa khomo la chihema. Kenaka anayitana Aaroni ndi Miriamu. Ndipo onse awiri atapita patsogolo,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.5",
            "verseOrgIds": [
              "NUM.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu anati, \"Mverani mawu anga:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "\"Pakakhala mneneri wa Yehova pakati panu,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "ndimadzionetsera kwa iyeyo mʼmasomphenya,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:6"
      },
      "items": [
        {
          "text": "ndimayankhula naye mʼmaloto.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.6",
            "verseOrgIds": [
              "NUM.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma sinditero ndi Mose mtumiki wanga;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.7",
            "verseOrgIds": [
              "NUM.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:7"
      },
      "items": [
        {
          "text": "Iyeyu ndi wokhulupirika mʼnyumba yanga yonse.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.7",
            "verseOrgIds": [
              "NUM.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndimayankhula naye maso ndi maso,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "momveka bwino osati mophiphiritsa;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "ndipo amaona maonekedwe a Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "Nʼchifukwa chiyani simunaope",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "NUM 12:8"
      },
      "items": [
        {
          "text": "kuyankhula motsutsana ndi Mose mtumiki wanga?\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.8",
            "verseOrgIds": [
              "NUM.12.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anawakwiyira, nachoka.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.9",
            "verseOrgIds": [
              "NUM.12.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene mtambo unachoka pamwamba pa Chihema, taonani, Miriamu anagwidwa ndi khate. Aaroni atachewuka anaona Miriamu ali ndi khate;",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.10",
            "verseOrgIds": [
              "NUM.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo Aaroni anawuza Mose kuti, \"Pepani mbuye wanga, musatilange chifukwa cha tchimo limene tachita mopusa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.11",
            "verseOrgIds": [
              "NUM.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Musalole kuti Miriamu akhale ngati mwana wobadwa wakufa kuchoka mʼmimba mwa amayi ake, thupi lake litawonongeka.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.12",
            "verseOrgIds": [
              "NUM.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mose anafuwulira Yehova kuti, \"Chonde Inu Mulungu, muchiritseni!\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.13",
            "verseOrgIds": [
              "NUM.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankha Mose kuti, \"Abambo ake akanamulavulira malovu mʼmaso, kodi sakanakhala wonyozeka masiku asanu ndi awiri? Mutsekereni kunja kwa msasa masiku asanu ndi awiri, kenaka mumulowetsenso.\"",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.14",
            "verseOrgIds": [
              "NUM.12.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anamutsekera Miriamu kunja kwa msasa masiku asanu ndi awiri ndipo anthu sanayende ulendo wawo mpaka Miriamu atamulowetsanso.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.15",
            "verseOrgIds": [
              "NUM.12.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake anthu ananyamuka ku Heziroti ndi kukamanga mʼchipululu cha Parani.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.12.16",
            "verseOrgIds": [
              "NUM.12.16"
            ]
          }
        }
      ]
    }
  ],
