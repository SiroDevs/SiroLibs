  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "ECC 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinaona choyipa china pansi pano, ndipo chimasautsa anthu kwambiri:",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.1",
            "verseOrgIds": [
              "ECC.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amapereka chuma, zinthu ndi ulemu kwa munthu, kotero kuti munthuyo sasowa kanthu kalikonse kamene akukalakalaka, koma Mulungu samulola kuti adyerere zinthuzo, ndipo mʼmalo mwake amadyerera ndi mlendo. Izi ndi zopandapake, ndi zoyipa kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.2",
            "verseOrgIds": [
              "ECC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale munthu atabereka ana 100 ndi kukhala ndi moyo zaka zambiri; komatu ngakhale atakhala zaka zambiri chotani, ngati iye sangadyerere chuma chake ndi kuyikidwa mʼmanda mwaulemu, ine ndikuti mtayo umamuposa iyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.3",
            "verseOrgIds": [
              "ECC.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtayo umangopita pachabe ndipo umapita mu mdima, ndipo mu mdimamo dzina lake limayiwalika.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.4",
            "verseOrgIds": [
              "ECC.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakhale kuti mtayowo sunaone dzuwa kapena kudziwa kanthu kalikonse, koma umapumula kuposa munthu uja,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.5",
            "verseOrgIds": [
              "ECC.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngakhale munthuyo atakhala ndi moyo zaka 2,000, koma ndi kulephera kudyerera chuma chake. Kodi onsewa sapita malo amodzi?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.6",
            "verseOrgIds": [
              "ECC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito yonse ya munthu imathera pakamwa pake,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:7"
      },
      "items": [
        {
          "text": "komatu iye sakhutitsidwa ndi pangʼono pomwe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.7",
            "verseOrgIds": [
              "ECC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi munthu wanzeru",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:8"
      },
      "items": [
        {
          "text": "amaposa motani chitsiru?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 6:8"
      },
      "items": [
        {
          "text": "Kodi munthu wosauka amapindula chiyani",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:8"
      },
      "items": [
        {
          "text": "podziwa kukhala bwino pamaso pa anthu ena?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.8",
            "verseOrgIds": [
              "ECC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli bwino kumangoona zinthu ndi maso",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:9"
      },
      "items": [
        {
          "text": "kusiyana ndi kumangozilakalaka mu mtima.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 6:9"
      },
      "items": [
        {
          "text": "Izinso ndi zopandapake,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:9"
      },
      "items": [
        {
          "text": "nʼkungodzivuta chabe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.9",
            "verseOrgIds": [
              "ECC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chilichonse chimene chilipo anachitchula kale dzina,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:10"
      },
      "items": [
        {
          "text": "za mmene munthu alili nʼzodziwika;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 6:10"
      },
      "items": [
        {
          "text": "sangathe kutsutsana ndi munthu",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:10"
      },
      "items": [
        {
          "text": "amene ali wamphamvu kupambana iyeyo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.10",
            "verseOrgIds": [
              "ECC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu akachuluka",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:11"
      },
      "items": [
        {
          "text": "zopandapake zimachulukanso,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 6:11"
      },
      "items": [
        {
          "text": "nanga munthu zimamupindulira chiyani?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.11",
            "verseOrgIds": [
              "ECC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ndani amene amadziwa chomwe ndi chabwino pa moyo wa munthu, pakuti moyo wake ndi wa masiku ochepa ndi opandapake, umangopitira ngati mthunzi. Ndani amene angamufotokozere zimene zidzachitika pansi pano iye atapita?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.6.12",
            "verseOrgIds": [
              "ECC.6.12"
            ]
          }
        }
      ]
    }
  ],
