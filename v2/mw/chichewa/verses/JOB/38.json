  "verseCount": 41,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "38",
        "style": "c",
        "sid": "JOB 38"
      },
      "items": [
        {
          "text": "38",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehova Ayankhula",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 38:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apo Yehova anamuyankha Yobu mʼkamvuluvulu. Ndipo anati:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.1",
            "verseOrgIds": [
              "JOB.38.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 38:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi uyu ndani amene akusokoneza uphungu wanga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:2"
      },
      "items": [
        {
          "text": "poyankhula mawu opanda nzeru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.2",
            "verseOrgIds": [
              "JOB.38.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 38:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onetsa chamuna;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "ndikufunsa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:3"
      },
      "items": [
        {
          "text": "ndipo undiyankhe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.3",
            "verseOrgIds": [
              "JOB.38.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 38:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi unali kuti pamene ndinkayika maziko a dziko lapansi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:4"
      },
      "items": [
        {
          "text": "Ndiwuze ngati ukudziwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.4",
            "verseOrgIds": [
              "JOB.38.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 38:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndani amene analemba malire ake? Ndithudi iwe ukudziwa!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:5"
      },
      "items": [
        {
          "text": "Ndani amene anayeza ndi chingwe dzikoli?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.5",
            "verseOrgIds": [
              "JOB.38.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 38:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi maziko ake anawakumba potani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:6"
      },
      "items": [
        {
          "text": "kapena ndani anayika mwala wake wapangodya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.6",
            "verseOrgIds": [
              "JOB.38.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 38:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamene nyenyezi za kummawa zinkayimba pamodzi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:7"
      },
      "items": [
        {
          "text": "ndipo angelo onse a Mulungu ankafuwula mokondwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.7",
            "verseOrgIds": [
              "JOB.38.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 38:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi ndani amene anatsekera nyanja pamene inkalengedwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:8"
      },
      "items": [
        {
          "text": "pamene inkachita ngati kutumphuka pansi pa dziko,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.8",
            "verseOrgIds": [
              "JOB.38.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamene ndinasandutsa mitambo kukhala chovala chake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:9"
      },
      "items": [
        {
          "text": "ndi kuyikulunga mu mdima wandiweyani,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.9",
            "verseOrgIds": [
              "JOB.38.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 38:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamene ndinayilembera malire ake",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:10"
      },
      "items": [
        {
          "text": "ndikuyikira zitseko ndi mipiringidzo yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.10",
            "verseOrgIds": [
              "JOB.38.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 38:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ndinati, 'Ufike mpaka apa ndipo usapitirire",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:11"
      },
      "items": [
        {
          "text": "apa ndiye pamene mafunde ako amphamvuwo azilekezera?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.11",
            "verseOrgIds": [
              "JOB.38.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 38:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi chibadwire chako unalamulapo dzuwa kuti lituluke mmawa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:12"
      },
      "items": [
        {
          "text": "kapena kuti mʼbandakucha ukhalepo pa nthawi yake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.12",
            "verseOrgIds": [
              "JOB.38.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 38:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti kuwalako kuwunikire dziko lonse lapansi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:13"
      },
      "items": [
        {
          "text": "ndi kuthamangitsa anthu oyipa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.13",
            "verseOrgIds": [
              "JOB.38.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 38:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha kuwala kwa usana mapiri ndi zigwa zimaonekera bwino ngati zilembo za chidindo pa mtapo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:14"
      },
      "items": [
        {
          "text": "zimaonekera bwino ngati makwinya a chovala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.14",
            "verseOrgIds": [
              "JOB.38.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 38:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwala kwa dzuwako sikuwafikira anthu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:15"
      },
      "items": [
        {
          "text": "ndipo dzanja lawo silingathe kuchita kanthu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.15",
            "verseOrgIds": [
              "JOB.38.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 38:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi unayendapo pansi penipeni pa nyanja",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:16"
      },
      "items": [
        {
          "text": "kapena pa magwero ake ozama?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.16",
            "verseOrgIds": [
              "JOB.38.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 38:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi anakuonetsapo zipata za imfa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:17"
      },
      "items": [
        {
          "text": "Kodi unaonako ku dziko la anthu akufa kumene kuli mdima wandiweyani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.17",
            "verseOrgIds": [
              "JOB.38.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 38:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi kukula kwa dziko lapansi umakudziwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 38:18"
      },
      "items": [
        {
          "text": "Undiwuze ngati ukuzidziwa zonsezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.38.18",
            "verseOrgIds": [
              "JOB.38.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
