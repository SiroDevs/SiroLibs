  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "JOB 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mtima wanga ukulumphalumpha pa chimenechinso",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:1"
      },
      "items": [
        {
          "text": "ndipo ukuchoka mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamverani! Tamverani kubangula kwa liwu lake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:2"
      },
      "items": [
        {
          "text": "kugunda kumene kukuchokera mʼkamwa mwake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amaponya chingʼaningʼani chake pansi pa thambo lonse",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:3"
      },
      "items": [
        {
          "text": "ndipo amachitumiza ku dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake kubangula kwake kumamveka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "Iye amabangula ndi liwu lake laulemerero.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "Pamene wabangula,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "palibe chimene amalephera kuchita.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liwu la Mulungu limabangula mʼnjira zambiri zodabwitsa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:5"
      },
      "items": [
        {
          "text": "Iye amachita zinthu zazikulu zimene sitingathe kuzimvetsa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amalamula chisanu chowundana kuti, 'Igwa pa dziko lapansi,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:6"
      },
      "items": [
        {
          "text": "ndipo amalamulanso mvula yamawawa kuti, 'Khala mvula yamphamvu.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti anthu onse amene anawalenga athe kuzindikira ntchito yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:7"
      },
      "items": [
        {
          "text": "Iye amalepheretsa anthu kugwira ntchito zawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zirombo zimakabisala",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:8"
      },
      "items": [
        {
          "text": "ndipo zimakhala mʼmaenje mwawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mphepo yamkuntho imatuluka ku malo ake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:9"
      },
      "items": [
        {
          "text": "kuzizira kumatuluka mʼmphepo yamkunthoyo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpweya wa Mulungu umawunditsa madzi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:10"
      },
      "items": [
        {
          "text": "ndipo madzi a mʼnyanja amawuma kuti gwaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amadzaza mitambo ndi madzi a mvula,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:11"
      },
      "items": [
        {
          "text": "amabalalitsa zingʼaningʼani zake kuchokera mʼmitambomo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu amayendetsa mitamboyo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:12"
      },
      "items": [
        {
          "text": "mozungulirazungulira dziko lonse lapansi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:12"
      },
      "items": [
        {
          "text": "kuti ichite zonse zimene Iye akufuna pa dziko lapansi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye amagwetsa mvula kuti alange anthu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:13"
      },
      "items": [
        {
          "text": "kapena kubweretsa chinyontho pa dziko lapansi kuti aonetse chikondi chake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abambo Yobu, tamvani izi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:14"
      },
      "items": [
        {
          "text": "imani ndipo muganizire ntchito zodabwitsa za Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mukudziwa momwe Mulungu amayendetsera mitambo",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:15"
      },
      "items": [
        {
          "text": "ndi kuchititsa kuti kukhale zingʼaningʼani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mukudziwa momwe Mulungu amayalira mitambo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:16"
      },
      "items": [
        {
          "text": "ntchito zodabwitsa za Iye amene ndi wanzeru zangwiro?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu amene mʼzovala zanu mumatuluka thukuta",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:17"
      },
      "items": [
        {
          "text": "pamene kunja kwatentha chifukwa cha mphepo yakummwera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 37:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kodi mungathe kuthandizana naye kutambasula thambo",
          "type": "text",
          "attrs": {
