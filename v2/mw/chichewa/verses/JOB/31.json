  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "31",
        "style": "c",
        "sid": "JOB 31"
      },
      "items": [
        {
          "text": "31",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 31:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndinachita pangano ndi maso anga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:1"
      },
      "items": [
        {
          "text": "kuti sindidzapenya namwali momusirira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.1",
            "verseOrgIds": [
              "JOB.31.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 31:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Mulungu kumwambako wandisungira zotani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:2"
      },
      "items": [
        {
          "text": "Kodi cholowa changa chochokera kwa Wamphamvuzonse kumwambako nʼchotani?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.2",
            "verseOrgIds": [
              "JOB.31.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 31:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi si chiwonongeko kwa anthu oyipa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:3"
      },
      "items": [
        {
          "text": "tsoka kwa iwo amene amachita zolakwa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.3",
            "verseOrgIds": [
              "JOB.31.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 31:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Mulungu saona zochita zanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:4"
      },
      "items": [
        {
          "text": "ndi kudziwa mayendedwe anga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.4",
            "verseOrgIds": [
              "JOB.31.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 31:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati ndachita zinthu mwachiphamaso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:5"
      },
      "items": [
        {
          "text": "kapena kufulumira kukachita zachinyengo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.5",
            "verseOrgIds": [
              "JOB.31.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 31:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mulungu andiyeze ndi muyeso wake wolungama",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:6"
      },
      "items": [
        {
          "text": "ndipo Iye adzadziwa kuti ine ndine wosalakwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.6",
            "verseOrgIds": [
              "JOB.31.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 31:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati mayendedwe anga asempha njira,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "ngati mtima wanga wakhumbira zimene maso anga aona,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:7"
      },
      "items": [
        {
          "text": "kapena ngati ndachita choyipa chilichonse.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.7",
            "verseOrgIds": [
              "JOB.31.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 31:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo ena adye zimene ndinadzala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:8"
      },
      "items": [
        {
          "text": "ndipo zomera zanga zizulidwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.8",
            "verseOrgIds": [
              "JOB.31.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 31:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati mtima wanga unakopekapo ndi mkazi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:9"
      },
      "items": [
        {
          "text": "ndipo ngati ndinalakalaka mkazi wa mnansi wanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.9",
            "verseOrgIds": [
              "JOB.31.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 31:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo mkazi wanga aphikire mwamuna wina chakudya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:10"
      },
      "items": [
        {
          "text": "ndipo amuna ena azigona naye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.10",
            "verseOrgIds": [
              "JOB.31.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 31:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti zimenezo zikanakhala zochititsa manyazi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:11"
      },
      "items": [
        {
          "text": "tchimo loyenera kulangidwa nalo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.11",
            "verseOrgIds": [
              "JOB.31.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 31:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi moto umene umayaka mpaka chiwonongeko;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:12"
      },
      "items": [
        {
          "text": "ukanapsereza zokolola zanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.12",
            "verseOrgIds": [
              "JOB.31.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 31:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati ndinkapondereza mlandu wa akapolo anga aamuna kapena aakazi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:13"
      },
      "items": [
        {
          "text": "pamene ankabwera kwa ine ndi milandu yawo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.13",
            "verseOrgIds": [
              "JOB.31.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 31:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndidzatani pamene Mulungu adzanditsutsa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:14"
      },
      "items": [
        {
          "text": "Nanga ndidzayankha chiyani akadzandifunsa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.14",
            "verseOrgIds": [
              "JOB.31.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 31:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi amene anapanga ine mʼmimba mwa amayi anga si yemwe anapanganso iwo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:15"
      },
      "items": [
        {
          "text": "Kodi si mmodzi yemweyo amene anatipanga tonsefe mʼmimba mwa amayi athu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.15",
            "verseOrgIds": [
              "JOB.31.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 31:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati ndinawamana aumphawi zinthu zimene ankazikhumba,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:16"
      },
      "items": [
        {
          "text": "kapena kuwagwiritsa fuwa lamoto akazi amasiye amene amafuna thandizo kwa ine,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.16",
            "verseOrgIds": [
              "JOB.31.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 31:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati chakudya changa ndinadya ndekha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:17"
      },
      "items": [
        {
          "text": "wosagawirako mwana wamasiye,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.17",
            "verseOrgIds": [
              "JOB.31.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 31:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "chonsechotu kuyambira unyamata wanga ndinamulera monga abambo ake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.18",
            "verseOrgIds": [
              "JOB.31.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:18"
      },
      "items": [
        {
          "text": "ndipo moyo wanga wonse ndakhala ndikusamalira akazi amasiye,",
          "type": "text",
          "attrs": {
