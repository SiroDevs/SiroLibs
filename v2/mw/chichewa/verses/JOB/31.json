      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:30"
      },
      "items": [
        {
          "text": "potulutsa matemberero a mdani wanga kuti awonongeke,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.30",
            "verseOrgIds": [
              "JOB.31.30"
            ]
          }
        }
      ]
    },
