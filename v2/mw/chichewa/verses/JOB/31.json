      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:23"
      },
      "items": [
        {
          "text": "ndinachitanso mantha ndi ulemerero wake, sindikanatha kuchita zinthu zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
      ]
    },
    {
