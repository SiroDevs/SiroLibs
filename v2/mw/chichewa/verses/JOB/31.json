          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOB 31:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu ine ndikanakoleka kalatayo pa phewa langa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.36",
            "verseOrgIds": [
              "JOB.31.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:36"
      },
      "items": [
        {
          "text": "ndikanayivala kumutu ngati chipewa chaufumu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.36",
            "verseOrgIds": [
              "JOB.31.36"
