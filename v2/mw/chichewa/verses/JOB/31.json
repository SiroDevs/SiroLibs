          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati ndinakondwera chifukwa choti chuma changa chinali chambiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
