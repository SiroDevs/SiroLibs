          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 31:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aa, pakanakhala wina wondimva!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:35"
      },
      "items": [
        {
          "text": "Tsopano ndikutsiriza mawu anga odzitetezera. Wamphamvuzonse andiyankhe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
