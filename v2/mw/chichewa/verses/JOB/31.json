          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza ine ndinaopa kwambiri chiwonongeko chochokera kwa Mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.23",
            "verseOrgIds": [
              "JOB.31.23"
            ]
          }
        }
