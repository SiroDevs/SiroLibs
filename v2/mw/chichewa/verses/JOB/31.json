      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "ndi kuchita mantha ndi mnyozo wa mafuko",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:34"
      },
      "items": [
        {
          "text": "kotero ndinakhala chete ndipo sindinatuluke panja.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.34",
            "verseOrgIds": [
              "JOB.31.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
