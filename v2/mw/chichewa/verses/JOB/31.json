      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:24"
      },
      "items": [
        {
          "text": "kapena kunena kwa golide wabwino kwambiri kuti, 'Iwe ndiye chitetezo changa,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.24",
            "verseOrgIds": [
              "JOB.31.24"
            ]
          }
        }
      ]
    },
    {
