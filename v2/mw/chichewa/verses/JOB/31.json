      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:26"
      },
      "items": [
        {
          "text": "kapena mwezi ukuyenda mwa ulemerero wake,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.26",
            "verseOrgIds": [
              "JOB.31.26"
            ]
          }
        }
      ]
    },
    {
