      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:32"
      },
      "items": [
        {
          "text": "pakuti khomo langa linali lotsekuka nthawi zonse kwa alendo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.32",
            "verseOrgIds": [
              "JOB.31.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 31:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati ndinabisa tchimo langa monga amachitira anthu ena,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.33",
            "verseOrgIds": [
              "JOB.31.33"
            ]
          }
        }
      ]
    },
