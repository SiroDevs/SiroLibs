      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:25"
      },
      "items": [
        {
          "text": "zinthu zimene manja anga anazipeza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.25",
            "verseOrgIds": [
              "JOB.31.25"
            ]
          }
        }
      ]
    },
    {
