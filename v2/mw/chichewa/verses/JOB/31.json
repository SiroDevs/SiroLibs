      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:35"
      },
      "items": [
        {
          "text": "mdani wanga achite kulemba pa kalata mawu ake ondineneza.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.35",
            "verseOrgIds": [
              "JOB.31.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
