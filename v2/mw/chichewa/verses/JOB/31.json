      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 31:29"
      },
      "items": [
        {
          "text": "kapena kusekera mavuto pamene mavuto anamugwera,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.31.29",
            "verseOrgIds": [
              "JOB.31.29"
            ]
          }
        }
      ]
    },
    {
