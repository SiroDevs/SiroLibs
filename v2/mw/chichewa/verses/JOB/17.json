  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOB 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mtima wanga wasweka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "masiku anga atha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "manda akundidikira.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithudi, anthu ondiseka andizungulira;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:2"
      },
      "items": [
        {
          "text": "maso anga akupenyetsetsa mdani wanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Inu Mulungu, patseni chikole chimene mukufuna.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:3"
      },
      "items": [
        {
          "text": "Ndani wina amene adzandiperekera ine chikole?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwatseka maganizo awo kuti asamvetse zinthu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:4"
      },
      "items": [
        {
          "text": "choncho simudzawalola kuti apambane.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu apereka mnzake chifukwa cha chuma,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:5"
      },
      "items": [
        {
          "text": "ana ake sadzaona mwayi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mulungu wandisandutsa chisudzo chochiseka aliyense,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:6"
      },
      "items": [
        {
          "text": "munthu amene anthu amalavulira malovu nkhope yake.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmaso mwanga mwada ndi chisoni;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:7"
      },
      "items": [
        {
          "text": "ndawonda ndi mutu womwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu olungama akudabwa nazo zimenezi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:8"
      },
      "items": [
        {
          "text": "anthu osachimwa akupsera mtima anthu osapembedza Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe anthu olungama adzasunga njira zawo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:9"
      },
      "items": [
        {
          "text": "ndipo anthu a makhalidwe abwino mphamvu zawo zidzanka zikuchuluka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono bwerani nonsenu, bwerezaninso mawu anuwo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:10"
      },
      "items": [
        {
          "text": "sindidzapezapo munthu wanzeru pakati panupo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku anga atha, zimene ndinakonza zalephereka,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:11"
      },
      "items": [
        {
          "text": "pamodzinso ndi zokhumba za mtima wanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu awa amasandutsa usiku kukhala usana,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:12"
      },
      "items": [
        {
          "text": "nthawi ya usiku iwo amati 'kwatsala pangʼono kucha.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati nyumba imene ndikuyiyembekezera ndi manda,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:13"
      },
      "items": [
        {
          "text": "ngati ndiyala bedi langa mu mdima,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngati ndinena kwa dzenje la manda 'ndinu abambo anga,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:14"
      },
      "items": [
        {
          "text": "ndiponso kwa mphutsi kuti, 'ndinu amayi anga' kapena 'mlongo wanga,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "tsono chiyembekezo changa chili kuti?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:15"
      },
      "items": [
        {
          "text": "Ndani angaone populumukira panga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu sindidzakhalanso ndi chiyembekezo chilichonse,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:16"
      },
      "items": [
        {
          "text": "polowa mʼmanda, pamene ndidzatsikira ku fumbi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    }
  ],
