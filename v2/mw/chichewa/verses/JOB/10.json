  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "JOB 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndatopa nawo moyo wanga;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "choncho ndidzanena zodandaula zanga momasuka",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:1"
      },
      "items": [
        {
          "text": "ndipo ndidzayankhula mwa kuwawidwa mtima kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.1",
            "verseOrgIds": [
              "JOB.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzati kwa Mulungu wanga: Musandiweruze kuti ndine wolakwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:2"
      },
      "items": [
        {
          "text": "koma mundiwuze chifukwa chimene Inu mukukanganira ndi ine.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.2",
            "verseOrgIds": [
              "JOB.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi mumakondwera mukamandizunza,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "kunyoza ntchito ya manja anu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:3"
      },
      "items": [
        {
          "text": "chonsecho mukusekerera ndi zochita za anthu oyipa?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.3",
            "verseOrgIds": [
              "JOB.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi maso anu ali ngati a munthu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:4"
      },
      "items": [
        {
          "text": "Kodi mumaona zinthu monga momwe amazionera munthu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.4",
            "verseOrgIds": [
              "JOB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi masiku anu ali ngati masiku a munthu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:5"
      },
      "items": [
        {
          "text": "kapena zaka zanu ngati zaka za munthu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.5",
            "verseOrgIds": [
              "JOB.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti Inu mufufuze zolakwa zanga",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:6"
      },
      "items": [
        {
          "text": "ndi kulondola tchimo langa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.6",
            "verseOrgIds": [
              "JOB.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ngakhale mukudziwa kuti sindine wolakwa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:7"
      },
      "items": [
        {
          "text": "ndiponso kuti palibe amene angandilanditse mʼdzanja lanu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.7",
            "verseOrgIds": [
              "JOB.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munandiwumba ndi kundipanga ndi manja anu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:8"
      },
      "items": [
        {
          "text": "Kodi tsopano Inu mudzatembenuka ndi kundiwononga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.8",
            "verseOrgIds": [
              "JOB.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbukirani kuti munandipanga ndi dothi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:9"
      },
      "items": [
        {
          "text": "kodi tsopano mundibwezeranso ku fumbi?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.9",
            "verseOrgIds": [
              "JOB.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suja munapatsa abambo anga mphamvu zoti andibale,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:10"
      },
      "items": [
        {
          "text": "suja munandikuza bwino mʼmimba mwa amayi anga?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.10",
            "verseOrgIds": [
              "JOB.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munandikuta ndi khungu ndi mnofu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:11"
      },
      "items": [
        {
          "text": "ndi kundilumikiza pamodzi ndi mafupa ndi mitsempha?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.11",
            "verseOrgIds": [
              "JOB.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munandipatsa moyo ndi kundionetsa chifundo chanu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:12"
      },
      "items": [
        {
          "text": "ndipo munasamalira bwino moyo wanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.12",
            "verseOrgIds": [
              "JOB.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Koma izi ndi zimene munabisa mu mtima mwanu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:13"
      },
      "items": [
        {
          "text": "ndipo ndikudziwa kuti zinali mʼmaganizo anu:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.13",
            "verseOrgIds": [
              "JOB.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti ngati ndingachimwe mudzakhala mukundipenyetsetsa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:14"
      },
      "items": [
        {
          "text": "ndipo kuti simudzalola kuti ndisalangidwe chifukwa cha kulakwa kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.14",
            "verseOrgIds": [
              "JOB.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ndili wolakwa, tsoka langa!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "Koma ngakhale ndili wosalakwa sindingathe kutukula mutu wanga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "pakuti ndagwidwa ndi manyazi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:15"
      },
      "items": [
        {
          "text": "ndipo ndamizidwa mʼmavuto anga.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.15",
            "verseOrgIds": [
              "JOB.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndikatukula mutu wanga, Inu mumandisaka ngati mkango",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:16"
      },
      "items": [
        {
          "text": "ndiponso mumandiopseza ndi mphamvu yanu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.16",
            "verseOrgIds": [
              "JOB.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mumabweretsa mboni zatsopano potsutsana nane",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 10:17"
      },
      "items": [
        {
          "text": "ndipo mkwiyo wanu pa ine umanka nukulirakulira ndi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.10.17",
            "verseOrgIds": [
              "JOB.10.17"
            ]
          }
        }
      ]
    },
    {
