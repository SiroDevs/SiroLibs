      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:22"
      },
      "items": [
        {
          "text": "Hatusi, Igala, Bariya, Neariya ndi Safati. Onse anali asanu ndi mmodzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
