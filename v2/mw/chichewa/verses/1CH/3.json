      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:22"
      },
      "items": [
        {
          "text": "Semaya ndi ana ake:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
        }
      ]
    },
