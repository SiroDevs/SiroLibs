      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:19"
      },
      "items": [
        {
          "text": "Mlongo wawo anali Selomiti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        }
      ]
    },
