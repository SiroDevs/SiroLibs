      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "1CH 3:19"
      },
      "items": [
        {
          "text": "Ana a Zerubabeli anali awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:19"
      },
      "items": [
        {
          "text": "Mesulamu ndi Hananiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
