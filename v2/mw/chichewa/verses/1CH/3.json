      "attrs": {
        "style": "li2",
        "vid": "1CH 3:24"
      },
      "items": [
        {
          "text": "Yohanani, Delaya ndi Anani, onse anali asanu ndi awiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.24",
