          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panalinso ana ena asanu awa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        }
