      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:23"
      },
      "items": [
        {
          "text": "Eliyoenai, Hezekiya ndi Azirikamu. Onse anali atatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.23",
            "verseOrgIds": [
              "1CH.3.23"
            ]
          }
        }
      ]
    },
