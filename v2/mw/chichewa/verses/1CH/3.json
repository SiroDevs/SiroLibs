      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 3:21"
      },
      "items": [
        {
          "text": "Pelatiya ndi Yesaiya, ndiponso ana a Refaya, ana a Arinani, ana a Obadiya ndi ana a Sekaniya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        }
      ]
    },
