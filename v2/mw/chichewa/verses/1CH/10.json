  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "1CH 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sauli Adzipha Yekha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Afilisti anachitanso nkhondo ndi Aisraeli ndipo Aisraeli anathawa Afilistiwo, kotero kuti ambiri anaphedwa pa phiri la Gilibowa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.1",
            "verseOrgIds": [
              "1CH.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afilisti anapanikiza kwambiri Sauli ndi ana ake, ndipo anapha Yonatani, Abinadabu ndi Maliki-Suwa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.2",
            "verseOrgIds": [
              "1CH.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nkhondo inakula kwambiri mozungulira Sauli ndipo pamene anthu amauta anamupeza, anamuvulaza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.3",
            "verseOrgIds": [
              "1CH.10.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Sauli anawuza mnyamata wake wonyamula zida zake kuti, \"Solola lupanga lako undiphe, kuopa kuti anthu osachita mdulidwewa angabwere ndi kudzandizunza ine.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1CH 10:4"
      },
      "items": [
        {
          "text": "Koma mnyamata wonyamula zida uja anachita mantha kwambiri ndipo sanathe kutero. Choncho Sauli anatenga lupanga lake lomwe nagwerapo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.4",
            "verseOrgIds": [
              "1CH.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mnyamata wonyamula zida zake uja ataona kuti Sauli wafa, nayenso anadzigwetsera pa lupanga lake nafa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.5",
            "verseOrgIds": [
              "1CH.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Motero Sauli ndi ana ake atatu anafa, pamodzi ndi banja lake lonse anafera limodzi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.6",
            "verseOrgIds": [
              "1CH.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene Aisraeli onse amene anali mʼchigwa anaona kuti gulu lankhondo lathawa komanso kuti Sauli ndi ana ake aphedwa, nawonso anathawa kusiya mizinda yawo. Ndipo Afilisti anabwera kudzakhalamo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.7",
            "verseOrgIds": [
              "1CH.10.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmawa mwake, Afilisti atabwera kudzatenga zinthu za anthu ophedwa, anapeza Sauli ndi ana ake atafa pa phiri la Gilibowa.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.8",
            "verseOrgIds": [
              "1CH.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anamuvula zovala zake, natenga mutu wake ndi zida zake zankhondo. Ndipo anatumiza amithenga mʼdziko lonse la Afilisti kukafalitsa nkhani yabwinoyi kwa mafano awo ndi kwa anthu awo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.9",
            "verseOrgIds": [
              "1CH.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo anayika zida zake zankhondo mʼnyumba zopembedzera milungu yawo ndipo anapachika mutu wake mʼnyumba ya Dagoni.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.10",
            "verseOrgIds": [
              "1CH.10.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene anthu onse okhala ku Yabesi Giliyadi anamva zimene Afilisti anachitira Sauli,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.11",
            "verseOrgIds": [
              "1CH.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "anthu awo onse olimba mtima anapita kukatenga mitembo ya Sauli ndi ana ake ndipo anabwera nayo ku Yabesi. Anakwirira mafupa awo pansi pa mtengo wabwemba ku Yabesi, ndipo anasala kudya masiku asanu ndi awiri.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.12",
            "verseOrgIds": [
              "1CH.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli anafa chifukwa anali wosakhulupirika pamaso pa Yehova. Iye sanasunge mawu a Yehova, pakuti anakafunsira nzeru kwa woyankhula ndi mizimu ya anthu akufa,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.13",
            "verseOrgIds": [
              "1CH.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "sanafunsire nzeruzo kwa Yehova. Choncho Yehova anamupha ndi kupereka ufumu kwa Davide mwana wa Yese.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.10.14",
            "verseOrgIds": [
              "1CH.10.14"
            ]
          }
        }
      ]
    }
  ],
