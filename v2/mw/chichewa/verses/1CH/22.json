  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "1CH 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Davide anati, \"Nyumba ya Yehova Mulungu idzakhala pano, ndiponso guwa lansembe zopsereza za Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.1",
            "verseOrgIds": [
              "1CH.22.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kukonzekera Kumanga Nyumba ya Mulungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Davide analamula kuti asonkhanitse alendo onse amene amakhala mu Israeli ndipo kuchokera pakati pawo anasankha amisiri a miyala kuti aseme miyala yomangira nyumba ya Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.2",
            "verseOrgIds": [
              "1CH.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anapereka zitsulo zambiri zopangira misomali ya zitseko za pa zipata ndi zolumikiza zake. Anaperekanso mkuwa wochuluka wokanika kuwuyeza.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.3",
            "verseOrgIds": [
              "1CH.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anaperekanso mitengo yambiri ya mkungudza, yosawerengeka, pakuti anthu a ku Sidoni ndi a ku Turo anabweretsa yambiri kwa Davide.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.4",
            "verseOrgIds": [
              "1CH.22.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anati, \"Mwana wanga Solomoni ndi wamngʼono ndipo sadziwa zambiri. Koma nyumba yomwe timangire Yehova iyenera kukhala yaulemerero, yotchuka ndi yokongola pamaso pa anthu a mitundu yonse. Choncho ndikonzekeratu zambiri.\" Motero Davide anayikonzekera kwambiri asanamwalire.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.5",
            "verseOrgIds": [
              "1CH.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono iye anayitana Solomoni mwana wake ndipo anamulamula kuti adzamangire nyumba Yehova Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.6",
            "verseOrgIds": [
              "1CH.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1CH 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anati kwa Solomoni, \"Mwana wanga, ine ndinali ndi maganizo oti ndimangire nyumba Dzina la Yehova Mulungu wanga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.7",
            "verseOrgIds": [
              "1CH.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1CH 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova anandiyankhula kuti, 'Iwe wapha anthu ambiri ndiponso wachita nkhondo zambiri. Sumangira dzina langa nyumba chifukwa wapha anthu ambiri pa dziko lapansi pamaso panga.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.8",
            "verseOrgIds": [
              "1CH.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma udzabala mwana wamwamuna amene adzakhala munthu wamtendere ndi wabata ndipo ndidzamupatsa mpumulo kuchokera kwa adani ake onse a mbali zonse. Dzina lake adzatchedwa Solomoni ndipo Ine ndidzapereka mtendere ndi bata kwa Israeli pa nthawi ya ulamuliro wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.9",
            "verseOrgIds": [
              "1CH.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye ndiye adzandimangire nyumba. Adzakhala mwana wanga ndipo Ine ndidzakhala abambo ake. Ndipo ndidzakhazikitsa mpando wake waufumu mʼdziko la Israeli mpaka muyaya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.10",
            "verseOrgIds": [
              "1CH.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano mwana wanga, Yehova akhale nawe ndipo upambane ndi kumanga Nyumba ya Yehova Mulungu wako, monga momwe Iye ananenera kuti udzatero.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.11",
            "verseOrgIds": [
              "1CH.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akupatse nzeru ndi kumvetsetsa pamene Iye adzakuyika kukhala wolamulira Israeli, kuti udzasunge malamulo a Yehova Mulungu wako.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.12",
            "verseOrgIds": [
              "1CH.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo udzapambana ngati udzamvera mosamala malangizo ndi malamulo amene Yehova anapereka kwa Aisraeli kudzera mwa Mose. Khala wamphamvu ndi wolimba mtima. Usachite mantha kapena kutaya mtima.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.13",
            "verseOrgIds": [
              "1CH.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine movutikira kwambiri ndapereka ku Nyumba ya Mulungu matani 3,400 agolide, matani 34,000 asiliva, ndiponso mkuwa ndi chitsulo, matabwa ndi miyala. Ndipo iwe utha kuwonjezerapo pa zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.14",
            "verseOrgIds": [
              "1CH.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe uli ndi antchito ambiri: osema miyala, amisiri a miyala, ndi amisiri a matabwa, komanso anthu ambiri aluso la ntchito zosiyanasiyana,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.15",
            "verseOrgIds": [
              "1CH.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "zagolide ndi zasiliva, zamkuwa, zazitsulo, amisiri osawerengeka. Tsopano yamba ntchito, ndipo Yehova akhale nawe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.16",
            "verseOrgIds": [
              "1CH.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Davide analamula atsogoleri onse a Israeli kuti athandize Solomoni mwana wake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.17",
            "verseOrgIds": [
              "1CH.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anawawuza kuti, \"Kodi Yehova Mulungu, sali nanu? Ndipo Iye siwakupatsani mpumulo mbali zonse? Pakuti Iyeyo wapereka eni nthaka kwa inu ndipo dziko lili pa ulamuliro wa Yehova ndi anthu ake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.18",
            "verseOrgIds": [
              "1CH.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono perekani mtima wanu ndi moyo wanu kufunafuna Yehova Mulungu wanu. Yambani kumanga malo opatulika a Yehova Mulungu, kuti mubweretse Bokosi la Chipangano la Yehova ndi zinthu zopatulika za Mulungu mʼNyumba ya Mulungu imene idzamangidwa chifukwa cha dzina la Yehova.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.22.19",
            "verseOrgIds": [
              "1CH.22.19"
            ]
          }
        }
      ]
    }
  ],
