              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "1CH 23:23"
      },
      "items": [
        {
          "text": "Mahili, Ederi ndi Yeremoti. Onse analipo atatu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.23",
            "verseOrgIds": [
              "1CH.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi zinali zidzukulu za Levi mwa mabanja awo, atsogoleri a mabanja monga momwe analembedwera mayina awo ndi monga momwenso anawerengedwera, banja lililonse pa lokha. Awa ndi anthu ogwira ntchito oyambira zaka makumi awiri zobadwa kapena kupitirirapo, amene amatumikira mʼNyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.24",
            "verseOrgIds": [
              "1CH.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1CH 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza Davide anati, \"Pakuti Yehova Mulungu wa Israeli, wapereka mpumulo kwa anthu ake ndipo wabwera kudzakhala mu Yerusalemu kwamuyaya,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.25",
            "verseOrgIds": [
              "1CH.23.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1CH 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "sikofunikiranso kuti Alevi azinyamula tenti kapena zipangizo za chipembedzo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.26",
            "verseOrgIds": [
              "1CH.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potsata malangizo otsiriza a Davide, Alevi anawerengedwa kuyambira amuna a zaka makumi awiri zakubadwa kapena kupitirirapo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.27",
            "verseOrgIds": [
              "1CH.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1CH 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ntchito ya Alevi inali kuthandiza zidzukulu za Aaroni pa ntchito yotumikira mʼNyumba ya Yehova monga kuyangʼanira mabwalo, zipinda zamʼmbali, kuyeretsa zinthu zonse zachipembedzo, ndiponso kuchita ntchito zina za mʼnyumba ya Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.28",
            "verseOrgIds": [
              "1CH.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1CH 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amayangʼanira buledi amene amayikidwa pa tebulo, ufa wa nsembe yachakudya, timitanda ta buledi wopanda yisiti: kuphika ndi kusakaniza, ndiponso miyeso yonse ndi kukula kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.29",
            "verseOrgIds": [
              "1CH.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo amayimiriranso mmawa uliwonse kuthokoza ndi kutamanda Yehova. Amachitanso chomwecho madzulo,",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.30",
            "verseOrgIds": [
              "1CH.23.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1CH 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndiponso popereka nsembe zopsereza kwa Yehova pa Sabata ndi pa chikondwerero cha Mwezi Watsopano, ndi pa nthawi yosankhidwa ya Chikondwerero. Iwo amatumikira pamaso pa Yehova nthawi zonse mwa chiwerengero chawo ndi momwe analangizidwira.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.31",
            "verseOrgIds": [
              "1CH.23.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1CH 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo kotero Alevi anachita ntchito yawo ya ku tenti ya msonkhano ya ku Malo Opatulika ndiponso molamulidwa ndi abale awo, zidzukulu za Aaroni, pa ntchito ya mʼNyumba ya Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.23.32",
            "verseOrgIds": [
              "1CH.23.32"
            ]
          }
        }
      ]
    }
  ],
