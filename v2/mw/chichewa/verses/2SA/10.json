  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2SA 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Davide agonjetsa Aamoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Patapita nthawi, mfumu ya Aamoni inamwalira, ndipo mwana wake Hanuni analowa ufumu mʼmalo mwake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide anaganiza kuti, \"Ine ndidzachitira chifundo Hanuni mwana wa Nahasi chifukwa abambo ake anandichitira zabwino.\" Choncho Davide anatumiza anthu kuti akamupepesere kwa Hanuni chifukwa cha imfa ya abambo ake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:2"
      },
      "items": [
        {
          "text": "Anthu amene Davide anawatuma atafika kwa Hanuni mʼdziko la Aamoni,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "atsogoleri a ankhondo a Aamoni anawuza Hanuni mbuye wawo kuti, \"Kodi mukuganiza kuti Davide akupereka ulemu kwa abambo anu potumiza anthuwa kwa inu kudzapepesa? Kodi Davide sanawatumize anthuwa kuti adzaone mzinda wanu ndi kuchita ukazitape ndi cholinga chofuna kuwulanda?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Hanuni anagwira anthu amene Davide anawatuma aja ndipo anameta munthu aliyense mbali imodzi ya ndevu zake, ndi kudula zovala zake pakati mʼchiwuno mpaka matako kuonekera, ndipo anawabweza kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamufotokozera Davide zimenezi, iye anatuma amithenga kukakumana ndi anthuwo chifukwa anali ndi manyazi kwambiri. Mfumu inati, \"Mukhale ku Yeriko mpaka ndevu zanu zitakula, ndipo kenaka mubwere kuno.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamoni atazindikira kuti amukwiyitsa kwambiri Davide, anakapeza ankhondo oyenda pansi aganyu okwanira 20,000 kuchokera ku Asiriya wa ku Beti Rehobu ndi Aramu-Zoba, komanso ankhondo 1,000 kwa mfumu Maaka ndiponso ankhondo 22,000 ochokera ku Tobu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.6",
            "verseOrgIds": [
              "2SA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide atamva zimenezi, anatumiza Yowabu ndi gulu lonse la ankhondo amphamvu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamoni anatuluka ndi kukhala mʼmizere ya nkhondo pa chipata cha mzinda wawo, pamene Aaramu a ku Aramu-Zoba ndi Rehobu ndi ankhondo a ku Tobu ndi Maaka anali kwa wokha ku malo wopanda mitengo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu ataona kuti kunali mizere ya ankhondo kutsogolo kwake ndi kumbuyo kwake, iye anasankha ena mwa ankhondo a Israeli odziwa kuchita bwino nkhondo ndipo anawayika kuti amenyane ndi Aaramu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.9",
            "verseOrgIds": [
              "2SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayika ankhondo ena otsalawo mʼmanja mwa Abisai mʼbale wake ndipo anawayika kuti amenyane ndi Aamoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.10",
            "verseOrgIds": [
              "2SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowabu anati, \"Ngati Aaramu andipose mphamvu, iwe ubwere udzandipulumutse. Koma ngati Aamoni akupose mphamvu, ine ndidzabwera kudzakupulumutsa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.11",
            "verseOrgIds": [
              "2SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limba mtima ndipo timenyane nawo mopanda mantha chifukwa cha anthu athu ndi mizinda ya Mulungu wathu. Yehova achite chomukomera pamaso pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Yowabu ndi ankhondo amene anali naye anapita kukamenyana ndi Aaramu, ndipo iwo anathawa pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aamoni atazindikira kuti Aaramu akuthawa, iwo anathawanso pamaso pa Abisai ndi kulowa mu mzinda. Nkhondo itatha, Yowabu anabwerera ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aaramu ataona kuti agonjetsedwa ndi Aisraeli, anasonkhananso.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.15",
            "verseOrgIds": [
              "2SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadezeri anatumiza amithenga kukayitana Aaramu amene anali ku tsidya la Mtsinje, iwo anapita ku Helamu motsogozedwa ndi Sobaki mkulu wa ankhondo a Hadadezeri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.16",
            "verseOrgIds": [
              "2SA.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Davide atawuzidwa zimenezi, iye anasonkhanitsa Aisraeli onse ndi kuwoloka Yorodani ndipo anapita ku Helamu. Aaramu anayima mʼmizere yawo yankhondo kukakumana ndi Davide ndipo anamenyana naye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.17",
            "verseOrgIds": [
              "2SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma iwo anathawa pamaso pa Aisraeli, ndipo Davide anapha anthu okwera pa magaleta 700 ndi ankhondo oyenda pansi 40,000. Davide anaphanso Sobaki mtsogoleri wawo wankhondo ndipo anafera pomwepo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.18",
            "verseOrgIds": [
              "2SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mafumu onse amene anali pansi pa Hadadezeri ataona kuti agonjetsedwa ndi Aisraeli, iwo anachita mtendere ndi Aisraeli ndipo anakhala pansi pawo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:19"
      },
      "items": [
        {
          "text": "Motero Aaramu anaopa kuthandizanso Aamoni.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    }
  ],
