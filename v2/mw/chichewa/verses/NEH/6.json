  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "NEH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Adani Apitiriza Kutsutsa ndi Kuopseza Nehemiya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Sanibalati, Tobiya, Gesemu Mwarabu ndi adani athu anamva kuti ndatsiriza ntchito yomanganso khoma ndi kuti palibe mpata umene watsala ngakhale kuti pa nthawi imeneyi ndinali ndisanayike zitseko pa zipata.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.1",
            "verseOrgIds": [
              "NEH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sanibalati ndi Gesemu, ananditumizira uthenga uwu: \"Bwerani tidzakumane pa mudzi wina ku chigwa cha Ono.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 6:2"
      },
      "items": [
        {
          "text": "Koma iwo anakonzekera kuti akandichite chiwembu kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.2",
            "verseOrgIds": [
              "NEH.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho ine ndinatuma amithenga ndi yankho ili: \"Ine ndikugwira ntchito yayikulu kuno ndipo sindingathe kubwera kumeneko. Kodi ntchito iyime pofuna kuti ndibwere kumeneko?\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.3",
            "verseOrgIds": [
              "NEH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananditumizira uthenga umodzimodzi omwewu kanayi ndipo ndinawayankha chimodzimodzi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.4",
            "verseOrgIds": [
              "NEH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono kachisanu, Sanibalati anatumiza wantchito wake ndi kalata yosamata.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.5",
            "verseOrgIds": [
              "NEH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu kalatamo munali mawu akuti,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 6:6"
      },
      "items": [
        {
          "text": "\"Pali mphekesera pakati pa mitundu ya anthu, ndiponso Gesemu akunena zomwezo kuti inu ndi Ayuda onse mufuna kuwukira boma. Nʼchifukwa chake mukumanga khoma. Mphekeserazo zikutinso inu mukufuna kudzakhala mfumu yawo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.6",
            "verseOrgIds": [
              "NEH.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwayikanso kale aneneri amene adzalengeza za iwe mu Yerusalemu kuti 'Mu Yuda muli mfumu!' Tsono nkhani iyi imveka ndithu kwa mfumu. Choncho bwerani kuti tidzakambirane.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.7",
            "verseOrgIds": [
              "NEH.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndinatumiza yankho ili: \"Pa zimene mukunenazo, palibe chimene chinachitikapo. Inu mukungozipeka mʼmutu mwanu.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.8",
            "verseOrgIds": [
              "NEH.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apa adani athu onsewa ankangofuna kutiopseza. Iwo ankaganiza kuti \"Tichita mantha ndi kuleka kugwira ntchito.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 6:9"
      },
      "items": [
        {
          "text": "Tsono ndinapemphera kuti, \"Inu Mulungu ndilimbitseni mtima.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.9",
            "verseOrgIds": [
              "NEH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina ndinapita ku nyumba ya Semaya mwana wa Delaya mwana wa Mehatabeli. Tsono anandiwuza kuti, \"Tiyeni tikakumanire ku Nyumba ya Mulungu. Tikabisale mʼmenemo ndi kutseka zitseko chifukwa akubwera kudzakuphani. Ndithu usiku uno akubwera kudzakuphani.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.10",
            "verseOrgIds": [
              "NEH.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndinayankha kuti, \"Kodi munthu ngati ine nʼkuthawa? Kapena munthu wofanana ndi ine nʼkupita ku Nyumba ya Mulungu kuti apulumutse moyo wake? Ayi, ine sindipita!\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.11",
            "verseOrgIds": [
              "NEH.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinazindikira kuti Mulungu sanamutume koma kuti anayankhula mawu oloserawa motsutsana nane chifukwa Tobiya ndi Sanibalati anamulemba ntchitoyi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.12",
            "verseOrgIds": [
              "NEH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye analembedwa ntchitoyi ndi cholinga choti ine ndichite mantha, ndithawe. Ndikanatero ndiye kuti ndikanachimwira Yehova ndiponso iwowo akanandiyipitsira mbiri yanga ndi kumandinyoza.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.13",
            "verseOrgIds": [
              "NEH.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NEH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ndinapemphera kuti, \"Inu Mulungu wanga, kumbukirani Tobiya ndi Sanibalati chifukwa cha zimene achita. Kumbukiraninso mneneri wamkazi Nowadiya ndi aneneri amene akhala akufuna kundiopseza.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.14",
            "verseOrgIds": [
              "NEH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutsiriza kwa Khoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NEH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo khoma linatsirizidwa kumanga pa tsiku la 25 la mwezi wa Eluli. Linamangidwa pa masiku okwana 52.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.15",
            "verseOrgIds": [
              "NEH.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NEH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Adani athu onse atamva izi, mitundu yonse ya anthu yozungulira inachita mantha ndi kuchita manyazi. Iwo anazindikira kuti ntchitoyo inachitika ndi thandizo la Mulungu wathu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.16",
            "verseOrgIds": [
              "NEH.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NEH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komanso masiku amenewo anthu olemekezeka a ku Yuda ankalemberana naye makalata ambiri ndi Tobiyayo,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.17",
            "verseOrgIds": [
              "NEH.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "NEH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti anthu ambiri a ku Yuda anali atalumbira kale kuti adzagwira naye ntchito popeza anali mkamwini wa Sekaniya mwana wa Ara, ndipo mwana wake Yehohanani anakwatira mwana wamkazi wa Mesulamu mwana wa Berekiya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.18",
            "verseOrgIds": [
              "NEH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "NEH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwonjezera apo, anthu ankasimba za ntchito zake zabwino ine ndili pomwepo ndipo anakamuwululira mawu anga. Choncho Tobiyayo ankatumiza makalata ondiopseza.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.6.19",
            "verseOrgIds": [
              "NEH.6.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "NEH.7",
    "number": "7",
