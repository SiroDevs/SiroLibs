  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ZEC 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Munthu ndi Chingwe Choyezera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ZEC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka ndinayangʼananso, ndipo ndinaona munthu atanyamula chingwe choyezera mʼmanja mwake.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.1",
            "verseOrgIds": [
              "ZEC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinafunsa kuti, \"Kodi ukupita kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ZEC 2:2"
      },
      "items": [
        {
          "text": "Anandiyankha kuti, \"Akukayeza Yerusalemu kuti ndidziwe mulifupi mwake ndi mulitali mwake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.2",
            "verseOrgIds": [
              "ZEC.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, mngelo amene amayankhula nane uja akuchoka, mngelo wina anabwera kudzakumana naye",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.3",
            "verseOrgIds": [
              "ZEC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo anamuwuza kuti, \"Thamanga, kamuwuze mnyamatayo kuti, 'Yerusalemu udzakhala mzinda wopanda malinga chifukwa mudzakhala anthu ambiri ndiponso ziweto zochuluka.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.4",
            "verseOrgIds": [
              "ZEC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ZEC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Ine mwini ndidzakhala linga lamoto kuteteza mzindawo,' akutero Yehova, 'ndipo ndidzakhala ulemerero mʼkati mwake.'",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.5",
            "verseOrgIds": [
              "ZEC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tulukani! Tulukani! Thawaniko ku dziko la kumpoto,\" akutero Yehova, \"pakuti ndinakumwazirani ku mphepo zinayi zamlengalenga,\" akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.6",
            "verseOrgIds": [
              "ZEC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tuluka, iwe Ziyoni! Thawa, iwe amene umakhala mʼdziko la mwana wamkazi wa Babuloni!\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.7",
            "verseOrgIds": [
              "ZEC.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Yehova Wamphamvuzonse akuti, \"Atatha kundilemekeza wanditumiza kwa anthu a mitundu ina amene anakufunkhani; pakuti aliyense wokhudza inu wakhudza mwanadiso wanga.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.8",
            "verseOrgIds": [
              "ZEC.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu Ine ndidzawamenya anthuwo ndi dzanja langa ndipo amene anali akapolo awo ndiye adzawalande zinthu. Pamenepo mudzadziwa kuti Yehova Wamphamvuzonse ndiye wandituma.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.9",
            "verseOrgIds": [
              "ZEC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wamkazi wa Ziyoni, fuwula ndipo sangalala. Pakuti taona ndikubwera, ndipo ndidzakhala pakati pako,\" akutero Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.10",
            "verseOrgIds": [
              "ZEC.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nthawi imeneyo anthu a mitundu yambiri adzabwera kwa Yehova ndipo adzasanduka anthu anga. Ndidzakhala pakati pako ndipo iwe udzadziwa kuti Yehova Wamphamvuzonse wandituma kwa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.11",
            "verseOrgIds": [
              "ZEC.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova adzachititsa kuti Yuda akhale chuma chake mʼdziko lopatulika ndipo adzasankhanso Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.12",
            "verseOrgIds": [
              "ZEC.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ZEC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Khalani chete pamaso pa Yehova anthu nonse, chifukwa Iye wavumbuluka kuchoka ku malo ake opatulika.\"",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.2.13",
            "verseOrgIds": [
              "ZEC.2.17"
            ]
          }
        }
      ]
    }
  ],
