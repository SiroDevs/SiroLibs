  "verseCount": 30,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "MAT 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Otumidwa ndi Yohane Mʼbatizi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yesu atamaliza kulangiza ophunzira ake khumi ndi awiri aja, anachoka kumeneko kupita kukaphunzitsa ndi kukalalikira ku mizinda ya ku Galileya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.1",
            "verseOrgIds": [
              "MAT.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yohane ali mʼndende anamva zimene Khristu ankachita, ndipo anatumiza ophunzira ake kukamufunsa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.2",
            "verseOrgIds": [
              "MAT.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anamufunsa kuti, \"Kodi Inu ndinu uja ankanena kuti mudzabwerayu kapena tidikire wina?\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.3",
            "verseOrgIds": [
              "MAT.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu anayankha kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bwererani ndi kukamuwuza Yohane zimene mwamva ndi kuona.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.4",
                "verseOrgIds": [
                  "MAT.11.4"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.4",
            "verseOrgIds": [
              "MAT.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Osaona akuona, olumala akuyenda, akhate akuchiritsidwa, osamva akumva, akufa akuukitsidwa ndipo Uthenga Wabwino ukulalikidwa kwa osauka.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.5",
                "verseOrgIds": [
                  "MAT.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.5",
            "verseOrgIds": [
              "MAT.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Odala ndi munthu amene sakhumudwa chifukwa cha Ine.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.6",
                "verseOrgIds": [
                  "MAT.11.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene ophunzira a Yohane ankachoka, Yesu anayamba kuyankhula kwa gulu la anthu za Yohane kuti,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi munkapita ku chipululu kuti mukaone chiyani? Kodi bango logwedezeka ndi mphepo?",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.7",
                "verseOrgIds": [
                  "MAT.11.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.7",
            "verseOrgIds": [
              "MAT.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nanga munkapita kukaona chiyani, munthu wovala zokongola? Ayi, wovala zokongola amakhala mʼnyumba za mafumu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.8",
                "verseOrgIds": [
                  "MAT.11.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.8",
            "verseOrgIds": [
              "MAT.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nanga munkapita kukaona chiyani? Mneneri kodi? Inde ndikuwuzani kuti munkakaona woposa mneneri.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.9",
                "verseOrgIds": [
                  "MAT.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.9",
            "verseOrgIds": [
              "MAT.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Uyu ndi amene malemba akunena za iye kuti,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndidzatuma mthenga wanga patsogolo panu",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:10"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "amene adzakonza njira yanu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.10",
                "verseOrgIds": [
                  "MAT.11.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Zoonadi, Ine ndikuwuzani kuti pakati pa obadwa ndi mkazi sipanaoneke wina aliyense wamkulu woposa Yohane Mʼbatizi; komatu amene ndi wamngʼono kwambiri mu ufumu wakumwamba ndi wamkulu koposa iye.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.11",
                "verseOrgIds": [
                  "MAT.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.11",
            "verseOrgIds": [
              "MAT.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kuyambira masiku a Yohane Mʼbatizi mpaka tsopano, ufumu wakumwamba ndi wolimbirana ndipo anthu amphamvu okha ndi amene akuwulanda.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.12",
                "verseOrgIds": [
                  "MAT.11.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.12",
            "verseOrgIds": [
              "MAT.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti aneneri onse ndi malamulo ananenera kufikira nthawi ya Yohane.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.13",
                "verseOrgIds": [
                  "MAT.11.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.13",
            "verseOrgIds": [
              "MAT.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo ngati inu mufuna kulandira izi, iyeyu ndi Eliya amene ankanena kuti adzabwera uja.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.14",
                "verseOrgIds": [
                  "MAT.11.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.14",
            "verseOrgIds": [
              "MAT.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Iye amene ali ndi makutu amve.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.15",
                "verseOrgIds": [
                  "MAT.11.15"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kodi mʼbado uwu ndingawufanizire ndi chiyani? Uli ngati ana opezeka mʼmisika amene akuyitana anzawo nʼkumati:",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.16",
                "verseOrgIds": [
                  "MAT.11.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\" 'Tinakuyimbirani zitoliro,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma inu simunavine;",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "ife tinayimba nyimbo zamaliro,",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MAT 11:17"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "koma inu simunalire.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.17",
                "verseOrgIds": [
                  "MAT.11.17"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti Yohane sanabwerere kudya kapena kumwa koma iwo ankanena kuti, 'Iye anali ndi chiwanda.'",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.18",
                "verseOrgIds": [
                  "MAT.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.18",
            "verseOrgIds": [
              "MAT.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Mwana wa Munthu anabwera ndi kumadya ndi kumwa koma iwo akuti, 'Munthu wadyera, woledzera, bwenzi la amisonkho ndi bwenzi la ochimwa.' Koma nzeru imatsimikizika kuti ndi yolondola mwa ntchito zake.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.19",
                "verseOrgIds": [
                  "MAT.11.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsoka la Mizinda Itatu Yosatembenuka mtima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Yesu anayamba kudzudzula mizinda imene zodabwitsa zake zambiri zinachitikamo, chifukwa chakuti sinatembenuke mtima.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.20",
            "verseOrgIds": [
              "MAT.11.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Tsoka kwa iwe Korazini! Tsoka kwa iwe Betisaida! Ngati zodabwitsa zimene zinachitika mwa iwe zikanachitidwa mu Turo ndi Sidoni, iwo akanalapa kale atavala ziguduli ndi kudzola phulusa.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.21",
                "verseOrgIds": [
                  "MAT.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.21",
            "verseOrgIds": [
              "MAT.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma ndikuwuzani inu kuti pa tsiku lachiweruzo mlandu wa Turo ndi Sidoni udzachepako kusiyana ndi wanu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.22",
                "verseOrgIds": [
                  "MAT.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
              "MAT.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ndipo iwe Kaperenawo, kodi udzakwezedwa kufika kumwamba? Ayi, udzatsitsidwa mpaka pansi kufika ku Hade. Ngati zodabwitsa zimene zinachitika mwa iwe, zikanachitika mu Sodomu, bwenzi iye alipo kufikira lero.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.23",
                "verseOrgIds": [
                  "MAT.11.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Koma Ine ndikuwuzani kuti pa tsiku la chiweruziro mlandu wa Sodomu udzachepako kusiyana ndi wanu.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.24",
                "verseOrgIds": [
                  "MAT.11.24"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Goli la Khristu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa nthawi imeneyo Yesu anati,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ine ndikukuyamikani Inu Atate Ambuye akumwamba ndi dziko lapansi, chifukwa Inu mwawabisira zinthu izi anzeru ndi ophunzira ndi kuziwulula kwa ana angʼonoangʼono.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.25",
                "verseOrgIds": [
                  "MAT.11.25"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.25",
            "verseOrgIds": [
              "MAT.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Inde, Atate, ichi chinali chokukomerani Inu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.26",
                "verseOrgIds": [
                  "MAT.11.26"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zinthu zonse zapatsidwa kwa Ine ndi Atate anga. Palibe mmodzi amene adziwa Mwana kupatula Atate ndipo palibe mmodzi amene adziwa Atate kupatula Mwana ndi kwa iwo amene Mwana awasankha kuwawululira.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.27",
                "verseOrgIds": [
                  "MAT.11.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Idzani kwa Ine, inu nonse otopa ndi olemedwa ndipo Ine ndidzakupatsani mpumulo.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.28",
                "verseOrgIds": [
                  "MAT.11.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Senzani goli langa ndipo phunzirani kwa Ine, pakuti ndine wofatsa ndi wodzichepetsa. Ndipo inu mudzapeza mpumulo wa miyoyo yanu.",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.29",
                "verseOrgIds": [
                  "MAT.11.29"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.29",
            "verseOrgIds": [
              "MAT.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Pakuti goli langa ndi losavuta ndipo katundu wanga ndi wopepuka.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.11.30",
                "verseOrgIds": [
                  "MAT.11.30"
                ]
              }
            }
          ]
        }
      ]
    }
