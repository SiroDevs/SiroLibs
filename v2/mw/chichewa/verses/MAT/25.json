        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Iye adzayankha kuti, 'Zoonadi, ndikuwuzani kuti chilichonse chimene simunachitire mmodzi wa abale anga onyozekawa simunandichitire Ine.'",
              "type": "text",
              "attrs": {
