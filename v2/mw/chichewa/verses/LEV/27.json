  "verseCount": 34,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "LEV 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuwombola Zomwe ndi za Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anawuza Mose kuti,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.1",
            "verseOrgIds": [
              "LEV.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yankhula ndi Aisraeli ndipo uwawuze kuti, 'Ngati munthu anachita lumbiro lapadera loti adzapereka munthu mnzake kwa Yehova ndipo akufuna kuti amuwombole,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.2",
            "verseOrgIds": [
              "LEV.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "mtengo wake ukhale masekeli a siliva makumi asanu, molingana ndi kawerengedwe ka ku Nyumba ya Mulungu, ngati munthuyo ndi wamwamuna wa zaka zapakati pa 20 ndi 60.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.3",
            "verseOrgIds": [
              "LEV.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ngati ndi wamkazi, mtengo wake ukhale masekeli makumi atatu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.4",
            "verseOrgIds": [
              "LEV.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtengo wa munthu wamwamuna wa zaka zapakati pa zisanu ndi makumi awiri ukhale masekeli makumi awiri ndipo munthu wamkazi ukhale masekeli khumi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.5",
            "verseOrgIds": [
              "LEV.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ndi munthu wamwamuna wa pakati pa mwezi umodzi ndi zaka zisanu, mtengo wa munthu wamwamuna ukhale masekeli asanu a siliva ndipo ngati ndi wamkazi, ukhale masekeli atatu a siliva.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.6",
            "verseOrgIds": [
              "LEV.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ndi munthu wa zaka makumi asanu ndi limodzi kapena kuposerapo, mtengo wa wamwamuna ukhale masekeli khumi ndi asanu, ndipo wamkazi ukhale masekeli khumi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.7",
            "verseOrgIds": [
              "LEV.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu amene anachita lumbiro ndi wosauka kwambiri kuti sangathe kulipira ndalama zimenezo, abwere ndi munthu woperekedwa uja kwa wansembe, ndipo wansembeyo ayike mtengo woti munthu wolumbirayo angathe kulipira.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.8",
            "verseOrgIds": [
              "LEV.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ngati chimene anachitira lumbiro kuti apereke ndi nyama imene amapereka kukhala nsembe kwa Yehova, zonse zimene amapereka kwa Yehova nʼzopatulika.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.9",
            "verseOrgIds": [
              "LEV.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu asasinthanitse ndi ina kapena kupereka ina yabwino mʼmalo mwa yoyipa, kapena yoyipa mʼmalo mwa yabwino. Ngati asinthitsa nyama ina mʼmalo mwa ina, nyamayo pamodzi ndi inzake wasinthitsayo zikhala zopatulika.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.10",
            "verseOrgIds": [
              "LEV.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati chimene anachitira lumbiro ndi nyama yodetsedwa, nyama imene siloledwa kuyipereka kukhala nsembe kwa Yehova, nyamayo abwere nayo kwa wansembe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.11",
            "verseOrgIds": [
              "LEV.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo wansembeyo atchule mtengo wake poona ngati ndi yabwino kapena ndi yoyipa. Mtengo umene wansembe atchule ndiwo udzakhale mtengo wake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.12",
            "verseOrgIds": [
              "LEV.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati mwini wakeyo akufuna kuwombola nyamayo, awonjezere pa mtengo wake wa nyamayo chimodzi mwa zigawo zisanu zamtengowo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.13",
            "verseOrgIds": [
              "LEV.27.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ngati munthu apereka nyumba yake kuti ikhale yopatulika kwa Yehova, wansembe atchule mtengo wake poona ngati ndi yabwino kapena ndi yoyipa. Mtengo umene wansembe atchule ndiwo udzakhale mtengo wake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.14",
            "verseOrgIds": [
              "LEV.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu amene wapereka nyumbayo afuna kuyiwombola nyumbayo, awonjezere pamtengo wake wa nyumbayo, limodzi mwa magawo asanu amtengowo. Ndipo nyumbayo idzakhalanso yake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.15",
            "verseOrgIds": [
              "LEV.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ngati munthu apereka kwa Yehova mbali ina ya malo a makolo ake, mtengo umene awuyike ukhale wolingana ndi mtengo wa mbewu zimene zimadzabzalidwamo. Zikhale mbewu za barele za makilogalamu makumi awiri ndipo mtengo wake ukhale masekeli makumi asanu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.16",
            "verseOrgIds": [
              "LEV.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu apereka munda wake kuyambira chaka chokondwerera zaka makumi asanu, mtengo wake ukhale umene unakhazikitsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.17",
            "verseOrgIds": [
              "LEV.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati apereka mundawo chaka chokondwerera zaka makumi asanu chitapita, wansembe adzatchula mtengo molingana ndi zaka zomwe zatsala kuti chifike chaka china chokondwerera zaka makumi asanu, ndipo mtengo wake udzakhala wotsikirapo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.18",
            "verseOrgIds": [
              "LEV.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu amene wapereka munda afuna kuwuwombola, ayenera kuwonjezera pa mtengo wake wa mundawo, limodzi mwa magawo asanu a mtengowo. Ndipo mundawo udzakhalanso wake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.19",
            "verseOrgIds": [
              "LEV.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ngati sawuwombola mundawo, kapena ngati waugulitsa kwa munthu wina, mundawo sudzawomboledwanso.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.20",
            "verseOrgIds": [
              "LEV.27.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwini mundawo akawusiya mʼchaka chokondwerera zaka makumi asanu ndiye kuti mundawo udzakhala wopatulika monga woperekedwa kwa Yehova: udzakhala munda wa ansembe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.21",
            "verseOrgIds": [
              "LEV.27.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ngati munthu apereka kwa Yehova munda umene anagula, umene si malo a makolo ake,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.22",
            "verseOrgIds": [
              "LEV.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "wansembe atchule mtengo wake kufikira pa chaka chokondwerera zaka makumi asanu, ndipo munthuyo apereke ndalama zokwanira mtengo wake pa tsikulo monga ndalama zopatulika kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.23",
            "verseOrgIds": [
              "LEV.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa chaka chokondwerera zaka makumi asanu, mundawo udzabwezedwa kwa munthu amene anawugulitsayo, amene malowo anali ake.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.24",
            "verseOrgIds": [
              "LEV.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Potchula mtengo uliwonse wansembe awerengere molingana ndi mtengo wa sekeli wa ku Nyumba ya Mulungu: magera makumi awiri pa sekeli imodzi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.25",
            "verseOrgIds": [
              "LEV.27.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Koma pasapezeke munthu wopereka mwana woyamba kubadwa wa nyama, popeza mwana woyamba kubadwa ali kale wa Yehova, kaya ndi ngʼombe kapena nkhosa, zimenezi ndi za Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.26",
            "verseOrgIds": [
              "LEV.27.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati ili nyama yodetsedwa, ayiwombole pa mtengo umene wansembe wawuyika, ndi kuwonjezeranso pa mtengo wake wa nyamayo, limodzi mwa magawo asanu amtengowo. Ngati sayiwombola, igulitsidwe pa mtengo umene wansembe awuyike.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.27",
            "verseOrgIds": [
              "LEV.27.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Koma chinthu chilichonse choperekedwa kwa Yehova, kaya ndi munthu, nyama, kaya ndi malo a makolo, chimenechi chisagulitsidwe kapena kuwomboledwa. Choperekedwa kwa Yehova motere nʼchopatulika kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.28",
            "verseOrgIds": [
              "LEV.27.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Munthu amene waperekedwa kotheratu sangawomboledwe. Munthuyo ayenera kuphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.29",
            "verseOrgIds": [
              "LEV.27.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Chakhumi chilichonse chochokera mʼdziko, kaya ndi tirigu wochokera mʼnthaka kapena chipatso cha mʼmitengo ndi za Yehova. Chimenecho ndi chopatulika kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.30",
            "verseOrgIds": [
              "LEV.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati munthu afuna kuwombola chakhumi chilichonse, awonjezere pamtengo wake chimodzi mwa zigawo zisanu za mtengowo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.31",
            "verseOrgIds": [
              "LEV.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chakhumi cha ngʼombe ndi nkhosa, kapena kuti nyama iliyonse ya khumi imene mʼbusa wayiwerenga idzakhala yopatulikira kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.32",
            "verseOrgIds": [
              "LEV.27.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe amene adzaloledwa kusankha nyama yomwe ili yabwino kapena kusinthitsa. Ngati asinthitsa, nyamayo pamodzi ndi inzakeyo zidzakhala zopatulika ndipo sangaziwombole.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.33",
            "verseOrgIds": [
              "LEV.27.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amenewa ndi malamulo amene Yehova anamupatsa Mose pa Phiri la Sinai kuti awuze Aisraeli.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.27.34",
            "verseOrgIds": [
              "LEV.27.34"
            ]
          }
        }
      ]
    }
