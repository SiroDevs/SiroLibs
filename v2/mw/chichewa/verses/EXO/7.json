  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "EXO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EXO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Yehova anati kwa Mose, \"Taona ine ndakuyika kuti ukhale ngati Mulungu kwa Farao, ndipo mʼbale wako Aaroni adzakhala mneneri wako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.1",
            "verseOrgIds": [
              "EXO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EXO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe ukanene zonse zimene ndakulamulirazi, ndipo Aaroni mʼbale wako ndiye akaziyankhule kwa Farao kuti atulutse ana a Israeli mʼdziko la Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.2",
            "verseOrgIds": [
              "EXO.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EXO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma ndidzawumitsa mtima wa Farao, ndipo ngakhale nditachulukitsa zizindikiro zozizwitsa ndi zodabwitsa mu Igupto,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.3",
            "verseOrgIds": [
              "EXO.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EXO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "iyeyo sadzakumverani. Choncho ndidzakantha Igupto, ndipo ndi ntchito zachiweruzo ndidzatulutsa magulu anga, anthu anga Aisraeli kuwachotsa mʼdziko la Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.4",
            "verseOrgIds": [
              "EXO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EXO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Aigupto adzadziwa kuti Ine ndine Yehova, ndikadzatambasula dzanja langa kukantha Igupto ndi kutulutsa Aisraeli mʼdzikomo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.5",
            "verseOrgIds": [
              "EXO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EXO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ndi Aaroni anachita monga momwe Yehova anawalamulira.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.6",
            "verseOrgIds": [
              "EXO.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EXO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose anali ndi zaka 80, ndipo Aaroni anali ndi zaka 83 pamene anakayankhula kwa Farao.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.7",
            "verseOrgIds": [
              "EXO.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndodo ya Aaroni Isanduka Njoka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EXO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati kwa Mose ndi Aaroni,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.8",
            "verseOrgIds": [
              "EXO.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EXO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngati Farao adzati kwa inu, 'Chitani chozizwitsa,' iwe Mose udzati kwa Aaroni, 'Tenga ndodo yako ndipo uyiponye pamaso pa Farao,' ndipo idzasanduka njoka.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.9",
            "verseOrgIds": [
              "EXO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Mose ndi Aaroni anapita kwa Farao ndi kuchita monga momwe Yehova anawalamulira. Aaroni anaponya ndodo yake pansi patsogolo pa Farao ndi nduna zake ndipo inasanduka njoka.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.10",
            "verseOrgIds": [
              "EXO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EXO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naye Farao anayitanitsa anthu ake anzeru ndi amatsenga, ndipo nawonso amatsenga a Chiigupto anachita zinthu zomwezo mwa matsenga awo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.11",
            "verseOrgIds": [
              "EXO.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EXO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliyense wa iwo anaponya ndodo yake pansi ndipo inasanduka njoka. Koma ndodo ya Aaroni inameza ndodo zawo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.12",
            "verseOrgIds": [
              "EXO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EXO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mtima wa Farao unawuma ndipo sanawamvere monga momwe Yehova ananenera.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.13",
            "verseOrgIds": [
              "EXO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mliri wa Magazi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EXO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Yehova anati kwa Mose, \"Farao ndi wowuma mtima. Akukana kulola anthu anga kuti apite.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.14",
            "verseOrgIds": [
              "EXO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EXO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upite kwa Farao mmawa pamene azidzapita ku madzi. Ukamudikire mʼmbali mwa Nailo kuti ukakumane naye ndipo unyamule ndodo imene inasanduka njoka ija mʼdzanja lako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.15",
            "verseOrgIds": [
              "EXO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EXO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ukamuwuze Farao kuti, 'Yehova, Mulungu wa Ahebri wandituma kuti ndikuwuzeni kuti: Lolani anthu anga apite kuti akandipembedze mʼchipululu. Koma mpaka tsopano inu simunandimvere.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.16",
            "verseOrgIds": [
              "EXO.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EXO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Izi ndi zimene Yehova akunena: Ndi ndodo imene ili mʼdzanja langa ndidzamenya madzi a mu Nailo, ndipo madzi adzasanduka magazi. Ndikadzachita ichi udzadziwa kuti Ine ndine Yehova:",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.17",
            "verseOrgIds": [
              "EXO.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsomba za mu Nailo zidzafa, mtsinje udzanunkha ndipo Aigupto sadzatha kumwa madzi ake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.18",
            "verseOrgIds": [
              "EXO.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati kwa Mose, \"Uza Aaroni kuti, 'Tenga ndodo yako uyilozetse ku madzi a mu Igupto pa mitsinje, pa ngalande, pa zithaphwi ndi pa madambo, ndipo onse adzasanduka magazi.' Mʼdziko lonse la Igupto mudzakhala magazi, ngakhale mʼzotungira madzi zopangidwa ndi mitengo ndi miyala.\"",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.19",
            "verseOrgIds": [
              "EXO.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ndi Aaroni anachita monga momwe Yehova analamulira. Anakweza ndodo yake pamaso pa Farao ndi akuluakulu ake ndipo anamenya madzi a mu Nailo, ndipo madzi onse anasanduka magazi.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.20",
            "verseOrgIds": [
              "EXO.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsomba za mu Nailo zinafa ndipo mtsinje unanunkha kwambiri kotero kuti Aigupto sanathe kumwa madzi ake. Magazi anali ponseponse mu Igupto.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.21",
            "verseOrgIds": [
              "EXO.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma amatsenga a Chiigupto anachita zinthu zomwezo mwa matsenga awo. Choncho Farao anawumabe mtima, ndipo sanamvere zonena za Mose ndi Aaroni monga momwe Yehova ananeneratu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.22",
            "verseOrgIds": [
              "EXO.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmalo mwake iye anatembenuka ndi kupita ku nyumba yake yaufumu ndipo zimenezi sanazilabadire.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.23",
            "verseOrgIds": [
              "EXO.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu onse a ku Igupto anayamba kukumba mʼmbali mwa mtsinje wa Nailo kuti apeze madzi akumwa, chifukwa sanathe kumwa madzi a mu mtsinjemo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.24",
            "verseOrgIds": [
              "EXO.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mliri wa Achule",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panapita masiku asanu ndi awiri Yehova atamenya madzi a mu mtsinje wa Nailo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.7.25",
            "verseOrgIds": [
              "EXO.7.25"
            ]
          }
        }
      ]
    }
  ],
