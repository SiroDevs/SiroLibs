  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Solomoni anati, \"Yehova anati adzakhala mʼmitambo yakuda;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ine ndakumangirani Nyumba yokongola kwambiri, malo woti muzikhalamo mpaka muyaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisraeli onse ali chiyimire pomwepo, mfumu inatembenuka ndi kuwadalitsa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo inati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:4"
      },
      "items": [
        {
          "text": "\"Atamandike Yehova, Mulungu wa Israeli amene wachita ndi dzanja lake zimene analonjeza ndi pakamwa pake kwa Davide abambo anga. Pakuti Iye anati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kuyambira tsiku limene ndinatulutsa anthu anga ku Igupto, sindinasankhe mzinda wina uliwonse pa fuko lina lililonse la Aisraeli kuti kumeneko andimangire Nyumba kuti ndizikhalamo kapena munthu wina aliyense kuti akhale mtsogoleri wa Aisraeli anthu anga.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.5",
            "verseOrgIds": [
              "2CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma tsopano ndasankha Yerusalemu kuti Dzina langa likhale kumeneko ndiponso ndasankha Davide kuti alamulire anthu anga Aisraeli.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.6",
            "verseOrgIds": [
              "2CH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Abambo anga Davide anali ndi maganizo mu mtima mwawo oti amangire Nyumba Yehova Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova ananena kwa abambo anga Davide kuti, 'Popeza zinali mu mtima mwako kumangira Nyumba dzina langa, unachita bwino kukhala ndi maganizo amenewa mu mtima mwakomo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komatu si iwe amene udzamanga Nyumba ya Mulungu koma mwana wako, mwana amene iwe udzabereke. Iyeyo ndiye amene adzandimangire Nyumba.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.9",
            "verseOrgIds": [
              "2CH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Yehova wasunga zimene analonjeza. Ine ndalowa mʼmalo mwa abambo anga Davide, ndipo tsopano ndili pa mpando waufumu wa Israeli, monga momwe Yehova analonjezera, ndipo ndamangira nyumba Dzina la Yehova Mulungu wa Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmenemo ndayikamo Bokosi la Chipangano, mmene muli pangano la Yehova limene anapangana ndi ana a Israeli.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pemphero la Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Solomoni anayimirira patsogolo pa guwa lansembe la Yehova patsogolo pa gulu lonse la Aisraeli ndipo anakweza manja ake.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iyeyo anali atapanga nsanja yamkuwa, kutalika kwake kunali mamita awiri, mulifupi mwake munali mamita awiri, msinkhu wake unali mita imodzi ndi theka ndipo nsanjayo anayimika pakati pa bwalo lakunja. Iye anayimirira pa nsanjapo nagwada pamaso pa gulu lonse la Aisraeli ndipo anakweza manja ake kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anati,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:14"
      },
      "items": [
        {
          "text": "\"Inu Yehova, Mulungu wa Israeli, palibe Mulungu wofanana nanu kumwamba kapena pa dziko. Inu amene mumasunga pangano ndi kuonetsa chikondi chosasinthika kwa atumiki anu amene amayenda pamaso panu ndi mtima wawo wonse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mwasunga lonjezo lanu kwa abambo anga Davide, mtumiki wanu. Inde zimene munalonjeza ndi pakamwa panu, mwazikwaniritsa ndi manja anu monga mmene tikuonera lero lino.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.15",
            "verseOrgIds": [
              "2CH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo tsopano, Inu Yehova Mulungu wa Israeli, sungani zimene munalonjeza kwa abambo anga Davide, mtumiki wanu pamene munati, 'Sudzasowa munthu wokhala pamaso panga pa mpando waufumu wa Israeli, ngati ana ako adzasamalira mayendedwe awo ndi kusunga malamulo anga monga iwe wachitira.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo tsopano Inu Yehova, Mulungu wa Israeli, lolani kuti mawu anu akwaniritsidwe amene munalonjeza mtumiki wanu Davide.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi Mulungu angakhaledi pa dziko lapansi ndi munthu? Mlengalenga ngakhale kumwamba kwenikweni sikungakukwaneni. Nanga kuli bwanji ndi Nyumba iyi imene ndamanga!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Inu Yehova, Mulungu wanga, imvani pemphero ndi pembedzero la mtumiki wanu. Imvani kulira ndi pemphero la mtumiki wanu limene ndikupempha pamaso panu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso anu azikhala otsekuka kuyangʼana Nyumba ino usana ndi usiku, malo ano amene Inu munati mudzayikamo Dzina lanu, imvani pemphero la mtumiki wanu limene akupemphera pa malo ano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imvani mapembedzero a mtumiki wanu ndi a anthu anu Aisraeli pamene akupemphera akuyangʼana malo ano. Imvani kumwambako, malo anu amene mumakhala; ndipo mukamva muzitikhululukira.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Munthu akalakwira mnzake, nawuzidwa kuti alumbire, akabwera kudzalumbira patsogolo pa guwa lansembe la Nyumba ino,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "imvani kumwambako ndi kuchitapo kanthu. Weruzani atumiki anuwo, wochimwa mugamule kuti ndi wolakwa ndipo alangidwe chifukwa cha zimene wachita. Wosachimwa mugamule kuti wosalakwa, ndipo muonetse kusalakwa kwakeko.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anthu anu Aisraeli akagonja kwa adani awo chifukwa akuchimwirani ndipo akatembenukira kwa Inu ndi kuvomereza Dzina lanu, kupemphera ndi kupembedzera pamaso panu mʼNyumba ino,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo imvani kumwambako ndi kukhululukira tchimo la anthu anu Aisraeli ndi kuwabweretsa ku dziko limene munawapatsa iwo ndi makolo awo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamene kumwamba kwatsekeka ndipo mvula sikugwa chifukwa anthu anu akuchimwirani, ndipo pamene apemphera akuyangʼana malo ano ndi kuvomereza Dzina lanu ndi kutembenuka kuchoka ku machimo awo chifukwa inu mwawalanga,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo imvani kumwambako ndipo muwakhululukire atumiki anu, anthu anu Aisraeli. Aphunzitseni makhalidwe oyenera, ndipo gwetsani mvula mʼdziko limene munapereka kwa anthu anu monga cholowa chawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamene mʼdziko mwagwa njala kapena mliri, chinoni kapena chiwawu, dzombe kapena kapuchi, kapena pamene adani azungulira mzinda wawo wina uliwonse, kaya mavuto kapena matenda abwera,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo wina aliyense mwa Aisraeli akapemphera kapena kukudandaulirani, aliyense wa iwo akadziwa masautso ake ndi ululu wake, ndi kukweza manja awo kuloza Nyumba ino,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo imvani kumwambako, malo anu wokhalamo. Khululukani ndipo muchitire aliyense molingana ndi zonse zimene anachita popeza Inu mumadziwa mtima wake, (pakuti ndinu nokha amene mumadziwa mitima ya anthu),",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "motero iwo adzakuopani ndipo adzayenda mʼnjira zanu masiku onse amene adzakhale mʼdziko limene munalipereka kwa makolo athu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndipo kunena za mlendo amene si mmodzi wa anthu anu Aisraeli, koma wabwera kuchokera ku dziko lakutali chifukwa cha dzina lanu lotchukali, ndiponso za dzanja lanu lamphamvu ndi lochita zazikulu, kudzapemphera akuyangʼana Nyumba ino,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo imvani kumwambako, malo anu okhalamo, ndipo muchite zonse zimene mlendoyo akukupemphani, kotero kuti anthu onse a dziko lapansi adziwe dzina lanu ndi kukuopani monga amachitira anthu anu Aisraeli, ndipo adziwe kuti nyumba ino imene ndakumangirani imadziwika ndi dzina lanu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anthu akapita ku nkhondo kukamenyana ndi adani awo, kulikonse kumene mungawatume, ndipo akapemphera moyangʼana mzinda uno umene mwausankha ndi Nyumba yanu imene ndakumangirani,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo imvani kumwamba pemphero lawo ndi kupempha kwawo ndipo muwapulumutse.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Pamene achimwira inu, pakuti palibe amene sachimwa, ndipo inu mwawakwiyira ndi kuwapereka kwa adani awo, amene awatenga ukapolo ku dziko lawo lakutali kapena pafupi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngati asintha mitima yawo ku dziko limene ali akapolo ndi kulapa ndi kukudandaulirani inu mʼdziko la ukapolo wawo ndi kunena kuti, 'Ife tachimwa, tachita zolakwa ndipo tachita moyipa kwambiri.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ngati atembenukira kwa inu ndi mtima ndi moyo wawo wonse mʼdziko lawo la ukapolo kumene anatengedwako ndi kupemphera moyangʼana dziko limene inu munalipereka kwa makolo awo, moyangʼana Nyumba yanu imene ndakumangirani;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "pamenepo imvani kumwamba, malo anu okhala, pemphero lawo ndi kudandaula kwawo, ndipo muwapulumutse. Ndipo mukhululukire anthu anu, amene akuchimwirani.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono Inu Mulungu wanga, tsekulani maso anu ndi makutu anu kuti mumve mapemphero ochitikira pa malo ano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano dzukani Inu Yehova Mulungu, ndipo bwerani ku malo anu ampumulo,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Inu ndi Bokosi la Chipangano la mphamvu zanu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Inu Yehova Mulungu, ansembe anu avale chipulumutso,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "oyera mtima anu akondwere ndi kukhulupirika kwanu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "2CH 6:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova Mulungu musamukane wodzozedwa wanu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:42"
      },
      "items": [
        {
          "text": "Kumbukirani chikondi chanu chachikulu chimene munalonjeza kwa Davide mtumiki wanu.\"",
          "type": "text"
        }
      ]
    }
  ],
