        {
          "text": "Ukulu wa Mordekai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Ahasiwero anakhometsa msonkho mʼdziko lake lonse mpaka ku zilumba zonse.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.1",
            "verseOrgIds": [
              "EST.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ntchito zonse zochitika ndi mphamvu zake komanso ndi zonse zofotokoza za ukulu wa Mordekai, kukwezedwa kwake ndi mfumu, kodi sizinalembedwe mʼbuku la mbiri ya mafumu a ku Mediya ndi Peresiya?",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.2",
            "verseOrgIds": [
              "EST.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Mordekai Myuda uja anali wachiwiri wa mfumu Ahasiwero. Kwa Ayuda onse Mordekai anali munthu wamkulu ndipo ankamukonda chifukwa ankachitira zabwino mtundu wake ndi kufunira mtendere abale ake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.10.3",
            "verseOrgIds": [
              "EST.10.3"
            ]
          }
        }
      ]
    }
