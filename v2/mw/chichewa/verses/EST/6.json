  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "EST 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mordekai Apatsidwa Ulemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku umenewo mfumu inalephera kugona tulo; Choncho inayitanitsa buku limene amalembamo mbiri ya zamakedzana kuti amuwerengere.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.1",
            "verseOrgIds": [
              "EST.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anapeza kuti mʼbukumo munalembedwa zoti Mordekai anawulula kuti Bigitana ndi Teresi, awiri mwa adindo ofulidwa a mfumu amene ankalondera pa khomo la chipinda cha mfumu ndiwo anakonza chiwembu chofuna kupha mfumu Ahasiwero.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.2",
            "verseOrgIds": [
              "EST.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inafunsa kuti, \"Kodi Mordekai anamupatsa ulemu ndi ukulu wotani chifukwa cha chinthu chimene anachitachi?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:3"
      },
      "items": [
        {
          "text": "Atumiki ake anamuyankha kuti, \"Palibe chimene chinachitika kwa iye.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inati, \"Kodi ndani ali mʼbwalomo?\" Tsono Hamani anali atangolowa kumene mʼbwalo lakunja la nyumba yaufumu kuti akawuze mfumu zomukhomera Mordekai pa mtanda umene anamukonzera.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.4",
            "verseOrgIds": [
              "EST.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atumiki ake anamuyankha kuti, \"Hamani ndiye wayima mu bwalo.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:5"
      },
      "items": [
        {
          "text": "\"Mulowetseni,\" Mfumu inalamulira.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani atalowa, mfumu inamufunsa kuti, \"Kodi timuchitire ulemu otani munthu amene mfumu ikondweretsedwa naye?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:6"
      },
      "items": [
        {
          "text": "Tsono Hamani anaganiza mu mtima kuti, \"Kodi palinso ndani amene mfumu ingamulemekeze kuposa ine?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Hamani anayankha mfumuyo kuti, \"Munthu amene mfumu ifuna kumuchitira ulemu, imuchitire izi:",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.7",
            "verseOrgIds": [
              "EST.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu abwere ndi chovala cha ufumu ndi kavalo amene mfumu imakwerapo wokhala ndi chizindikiro chaufumu pamutu pake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.8",
            "verseOrgIds": [
              "EST.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mupereke chovala cha ufumucho ndi kavalo kwa mmodzi wa akalonga a mfumu a ulemu kwambiri. Ameneyu amuveke chovalacho munthu amene mfumu yakondweretsedwa naye. Akavekedwa chovalachi amuyendetse mʼmisewu yonse ya mzinda atakwera pa kavalo wa mfumu. Kalongayu azifuwula patsogolo pa munthuyu kuti 'Ichi ndi chimene mfumu yachita kwa munthu amene yafuna kumuchitira ulemu!' \"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inalamulira Hamani kuti, \"Pita msanga, katenge chovala cha ufumu ndi kavalo ndipo uchite monga wanenera kwa Mordekai Myuda, amene amakhala pa chipata cha mfumu. Usasiyeko china chilichonse chimene wanena.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Hamani anatenga chovala ndi kavalo. Anamuveka Mordekai chovalacho ndipo anamuyendetsa mʼmisewu yonse ya mu mzinda atakwera pa kavalo, akufuwula kuti, \"Ichi ndi chimene mfumu yachita kwa munthu amene yafuna kumuchitira ulemu!\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Mordekai anabwerera ku chipata cha mfumu. Koma Hamani anapita msanga ku nyumba kwake, akulira, atafundira mutu wake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani anawuza Zeresi mkazi wake ndi abwenzi ake onse zonse zinamuchitikira.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 6:13"
      },
      "items": [
        {
          "text": "Anthu ake anzeru ndi mkazi wake Zeresi anamuwuza kuti, \"Popeza kuti Mordekai ndi Myuda amene mwayamba kale kugonja pamaso pake, ndiye kuti palibe chimene mungachitepo. Mudzagwa ndithu pamaso pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene anthuwa amayankhula nayebe, adindo a mfumu ofulidwa anabwera kudzamutenga Hamani mofulumira kupita naye ku phwando limene Estere anakonza.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
    }
  ],
