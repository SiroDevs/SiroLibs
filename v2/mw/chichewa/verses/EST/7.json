  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "EST 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hamani Aphedwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mfumu ndi Hamani anabwera kudzadya phwando la mfumukazi Estere.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.1",
            "verseOrgIds": [
              "EST.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa tsiku lachiwiri akumwa vinyo, mfumu inafunsanso kuti, \"Kodi iwe mfumukazi Estere, chimene ufuna kupempha nʼchiyani? Chimene uti upemphe ndidzakupatsa. Choncho ukufuna chiyani? Ngakhale utafuna theka la ufumu ndidzakupatsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.2",
            "verseOrgIds": [
              "EST.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mfumukazi Estere anayankha kuti, \"Ngati mwandikomera mtima, inu mfumu, ndipo ngati chingakukomereni mfumu, pempho ndi chokhumba changa ndi ichi, mulole kuti ine ndi abale anga tisungidwe tonse ndi moyo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.3",
            "verseOrgIds": [
              "EST.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza ine ndi anthu a mtundu wanga tagulitsidwa kuti atiwononge, atiphe ndi kutifafaniziratu. Akanangotigulitsa kokha tikanakhala chete, chifukwa chimene mdani wathuyo akanakupatsani mfumu sibwenzi mutasowa nacho mtendere.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.4",
            "verseOrgIds": [
              "EST.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu Ahasiwero anamufunsa mfumukazi Estere, \"Kodi iyeyu ndi ndani ndipo ali kuti amene saopa kuchita chinthu chotere?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.5",
            "verseOrgIds": [
              "EST.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Estere anati, \"Wotizunza ndiponso mdani wathu! Munthu woyipayo ndi Hamani.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:6"
      },
      "items": [
        {
          "text": "Kenaka Hamani anagwidwa ndi mantha pamaso pa mfumu ndi mfumukazi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.6",
            "verseOrgIds": [
              "EST.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu itakwiya kwambiri inanyamuka pa phwando nipita ku munda wa maluwa wa nyumba yaufumu. Koma Hamani, pozindikira kuti mfumu yaganiza kale kumuchitira choyipa, anatsalira mʼnyumba kupempha Estere kuti apulumutse moyo wake.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.7",
            "verseOrgIds": [
              "EST.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu itabwerera kuchokera ku munda wa maluwa wa nyumba yaufumu uja ndi kulowanso mʼchipinda chaphwando, anapeza Hamani atagona chafufumimba pa mpando wa khutagone pomwe Estere anakhalapo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:8"
      },
      "items": [
        {
          "text": "Mfumu inayankhula mokweza kuti, \"Kodi afunanso kuvula mfumukazi momukakamiza pamene ine ndili mʼnyumba?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:8"
      },
      "items": [
        {
          "text": "Mfumu isanatsirize kuyankhula mawu awa, atumiki ake anaphimba nkhope ya Hamani.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.8",
            "verseOrgIds": [
              "EST.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haribona, mmodzi wa adindo ofulidwa amene ankatumikira mfumu anati, \"Mtanda wotalika mamita 23 uli mʼnyumba ya Hamani. Mtandawu, Hamani anapangira Mordekai, uja amene anapulumutsa mfumu ku chiwembu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 7:9"
      },
      "items": [
        {
          "text": "Mfumu inati, \"Mpachikeni pamenepo!\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.9",
            "verseOrgIds": [
              "EST.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anamupachika Hamani pa mtanda umene anakonzera Mordekai. Kenaka mkwiyo wa mfumu unatsika.",
          "type": "text",
          "attrs": {
            "verseId": "EST.7.10",
            "verseOrgIds": [
              "EST.7.10"
            ]
          }
        }
      ]
    }
  ],
