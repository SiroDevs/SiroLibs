  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "PRO 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zolinga za mu mtima ndi za munthu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:1"
      },
      "items": [
        {
          "text": "koma kwa Yehova ndiye kumachokera yankho.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.1",
            "verseOrgIds": [
              "PRO.16.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zochita zonse za munthu zimaoneka zabwino pamaso pake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:2"
      },
      "items": [
        {
          "text": "koma Yehova ndiye amasanthula zolinga zako.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.2",
            "verseOrgIds": [
              "PRO.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pereka ntchito zako zonse mʼmanja mwa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:3"
      },
      "items": [
        {
          "text": "ndipo zolinga zako zidzachitikadi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.3",
            "verseOrgIds": [
              "PRO.16.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova amachita zonse ndi cholinga chake,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:4"
      },
      "items": [
        {
          "text": "ngakhale anthu oyipa kuti aone tsiku latsoka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.4",
            "verseOrgIds": [
              "PRO.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthu aliyense wodzikuza amamunyansa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:5"
      },
      "items": [
        {
          "text": "Koma dziwani izi: Iwo sadzakhala osalangidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.5",
            "verseOrgIds": [
              "PRO.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chifukwa cha chikondi chosasinthika ndi kukhulupirika, munthu amakhululukidwa machimo ake;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:6"
      },
      "items": [
        {
          "text": "chifukwa cha kuopa Yehova munthu amapewa zoyipa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.6",
            "verseOrgIds": [
              "PRO.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene makhalidwe a munthu akondweretsa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:7"
      },
      "items": [
        {
          "text": "ngakhale adani ake amakhala naye mwa mtendere.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.7",
            "verseOrgIds": [
              "PRO.16.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli bwino kukhala ndi zinthu pangʼono zozipeza mwachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.8",
            "verseOrgIds": [
              "PRO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:8"
      },
      "items": [
        {
          "text": "kusiyana ndi kukhala ndi zinthu zambiri zozipeza popanda chilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.8",
            "verseOrgIds": [
              "PRO.16.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wa munthu umalingalira zochita,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:9"
      },
      "items": [
        {
          "text": "koma Yehova ndiye amakhazikitsa njira zake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.9",
            "verseOrgIds": [
              "PRO.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu a mfumu ali ngati mawu ochokera kwa Mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.10",
            "verseOrgIds": [
              "PRO.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:10"
      },
      "items": [
        {
          "text": "ndipo pakamwa pake sipalakwa poweruza mlandu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.10",
            "verseOrgIds": [
              "PRO.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miyeso ndi masikelo achilungamo zimachokera kwa Yehova;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:11"
      },
      "items": [
        {
          "text": "miyala yonse yoyesera ya mʼthumba anayipanga ndi Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.11",
            "verseOrgIds": [
              "PRO.16.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuchita zoyipa kumanyansa mafumu,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:12"
      },
      "items": [
        {
          "text": "pakuti chilungamo ndiye maziko a ufumu wake.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.12",
            "verseOrgIds": [
              "PRO.16.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu owona amakondweretsa mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.13",
            "verseOrgIds": [
              "PRO.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:13"
      },
      "items": [
        {
          "text": "Iyo imakonda munthu woyankhula choonadi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.13",
            "verseOrgIds": [
              "PRO.16.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ukali wa mfumu ndi mthenga wa imfa,",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:14"
      },
      "items": [
        {
          "text": "koma munthu wanzeru amawupepesa ukaliwo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.14",
            "verseOrgIds": [
              "PRO.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwala kwa nkhope ya mfumu kumapatsa moyo;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:15"
      },
      "items": [
        {
          "text": "ndipo kukoma mtima kwake kuli ngati mitambo ya mvula nthawi ya chilimwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.15",
            "verseOrgIds": [
              "PRO.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼkwabwino kwambiri kupeza nzeru kupambana golide.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:16"
      },
      "items": [
        {
          "text": "Kukhala womvetsa bwino zinthu nʼkwabwino kupambana ndi kukhala ndi siliva.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.16",
            "verseOrgIds": [
              "PRO.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msewu wa munthu wowongoka mtima umapewa zoyipa;",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PRO 16:17"
      },
      "items": [
        {
          "text": "wopenyetsetsa kumene akupita amasunga moyo wake.",
          "type": "text",
