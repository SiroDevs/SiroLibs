  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "AMO 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Dzombe, Moto ndi Chingwe Chowongolera Khoma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene Ambuye Yehova anandionetsa ndi izi: Yehova ankasonkhanitsa gulu la dzombe nthawi imene gawo la zokolola za mfumu linali litakololedwa kale ndipo mbewu zachiwiri zinali zitangoyamba kumera kumene.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.1",
            "verseOrgIds": [
              "AMO.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dzombelo litadya zomera zonse za mʼdzikomo, Ine ndinafuwula kuti, \"Ambuye Yehova, khululukani! Kodi Yakobo adzapulumuka bwanji? Iye ndi wofowoka kwambiri!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.2",
            "verseOrgIds": [
              "AMO.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Yehova anakhululuka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:3"
      },
      "items": [
        {
          "text": "Yehovayo anati, \"Izi sizidzachitika.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.3",
            "verseOrgIds": [
              "AMO.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene Ambuye Yehova anandionetsa ndi izi: Ambuye Yehova ankayitana malawi a moto kuti alange anthu. Motowo unawumitsa nyanja yakuya ndi kupsereza dziko.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.4",
            "verseOrgIds": [
              "AMO.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono ine ndinafuwula kuti, \"Ambuye Yehova, chonde ndikukupemphani, lekani! Kodi Yakobo adzapulumuka bwanji? Iye ndi wofowoka kwambiri!\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.5",
            "verseOrgIds": [
              "AMO.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Yehova anakhululuka.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:6"
      },
      "items": [
        {
          "text": "Ambuye Yehova anati, \"Izinso sizidzachitika.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.6",
            "verseOrgIds": [
              "AMO.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimene Iye anandionetsa ndi izi: Ambuye anayima pambali pa khoma lomangamanga, mʼmanja mwake muli chingwe chowongolera khoma.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.7",
            "verseOrgIds": [
              "AMO.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Ambuye anandifunsa kuti, \"Amosi, nʼchiyani ukuonachi?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "Ine ndinayankha kuti, \"Chingwe chowongolera khoma.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "AMO 7:8"
      },
      "items": [
        {
          "text": "Ndipo Yehova anati, \"Taona, Ine ndikuyika chingwe chowongolerachi pakati pa anthu anga, Aisraeli; sindidzawalekereranso.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.8",
            "verseOrgIds": [
              "AMO.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Malo achipembedzo a Isake adzawonongedwa",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:9"
      },
      "items": [
        {
          "text": "ndipo malo opatulika a Israeli adzasanduka bwinja;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:9"
      },
      "items": [
        {
          "text": "ndidzagwetsa nyumba ya Yeroboamu ndi lupanga langa.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.9",
            "verseOrgIds": [
              "AMO.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amosi ndi Amaziya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo Amaziya wansembe wa ku Beteli anatumiza uthenga kwa Yeroboamu mfumu ya Israeli kuti, \"Amosi akukuutsirani chiwembu pakati pa Aisraeli. Dziko silingalekerere zonena zake zonsezo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.10",
            "verseOrgIds": [
              "AMO.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti zimene Amosi akunena ndi izi:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "\" 'Yeroboamu adzaphedwa ndi lupanga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "ndipo Israeli adzapita ndithu ku ukapolo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:11"
      },
      "items": [
        {
          "text": "kutali ndi dziko lake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.11",
            "verseOrgIds": [
              "AMO.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Amaziya anawuza Amosi kuti, \"Choka, mlosi iwe! Bwerera ku dziko la Yuda. Uzikalosera kumeneko ndipo anthu a kumeneko azikakudyetsa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.12",
            "verseOrgIds": [
              "AMO.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usanenerenso ku Beteli, chifukwa kumeneko ndi malo opatulika a mfumu ndiponso ndi malo a nyumba yachipembedzo yaufumu.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.13",
            "verseOrgIds": [
              "AMO.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amosi anayankha Amaziya kuti, \"Ine sindine mneneri kapena mwana wa mneneri; koma ndine woweta ziweto, ndiponso mlimi wa nkhuyu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.14",
            "verseOrgIds": [
              "AMO.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova ananditenga ndikuweta nkhosa ndipo anati, 'Pita ukanenere kwa anthu anga Aisraeli.'",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.15",
            "verseOrgIds": [
              "AMO.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono imva mawu a Yehova. Iwe ukunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.16",
            "verseOrgIds": [
              "AMO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:16"
      },
      "items": [
        {
          "text": "\" 'Usanenere zotsutsa Israeli,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.16",
            "verseOrgIds": [
              "AMO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:16"
      },
      "items": [
        {
          "text": "ndipo siya kulalikira motsutsa nyumba ya Isake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.16",
            "verseOrgIds": [
              "AMO.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "AMO 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsono zimene akunena Yehova ndi izi:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "\" 'Mkazi wako adzasanduka wachiwerewere mu mzindamu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "ndipo ana ako aamuna ndi aakazi adzaphedwa ndi lupanga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "Munda wako udzayezedwa ndi chingwe ndi kugawidwa,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "ndipo iwe mwini udzafera mʼdziko la anthu osapembedza Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "Ndipo Israeli adzatengedwa ndithu kupita ku ukapolo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 7:17"
      },
      "items": [
        {
          "text": "kutali ndi dziko lake.' \"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.7.17",
            "verseOrgIds": [
              "AMO.7.17"
            ]
          }
        }
      ]
    }
  ],
