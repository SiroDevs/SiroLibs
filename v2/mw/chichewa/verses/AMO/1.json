          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:8"
      },
      "items": [
        {
          "text": "mpaka wotsala mwa Afilisti atafa,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 1:8"
      },
      "items": [
