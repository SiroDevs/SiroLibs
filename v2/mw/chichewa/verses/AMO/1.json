      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:9"
      },
      "items": [
        {
          "text": "osasunga pangano laubale lija,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.9",
            "verseOrgIds": [
              "AMO.1.9"
            ]
          }
        }
      ]
    },
    {
