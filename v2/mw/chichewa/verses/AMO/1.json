    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:9"
      },
      "items": [
        {
          "text": "Popeza iwo anagulitsa mtundu wathunthu ku ukapolo ku Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.9",
            "verseOrgIds": [
              "AMO.1.9"
            ]
          }
        }
