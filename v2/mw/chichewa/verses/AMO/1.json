      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:11"
      },
      "items": [
        {
          "text": "popanda nʼchifundo chomwe.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.11",
            "verseOrgIds": [
              "AMO.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:11"
      },
      "items": [
        {
          "text": "Popeza mkwiyo wake unakulabe",
