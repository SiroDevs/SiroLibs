    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:7"
      },
      "items": [
        {
          "text": "umene udzanyeketsa nyumba zake zaufumu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
      ]
    },
