      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:11"
      },
      "items": [
        {
          "text": "Popeza anathamangitsa mʼbale wake ndi lupanga,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.11",
            "verseOrgIds": [
              "AMO.1.11"
            ]
