    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawu a Amosi, mmodzi mwa anthu oweta nkhosa ku Tekowa. Zimene iye anaona mʼmasomphenya zokhudza Israeli patatsala zaka ziwiri kuti chivomerezi chichitike, nthawi imene Uziya anali mfumu ya Yuda ndipo Yeroboamu mwana wa Yowasi anali mfumu ya Israeli.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.1",
            "verseOrgIds": [
              "AMO.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amosi anati:",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "\"Yehova akubangula mu Ziyoni",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "ndipo akumveka ngati bingu mu Yerusalemu;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "msipu wa abusa ukulira,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:2"
      },
      "items": [
        {
          "text": "ndipo pamwamba pa Karimeli pakuwuma.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.2",
            "verseOrgIds": [
              "AMO.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chiweruzo pa Anthu Oyandikana ndi Israeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "\"Chifukwa anthu a ku Damasiko akunka nachimwirachimwira,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "Ine sindileka kuwalanga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "Popeza anapuntha Giliyadi",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:3"
      },
      "items": [
        {
          "text": "ndi zopunthira za mano achitsulo,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzatumiza moto pa nyumba ya Hazaeli",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:4"
      },
      "items": [
        {
          "text": "umene udzanyeketsa nyumba zaufumu za Beni-Hadadi.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.4",
            "verseOrgIds": [
              "AMO.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzathyola chipata cha Damasiko;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "ndidzawononga mfumu yokhala ku Chigwa cha Aveni,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "ndiponso iye amene akugwira ndodo yaufumu mu Beti-Edeni.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "Anthu a ku Aramu adzapita ku ukapolo ku Kiri,\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.5",
            "verseOrgIds": [
              "AMO.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q4",
        "vid": "AMO 1:5"
      },
      "items": [
        {
          "text": "akutero Yehova.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "\"Chifukwa anthu a ku Gaza akunka nachimwirachimwira,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "Ine sindileka kuwalanga.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "Popeza anatenga ukapolo mtundu wathunthu",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 1:6"
      },
      "items": [
        {
          "text": "ndi kuwugulitsa ku Edomu,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.6",
            "verseOrgIds": [
              "AMO.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndidzatumiza moto pa makoma a Gaza",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        }
