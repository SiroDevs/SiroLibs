      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:16"
      },
      "items": [
        {
          "text": "ndipo umate malamulowa pamaso pa ophunzira anga.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.16",
            "verseOrgIds": [
              "ISA.8.16"
            ]
          }
        }
      ]
