  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "ISA 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Asiriya, Chida cha Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anati kwa ine, \"Tenga cholembapo chachikulu ndipo ulembepo malemba odziwika bwino:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "sc"
          },
          "items": [
            {
              "text": "Kusakaza-Kwamsanga Kufunkha-Kofulumira",
              "type": "text",
              "attrs": {
                "verseId": "ISA.8.1",
                "verseOrgIds": [
                  "ISA.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.1",
            "verseOrgIds": [
              "ISA.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndidzayitana wansembe Uriya ndi Zekariya mwana wa Yeberekiya kuti akhale mboni zanga zodalirika.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.2",
            "verseOrgIds": [
              "ISA.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ine ndinapita kwa mneneri wamkazi, ndipo anakhala woyembekezera nabala mwana wamwamuna. Ndipo Yehova anati kwa ine, \"Umutche dzina lakuti, 'Kusakaza-Kwamsanga Kufunkha-Kofulumira.'",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.3",
            "verseOrgIds": [
              "ISA.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanayo asanayambe kudziwa kuyitana kuti, 'Ababa' kapena 'Amama' chuma cha Damasiko ndi zofunkha za Samariya zidzatengedwa ndi mfumu ya ku Asiriya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.4",
            "verseOrgIds": [
              "ISA.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anayankhulanso ndi Ine;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.5",
            "verseOrgIds": [
              "ISA.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Popeza anthu a dziko ili akana",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "madzi anga oyenda mwachifatse a ku Siloamu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "ndipo akukondwerera Rezini",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:6"
      },
      "items": [
        {
          "text": "ndi mwana wa Remaliya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.6",
            "verseOrgIds": [
              "ISA.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼchifukwa chake Ambuye ali pafupi kubweretsa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "madzi amkokomo a mtsinje wa Yufurate kudzalimbana nawo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "mfumu ya ku Asiriya ndi gulu lake lonse lankhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "Madziwo adzasefukira mʼngalande zake zonse",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:7"
      },
      "items": [
        {
          "text": "ndi mʼmagombe ake onse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.7",
            "verseOrgIds": [
              "ISA.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo adzalowa mwamphamvu mʼdziko la Yuda, adzasefukira,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "adzapitirira mpaka kumuyesa mʼkhosi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "Mapiko ake otambasuka adzaphimba dziko lako lonse,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:8"
      },
      "items": [
        {
          "text": "iwe Imanueli!\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.8",
            "verseOrgIds": [
              "ISA.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chitani phokoso lankhondo, inu mitundu ya anthu, ndipo munjenjemere!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Tamverani, inu mayiko onse akutali.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Konzekerani nkhondo ndipo munjenjemere!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:9"
      },
      "items": [
        {
          "text": "Konzekerani nkhondo ndipo munjenjemere!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.9",
            "verseOrgIds": [
              "ISA.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Konzani kachitidwe kanu kankhondo, koma simudzaphula kanthu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "kambiranani zochita, koma zidzalephereka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:10"
      },
      "items": [
        {
          "text": "pakuti Mulungu ali nafe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.10",
            "verseOrgIds": [
              "ISA.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehova Achenjeza Mneneri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiyankhula ine mwamphamvu, ndipo anandichenjeza kuti ndisamayende mʼnjira za anthuwa. Iye anati:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.11",
            "verseOrgIds": [
              "ISA.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Usamanene kuti ndi chiwembu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "chilichonse chimene anthuwa amati ndi chiwembu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "usamaope zimene anthuwa amaziopa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:12"
      },
      "items": [
        {
          "text": "ndipo usamachite nazo mantha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.12",
            "verseOrgIds": [
              "ISA.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Wamphamvuzonse ndiye amene uyenera kumuona kuti ndi woyera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "ndiye amene uyenera kumuopa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:13"
      },
      "items": [
        {
          "text": "ndiye amene uyenera kuchita naye mantha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.13",
            "verseOrgIds": [
              "ISA.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndipo ndiye amene adzakhala malo opatulika;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "koma kwa anthu a ku Yuda ndi kwa anthu a ku Israeli adzakhala",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "mwala wopunthwitsa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "mwala umene umapunthwitsa anthu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "thanthwe limene limagwetsa anthu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:14"
      },
      "items": [
        {
          "text": "Ndipo kwa anthu a mu Yerusalemu adzakhala ngati msampha ndi khwekhwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.14",
            "verseOrgIds": [
              "ISA.8.14"
            ]
          }
        }
      ]
    },
    {
