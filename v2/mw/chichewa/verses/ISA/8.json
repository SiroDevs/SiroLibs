      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:15"
      },
      "items": [
        {
          "text": "adzagwa ndi kuthyokathyoka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.15",
            "verseOrgIds": [
              "ISA.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 8:15"
      },
      "items": [
        {
          "text": "adzakodwa ndi kugwidwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.8.15",
            "verseOrgIds": [
              "ISA.8.15"
            ]
          }
        }
      ]
