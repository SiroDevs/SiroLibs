  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "64",
        "style": "c",
        "sid": "ISA 64"
      },
      "items": [
        {
          "text": "64",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 64:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, bwanji mukanangongʼamba mlengalenga ndi kutsika pansi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:1"
      },
      "items": [
        {
          "text": "kuti mapiri agwedezeke pamaso panu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.1",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 64:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Monga momwe moto umatenthera tchire",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "ndiponso kuwiritsa madzi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "tsikani kuti adani anu adziwe dzina lanu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:2"
      },
      "items": [
        {
          "text": "ndiponso kuti mitundu ya anthu injenjemere pamaso panu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.2",
            "verseOrgIds": [
              "ISA.64.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 64:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti nthawi ina pamene munatsika munachita zinthu zoopsa zimene sitinaziyembekezere,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:3"
      },
      "items": [
        {
          "text": "ndipo mapiri anagwedezeka pamaso panu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.3",
            "verseOrgIds": [
              "ISA.64.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 64:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chikhalire palibe ndi mmodzi yemwe anamvapo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "kapena kuona",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "Mulungu wina wonga Inu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:4"
      },
      "items": [
        {
          "text": "amene amachitira zinthu zotere amene amadikira pa Iye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.4",
            "verseOrgIds": [
              "ISA.64.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 64:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu mumabwera kudzathandiza onse amene amakondwera pochita zolungama,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "amene amakumbukira njira zanu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "Koma Inu munakwiya,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "ife tinapitiriza kuchimwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:5"
      },
      "items": [
        {
          "text": "Kodi nanga tingapulumutsidwe bwanji?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.5",
            "verseOrgIds": [
              "ISA.64.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 64:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tonsefe takhala ngati anthu amene ndi odetsedwa,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "ndipo ntchito zathu zili ngati sanza za msambo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "tonse tafota ngati tsamba,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:6"
      },
      "items": [
        {
          "text": "ndipo machimo athu akutiwuluzira kutali ngati mphepo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.6",
            "verseOrgIds": [
              "ISA.64.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 64:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Palibe amene amapemphera kwa Inu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "kutekeseka kuti apemphe chithandizo kwa Inu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "pakuti mwatifulatira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:7"
      },
      "items": [
        {
          "text": "ndi kutisiya chifukwa cha machimo athu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.7",
            "verseOrgIds": [
              "ISA.64.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 64:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Komabe, Inu Yehova ndinu Atate athu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "Ife ndife chowumba, Inu ndinu wowumba;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:8"
      },
      "items": [
        {
          "text": "ife tonse ndi ntchito ya manja anu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.8",
            "verseOrgIds": [
              "ISA.64.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 64:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, musatikwiyire kopitirira muyeso",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "musakumbukire machimo athu mpaka muyaya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "Chonde, mutiganizire, ife tikupempha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:9"
      },
      "items": [
        {
          "text": "pakuti tonsefe ndi anthu anu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.9",
            "verseOrgIds": [
              "ISA.64.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 64:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mizinda yanu yopatulika yasanduka chipululu;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:10"
      },
      "items": [
        {
          "text": "ngakhaletu Ziyoni wasanduka chipululu, Yerusalemu ndi wamasiye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.10",
            "verseOrgIds": [
              "ISA.64.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 64:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyumba yanu yopatulika ndi yaulemu, kumene makolo athu ankakutamandani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "yatenthedwa ndi moto",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:11"
      },
      "items": [
        {
          "text": "ndipo malo onse amene tinkawakonda asanduka bwinja.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.11",
            "verseOrgIds": [
              "ISA.64.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 64:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova, zonse zachitikazi, kodi mungokhala osatithandiza?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 64:12"
      },
      "items": [
        {
          "text": "Kodi mudzapitirizabe kukhala chete ndi kutilangabe mopitirira muyeso?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.64.12",
            "verseOrgIds": [
              "ISA.64.11"
            ]
          }
        }
      ]
    }
  ],
