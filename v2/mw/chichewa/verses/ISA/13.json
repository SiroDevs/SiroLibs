  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "ISA 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulangidwa Kwa Babuloni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uthenga onena za Babuloni umene Yesaya mwana wa Amozi anawulandira:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.1",
            "verseOrgIds": [
              "ISA.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwezani mbendera yankhondo pa phiri loti see,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "muwafuwulire ankhondo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "muwakodole kuti adzalowe pa zipata",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:2"
      },
      "items": [
        {
          "text": "za anthu olemekezeka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.2",
            "verseOrgIds": [
              "ISA.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine Yehova, ndalamulira ankhondo anga;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "ndasonkhanitsa ankhondo anga kuti akhale zida zanga zolangira",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:3"
      },
      "items": [
        {
          "text": "amene amadzikuza ndi chipambano changa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.3",
            "verseOrgIds": [
              "ISA.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tamvani phokoso ku mapiri,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "likumveka ngati phokoso la gulu lalikulu la anthu!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "Tamvani phokoso pakati pa maufumu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "ngati kuti mitundu ya anthu ikusonkhana pamodzi!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "Yehova Wamphamvuzonse akukhazika asilikali ake mokonzekera",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:4"
      },
      "items": [
        {
          "text": "kuchita nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.4",
            "verseOrgIds": [
              "ISA.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo akuchokera ku mayiko akutali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "kuchokera kumalekezero a dziko",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "Yehova ali ndi zida zake za nkhondo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:5"
      },
      "items": [
        {
          "text": "kuti adzawononge dziko la Babuloni.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.5",
            "verseOrgIds": [
              "ISA.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lirani mofuwula, pakuti tsiku la Yehova layandikira;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:6"
      },
      "items": [
        {
          "text": "lidzabwera ngati chiwonongeko chochokera kwa Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.6",
            "verseOrgIds": [
              "ISA.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zimenezi zinafowoketsa manja onse,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:7"
      },
      "items": [
        {
          "text": "mtima wa munthu aliyense udzachokamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.7",
            "verseOrgIds": [
              "ISA.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu adzagwidwa ndi mantha aakulu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "zowawa ndi masautso zidzawagwera;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "adzamva zowawa zonga amamva mayi pobereka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "Adzayangʼanana mwamantha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:8"
      },
      "items": [
        {
          "text": "nkhope zawo zikufiira ngati malawi amoto.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.8",
            "verseOrgIds": [
              "ISA.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, tsiku la Yehova likubwera,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "tsiku lopanda chisoni, lawukali ndi lamkwiyo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "kudzasandutsa dziko kuti likhale chipululu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:9"
      },
      "items": [
        {
          "text": "ndi kuwononga anthu ochimwa a mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.9",
            "verseOrgIds": [
              "ISA.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyenyezi zakumwamba ndiponso zonse zamlengalenga",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "sizidzaonetsa kuwala kwawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "Dzuwa lidzada potuluka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:10"
      },
      "items": [
        {
          "text": "ndipo mwezi sudzawala konse.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.10",
            "verseOrgIds": [
              "ISA.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzalanga dziko lonse chifukwa cha zolakwa zake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "anthu oyipa ndidzawalanga chifukwa cha machimo awo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "Ndidzathetsa kunyada kwa odzikuza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:11"
      },
      "items": [
        {
          "text": "ndipo ndidzatsitsa kudzitukumula kwa anthu ankhanza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.11",
            "verseOrgIds": [
              "ISA.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzasandutsa anthu kukhala ovuta kupeza kuposa mmene amasowera golide wabwino.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 13:12"
      },
      "items": [
        {
          "text": "Iwo sazidzapezekapezeka kuposa mmene amasowera golide wa ku Ofiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.13.12",
            "verseOrgIds": [
              "ISA.13.12"
            ]
          }
        }
      ]
    },
    {
