  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ISA 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Phiri la Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nazi zinthu zokhudza Yuda ndi Yerusalemu, zimene Yesaya mwana wa Amozi anaziona mʼmasomphenya:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.1",
            "verseOrgIds": [
              "ISA.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼmasiku otsiriza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "phiri la Nyumba ya Yehova adzalikhazikitsa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "kukhala lalitali kuposa mapiri ena onse,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "lidzaonekera pamwamba pa mapiri ena onse,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:2"
      },
      "items": [
        {
          "text": "ndipo mayiko onse adzathamangira kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.2",
            "verseOrgIds": [
              "ISA.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu ambiri adzabwera ndikunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "\"Tiyeni tikwere ku phiri la Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "ku nyumba ya Mulungu wa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Iye adzatiphunzitsa njira zake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "ndipo tidzayenda mʼnjira zakezo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "Malangizo adzachokera ku Ziyoni,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:3"
      },
      "items": [
        {
          "text": "mawu a Yehova adzachokera ku Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.3",
            "verseOrgIds": [
              "ISA.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye adzaweruza pakati pa mayiko,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "ndipo adzathetsa kusamvana pakati pa anthu ambiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Anthuwo adzasandutsa malupanga awo kukhala makasu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "ndiponso mikondo yawo kukhala zomwetera.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "Mtundu wina sudzatenganso lupanga kumenyana ndi mtundu wina,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:4"
      },
      "items": [
        {
          "text": "kapena kuphunziranso za nkhondo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.4",
            "verseOrgIds": [
              "ISA.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu nyumba ya Yakobo, bwerani,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:5"
      },
      "items": [
        {
          "text": "tiyeni tiyende mʼkuwala kwa Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.5",
            "verseOrgIds": [
              "ISA.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Tsiku la Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Inu Yehova mwawakana anthu anu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "nyumba ya Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "Iwo adzaza ndi zamatsenga zochokera Kummawa;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "amawombeza mawula ngati Afilisti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:6"
      },
      "items": [
        {
          "text": "ndipo amayanjana ndi anthu osapembedza Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.6",
            "verseOrgIds": [
              "ISA.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko lawo ndi lodzaza ndi siliva ndi golide;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "ndipo chuma chawo ndi chosatha.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "Dziko lawo ndi lodzaza ndi akavalo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:7"
      },
      "items": [
        {
          "text": "ndipo magaleta awo ankhondo ngosawerengeka.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.7",
            "verseOrgIds": [
              "ISA.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dziko lawo ndi lodzaza ndi mafano;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "iwo amapembedza ntchito ya manja awo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:8"
      },
      "items": [
        {
          "text": "amagwadira zomwe anapanga ndi zala zawo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.8",
            "verseOrgIds": [
              "ISA.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono munthu aliyense adzachepetsedwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
      "items": [
        {
          "text": "ndi kutsitsidwa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:9"
      },
      "items": [
        {
          "text": "Inu Yehova musawakhululukire.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.9",
            "verseOrgIds": [
              "ISA.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lowani mʼmatanthwe,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "bisalani mʼmaenje,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "kuthawa kuopsa kwa Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:10"
      },
      "items": [
        {
          "text": "ndi ulemerero wa ufumu wake!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.10",
            "verseOrgIds": [
              "ISA.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kudzikuza kwa anthu kudzatha,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.2.11",
            "verseOrgIds": [
              "ISA.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 2:11"
      },
      "items": [
        {
          "text": "ndipo kudzitama kwa anthu kudzawonongedwa;",
          "type": "text",
