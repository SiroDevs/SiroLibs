  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "ISA 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mtumiki wa Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nayu mtumiki wanga, amene ndimamuchirikiza,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "amene ndamusankha, amenenso ndimakondwera naye.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "Ndayika Mzimu wanga mwa Iyeyo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:1"
      },
      "items": [
        {
          "text": "ndipo adzaweruza anthu a mitundu yonse mwachilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.1",
            "verseOrgIds": [
              "ISA.42.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye sadzafuwula, sadzamveka mawu,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:2"
      },
      "items": [
        {
          "text": "kapena mawu ake kumveka mʼmisewu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.2",
            "verseOrgIds": [
              "ISA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bango lophwanyika sadzalithyola,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:3"
      },
      "items": [
        {
          "text": "ndipo moto wozilala sadzawuzimitsa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:3"
      },
      "items": [
        {
          "text": "Motero adzaonetsa kuti chilungamo ndicho choonadi;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.3",
            "verseOrgIds": [
              "ISA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "sadzafowoka kapena kukhumudwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:4"
      },
      "items": [
        {
          "text": "mpaka atakhazikitsa chilungamo pa dziko lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:4"
      },
      "items": [
        {
          "text": "ndi mpaka mayiko a mʼmbali mwa nyanja atafika poyembekezera malangizo ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.4",
            "verseOrgIds": [
              "ISA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova Mulungu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "amene analenga zamlengalenga ndi kuziyalika,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "amene analenga dziko lapansi ndi zonse zimene zimabereka,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "amenenso amapereka mpweya kwa anthu ake okhala mʼdzikomo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:5"
      },
      "items": [
        {
          "text": "ndi moyo kwa onse oyendamo, akuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.5",
            "verseOrgIds": [
              "ISA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine Yehova, ndakuyitana chifukwa Ine ndine wolungama;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "ndikugwira dzanja ndipo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "ndidzakuteteza.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "Ndakupereka kukhala pangano langa kwa anthu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:6"
      },
      "items": [
        {
          "text": "ndi kuwunika kwa anthu a mitundu ina.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.6",
            "verseOrgIds": [
              "ISA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzatsekula maso a anthu osaona,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:7"
      },
      "items": [
        {
          "text": "udzamasula anthu a mʼndende",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:7"
      },
      "items": [
        {
          "text": "ndi kutulutsa mʼndende anthu okhala mu mdima.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.7",
            "verseOrgIds": [
              "ISA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ine ndine Yehova: dzina langa ndi limenelo!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:8"
      },
      "items": [
        {
          "text": "Sindidzapereka ulemerero wanga kwa wina aliyense",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:8"
      },
      "items": [
        {
          "text": "kapena matamando anga kwa mafano.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.8",
            "verseOrgIds": [
              "ISA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taonani, zinthu zimene ndinalosera kale zachitikadi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "ndipo ndikuwuzani zinthu zatsopano;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "zinthuzo zisanaonekere",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:9"
      },
      "items": [
        {
          "text": "Ine ndakudziwitsani.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.9",
            "verseOrgIds": [
              "ISA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyimbo Yotamanda Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Imbirani Yehova nyimbo yatsopano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "mutamandeni inu okhala mʼdziko lonse lapansi,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "inu amene mumayenda pa nyanja, nyanja ikokome ndi zonse zili mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:10"
      },
      "items": [
        {
          "text": "Inu okhala pa zilumba tamandani Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.10",
            "verseOrgIds": [
              "ISA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 42:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chipululu ndi mizinda yake zikweze mawu awo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "midzi ya Akedara ikondwere.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "Anthu a ku Sela ayimbe mwachimwemwe;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:11"
      },
      "items": [
        {
          "text": "afuwule kuchokera pamwamba pa mapiri.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.11",
            "verseOrgIds": [
              "ISA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 42:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamande Yehova",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.12",
            "verseOrgIds": [
