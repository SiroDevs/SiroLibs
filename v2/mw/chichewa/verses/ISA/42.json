      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:20"
      },
      "items": [
        {
          "text": "makutu ako ndi otsekuka koma sumva kanthu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
    },
