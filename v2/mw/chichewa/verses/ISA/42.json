      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "popanda wina wowapulumutsa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
