      "attrs": {
        "style": "q2",
        "vid": "ISA 42:14"
      },
      "items": [
        {
          "text": "ndakhala ndili phee osachita kanthu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
            ]
          }
        }
      ]
