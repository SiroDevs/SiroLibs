          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma awa ndi anthu amene afunkhidwa ndi kuwalanda zinthu zawo,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
