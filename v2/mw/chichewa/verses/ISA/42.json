      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:16"
      },
      "items": [
        {
          "text": "ndidzawatsogolera mʼnjira zimene sanayendepo;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.16",
            "verseOrgIds": [
              "ISA.42.16"
            ]
          }
        }
      ]
