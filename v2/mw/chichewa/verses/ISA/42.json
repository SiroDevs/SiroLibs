      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "kapena kunena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:22"
      },
      "items": [
        {
          "text": "\"Abwezeni kwawo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.22",
            "verseOrgIds": [
              "ISA.42.22"
            ]
          }
        }
      ]
    },
