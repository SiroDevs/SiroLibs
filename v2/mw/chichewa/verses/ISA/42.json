          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 42:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe waona zinthu zambiri, koma sunazisamale;",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.20",
            "verseOrgIds": [
              "ISA.42.20"
            ]
          }
        }
      ]
