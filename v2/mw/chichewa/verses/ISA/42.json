              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova akuti, \"Ndakhala ndili chete kwa nthawi yayitali,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.14",
            "verseOrgIds": [
              "ISA.42.14"
