    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:18"
      },
      "items": [
        {
          "text": "yangʼanani osaona inu, kuti muone!",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.18",
            "verseOrgIds": [
              "ISA.42.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 42:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali wosaona ndani, si mtumiki wanga kodi?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:19"
      },
      "items": [
        {
          "text": "Ndipo ndani ali wosamva ngati mthenga amene ndamutuma?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ISA 42:19"
      },
      "items": [
        {
          "text": "Kodi ndani ali wosaona ngati uja ndinachita naye pangano,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:19"
      },
      "items": [
        {
          "text": "kapena wosaona ndani ngati mtumiki wa Yehova?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.19",
            "verseOrgIds": [
              "ISA.42.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
