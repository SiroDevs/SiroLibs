      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ISA 42:21"
      },
      "items": [
        {
          "text": "chifukwa cha chilungamo chake,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.42.21",
            "verseOrgIds": [
              "ISA.42.21"
            ]
          }
        }
      ]
