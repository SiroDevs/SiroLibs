          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsoka kwa amene amawuza mtengo kuti, 'Khala wamoyo!'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Kapena mwala wopanda moyo kuti, 'Dzuka!'",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Kodi zimenezi zingathe kulangiza?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "Ndi zokutidwa ndi golide ndi siliva;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:19"
      },
      "items": [
        {
          "text": "mʼkati mwake mulibe mpweya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.19",
            "verseOrgIds": [
              "HAB.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HAB 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Yehova ali mʼNyumba yake yopatulika;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.20",
            "verseOrgIds": [
              "HAB.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:20"
      },
      "items": [
        {
          "text": "dziko lonse lapansi likhale chete pamaso pake.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.20",
            "verseOrgIds": [
              "HAB.2.20"
            ]
          }
