  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "HAB 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndidzakhala pa malo anga aulonda,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "ndi kuyima pa mitumbira ya nkhondo;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "ndidzadikira kuti ndimve zimene Iye adzandiwuze,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:1"
      },
      "items": [
        {
          "text": "ndi yankho limene ndidzapatsidwe pa madandawulo anga.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.1",
            "verseOrgIds": [
              "HAB.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yankho la Yehova",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yehova anandiyankha, nati:",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "\"Lemba masomphenyawa",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "ndipo uwalembe mooneka bwino pa mapale",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:2"
      },
      "items": [
        {
          "text": "kuti wowerenga awawerenge mosavuta.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.2",
            "verseOrgIds": [
              "HAB.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti masomphenyawa akudikira nthawi yake;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "masomphenyawa akunena zamʼtsogolo",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "ndipo sizidzalephera kuchitika.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "Ngakhale achedwe kukwaniritsidwa, uwayembekezere;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:3"
      },
      "items": [
        {
          "text": "zidzachitika ndithu ndipo sadzachedwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.3",
            "verseOrgIds": [
              "HAB.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taona, mdani wadzitukumula;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:4"
      },
      "items": [
        {
          "text": "zokhumba zake sizowongoka,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:4"
      },
      "items": [
        {
          "text": "koma wolungama adzakhala ndi moyo mwachikhulupiriro.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.4",
            "verseOrgIds": [
              "HAB.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndithu, wasokonezeka ndi vinyo;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "ndi wodzitama ndiponso wosakhazikika.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "Pakuti ngodzikonda ngati manda,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "ngosakhutitsidwa ngati imfa,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "wadzisonkhanitsira mitundu yonse ya anthu",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:5"
      },
      "items": [
        {
          "text": "ndipo wagwira ukapolo anthu a mitundu yonse.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.5",
            "verseOrgIds": [
              "HAB.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi onse ogwidwawo sadzamunyoza ndi kumunyogodola ponena kuti,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "\"Tsoka kwa amene amadzikundikira katundu amene si wake",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "ndipo amadzilemeretsa ndi chuma cholanda!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:6"
      },
      "items": [
        {
          "text": "Kodi izi zidzachitika mpaka liti?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.6",
            "verseOrgIds": [
              "HAB.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi angongole ako sadzakuwukira mwadzidzidzi?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "Kodi sadzadzuka ndi kukuchititsa mantha?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:7"
      },
      "items": [
        {
          "text": "Pamenepo iwe udzalandidwa kalikonse.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.7",
            "verseOrgIds": [
              "HAB.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti unafunkha mitundu yambiri ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "mitundu ina imene inatsala idzakufunkha iweyo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "Pakuti wakhetsa magazi a anthu;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:8"
      },
      "items": [
        {
          "text": "wawononga mayiko ndi mizinda ndi aliyense wokhala mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.8",
            "verseOrgIds": [
              "HAB.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsoka kwa amene amalemera ndi chuma chochipeza mwachinyengo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "kukweza malo ake okhalapo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:9"
      },
      "items": [
        {
          "text": "kuthawa mavuto!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.9",
            "verseOrgIds": [
              "HAB.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wakonzekera kuwononga mitundu yambiri ya anthu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:10"
      },
      "items": [
        {
          "text": "kuchititsa manyazi nyumba yako yomwe ndi kuwononga moyo wako.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.10",
            "verseOrgIds": [
              "HAB.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwala pa khoma udzafuwula,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:11"
      },
      "items": [
        {
          "text": "ndipo mitanda ya matabwa idzavomereza zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.11",
            "verseOrgIds": [
              "HAB.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsoka kwa amene amanga mzinda pokhetsa magazi",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:12"
      },
      "items": [
        {
          "text": "ndi kukhazikitsa mzinda pochita zoyipa!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.12",
            "verseOrgIds": [
              "HAB.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAB 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi Yehova Wamphamvuzonse sanatsimikize",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "kuti ntchito za anthu zili ngati nkhuni pa moto,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:13"
      },
      "items": [
        {
          "text": "ndi kuti mitundu ya anthu imadzitopetsa popanda phindu?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.13",
            "verseOrgIds": [
              "HAB.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAB 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti dziko lapansi lidzadzaza ndi chidziwitso cha ulemerero wa Yehova,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:14"
      },
      "items": [
        {
          "text": "monga momwe madzi amadzazira nyanja.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.14",
            "verseOrgIds": [
              "HAB.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAB 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsoka kwa amene amamwetsa anzake zakumwa zoledzeretsa,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:15"
      },
      "items": [
        {
          "text": "kutsanula mʼbotolo mpaka ataledzera,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:15"
      },
      "items": [
        {
          "text": "kuti aone umaliseche wawo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.15",
            "verseOrgIds": [
              "HAB.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzachita manyazi mʼmalo mokhala ndi ulemerero.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Tsopano ino ndi nthawi yako! Imwa mpaka umaliseche wako uwonekere!",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "Chikho chochokera mʼdzanja lamanja la Yehova chikubwera kwa iwe,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:16"
      },
      "items": [
        {
          "text": "ndipo manyazi adzaphimba ulemerero wako.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.16",
            "verseOrgIds": [
              "HAB.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAB 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzathedwa nzeru ndi chiwawa chimene unachita ku Lebanoni,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "ndiponso udzachita mantha ndi nyama zimene unaziwononga.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "Pakuti wakhetsa magazi a anthu;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:17"
      },
      "items": [
        {
          "text": "wawononga mayiko ndi mizinda ndi aliyense wokhala mʼmenemo.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.17",
            "verseOrgIds": [
              "HAB.2.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HAB 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kodi fano lili ndi phindu lanji, poti analisema ndi munthu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "kapena chifanizo chimene chimaphunzitsa mabodza?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "Pakuti munthu amene walipanga amakhulupirira ntchito ya manja ake;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 2:18"
      },
      "items": [
        {
          "text": "amapanga mafano amene samatha kuyankhula.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.2.18",
            "verseOrgIds": [
              "HAB.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
