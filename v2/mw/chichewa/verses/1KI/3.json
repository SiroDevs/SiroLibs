  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1KI 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoni Apempha Nzeru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anachita ubale ndi Farao mfumu ya ku Igupto ndipo anakwatira mwana wake wamkazi. Mkaziyo anabwera naye mu Mzinda wa Davide mpaka anatsiriza kumanga nyumba yaufumu ndi Nyumba ya Yehova ndiponso khoma lozungulira Yerusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma anthu ankaperekabe nsembe ku malo achipembedzo osiyanasiyana chifukwa chakuti mpaka pa nthawi imeneyo Dzina la Yehova anali asanalimangire nyumba.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anaonetsa chikondi chake pa Yehova poyenda motsatira malamulo a abambo ake Davide, kupatula kuti ankapereka nsembe ndi kufukiza lubani ku malo osiyanasiyana achipembedzo.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mfumu inapita ku Gibiyoni kukapereka nsembe popeza kumeneko ndiye kunali malo oposa malo ofunika kwambiri pachipembedzo. Kumeneko Solomoni anapereka nsembe zopsereza 1,000 pa guwa lansembe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.4",
            "verseOrgIds": [
              "1KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Gibiyoniko Yehova anaonekera kwa Solomoni mʼmaloto usiku, ndipo Mulungu anati, \"Pempha chilichonse chimene ukufuna ndipo ndidzakupatsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.5",
            "verseOrgIds": [
              "1KI.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni anayankha kuti, \"Inu munaonetsa kukoma mtima kwanu kwakukulu kwa kapolo wanu, abambo anga Davide, chifukwa anali wokhulupirika pamaso panu, wolungama mtima ndiponso wa mtima wangwiro. Inu mukupitirizabe kukoma mtima kwanu kwakukulu kwa iye ndipo mwamupatsa mwana kuti akhale pa mpando wake waufumu lero lino.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.6",
            "verseOrgIds": [
              "1KI.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Tsopano Inu Yehova Mulungu wanga, mtumiki wanune mwandiyika kukhala mfumu mʼmalo mwa abambo anga Davide. Komatu ndine mwana wamngʼono ndipo sindidziwa kagwiridwe kake ka ntchito yangayi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtumiki wanu ali pakati pa anthu amene munawasankha, mtundu waukulu, anthu ochuluka kwambiri osatheka kuwawerenga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.8",
            "verseOrgIds": [
              "1KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho mupatseni mtumiki wanu nzeru zolamulira anthu anu ndi kuti azitha kusiyanitsa pakati pa chabwino ndi choyipa. Pakuti ndani amene angathe kulamulira anthu anu ochulukawa?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.9",
            "verseOrgIds": [
              "1KI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuye anakondwera kuti Solomoni anapempha zimenezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.10",
            "verseOrgIds": [
              "1KI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Mulungu anati kwa Solomoni, \"Popeza wapempha zinthu zimenezi osati moyo wautali kapena chuma chako kapena imfa ya adani ako koma nzeru zolamulira anthu mwachilungamo,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.11",
            "verseOrgIds": [
              "1KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzakuchitira zimene wapempha. Ndidzakupatsa mtima wanzeru ndi wozindikira zinthu, kotero kuti sipanakhalepo wina wofanana nawe ndipo sipadzapezekanso wina wonga iwe pambuyo pako.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.12",
            "verseOrgIds": [
              "1KI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuwonjeza apo, ndidzakupatsa zimene sunazipemphe: chuma ndi ulemu, kotero kuti pa masiku onse a moyo wako sipadzakhala mfumu yofanana nawe.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.13",
            "verseOrgIds": [
              "1KI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ngati udzayenda mʼnjira zanga ndi kumvera malamulo anga ndiponso malangizo anga monga abambo ako Davide anachitira, ndidzakupatsa moyo wautali.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.14",
            "verseOrgIds": [
              "1KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero Solomoni anadzuka ndipo anazindikira kuti anali maloto.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:15"
      },
      "items": [
        {
          "text": "Iye anabwerera ku Yerusalemu nakayimirira patsogolo pa Bokosi la Chipangano la Ambuye ndipo anapereka nsembe zopsereza ndi nsembe zachiyanjano. Kenaka anakonzera phwando atumiki ake onse.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuweruza Kolungama",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawi ina amayi awiri adama anabwera kwa mfumu ndipo anayima pamaso pake.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.16",
            "verseOrgIds": [
              "1KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmodzi mwa amayiwo anati, \"Mbuye wanga, mayi uyu ndi ine timakhala nyumba imodzi. Ine ndinabala mwana tili limodzi ndi mnzangayu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.17",
            "verseOrgIds": [
              "1KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lachitatu ine nditabala mwana, mnzangayunso anabereka mwana wake. Tinalipo awiriwiri mʼnyumbamo ndipo munalibe wina aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.18",
            "verseOrgIds": [
              "1KI.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nthawi ya usiku mwana wa mnzangayu anafa chifukwa anamugonera.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.19",
            "verseOrgIds": [
              "1KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono iyeyu anadzuka pakati pa usiku, natenga mwana wanga ku mimba kwanga pamene ine mdzakazi wanu ndinali mʼtulo. Anamuyika mwanayo ku mimba kwake ndi kuyika mwana wake wakufayo ku mimba kwanga.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.20",
            "verseOrgIds": [
              "1KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmawa nditadzuka kuti ndiyamwitse mwana wanga ndinapeza kuti ndi wakufa! Koma kutacha nditamuyangʼanitsitsa ndinaona kuti si mwana amene ine ndinabala.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.21",
            "verseOrgIds": [
              "1KI.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mayi winayo anati, \"Ayi! Mwana wamoyoyu ndi wanga, mwana wakufayu ndi wako.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:22"
      },
      "items": [
        {
          "text": "Koma mayi woyambayo analimbikira kuti. \"Ayi! Mwana wakufayu ndi wako; wamoyoyu ndi wanga.\" Motero akaziwa anatsutsana pamaso pa mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mfumu inati, \"Wina akuti, 'Mwana wanga ndi wamoyoyu ndipo mwana wako ndi wakufayu,' pamene winanso akuti, 'Ayi! Mwana wako ndi wakufayu wanga ndi wamoyoyu.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.23",
            "verseOrgIds": [
              "1KI.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo mfumu inati, \"Patseni lupanga.\" Ndipo anabwera nalo lupanga kwa mfumu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
              "1KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono mfumu inagamula kuti, \"Muduleni pakati mwana wamoyoyu ndipo wina mumupatse gawo limodzi, gawo linalo mumupatse winayo.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mayi amene mwana wake anali moyo anagwidwa ndi chisoni chifukwa cha mwana wakeyo ndipo anawuza mfumu kuti, \"Chonde mbuye wanga, mupatseni mnzangayu mwana wamoyoyu! Musamuphe!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:26"
      },
      "items": [
        {
          "text": "Koma winayo anati, \"Ayi, asandipatse ine kapena iwe. Muduleni pakati!\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
