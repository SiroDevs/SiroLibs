  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "REV 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Babuloni Wagwa, Haleluya!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zitatha izi, ndinamva chimene chinamveka ngati phokoso la gulu lalikulu mmwamba likufuwula kuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:1"
      },
      "items": [
        {
          "text": "\"Haleluya!",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:1"
      },
      "items": [
        {
          "text": "Chipulumutso ndi ulemerero ndi mphamvu ndi za Mulungu wathu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.1",
            "verseOrgIds": [
              "REV.19.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuti chiweruzo chake ndi choona ndi cha chilungamo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:2"
      },
      "items": [
        {
          "text": "Iye waweruza mkazi wadama wotchuka uja",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:2"
      },
      "items": [
        {
          "text": "amene anayipitsa dziko lonse lapansi ndi zigololo zake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:2"
      },
      "items": [
        {
          "text": "Iye wabwezera pa mkaziyo magazi a atumiki ake.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.2",
            "verseOrgIds": [
              "REV.19.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo anafuwulanso kuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:3"
      },
      "items": [
        {
          "text": "\"Haleluya!",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:3"
      },
      "items": [
        {
          "text": "Utsi wochokera kwa mkazi wadamayo udzakwera kumwamba mpaka muyaya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.3",
            "verseOrgIds": [
              "REV.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akuluakulu 24 aja ndi zamoyo zinayi zija anadzigwetsa pansi kupembedza Mulungu amene anakhala pa mpando waufumu. Ndipo anafuwula kuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
            "verseOrgIds": [
              "REV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:4"
      },
      "items": [
        {
          "text": "\"Ameni, Haleluya!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.4",
            "verseOrgIds": [
              "REV.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mawu anachoka ku mpando waufumu kuti,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "\"Lemekezani Mulungu wathu",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "inu nonse atumiki ake,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "inu amene mumamuopa,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:5"
      },
      "items": [
        {
          "text": "nonse angʼono ndi akulu!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.5",
            "verseOrgIds": [
              "REV.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka ndinamva chimene chinamveka ngati gulu lalikulu, ngati mkokomo wamadzi othamanga ndipo ngati kugunda kwakukulu kwa bingu, ndipo anati,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:6"
      },
      "items": [
        {
          "text": "\"Haleluya!",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:6"
      },
      "items": [
        {
          "text": "Pakuti Ambuye Mulungu wathu Wamphamvuzonse akulamulira.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.6",
            "verseOrgIds": [
              "REV.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tiyeni tisangalale ndi kukondwera",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:7"
      },
      "items": [
        {
          "text": "ndi kumutamanda!",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 19:7"
      },
      "items": [
        {
          "text": "Pakuti nthawi ya ukwati wa Mwana Wankhosa yafika,",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:7"
      },
      "items": [
        {
          "text": "ndipo Mkwatibwi wakonzekeratu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.7",
            "verseOrgIds": [
              "REV.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wapatsidwa nsalu yoyera kwambiri, yowala ndi yosada",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 19:8"
      },
      "items": [
        {
          "text": "kuti avale.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "REV 19:8"
      },
      "items": [
        {
          "text": "(Nsalu yoyera kwambiri ikuyimira ntchito zolungama za oyera mtima).",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.8",
            "verseOrgIds": [
              "REV.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka mngelo anandiwuza kuti, \"Lemba kuti, Odala amene ayitanidwa ku phwando la ukwati wa Mwana Wankhosa.\" Ndipo anatinso, \"Awa ndiwo mawu woona a Mulungu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.9",
            "verseOrgIds": [
              "REV.19.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamenepo ndinadzigwetsa pa mapazi ake kumupembedza. Koma anandiwuza kuti, \"Usatero ayi, ine ndine mtumiki mnzako ngati iwe yemwe, ndiponso ngati abale ako amene asunga umboni wa Yesu. Pembedza Mulungu. Pakuti umboni wa Yesu ndiye mzimu wa uneneri.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.10",
            "verseOrgIds": [
              "REV.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Wokwera pa Kavalo Woyera",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndinaona kumwamba kutatsekuka ndipo patsogolo panga panali kavalo woyera, amene anakwerapo dzina lake linali Wokhulupirika ndiponso Woona. Poweruza ndi kuchita nkhondo, amachita molungama.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.11",
            "verseOrgIds": [
              "REV.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maso ake anali ngati malawi amoto, ndipo pamutu pake panali zipewa zaufumu zambiri. Anali ndi dzina lolembedwa, lodziwika ndi Iye yekha, osati wina aliyense.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.12",
            "verseOrgIds": [
              "REV.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anavala mkanjo woviyika mʼmagazi, ndipo dzina lake ndi Mawu a Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.13",
            "verseOrgIds": [
              "REV.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Magulu ankhondo akumwamba ankamutsatira atakwera pa akavalo oyera, ndipo iwowo atavala nsalu zoyera kwambiri ndi zosada.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.14",
            "verseOrgIds": [
              "REV.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mʼkamwa mwake munatuluka lupanga lakuthwa limene anati akaphe nalo mitundu ya anthu. Iye adzalamulira ndi ndodo yachitsulo. Iye anaponda choponderamo mphesa cha ukali wa Mulungu Wamphamvuzonse.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.15",
            "verseOrgIds": [
              "REV.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa chovala ndi pa ntchafu pake panalembedwa dzina ili:",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pc",
        "vid": "REV 19:16"
      },
      "items": [
        {
          "text": "MFUMU YA MAFUMU NDI MBUYE WA AMBUYE.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo ndinaona mngelo atayimirira pa dzuwa amene anafuwula ndi mawu okweza kwa mbalame zonse zowuluka mlengalenga kuti, \"Bwerani, sonkhanani pamodzi ku phwando lalikulu la Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
