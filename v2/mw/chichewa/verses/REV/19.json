        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti mudye mnofu wa mafumu, wa akulu a ankhondo, ndi wa anthu amphamvu, wa akavalo ndi okwerapo awo, ndi wa anthu onse, mfulu ndi akapolo, angʼono ndi aakulu.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka ndinaona chirombo chija ndi mafumu a dziko lapansi ndi magulu ankhondo atasonkhana pamodzi kuti achite nkhondo ndi wokwera pa kavalo ndi ankhondo ake.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.19",
            "verseOrgIds": [
              "REV.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma chirombocho chinagwidwa pamodzi ndi mneneri wonyenga uja amene anachita zizindikiro zodabwitsa pamaso pake. Ndi zizindikirozi anasocheretsa amene analembedwa chizindikiro cha chirombocho napembedza fano lake. Onse awiri anaponyedwa amoyo mʼnyanja yamoto yasulufule wotentha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.20",
            "verseOrgIds": [
              "REV.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "REV 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ena onse anaphedwa ndi lupanga lija linatuluka mʼkamwa mwa wokwera pa kavalo uja, ndipo mbalame zonse zinadya mokwanira mnofu wa anthu akufawo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.21",
            "verseOrgIds": [
              "REV.19.21"
            ]
          }
        }
      ]
    }
