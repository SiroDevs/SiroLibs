  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "19",
        "style": "c",
        "sid": "1SA 19"
      },
      "items": [
        {
          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sauli Ayesanso Kupha Davide",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli anawuza mwana wake Yonatani ndi nduna zake zonse kuti aphe Davide. Koma Yonatani amamukonda kwambiri Davide.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.1",
            "verseOrgIds": [
              "1SA.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anawuza Davide kuti, \"Abambo anga Sauli akufuna kukupha. Tsono uchenjere. Mmawa upite ukabisale ndipo ukakhale komweko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.2",
            "verseOrgIds": [
              "1SA.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzapita ndi kukayima pafupi ndi abambo anga ku munda kumene iwe ukabisale. Ndipo ndidzayankhula ndi abambo anga za iwe ndipo chilichonse chimene ndikamve ndidzakuwuza.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.3",
            "verseOrgIds": [
              "1SA.19.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Yonatani anakanena zabwino za Davide kwa abambo ake Sauli ndipo anati, \"Mfumu musachimwire mtumiki wanu Davide, sanakuchimwireni, koma amakuchitirani zabwino kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.4",
            "verseOrgIds": [
              "1SA.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayika moyo wake pa chiswe pamene anapha Mfilisiti uja. Choncho Yehova anachita zazikulu popambanitsa Aisraeli pa nkhondo. Inu munaona zonsezo ndipo munakondwera. Nanga nʼchifukwa chiyani mukufuna kuchimwira munthu wosalakwa pofuna kupha Davide?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.5",
            "verseOrgIds": [
              "1SA.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli anamvera mawu a Yonatani ndipo analumbira kuti, \"Pali Yehova, Davide sadzaphedwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.6",
            "verseOrgIds": [
              "1SA.19.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pambuyo pake Yonatani anayitana Davide namuwuza zonsezi. Choncho Yonatani anabwera naye Davide kwa Sauli ndipo ankamutumikira Sauliyo monga kale.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.7",
            "verseOrgIds": [
              "1SA.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panabukanso nkhondo ina ndipo Davide anapita ndi kukamenyana ndi Afilisti. Iye anawakantha mwamphamvu kotero kuti Afilisti anathawa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.8",
            "verseOrgIds": [
              "1SA.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lina mzimu woyipa uja unafikanso pa Sauli. Nthawi imeneyi nʼkuti Sauli uja ali mʼnyumba mwake, mkondo uli mʼdzanja lake ndi Davide akuyimba zeze,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.9",
            "verseOrgIds": [
              "1SA.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli anafuna kumubaya Davide ndi kumukhomera kukhoma, koma Davide anapewa mkondowo kotero Sauli anakabaya pa khoma. Usiku womwewo Davide anathawa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.10",
            "verseOrgIds": [
              "1SA.19.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usiku womwewo Sauli anatumiza anthu ku nyumba ya Davide kuti akamubisalire ndi kumupha mmamawa. Koma Mikala mkazi wake anamuchenjeza nati, \"Ngati usiku uno supulumutsa moyo wako, mawa udzaphedwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.11",
            "verseOrgIds": [
              "1SA.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Mikala anamutulutsira Davide pa zenera, ndipo anathawa ndi kupulumuka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.12",
            "verseOrgIds": [
              "1SA.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka Mikala anatenga fano naligoneka pa bedi nayika pilo wa ubweya wa mbuzi ku mutu kwa fanolo ndipo analifunditsa nsalu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.13",
            "verseOrgIds": [
              "1SA.19.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pamene amithenga a Sauli aja anafika kuti akamugwire Davide, Mikala anati, \"Davide akudwala.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.14",
            "verseOrgIds": [
              "1SA.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma Sauli anatumanso anthuwo kuti akamuone Davide, nati, \"Mubwere naye kuno ali pa bedi pomwepo kuti ndidzamuphe.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.15",
            "verseOrgIds": [
              "1SA.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma pamene anthuwo analowa, anangoona fano pa bedipo ndi pilo wa ubweya wa mbuzi ku mutu kwake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.16",
            "verseOrgIds": [
              "1SA.19.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono Sauli anafunsa Mikala kuti, \"Nʼchifukwa chiyani wandinamiza chotere polola kuti mdani wanga athawe?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 19:17"
      },
      "items": [
        {
          "text": "Mikala anayankha kuti, \"Davide anandiwuza kuti, 'Ukapanda kutero ndikupha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.17",
            "verseOrgIds": [
              "1SA.19.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Davide anathawa napulumuka. Pambuyo pake anapita kwa Samueli ku Rama nakamuwuza zonse zimene Sauli anamuchita. Kenaka iye ndi Samueli anapita kukakhala ku Nayoti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.18",
            "verseOrgIds": [
              "1SA.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli anamva kuti, \"Davide ali ku Nayoti ku Rama.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.19",
            "verseOrgIds": [
              "1SA.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho iye anatumiza anthu kuti akamugwire Davide. Koma anaona gulu la aneneri likulosera ndi Samueli akuwatsogolera. Pomwepo Mzimu wa Mulungu unawafikira ndipo nawonso anayamba kulosera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.20",
            "verseOrgIds": [
              "1SA.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sauli atamva zimenezi anatumizanso anthu ena, koma nawonso anayamba kulosa. Anatumanso anthu ena kachitatu, koma nawonso anayamba kulosa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.21",
            "verseOrgIds": [
              "1SA.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pomaliza Sauli mwini wake ananyamuka kupita ku Rama ndipo anafika ku chitsime chachikulu cha ku Seku. Ndipo anafunsa, \"Samueli ndi Davide ali kuti?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 19:22"
      },
      "items": [
        {
          "text": "Munthu wina anamuyankha kuti, \"Ali ku Nayoti ku Rama.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.22",
            "verseOrgIds": [
              "1SA.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Sauli anapita ku Nayoti ku Rama. Koma Mzimu wa Mulungu unafikanso pa iye ndipo ankalosa akuyenda mpaka anafika ku Nayoti.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.23",
            "verseOrgIds": [
              "1SA.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nayenso anavula zovala zake nayamba kulosa pamaso pa Samueli. Kenaka anagona wamaliseche tsiku lonse ndi usiku wonse. Nʼchifukwa chake anthu amati, \"Kodi Sauli alinso mmodzi wa aneneri?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.19.24",
            "verseOrgIds": [
              "1SA.19.24"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1SA.20",
    "number": "20",
    "bookId": "1SA"
  },
