  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "1SA 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo mawu a Samueli anafika kwa Aisraeli onse.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1",
        "vid": "1SA 4:1"
      },
      "items": [
        {
          "text": "Afilisti Alanda Bokosi la Chipangano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:1"
      },
      "items": [
        {
          "text": "Aisraeli anapita kukamenya nkhondo ndi Afilisti. Aisraeli anamanga misasa yawo ku Ebenezeri, ndipo Afilisti anamanga ku Afeki.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.1",
            "verseOrgIds": [
              "1SA.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afilisti anandanda kuyangʼana Aisraeli nayamba kumenyana. Nkhondo inakula ndipo Afilisti anagonjetsa Aisraeli napha anthu 4,000 pa malo a nkhondopo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.2",
            "verseOrgIds": [
              "1SA.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilikali atabwerera ku misasa, akuluakulu a Israeli anafunsa kuti, \"Nʼchifukwa chiyani Yehova walola kuti tigonjetsedwe lero pamaso pa Afilisti? Tiyeni tikatenge Bokosi la Chipangano cha Yehova ku Silo kuti Yehovayo abwere kukhala pakati pathu ndi kutipulumutsa mʼmanja mwa adani athu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.3",
            "verseOrgIds": [
              "1SA.4.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anatuma anthu ku Silo ndipo anakatenga Bokosi la Chipangano cha Yehova Wamphamvuzonse amene amakhala pa akerubi. Ndipo ana awiri a Eli, Hofini ndi Finehasi anatsagana nalo Bokosi la Chipangano cha Mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.4",
            "verseOrgIds": [
              "1SA.4.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bokosi la Chipangano cha Yehova litafika ku msasa, Aisraeli onse anafuwula kwambiri mpaka nthaka inagwedezeka.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.5",
            "verseOrgIds": [
              "1SA.4.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamva kufuwulaku, Afilisti anafunsa, \"Kodi kufuwula kwakukulu kumeneku ku misasa ya Ahebri ndi kwachiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:6"
      },
      "items": [
        {
          "text": "Atamva kuti Bokosi la Yehova lafika ku msasako,",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.6",
            "verseOrgIds": [
              "1SA.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afilisti anachita mantha pakuti iwo ankanena kuti, \"Milungu yafika ku msasa. Iwo anati, 'Tili pamavuto. Chinthu choterechi sichinachitikepo nʼkale lomwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.7",
            "verseOrgIds": [
              "1SA.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atsoka ife! Adzatipulumutsa ndani mʼmanja mwa milungu yamphamvuyi? Iyi ndi milungu imene inakantha Aigupto ndi miliri yosiyanasiyana mʼchipululu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.8",
            "verseOrgIds": [
              "1SA.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Limbani mtima Afilisti! Chitani chamuna, kuti mungakhale akapolo a Ahebri monga iwowa alili akapolo anu. Chitani chamuna ndipo menyani nkhondo!' \"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.9",
            "verseOrgIds": [
              "1SA.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho Afilisti anamenya nkhondo, ndipo anagonjetsa Aisraeli. Iwo anathawa aliyense kwawo. Ankhondo a Aisraeli oyenda pansi okwanira 30,000 anaphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.10",
            "verseOrgIds": [
              "1SA.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndipo Bokosi la Chipangano la Yehova linalandidwa, ndiponso ana awiri Eli, Hofini ndi Finehasi anaphedwa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.11",
            "verseOrgIds": [
              "1SA.4.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Imfa ya Eli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsiku lomwelo munthu wina wa fuko la Benjamini anathawa ku nkhondo ndipo anafika ku Silo. Iyeyu zovala zake zinali zongʼamba ndipo anadzithira dothi kumutu kuonetsa chisoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.12",
            "verseOrgIds": [
              "1SA.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atafika, anapeza Eli atakhala pa mpando wake mʼmbali mwa msewu, akungoyangʼana, pakuti ankadera nkhawa Bokosi la Mulungu. Munthuyo atalowa mu mzindamo ndi kufotokoza zimene zinachitika ku nkhondo, anthu onse a mu mzindamo anayamba kulira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.13",
            "verseOrgIds": [
              "1SA.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eli atamva kulirako anafunsa kuti, \"Kodi phokosoli likutanthauza chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:14"
      },
      "items": [
        {
          "text": "Tsono munthu wa fuko la Benjamini uja anapita msanga kwa Eli kukamufotokozera.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.14",
            "verseOrgIds": [
              "1SA.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawiyo nʼkuti Eli ali wa zaka 98 ndipo maso ake anali atachita khungu kotero kuti samatha kuona.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.15",
            "verseOrgIds": [
              "1SA.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Munthuyo anamuwuza Eli kuti, \"Ine ndabwera kuchokera ku nkhondo, ndathawako lero lomwe lino.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 4:16"
      },
      "items": [
        {
          "text": "Eli anafunsa, \"Nanga nkhondo yayenda bwanji mwana wanga?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.16",
            "verseOrgIds": [
              "1SA.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iye anayankha kuti, \"Aisraeli athawa pamaso pa Afilisti. Anthu ambirimbiri aphedwa. Ana anunso Hofini ndi Finehasi aphedwa. Bokosi la Mulungu nalonso lalandidwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.17",
            "verseOrgIds": [
              "1SA.4.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atangotchula Bokosi la Yehova, Eli anagwa chagada, kuchoka pa mpando wake umene unali mʼmbali mwa chitseko cha mpanda. Khosi lake linathyoka ndipo anafa, pakuti anali okalamba ndi onenepa kwambiri. Iye anatsogolera Israeli zaka makumi anayi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.18",
            "verseOrgIds": [
              "1SA.4.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nthawiyo, mpongozi wa Eli, mkazi wa Finehasi anali woyembekezera ndipo anali pafupi kuchira. Atamva kuti Bokosi la Mulungu lalandidwa ndi kuti mpongozi wake Eli ndi mwamuna wake amwalira, ululu wa pobereka mwana unamufikira modzidzimutsa ndipo anabereka mwana.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.19",
            "verseOrgIds": [
              "1SA.4.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Popeza mkaziyo anali pafupi kumwalira, akazi amene amamuthandiza anati, \"Usaope, wabereka mwana wamwamuna\" Koma iye sanayankhe kapena kulabadirako.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.20",
            "verseOrgIds": [
              "1SA.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tsono iye anatcha mwanayo dzina loti Ikabodi kutanthauza kuti, \"Ulemerero wachoka mu Israeli,\" chifukwa cha kulandidwa Bokosi la Mulungu ndi imfa ya mpongozi wake Eli ndi mwamuna wake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.21",
            "verseOrgIds": [
              "1SA.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ananena momwemo kuti, \"Ulemerero wachoka mu Israeli, pakuti Bokosi la Mulungu lalandidwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.4.22",
            "verseOrgIds": [
              "1SA.4.22"
            ]
          }
        }
      ]
    }
  ],
