  "verseCount": 12,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "1SA 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bokosi la Chipangano Pakati pa Afilisti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afilisti atalanda Bokosi la Mulungu lija, analitenga kuchoka ku Ebenezeri kupita ku Asidodi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.1",
            "verseOrgIds": [
              "1SA.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kenaka anatenga Bokosi la Chipanganolo nabwera nalo ku nyumba ya Dagoni ndi kuliyika pambali pa Dagoni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.2",
            "verseOrgIds": [
              "1SA.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1SA 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Asidodi atadzuka mmawa mwake, anangoona Dagoni atagwa pansi chafufumimba pamaso pa Bokosi la Yehova! Iwo anatenga Dagoni ndi kumuyimika pamalo pake.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.3",
            "verseOrgIds": [
              "1SA.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma mmawa mwakenso atadzuka, anaona Dagoni atagwa chafufumimba pamaso pa Bokosi la Yehova. Mutu wake ndi manja ake zinali zitaduka ndi kugwera pa khonde polowera, thunthu lake lokha ndilo linatsala.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.4",
            "verseOrgIds": [
              "1SA.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼchifukwa chake mpaka lero ansembe a Dagoni kapena wina aliyense amene amalowa mʼkachisi wa Dagoni ku Asidodi saponda pa khonde.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.5",
            "verseOrgIds": [
              "1SA.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova analanga koopsa anthu a ku Asidodi. Yehova anawawononga ndi kuwazunza ndi zithupsa Asidoniwa pamodzi ndi anthu a madera ozungulira.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.6",
            "verseOrgIds": [
              "1SA.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu a ku Asidodi ataona zimene zimachitika anati, \"Bokosi la Mulungu wa Israeli lisakhale kuno chifukwa akutizunza ife pamodzi ndi mulungu wathu Dagoni.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.7",
            "verseOrgIds": [
              "1SA.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anayitana atsogoleri onse a Afilisti kuti asonkhane ndipo anawafunsa kuti, \"Kodi Bokosi la Mulungu wa Israeli tichite nalo chiyani?\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 5:8"
      },
      "items": [
        {
          "text": "Iwo anayankha kuti, \"Bokosi la Mulungu wa Israeli lipite ku Gati.\" Kotero analichotsa Bokosi la Mulungu wa Israelilo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.8",
            "verseOrgIds": [
              "1SA.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Koma atafika nalo ku Gati, Yehova analanga mzindawo, ndipo anthu anachita mantha aakulu. Iye anazunza anthu a mu mzindawo, ana ndi akulu omwe, ndi zithupsa.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.9",
            "verseOrgIds": [
              "1SA.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Choncho anatumiza Bokosi la Mulungu ku Ekroni.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1SA 5:10"
      },
      "items": [
        {
          "text": "Koma Bokosi la Mulungu lija litangofika ku Ekroni, anthu a ku Ekroni analira kuti, \"Abwera nalo Bokosi la Mulungu wa Israeli kwa ife kuti atiphe pamodzi ndi anthu athu.\"",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.10",
            "verseOrgIds": [
              "1SA.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kotero iwo anayitana atsogoleri onse a Afilisti kuti asonkhane ndipo anati, \"Chotsani Bokosi la Mulungu wa Israeli, libwerere ku malo ake. Tikapanda kutero lidzatipha ife ndi anthu athu.\" Pakuti mu mzinda monse munali mantha aakulu kwambiri ndipo Mulungu ankawalanga kwambiri anthu a kumeneko.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.11",
            "verseOrgIds": [
              "1SA.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anthu amene sanafe anavutika ndi zithupsa, ndipo kulira kwa anthu a mu mzindamo kunamveka kumwamba.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.5.12",
            "verseOrgIds": [
              "1SA.5.12"
            ]
          }
        }
      ]
    }
  ],
