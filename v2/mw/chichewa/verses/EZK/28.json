  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "28",
        "style": "c",
        "sid": "EZK 28"
      },
      "items": [
        {
          "text": "28",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mawu Odzudzula Mfumu ya Turo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 28:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiyankhula nati:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.1",
            "verseOrgIds": [
              "EZK.28.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 28:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wa munthu, iwuze mfumu ya ku Turo mawu a Ine Ambuye Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "\" 'Iwe ndi mtima wako wodzikuza",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "umanena kuti, 'Ine ndine mulungu;",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "ndimakhala pa mpando wa mulungu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "pakati pa nyanja.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "Koma ndiwe munthu chabe osati mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:2"
      },
      "items": [
        {
          "text": "ngakhale ukuganiza kuti ndiwe wanzeru ngati mulungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.2",
            "verseOrgIds": [
              "EZK.28.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 28:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taona, ndiwedi wanzeru kupambana Danieli.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.3",
            "verseOrgIds": [
              "EZK.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:3"
      },
      "items": [
        {
          "text": "Ndipo palibe chinsinsi chobisika kwa iwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.3",
            "verseOrgIds": [
              "EZK.28.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 28:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa nzeru zako ndi kumvetsa kwako",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:4"
      },
      "items": [
        {
          "text": "unadzipezera chuma",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:4"
      },
      "items": [
        {
          "text": "ndipo unasonkhanitsa golide ndi siliva",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:4"
      },
      "items": [
        {
          "text": "mʼnyumba zosungira chuma chako.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.4",
            "verseOrgIds": [
              "EZK.28.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 28:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndi nzeru zako zochitira malonda",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:5"
      },
      "items": [
        {
          "text": "unachulukitsa chuma chako",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:5"
      },
      "items": [
        {
          "text": "ndipo wayamba kunyada",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:5"
      },
      "items": [
        {
          "text": "chifukwa cha chuma chakocho.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.5",
            "verseOrgIds": [
              "EZK.28.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 28:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Choncho Ine Ambuye Yehova ndikuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:6"
      },
      "items": [
        {
          "text": "\" 'Popeza umadziganizira",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:6"
      },
      "items": [
        {
          "text": "kuti ndiwe mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.6",
            "verseOrgIds": [
              "EZK.28.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 28:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ine ndidzabwera ndi anthu achilendo, anthu ankhanza,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:7"
      },
      "items": [
        {
          "text": "kuti adzalimbane nawe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:7"
      },
      "items": [
        {
          "text": "Adzakuthira nkhondo kuti awononge zonse zimene unazipeza ndi nzeru zako,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:7"
      },
      "items": [
        {
          "text": "ndipo adzawononga kunyada kwakoko.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.7",
            "verseOrgIds": [
              "EZK.28.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 28:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwo adzakuponyera ku dzenje",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:8"
      },
      "items": [
        {
          "text": "ndipo udzafa imfa yoopsa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:8"
      },
      "items": [
        {
          "text": "mʼnyanja yozama.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.8",
            "verseOrgIds": [
              "EZK.28.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 28:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kodi udzanenabe kuti, 'Ine ndine mulungu,'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:9"
      },
      "items": [
        {
          "text": "pamaso pa iwo amene akukupha?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:9"
      },
      "items": [
        {
          "text": "Iwe udzaoneka kuti ndiwe munthu chabe, osati mulungu,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:9"
      },
      "items": [
        {
          "text": "mʼmanja mwa iwo amene akukuphawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.9",
            "verseOrgIds": [
              "EZK.28.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 28:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udzafa imfa ya anthu osachita mdulidwe",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:10"
      },
      "items": [
        {
          "text": "mʼmanja mwa anthu achilendo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZK 28:10"
      },
      "items": [
        {
          "text": "Ine ndayankhula zimenezi, akutero Ambuye Yehova.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.10",
            "verseOrgIds": [
              "EZK.28.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 28:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehova anandiyankhula kuti:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.11",
            "verseOrgIds": [
              "EZK.28.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 28:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Iwe mwana wa munthu, imba nyimbo yodandaulira mfumu ya Turo ndipo uyiwuze mawu a Ine Ambuye Yehova akuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZK 28:12"
      },
      "items": [
        {
          "text": "\" 'Iwe unali chitsanzo cha ungwiro weniweni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:12"
      },
      "items": [
        {
          "text": "wodzaza ndi nzeru ndi wokongola kwambiri.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.12",
            "verseOrgIds": [
              "EZK.28.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 28:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe unkakhala ngati mu Edeni,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.13",
            "verseOrgIds": [
              "EZK.28.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZK 28:13"
      },
      "items": [
        {
          "text": "munda wa Mulungu.",
