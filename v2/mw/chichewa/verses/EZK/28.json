        "style": "q1",
        "vid": "EZK 28:23"
      },
      "items": [
        {
          "text": "Pamenepo iwo adzadziwa kuti Ine ndine Yehova.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
