                "loc": "ISA.62.11"
              },
              "items": [
                {
                  "text": "62:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.28.4"
              },
              "items": [
                {
                  "text": "Mas 28:4",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
