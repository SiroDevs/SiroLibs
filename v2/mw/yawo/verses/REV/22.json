              "items": [
                {
                  "text": "Yel 17:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uneji ndili Alefa ni Omega, gopolela kuti jwandanda ni jwakumalisya, ndande ni mbesi.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.13",
            "verseOrgIds": [
