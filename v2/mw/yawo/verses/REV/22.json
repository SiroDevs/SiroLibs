            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu akuti, “Mpikane, ngwisa pangakaŵa! Ngwisa ni mbote syangu kuti nimpe jwalijose malinga ni masengo gapanganyisye.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.12",
            "verseOrgIds": [
              "REV.22.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
