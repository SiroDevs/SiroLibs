        },
        {
          "text": "Nambo ŵakutenda ya usakwa, usaŵi, ya lilama, kuwulaga acimjawo, kulambila tumilungu twakupanganyidwa, ni ŵakunonyela ya mabosa m'maloŵe ni mu yitendo, taciŵa kusa kwa msindawo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.15",
            "verseOrgIds": [
              "REV.22.15"
            ]
          }
        }
