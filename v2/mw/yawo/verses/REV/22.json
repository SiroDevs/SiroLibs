          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jujimkwete njota, ayice; jwalijose jwakugasosa mesi agapocele mwalulele mesi gakupeleka umi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
            "verseOrgIds": [
