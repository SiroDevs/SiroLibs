              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jwakugapikana maloŵega aŵecete kuti, “Myice!”",
          "type": "text",
          "attrs": {
            "verseId": "REV.22.17",
            "verseOrgIds": [
