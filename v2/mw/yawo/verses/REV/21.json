    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwinani kwasambano ni cilambo capasi casambano",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko nakuweni kwinani ni cilambo capasi casambano. Pakuti kwinani kwandanda kula ni cilambo capasi candanda cila yaliji yili yityosile, soni nyasa jila paliji pali pangali.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.1",
            "verseOrgIds": [
              "REV.21.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
