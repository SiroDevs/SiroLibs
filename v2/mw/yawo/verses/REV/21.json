            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.14",
            "verseOrgIds": [
              "REV.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lilyaŵecete ni une lyakwete simbo jakupimila ja golidi,",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "text": " jakuti akamulisye masengo pakuwupima msindawo, yipata ni mapupa gakwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.21.15",
            "verseOrgIds": [
              "REV.21.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
