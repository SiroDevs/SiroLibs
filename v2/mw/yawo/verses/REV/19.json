              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa mkanjo wakwe nambo soni pa ciga cakwe palembedwe lina lyakuti: “Mcimwene jwa ayimwene wosope ni Ambuje ŵa acambuje wosope.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.16",
            "verseOrgIds": [
              "REV.19.16"
            ]
          }
        }
