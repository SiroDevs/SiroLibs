          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko naliweni lilayika lili lijimi pa lyuŵa. Lyagumisile mwakwesya maloŵe, ni kuyisalila yijuni yosope yakuguluka mwinani kuti, “Myice msongane pampepe ku cindimba cekulungwa ca Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
