                "loc": "EZK.39.17+EZK.39.18+EZK.39.19+EZK.39.20"
              },
              "items": [
                {
                  "text": "Esek 39:17-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.17",
            "verseOrgIds": [
              "REV.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myice kukulya mnowu wa ayimwene, wa acakulungwa ŵa ngondo, asilikali, mnowu wa mahaci ni ŵakukwelapo ŵakwe, mnowu wa ŵandu wosope, alukosyo ni acikapolo, ŵandu ŵacanandi ni acakulungwa.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.19.18",
            "verseOrgIds": [
              "REV.19.18"
            ]
          }
        }
      ]
    },
