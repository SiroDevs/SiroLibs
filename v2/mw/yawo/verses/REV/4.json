            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.8",
            "verseOrgIds": [
              "REV.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi josope jeneji, ya umiyo yaliji mkwimba nyimbo syakupeleka lumbili, ucimbicimbi ni matogolelo kwa jwele juŵatemi pa citengu ca ucimwene cila, jwele jwakwete umi mpaka ndaŵi syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.9",
            "verseOrgIds": [
              "REV.4.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piyaliji mkutendekwa yeleyi, acakulungwakulungwa ŵakwana makumi gaŵili ni mcece ŵala ŵaliji mkuligwisya pameso pa juŵatemi pa citengu ca ucimwene jula, ni kumlambila jwele jwakwete umi ndaŵi syosopejo. Jemanjajo ŵaponyaga yisindi yawo pasi pameso pa citenguco nipo ŵaŵecetaga kuti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.4.10",
            "verseOrgIds": [
              "REV.4.10"
            ]
          }
        }
      ]
