              "REV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lya msano ni gaŵili lyapungulile ya mu mbale mwakwe mwinani. Pandaŵi jijojo, papikanice maloŵe gekulungwa gakutyocela ku mpando wa ucimwene ku Malo Gamaswela. Maloŵego gatite kuti, “Gamasile.” ",
          "type": "text",
          "attrs": {
            "verseId": "REV.16.17",
            "verseOrgIds": [
              "REV.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jijojo kwapali kumesya kwa njasi, masegwe ni kulindima kwatesile soni cisicinya cakogoya, mwakuti cipanganyikwile mundu pa cilambo capasici capasi nganicitendekweje cisicinya camti myoyo, pakuti celeco caliji cakogoya mnope.",
          "type": "text",
