                {
                  "text": "Eks 15:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.4",
            "verseOrgIds": [
              "REV.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piyamasile yeleyi, nagaweni Malo Geswela mnope ga mkati mwa Citenti ca Umboni gali gawugwice.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.38.21"
              },
              "items": [
                {
                  "text": "Eks 38:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.5",
            "verseOrgIds": [
              "REV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo mu m'Malo Geswelago mwakopwecemo malayika msano ni gaŵili gala gigakwete milili msano ni jiŵili jila, ali awete nguwo syeswela syakunyesima mnope kuti mbee, soni ali ataŵile malamba ga golidi",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "text": " pa cidali pawo. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.6",
            "verseOrgIds": [
              "REV.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cimo mwa ya umi mcece yila capelece mbale ja msimbo msano ni siŵili sya golidi kwa malayika msano ni gaŵili gala. Mu mbalemo mwaliji mwegumbale ni ukali wa Mlungu jwa cijumi mpaka ndaŵi syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.7",
            "verseOrgIds": [
              "REV.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'malo Gamaswela mnope gala mwagumbele lyosi lyakutyocela ku lumbili lwa Mlungu ni macili gakwe, myoyo paliji pangali atamose jumo jose juŵapakombwele kwinjila ku Malo Gamaswelago mpaka jili jimasile milili msano ni jiŵili jila jijaliji ni malayika msano ni gaŵili gala.",
          "type": "text",
          "attrs": {
            "verseId": "REV.15.8",
            "verseOrgIds": [
              "REV.15.8"
            ]
          }
        },
