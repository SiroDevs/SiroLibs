              "REV.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa jwakulongolela mpingo wa mu msinda wa Tiyatila mlembe kuti:",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Awu uli utenga wakutyocela kwa Mwanace jwa Mlungu, jwele meso gakwe gakusaŵala mpela lilamba lya moto, soni sajo syakwe sili mpela cisyano cakunyesima. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.18",
            "verseOrgIds": [
              "REV.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumanyilila masengo genu gosope. Ngumanyilila cinonyelo ni kulupicika kwenu, ni kupimilila kwenu kwakulimbangana. Ngumanyilila kuti masengo genu ga sampano gejinji, gali gambone kupunda gakala gala. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.19",
            "verseOrgIds": [
              "REV.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "REV 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pakumsisicisya papali: pelepo pali pakuti mkusamlecelela jwamkongwe jula Yesebele, jwakusalikolanga kuti ali jwakulocesya. Jwalakwe jula akwalambusya ni kwajiganya ŵakutumicila ŵangu kuti atendeje cikululu ni kulya yindu yepelecedwe mbopesi ku tumilungu twawo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.20",
            "verseOrgIds": [
              "REV.2.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.16.31"
              },
              "items": [
                {
                  "text": "1 Ayi 16:31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.9.22"
              },
              "items": [
                {
                  "text": "2 Ayi 9:22",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
