          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jwele jwakwete mapikanilo, apikanicisye yele Msimu akujisalila mipingoji.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
