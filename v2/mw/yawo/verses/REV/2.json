    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kwa ŵele ŵitacipunda tinjapa upile wakulya yisogosi ya mcitela cakupeleka umi cacili mu mgunda wakusalala wa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.7",
