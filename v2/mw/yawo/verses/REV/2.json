              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo soni jemanja mkwete ŵandu ŵane pasikati penu ŵakukuya majiganyo ga Anikolayi. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.15",
            "verseOrgIds": [
              "REV.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mpitikuce mitima jenu ku ulemwa, naga ngamkutenda myoyo, une tinjiyika kumangwenuko pangakaŵapa, nipo tinjiputa ngondo ni jemanja ni upanga wakopocela mkamwa mwangu ula.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.16",
            "verseOrgIds": [
              "REV.2.16"
            ]
          }
        }
