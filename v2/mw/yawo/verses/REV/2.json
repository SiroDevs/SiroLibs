    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Awu uli utenga wakutyocela kwa jwele jwakwete upanga wakutema kosekose ula. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.12",
            "verseOrgIds": [
              "REV.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngukumanyilila kumkusatama, kweleko ni kukuli citengu ca ucimwene wa Satana. Jemanja mli ŵakulupicika kwa une, nganimjasa cikulupi cenu, atamose pa ndaŵi ja Antipa",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "2:13",
              "type": "text"
            },
            {
              "text": "Antipa:",
              "type": "text"
            },
            {
              "text": "Ngitukumanyilila yejinji ya jwalakweju, nambo yikulosya kuti jwalakweju jwaliji mklistu juŵawulajidwe ligongo lyakuti ŵakanile kumlambila Mwenye jwa ku Loma.",
              "type": "text"
            }
          ]
        },
        {
          "text": " mboni jangu jakulupicika, ŵawulajidwe kweleko kwakusatama Satana. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.13",
            "verseOrgIds": [
              "REV.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pana yindu panandi yakuti nimsisye nayo: Kumangwenuko kwana ŵandu ŵane ŵakukuya majiganyo ga Balamu jwakulocesya jwa unami jula. Jwalakwe jula ŵajiganyisye mwenye Balaki kwakopa Aisalaeli kuti alyeje ya mbopesi jakupelecedwa ku tumilungu twawo ni kutenda cikululu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.2.14",
            "verseOrgIds": [
              "REV.2.14"
            ]
          }
        },
        {
          "name": "note",
