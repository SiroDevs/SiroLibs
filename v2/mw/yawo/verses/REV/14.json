          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko lilayika line lyakopwece m'Nyumba ja AMBUJE kwinani. Nombe najo jwakwete cikwakwa cakutema mnope.",
          "type": "text",
          "attrs": {
            "verseId": "REV.14.17",
            "verseOrgIds": [
              "REV.14.17"
            ]
          }
        }
