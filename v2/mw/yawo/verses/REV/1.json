          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuje Mlungu Ŵamaciligosope akuŵeceta kuti, “Une ndili Alefa ni Omega,” jumbali, junapali kala, nambo soni jwele jungwisa pangakaŵa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.22.13"
              },
              "items": [
                {
                  "text": "Ciw 22:13",
                  "type": "text"
                }
              ]
            },
            {
