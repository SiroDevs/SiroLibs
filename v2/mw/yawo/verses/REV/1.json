              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une ndili jwa umi! Nawile, nambo sambano ndili cijumi mpaka kalakala. Ngwete ulamusi pa ciwa ni cilambo ca ŵandu ŵawe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.18",
            "verseOrgIds": [
