            "number": "7",
            "style": "v",
            "sid": "REV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlole! Akwisa m'mawunde! Jwalijose tacimwona jwalakwejo, kupwatikapo juŵamsomile jwalakwejo. Ŵandu ŵosope pa cilambo capasi tacimlilila jwalakwejo. Yisyene, tiyiciŵa mpela muyiŵelelemu. Ami.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        },
