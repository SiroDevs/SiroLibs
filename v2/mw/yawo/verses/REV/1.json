          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinam'weni jwalakwejo, nagwile pasi pa sajo syakwe mpela mundu jwam'we. Ŵasajice ligasa lyakwe lyamlyo pa une ni ŵatite kuti, “Mkatenda woga! Une ndili jwandanda ni jwakumalisya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
