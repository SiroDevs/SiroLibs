          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo akusatunonyela, soni kupitila mu ciwa cakwe ŵatugopwele ku ulemwa wetu, ",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo lya yeleyi atutesile uwe kuŵa ŵa mwiŵasa lya ŵakutaga mbopesi ŵakumtumicila Mlungu Atati ŵakwe. Myoyo Yesu Klistujo apocele lumbili ni macili gakulamulila mpaka ndaŵi syosope. Ami.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
