            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pampepe ni mapopelo ga ŵandu ŵa Mlunguwo, lyosi lya ubaniwo lyakwesile kwawula kwinani kutyocelaga m'magasa ga lilayika lila. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko lilayika lila lyajigele cakututumicisya ubani cila ni kugumbasyamo moto wakutyocela pa malo gakupelecela mbopesi gala. Ŵaciponyisye pa cilambo capasi, nipo ndaŵi jijojo kwalindime, kwaliji kwana masegwe, njasi ni cisicinya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        },
        {
          "name": "note",
