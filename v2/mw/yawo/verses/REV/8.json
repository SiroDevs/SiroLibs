          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lyatatu lyagombile lipenga lyakwe. Piŵatesile myoyo cindondwa cekulungwa cicakolelaga mpela lumuli cagwile pasi kutyocela kwinani. Celeco cagwilile pa mbali jimo ja mbali sitatu mu sulo, ni pa nduluko sya mesi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
