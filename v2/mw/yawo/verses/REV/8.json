          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lina lya ndondwajo lili “Kuŵaŵa”. Mbali jimo ja mbali sitatu sya mesi jasandwice kuŵa cakuŵaŵa, mwakuti ŵandu ŵajinji ŵawile nago mesigo ligongo lya kuŵaŵa kwakweko.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        },
