          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lyandanda lyagombile lipenga lyakwe. Matalila ni moto, yewanganyicilane ni miasi, yagwile pacilambo capasi pano kutyocela kwinani. Mbali jimo ja ma mbali sitatu sya cilambo ni yitela yapile, nombe nago manyasi gamaŵisi gapile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        },
