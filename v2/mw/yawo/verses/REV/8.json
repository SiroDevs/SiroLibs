          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano acimalayika msano ni ŵaŵili ŵala ŵiŵakwete malipenga msano ni gaŵili ŵala ŵaliŵicile cile kuti agombe malipengago.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        }
