            "sid": "REV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace Jwangondolo pijwamatukwile cimanyisyo ca msano ni yiŵili, kwinani kwatesile jii kwa mbindi makumi gatatu. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko nagaweni malayika msano ni gaŵili gala gigajimi pameso pa Mlungu gala, gali mkupegwa malipenga msano ni gaŵili.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
    },
    {
