          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lya mcece lyagombile lipenga lyakwe lila. Piŵatesile myoyo yasimanikwe kuti jimojimo mwa mbali sitatusitatu sya lyuŵa, mwesi ni ndondwa yamenyene. Piyatendekwe yeleyi, mbali jimo mwa mbali sitatu sya yosopeyo syaŵilile. Kwaliji kwangali soni lilanguka pa jimo mwa mbali sitatu sya musi, yalumo soni cilo.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        },
