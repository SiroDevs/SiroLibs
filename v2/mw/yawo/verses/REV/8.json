          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lyaŵili lyagombile lipenga lyakwe. Cine cakwe cakuwoneka mpela litumbi lyakolela moto cawonece nipo caponyedwe m'nyasa. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo mbali jimo ja mbali sitatu sya nyasa syasyucile kuŵa miasi, soni mbali jimo ja mbali sitatu sya yakupanganyidwa yosope ya umi ya m'nyasamo yawile, myoyo soni mwa mbali sitatu sya yombo syajonasice.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
    {
