          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika line lilyakwete cakututumicisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "text": " lyayice, nipo ŵalipele ubani wejinji kuti awupelece pamo ni mapopelo ga ŵandu ŵa Mlungu pa malo gakupelecela mbopesi ga golidi",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "text": " gigaliji pasogolo pa citengu ca ucimwene ula.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
