                "loc": "ISA.13.21"
              },
              "items": [
                {
                  "text": "Yes 13:21",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.21.9"
              },
              "items": [
                {
                  "text": "21:9",
