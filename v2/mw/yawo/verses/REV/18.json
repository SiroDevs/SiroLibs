            "number": "17",
            "style": "v",
            "sid": "REV 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wosope ŵakwendesya yombo, wosope ŵakwenda myombo, ŵakukamula masengo mu yombomo, ni wosope ŵakusajesya malonda mu yombomo ni kulamilaga pa gele masengogo ŵajimi kwakutalicila mnope.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.17",
            "verseOrgIds": [
              "REV.18.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
