            "number": "1",
            "style": "v",
            "sid": "REV 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piyatendekwe yeleyi, naliweni lilayika lili mkutuluka kutyocela kwinani. Jwakwete ulamusi wekulungwa, nipo pacilambo cosope capasi kwaswejele ligongo lya kuŵala kwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.1",
            "verseOrgIds": [
              "REV.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵagumisile mwakwesya maloŵe ni kuŵeceta kuti: “Agwile! Agwile Babiloni",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "text": " jwakupikanika jula! Aŵele malo gakutamamo misimu jakusakala, malo gakutililamo misimu josope jakunyalaya, malo gakutililamo yijuni yosope yakunyalaya ni yinyama yakuŵenjedwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
