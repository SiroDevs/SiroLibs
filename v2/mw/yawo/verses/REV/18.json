              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.14.8"
              },
              "items": [
                {
                  "text": "Ciw 14:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.2",
            "verseOrgIds": [
              "REV.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ŵamwesisye finyo ŵandu ŵa mitundu josope jwele jukusatandisya kutenda ya cikululu. Ayimwene ŵa pa cilambo capasi ŵatesile nawo cikululu, nipo ŵandu ŵakusuma ni kusumisya malonda ŵa pa cilambo cosope capasi ŵasicililagapo pa yakusakala yakwe yakuliwunjicila yipanje.”",
          "type": "text",
          "attrs": {
            "verseId": "REV.18.3",
            "verseOrgIds": [
              "REV.18.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
