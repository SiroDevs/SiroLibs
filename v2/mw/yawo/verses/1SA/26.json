              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.24",
            "verseOrgIds": [
              "1SA.26.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Saulo ŵamsalile Daudi kuti, “Mlungu ampe upile m'mwejo mwanangu Daudi! M'mwejo timcitenda yindu yayikulungwa, nipo timcipunda mu yosope yeneyo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 26:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Daudi ŵatyosile ni kwawulaga nombe najo Saulo ŵawujile kumangwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.26.25",
            "verseOrgIds": [
              "1SA.26.25"
            ]
          }
        }
      ]
