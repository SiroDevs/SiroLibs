          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo kwa ŵandu ŵa ku misinda ja Holoma, ŵa ku Bolashani, ŵa ku Ataki ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.30",
            "verseOrgIds": [
              "1SA.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
