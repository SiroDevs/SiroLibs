          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵa ku Hebuloni ni ku malo gosope gene giŵajendelaga Daudi ni ŵandu ŵakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.30.31",
