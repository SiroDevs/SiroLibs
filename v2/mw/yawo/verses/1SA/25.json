          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ciwa ca Samuele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Samuele ŵawile, nipo Aisalaeli wosope ŵene ŵasongene pamo kukulila malilo gakwe. Kaneko ŵamsicile kumangwakwe ku Lama.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.1",
            "verseOrgIds": [
              "1SA.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Daudi ni Abigelo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1SA 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeleyi yili yitendekwe Daudi",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.1",
            "verseOrgIds": [
              "1SA.25.1"
            ]
          }
        },
        {
          "text": " ŵatyosile kwawula ku cipululu ca Palani. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.1",
            "verseOrgIds": [
              "1SA.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwapali mundu jwine jwa liŵele lya Kalebu lina lyakwe Nabala jwa ku msinda wa Maoni. Jweleju jwaliji jwakusicila mnope kwakuti ŵakwete kacilambo kakwe ciŵandika ni msinda wa Kalimeli. Ŵakwete ngondolo 3,000 ni mbusi 1,000. Ŵamkwawo Abigelo ŵaliji ŵakusalala nipo soni ŵalunda, nambo jwamlumejo ŵaliji jwakusuka, ni jwakupya mtima msanga.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.2+1SA.25.3",
            "verseOrgIds": [
              "1SA.25.2",
              "1SA.25.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1SA 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabala ŵaliji mkusenga ngondolo syakwe ku Kalimeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.2+1SA.25.3",
            "verseOrgIds": [
              "1SA.25.2",
              "1SA.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1SA 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi piŵaliji kucipululu kula ŵapikene kuti Nabala akusenga ngondolo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.4",
            "verseOrgIds": [
              "1SA.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1SA 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵatumisye acacanda likumi kuti ajawule kwa Nabala ku Kalimeli, kukwapelecela moni. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.5",
            "verseOrgIds": [
              "1SA.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1SA 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalamwile jemanjajo kuti akasalile Nabala kuti: “Mtendele uŵe ni ŵalakwe ni liŵasa lyawo lyosope ni yindu yosope yene yimkwete. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.6",
            "verseOrgIds": [
              "1SA.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1SA 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵapikene kuti mkusenga manyunya ngondolo syenu, nipo akum'manyisya kuti, akucinga ŵenu ŵaliji ni uwe nipo nganitwatenda cilicose cakusakala. Pangali cindu cawo cilicose cicajiŵidwe pa ndaŵi josope jiŵaliji ku Kalimeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.7",
            "verseOrgIds": [
              "1SA.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gambani kwawusya acimsyenewo, tamsalile. Uwe tuyice pa ndaŵi ajino ja cisangalalo, nipo Daudi akwaŵenda wawojo kuti atupocele cenene. Conde atugaŵile uwe ŵamasengo ŵawo pamo ni mjawo jwakunonyelwa Daudi cilicose cakwete.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.8",
            "verseOrgIds": [
              "1SA.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1SA 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.8",
            "verseOrgIds": [
              "1SA.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1SA 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acacanda ŵa Daudi ŵapelece wele mtengawu kwa Nabala mu lina lya Daudi. Kaneko ŵajembecele papopo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.9",
            "verseOrgIds": [
              "1SA.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1SA 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nabala ŵajanjile acacanda ŵa Daudi pakwawusya kuti, “Ana Daudi mwanace jwa Yese ni nduni? Une nganimbikaneje ya jwalakwe. Masiku agano mcilambomutu mugumbele ni ŵamasengo wakwamba kutila kwa acambuje ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.10",
            "verseOrgIds": [
              "1SA.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une ngaŵa mkujigala mkate wangu ni mesi, ni nyama jangu jinawulajile ŵakusenga manyunya ngondolo ŵangu, ni kwapa ŵandu ŵingakukumanyilila kumalo kwakutyocela.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.11",
            "verseOrgIds": [
              "1SA.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1SA 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.11",
            "verseOrgIds": [
              "1SA.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1SA 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acacanda ŵa Daudi ŵala ŵawujile kuja kukumsalila yiŵaŵecete Nabala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.12",
            "verseOrgIds": [
              "1SA.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Daudi ŵalamwile ŵa ngondo ŵakwe kuti, “Jwalijose ataŵilile upanga wakwe.” Myoyo jwalijose ŵataŵilile upanga wakwe. Nombe najo Daudi ŵataŵilile upanga wakwe nipo ŵanyakwice pamo ni ŵa ngondo ŵakwe 400, kusigala 200 kuti asunjeje katundu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.13",
            "verseOrgIds": [
              "1SA.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1SA 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.13",
            "verseOrgIds": [
              "1SA.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1SA 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumo jwa ŵamasengo ŵa Nabala ŵamsalile msonogwe Nabala jwakolanjidwa Abigelo kuti, “Ana apikene? Daudi ŵatumisye ŵamitenga ŵane kutyocela ku cipululu kuti akapelece moni kwa ambuje ŵetu, nambo ambujewo ŵakalipile ŵanduwo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.14",
            "verseOrgIds": [
              "1SA.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1SA 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambotu atamose akwakalipila myoyo, ŵanduwotu ŵaliji ŵambone kwa uwe. Nganatusawusya amta panandi, nipo mu ndaŵi josope jitwaliji nawo pakulanga yilangwa yetu, pangali cindu cetu cimo cicajiŵidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.15",
            "verseOrgIds": [
              "1SA.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1SA 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵatucinjilicisye mpela lipupa ndaŵi syosope pitwalangaga yilangwa yetu cilo ni musi wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.16",
            "verseOrgIds": [
              "1SA.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Conde ngwaŵenda kuti aganicisye mwalunda ni kumanyilila cakutenda. Yeleyi mpaka yijonanjisye ambuje ŵetuŵa ni liŵasa lyawo lyakwe. Cindu cine soni ni cakuti, ambuje ŵala ŵakusawusya, ŵangasosa kupikana cakwasalila mundu jwine.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.17",
            "verseOrgIds": [
              "1SA.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1SA 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.17",
            "verseOrgIds": [
              "1SA.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1SA 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jijojo Abigelo ŵajigele mitanda ja mikate 200 mwakwanguya, misaku jiŵili ja mapende jagumbala ni finyo, ngondolo syakoca msano, makilogalamu 17 ga tiligu jwakalanga, mikonga ja 100 ja yisogosi ya finyo jwejumusye, ni makeke ga nguju 200, yosopeyo ŵayikwesisye pa bulu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.18",
            "verseOrgIds": [
              "1SA.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵasalile ŵamasengo ŵakwe kuti, “Longolelani nipo une tinimkuyeje panyuma.” Nambo nganaŵeceta cilicose kwa ŵamkwawo.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.19",
            "verseOrgIds": [
              "1SA.25.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1SA 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.19",
            "verseOrgIds": [
              "1SA.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1SA 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigelo ŵakwesile bulu jwakwe mpaka ŵayice mwiŵanda mwa litumbi line piwapindile msewu, mwakusisimucisya ŵasimangene ni Daudi, ŵa ngondo ŵakwe ŵala ali mkwisa kwa jwalakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.20",
            "verseOrgIds": [
              "1SA.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1SA 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵaganisyaga kuti, “Ana nalisawucisyagaci kucinjilicisya katundu jwa jwele munduju mcipululu? Pangali cindu cawo cimo cicajiŵidwe, nipo m'malo mwakwe jwalakwe akumbucisya une yeleyi pacikamucisyo cinampele. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.21",
            "verseOrgIds": [
              "1SA.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ambulaje une naga nginguwulaga jwamlume jwalijose jwa jemanjajo pakwanaga kundaŵi.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.22",
            "verseOrgIds": [
              "1SA.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1SA 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.22",
            "verseOrgIds": [
              "1SA.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1SA 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigelo piŵam'weni Daudi, ŵatulwice pa bulu jwakwe jula mwacitema ni kuligwisya pasi calutumbo pasogolo pakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.23",
            "verseOrgIds": [
              "1SA.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1SA 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali cinamile pa sajo sya Daudi yilayila, jwalakwe ŵatite kuti, “Conde bwana, ambikanile une. Magambo gaŵe pa unepe basi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.24",
            "verseOrgIds": [
              "1SA.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1SA 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Conde akatendela masengo ya Nabala msonogwangu, mundu jwa umi wakusawusya jula. Jwejula agambile kuŵa mpela mwaliŵelele lina lyakwelyo cisilu. Bwana une paliji pangali pa ndaŵi jiŵayice ŵamasengo ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.25",
            "verseOrgIds": [
              "1SA.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1SA 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.26",
            "verseOrgIds": [
              "1SA.25.26"
            ]
          }
        },
        {
          "text": " ni ŵiŵasunjile wawojo kwacinjilicisya kuti akawucisya nipo akawulaga amagongo ŵawo ni magasa gawo. Pali AMBUJE ŵa umi, une ngulumbila kuti, amagongo ŵawo ni wosope ŵakusosa kwatenda wawojo yakusakala tacapa cilango mpela Nabala. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.26",
            "verseOrgIds": [
              "1SA.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1SA 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana, conde, apocele mtuka unajigalilewu, nipo ŵape ŵandu ŵali nawoŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.27",
            "verseOrgIds": [
              "1SA.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1SA 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwana, conde angululucile, pa cakusakala cimbanganyisye. AMBUJE tacajinjisya wawojo ucimwene, ni yisukulu yawo yakwe, ligongo wawo akuputa ngondo syakwe. Myoyo cakusakala cilicose ngaŵa mkusimanika mwa wawojo masiku gosope ga umi wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.28",
            "verseOrgIds": [
              "1SA.25.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1SA 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga jwalijose akwatanda wawojo ni kusosa kwawulaga, AMBUJE Mlungu jwawo tacakulupusya, mpela mundu jwakusunga cipanje ca mtengo wejinji. Kwamba ya amagongo ŵawo, AMBUJE tacaponya jemanjajo kwakutalika mpela mwakuponyela mundu maganga pa cinawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.29",
            "verseOrgIds": [
              "1SA.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1SA 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵawo ambuje ŵangu, AMBUJE pitacatendela yindu yosope yambone yiŵalangene ni wawojo, tacajinjisya kuŵa mwenye jwa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.30",
            "verseOrgIds": [
              "1SA.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jele ndaŵijo wawo bwana ngasakola canasa kapena kulaga mu mtima kuti ŵawuleje kapena kuwucisya pangali ligongo lisyesyene. AMBUJE ali ŵapele upile, wawo bwana, conde akasandiŵalila une.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.31",
            "verseOrgIds": [
              "1SA.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1SA 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.31",
            "verseOrgIds": [
              "1SA.25.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1SA 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo Daudi ŵamsalile Abigelo kuti, “Wawo mama, upile uŵe kwa AMBUJE, Mlungu jwa Aisalaeli, ŵiŵatumisye wawojo kuti awonegane ni une lelo jino. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.32",
            "verseOrgIds": [
              "1SA.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1SA 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵape upile wawojo ligongo lya lunda lwawo nipo pa yatesile lelo pakundekasya kuti ngatenda ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.33",
            "verseOrgIds": [
              "1SA.25.33"
            ]
          }
        },
        {
          "text": " wakuwulaga ni kwawucisya amagongo ŵangu ni magasa gangu. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.33",
            "verseOrgIds": [
              "1SA.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1SA 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Mlungu jwa Aisalaeli ni ŵandekasisye une kuti ngapweteka jemanja. Nambo ngulumbila mu lina lya AMBUJE ŵa Aisalaeli kuti akaŵe kuti wawo nganajanguya kwisa kukuwonegana ni une, ŵandu ŵacalume ŵosope ŵa Nabala akaliji ali awile pikukayikaga kundaŵi.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.34",
            "verseOrgIds": [
              "1SA.25.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Daudi ŵapocele yiŵamjigalileyo ni ŵamsalile Abigelo kuti, “Jawulagani kumangwenu mu mtendele. Mkadandawula maloŵe genu mbikene, soni yimŵendileyo njiticisye.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.35",
            "verseOrgIds": [
              "1SA.25.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1SA 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.35",
            "verseOrgIds": [
              "1SA.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1SA 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigelo ŵawujile kwa Nabala, juŵaliji kumangwakwe ni kutendaga cindimba mpela ca mwenye. Ŵaliji ali akolelwe nipo ŵasangalele. Myoyo ŵamkwawowo nganiŵasalila cilicose mpaka kundaŵi. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.36",
            "verseOrgIds": [
              "1SA.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1SA 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ukana uli watyosile, jwamkongwejo ŵasalile yosope yene. Ali apikene yeleyo papopo Nabala mtima wakwe wajimi, nipo cilu cakwe cajumwile mpela liganga. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.37",
            "verseOrgIds": [
              "1SA.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pali papite masiku likumi, AMBUJE ŵamtyosisye umi nipo Nabala ŵawile.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.38",
            "verseOrgIds": [
              "1SA.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1SA 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.38",
            "verseOrgIds": [
              "1SA.25.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi piŵapikene kuti Nabala ŵawile, jwalakwe ŵatite kuti, “Upile uŵe kwa AMBUJE! Amwucisye Nabala ligongo lyakundendela une yakusakala nipo andekasisye une jwamasengo jwawo kuti ngalemwa. AMBUJE ampele yakusawusya Nabala ligongo lya yakusakala yakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.39",
            "verseOrgIds": [
              "1SA.25.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "1SA 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Daudi ŵatumile acacanda ŵakwe kukuwucisya liŵasa kwa Abigelo kuti aŵe ŵamkwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.39",
            "verseOrgIds": [
              "1SA.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acacanda ŵakwe ŵala ŵajawile kwa jwamkongwejo ku Kalimeli, ni ŵamsalile kuti, “Daudi atutumisye uwe kuti twajigale wawojo, akaŵe ŵamkwawo.”",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.40",
            "verseOrgIds": [
              "1SA.25.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "1SA 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.40",
            "verseOrgIds": [
              "1SA.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "1SA 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abigelo ŵatindiŵele ni kugundisya ngope jawo pasi nipo ŵatite kuti, “Une jwamasengo jwa ambuje ŵangu Daudi, ndili cile kojesya sajo sya ŵamasengo ŵakwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.41",
            "verseOrgIds": [
              "1SA.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Abigelo ŵajimwice mwakulumika ni kukwela pa bulu jwakwe. Ŵalongene nawo ŵali msano ŵiŵamtumicilaga, acakuyaga ŵamasengo ŵa Daudi ŵala nipo ŵajile kuŵa ŵamkwakwe ŵa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "1SA 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.42",
            "verseOrgIds": [
              "1SA.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "1SA 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi ŵaliji ali alombele Ahinowamu ŵa ku Yesilele, nipo aji ndaŵiji Abigelo nombe nawo ŵaliji ŵamkwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.43",
            "verseOrgIds": [
              "1SA.25.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "1SA 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa jele ndaŵiji, Saulo ŵaliji ali ampelece mwanagwe jwamkongwe Mikala juŵaliji msonogwe jwa Daudi kwa Paliti, mwanace jwa Laishi jwa ku msinda wa ku Galimu.",
          "type": "text",
          "attrs": {
            "verseId": "1SA.25.44",
            "verseOrgIds": [
              "1SA.25.44"
            ]
          }
        },
