              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi piŵayice ku Mahanaimu, Shobi mwanace jwa Nahasi jwa ku msinda wa Laba ku Amoni ni Makili mwanace jwa Amiyele jwa ku Lodebala soni Balisilayi jwa ku Logelimu ku Giliyadi, ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.17.27",
            "verseOrgIds": [
              "2SA.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
