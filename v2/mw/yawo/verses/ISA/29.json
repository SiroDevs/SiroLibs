            "sid": "ISA 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵakwalagasya acimjawo tacimalila papopo, ŵakwanyosya acimjawo tacisimilila, soni wosope ŵakusanonyela ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        },
        {
          "text": " tacijonanjidwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.20",
            "verseOrgIds": [
              "ISA.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu tacapa cilango ŵandu ŵakwasinjilila acimjawo, nipo soni ŵakwasokonesya ŵandu ŵali pa magambo. Tacipeleka soni cilango kwa ŵandu ŵakupeleka umboni wa unami, kuti acimjawo ŵangalemwa akasalamulwa mwakulungama.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.21",
            "verseOrgIds": [
              "ISA.29.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
