          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo sambano AMBUJE Mlungu jwa Aisalaeli, ŵele ŵakulupwisye Abulahamu",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        },
        {
          "text": " pa yisawusyo, akuŵeceta kuti, “Ŵandu ŵangu ngasanyosyedwa soni, ngasagwisya ngope syawo ligongo lya soni. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.22",
            "verseOrgIds": [
              "ISA.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ISA 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ni kuti ŵanace ŵawo, pitaciyiwona yindesile une pasikati pawo, tacililumba lina lyangu lyeswela. Tacimanyilila uswela wakwe kwa Jwamswela jula jwa Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        },
        {
          "text": " nipo tacitenda najo woga Mlungu jwa Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.23",
            "verseOrgIds": [
              "ISA.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
