          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakuloŵela tacipata lunda, ŵandu ŵakunyinyita ndaŵi syosope tacijiticisya malangiso.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.29.24",
