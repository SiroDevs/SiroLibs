          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.8",
            "verseOrgIds": [
              "ISA.38.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 38:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali aposile ku cilwele cakwe, Hesekiya mwenye jwa ku Yuda jwalembile nyimbo ja malumbo jakuti:",
          "type": "text",
          "attrs": {
            "verseId": "ISA.38.9",
            "verseOrgIds": [
              "ISA.38.9"
            ]
          }
        }
      ]
