            "number": "1",
            "style": "v",
            "sid": "ISA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likungu kwa ŵandu ŵakutama mcilambo capesi pa sulo sya cilambo ca Ifiyopiya! Kweleko kukusapikanika mkokomo wa mapapiko.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEP.2.12"
              },
              "items": [
                {
                  "text": "Sef 2:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.1",
            "verseOrgIds": [
              "ISA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ku cilamboco akusatuma ŵakwimilila cilamboco, m'mawato gakupanganyidwa ni matete kupitila mu Lusulo lwa Nayilo. Mjawuleje kumangwenu jemanja ŵamitenga ŵacitema, kwa ŵandu ŵalewu mnope soni ŵa yilu ya mya, kwa ŵandu ŵakusajogopedwa ni ŵandu ŵapakuŵandika soni ŵakutali, cilambo ca ŵandu ŵamacili soni ŵakulimbangana pa ngondo, cilambo cawo cili cegaŵanice ni sulo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.2",
            "verseOrgIds": [
              "ISA.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane jemanja wosope ŵimkutama mcilambo capasi, Pitacijimusya mbendela ja cimanyisyo pa matumbi, mlole! Pitacigombaga lipenga, mpikane! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.3",
            "verseOrgIds": [
              "ISA.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "text": " ŵaŵecete ni une kuti, “Kutyocela kungusindama Uneji tinjilola pasi mwakuwusimana mtima, mpela mulikusaŵalila lyuŵa mu ndaŵi ja citukuta, mpela mugakusagwila mangame cilo mu ndaŵi jagowola. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.4",
            "verseOrgIds": [
              "ISA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu alimkanatande kugowola, maluŵa gali gagwile pasi, nipo yisogosi yili yitandite kwiwula Mlungu tacikatatu yakusipuka ni kusityosya nyambi syakutambalala mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.5",
            "verseOrgIds": [
              "ISA.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mitembo ja ŵandu ŵa ngondowo tacijileka jangasika kuti yijuni ya m'matumbi ni yinyama yilye. Yijuni tiyicilya mu ndaŵi ja cawu nipo yinyama ya mwitinji tiyicilya mu ndaŵi jakusisima.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
