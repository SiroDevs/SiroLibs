        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.6",
            "verseOrgIds": [
              "ISA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ndaŵi jelejo ŵandu taciyika ni yakupeleka kwa AMBUJE Ŵamaciligosope. Ŵandu ŵakwe taciŵa ŵalewu ni ŵakusalala pa cilu. Taciŵa ŵakogopedwa ni ŵandu ŵa pakuŵandika ni kwakutalika. Mtundu wa ŵandu ni wakujipunda mitundu jine. Cilambo cawo cili cekaticekatice mtande wa sulo. Yakupelekayo taciyika nayo Kwitumbi lya Siyoni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        },
        {
          "text": " kwele ŵandu akusiŵalambila AMBUJE Ŵamaciligosope.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.18.7",
            "verseOrgIds": [
              "ISA.18.7"
            ]
          }
        }
      ]
