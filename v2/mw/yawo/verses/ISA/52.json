            "number": "4",
            "style": "v",
            "sid": "ISA 52:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kalakala jemanja ŵandu ŵangu mwapite ku Iguputo mwa lisosa lyenu kuja kutama nawo, nambo Asiliya ŵalagasisye atamose nganalemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.4",
            "verseOrgIds": [
              "ISA.52.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 52:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Une AMBUJE nguti, ‘Sambano ndende cici pakutipo m'mweji ŵandu ŵangu ŵamjigele ukapolo nambo ngapeleka cilicose? Ŵakumlamulila akuŵeceta ni lisegwe mwakutwanga, soni agamba kunyosya Une mwangalecesya.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.5",
            "verseOrgIds": [
              "ISA.52.5"
            ]
          }
        },
        {
