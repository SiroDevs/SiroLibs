            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
        },
        {
          "text": " akuŵeceta kuti, “Nganapocela cilicose pakumsumisya, myoyo timciwomboledwa pangali mbiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.52.3",
            "verseOrgIds": [
              "ISA.52.3"
            ]
          }
