              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵangu, mjawule mkajinjile m'nyumba syenu, ni kuwugala matanga gakwe. Mkajuŵe mwelemo ndaŵi jamnono kwembecela kuti lutumbilo lwa AMBUJE lumale. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.20",
            "verseOrgIds": [
              "ISA.26.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 26:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akwisa kutyocela kwakusatama, akwisa kukwapa cilango ŵandu ŵa cilambo capasi ligongo lya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
            "verseOrgIds": [
              "ISA.26.21"
            ]
          }
        },
        {
          "text": " wawo. Miasi ja ŵandu ŵakuwulajidwa mcilambo capasi tijicijuwulika. Mitembo ja ŵandu ŵakuwulajidwa ngisijisisika.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.26.21",
            "verseOrgIds": [
              "ISA.26.21"
            ]
