            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ISA 37:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambo une AMBUJE ngumsalila m'mwejo Senakelibu kuti, yindu yeleyi nayikolosisye uneji kalakala. M'mwejo ngamkumanyilila kuti une jika ni junaganisisye yakumtuma m'mwejo kuti myitende yindu yeleyi. Nipo sambano yosope yitendecekwe. Une nampele m'mwejo macili gagwicisya misinda ni kujisandusya kuŵa mawunjili ga maganga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.26",
            "verseOrgIds": [
              "ISA.37.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵaliji m'misindamo ŵaliji ŵangali macili, wakamwile woga, nipo nganisyo syawo syasokonecele. Ŵaliji ŵangali macili mpela mugakuŵela manyasi gagakumela m'migunda, kapena manyasi gakumela pa msakasa, gele gakusajumula ni mbungo ja mtukuta mkanigakule.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.27",
            "verseOrgIds": [
              "ISA.37.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ISA 37:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.27",
            "verseOrgIds": [
              "ISA.37.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ISA 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambotu une nguyimanyilila yosope yenumwe, yosope yimkutenda ni kosope kumkuja. Soni ngumanyilila yimkuti pakundumbilila une. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.28",
            "verseOrgIds": [
              "ISA.37.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 37:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nakuweni kulikwesya kwenu soni nagapikene maloŵe genu gakunyosya une. Sambano tinalukolece lupula lwenu ni cisopo, ni kukoleka cisyano mkamwa mwenu. Nipo tinamwusye kumangwenu pakumpitisya mwitala limwapitile pakwisa akuno.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.37.29",
            "verseOrgIds": [
              "ISA.37.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ISA 37:29"
          },
          "items": [
