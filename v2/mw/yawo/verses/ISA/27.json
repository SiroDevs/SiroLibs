          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "text": " tacikamulisya masengo upanga wawo wakutema, wekulungwa soni ŵamacili pakupeleka cilango kwa Lefiyatani.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "text": " Lefiyatani cili cilijoka cakotakota pakwenda soni caguluka. Nipo soni taciciwulaga cilombo cakogoya ca m'nyasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
