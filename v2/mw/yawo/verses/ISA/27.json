              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.1",
            "verseOrgIds": [
              "ISA.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo AMBUJE taciŵeceta ya mgunda wawo wa mpeleya wesogole cenene. Tacijila kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.2",
            "verseOrgIds": [
              "ISA.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Une, AMBUJE ndili mlonda jwa mgundawo, ngusinawujitilila ndaŵi syosope. Ngusinawulondela cilo ni musi, kuti jwalijose akapata lipesa lyakuwujonanga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.3",
            "verseOrgIds": [
              "ISA.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganimba jwakutumbila soni. Nambo naga seselesya ni yitela yine ya miŵa yikawonece, ni tingalimbane nayo ni kuyijoca moto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.4",
            "verseOrgIds": [
              "ISA.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga amagongo ŵa ŵandu ŵangu akusosa kuti natetele, akamulane ni une ya mtendele, nditu akamulane ni une ya mtendele.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.5",
            "verseOrgIds": [
              "ISA.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku ga pasogolo, Aisalaeli, yisukulu ya Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        },
        {
          "text": " tacimela miciga mpela mpeleya. Tacisipuka ni kusogola yisogosi, yitiyicigumbala mcilambo cosope capasi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.6",
            "verseOrgIds": [
              "ISA.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana AMBUJE ŵapelece cilango kwa Aisalaeli muŵapelecele kwa amagongo ŵa jemanjajo? Ana Aisalaeli ŵawulajidwe mpela muŵawulajile amagongo ŵawo? ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.7",
            "verseOrgIds": [
              "ISA.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵapele cilango ŵandu ŵakwe pakwatopola ni kwatumisya ku ukapolo. Ŵatopwele ni mbungo jawo ja ukali, mpela muyikusaŵela pa lisiku lyakupuga mbungo kutyocela kungopoko lyuŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.8",
            "verseOrgIds": [
              "ISA.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        },
        {
          "text": " wa Isalaeli tucikululucidwa, nipo tacilosya yisogosi yakupesya ulemwa wawo, pitacigakasanya maganga gosope ga m'malo gakupelecela mbopesi sya ŵandu ŵangam'manyilila Mlungu, kuŵa luwundu. Ngasigawoneka soni malo gakutinicisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        },
        {
          "text": " nipo soni ngasiyiwoneka yilandanyo ya Ashela.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.9",
            "verseOrgIds": [
              "ISA.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msinda wa mapupa usandwice wangatamidwa. Usandwice malo gakulecedwa soni kuliŵalika mpela cipululu. Kweleko kutendedwe kuŵa malo gakulanjila yinyama, nipo yinyama yikusapumula kweleko ni kulyaga nyambi sya yitela. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.10",
            "verseOrgIds": [
              "ISA.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyambi sya yitelayo sili sijumwile, akusasitemangula, nipo acakongwe akusasijigala kuja kutenda sasu. Pakuti ŵandu ŵeleŵa ali ŵangapikanicisya, ni ligongo lyakwe Mlungu juŵapanganyisye ngasiŵatendela canasa, ŵalakwe uŵapanganyisye jemanjajo ngisiŵatendela canasa.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.11",
            "verseOrgIds": [
              "ISA.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.11",
            "verseOrgIds": [
              "ISA.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo AMBUJE tacasonganya ŵandu ŵakwe jumojumo, kutyocela ku Lusulo lwa Yufuleti mpaka ku lusulo lwa ku Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.12",
            "verseOrgIds": [
              "ISA.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo lipenga lyekulungwa tilicilila kwaŵilanga Aisalaeli wosope ŵiŵaliji mu ukapolo ku Asiliya ni ku Iguputo. Jemanjajo taciyika nipo tacalambila AMBUJE pa litumbi lyawo lyeswela lya ku Yelusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.27.13",
            "verseOrgIds": [
              "ISA.27.13"
            ]
          }
        }
      ]
    }
