            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.4",
            "verseOrgIds": [
              "ISA.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Upanga wangu niwukolosisye kala kwinani. Ana ngaŵa welewu uwukutuluka kukwapa cilango Aedomu, ŵandu ŵanasimicisye kuti najonanje.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.34.5",
            "verseOrgIds": [
              "ISA.34.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
