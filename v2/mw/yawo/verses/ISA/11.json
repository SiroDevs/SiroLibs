                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo AMBUJE tacitambalisya mkono wawo kaŵili kuti ŵakulupusye ŵandu ŵawo ŵakusigalila ku Asiliya, ku Iguputo, ku Patilosi, Ifiyopiya, ku Elamu, ku Babiloniya, ku Hamati ni ku yilambo ya mungulugulu mwa nyasa jekulungwa. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.11",
            "verseOrgIds": [
              "ISA.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacajimicila cimanyisyo ŵandu ŵa mitundu jine,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        },
        {
          "text": " tacasonganya ŵakwasika ŵa ku Isalaeli soni ŵapwilingenye ŵa ku Yuda kutyocela kumbali syosope mcece sya cilambo ca pasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.12",
            "verseOrgIds": [
              "ISA.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wiwu wa Efelemu kucitendela cilambo ca Yuda tiwucimala, nipo ŵele ŵakucisisya cilambo ca Yuda taciwulajidwa. Efelemu ngasatenda wiwu ni Yuda, soni Yuda ngasasisya Efelemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.13",
            "verseOrgIds": [
              "ISA.11.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yilambo ya Yuda ni Efelemu yalumo, tiyiciputa ngondo ni cilambo ca Afilisiti ŵa kungapilo lyuŵa, nipo wosopewo yalumo tacisumula yindu ya ŵandu ŵa kungopoko lyuŵa. Tacilimbana ni ŵandu ŵa ku Edomu ni Mowabu, nipo ŵandu ŵa ku Amoni tacapikanilaga. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.14",
            "verseOrgIds": [
              "ISA.11.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo AMBUJE tacijipwesya mnope nyasa jekulungwa ja ku Iguputo. Taciwutambalisya mkono wakwe nipo tacijitendekasya mbepo jakoca kupuga ni kumusya Lusulo lwa Yufuleti. Lusulolo tulucigaŵikana mtumasulo msano ni tuŵili, kuti ŵandu ajomboce pejumu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.12"
              },
              "items": [
                {
                  "text": "Ciw 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.15",
            "verseOrgIds": [
              "ISA.11.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo tipaciŵa litala lyekulungwa lyakutyocela ku Asiliya, lyele litacijenda Aisalaeli utacisigalila, mpela mwele yiyaŵelele pa litala lyekulungwa lyele Aisalaeli ŵajesile pakutyoka ku Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.16",
            "verseOrgIds": [
              "ISA.11.16"
            ]
          }
        }
      ]
    }
