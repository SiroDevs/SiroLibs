            "number": "10",
            "style": "v",
            "sid": "ISA 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lyelelo mwenye jwasambano jwakutyocela ku liŵasa lya Daudi",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "text": " taciŵa cimanyisyo kwa ŵandu ŵa mitundu josope. Ŵandu wosope tacisongana kwa jwalakwe, nipo malo gakwe gakutama tigaciŵa ga ucimbicimbi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.11.10",
            "verseOrgIds": [
              "ISA.11.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
