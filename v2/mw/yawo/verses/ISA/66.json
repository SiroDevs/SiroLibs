                "loc": "MAT.5.34+MAT.5.35"
              },
              "items": [
                {
                  "text": "Mat 5:34-35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.22"
              },
              "items": [
                {
                  "text": "23:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.49+ACT.7.50"
              },
              "items": [
                {
                  "text": "Mase 7:49-50",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yindu yosope nayipanganyisye ni Une, ni kuti yosopeyi yili yangu, akuti myoyo AMBUJE. Ŵandu ŵingusinanonyela ni aŵa: Ŵakulinandiya ni ŵakupesya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "text": " wawo, ŵakusanjogopa soni kugapikanila maloŵe gangu.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ISA 66:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.2",
            "verseOrgIds": [
              "ISA.66.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ISA 66:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambo pana ŵane ŵakusagamba kutenda yakwanonyela jika. Kwa jemanjajo nganiyiŵa yakulekangana kupeleka ng'ombe jajilume mpela mbopesi kapena kuwulaga mundu, kuwulaga mwanace jwangondolo kuti apelece mbopesi kapena kuwulaga m'mbwa, kupeleka cakupeleka ca yakulya kapena kupeleka miasi ja liguluŵe, kupeleka mbopesi ja ubani",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "text": " ja cikumbukumbu mwine kujilambila milungu jakupanganyidwa ni ŵandu. Ŵandu ŵeleŵa umi wawo wukusanonyela yindu yakusakala. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.3",
            "verseOrgIds": [
              "ISA.66.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une sambano tinjitumisya yakogoya pa jemanja nipo tinjimtesya woga, ligongo pinaŵilasile, paliji pangali juŵanjiticisye, kapena kundejela lipikanilo pinaŵecetaga. Ŵatesile yakusakala pameso pangu, ŵalisagulile kutenda yiyaliji yakunyalaya kwa une.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ISA 66:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.4",
            "verseOrgIds": [
              "ISA.66.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ISA 66:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane maloŵe ga AMBUJE, jemanja ŵimkusatetemela ni maloŵe gakwe. Jwalakwe akuti, “Acalongo acimjenu ŵakusaŵengana namwe soni ŵangamjiticisya ligongo lya lina lyangu, akusati, ‘Acimbicikwe AMBUJE, kuti uwe tuwone lukondwa lwawo.’ Nambo jemanjajo ni ŵitacitenda soni! ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.5",
            "verseOrgIds": [
              "ISA.66.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane lisegwe mu msinda! Mpikane liloŵe m'Nyumba ja AMBUJE, liloŵe lya AMBUJE lyalikupeleka cilango kwa amagongo ŵakwe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ISA 66:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.6",
            "verseOrgIds": [
              "ISA.66.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ISA 66:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Msinda wanguwu uli mpela jwamkongwe jwakuŵeleka mwanace jwali mkanayipikane yipwetesi yakwe, jwakuŵeleka mwanace jwamlume kupweteka mkani kuŵe.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.12.5"
              },
              "items": [
                {
                  "text": "Ciw 12:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.7",
            "verseOrgIds": [
              "ISA.66.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ISA 66:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ŵani uŵayipikene yamti myiyi? Ana ŵani uŵayiweni yamti myiyi? Ana cilambo komboleka kucipanganya lisiku limpepe? Ana mtundu wa ŵandu komboleka kupagwa lisiku limpepe? Nambo Siyoni",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        },
        {
          "text": " ali agambile kutanda kuyipikana yipwetesi, ŵaŵelece ŵanace ŵakwe ŵacalume. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.8",
            "verseOrgIds": [
              "ISA.66.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ISA 66:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana une tinjayicisya ŵandu ŵangu mu ndaŵi jakuŵeleka, ni kwakanya kuti akaŵeleka?” AMBUJE aŵecete. “Ana Une jundili jakuŵelekasya mpaka mbugale citumbo pa ndaŵi jelejo?” Aŵecete myoyo AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.9",
            "verseOrgIds": [
              "ISA.66.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ISA 66:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.11",
            "verseOrgIds": [
              "ISA.66.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ISA 66:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Tinjimpa yambone yejinji mpela lusulo lwa mesi. Yipanje ya mitundu ja ŵandu tiyiciyika kwa jemanja mpela lusulo lwakusewucila mesi. Timciŵa mpela mwanace jwakonga jwele mamagwe amnyakwile kapena kumpembeka pa malungo. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.12",
            "verseOrgIds": [
              "ISA.66.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ISA 66:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimsangalasya ku Yelusalemu mpela mwele jwamkongwe akusamsangalalicisya mwanace jwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.13",
            "verseOrgIds": [
              "ISA.66.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timcisangalala pakuyiwona yeleyi, tiyicimlimbikasya ni kumpa umi wamacili. Sambano timcimanyilila kuti une AMBUJE ngusinakamucisya ŵele ŵakusambikanila, soni ngusinatumbilila amagongo ŵangu.”",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ISA 66:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.14",
            "verseOrgIds": [
              "ISA.66.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ISA 66:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE taciyika ni moto. Yigeleta yakwe tiyiciyika mpela mbungo jamacili. Jwalakwejo tacilosya pakulanguka ukali wakwe, nipo tacipeleka cilango kwa amagongo ŵakwe ni malamba ga moto. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.15",
            "verseOrgIds": [
              "ISA.66.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacipeleka cilango kwa ŵandu wosope ŵa cilambo capasi ni moto ni upanga, ŵajinji taciwulajidwa ni AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ISA 66:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.16",
            "verseOrgIds": [
              "ISA.66.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ISA 66:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Ŵele ŵakuti akuliŵika pa jika ni kuliswejesya pa ndaŵi jakusosa kutenda misyungu ja m'migunda jila, pa ndaŵi ni mlongola jwawo, ni kulyaga nyama ja maguluŵe, mapuku ni yakunyalaya yine, wosopewo taciwila yalumo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.17",
            "verseOrgIds": [
              "ISA.66.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ISA 66:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumanyilila yitendo yawo ni nganisyo syawo. Ngwisa kukwasonganya ŵandu ŵa mitundu josope ni yiŵeceto yosope. Taciyika nipo taciluwona lumbili lwangu. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.18",
            "verseOrgIds": [
              "ISA.66.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ISA 66:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjiŵika cimanyisyo pasikati pawo. Mwa jemanjajo, tipaciŵa ŵane ŵakulupuka, ŵele tinjatuma kwa ŵandu ŵa mitundu jine,",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "text": " mpela ŵa ku Sipeni, ŵa ku Libiya ni ŵa ku Ludi, ŵakumanyilila mnope ya mipamba, ni ŵa ku Tubali ni ku Gilisi, ni ku yilambo yakwakutalika ŵele nganapikaneje ya mbili jangu kapena kuluwona lumbili lwangu. Jemanjajo tacilalicila ya lumbili lwangu pasikati pa ŵandu ŵa mitundu jine. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.19",
            "verseOrgIds": [
              "ISA.66.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ISA 66:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo taciyika nawo acalongo acimjenu wosope kutyocela kwa ŵandu ŵa mitundu josope, kuti aŵe mtuka kwa une. Taciyika nawo kwitumbi lyangu lyeswela lya Yelusalemu, acalongo acimjenuwo pitacikwesya mahaci, acibulu, ngamila",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "text": " pa mageleta ni ngolo. Taciyika nawo mpela mwele mwakusayicila ni yakupeleka Aisalaeli ya yakulya ku Nyumba ja AMBUJE, ali ayijigalile mu yakujigalila yeswejesedwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.20",
            "verseOrgIds": [
              "ISA.66.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ISA 66:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa jemanjajo tinjatenda kuŵa ŵakutaga mbopesi ni Alefi.",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.21",
            "verseOrgIds": [
              "ISA.66.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
