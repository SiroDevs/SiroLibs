      },
      "items": [
        {
          "text": "AMBUJE akuyilamula yilambo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ISA 66:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "text": " akuŵeceta kuti, “Kwiwunde ni kukuli citengu ca ucimwene wangu, soni cilambo capasi ni cakuliŵatila ca sajo syangu. Ana nyumba jamti uli jampaka mpakombole kundaŵila? Ana malo gamti uli gampaka mgalinganye kuti Uneji mbumulilejemo?",
          "type": "text",
          "attrs": {
            "verseId": "ISA.66.1",
            "verseOrgIds": [
              "ISA.66.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
