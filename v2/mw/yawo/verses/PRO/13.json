              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu mgunda wegonele wa mundu jwakulaga mukusasogola yakulya yejinji, nambo ŵandu ŵangali cilungamo akusasumula yakulyayo.",
          "type": "text",
          "attrs": {
