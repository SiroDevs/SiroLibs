          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamtenga jwakusakala akusiŵagwicisya ŵandu m'yisawusyo, nambo ndumetume jakulupicika jikusayikasya mtendele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.17",
            "verseOrgIds": [
              "PRO.13.17"
            ]
          }
        }
