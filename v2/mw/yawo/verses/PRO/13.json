          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakwenda ni ŵandu ŵalunda nombe najo akusaŵa jwalunda, nambo jwakwenda ni yisilu nombe najo tacijonasika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.20",
            "verseOrgIds": [
