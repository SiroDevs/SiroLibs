      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwalunda akusapikanila malamusi ga babagwe, nambo mwanace jwakunyosya ngakusapikanila ali kumjamuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.1",
            "verseOrgIds": [
              "PRO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwambone tacilya yambone malinga ni yisogosi yakuwuma mkamwa mwakwe, nambo ŵandu ŵakunyenga akusagambaga kumbila ya ndewo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.2",
            "verseOrgIds": [
              "PRO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusawugala pakamwa pakwe akusasunga umi wakwe, nambo mundu jwakusagamba kuwugula pakamwa pakwe mwangajimicila akusalijonanga msyene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PRO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.3",
            "verseOrgIds": [
              "PRO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwaulesi akusakumbila yindu nambo ngayipata kose, nambo mundu jwamtawu pa masengo akusagambaga kusicililape.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PRO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.4",
            "verseOrgIds": [
              "PRO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakunonyela Mlungu akusaŵengana ni ya unami, nambo yakutenda ya ŵandu ŵakusakala yikusasakalisya nipo yikusatesya soni.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PRO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.5",
            "verseOrgIds": [
              "PRO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilungamo cikusamcenjela mundu jwambone, nambo ungalumbana ukusamgwisya mundu jwakusakala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PRO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.6",
            "verseOrgIds": [
              "PRO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwine akusaliwanicisya mpela jwakusicila nambo mkinakola kalikose. Jwine akusalitenda jwakulaga, kutendaga ali akwete cipanje cejinji mnope.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.7",
            "verseOrgIds": [
              "PRO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cipanje ca mundu jwakusicila ni cikusakulupusya umi wakwe, nambo mundu jwakulaga nganakola litala lyakuti alikulupucisye.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PRO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.8",
            "verseOrgIds": [
              "PRO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilanguka lya ŵandu ŵakulungama likusalanguka mnope, nambo nyali ja ŵandu ŵakusakala tijicisima nditu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PRO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.9",
            "verseOrgIds": [
              "PRO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cipongwe ca ŵandu ŵa mwano cikusatandisya njojo, nambo ŵandu ŵakusapikanila msyungu wa acimjawo ni ŵakwete lunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PRO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.10",
            "verseOrgIds": [
              "PRO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cipanje cakucipata mwacitemacitema nombe naco soni cikusamala mwacitecimape, nambo cakucipata mwapanandipanandi cikusaŵa cili mkutupilatupilape.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PRO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.11",
            "verseOrgIds": [
              "PRO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cindu cakucijembeceya pati cilepelece, cikusapwetesya mtima, nambo cindu cakucikumbila pati ucipatile, umi wakwe ukusaŵa wakusengwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PRO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.12",
            "verseOrgIds": [
              "PRO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakunyosya msyungu akusalijonanga msyene pejo, nambo jwakusapikanila lilamusi akusapocela mbote.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PRO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.13",
            "verseOrgIds": [
              "PRO.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Majiganyo ga ŵandu ŵalunda gali mpela uliŵa wa umi, gakusakamucisya ŵandu kuti akasatanjila mu citega ca ciwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.14",
            "verseOrgIds": [
              "PRO.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwa nganisyo syambone ŵandu akusamsalalila mtima, nambo mundu jwangakulupicika, kwakwe ni konasika basi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.15",
            "verseOrgIds": [
              "PRO.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakalamuka akusatenda yindu yakwe yosope mwa lunda, nambo cisilu cikusalosya pakulanguka usilu wakwewo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.16",
            "verseOrgIds": [
              "PRO.13.16"
            ]
          }
        }
      ]
    },
