          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cindu cakucikumbila pati citendekwe, cikusasangalasya mtima. Nambo kuleka kutenda yindu yakusakala cili cindu cakusakalisya kwa ŵakuloŵela.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.19",
            "verseOrgIds": [
