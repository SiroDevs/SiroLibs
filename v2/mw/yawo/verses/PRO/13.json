          ]
        },
        {
          "text": "Mundu jwakunyosya msyungu tacilaga, soni tacinyosyedwa, nambo mundu jwakupikanila camuko, akusacimbicisidwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.18",
            "verseOrgIds": [
              "PRO.13.18"
            ]
          }
