          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakusakala yikusiyalondalonda ŵandu ŵa ulemwa, nambo mundu jwakutenda yindu ya cilungamo akusapocela yindu yambone.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.13.21",
            "verseOrgIds": [
              "PRO.13.21"
