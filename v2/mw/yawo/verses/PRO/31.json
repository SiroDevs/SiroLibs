          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusati, “Elo apali acakongwe ŵajinji ŵakusicilila kwabasi, nambo m'mwe mkwapunda wosopewo.”",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.29",
            "verseOrgIds": [
