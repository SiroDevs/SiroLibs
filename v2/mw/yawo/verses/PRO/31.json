        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 31:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵakwe akusampocela ni kumkolangaga kuti jwana upile. Ŵamkwakwe nombe nawo akusamlumba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.28",
            "verseOrgIds": [
              "PRO.31.28"
