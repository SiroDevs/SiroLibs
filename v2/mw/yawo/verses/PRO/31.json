          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngope jakusangalala jikusaloŵesya, soni kusalala kwangalila ugali, nambo jwamkongwe jwakwajogopa AMBUJE ni jwakuŵajilwa kumlomba.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.30",
            "verseOrgIds": [
              "PRO.31.30"
            ]
