          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusaŵeceta mwa lunda, soni akusiŵajiganya ŵandu ni maloŵe gambone.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.26",
            "verseOrgIds": [
              "PRO.31.26"
            ]
          }
        }
