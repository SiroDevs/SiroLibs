          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macili ni ucimbicimbi yikusaŵa mpela cakuwala cakwe, akusaganicisya yakusogolo mwakusangalala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.25",
            "verseOrgIds": [
              "PRO.31.25"
            ]
