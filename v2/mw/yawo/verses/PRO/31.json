            "sid": "PRO 31:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusalolela cenene ndamo sya ŵandu ŵa mwiŵasa lyakwe, soni ngakusatenda ulesi amta panandi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.31.27",
            "verseOrgIds": [
              "PRO.31.27"
            ]
          }
        }
      ]
