            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakusakala taciŵa cida cakwawombolela ŵandu ŵakulungama, soni ŵandu ŵangakulupicika taciŵa cida cakwawombolela ŵandu ŵa mtima wambone.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.18",
            "verseOrgIds": [
              "PRO.21.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PRO 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.18",
            "verseOrgIds": [
              "PRO.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PRO 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli kwambone kuja kutama mcipululu, kulekangana ni kutama ni jwamkongwe jwa lisegwe ni jwakupya mtima citema.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.19",
            "verseOrgIds": [
              "PRO.21.19"
            ]
          }
        }
      ]
    },
    {
