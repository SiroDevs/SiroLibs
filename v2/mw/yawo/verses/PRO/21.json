          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumbila kwa mundu jwaulesi tikucimwulaga, pakuŵa akusagamba kuti yala lende, ngakamula masengo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.25",
            "verseOrgIds": [
              "PRO.21.25"
            ]
