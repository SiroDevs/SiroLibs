              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pangali lunda, pangali kupikanicisya yindu cenene, pangali soni atamose msyungu, yampaka yikombole kwapunda AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.30",
            "verseOrgIds": [
              "PRO.21.30"
            ]
          }
        }
      ]
