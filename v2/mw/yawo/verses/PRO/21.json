          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jikusataŵa pakamwa pakwe ni kusamalila yakuŵeceta yakwe, ngaŵa mkusimana ni yakusawusya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.23",
            "verseOrgIds": [
