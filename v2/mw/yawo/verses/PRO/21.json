          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mboni ja unami tijicijonasika, nambo maloŵe ga mundu jwakupikana, tigacipikanika mpaka kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.28",
            "verseOrgIds": [
              "PRO.21.28"
            ]
          }
        }
