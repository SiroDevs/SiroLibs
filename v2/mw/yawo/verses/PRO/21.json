          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusakala akusasaka kulilosya mpela jwakulimba mtima, nambo mundu jwagoloka akusaganicisya cenene yitendo yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.29",
            "verseOrgIds": [
              "PRO.21.29"
            ]
          }
        }
      ]
    },
