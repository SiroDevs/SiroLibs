          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwalunda mpaka apakombole kuwupunda pa ngondo msinda wa ŵandu ŵamacili, ni gwisya mapupa gakulimba gakusagakulupilila ŵandu ŵa mu msindamo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.22",
            "verseOrgIds": [
              "PRO.21.22"
            ]
          }
        }
      ]
    },
