          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lyosope lyamtundu ŵandu ŵakusakala pangali cakusatenda akaŵe kumbila yindu basi, nambo ŵandu ŵambone akusapeleka, soni mwangajumulila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.26",
            "verseOrgIds": [
              "PRO.21.26"
            ]
          }
        }
      ]
    },
