          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbopesi ja ŵandu ŵakusakala jikusijanyalaya AMBUJE, mnopemnope pati ajipelece ni cakulinga cakusakala.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.27",
            "verseOrgIds": [
              "PRO.21.27"
            ]
