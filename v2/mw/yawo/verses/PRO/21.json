          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusanonyela yakusangalasya taciŵa mundu jwakulaga, Jwalijose jwakunonyelwa finyo ni mawuta, ngasasicila.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.17",
            "verseOrgIds": [
              "PRO.21.17"
            ]
          }
        }
      ]
    },
