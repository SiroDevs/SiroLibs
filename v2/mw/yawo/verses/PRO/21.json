          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakupoka ni jwakulikwesya lina lwakwe ni “Jwakunyosya” ligongo akusatenda yindu mwa lilama ni mwa cipongwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.24",
            "verseOrgIds": [
