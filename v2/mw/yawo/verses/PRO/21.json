          "type": "text",
          "attrs": {
            "verseId": "PRO.21.13",
            "verseOrgIds": [
              "PRO.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtuka wamcisyepela ukusalekasya ukali, soni cakwapa camcisyepela cikusamasya atamose macili ga ukali wakogoya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.14",
            "verseOrgIds": [
              "PRO.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pati cilungamo citendekwe, ŵandu ŵambone akusasangalalaga, nambo yikusiyajogoya ŵandu ŵali acitambwali.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.21.15",
            "verseOrgIds": [
              "PRO.21.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
