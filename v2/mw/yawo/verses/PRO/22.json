          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.27",
            "verseOrgIds": [
              "PRO.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasimlunda malile gakalakala pakusumba malile, gele giŵaŵisile acinangolo ŵenu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.22.28",
            "verseOrgIds": [
              "PRO.22.28"
            ]
          }
        }
