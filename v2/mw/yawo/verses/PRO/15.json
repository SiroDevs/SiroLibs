          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matala ga mundu jwaulesi gali gamawutale ni miŵa, nambo litala lya mundu jwakulungama lili mpela msewo wagoloka watyatyatya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.19",
            "verseOrgIds": [
              "PRO.15.19"
            ]
          }
        }
