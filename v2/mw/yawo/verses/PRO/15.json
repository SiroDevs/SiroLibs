          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusasosa kupindula mu matala gangakulupicika, akusalilagasya liŵasa lyakwe; nambo mundu jwakuŵengana ni mbote sya cilo tacisimana cenene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.27",
            "verseOrgIds": [
              "PRO.15.27"
            ]
