          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Usilu ukusiwumsangalasya mundu jumkinakola lunda, nambo mundu jwakupikanicisya cenene yindu akusajenda mwagoloka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.21",
            "verseOrgIds": [
              "PRO.15.21"
            ]
          }
        }
      ]
    },
