        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku gosope ga mundu jwakulagasika gakusaŵa gakusakala, nambo mtima wakusangalala ukusaŵaga wakondwa ndaŵi josope.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.15",
            "verseOrgIds": [
              "PRO.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuli kwambone kola yakunandipa uli mkwajogopa AMBUJE, kulekangana ni kola cipanje cejinji ni kusimanaga ni yisawusyo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.16",
            "verseOrgIds": [
              "PRO.15.16"
            ]
          }
        }
      ]
    },
    {
