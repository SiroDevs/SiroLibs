          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nganisyo sya ŵandu ŵakusakala sikusisyanyalaya AMBUJE, nambo maloŵe ga ŵandu ŵakulungama gakusigamsangalasya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.26",
            "verseOrgIds": [
              "PRO.15.26"
            ]
