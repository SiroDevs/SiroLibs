          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusaganyosya malamusi akusagamba kulinyosya msyene jika, nambo jwakusajiticisya camuko akusapindula pakupikanicisya cenene yindu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.32",
            "verseOrgIds": [
              "PRO.15.32"
            ]
          }
        }
      ]
