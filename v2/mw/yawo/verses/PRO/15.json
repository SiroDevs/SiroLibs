          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵalunda akusajenda litala lyalikusilyayicisya ku umi, kuti agaŵambale malembe kusi kwakweko.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.24",
