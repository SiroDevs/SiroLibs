        },
        {
          "text": "Mundu jwakupya mtima citema akusatandisya njojo, nambo mundu jwakuwusimana mtima akusayikasya mtendele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.18",
            "verseOrgIds": [
              "PRO.15.18"
            ]
          }
        }
      ]
    },
