          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.16",
            "verseOrgIds": [
              "PRO.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PRO 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kulya liponda pali pana cinonyelano kuli kwambone, kupunda ni kulila nyama ja ng'ombe jakwimbala pali pana uŵengani.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.17",
            "verseOrgIds": [
              "PRO.15.17"
            ]
          }
        }
      ]
    },
