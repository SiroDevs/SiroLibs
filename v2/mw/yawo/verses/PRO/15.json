          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akusapasula nyumba ja mundu jwakupoka, nambo akusasamalila malile ga kacilambo ka jwamkongwe jwamasije.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.25",
            "verseOrgIds": [
              "PRO.15.25"
            ]
