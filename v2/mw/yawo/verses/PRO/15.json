          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwalunda akusiŵasangalasya babagwe, nambo mwanace jwakuloŵela akusiŵanyosya mamagwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.20",
            "verseOrgIds": [
              "PRO.15.20"
            ]
          }
