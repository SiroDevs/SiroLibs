          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakwete mapikanilo gagakusapikana camuko, tacitama mwikuga lya ŵandu ŵalunda.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.31",
            "verseOrgIds": [
              "PRO.15.31"
            ]
          }
        }
      ]
