          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wa mundu jwambone ukusiwuganicisya yakwanga, nambo mkamwa mwa mundu jwakusakala mukusimugamba kopoka maloŵe gakusakalape basi.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.28",
            "verseOrgIds": [
              "PRO.15.28"
            ]
          }
        }
      ]
    },
