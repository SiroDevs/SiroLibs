              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwajogopa AMBUJE kukusikumjiganya mundu lunda, soni kulinandiya ni kucimbicisya, kulinandiya ni kuli kwakupunda mnope kuŵa pasogolo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.33",
            "verseOrgIds": [
              "PRO.15.33"
            ]
          }
        }
