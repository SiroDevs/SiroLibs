          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwanga mwakwenela kukusikumsangalasya mundu, nambo soni maloŵe gambone gakuŵecetedwa pa ndaŵi jambone gakusasangalasya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.23",
