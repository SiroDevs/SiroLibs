          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtima wa mundu jwakupikanicisya cenene yindu ukusasosa nditu kumanyilila yejinji, nambo mkamwa mwa ŵandu ŵakuloŵela mukusajikutila ni ya usilu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.14",
            "verseOrgIds": [
              "PRO.15.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
