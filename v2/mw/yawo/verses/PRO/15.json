          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumulika kwa meso kukusikusangalasya mtima, soni utenga wambone ukusiwumlimbikasya mundu.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.30",
            "verseOrgIds": [
              "PRO.15.30"
            ]
          }
        }
