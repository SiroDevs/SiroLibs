          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akusaŵa kwakutalicila ni ŵandu ŵakusakala, nambo akusapikana lipopelo lya ŵandu ŵakulungama.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.29",
            "verseOrgIds": [
              "PRO.15.29"
            ]
