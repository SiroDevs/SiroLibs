          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakusoŵa msyungu nganisyo syakwe sikusajonasika, nambo pati atupile apungu, yakuyiganicisya kuyitenda yikusakomboleka kusyene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.15.22",
            "verseOrgIds": [
              "PRO.15.22"
            ]
          }
