          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakumsisinila meso mwakunyenga, akusayicisya yisawusyo, jwakwamuka mwakulimba mtima, akusayicisya mtendele.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.10",
            "verseOrgIds": [
              "PRO.10.10"
            ]
