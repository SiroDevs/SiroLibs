          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵalunda akusasunga umanyilisi, nambo pakamwa pa mundu jwakuloŵela pakusajonanga mwangakaŵilisya.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.14",
            "verseOrgIds": [
