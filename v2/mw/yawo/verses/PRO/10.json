          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwa mtima wa lunda, akusasamalila malamusi, nambo cisilu cikusagamba kuŵecetesya, ticicijonasika.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.8",
            "verseOrgIds": [
              "PRO.10.8"
            ]
          }
