              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa pa mundu jwa umanyilisi pakusakopoka ya lunda, nambo cikoti ngasicityoka pa mgongo pa ŵandu ŵakuloŵela.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.13",
