              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakamwa pa mundu jwambone ni uliŵa wa umi, nambo pakamwa pa mundu jwakusakala pakusasisa yandewo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.11",
