        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.6",
            "verseOrgIds": [
              "PRO.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PRO 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwambone, acimjakwe tacimkumbucila ni mitima jakusangalala, ngasaliŵalicika, nambo lina lya mundu jwakusakala, tiyicimala mpela cindu cewole.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.7",
            "verseOrgIds": [
              "PRO.10.7"
            ]
          }
        }
      ]
    },
    {
