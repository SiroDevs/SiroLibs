              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aji ni misyungu ja Solomoni:",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwalunda akusiŵasangalasya babagwe, nambo mwanace jwakuloŵela akusiŵatesya canasa mamagwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PRO 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.1",
            "verseOrgIds": [
              "PRO.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PRO 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cipanje cakupata mwawiyi, cangatamilisya, nambo cilungamo cikusamkulupusya mundu ku ciwa.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.10.2",
            "verseOrgIds": [
              "PRO.10.2"
            ]
          }
        }
      ]
    },
    {
