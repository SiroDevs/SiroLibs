          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msewo wa mundu jwakulungama ukusaŵambala yakusakala, mundu jwakulolecesya cenene kwakuja akusasunga umi wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.17",
            "verseOrgIds": [
              "PRO.16.17"
            ]
          }
        }
      ]
    },
