          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.16.13",
            "verseOrgIds": [
              "PRO.16.13"
            ]
          }
        },
        {
