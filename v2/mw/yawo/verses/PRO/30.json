          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pana yindu yitatu yayikusajenda mwamacili, cinyacinya: pana yindu yitatu yayikusajenda mwakupocela: ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.29",
            "verseOrgIds": [
              "PRO.30.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PRO 30:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisimba lyalikwete macili kupunda yinyama yosope, soni ngalikusatila cinyama cilicose. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.30",
            "verseOrgIds": [
              "PRO.30.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "PRO 30:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tambala jwakwenda mwamacili, cinyacinya, ni tonde, soni mwenye jwakwenda mtima uli m'malo pasikati ja ŵandu ŵakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.31",
            "verseOrgIds": [
              "PRO.30.31"
            ]
          }
        }
      ]
