            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.23",
            "verseOrgIds": [
              "PRO.30.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PRO 30:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pana yindu mcece yayinandinandi pa cilambo capasi, nambo yili yakalamuka kwakupundanganya: ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.24",
            "verseOrgIds": [
              "PRO.30.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PRO 30:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbamba sili mpela ŵandu ŵangali macili, nambo sikusalinganyicisya cilepe yakulya yakwe m'cawu. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.25",
            "verseOrgIds": [
              "PRO.30.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PRO 30:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Njecele sili mpela ŵandu ŵangali macili, nambo sikusalinganya nyumba syakwe mkati mwa maganga. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.26",
            "verseOrgIds": [
              "PRO.30.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PRO 30:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sombe nganijikola mwenye, nambo syosope sikutama m'mipingo pakwenda. ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.27",
            "verseOrgIds": [
              "PRO.30.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PRO 30:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pulundwe komboleka kumkamula m'myala, nambo akusatama m'majumba ga ayimwene.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.30.28",
            "verseOrgIds": [
              "PRO.30.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
