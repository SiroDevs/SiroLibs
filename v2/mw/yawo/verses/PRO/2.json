{
  "id": "PRO.2",
  "number": "2",
  "bookId": "PRO",
  "reference": "Mis 2",
  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
