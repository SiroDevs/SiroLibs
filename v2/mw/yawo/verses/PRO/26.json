              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto ukusasima naga sasu sisoŵile, myoyo soni ku malo kwele kuli jwa unami kukusaŵa kwangali ya ndewo.",
          "type": "text",
          "attrs": {
