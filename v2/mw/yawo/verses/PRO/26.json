          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PRO 26:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwaulesi akusalinyenga kulitenda jwalunda, kupunda ŵandu msano ni ŵaŵili ŵampaka apakombole kwanga mwakalamuka.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.16",
            "verseOrgIds": [
              "PRO.26.16"
            ]
          }
        }
      ]
    },
