          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakusagamba kwinjilila nawo mu ndewo jamkanijimŵandika kose, ali mpela mundu jwakwamba kulijigalila m'mbwa jajigamba kulijendela pakujiwutaga mapikanilo.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.17",
            "verseOrgIds": [
              "PRO.26.17"
            ]
          }
        }
      ]
