        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.13",
            "verseOrgIds": [
              "PRO.26.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela litanga likusagalawucila aku naku m'mayinjesi gakwe, myoyo peyo soni ni mwakusatendela mundu jwaulesi, akusagambaga kutamila kuligalawusya pa cindanda cakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PRO 26:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.14",
            "verseOrgIds": [
              "PRO.26.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PRO 26:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwaulesi pati apisisye mkono wakwe mu mbale, ukusamsitopa kulepela kuti awucisye uyicile kukamwa kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "PRO.26.15",
            "verseOrgIds": [
              "PRO.26.15"
            ]
          }
        }
      ]
    },
    {
