              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.19",
            "verseOrgIds": [
              "2KI.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlonda jwakwima pa cipilala jula, ŵajile kumsalila soni Mwenye Yolamu kuti, “Mundu jwamtenga jwaŵili jula ajile kwayika ŵandu ŵala soni, nambo ngakuwuja. Nambo kwendesya kwa ligeleta kwa mundu jwakulongolela likugalyo kuli kwa masoka, mpela mwakusajendecesya Yehu mula.”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.9.20",
            "verseOrgIds": [
              "2KI.9.20"
            ]
          }
        }
      ]
    },
