          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yindu yine yosope yiŵayitesile Menahemu ali mwenye, yilembedwe m'buku ja Mbili ja Ayimwene ŵa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.21",
            "verseOrgIds": [
              "2KI.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Menahemu ŵawile, nipo Peka mwanace jwakwe ŵajinjile ucimwene m'malo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.22",
            "verseOrgIds": [
              "2KI.15.22"
            ]
          }
        }
      ]
    },
