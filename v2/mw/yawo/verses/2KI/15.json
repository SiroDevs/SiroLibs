                "loc": "ISA.6.1"
              },
              "items": [
                {
                  "text": "Yes 6:1",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sakaliya mwenye jwa ku Isalaeli",
          "type": "text"
        }
