          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcaka ca 20 ca ucimwene wa Mwenye Yotamu mwanace jwa Usiya mpela mwenye jwa ku Yuda, Hosheya mwanace jwa Ela ŵamtendele malindi Mwenye Peka, ni ŵamwuleje. Nipo Hosheyajo ŵajinjile ucimwene m'malo mwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.30",
            "verseOrgIds": [
              "2KI.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gane gaŵatesile Peka pa ucimwene wakwe, yilembedwe m'buku ja Mbili ja Ayimwene ŵa ku Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.31",
            "verseOrgIds": [
              "2KI.15.31"
            ]
          }
        }
