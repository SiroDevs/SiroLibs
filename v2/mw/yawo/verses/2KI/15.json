        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaliya, mwanace jwa Amasiya ŵajinjile ucimwene wa ku Yuda, mcaka ca 27 ca ucimwene ŵa Yelobowamu, mwenye jwa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.1",
            "verseOrgIds": [
              "2KI.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju ŵajinjile ucimwenewu ali ni yaka 16 yakupagwa, ni ŵalamulile kwa yaka 52 ku Yelusalemu. Mamagwe ŵaliji Yekoliya ŵa ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.2",
            "verseOrgIds": [
              "2KI.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaliya ŵatesile yakulungamika pameso pa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.3",
            "verseOrgIds": [
              "2KI.15.3"
            ]
          }
        },
        {
          "text": " mpela muŵatendelaga babagwe Amasiya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.3",
            "verseOrgIds": [
              "2KI.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo nganapasulanya malo gaŵapopelelaga milungu ja cilendo. Ŵandu ŵaliji ciŵela mkutaga mbopesi ni kututumisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.4",
            "verseOrgIds": [
              "2KI.15.4"
            ]
          }
        },
        {
          "text": " pa malo gelego. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.4",
            "verseOrgIds": [
              "2KI.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵampele Mwenye Asaliya cilango ca ulwele ŵa matana umi wakwe wosope. Nginamkunda kuti atameje m'nyumba ja ucimwene, m'malo mwakwe ŵatamaga m'nyumba jajika, nipo Yotamu mwanace jwakwe ni juŵalolelaga liŵasa lya mwenyewo, soni ni juŵalamulilaga ŵandu ŵa mcilambomo m'malo mwa Mwenye Asaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.5",
            "verseOrgIds": [
              "2KI.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gane giŵatesile Mwenye Asaliya yilembedwe m'buku ja Mbili ja Ayimwene ŵa ku Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.6",
            "verseOrgIds": [
              "2KI.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asaliya ŵawile, nipo ŵamsicile m'malembe ga ucimwene mu msinda wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        },
        {
          "text": " Yotamu mwanagwe jwakwe ni juŵajinjile ucimwene m'malo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.7",
            "verseOrgIds": [
              "2KI.15.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
