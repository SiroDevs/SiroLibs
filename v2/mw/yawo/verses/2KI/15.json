              "2KI.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakaliya mwanace jwa Yelobowamu ŵajinjile ucimwene wa ku Isalaeli, mcaka ca 38 ca ucimwene wa Asaliya, mwenye jwa ku Yuda, nambo ŵagambile kulamulila kwa miesi msano ni umo ku Samaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.8",
            "verseOrgIds": [
              "2KI.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nombe najo jwalakwe, mpela acinangolo ŵakwe ŵosope, ŵalemwisye pameso pa AMBUJE. Nginayileka yakusakala yiŵayitendaga Mwenye Yelobowamu, mwanace jwa Nebati, juŵalongolele ŵandu ŵa ku Isalaeli kulemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.9",
            "verseOrgIds": [
              "2KI.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu mwanace jwa Yabeshi ŵamtendele malindi Sakaliya, nipo ŵamwulajile ku Ibuleyamu. Myoyo Shalumujo ŵajinjile ucimwene m'malo mwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.10",
            "verseOrgIds": [
              "2KI.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE ŵakwanilisye cilanga",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11+2KI.15.12",
            "verseOrgIds": [
              "2KI.15.11",
              "2KI.15.12"
            ]
          }
        },
        {
          "text": " ciŵaŵisile kwa Yehu, cakuti, “Ayimwene ŵakuyicisya mcece ŵa ku Isalaeli, tacityocela mwiŵasa lyenu.” Yindu yine yosope yiŵatesile mwenye Sakaliya, yilembedwe m'buku ja Mbili ja Ayimwene ŵa ku Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.15.11+2KI.15.12",
            "verseOrgIds": [
              "2KI.15.11",
              "2KI.15.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
