              "2KI.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Yesaya ŵamsalile Mwenye Hesekiya kuti, “Cilocesyo cakuti yele yindu tiyicitendekwa ni aci: Caka acino ni caka ca malaŵi timlye yakulya yakulimela jika. Nambo caka ca mtondo timcipanda mbeju syenu ni kugowola, ni timcipanda soni mipeleya ni kulya yisogosi yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.29",
            "verseOrgIds": [
              "2KI.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵatacikulupuka ni kusigala ŵa ku Yuda, tacisangalala mpela yakumela yayisimice miciga jakwe mkati mwa litaka, ni kusogola yisogosi yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.30",
            "verseOrgIds": [
              "2KI.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacipagwa ŵandu ŵatacikulupuka ni kusigala ku Yelusalemu ni Kwitumbi lya Siyoni. Ligongo AMBUJE ni ŵakusaka kuti yeleyi yitendekwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.31",
            "verseOrgIds": [
              "2KI.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Maloŵe ga AMBUJE gakusala ya mwenye jwa ku Asiliya ni gakuti, ‘Ngasajinjila mu msinda kapena kuponya mpamba uliwose mu msinda welewu. Asilikali ŵa ngondo ŵana yida ngasawuŵandicila. Ni ngasawunga lituto kusyungulila msindawo lyakulicenjela pa ngondo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.32",
            "verseOrgIds": [
              "2KI.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taciwujila kumangwawo ŵangajinjila mu msindawo, tacipitila litala liŵapitile pakwisa akuno. Une AMBUJE nguti myoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.33",
            "verseOrgIds": [
              "2KI.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une tinawutetele ni kuwucenjela wele msindawu, kwa ligongo lya une namsyene ni kwa cilanga cinapangene ni Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.34",
            "verseOrgIds": [
              "2KI.19.34"
            ]
          }
        },
        {
          "text": " jwakutumicila jwangu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.34",
            "verseOrgIds": [
              "2KI.19.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
