        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo cilo cakwe lilayika lya AMBUJE lyapite ku masakasa ga Asilikali ŵa ngondo ŵa ku Asiliya ni ŵawuleje asilikali 185,000. Nipo kundaŵi kwakwe ŵandu ŵagambile kwawona asilikali ŵa ngondo ŵa ku Asiliya ali ngundangunda, ali awile. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.35",
            "verseOrgIds": [
              "2KI.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2KI 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Senakelibu mwenye jwa ku Asiliya, ŵatyosile ni ŵawujile kumangwawo ni ŵaliji mkutama mu msinda wa Ninefe. ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.36",
            "verseOrgIds": [
              "2KI.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2KI 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line Mwenye Senakelibu piŵaliji mkupopela m'nyumba ja Nisiloki mlungu jwakwe, ŵanace ŵakwe ŵaŵili, Adilameleki ni Shalesa, ŵamwuleje ni mawupanga gawo, nipo ŵanacewo ŵatilile ku Alalati. Myoyo mwanace jwakwe jwine lina lyakwe, Esalahadoni, ŵajinjile ucimwene m'malo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.19.37",
            "verseOrgIds": [
              "2KI.19.37"
            ]
          }
        }
      ]
