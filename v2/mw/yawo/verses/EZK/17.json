          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi ni yakuŵeceta AMBUJE:",
          "type": "text",
          "attrs": {
            "verseId": "EZK.17.22",
            "verseOrgIds": [
              "EZK.17.22"
            ]
          }
        }
