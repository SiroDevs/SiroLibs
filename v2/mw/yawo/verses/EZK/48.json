          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kum'mwela, ulewu wakwe uli mamita 2,250, kuŵe yipata yitatu, Cipata ca Simiyoni, Cipata ca Isakala ni Cipata ca Sebuloni. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.33",
            "verseOrgIds": [
              "EZK.48.33"
            ]
          }
        },
