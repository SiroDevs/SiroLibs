            "number": "34",
            "style": "v",
            "sid": "EZK 48:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kungapilo lyuŵa, ulewu wakwe uli mamita 2,250, kuŵe yipata yitatu, Cipata ca Gadi, Cipata ca Asha ni Cipata ca Nafutali.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.48.34",
