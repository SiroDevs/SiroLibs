                "loc": "LEV.19.36"
              },
              "items": [
                {
                  "text": "Lef 19:36",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 45:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.10",
            "verseOrgIds": [
              "EZK.45.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Efa mlingo wa yindu yejumu ni bati mlingo wa yindu ya mesi yiŵe yakulandana. Mlingo wa homeli uŵe wakwanila ma efa likumi, uŵe soni wakwanila mabati likumi. Myoyo homeli ni mlingo wakwenela.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 45:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.11",
            "verseOrgIds": [
              "EZK.45.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mpimo wa sekeli uŵe magela makumi gaŵili nipo mlingo wa mina uŵe wakusitopa masekeli makumi msano ni limo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 45:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.12",
            "verseOrgIds": [
              "EZK.45.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Asi ni mbopesi simkwenela kupeleka: cimo mwa yindu 60 ya tiligu ni ya balele,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13+EZK.45.14+EZK.45.15",
            "verseOrgIds": [
              "EZK.45.13",
              "EZK.45.14",
              "EZK.45.15"
            ]
          }
        },
        {
          "text": " soni cimo mwa yindu 100 ya mawuta. Milingo jakwe jili myi: mabati likumi gakulandana ni homeli jimo kapena koli jimo. Mpelece ngondolo jimo pa likuga lya ngondolo 200 kutyocela ku maŵasa ga Aisalaeli. Mwelemu ni mucimcipelecelaga mbopesi sya tiligu, mbopesi syakutinisya nipo soni mbopesi sya mkamulano, ni syakupesya ligongo lya magambo ga ŵandu. Ni yinguti Une AMBUJE Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13+EZK.45.14+EZK.45.15",
            "verseOrgIds": [
              "EZK.45.13",
              "EZK.45.14",
              "EZK.45.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 45:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.13+EZK.45.14+EZK.45.15",
            "verseOrgIds": [
              "EZK.45.13",
              "EZK.45.14",
              "EZK.45.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 45:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŵandu wosope ŵa mcilambomo apeleceje yeleyi kwa mwenye jwa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.16",
            "verseOrgIds": [
              "EZK.45.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tigaciŵa masengo ga mwenye kupeleka mbopesi sya kutinisya, mbopesi sya tiligu, mbopesi sya yakumwa pa masiku ga cindimba, ni masiku gakupumula ga Ayuda nipo soni pa masiku gele Aisalaeli akusagasunga. Mwenyejo akusapeleka mbopesi sya syakupesya ligongo lya ulemwa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        },
        {
          "text": " mbopesi sya tiligu, mbopesi sya kutinisya ni mbopesi sya mkamulano, kuti syosope siŵe sya kupecesya ulemwa wa Aisalaeli.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cindimba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 45:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.17",
            "verseOrgIds": [
              "EZK.45.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 45:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Mlungu akuti, “Pa lisiku lyandanda lya mwesi wandanda, ajigaleje mwanace jwa ng'ombe jamkambako jwangali liŵasi ni kuja kutenda msyungu wakuswejesya Nyumba ja kupopelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.18",
            "verseOrgIds": [
              "EZK.45.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 45:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi tajigale miasi ja mbopesi jakupecesya ulemwa nipo ajipace pa felemu ja Nyumba jakupopelela, pa ndumba mcece sya malo gakupelecela mbopesi ni pa felemu jakwinjilila luŵala lwamkati. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.19",
            "verseOrgIds": [
              "EZK.45.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atendeje yeleyi pa lisiku lyamsano ni lyaŵili lya mwesi, kuti ŵapecesyeje ŵaliwose ŵiŵalemwisye mwangasaka kapena mwangamanyilila. Myoyo Nyumba jakupopelela tacijisunga jeswela.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.45.20",
            "verseOrgIds": [
              "EZK.45.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 45:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
