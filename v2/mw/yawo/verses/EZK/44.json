          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jwakutaga mbopesi akalisakasya pakukamula mundu jwam'we, nambo naga ali babagwe kapena mamagwe, mwanagwe jwamlume kapena jwamkongwe, mcimwene jwakwe kapena mlumbugwe jwangalombela, pelepo takombolece kulisakasya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.25",
            "verseOrgIds": [
              "EZK.44.25"
            ]
          }
        },
        {
          "name": "note",
