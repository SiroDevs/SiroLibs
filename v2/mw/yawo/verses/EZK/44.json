              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi akamwa finyo ndaŵi jakwinjila mluŵala lwamkati.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
