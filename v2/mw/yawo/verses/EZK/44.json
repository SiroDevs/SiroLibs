          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakasimanikwa jwakutaga mbopesi kulombela jwamkongwe jwa masije kapena jwawumasile ulombela wakwe; nambo alombeleje mwali jwangamanyilila jwamlume jwa mtundu wa Aisalaeli kapena jwamkongwe jwamasije jwa jwakutaga mbopesi mjakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.22",
            "verseOrgIds": [
