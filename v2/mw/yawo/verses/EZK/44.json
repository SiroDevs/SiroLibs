                  "text": "Lef 10:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.21",
            "verseOrgIds": [
              "EZK.44.21"
            ]
          }
