          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŵakutaga mbopesi ŵajiganyeje ŵandu ŵangu kulekangana kwa yindu yeswela ni yangaswejela, soni yindu yakwenela ni yangajenela kupeleka mbopesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "note",
