              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.10.10"
              },
              "items": [
                {
                  "text": "Lef 10:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.23",
            "verseOrgIds": [
              "EZK.44.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 44:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ukangani uli ubucile, ŵakutaga mbopesi tacilamulaga magambogo pakuya malamusi gangu. Asunjeje malamusi gangu pa masiku gangu gosope ga yindimba. Soni tasamaleje masiku gangu gakupumula kuti tigaŵe gamaswela.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.24",
            "verseOrgIds": [
              "EZK.44.24"
            ]
          }
        }
      ]
    },
