          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ŵakutaga mbopesi akwenela ngapata cindu cilicose, cakupata cawo ni Une. Soni akasiŵapa yipanje mu Isalaeli; Une ni cipanje cawo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.44.28",
            "verseOrgIds": [
              "EZK.44.28"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
