              "items": [
                {
                  "text": "Ciw 1:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.2",
            "verseOrgIds": [
              "EZK.43.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 43:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi yinguyiwona m'mesomkulolayi yili mpela yeyila yinayiweni yila ndaŵi jiŵayice Mlungu kukonanga Yelusalemu, nipo soni yaliji mpela yinayiweni ku Lusulo lwa Kebala. Myoyo naligwicisye pasi camakuku. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.3",
            "verseOrgIds": [
              "EZK.43.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ucimbicimbi wa Mlungu wajinjile m'Nyumba ja AMBUJE kupitila ku cipata ca kungopoko lyuŵa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 43:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.4",
            "verseOrgIds": [
              "EZK.43.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 43:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msimu wa AMBUJE wanyakwile une ni kunjinjisya mluŵala lwamkati, nipo ucimbicimbi wa AMBUJE wagumbele m'nyumba jakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.5",
            "verseOrgIds": [
              "EZK.43.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 43:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jula ŵajimi pambali pangu, nipo nampikene jwine alimkumbecetekasya kutyocela m'Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.6",
            "verseOrgIds": [
              "EZK.43.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 43:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasalile kuti, “M'mwe mwanace jwa mundu, malo gano ni malo ga citengu ca ucimwene wangu, malo gele gingusaliŵataga ni sajo syangu. Akuno ni kwele kucinjitama ni ŵandu ŵangu Aisalaeli mpaka kalakala. Jemanjajo atamose ayimwene ŵawo ngasalisakasya lina lyangu lyeswela pakuŵa ŵangakulupilila kapena pakusika mitembo ja ayimwene ŵawo kuyikwesya ya kupopelela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.7",
            "verseOrgIds": [
              "EZK.43.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 43:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵaga ciwundo cawo pakuŵandikana ni cangu nipo soni mafelemu gawo pakuŵandikana ni gangu, mwamti pagambile kuŵa lipupa pasikati pa jemanjajo ni Une. Myoyo ŵasakasyaga lina lyangu lyeswela ni yakusakala yiŵatendaga. Ni najonasile ndili ndumbile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.8",
            "verseOrgIds": [
              "EZK.43.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano alece kulambila milungu jine ni kutyosya mitembo ja ayimwene ŵawo. Pelepo Une tinjitama sikati jawo mpaka kalakala.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 43:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.9",
            "verseOrgIds": [
              "EZK.43.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 43:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo AMBUJE ŵapitilisye kuti, “M'mwe mwanace jwa mundu, mwasalile Aisalaeli ya Nyumba ja AMBUJEJI, nipo alole utaŵidwe wakwe ni uwonece wakwe kuti atende soni ni ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.10",
            "verseOrgIds": [
              "EZK.43.10"
            ]
          }
        },
        {
          "text": " wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.10",
            "verseOrgIds": [
              "EZK.43.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 43:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitatende sonipo ni yindu yiŵatesile, mwasalile ya Nyumba ja AMBUJE ni uwonece wakwe, milango jakwe jakopocela ni kwinjilila, ya kawonece kakwe kosope ni kataŵidwe kakwe kosope. Mwasalile malamusi ni yakutenda yakwe, nipo mgalembe jemanjajo ali mkulola kuti agakumbucileje ni kugakuyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.11",
            "verseOrgIds": [
              "EZK.43.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni lilamusi lya Nyumba ja AMBUJE jele jitijicitaŵidwa penani petumbi. Malo gosope gakusyungulila Nyumbajo tigaciŵa gamaswela mnope. Lyeleli ni lilamusi lya Nyumba ja AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Malo gakupelecela mbopesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 43:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.12",
            "verseOrgIds": [
              "EZK.43.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 43:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aji ni mipimo ja ku malo gakupelecela mbopesi, pakuya mipimo josope jila jele jiŵalinjila Nyumba ja AMBUJE. Pasi pakwe tipaciŵa ngalande ja masentimita makumi msano kusokoka kwakwe, myoyo soni mcijipi mwakwe. Mu ngomo mwa ngalandemo timuciŵa masentimita 25.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.27.1+EXO.27.2"
              },
              "items": [
                {
                  "text": "Eks 27:1-2",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.4.1"
              },
              "items": [
                {
                  "text": "2 Mbi 4:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.13",
            "verseOrgIds": [
              "EZK.43.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 43:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo gakupelecela mbopesi msingu wakwe uciŵa myi: kutyocela penani mpaka pa citandala capasi mita jimo, mcijipi mwakwe hafu mita. Kutyocela pa citandala cacinondi mpaka ku citandala cacikulungwa, msingu wakwe uciŵa mamita gaŵili, mcijipi mwakwe timuciŵa masentimita msano. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.14",
            "verseOrgIds": [
              "EZK.43.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 43:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pacanya pelepa, pele mbopesi jikusajocedwa, msingu wakwe tiwuciŵa mamita gaŵili. Penani pakwe pacikopoka misengo mcece jajilewu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.15",
            "verseOrgIds": [
              "EZK.43.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 43:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pacanya pa malo gakupelecela mbopesigo mcilewu ni mcijipi mwakwe ticiciŵa mamita msano ni limo, myoyo tiyiciŵa yakulandana mbali syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.16",
            "verseOrgIds": [
              "EZK.43.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Citandala capasikati ticiciŵa mamita msano ni gaŵili mcilewu mwakwe nipo soni mamita msano ni gaŵili mcijipi mwakwe, mbali syakwe syosope mcece. Nipo mkombelo wakwe uciŵa masentimita 25 msingu wakwe. Ngalande ja pasi pakwe pa malo gakupelecela mbopesigo jiciŵa masentimita makumi msano, nipo masitepe ga malo gakupelecela mbopesi tigacilola kungopoko lyuŵa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Msyungu wakuswejesya malo gakupelecela mbopesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 43:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.17",
            "verseOrgIds": [
              "EZK.43.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 43:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Mlungu ŵaŵecete ni une kuti, “M'mwe mwanace jwa mundu, aga ni malamusi gakwe ga malo gakupelecela mbopesi: Pa lisiku lyele malo gelega gataŵidwe kuti apelecele mbopesi jakutinisya ni kumisila miasi pelepo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.18",
            "verseOrgIds": [
              "EZK.43.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 43:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ŵa mtundu wa Lefi ŵa liŵasa lya Sadoki, ni ŵitaciyikaga pakuŵandika kukundumicilaga Une. Ni yinguti Une AMBUJE Mlungu. Timwape mwanace jwa ng'ombe jamkambako kuti apelece mbopesi ja kupecesya ulemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.19",
            "verseOrgIds": [
              "EZK.43.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 43:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timjigale miasi ni timjipakasye pa misengo mcece jili m'makona ga citandala ca malo gakupelecela mbopesi nipo soni kusyungulila makona ga m'malile mwakwe. Myoyo timgaswejesye malo gakupelecela mbopesigo ni kugapa upile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.20",
            "verseOrgIds": [
              "EZK.43.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 43:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko timjigale ng'ombe jamkambako japelecedwe mbopesi ja kupecesya ulemwa. Timjijoce pa malo gakwegakwepe gagali ga Nyumba ja AMBUJE, kusa kwa malo gamaswela. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.21",
            "verseOrgIds": [
              "EZK.43.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 43:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lyaŵili timkapelece tonde jwangali liŵasi, kuti nombe najo akaŵe mbopesi jakupecesya ulemwa. Timswejesye malo gakupelecela mbopesigo ni miasi jakwe mpela mumwatendele ni ng'ombe jamkambako mula. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.22",
            "verseOrgIds": [
              "EZK.43.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 43:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mli m'malisisye kuswejesya malo gakupelecela mbopesigo, timpelece ng'ombe jamkambako jangali liŵasi ni ngondolo jamkambako jangali liŵasi ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.23",
            "verseOrgIds": [
              "EZK.43.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 43:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni timjipeleceje pameso pa AMBUJE, nipo jwakutaga mbopesi tataje njete ni kupeleka kuti yiŵe mbopesi ja kutinisya kwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.24",
            "verseOrgIds": [
              "EZK.43.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lililyose pa masiku msano ni gaŵili mpeleceje tonde, ng'ombe ja mkambako ni ngondolo ja mkambako, kupeleka mbopesi syakupecesya ulemwa. Yosope yiŵe yangali yilema. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa masiku msano ni gaŵili tatende msyungu wakuswejesya malo gakupelecela mbopesi, ni kugapelaka kwa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 43:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masiku gelego gali gamasile, kutandila lisiku lya msano ni gatatu mpaka msogolo mwakwe, ŵakutaga mbopesi tacipelekaga pa malo kutajila mbopesigo mbopesi syenu syakutinisya nipo soni mbopesi syenu sya mkamulano. Pelepo tinjimpocela. Ni yinguti Une AMBUJE Mlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.27",
            "verseOrgIds": [
              "EZK.43.27"
            ]
          }
        },
