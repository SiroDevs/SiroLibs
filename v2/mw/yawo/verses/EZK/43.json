        "style": "s1"
      },
      "items": [
        {
          "text": "AMBUJE akuwujila ku Nyumba jawo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 43:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe mundu jula ŵanjigalile ku cipata cicalolite kungopoko lyuŵa, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.1",
            "verseOrgIds": [
              "EZK.43.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 43:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo kweleko nawuweni ucimbicimbi wa Mlungu jwa Aisalaeli uli mkutyocela kungopoko lyuŵa. Nipo liloŵe lya Mlungu lyaliji mpela mkokomo wa matumbela m'nyasa, nipo cilambo capasi caŵasile ni ucimbicimbi wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.2",
            "verseOrgIds": [
              "EZK.43.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
