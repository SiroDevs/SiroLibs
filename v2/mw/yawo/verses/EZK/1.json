          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pasi pa msakasa wakunyesimilawo pajimi yiwumbeyo, cilicose catambasukwile mapapiko gakwe kucijakwe cakuŵandikana naco ni kuwunicila cilu cakwe ni mapapiko gaŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.23",
            "verseOrgIds": [
              "EZK.1.23"
            ]
          }
        },
        {
          "name": "verse",
