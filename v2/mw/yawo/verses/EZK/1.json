            "number": "24",
            "style": "v",
            "sid": "EZK 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Katema kiyagulukaga, napikene lisegwe lya mapapiko gakwe mpela mkokomo wa mesi gejinji gakuwutuka mnope, mpela lisegwe lya likuga lya asilikali ŵangondo, mpela liloŵe lya AMBUJE Mlungu. Ndaŵi jiyalekaga guluka, yagwisyaga mapapiko gakwe,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.1.24",
            "verseOrgIds": [
              "EZK.1.24"
            ]
          }
        },
