            "verseId": "EZK.9.10",
            "verseOrgIds": [
              "EZK.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mundu juŵawete yakuwala ya bafuta jula ŵayice ni kwasalilaga AMBUJE kuti, “Ndesile yele yiŵandumile yila.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.9.11",
            "verseOrgIds": [
              "EZK.9.11"
            ]
          }
        }
      ]
