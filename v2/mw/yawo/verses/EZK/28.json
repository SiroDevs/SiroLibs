              "EZK.28.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 28:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'mwe mwanace jwa mundu, mjawule ku msinda wa Sidoni, ni mkajile kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.21",
            "verseOrgIds": [
              "EZK.28.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 28:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Mlungu akuti, Une ndili m'magongo jwenu, m'mwe Sidoni, soni ŵandu tacinjimbicisya pitaciyiwona yitinjimtenda m'mwejo. Tacimanyilila kuti Une ni Mlungu, patinjimpa cilango soni pakulosya kuti Une ni jwamswela pasikati pawo. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.22",
            "verseOrgIds": [
              "EZK.28.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 28:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimtumicisya yilwele soni m'misewu jenu mucijilimaga miasi. Ngondo tijicimsungulila mbali syosope, soni ŵandu ŵenu tacimala kuwulajidwa. Pelepo timcimanyilila kuti Une ni AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.28.23",
            "verseOrgIds": [
              "EZK.28.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isalaeli tacikola upile",
          "type": "text"
        }
      ]
    },
    {
