        "style": "s1"
      },
      "items": [
        {
          "text": "Ya cilango ca Aiguputo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lya likumi ni gaŵili lya mwesi wa likumi caka ca likumi ca ukapolo, AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "text": " ŵaŵecete ni une.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.29.1",
            "verseOrgIds": [
              "EZK.29.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
