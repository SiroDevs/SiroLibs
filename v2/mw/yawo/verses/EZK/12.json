            "number": "24",
            "style": "v",
            "sid": "EZK 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Myoyo ngasigawoneka soni mesomkulola ga unami kapena kutenda cisango ca unami pasikati pa Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.24",
            "verseOrgIds": [
              "EZK.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une AMBUJE tinjiŵeceta ni jemanjajo, soni yiticinjiŵeceta yiticitendecekwa. Ngasiyikokoŵa soni iyayi, nambo masiku genu pega, Une tinjiŵeceta ni jemanja ŵandu ŵakwimucila, soni tinjiyitenda kusyene.” Ni yinguti Une AMBUJE Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.25",
            "verseOrgIds": [
              "EZK.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
