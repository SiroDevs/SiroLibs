          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.12.23",
            "verseOrgIds": [
              "EZK.12.23"
            ]
          }
        },
        {
          "name": "verse",
