            "sid": "EZK 37:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo ŵandu ŵa mitundu jine",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
            "verseOrgIds": [
              "EZK.37.28"
            ]
          }
        },
        {
          "text": " tacimanyilila kuti Une AMBUJE, natesile Aisalaeli kuŵa ŵaswela ligongo lyakuti Nyumba jangu jili pasikati pawo mpaka kalakala.”",
          "type": "text",
          "attrs": {
            "verseId": "EZK.37.28",
