              "EZK.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligasalyo lyatambasukwile cipukutu ca yakulembedwayo, ni naciweni cipukutu cosopeco kuti caliji celembe mbali syosope. Maloŵe gigalembedwe mwelemo galiji ga yidandawulo, ga malilo ni gakulila ligongo lya yipwetesi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.10",
