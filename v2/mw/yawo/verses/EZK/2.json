              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“M'mwe mwanace jwa mundu, mpikanile yingumsalilayi. Kasimŵa ŵakwimucila mpela jemanjajo. Mjasame kukamwa ni mlye yele yitinampeje m'mwejo.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.8",
            "verseOrgIds": [
              "EZK.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naliweni ligasa lili lilondite une, nipo lyakamulile cipukutu ca yakulembedwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.9",
            "verseOrgIds": [
              "EZK.2.9"
            ]
          }
        },
