              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambo m'mwe mwanace jwa mundu, mkasimwajogopa jemanjajo kapena yiliyose yitakaŵecete. Takamnyosye ni kumnandiya m'mwejo; timkaŵe mpela mli pasikati pa yiŵalaŵala. Nambope kasimwajogopa ŵandu ŵakwimucilawo kapena kogopa yiliyose yakuŵeceta. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.6",
            "verseOrgIds": [
              "EZK.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkasalile jemanjajo cilicose cinamtumile kuti mkaŵecete, kanga takapikanile kapena iyayi. Mkumbucile mwakusaŵela ŵandu ŵakwimucila.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.2.7",
            "verseOrgIds": [
              "EZK.2.7"
            ]
          }
        }
      ]
    },
