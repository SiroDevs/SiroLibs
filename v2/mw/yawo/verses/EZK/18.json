                "loc": "JER.31.29"
              },
              "items": [
                {
                  "text": "Yel 31:29",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Elo, une Mlungu jwa umi,” ni yakuti AMBUJE Mlungu, “Ngasimkamulisya soni masengo citagu celeci mu Isalaeli.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.3",
            "verseOrgIds": [
              "EZK.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umi uliwose wa mundu uli wangu, umi wa nangolo kwika soni wa mwanace. Mundu jwakulemwa ni jutaciwa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.4",
            "verseOrgIds": [
              "EZK.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tuwanicisye kuti pana mundu jwambone, jwakulungamika ni kulupicika. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.5",
            "verseOrgIds": [
              "EZK.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe jwangalambila milungu jine ja Aisalaeli kapena kulya nyama jakupelecedwa ku matumbi gakulambila. Jwangasakasya jwamkongwe jwa jwine mundu kapena kutama malo gamo ni jwamkongwe jwakulwala ulwele wa kumwesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.6",
            "verseOrgIds": [
              "EZK.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwangalambusya kapena kumjiŵila mundu jwalijose soni ndaŵi syosope akusawusya cilicose ciŵajigele kwa jwangongole kuti tapelece ngongole jakwe, akusiŵapa yakulya ŵasala ni kwapa yakuwala ŵakulaga. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.7",
            "verseOrgIds": [
              "EZK.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakusakongosya mbiya kuti apate mbiya syakonjecesya. Akusakana kutenda yakusakala nipo akusaŵeceta magambo pangamjimila mundu jwalijose kunyuma. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.8",
            "verseOrgIds": [
              "EZK.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jweleju akusagapikanila ni kugasunga malamusi gangu. Jwalakweju ali jwakulungama, soni taciŵa ni umi,” ni yakuti AMBUJE Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.18.5"
              },
              "items": [
                {
                  "text": "Lef 18:5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.9",
            "verseOrgIds": [
              "EZK.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tuwanicisye mundu jweleju ni kuŵeleka mwanace jwele masengo gakwe ni wiyi soni kuwulaga ŵandu, jwele jwakusatenda yindu yejinji, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.10",
            "verseOrgIds": [
              "EZK.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "yele babagwe yinganatendeje. Jwalakwe akusalya nyama jakupelecedwa ku malo gakulambila soni akusasakasya jwamkongwe jwa jwine jwamlume, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.11",
            "verseOrgIds": [
              "EZK.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "akusiŵalagasya ŵakulaga, kwajiŵila yindu, soni jwangawusya cindu ca cilangano kwa jwangongole. Akusagalawucila kwa milungu jine ni kutendaga yakunyalaya. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.12",
            "verseOrgIds": [
              "EZK.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusakongosya kuti apate mbiya sine syakupwaticila penani. Ana mundu jweleju mpaka aŵe ni umi? Iyayi, ngasaŵa ni umi. Ligongo ŵatesile yakusakala yosopeyi, myoyo taciwa, celeci ni cilango cakumŵajila jwalakwejo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.13",
            "verseOrgIds": [
              "EZK.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Tuwanicisye mundu jwakusakala jula ni kuŵeleka mwanace jwele juŵawuweni ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        },
        {
          "text": " wa babagwe, ni ngatenda yiŵatendaga babagwe yila. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.14",
            "verseOrgIds": [
              "EZK.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwangalambila milungu jine ja Aisalaeli kapena kulya nyama jakupelecedwa ku malo gakulambila gakwela mnope. Soni jwangasakasya jwamkongwe jwa jwine jwamlume kapena ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.15",
            "verseOrgIds": [
              "EZK.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "kumlagasya mundu jwalijose kapena kumjiŵila mundu jwalijose. Akusamwucisya mundu jwangongole cindu ca cilangano cakusapeleka kwa jwalakwe. Akusiŵalisya ŵa sala ni kwaweca ŵa usawuci. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.16",
            "verseOrgIds": [
              "EZK.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusakana kutenda yakusakala ni ŵangakongosya mbiya kuti apate mbiya sine syakonjecesya. Akusagasunga ni kugapikanila malamusi gangu. Mundu jwamti myiyi ngasawila ulemwa wa babagwe, nambo taciŵa nditu ni umi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.17",
            "verseOrgIds": [
              "EZK.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo babagwe, pakuti ŵalemwisye pakwalagasya ŵandu ŵane ni kumjiŵila mlongo mjawo ni soni kumtendela yakusakala mundu jwalijose, myoyo taciwila ulemwa uŵawutesile asyene pewo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.18",
            "verseOrgIds": [
              "EZK.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mwine mpaka awusye kuti, ‘Ligongo cici mwanace jwangapocela cilango pa ulemwa wa babagwe?’ Mwanacejo jwatendaga yakulungamika ni yambone. Jwasungaga ni kugapikanila malamusi gangu, myoyo mwanacejo taciŵa ni umi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.19",
            "verseOrgIds": [
              "EZK.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwakulemwa ni jutaciwa, ngaŵa jwine. Mwanace ngasalaga ligongo lya ulemwa wa babagwe, soni baba ngasalaga ligongo lya ulemwa wa mwanace jwakwe. Mundu jwambone tacipocela mbote ja umbone wakwe, soni mundu jwakusakala tacipocela mbote ja kusakala kwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.20",
            "verseOrgIds": [
              "EZK.18.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.24.16"
              },
              "items": [
                {
                  "text": "Det 24:16",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.20",
            "verseOrgIds": [
              "EZK.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga mundu jwakulemwa akuleka ulemwa wakwe uŵatendaga, ni kupikanilaga malamusi gangu gosope, ni kutendaga yakulungamika ni yambone, nditu jwalakwejo taciŵa ni umi, ngasawa. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.21",
            "verseOrgIds": [
              "EZK.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ulemwa wakwe wosope tiwucikululucidwa, nipo taciŵa ni umi ligongo lyakutenda yindu yambone. ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.22",
            "verseOrgIds": [
              "EZK.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana mkuganisya kuti ngusasangalala ndili kumwona mundu jwakulemwa ali mkuwa?” AMBUJE ŵawusisye. Iyayi, ngasangalele kumwona jwakulemwa ali alesile ulemwa wakwe ni kuŵa ni umi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.23",
            "verseOrgIds": [
