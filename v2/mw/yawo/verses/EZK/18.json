          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "text": " ŵaŵecete ni une kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.1",
            "verseOrgIds": [
              "EZK.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ana ligongo cici ŵandu ŵa ku Isalaeli mkusanonyela kuwilisyawilisya citagu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        },
        {
          "text": " cakuti,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.18.2",
            "verseOrgIds": [
              "EZK.18.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
