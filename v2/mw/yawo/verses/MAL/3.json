            "sid": "MAL 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Ŵamaciligosope akuŵeceta kuti, “Tinjitumisya jwamtenga jwangu kuti akalinganyisye une litala. Kaneko mwacisisimucisya AMBUJE ŵimkwasosasosawo taciyika ku Nyumba jakwe. Jwamtenga jumkusosa kumwonajo taciyika ni kulalicila ya cilanga",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "text": " cangu.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.1",
            "verseOrgIds": [
              "MAL.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
