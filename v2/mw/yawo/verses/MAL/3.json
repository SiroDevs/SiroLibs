                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "14:22-29",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NEH.13.12"
              },
              "items": [
                {
                  "text": "Neh 13:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.10",
            "verseOrgIds": [
              "MAL.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAL 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjilekasya tuyilombo kuti tukalya mbeju syenu, mipeleya jenu ngasijileka kusogola. Ni yinguti Une AMBUJE Ŵamaciligosope. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.11",
            "verseOrgIds": [
              "MAL.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵandu ŵa mitundu josope tacimkolanga jemanja ŵajaliwe, ligongo cilambo cenu ticiciŵa cambone kutama. Ni yinguti une AMBUJE Ŵamaciligosope.",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cilanga ca canasa ca Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAL 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.12",
            "verseOrgIds": [
              "MAL.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAL 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mŵecete maloŵe gakupweteka kwa une,” ni yikuti une AMBUJE. “Nambo mkusati, ‘Ana twaŵecetele cici?’ ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.13",
            "verseOrgIds": [
              "MAL.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAL 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mŵecete kuti, ‘Kwatumicila AMBUJE kuli kwangali mate. Ana pana cici cakupata pakuya malamusi ga Mlungu Jwamaciligosope ni kulosyaga canasa pameso pakwe pa yele yitutesile uwe? ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.14",
            "verseOrgIds": [
              "MAL.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo uwe tukuganisya kuti ŵandu ŵakulikwesya ni ŵali ŵakusangalala. Ŵandu ŵakutenda yakusakala ni yindu yangajenela cenene, nambo akusakulinga kuwusimana mtima kwa Mlungu pakutenda yindu yakusakala, atamose amtande Mlungu akusakulupuka nditu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAL 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.15",
            "verseOrgIds": [
              "MAL.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAL 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano ŵandu ŵiŵajogopaga AMBUJE ŵatandite kuŵecetana, nipo AMBUJE ŵapikanilaga. Buku jacikumbukumbu jalembedwe pameso pakwe, jakusala ya ŵele ŵandu uŵajogopaga AMBUJE ni kulicimbicisya lina lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.16",
            "verseOrgIds": [
              "MAL.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAL 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Ŵamaciligosope akuti, “Ŵandu ŵelewo taciŵa ŵangu, taciŵa ŵanguŵangupe ŵakunonyelwa pa lisiku litinjilipanganya. Tinjatendela canasa mpela baba akusamtendela canasa mwanagwe jwamlume jwakusamtumicila jwalakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.17",
            "verseOrgIds": [
              "MAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo timcilekanganya pasikati pa ŵandu ŵakulungama ni ŵangalumbana, pasikati pa ŵandu ŵakutumicila Mlungu ni ŵangamtumicila.”",
          "type": "text",
          "attrs": {
            "verseId": "MAL.3.18",
            "verseOrgIds": [
              "MAL.3.18"
            ]
          }
        }
      ]
    }
  ],
