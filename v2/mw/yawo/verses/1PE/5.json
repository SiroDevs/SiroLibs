              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.11",
            "verseOrgIds": [
              "1PE.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1PE 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumlembela jemanja cikalataci mwakata mwakamucisidwa ni Sila. Ngusinamwona jwalakwejo kuti mjetu mwa Ambuje jwakulupicika. Sambano sosile kumlimbisya mtima jemanja ni kutendela umboni wakuti umbone mtima usyesyene wa Mlungu ni welewu. Ligongo lya umbone mtimawo, limbicilani.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.12",
            "verseOrgIds": [
              "1PE.5.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
