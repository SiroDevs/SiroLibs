          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtendele uwe pa jemanja ŵimli ŵakwe ŵa Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "1PE.5.14",
