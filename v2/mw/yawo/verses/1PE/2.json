                "loc": "EXO.19.5+EXO.19.6"
              },
              "items": [
                {
                  "text": "Eks 19:5-6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.43.20"
              },
              "items": [
                {
