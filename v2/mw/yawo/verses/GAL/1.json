              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko nganinamwona ndumetume jwalijose akaŵe Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.19",
            "verseOrgIds": [
              "GAL.1.19"
            ]
          }
        },
        {
          "text": " mpwawo jwa Ambuje.",
