        {
          "text": "Kaneko piyamasile yaka yitatu, napite ku Yelusalemu kukuwonegana ni Petulo,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
          "text": " nipo nalonjele ni jwalakwejo kwa yijuma yiŵili.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.1.18",
            "verseOrgIds": [
              "GAL.1.18"
            ]
          }
        },
        {
