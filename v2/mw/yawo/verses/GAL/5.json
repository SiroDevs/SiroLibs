              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "kulisinga, nambo soni kuligosa. Pangali lilamusi lyakulekasya yeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.23",
            "verseOrgIds": [
              "GAL.5.23"
            ]
          }
        },
        {
