          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵele ŵali ŵakwe ŵa Klistu Yesu, nganalipeleka acimsyenepe kuti alamulilidwe ni ndamo syakusakala sya m'mitima jawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.24",
