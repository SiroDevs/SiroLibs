        },
        {
          "text": "Nambo Msimu wa Mlungu ukusatutendekasya uwe kuti tuŵe ŵa: Cinonyelo, lukondwa, mtendele, kuwusimana mtima, umbone mtima, kwatendela ŵane yambone, kulupicika, ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.22",
            "verseOrgIds": [
              "GAL.5.22"
            ]
          }
        },
        {
