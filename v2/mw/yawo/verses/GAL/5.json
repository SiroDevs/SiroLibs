          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti Msimu atupele uwe umi, myoyo jwalakwejo akwenela kulamulila ma umi getu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.5.25",
            "verseOrgIds": [
