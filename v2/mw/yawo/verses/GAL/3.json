                "loc": "ROM.4.14"
              },
              "items": [
                {
                  "text": "Alo 4:14",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "GAL 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi sambano cakulinga cakupelecela Malamusi caliji cici? Mlungu ŵajonjecesyepo Malamusi kuti ŵamanyisye ŵandu ya ulemwa,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.19",
            "verseOrgIds": [
              "GAL.3.19"
            ]
          }
        },
        {
          "text": " mpaka yisukulu ya Abulahamu, yele Mlungu ŵatesile nayo cilanga cila. Mlungu ŵapelece Malamusigo kupitila mwa Malayika,",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.19",
            "verseOrgIds": [
              "GAL.3.19"
            ]
          }
        },
        {
          "text": " nambo soni kupitila mwa Mose mpela juŵaliji jwakwimilila pasikati ja Mlungu ni ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.19",
            "verseOrgIds": [
              "GAL.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga tukuŵeceta ya jwakwimilila pasikati ni kuti pana mbali siŵili sikukwayidwa. Nambo Mlungu jwatesile yosope jikape pali pangali jwakwimilila pasikati.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
              "GAL.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cakulinga ca Malamusi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GAL 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.20",
            "verseOrgIds": [
              "GAL.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GAL 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ni kuti Malamusi gakusasisyana ni cilanga ca Mlungu? Iyayi, pakuti ŵandu naga akapocele malamusi gele gakomboleka kwapa umi, ni kuti ŵandu akaŵele ŵakulungama kupitila m'Malamusimo. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.21",
            "verseOrgIds": [
              "GAL.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo m'Malemba mulembedwe kuti yindu yosope yili pasi pa ulamusi wa ulemwa, kuti pakukulupilila mwa Yesu Klistu, ŵandu apocele cilanga ciŵatesile Mlungu kwa jemanjajo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
            "verseOrgIds": [
              "GAL.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GAL 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.22",
            "verseOrgIds": [
              "GAL.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GAL 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkanijiyice ndaŵi ja cikulupiji, uwe twaliji mpela acikayidi m'myala mwa Malamusi, kwembeceya kuti cikulupi cicatiji ciyiceco, cijuwulidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.23",
            "verseOrgIds": [
              "GAL.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GAL 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Malamusi galiji mpela jwakutulamulila jwetu mpaka pa ndaŵi jiŵayice Klistu, kuti uwe tulungamisidwe ni Mlungu kupitila mu cikulupi. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.24",
            "verseOrgIds": [
              "GAL.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti sambano jiyice ndaŵi ja cikulupi, mwakuti Malamusi ngagatulamulila soni.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GAL 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.25",
            "verseOrgIds": [
              "GAL.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GAL 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupitila mu cikulupi, jemanja wosope mli ŵanace ŵa Mlungu kupitila mu kulumbikana ni Klistu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.26",
            "verseOrgIds": [
              "GAL.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GAL 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wosope ŵa jemanja ŵimwaŵele ŵampepe ni Klistu kupitila mu ubatiso, mwatesile mpela kuwala cakuwala casambano. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.27",
            "verseOrgIds": [
              "GAL.3.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GAL 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo pangali kulekangana sikati ja Ayuda ni ŵandu ŵa mitundu jine, sikati ja acikapolo ni alukosyo, kapena soni sikati ja acalume ni acakongwe, pakuti jemanja wosope mli ŵampepe mwakulumbikana ni Klistu Yesu. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.28",
            "verseOrgIds": [
              "GAL.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga jemanja mli ŵakwe ŵa Klistu, ni kuti mli yisukulu ya Abulahamu, ŵakwenela kupocela yiŵatesile cilanga Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.29",
            "verseOrgIds": [
              "GAL.3.29"
            ]
          }
        },
