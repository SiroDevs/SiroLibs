              "type": "tag",
              "attrs": {
                "loc": "EXO.12.40"
              },
              "items": [
                {
                  "text": "Eks 12:40",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.17",
            "verseOrgIds": [
              "GAL.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "GAL 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu naga akumpa mundu upile ligongo lyakuti jwele mundujo ali jwakugagosa Malamusi, ni kuti upilewo ngaŵa kuti ukusapelecedwa ligongo lya cilanga. Nambo Mlungu ŵampele upile Abulahamu ligongo lyakuti Mlungujo jwaŵecete kuti tayitende.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.3.18",
            "verseOrgIds": [
              "GAL.3.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
