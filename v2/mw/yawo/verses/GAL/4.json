              "type": "tag",
              "attrs": {
                "loc": "GEN.21.10"
              },
              "items": [
                {
                  "text": "Gen 21:10",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.30",
            "verseOrgIds": [
              "GAL.4.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GAL 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe, ŵakulupilila acimjangu, uwe nganituŵa ŵanace ŵa kapolo, nambo tuli ŵanace ŵa jwamkongwe jwali mlukosyo.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.31",
