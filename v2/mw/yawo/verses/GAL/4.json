          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano jemanja ŵakulupilila acimjangu, tuli ŵanace ŵa Mlungu ligongo lya cilanga cakwe, mpela muŵaŵelele Isaki. ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.28",
            "verseOrgIds": [
              "GAL.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GAL 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi jelejo mwanace juŵapagwile mpela mwakusapagwila ŵanace wosope jula, ŵamsawusyaga mwanace jwinejo jwele juŵapagwile kupitila mu macili ga Msimu Ŵaswela, mwakuti mpaka sambano jino yili yalumope.",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.29",
            "verseOrgIds": [
              "GAL.4.29"
            ]
          }
        },
        {
          "name": "note",
