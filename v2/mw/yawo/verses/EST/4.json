          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.14",
            "verseOrgIds": [
              "EST.4.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Esitele ŵatumile ŵakutumicila ŵacelewo kuti akamsalile Modekayi kuti: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.15",
            "verseOrgIds": [
              "EST.4.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mjawule mkasonganye Ayuda wosope ŵakusimanika ku Susa, ni mkasalile kuti akalijime kulya, m'malo mwa une. Akasaja kulya kapena kumwa kwa masiku gatatu cilo ni musi. Une soni pamo ni ŵali ŵakundumicilaŵa tucilijima kulya mpela mutacitendela jemanja. Kaneko tinjijawula kuwonegana ni mwenye, atamose kuti kuli kugalemwecesya malamusi. Naga kuli kuwa, tingawe.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.4.16",
            "verseOrgIds": [
              "EST.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
