    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye ŵamcimbicisye Modekayi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilo cicoco mwenye nganagona lugono, nipo ŵalamwile kuti ayice najo buku jiŵalembagamo mbili ja yindu yiyatendedwaga kala. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.1",
            "verseOrgIds": [
              "EST.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'bukumo ŵasimene kuti mwalembedwe ya muŵajuwulile Modekayi malindi ga ŵakutumicila ŵaŵili ŵa mwenye aŵa: Bigitani ni Teleshi, ŵiŵalondelaga yipinda ya mwenye, muŵasacilaga kutenda malindi kuti amwulaje Mwenye Ahasuwelo.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.2",
            "verseOrgIds": [
              "EST.6.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EST.2.21+EST.2.22"
              },
              "items": [
                {
                  "text": "Est 2:21-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.2",
            "verseOrgIds": [
              "EST.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye ŵawusisye kuti, “Ana tutesile cici pa kumcimbicisya Modekayi pa yeleyi? Ŵakutumicila ŵa mwenye ŵajanjile kuti pangali citutesile.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.3",
            "verseOrgIds": [
              "EST.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye ŵawusisye soni kuti, “Ana ŵani ŵali mluŵalamo?” Pandaŵi jeleji Hamani ŵaliji ali agambile kwinjila kwene mu luŵala lwa kusa kwa nyumba ja mwenye, kuti akasalile mwenye yakumwulaga Modekayi pakumkoleka pa yitela yiŵaliji ali apanganyisye kala yila. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.4",
            "verseOrgIds": [
              "EST.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵakutumicilawo ŵajanjile kuti, “Hamani ni ŵajimi mu luŵalamo, nipo akwembecela kuti awonegane ni wawo.” Mwenye ŵatite kuti, “Ŵajinjisye.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.5",
            "verseOrgIds": [
              "EST.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hamani piŵajinjile mcipindamo, mwenye ŵamwusisye jwalakwejo kuti, “Ana mpaka namtendele cici mundu jungusaka kumcimbicisya?” Kaneko Hamani ŵatandite kuganisya acitiji, “Ana mwenye mpaka asose kwacimbicisya ŵani kumbunda une?” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.6",
            "verseOrgIds": [
              "EST.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵelewo ŵajanjile kuti, “Kwa mundu jwele jwakusaka kumpa ucimbicimbi, wawo mwenye amtendele yindu ayi: ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.7",
            "verseOrgIds": [
              "EST.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatume ŵandu, ayice ni yakuwala yakusawala wawo, ni haci jakusakwela wawo jajikwete cimanyisyo ca ucimwene pa mtwe pakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.8",
            "verseOrgIds": [
              "EST.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ajigale yakuwalayo ni hacijo ayipelece kwa jwakutumicila jwa wawo jwakucimbicikwa. Nipo am'wece yakuwalayo mundu jwasacile wawo kumcimbicisya. Amjendesye jwalakwejo m'misewu ja mu msinda ali akwesile pa haci, aku ali mkugumila kuti ‘Alole mwakusatendela mundu jwasacile mwenye kumcimbicisya.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.9",
            "verseOrgIds": [
              "EST.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye ŵamsalile Hamani kuti, “Kajigaleni yakuwalayo ni hacijo mwacitema mpela mumŵecetele m'mwejo. Mumtendele yeleyo Modekayi, m'Yuda jula jwakutama pa cipata cakwinjilila ku nyumba ja mwenye. Pakasoŵeka cilicose pa yicindu yimkolasileyi.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.10",
            "verseOrgIds": [
              "EST.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Hamani ŵajigele mkanjo wa mwenye ni haci nipo ŵamŵecice Modekayi mkanjowo. Modekayi ŵakwesile pa hacipo, nipo Hamani ŵatandite kumjendesya Modekayi m'misewu josope ja mu msindamo, ŵajenesyaga kuti, “Alole mwakusatendela mundu jwele mwenye jwasacile kumcimbicisya.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.11",
            "verseOrgIds": [
              "EST.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe, Modekayi ŵawujile pa cipata cakwinjilila ku nyumba ja mwenye kupitilisya masengo gawo, nambo Hamani ŵapite mwacitema kumangwakwe ali aliwunicile mu mtwe ligongo lya soni. ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.12",
            "verseOrgIds": [
              "EST.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵalondecesye ŵamkwakwe ni acimjakwe wosope yiyawonecele ŵalakwewo. Kaneko ŵamkwawo Hamani pamo ni acimjawo Hamani ŵalunda ŵala ŵasalile ŵelewo kuti, “Naga Modekayi ali m'Yuda, pangali soni cilicose ca mpaka mtende m'mwejo kuti mumpunde jwalakwejo. Mwangakayicila kose, m'mwejo timlepele pameso pa jwalakwejo.”",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hamani akuwulajidwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.13",
            "verseOrgIds": [
              "EST.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo piŵaliji mkuŵeceta, ŵakutumicila ŵacele ŵa mwenye ŵayice, ŵamjigele Hamani jula mwacitema, ni ŵapite nawo ku cindimba ciŵalinganyisye Esitele.",
          "type": "text",
          "attrs": {
            "verseId": "EST.6.14",
            "verseOrgIds": [
              "EST.6.14"
            ]
          }
        }
      ]
    }
  ],
