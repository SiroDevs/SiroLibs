          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloŵe gakumalisya gakwatetela, ni kupeleka moni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CO 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akano ni katatu sambano kwika soni kumangwenu kuno. Maloŵe ga Mlungu gakuti, “Magambo galigose gasimisicidweje ni umboni wa ŵandu ŵaŵili kapena ŵatatu.”",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Det 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.19.15"
              },
              "items": [
                {
                  "text": "19:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.1",
            "verseOrgIds": [
              "2CO.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CO 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja ŵimwalemwisye kala, nipo soni ŵane wosope, paja namsalile ndaŵi jele jinayice kaŵili kala kweleko nipo nguwilisya kumsalila cilepe sambano mkiniyice, kuti patinjiyikapo soni, ngasinamtendela canasa mundu jwalijose. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.2",
            "verseOrgIds": [
              "2CO.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CO 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo timciciwona cimanyisyo cele cimkucisosa cakuti Klistu",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "text": " akuŵeceta kupitila mwa une. Jwalakwe nganaŵa jwakulepetala pa yele yakutenda ni jemanja, nambo akusalosya macili gakwe pasikati penu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.3",
            "verseOrgIds": [
              "2CO.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwaliji jwakulepetala ndaŵi jiŵamkomelaga pa msalaba, nambope sambano ali cijumi mwamacili ga Mlungu. Uwe soni tuli ŵakulepetala mwa jwalakwe, nambo tuciŵa ni umi pampepe najo ni macili ga Mlungu, pakamula masengo getu pasikati penu.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CO 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.4",
            "verseOrgIds": [
              "2CO.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CO 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlilinje mwacimsyene kuti mlilole naga mkusungadi cikulupi cenu. Naga mkupunda kulingwa, timcimanyilila kuti Klistu Yesu",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.5",
            "verseOrgIds": [
              "2CO.13.5"
            ]
          }
        },
        {
          "text": " ali mwa jemanja. Naga ngaŵa myoyo ni kuti mlepeletu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.5",
            "verseOrgIds": [
              "2CO.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CO 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ngukulupilila kuti timcimanyilila kuti uwe nganitulepela. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.6",
            "verseOrgIds": [
              "2CO.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CO 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukupopela kwa Mlungu kuti jemanja kasimtenda yangalumbana yiliyose. Ngaŵa kuti uwe tuwonece mpela ŵakupunda, nambo kuti jemanja mtende yele yayili yakwenela, atamose kuti uwe tuwonece mpela tulepele. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.7",
            "verseOrgIds": [
              "2CO.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CO 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ngatukupakombola kutenda cindu cilicose cakusisyana ni cakuwonaco, nambo myoyopeyo yakamucisya yakuwonayo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.8",
            "verseOrgIds": [
              "2CO.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CO 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukusangalala uwe patuli ŵakulepetala nambo jemanja mli ŵamacili. Cele citukumŵenda Mlungu ni cakuti mŵeje ŵambone kwene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.9",
            "verseOrgIds": [
              "2CO.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CO 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe ngulemba ndili kwakutalicila ni jemanja, kuti patinjiyikapo kasipapagwa ligongo lyakuti tingamulisye masengo ulamusi wangu wa ukali. Ambuje ŵambele ulamusiwo kuti limbisye mpingo, ngaŵa kuti nawupasule. ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.10",
            "verseOrgIds": [
              "2CO.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano acalongo acimjangu, sangalalani. Mpikane yele yingumsalilayi nipo mkolosye yele yayilemale. Mpikangananeje ni kuŵa pa mtendele. Pelepo Mlungu jwacinonyelo ni jwa mtendele tacitama namwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CO 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.11",
            "verseOrgIds": [
              "2CO.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkomasyane jwine ni mjakwe mwa cinonyelo cisyesyene.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope ŵa Mlungu akupeleka moni.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CO 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.12",
            "verseOrgIds": [
              "2CO.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CO 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbone mtima wakutyocela kwa Ambuje Yesu Klistu ni cinonyelo ca Mlungu nipo soni cikamulano ca Msimu Ŵaswela yiŵe ni jemanja wosopemwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CO.13.13",
            "verseOrgIds": [
              "2CO.13.13"
            ]
          }
        }
      ]
    }
  ],
