        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malamusi ga Mose",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "text": " ni ciwilili ca upile wele wawulimkwisawo, ngaŵa upile usyesyenewo. Atamose mbopesi sisyosyopesyo sikusapelecedwa caka ni caka, malamusigo ngaŵa mkomboleka kose kupitila mu mbopesisyo kugalawusya ŵandu kuti aŵe ŵakulungama kusyesyene ŵakwawula kwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.1",
            "verseOrgIds": [
              "HEB.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakumlambila Mlungu ŵala akaŵe kuti ali ŵaswejesedwe kusyesyene, ni kuti mtima wawo mkaniŵasisya soni pa ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "text": " nipo kuti akalesile kupeleka mbopesi syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.2",
            "verseOrgIds": [
              "HEB.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mpela muyiŵelelemu, mbopesisyo sikusakumbusya ŵandu ya ulemwa wawo caka ni caka. ",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.3",
            "verseOrgIds": [
              "HEB.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti miasi ja ng'ombe sya mikambako ni acitonde ngaŵa mkombola kose kutyosya ulemwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.10.4",
            "verseOrgIds": [
              "HEB.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
