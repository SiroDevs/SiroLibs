                "loc": "PSA.95.11"
              },
              "items": [
                {
                  "text": "Mas 95:11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 4:7"
          },
          "items": [
            {
              "text": "7",
