            "number": "23",
            "style": "v",
            "sid": "1KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapanganyisye akelubi ŵaŵili ŵa citela ca olifi,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "text": " ukulu ŵa jwalijose waliji mamita mcece ni hafu, nipo ŵaŵisile mkati mwa cipinda ca mkatikati ca Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
