          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵaŵisile akelubiwo mwakulolegana mkati mwa cipinda Ceswela Mbope m'Nyumba ja AMBUJE, kuti mapapiko gawo gaŵili getambasukule galiji mkwayana pa cilikati pa cipindaco, ni mapapiko gane gaŵili gakwayiye mapupa gakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
