                "loc": "NUM.6.1+NUM.6.2+NUM.6.3+NUM.6.4+NUM.6.5"
              },
              "items": [
                {
                  "text": "Num 6:1-5",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JDG 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko jwamkongwejo ŵajile kukwasalila ŵamkwakwe kuti, “Mundu jwa Mlungu ambonecele, nipo kuwoneka kwakwe kwakogoya mpela malayika ga Mlungu. Une nganinimwusya kuŵatyocele, soni nginasalila lina lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.6",
            "verseOrgIds": [
              "JDG.13.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo yiŵasalile ni yakuti une tingole cilu ni kuŵeleka mwanace jwamlume. Ŵasalile kuti ngamwa finyo jwa mtundu uliwose kapena ukana kapena kulya cakulya cigakukana malamusi ga Mlungu, ligongo mcandajo taciŵa kwa Mlungu mnasili mu umi wakwe wosope.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JDG 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.7",
            "verseOrgIds": [
              "JDG.13.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Manowa ŵapopesile kwa AMBUJE kuti, “Conde, AMBUJE, amkunde mundu jwa Mlungu juŵamtumisye jula ayice soni kuti atusalile uwe yakuŵajilwa kumtendela mwanacejo pitacipagwa.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JDG 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.8",
            "verseOrgIds": [
              "JDG.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JDG 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Mlungu ŵatesile yiŵamŵendile Manowa, nipo lilayika lyakwe lyayice soni kwa jwamkongwejo piŵaliji ali kumigunda. Manowa nginaŵa nawo ŵamkwawo, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.9",
            "verseOrgIds": [
              "JDG.13.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ŵawutwice ndaŵi jijojo kukwasalila ŵamkwawo kuti, “Wawo, mundu juŵambicile lisiku line jula ambonecele soni.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JDG 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.10",
            "verseOrgIds": [
              "JDG.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manowa ŵajimwice ni kwakuya ŵamkwawo. Ŵajawile kwa mundu jula ni kumwusya kuti, “Ana ni wawojo ŵiŵaŵecetaga kwa ŵamkwangu?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵajitice kuti, “Elo.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JDG 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.11",
            "verseOrgIds": [
              "JDG.13.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Manowa ŵawusisye, “Mwanagwetu tatende cici, pitigacitendecekwa maloŵe gawo? Akusosa mwanacejo tatame umi wamti uli?”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JDG 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.12",
            "verseOrgIds": [
              "JDG.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JDG 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lya AMBUJE lyajanjile kuti, “Ŵamkwenu talolecesye kuti tatende yosope yene yinasalile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.13",
            "verseOrgIds": [
              "JDG.13.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngakuŵajilwa kulya cilicose ca mbeju ja mpeleya, ngakuŵajilwa kumwa finyo kapena ukana, kapena kulya cakulya cigakukana malamusi ga Mlungu. Basi akuŵajilwa kutenda yosope yene yinasalile.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JDG 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.14",
            "verseOrgIds": [
              "JDG.13.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa Manowa nginamanyilila kuti lyaliji lilayika lya AMBUJE, ŵaliŵendile kuti, “Conde atujembeceye akasajawula. Tukusosa kuti twalinganyicisye nyama ja mbusi alye.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15+JDG.13.16",
            "verseOrgIds": [
              "JDG.13.15",
              "JDG.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo lilayikalyo lyatite kuti, “Naga ngutama, ngindya yakulya yenu. Nambo naga mkusosa kuteleka, mtende jakutinisya mpela mkupeleka mbopesi ja kwa AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15+JDG.13.16",
            "verseOrgIds": [
              "JDG.13.15",
              "JDG.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JDG 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.15+JDG.13.16",
            "verseOrgIds": [
              "JDG.13.15",
              "JDG.13.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manowa ŵajanjile kuti, “Atusalile lina lyawo, kuti pitigacitendeka maloŵe gawo uwe citwacimbicisye wawojo.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JDG 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.17",
            "verseOrgIds": [
              "JDG.13.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JDG 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayikalyo lyawusisye kuti, “Ligongo cici mkusosa kumanyilila lina lyangu? Lina lyangutu liŵele lyakusimonjesya.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.18",
            "verseOrgIds": [
              "JDG.13.18"
            ]
          }
        },
