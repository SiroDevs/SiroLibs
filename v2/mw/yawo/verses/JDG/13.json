              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkongwejo ŵaŵelece mwanace jwamlume ni ŵampele lina lyakuti Samusoni. Mwanace ŵakusile cenene nipo AMBUJE ŵampele upile. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.24",
