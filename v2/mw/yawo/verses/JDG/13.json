        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli ŵatesile soni ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        },
        {
          "text": " kwa AMBUJE, nipo jwalakwe ŵakundile Afilisiti kwalamulila Aisalaeli kwa yaka makumi mcece.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JDG 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.1",
            "verseOrgIds": [
              "JDG.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JDG 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa jele ndaŵijo ŵapali mundu jwine lina lyakwe Manowa jwa ku msinda wa Sola. Jwalakwe ŵaliji jwa lukosyo lwa Dani. Ŵamkwakwe ŵaliji jwangaŵeleka. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.2",
            "verseOrgIds": [
              "JDG.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JDG 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilayika lya AMBUJE lyamwonecele ni kumsalila kuti, “M'mwejo nginimŵeleceje citandilile, nambo pangakaŵa timcikola cilu nipo timciŵeleka mwanace jwamlume. ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.3",
            "verseOrgIds": [
              "JDG.13.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JDG 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlolecesye kuti mkamwa finyo kapena ukana, kapena kulya cakulya cilicose cigakukana malamusi ga Mlungu, ",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.4",
            "verseOrgIds": [
              "JDG.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JDG 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo pitacipagwa mwanagwenu mkasimlogwa kumsenga umbo syakwe, ligongo kutandila lisiku lyakupagwa kwakwe mcandajo taciŵa mnasili kwa Mlungu. Jwalakwe tacipanganya masengo gakwakulupusya Aisalaeli kwa Afilisiti.”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.5",
            "verseOrgIds": [
              "JDG.13.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
