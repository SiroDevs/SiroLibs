              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Manowa ŵajigele mwanace jwa mbusi ni utandi, kwawula nayo pa liganga liŵalisandwisye malo gakupelecela yinduyo mbopesi kwa AMBUJE ŵakusatenda yakusimonjesya.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.19",
            "verseOrgIds": [
              "JDG.13.19"
            ]
          }
        }
      ]
    },
