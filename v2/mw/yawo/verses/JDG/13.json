              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manowa ŵatite kwa ŵamkwakwe, “Uwetu cituwe, ligongo tum'weni Mlungu!”",
          "type": "text",
          "attrs": {
            "verseId": "JDG.13.22",
