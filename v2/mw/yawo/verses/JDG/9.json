              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayiweni asilikali ŵa ku Isalaeli kuti Abimeleki awile, wosope ŵene ŵawujile kumangwawo.",
          "type": "text",
          "attrs": {
            "verseId": "JDG.9.55",
