              "ZEC.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ZEC 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jelejo kulila kwa Yelusalemu tikuciŵa mpela kulila kwa Hadadi Limoni mu ciŵata ca ku Megido. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.11",
            "verseOrgIds": [
              "ZEC.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ZEC 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŵasa lililyose mcilambomo tilicilila lisyene: liŵasa lyakutyocela kwa Daudi tilicilila pajikape. Liŵasa lyakutyocela kwa Natani tilicilila pajikape. Liŵasa lyakutyocela kwa Lefi tilicilila pajikape. Liŵasa lyakutyocela kwa Shimeyi tilicilila pajikape, pamo ni maŵasa gane gosope. Liŵasa lililyose tilicilila pajikape, nipo acalume ŵa liŵasa lililyose tacilila pajikape kulekangana ni acakongwe.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.12+ZEC.12.13+ZEC.12.14",
            "verseOrgIds": [
              "ZEC.12.12",
              "ZEC.12.13",
              "ZEC.12.14"
            ]
          }
        }
