              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.9",
            "verseOrgIds": [
              "ZEC.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano yisukulu yosope ya Daudi ni ŵandu ŵa ku Yelusalemu tinjapa mtima wa canasa ni wa kupopela. Myoyo tacitiji kumlola ajula juŵamsomile mpaka kuwa jula, tacimlilila mnope mpela amula mwakusamlilila mwanace jwandanda kupagwa jwele jwawile.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.12.10",
            "verseOrgIds": [
              "ZEC.12.10"
            ]
          }
        },
        {
