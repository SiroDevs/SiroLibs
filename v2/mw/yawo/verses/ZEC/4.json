          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵajanjile kuti, “Jemanjaji ali ŵandu ŵaŵili ŵele ŵasagulidwe ni Mlungu, ŵakusamtumicila jwalakwejo, AMBUJE ŵa cilambo cosope capasi.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.4.14",
            "verseOrgIds": [
              "ZEC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cilanga ca Mlungu kwa Selubabele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
