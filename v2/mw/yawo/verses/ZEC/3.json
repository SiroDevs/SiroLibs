            "number": "1",
            "style": "v",
            "sid": "ZEC 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupitila m'mesomkulola gane, AMBUJE ŵandosisye Yoswa, jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "text": " ali ajimi pameso pa lilayika lya AMBUJE. Paliji pana soni Satana",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "text": " jwele jujwajimi kumbali ja mkono wamlyo wa Yoswa kuti amjimbe Yoswajo magambo.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.1",
            "verseOrgIds": [
              "ZEC.3.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
