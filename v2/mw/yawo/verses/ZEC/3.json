                "loc": "JER.23.5"
              },
              "items": [
                {
                  "text": "Yel 23:5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.33.15"
              },
              "items": [
                {
                  "text": "33:15",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.6.12"
              },
              "items": [
                {
                  "text": "Sak 6:12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ZEC 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguŵika pameso pa Yoswa liganga lyalikwete mbali msano ni siŵili. Une namsyene tinjisokotapo maloŵe, tinjityosya ulemwa wa mcilambo acino pa lisiku limpepe. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.9",
            "verseOrgIds": [
              "ZEC.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ZEC 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitiliciyika lisiku lyelelyo, wosope ŵene timciŵilanjidwa kuti mkasangalalile mtendele wenu, jwalijose ali atemi pa citela cakwe ca mpeleya ni ca mkuju.”",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.10",
            "verseOrgIds": [
              "ZEC.3.10"
            ]
          }
        },
        {
