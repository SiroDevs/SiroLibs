          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.5",
            "verseOrgIds": [
              "ZEC.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ZEC 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko lilayika lya AMBUJE lila lyamsalile Yoswa kuti ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.6",
            "verseOrgIds": [
              "ZEC.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ZEC 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Ŵamaciligosope akuŵeceta kuti, “Naga mkugapikanila malamusi gangu ni kutenda yele yinimsalile une kuti myitende, timcipitilisya kulamulila nyumba jangu ni kulolela soni maluŵala gakwe, nipo soni tinjigapikanila mapopelo genu mpela mungusagapikanila mapopelo ga malayika gali pameso panguga. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.7",
            "verseOrgIds": [
              "ZEC.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ZEC 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane sambano, Yoswa, m'mwejo mli jwamkulungwa jwa ŵakutaga mbopesi, mpikane soni jemanja ŵimli ŵakutaga mbopesi, ŵele ŵimli cimanyisyo ca yambone yitiyicitendekwa. Tinjiyika ni jwakutumicila jwangu jwakolanjidwa kuti Nyambi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.3.8",
            "verseOrgIds": [
              "ZEC.3.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
