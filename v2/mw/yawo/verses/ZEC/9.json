              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo akucijamuka cilambo ca Hadilaki nambo soni msinda wa Damasiko. Pajatu misinda josope ja ku Alamu jili jakwe ja AMBUJE, yalumo soni mpela musiŵelele ngosyo syosope sya Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.1",
            "verseOrgIds": [
              "ZEC.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ZEC 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilambo ca Hamati cicitesile malile ni cilambo ca Hadilaki cili soni cakwe ca AMBUJE yalumo soni misinda ja Taya ni Sidoni atamose kuti ali ŵalunda mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.2",
            "verseOrgIds": [
              "ZEC.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ZEC 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taya ŵalitaŵile mapupa gakulicinjilicisya, soni ŵawunjice silifa",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        },
        {
          "text": " ni golidi",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        },
        {
          "text": " mpela litaka! ",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.3",
            "verseOrgIds": [
              "ZEC.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ZEC 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo AMBUJE tacisumula yosope yakwete jemanjajo, ni kuyijasa m'nyasa soni msindawo taciwujoca moto.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.4",
            "verseOrgIds": [
              "ZEC.9.4"
            ]
          }
        }
      ]
    },
