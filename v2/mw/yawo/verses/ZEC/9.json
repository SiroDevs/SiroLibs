            "sid": "ZEC 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msinda wa Ashikeloni nombe nawo tiwuciyiwona yeleyi nipo tiwucitenda woga. Msinda wa Gasa tiwucikwinyata ni woga, yalumo soni Ekiloni nipo yiŵajembecelaga tiyicisokonecela. Mwenye jwa ku Gasa tacimtyosya nipo ku Ashikeloni tikuciŵa kwangali ŵandu.",
          "type": "text",
          "attrs": {
            "verseId": "ZEC.9.5",
            "verseOrgIds": [
              "ZEC.9.5"
            ]
          }
        },
