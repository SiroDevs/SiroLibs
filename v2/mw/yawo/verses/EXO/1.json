          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jiŵajawulaga Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1+EXO.1.2+EXO.1.3+EXO.1.4+EXO.1.5",
            "verseOrgIds": [
              "EXO.1.1",
              "EXO.1.2",
              "EXO.1.3",
              "EXO.1.4",
              "EXO.1.5"
            ]
          }
        },
        {
          "text": " ku Iguputo, mwanace jwawo jumo jwamlume lina lyakwe Yosefe, ŵaliji kala ku Iguputoko. Aga ni mena ga ŵanace 11 ŵacalume ŵa Yakobo, ŵaŵajawile nawo Yakobojo ku Iguputo, pamo ni maŵasa gawo. Lubeni, Simiyoni, Lefi, Yuda, Isakala ni Sebuloni, Dani ni Nafutali, Gadi ni Asha, ni Benjamini. Pakwawula ku Iguputo, Yakobo ŵakwete ŵanace, yisukulu, ni yisukulu ya m'mawuja. Wosope pamo ŵakwanile 70.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.1.1+EXO.1.2+EXO.1.3+EXO.1.4+EXO.1.5",
            "verseOrgIds": [
              "EXO.1.1",
              "EXO.1.2",
              "EXO.1.3",
              "EXO.1.4",
              "EXO.1.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
