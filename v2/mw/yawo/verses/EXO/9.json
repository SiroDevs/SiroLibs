                "loc": "REV.8.7"
              },
              "items": [
                {
                  "text": "Ciw 8:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "REV.16.21"
              },
              "items": [
                {
                  "text": "16:21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.24",
            "verseOrgIds": [
              "EXO.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matalilago gayijonasile yindu yosope yiyaliji pasa mcilambo cosope ca Iguputo, kutandila ŵandu wosope pampepe ni yinyama yakwe. Gajonasile soni yindu yosope yakumela m'migunda ni kutemangula yitela yosope ya mwitinji. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.25",
            "verseOrgIds": [
              "EXO.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mcilambo ca Gosheni, ciŵatamaga Aisalaeli, mwaliji mwangali ula ja matalila.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.26",
            "verseOrgIds": [
              "EXO.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye jwa ku Iguputo ŵaŵilasile Mose ni Aloni ni ŵasalile kuti, “Une ndemwisye, nambo AMBUJE ali ŵakulungama, une ni ŵandu ŵangu tuli ŵakulemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.27",
            "verseOrgIds": [
              "EXO.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EXO 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpopele kwa AMBUJE kuti alekasye ula ja matalila ni kulindimaku ni tinamkunde kuti mjawuleje. Ngamtama soni akuno.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.28",
            "verseOrgIds": [
              "EXO.9.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EXO 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵamsalile Mwenye jwa ku Iguputo kuti, “Patingopoce mu msinda awuno, tingatambasukule magasa gangu kwa AMBUJE, ni kulindima ni matalila tigalece, kuti m'manyilile kuti cilambo cosope capasi cili ca AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.29",
            "verseOrgIds": [
              "EXO.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EXO 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ngumanyilila kuti m'mwejo ni nduna syenu ngamkwajogopape AMBUJE Mlungu.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.30",
            "verseOrgIds": [
              "EXO.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EXO 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Litonji lyamasile konasika pampepe ni mbeju ja balele",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "text": " jakwe, ligongo lyakuti mbeju ja balelejo jaliji jili jekomale, ni litonji lyaliji lili litandite uluŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.31",
            "verseOrgIds": [
              "EXO.9.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EXO 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mbeju ja tiligu ni mbeju ja usanje, nganiyijonasika ligongo akusapanda mwakokoŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.32",
            "verseOrgIds": [
              "EXO.9.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EXO 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni Mose ŵalekangene najo Mwenye jwa ku Iguputo, ni ŵakopwece kusa kwa msinda, ni ŵanyakwile makono gakwe kwinani ni ŵapopesile kwa AMBUJE, ni kulindima ni matalila yalesile, soni ula jalesile kugwa pacilambo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.33",
            "verseOrgIds": [
              "EXO.9.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "EXO 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mwenye jwa ku Iguputo piŵalolite kuti ula, matalila, ni kulindima, yosopeyo yilesile, ŵalemwisye soni, jwalakwe ni nduna syakwe ŵajumwile soni mtima. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.34",
            "verseOrgIds": [
              "EXO.9.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "EXO 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye jwa ku Iguputo ŵajumwile mtima, ni nganiŵakunda ŵanace ŵa Aisalaeli kuti atyoce, mpela muŵaŵecetele AMBUJE kwa Mose mula.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.9.35",
            "verseOrgIds": [
              "EXO.9.35"
            ]
          }
        }
      ]
    }
