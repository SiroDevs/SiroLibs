                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyimbo ja Miliyamu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EXO 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.18",
            "verseOrgIds": [
              "EXO.15.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jele mahaci ga Mwenye jwa ku Iguputo, pampepe ni mageleta gakwe, ni ŵandu ŵakwela, ŵajinjile m'nyasa, AMBUJE ŵagawucisye mesigo, ni kwatiŵisya wosopewo. Nambo Aisalaeli ŵajesile cilikati ca nyasajo, pasi pali papajumu. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.19",
            "verseOrgIds": [
              "EXO.15.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miliyamu, jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "text": " jwamkongwe, mlumbugwawo Aloni,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "text": " ŵajigele kagoma m'myala mwakwe, ni acakongwe wosope ŵamkuyisye panyuma ali mkugomba tugoma twawo m'myala, ali mkuŵina. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.20",
            "verseOrgIds": [
              "EXO.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Miliyamu pamo ni acakongwe ŵajimbile nyimbo jakwalumba AMBUJE, jakuti,",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mesi gakuŵaŵa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EXO 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.21",
            "verseOrgIds": [
              "EXO.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EXO 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mose ŵalongolele Aisalaeli kutyocela ku Nyasa Jecejewu",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "text": " jila, ni ŵajinjile mcipululu ca Shuli. Ŵajesile mcipululumo kwa masiku gatatu, ni nganagasimana mesi. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.22",
            "verseOrgIds": [
              "EXO.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EXO 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ŵajile kwika ku Mala, nambo nganapakombola kumwa mesi ga ku Malako ligongo galiji gakuŵaŵa. Ni ligongo lyakwe ŵagakolasile malogo, lina lyakuti Mala. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.23",
            "verseOrgIds": [
              "EXO.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EXO 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵala ŵamdandawulile Mose, ni ŵamwusisye kuti, “Ana uweji citumwe cici?” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.24",
            "verseOrgIds": [
              "EXO.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵapopesile kwa AMBUJE, ni AMBUJE ŵamlosisye katela. Mose ŵakaponyisye katelako m'mesi, ni mesigo galesile kuŵaŵako.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EXO 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko AMBUJE ŵapele ŵanduwo lilamusi lyakutamilicika, ni ŵalinjile soni ŵanduwo kweleko. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.25",
            "verseOrgIds": [
              "EXO.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EXO 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵatite, “Naga mkumbikanila une, AMBUJE Mlungu jwenu, ni kutenda yindu yakulungamika, ni kugasunga malamusi gangu, ni kuyipikanila yosope yingumgombelesya kuti myitende, ngasinimpa cilango ca yilwele yili yose yinayipelece kwa Aiguputo. Ligongo une ndili AMBUJE ŵingusamposya jemanja.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.26",
            "verseOrgIds": [
              "EXO.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EXO 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe ŵayice ku Elimu, kuyapali yisima ya nduluko ja mesi 12, ni yitela ya migwalangwa 70, ni ŵataŵile masakasa gawo kweleko mungulugulu mesigo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.15.27",
            "verseOrgIds": [
              "EXO.15.27"
            ]
          }
        }
      ]
    }
  ],
