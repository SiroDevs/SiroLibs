        },
        {
          "text": "Ŵandu ŵacalume wosope awoneceleje pameso pa une AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.17",
            "verseOrgIds": [
              "EXO.23.17"
            ]
          }
        },
        {
          "text": " Mlungu, katatu pa caka.",
          "type": "text",
          "attrs": {
