          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Myiceje ni yagowola yakutanda, yambone mnope, ya ku migunda kwenu ku Nyumba ja AMBUJE Mlungu jwenu.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.23.19",
            "verseOrgIds": [
              "EXO.23.19"
            ]
          }
        },
        {
