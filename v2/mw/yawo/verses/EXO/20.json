            "number": "11",
            "style": "v",
            "sid": "EXO 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵa masiku msano ni limo, AMBUJE ŵamalisisye kupanganya kwinani, cilambo capasi ni nyasa, ni yindu yosope yamwelemo, nambo pa lisiku lya msano ni kaŵili ŵapumwile, ni ligongo lyakwe AMBUJE ŵalipele upile lisiku lya Sabato ni kuliswejesya.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.11",
            "verseOrgIds": [
              "EXO.20.11"
            ]
