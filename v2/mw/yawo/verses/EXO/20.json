            "number": "2",
            "style": "v",
            "sid": "EXO 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Une ndili AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
          }
        },
        {
          "text": " Mlungu jwenu junamkopwesye mu ukapolo, mcilambo ca Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.2",
            "verseOrgIds": [
              "EXO.20.2"
            ]
          }
        }
      ]
    },
