            "verseOrgIds": [
              "EXO.20.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EXO 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanduwo ŵamsalile Mose",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        },
        {
          "text": " kuti, “Mŵecete m'mwejo ni uwe, ni uweji tupikane, nambo akakunda kuti Mlungu aŵecete ni uwe, ni mkaŵa uweji kuwa.” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.19",
            "verseOrgIds": [
              "EXO.20.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EXO 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵajanjile kuti, “Mkajogopa, Mlungu ayice kukumlinga, kuti kumcimbicisya kwakwe kuŵeje kwa kutyocela m'mitima mwenu, kuti mkaleŵa.”",
          "type": "text",
          "attrs": {
            "verseId": "EXO.20.20",
            "verseOrgIds": [
              "EXO.20.20"
            ]
          }
        }
      ]
