            "style": "v",
            "sid": "EXO 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.9",
            "verseOrgIds": [
              "EXO.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EXO 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mose ni Aloni",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        },
        {
          "text": " ŵayitesile yitagu yakusimonjeka yosopeyi pameso pa Mwenye jwa ku Iguputo. Nambo AMBUJE ŵamjumwisye mtima Mwenye jwa ku Iguputojo, ni nganiŵakunda Aisalaeli kutyoka mcilambo mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "EXO.11.10",
            "verseOrgIds": [
              "EXO.11.10"
            ]
          }
        }
      ]
    }
  ],
