              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵatite kwa AMBUJE, “Ŵanduŵa ngakomboleka kukwela litumbi alino, ligongo ŵalakwe ŵatusalile cile kuti, ‘Mkalembe malile kusyungula litumbi, ni mkagombelesye ŵanduwo kuti akaja kusumba malilego.’ ” ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.19.23",
            "verseOrgIds": [
              "EXO.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
