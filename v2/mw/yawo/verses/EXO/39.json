          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni nduŵila, yikofiya ni makabudula, yosopeyo yakupanganyidwa ni nguwo ja bafuta jwakutililika mnope soni jeluce cenene. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.28",
            "verseOrgIds": [
