              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapanganyisye soni tumabelo twa golidi jwambone mnope, ni ŵatuŵisile mwakupacisya pa cilikati pa maluŵa gakuwoneka mpela yisogosi yila, kusyungulila mlutoto losope lwa mwiŵanda mwa mkanjo. ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.25",
            "verseOrgIds": [
