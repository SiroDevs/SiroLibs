          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatotele Aloni ni ŵanace ŵakwe mwinjilo, wa nguwo ja bafuta jakutililika mnope soni jeluce cenene, ",
          "type": "text",
          "attrs": {
            "verseId": "EXO.39.27",
