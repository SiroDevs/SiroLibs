              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwende tumcimbicisye Mlungu! Jwalakwe akwete macili gakumlimbisya jemanja pakukuya Ngani Syambone",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        },
        {
          "text": " singusalalicila, syele sisili maloŵe gakwenesya ya Yesu Klistu. Yiyaliji ya mtemela nipo soni yaliji yakusisika pa yaka yosope kutyocela kalakala. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.25",
            "verseOrgIds": [
              "ROM.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ROM 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo sambano yikopocele pakulanguka kupitila mu yele yiŵalembile ŵakulocesya, nambo soni kupitila mu Lilamusi lya Mlungu jwa cijumi yimanyice kwa ŵandu ŵa mitundu josope, mwakuti ayikulupilile ni kuyipikanila.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.16.26",
            "verseOrgIds": [
              "ROM.16.26"
            ]
          }
        }
      ]
