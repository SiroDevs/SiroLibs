          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Aisalaeli ŵalingaga kuti asosesose Malamusi gitigalungamisye jemanjajo kwa Mlungu, nambo nganagasimana. ",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.31",
            "verseOrgIds": [
              "ROM.9.31"
            ]
          }
        },
        {
