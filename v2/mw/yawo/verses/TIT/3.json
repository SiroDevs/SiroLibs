            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.14",
            "verseOrgIds": [
              "TIT.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wosope ŵali ni une akuno akumpa moni. Mpelece soni moni kwa wosope ŵakusatunonyela kupitila mcikulupi.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
              "TIT.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "TIT 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbone mtima wakutyocela kwa Mlungu uŵe ni jemanja wosope.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.15",
            "verseOrgIds": [
