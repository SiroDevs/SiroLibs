          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtende yakomboleka kumkamucisya Senasi jwakumanyilila ya malamusi jula, nambo soni Apolo kuti ajendelecele ulendo wawo. Mlolecesye soni kuti jemanjajo akasoŵa kandu kalikose.",
          "type": "text",
          "attrs": {
            "verseId": "TIT.3.13",
            "verseOrgIds": [
              "TIT.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
