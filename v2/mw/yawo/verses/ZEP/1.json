            "sid": "ZEP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awu uli utenga wele AMBUJE ŵapelece kwa Sefaniya mu ndaŵi jele Yosiya mwanace jwa Amoni jiŵaliji mwenye jwa ku Yuda. Sefaniya jwapagwile kwiŵasa lya Mwenye Hesekiya kupitila mwa Amaliya, Gedaliya, ni Kushi.",
          "type": "text",
          "attrs": {
            "verseId": "ZEP.1.1",
            "verseOrgIds": [
              "ZEP.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "2 Ayi 22:1—23:30; 2 Mbi 34:1—35:27",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisiku lyele AMBUJE tacalamula ŵandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
