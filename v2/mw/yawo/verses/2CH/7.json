                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Solomoni pamo ni ŵandu wosope ŵala, ŵapelece mbopesi pameso pa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni pamo ni ŵandu ŵala piŵajipelece Nyumbaji kwa AMBUJE, ŵawuleje ng'ombe 22,000, ni ngondolo 120,000 syakupeleka mpela mbopesi jambopesi ja mkamulano.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi wosope ŵajimbaga malipenga gawo ali ajimi m'malo mwawo. Alefi ŵajimi mwakulolegana ni ŵakutaga mbopesiwo, nipo ŵajimbaga yida yakwimbila yiŵapanganyisye Mwenye Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "text": " Ŵajimbaga nyimbo ni kwatogolela AMBUJE ligongo lya “Cinonyelo cawo cangamala” mpela muŵalamulile Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomoni ŵagaswejesye malo ga pasikati pa luŵala lwa kumeso kwa Nyumba ja AMBUJE, nipo ŵapelece mbopesi syosope syakutinisya, ni mawuta ga mbopesi sya mkamulano. Solomoni ŵatesile yeleyi ligongo lyakuti malo giŵapanganyisye gakupelecela mbopesigo galiji gamwana pakulandanya ni musyaŵelele mbopesi syosope.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jelejo Solomoni ŵatesile cindimba ca masakasa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "text": " nipo ŵasangalele kwa masiku msano ni gaŵili. Waliji msongano wekulungwa mwakuti ŵandu ŵa ku mpoto ku Mpata wa Hamati pamo ni ŵa ku m'mwela kumalile kwa cilambo ca Iguputo ŵayice ku cindimbaco. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa masiku msano ni gaŵili, ŵanduŵa ŵatendaga msyungu ŵakupeleka malo gakupelecela mbopesi, nipo pa masiku gane msano ni gaŵili, jemanjajo ŵaliji pa cindimba. Pa lyuŵa lya mbesi ŵandu ŵaliji pa cisangalalo cakumalisya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo pa lyuŵa lya 23 lya mwesi wa msano ni jiŵili, Solomoni ŵasalile ŵandu ŵala kuti jwalijose ajawuleje kumangwakwe. Ŵanduwo ŵaliji ŵakondwa ligongo lya yambone yosope yele AMBUJE ŵamtendele Daudi, Solomoni, ni ŵandu wakwe wosope ŵa Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu ŵawonecele soni kwa Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Solomoni ŵamalisisye kutaŵa Nyumba ja AMBUJE, nipo yosope yiŵaganisyaga kuti ayitende ŵayimalisisye cenene. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE ŵalilosisye asyene kwa jwalakwejo kupitila mu sagamisi ndaŵi ja cilo, nipo ŵasalile kuti, “Mbikene mapopelo genu, nipo une sagwile nyumbaji kuti jiŵe malo gakupelecela mbopesi kwa une. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ndili mbugele kwinani kuti ula jikagwa, kapena naga ngutumisya sombe kuti silye m'mela wawo, kapena kutumisya yilwele sikati ja ŵandu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nambo naga ŵandu ŵangu akupopela mwakulinandiya kwa une ni kupitikuka mitima jawo, ni kuleka ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "text": " wawo, tinjicitendekasya cilambo cawo kuŵa ca cajila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjiŵa ndili mkujilolela nyumbaji ni kupikana mapopelo gakutendekwa m'nyumbaji, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo lyakuti nyumbaji jili jangu nipo tacilambila une mwelemu mpaka kalakala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga mkundumicila une mwakulupicika mpela muŵatendele Daudi baba ŵenu, pakugapikanila malamusi ni kutenda yosope yinamlamwile m'mwejo, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une, tinjisunga cilanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        },
        {
          "text": " cinatesile ni baba ŵenu, pinasalile kuti, ‘ŵanace ŵa mwiŵasa lyawo ni ŵitacilamulila cilambo ca Isalaeli.’",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.4"
              },
              "items": [
                {
                  "text": "1 Ayi 2:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga jemanja akuleka kugapikanila malamusi gangu, ni kutanda kujitindiŵalila milungu jine, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "tinjimtyosya jemanja mcilambo cinampeleci, nipo tinjijileka nyumba jinataŵileji kuti alambilejemo une nipo yeleyi tiyiciŵa ngani ni cindu cakusecesya sikati ja ŵandu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
