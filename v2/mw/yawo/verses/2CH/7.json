      },
      "items": [
        {
          "text": "Kupeleka kwa Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵamasile kupopela Mwenye Solomoni, moto watulwice kutyocela kwinani, nipo wajocile mbopesi syosope sisyapelecedwe, nipo lilanguka lyakunyesima lya AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "text": " lyagumbele m'Nyumbamo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.9.23+LEV.9.24"
              },
              "items": [
                {
                  "text": "Lef 9:23-24",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo lyakuti m'Nyumbamo mwagumbele ni lilanguka lyakunyesima lya AMBUJE, ŵakutaga mbopesi nganapakombola kwinjila m'nyumbamo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa ku Isalaeli piŵaluweni lumbili lwa AMBUJE, wosope ŵatindiŵele ni kwalambila AMBUJE ligongo lya umbone wawo ni cinonyelo cawo cangamala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
