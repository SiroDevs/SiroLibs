        "style": "s1"
      },
      "items": [
        {
          "text": "Solomoni akuŵeceta ni ŵandu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
