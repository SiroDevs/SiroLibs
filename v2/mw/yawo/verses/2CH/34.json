    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosiya mwenye jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 34:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosiya ŵaliji ni yaka msano ni yitatu pa ndaŵi jiŵajinjilaga ucimwene, nipo ŵalamulile ku Yelusalemu yaka 31.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.3.6"
              },
              "items": [
                {
                  "text": "Yel 3:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.1",
            "verseOrgIds": [
              "2CH.34.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatesile yakulungama pameso pa AMBUJE,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "text": " soni ŵakuyisye ndamo syambone sya Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "text": " nangolo jwakwe, pakugapikanila malamusi gosope ga Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosiya ŵalekasisye kujilambila milungu ja cilendo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 34:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.2",
            "verseOrgIds": [
              "2CH.34.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 34:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcaka ca msano ni yitatu ya ucimwene wakwe, jwalakwejo pijwaliji mcanda, jwatandite kumlambila Mlungu juŵalambilaga Mwenye Daudi nangolo jwakwe. Pali papite yaka mcece ŵatandite kugumula malo gakulambililapo milungu ja cilendo ja ku Yuda ni ku Yelusalemu, ŵagumwile soni yimanyisyo ya mlungu jwa cikongwe jwakolanjidwa Ashela pamo ni milungu jine. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.3",
            "verseOrgIds": [
              "2CH.34.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 34:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵagumwile soni malo gakupelecela mbopesi kwa mlungu jwakumanyika ni lina lyakuti Baala,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "text": " Yosiyawo ali mkulola. Ŵagumwile soni malo gakutinicisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "text": " nipo ŵajisyajile milungu ja Ashela mpaka kujisandusya luwundu, kaneko ŵamwasenye luwundulo penani pa malembe ga ŵandu ŵakutaga mbopesi ŵa milungujo jakusepajo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2KI.21.3"
              },
              "items": [
                {
                  "text": "2 Ayi 21:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.33.3"
              },
              "items": [
                {
                  "text": "2 Mbi 33:3",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.4",
            "verseOrgIds": [
              "2CH.34.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 34:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵelewo ŵatinisye soni maupa ga ŵakutaga mbopesi ŵa milungu ja cilendo pa malo giŵalambilagago. Myoyo ŵaswejesye cilambo ca Yuda ni Yelusalemu pakutenda yeleyi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.13.2"
              },
              "items": [
                {
                  "text": "1 Ayi 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.5",
            "verseOrgIds": [
              "2CH.34.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 34:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaswejesye soni misinda ja Manase, Efelemu, ni Simiyoni, mpaka kumpoto ku malile ga Nafutali. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.6",
            "verseOrgIds": [
              "2CH.34.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu cilambo cosope ca Isalaeli, ŵagwisisyeko malo gakupelecela mbopesi soni ŵakasenye yilandanyo ya Ashela mpaka ŵayisyajile kuŵa mpela luwundu. Ŵagwisisye soni malo gakututumicisya ubani mcilambomo. Kaneko Yosiya ŵawujile ku Yelusalemu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Hilikiya ŵasimene Buku ja Malamusi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 34:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.7",
            "verseOrgIds": [
              "2CH.34.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 34:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcaka ca msano ni yitatu ya kulamulila kwawo, piŵamasile kuswejesya cilambo ni Nyumba ja AMBUJE ni kumasya soni kulambila milungu ja cilendo, Mwenye Yosiya ŵatumile acalume ŵatatu kuti akalinganye Nyumba ja AMBUJE. Acalumewo ŵaliji Shafani mwanace wa Asaliya, Maaseya nduna ja ku Yelusalemu, ni Yowa mwanace Yowahasi juŵaliji mlembela, kuti alinganye soni Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.8",
            "verseOrgIds": [
              "2CH.34.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 34:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalume ŵatatuŵa ŵajile kwa Hilikiya jwamkulungwa jwa ŵakutaga mbopesi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "text": " Ŵampele jwalakwejo mbiya siŵasongenye alonda ŵa ci Lefi kutyocela kwa ŵandu ŵaŵatamaga ku cilambo ca Manase jwa kungapilo lyuŵa, Efelemu, ni ku Isalaeli kwesope ni ku Yuda, Benjamini ni alukosyo wosope ŵa ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.9",
            "verseOrgIds": [
              "2CH.34.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 34:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mbiyasyo ŵasipelece kwa acikapitawo ŵiŵalolelaga masengogo kuti ŵalipileje ŵandu ŵiŵalinganyaga Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.10",
            "verseOrgIds": [
              "2CH.34.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 34:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbiya sine ŵasipelece kwa makalipentala ni amisili ŵakutaŵa nyumba kuti asume maganga ni matabwa ga migomba ni mbalaŵala sya nyumba jiŵajilesile ayimwene ŵa ku Yuda kuti jijonasice. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.11",
            "verseOrgIds": [
              "2CH.34.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 34:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acalumeŵa ŵakamwile masengo mwakulupicika. Jemanjaji ŵaliji mkulongoleledwa ni Yahati, Obadiya ŵa mwiŵasa lya Melali, Sakaliya ni Meshulamu ŵa mwiŵasa lya Kohati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.12",
            "verseOrgIds": [
              "2CH.34.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alefi ŵane ŵiŵaliji ŵakumanyilila kwimba ŵaliji ŵakulolela ŵandu ŵaŵanyakulaga katundu, ŵalolelaga soni ŵandu ŵaŵatumicilaga pa masengo gakulekanganalekangana, Alefi ŵane ŵaliji acimlembela, nipo ŵane ŵalondelaga pa yipata.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 34:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.13",
            "verseOrgIds": [
              "2CH.34.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 34:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵakoposyaga mbiya kutyocela mcipinda cakusunjilamo yindu, Hilikiya ŵasimene buku ja Malamusi giŵapelece AMBUJE, Mlungu kwa Mose.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.14",
            "verseOrgIds": [
              "2CH.34.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 34:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilikiya ŵasalile Shafani kuti, “Najisimene buku ja Malamusi m'Nyumba ja AMBUJE.” Kaneko ŵapelece bukujo kwa Shafani ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.15",
            "verseOrgIds": [
              "2CH.34.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 34:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo Shafani ŵajigele buku jila ni kwawula najo kwa mwenye. Ŵelewo ŵamsalile mwenyejo kuti, “Tutesile yosope yene yimwatulamwile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.16",
            "verseOrgIds": [
              "2CH.34.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 34:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tutyosisye mbiya syele sisyasunjidwe m'Nyumba ja AMBUJE, nipo tusipelece kwa acikapitawo ni kwa ŵandu ŵamasengo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.17",
            "verseOrgIds": [
              "2CH.34.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 34:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shafani ŵasalile soni mwenye kuti, “Apano ngwete buku jambele une Hilikiya.” Nipo ŵaŵalasile bukujo pameso pa mwenye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.18",
            "verseOrgIds": [
              "2CH.34.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 34:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye piŵapikene maloŵe ga m'buku ja malamusigo, ŵapapwile yakuwala yakwe mwa canasa ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.19",
            "verseOrgIds": [
              "2CH.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 34:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ŵalamwile Hilikiya, Ahikamu mwanace jwa Shafani, Abidoni mwanace jwa Mikaya, Shafani mlembela ni Asayiya jwakutumicila jwa mwenye kuti: ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.20",
            "verseOrgIds": [
              "2CH.34.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mjawule nipo mkawusye m'malo mwa une kwa AMBUJE, ni kwa ŵandu ŵele ŵasigele ku Isalaeli ni ku Yuda. Mkawusye ya maloŵe ga m'buku jele jisimanikweji. AMBUJE atutumbilile uwe ligongo acinangolo ŵetu nganagapikanila maloŵe ga AMBUJE soni nganagakuya maloŵe gosope gigalembedwe m'bukuji.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 34:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.21",
            "verseOrgIds": [
              "2CH.34.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 34:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Hilikiya pamo ni ŵandu ŵawatumidwe kwa mwenye ŵala ŵajile kwa jwamkongwe jwine jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "text": " lina lyakwe Hulida juŵatamaga kumpoto kwa Yelusalemu. Ŵamkwawo ŵaliji Shalumu, mwanace jwa Tikifa, ni cisukulu ca Halihasi juŵaliji jwakulolela mikanjo m'Nyumba ja AMBUJE. Piŵamsimene ŵamsalile jwelejo yiyatendekwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.22",
            "verseOrgIds": [
              "2CH.34.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 34:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo ŵasalile jemanjajo kuti awujile soni kwa mwenye ŵiŵatumile jemanjajo soni akasalile ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.23",
            "verseOrgIds": [
              "2CH.34.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 34:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "utenga wakuyicisyawu wakutyocela kwa AMBUJE wawukuti: “Une tinjipeleka cilango kwa ŵandu ŵa mu Yelusalemu ni malweso gagalembedwe m'buku jajiŵalanjidwe pameso pa mwenye jwa ku Yuda. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.24",
            "verseOrgIds": [
              "2CH.34.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 34:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji anganile une nipo apelece mbopesi kwa milungu jine, myoyo andumbilisye une pa yosope yatesile, nipo lutumbilo lwangu tiluŵe pa ŵandu ŵa mu msinda wa Yelusalemu nipo lutumbilolo ngasilutyoka. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.25",
            "verseOrgIds": [
              "2CH.34.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 34:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa mwenye jwa ku Yuda, juŵamtumile jemanja kuti mkawusye kwa AMBUJE mkasalile jwalakwejo Une, AMBUJE, Mlungu juŵamlambilaga Aisalaeli nguŵeceta kuti: Mwapikene yayilembedwe m'buku. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.26",
            "verseOrgIds": [
              "2CH.34.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 34:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵapo kuti pimwapikene maloŵe gigalembedwe m'buku ja malamusi mwapitikwice mtima ni kulinondiya pameso pangu, mwalisile ni kupapula yakuwala yenu, pimwapikene une munajogoyicisye kuti timbelece cilango kwa ŵandu ŵa ku Yelusalemu. Une mbikene lipopelo lyenu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.27",
            "verseOrgIds": [
              "2CH.34.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo cilango cisacileje kupeleka kwa ŵandu ŵa ku Yelusalemu ngimbeleka mpaka pitimciwa m'mwejo mwa mtendele.” Kaneko acalume ŵala ŵawujilile kwa Mwenye Yosiya kukwasalila maloŵega.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yosiya akutenda cilanga cakwapikanila AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 34:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.28",
            "verseOrgIds": [
              "2CH.34.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 34:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Yosiya ŵaŵilasile pamo acimlongola wosope ŵa ku Yuda ni ku Yelusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.29",
            "verseOrgIds": [
              "2CH.34.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 34:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ŵajile ku Nyumba ja AMBUJE yalumo ni acimlongolawo, ŵakutaga mbopesi, Alefi ni ŵandu wosope. Kaneko mwenye ŵaŵalasile buku ja cilanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "text": " jila pameso pa ŵandu wosope jijasimanikwe m'Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.30",
            "verseOrgIds": [
              "2CH.34.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 34:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenyewo ŵajimi pa cipilala cawo nipo ŵawilisye soni cilanga ca kuti tiŵapikanileje AMBUJE, soni tacisunga malamusi gawo ni mtima wakwe wesope ni umi wawo wesope, nipo tagakamulisyeje masengo maloŵe ga cilanga, mpela mwayilembedwele m'bukumo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.31",
            "verseOrgIds": [
              "2CH.34.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 34:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Yosiya ŵaŵendile ŵandu wosope ŵa ku Yelusalemu ni ku Benjamini kuti asunje cilangaco. Myoyo ŵandu ŵa ku Yelusalemu ŵatesile yeleyi mwakulingana ni cilanga ca AMBUJE, Mlungu jwele juŵamlambilaga acinangolo ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.32",
            "verseOrgIds": [
              "2CH.34.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 34:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Yosiya ŵatyosisye milungu jesope ja cilendo jijaliji mcilambo ca Isalaeli, pa ndaŵi jiŵaliji cijumi nipo ŵalamwile ŵandu wosope kuti ŵatumicileje AMBUJE, Mlungu juŵamlambilaga acinangolo ŵawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.34.33",
            "verseOrgIds": [
              "2CH.34.33"
            ]
          }
        }
      ]
    }
