    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye Hesekiya jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 29:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiya ŵajinjile ucimwene pa ndaŵi jiŵaliji ni yaka 25, nipo ŵalamulile ku Yelusalemu yaka 29. Mamagwe ŵaliji Abiya mwanace jwamkongwe jwa Sakaliya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.1",
            "verseOrgIds": [
              "2CH.29.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatesile yakulungama pameso pa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        },
        {
          "text": " mpela muŵatendelaga Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        },
        {
          "text": " nangolo jwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuswejesya Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 29:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.2",
            "verseOrgIds": [
              "2CH.29.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 29:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcaka candanda ca ucimwene wakwe, pa mwesi wandanda, Hesekiya ŵawugwile matanga ga ku Nyumba ja AMBUJE nipo ŵagalinganyisye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.3",
            "verseOrgIds": [
              "2CH.29.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 29:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasongenye Alefi ni ŵakutaga mbopesi wosope pa luŵala lwa kungopoko lyuŵa kwa Nyumba ja AMBUJE, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.4",
            "verseOrgIds": [
              "2CH.29.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 29:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ŵasalile kuti, “Mumbikanile une Alefi wosope, sambano mkwenela kuliswejesya mwacimsyene, ni kujiswejesya soni Nyumba ja AMBUJE, Mlungu jwakusamlambila acinangolo ŵenu. Mkatyosye cakunyalaya cilicose pameso pa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.5",
            "verseOrgIds": [
              "2CH.29.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 29:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti acinangolo ŵetu ŵaliji ŵangakulupicika nipo ŵatesile yangalumbana pameso pa AMBUJE, soni alesile kumpikanila jwalakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.6",
            "verseOrgIds": [
              "2CH.29.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 29:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵawugele matanga ga Nyumba ja AMBUJE, soni ŵasimisye nyali, nipo nganatutumisya ubani",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.7",
            "verseOrgIds": [
              "2CH.29.7"
            ]
          }
        },
        {
          "text": " kapena kupeleka mbopesi syakutinisya ku Nyumba ja AMBUJE Mlungu jwa Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.7",
            "verseOrgIds": [
              "2CH.29.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 29:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo lya yeleyi lutumbilo lwa AMBUJE lwaliji pa ŵandu ŵa ku Yuda ni ku Yelusalemu, Mlungu ŵatesile jemanjajo kuti aŵe ŵakogoya uwonece wawo ŵakwasimonjesya ŵandu, ni ŵakulundukwa mpela mumkuyiwonela ni meso genu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.8",
            "verseOrgIds": [
              "2CH.29.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acinangolo ŵetu ŵawulajidwe ku ngondo, nipo ŵanagwetu ŵacalume, ŵacakongwe ni aciŵamkwetu ŵajigalidwe kwawula ku ukapolo ligongo lya yeleyi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.9",
            "verseOrgIds": [
              "2CH.29.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 29:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.9",
            "verseOrgIds": [
              "2CH.29.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 29:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Sambano une nganisisye kuti ndende cilanga",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.10",
            "verseOrgIds": [
              "2CH.29.10"
            ]
          }
        },
        {
          "text": " ni AMBUJE, Mlungu juŵamlambilaga Aisalaeli kuti lutumbilo lwawo lutyoce pa uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.10",
            "verseOrgIds": [
              "2CH.29.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵangu, mkajasa ndaŵi, pakuti AMBUJE amsagwile jemanja kuti mwatinicisyeje ubani ni kwatumicila ŵalakwewo pakwalongolela ŵandu kuti amlambileje jwalakwejo.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 29:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.11",
            "verseOrgIds": [
              "2CH.29.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alefi ŵakuyicisyaŵa ŵapali pelepo:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12+2CH.29.13+2CH.29.14",
            "verseOrgIds": [
              "2CH.29.12",
              "2CH.29.13",
              "2CH.29.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 29:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.12+2CH.29.13+2CH.29.14",
            "verseOrgIds": [
              "2CH.29.12",
              "2CH.29.13",
              "2CH.29.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 29:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ŵasongenye acalongo acimjawo ŵa ci Lefi pakukuya maloŵe giŵaŵecete mwenye nipo wosopeŵa ŵaliswejesye acimsyene, nipo kaneko ŵajiswejesye soni Nyumba ja AMBUJE mpela muŵaŵecetele AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.15",
            "verseOrgIds": [
              "2CH.29.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ŵajinjile mkati mwa Nyumbajo kuti akajiswejesye, nipo ŵakopwesye kusa kwa luŵala lwa Nyumba ja AMBUJEJO yindu yakunyalaya yiŵayisimene mwelemo. Kutyocela pelepo Alefi ŵayijigalaga kuja kuyijasa kusa ku Ciŵata ca Kidiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 29:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.16",
            "verseOrgIds": [
              "2CH.29.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lyuŵa lyandanda lya mwesi wandanda Alefi ŵagatandite masengo gakuswejesya Nyumba ja AMBUJE, pa lyuŵa lya 8 lya mwesi uwowo ŵamalisisye masengo gosope mpaka pa cipinda cakwinjilila m'Nyumba ja AMBUJE. Kaneko ŵakamwile soni masengo gakuswejesya Nyumbajo kwa masiku 8 nipo ŵamalisisye pa lyuŵa lya 16 lya mwesi wandandawo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyumba ja AMBUJE jikupelecedwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 29:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.17",
            "verseOrgIds": [
              "2CH.29.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 29:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵamalisisye masengogo Alefi ŵajile kwa Mwenye Hesekiya nipo ŵamsalile kuti: “Tumalisisye masengo gosope gakuswejesya Nyumba ja AMBUJE, kupwatikapo malo gakupelecela mbopesi syakutinisya, pamo ni yida yakwe, tebulo jakuŵikapo mkate ŵakupeleka kwa AMBUJE, pamo ni yida yakwe yosope. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.18",
            "verseOrgIds": [
              "2CH.29.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yida yosope yiŵatyosisye Mwenye Ahasi pa ndaŵi jiŵalamulilaga soni piŵaliji ŵangakulupicika, tuyiswejesye ni kuyiŵika pasogolo pa malo gakupelecela mbopesi.”",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 29:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.19",
            "verseOrgIds": [
              "2CH.29.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 29:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Mwenye Hesekiya ŵajimwice kundaŵindaŵipe nipo ŵasongenye acakulungwa wosope ŵa mu msindamo, nipo ŵajile ku Nyumba ja AMBUJE pamo ni ŵanduwo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.20",
            "verseOrgIds": [
              "2CH.29.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 29:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵayice nasyo ng'ombe sya mikambako msano ni siŵili, ngondolo sya mikambako msano ni siŵili, ŵanace ŵangondolo sya mikambako msano ni ŵaŵili, ni acitonde msano ni ŵaŵili kuti apelece mbopesi jakuŵenda cikululucilo ca ulemwa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "text": " jiŵapelece m'malo mwa liŵasa lya mwenye ni ŵandu ŵa ku Yuda, nambo soni kuti aswejesye Nyumba ja AMBUJE. Hesekiya ŵalamwile ŵakutaga mbopesi ŵanace ŵa Aloni",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "text": " kuti ayipelece yeleyi pa malo gakupelecela mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.21",
            "verseOrgIds": [
              "2CH.29.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 29:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandanda pene jemanjajo ŵawuleje ng'ombe sya mikambako sila, kaneko ngondolo, kaneko ŵanace ŵangondolo ŵala, nipo ŵakutaga mbopesi ŵala ŵajigele miasi ja yinyamayo ni kujimisila pa malo gakupelecela mbopesi pala. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.22",
            "verseOrgIds": [
              "2CH.29.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 29:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakumalisya pasyesyene ŵajigele acitonde ŵala kwawula nawo kwa mwenye ni ŵandu wosope ŵaŵasongene, nipo jemanjajo ŵasajice magasa gawo pa mtwe pa acitondewo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.23",
            "verseOrgIds": [
              "2CH.29.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ŵala ŵasiwuleje mbusi sila, nipo ŵajigele miasi jakwe ni kujijitila pa malo gakupelecela mbopesi pala, kuti atende msyungu wakululucila ulemwa wa Aisalaeli wosope.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 29:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.24",
            "verseOrgIds": [
              "2CH.29.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 29:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesekiya ŵaŵisile Alefi m'malo mwawo m'Nyumba ja AMBUJE kuti ajimbeje ni yida ya ngonji, malipenga ni micekece, pakugakuya Malamusi ga AMBUJE giŵapelece kwa Mwenye Daudi kupitila kwa Gadi ni kwa Natani ŵakulocesya ŵa mwenye. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.25",
            "verseOrgIds": [
              "2CH.29.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 29:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alefi ŵajimi ali anyakwile yida yawo yakwimbila yakulandana ni ya Mwenye Daudi, nipo ŵakutaga mbopesi ŵajimi pelepo ali anyakwile malipenga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.26",
            "verseOrgIds": [
              "2CH.29.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 29:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Hesekiya ŵalamwile kuti mbopesi jakutinisya jipelecedwe, nipo piŵatandite kupeleka mbopesi jakutinisyajo ŵandu ŵajimbile nyimbo sya kwalumba AMBUJE, kaneko ŵakwimba nyimbo ŵagombile malipenga ni yida yine. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.27",
            "verseOrgIds": [
              "2CH.29.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 29:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope ŵalambile AMBUJE, nipo ŵakwimba nyimbo ŵaliji mkwimba mpaka pambesi pa mbopesi jakutinisyajo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.28",
            "verseOrgIds": [
              "2CH.29.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 29:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵamasile kupeleka mbopesi, Mwenye Hesekiya pamo ni ŵandu wosope ŵatindiŵele pasi nipo ŵalambile AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.29",
            "verseOrgIds": [
              "2CH.29.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Hesekiya pamo ni nduna syakwe ŵasalile Alefi kuti ajimbeje nyimbo sya kwalumba AMBUJE syele siŵalembile Daudi, ni jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "text": " Asafu. Myoyo ŵandu wosope ŵajimbile mwa lukondwa nyimbo syakwalumba AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 29:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.30",
            "verseOrgIds": [
              "2CH.29.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 29:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Mwenye Hesekiya ŵasalile ŵanduwo kuti, “Pakuti sambano jemanja ali ŵaswejesedwe pameso pa AMBUJE, ayice najo mbopesi pamo ni cakupeleka cakutogolela kwa AMBUJE, nipo ŵiŵakwete mtima ŵakusaka kupeleka mbopesi jakutinisya ŵayice najo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.31",
            "verseOrgIds": [
              "2CH.29.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 29:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵayice ni ng'ombe sya mikambako 70, ngondolo sya mikambako 100, ni ŵanace ŵangondolo ŵa mikambako 200, kuti yiŵe mbopesi jakutinisya, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.32",
            "verseOrgIds": [
              "2CH.29.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 29:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbopesi sine siŵapelece syaliji, ng'ombe sya mikambako 600 ni ngondolo sya mikambako 3,000. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.33",
            "verseOrgIds": [
              "2CH.29.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 29:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ŵakutaga mbopesi ŵaliji ŵa panandi, mwakuti ngamkanapakombola kuwulaga yinyama yosope ya mbopesi syakutinisyayo; myoyo pakwembeceya kuti ŵakutaga mbopesi ŵane aliswejesye, acalongo acimjawo ŵane ŵa ci Lefi ŵakamwisye jemanjajo mpaka masengogo gamasile. Alefiwo ŵatesile citema kwapunda ŵakutaga mbopesi pa kuliswejesya kwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.34",
            "verseOrgIds": [
              "2CH.29.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 29:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupwatika pa ciŵalanjilo ca mbopesi sya kutinisya, gapali soni mawuta gakupeleka ku mbopesi ja mkamulano,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "text": " nipo soni yakumwa ya mbopesi jakutinisya. Mwa litala lyeleli misyungu jesope ja mapopelo jatandite soni ku Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.35",
            "verseOrgIds": [
              "2CH.29.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 29:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Hesekiya pampepe ni ŵandu ŵala ŵaliji ŵakusangalala, ligongo lyakuti AMBUJE ŵakamwisye jemanjajo kugatenda masengoga mwacitema.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.29.36",
            "verseOrgIds": [
              "2CH.29.36"
            ]
          }
        }
      ]
    }
