          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni masengo gakwe gandanda ni gakumalisya, gosopego galembedwe mu Buku ja Mbili ja Ayimwene ŵa ku Isalaeli ni ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.35.27",
