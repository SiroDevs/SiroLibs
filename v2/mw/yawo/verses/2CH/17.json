        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yehoshafati akwinjila ucimwene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati mwanace jwa Asa ŵajinjile ucimwene m'malo mwa babagwe, nipo ŵalimbangene piŵalimbanaga ni Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.1",
            "verseOrgIds": [
              "2CH.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaŵisile asilikali ŵa ngondo ku misinda jesope jakucinjilicisidwa ja ku Yuda, nipo ŵataŵile malo ga asilikali ku cilambo ca Yuda ni ku misinda ja Efelemu jiŵajisumwile Asa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.2",
            "verseOrgIds": [
              "2CH.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
        {
          "text": " ŵaliji nawo Yehoshafati ligongo lyakuti ŵelewo ŵakuyaga ndamo jandanda jambone ja babagwe, nipo nganajilambila milungu ja Baala, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.3",
            "verseOrgIds": [
              "2CH.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "nambo ŵamtumicilaga Mlungu jwa baba ŵawo, soni ŵagapikanilaga malamusi ga Mlungu. Jwalakwe nganakuya ndamo jakusakala ja ayimwene ŵa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.4",
            "verseOrgIds": [
              "2CH.17.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵawutamilisye ucimwene wa Yehoshafati, nipo ŵandu wosope ku cilambo ca Yuda ŵayice kukumpa jwalakwejo mituka, nipo ŵasicile nambo soni ŵandu ŵamcimbicisyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.5",
            "verseOrgIds": [
              "2CH.17.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo jwaliji jwakulupicika pakwatumicila AMBUJE nipo ŵagwisisye malo gosope giŵalambililagapo milungu ja Ashela ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.6",
            "verseOrgIds": [
              "2CH.17.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcaka catatu ca kulamulila kwakwe, Yehoshafati ŵasagwile nduna msano nipo ŵasitumile kuti sikajiganye ku misinda jesope ja ku Yuda. Ndunasyo syaliji: Beni Haili, Obadiya, Sakaliya, Netanele, ni Mikaya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.7",
            "verseOrgIds": [
              "2CH.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndunasi syalongene pamo ni Alefi ŵane ŵakwana msano ni mcece ni ŵakutaga mbopesi ŵaŵili. Alefiwo ŵaliji Shemaya, Netaniya, Sebadiya, Asahelo, Shemilamoti, Yehonatani, Adoniya, Tobiya, ni Tobadoniya; nipo ŵakutaga mbopesiwo ŵaliji Elishama ni Yeholamu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.8",
            "verseOrgIds": [
              "2CH.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ŵajigele buku ja Malamusi ga AMBUJE, nipo ŵajesilejesile m'misinda jesope ja ku Yuda kwajiganya ŵandu malamusigo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Macili ga Yehoshafati",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.9",
            "verseOrgIds": [
              "2CH.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa myilambo yosope yiyasyungulile cilambo ca Yuda ŵatandite kwajogopa AMBUJE, nipo nganatenda ngondo ni Mwenye Yehoshafati. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.10",
            "verseOrgIds": [
              "2CH.17.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afilisiti ŵane ŵajigele silifa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        },
        {
          "text": " ni mituka jine kwawula kukwapa Mwenye Yehoshafati, nombe nawo Aluya ŵane ŵayice nasyo ngondolo 7,700 ni mbusi 7,700. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.11",
            "verseOrgIds": [
              "2CH.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Macili ga Mwenye Yehoshafati gapundile kuja msogolo. Ŵataŵile lipupa lyakucinjilicisya msinda wa Yuda ni misinda jine, ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.12",
            "verseOrgIds": [
              "2CH.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuŵasunjilaga katundu jwine. Ŵakwete soni asilikali ŵakulimba mitima ŵaŵatamaga ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.13",
            "verseOrgIds": [
              "2CH.17.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cawo caliji aci pakukuya maŵasa gawo: Adina ŵaliji mlongola jwa asilikali ŵakutyocela mwiŵasa lya Yuda, nipo ŵakwete asilikali 300,000. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.14",
            "verseOrgIds": [
              "2CH.17.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlongola jwaŵili ŵaliji Yehohanani, jwalakweju ŵakwete asilikali ŵa ngondo 280,000. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.15",
            "verseOrgIds": [
              "2CH.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlongola jwatatu ŵaliji Amasiya mwanace jwa Sikili, juŵalipelece mwa lisosa lyakwe kwatumicila AMBUJE, jwalakwe ŵakwete asilikali 200,000. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.16",
            "verseOrgIds": [
              "2CH.17.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyada ŵaliji mlongola jwakulimba mtima jwa asilikali ŵakutyocela mwiŵasa lya Benjamini, jwalakwe ŵakwete asilikali 200,000 ŵaŵakwete mawukunje ni yakucijila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.17",
            "verseOrgIds": [
              "2CH.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwaŵili jwawo ŵaliji Yehosabadi, jwalakwe ŵakwete asilikali 180,000, ŵiŵaliji cile kuputa ngondo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.18",
            "verseOrgIds": [
              "2CH.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ni ŵiŵamtumicilaga mwenye ku Yelusalemu, pambali pa jemanjaji ŵapali asilikali ŵane ŵele mwenye ŵaŵisile m'misinda jine jakucinjilicisidwa ni lipupa ja ku Yuda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.17.19",
            "verseOrgIds": [
              "2CH.17.19"
            ]
          }
        }
      ]
    }
  ],
