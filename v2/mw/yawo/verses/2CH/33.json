    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase mwenye jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵajinjile ucimwene piŵaliji ni yaka 12, nipo ŵalamulile ku Yelusalemu kwa yaka 52. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.1",
            "verseOrgIds": [
              "2CH.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵatesile yangalumbana pameso pa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "text": " papakuya yiŵatendaga ŵandu ŵa mitundu jine,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "text": " ŵele AMBUJE ŵiŵatopwesye mcilambomo pa ndaŵi jiŵayikaga Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.15.4"
              },
              "items": [
                {
                  "text": "Yel 15:4",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.2",
            "verseOrgIds": [
              "2CH.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵatandisye soni malo gakulambililapo milungu jine ja cilendo gele Hesekiya giŵagajonasile. Ŵapanganyisye soni malo gakulambilila milungu ja Baala",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        },
        {
          "text": " ni Ashela mlungu jwacikongwe jwakusepa, soni ŵasilambilaga ndondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.3",
            "verseOrgIds": [
              "2CH.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵataŵile malo gakupelecela mbopesi kwa milungu ja cilendo m'Nyumba ja AMBUJE, pa malo gele AMBUJE ŵaŵecete ni une acitiji kuti mwelemo ni mutiŵalambileje ŵalakwewo mpaka kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.6.6"
              },
              "items": [
                {
                  "text": "2 Mbi 6:6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.4",
            "verseOrgIds": [
              "2CH.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa maluŵala gaŵili gosope ga ku Nyumba ja AMBUJE ŵataŵilepo malo gakupelecela mbopesi kuti alambililejepo yindu ya kwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.5",
            "verseOrgIds": [
              "2CH.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵapelece ŵanace ŵakwe ŵacalume mpela mbopesi jakutinisya ku Ciŵata ca Hinomu. Jwalakwejo ŵatendaga yindu ya ukomasi, kupikanganana ni ŵandu ŵakuŵeceta ni misimu ni ŵandu ŵamatipwi. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.6",
            "verseOrgIds": [
              "2CH.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaŵisile cilandanyo ca mlungu jwakusepa m'Nyumba ja AMBUJE, pa malo gele Mlungu giŵamsalile Daudi",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "text": " pamo ni Solomoni mwanace jwakwe kuti: “Mu Yelusalemu muno, gali malo gisagwile une sikati ja ngosyo 12 sya ku Isalaeli kuti gaŵe malo gakulambilila lina lyangu mpaka kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.9.3+1KI.9.4+1KI.9.5"
              },
              "items": [
                {
                  "text": "1 Ayi 9:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2CH.7.12+2CH.7.13+2CH.7.14+2CH.7.15+2CH.7.16+2CH.7.17+2CH.7.18"
              },
              "items": [
                {
                  "text": "2 Mbi 7:12-18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.7",
            "verseOrgIds": [
              "2CH.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo naga ŵandu ŵa ku Isalaeli akugapikanila malamusi gangu gosope ni kusunga lilamusi liŵapele Mose",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "text": " jwakutumicila jwangu, une ngasingunda kuti jemanjajo ŵatoposye mcilamboco cele cinapele acinangolo ŵawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.8",
            "verseOrgIds": [
              "2CH.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵalemwekasisye ŵandu ŵa ku Yuda, mwakuti ŵatendaga yindu yakusakala mnope kwapunda ŵandu ŵa mitundu jine jiŵajitopwesye AMBUJE mcilambomo piŵayikaga Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Manase akugalawuka mtima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.9",
            "verseOrgIds": [
              "2CH.33.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamose kuti AMBUJE ŵamkalamwisye Manase pamo ni ŵandu ŵakwe, nambo jemanjajo nganapikanila. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.10",
            "verseOrgIds": [
              "2CH.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE ŵakundile asilikali ŵa ngondo ŵa ku Asiliya kuti ayice kuputa ngondo ni asilikali ŵa Manase. Ŵamwutile ni yisopo ya yisyano, nipo ŵamtaŵile ni ma unyolo ga yisyano ni ŵapite nawo ku Babiloni.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.11",
            "verseOrgIds": [
              "2CH.33.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jiŵaliji mu yipwetesi, Manase ŵalinondiye, nipo ŵagalawucile kwa AMBUJE, Mlungu jwawo. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.12",
            "verseOrgIds": [
              "2CH.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵapopesile kwa Mlungu, nipo Mlungu ŵapikene lipopelolyo, nipo ŵamkundile kuti awujile ku Yelusalemu kuti akalamulile soni. Kutyocela ndaŵi jeleji Manase ŵamanyilile kuti AMBUJE ŵaliji Mlungu jusyesyene.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.13",
            "verseOrgIds": [
              "2CH.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piyamasile yeleyi Manase ŵataŵile lipupa lya kusa kwa msinda wa Daudi, cakungapilo lyuŵa kwa Gihoni, kutyocela ku ciŵata mpaka pa Cipata ca Somba. Ŵataŵile lipupalyo kusyungulila msinda wa Ofula. Lipupalyo ŵalitaŵile mwakulikwesya mnope, mwakuti ŵaŵisile acakulungwa ŵakulamulila asilikali ŵa ngondo mu misinda jesope jijaliji mkati mwa mapupago. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.14",
            "verseOrgIds": [
              "2CH.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatyosisye milungu ja cilendo ni kutyosya cilandanyo cicaliji cakusepa m'Nyumba ja AMBUJE. Ŵatyosisye soni malo gakupelecela mbopesi kwa milungu ja cilendo giŵagataŵile petumbi ciŵandika ni Nyumba ja AMBUJE ku Yelusalemu; ŵajigele yosope yeneyi kwawula nayo kusa kwa msinda kwele kuŵayijasile. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.15",
            "verseOrgIds": [
              "2CH.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalinganyisye soni malo gakupelecela mbopesi kwa AMBUJE, nipo pa malopo ŵapelecelagapo mbopesi sya mkamulano ni sya kwatogolela AMBUJE. Ŵalamwile soni ŵandu wosope ŵa ku Yuda kuti jemanjajo ŵatumicileje AMBUJE, Mlungu juŵamlambilaga ŵandu ŵa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.16",
            "verseOrgIds": [
              "2CH.33.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamose kuti ŵanduwo ŵapitilisye kupeleka mbopesi ku malo gane gakulambila, ŵapelekaga mbopesisyo kwa AMBUJE, Mlungupe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kumala kwa ucimwene wa Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.17",
            "verseOrgIds": [
              "2CH.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gosope giŵatesile Manase, ni lipopelo lyakwe liŵapopesile kwa Mlungu, ni utenga wa ŵakulocesya wele uŵaŵecete kwa jwalakwe mu lina lya AMBUJE, Mlungu jwa ŵandu ŵa ku Isalaeli, yilembedwe mu Buku ja Mbili ja Ayimwene ŵa ku Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.18",
            "verseOrgIds": [
              "2CH.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lipopelo lya mwenye ni muŵalijanjile Mlungu lipopelolyo, ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "text": " wuŵatesile, yangalumbana yiŵatesile, malo giŵalinganyisye ga kujipopelela milungu ja cilendo ni yimanyisyo ya mlungu jwa cikongwe jwakolanjidwa Ashela ni milungu jiŵajilambilaga, yilembedwe m'buku ja Mbili ja Ŵakulocesya. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.19",
            "verseOrgIds": [
              "2CH.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵawile nipo ŵamsicile m'malembe giŵasosile m'nyumba mwakwe pemo, nipo Amoni ŵajinjile ucimwene m'malo mwa babagwewo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.20",
            "verseOrgIds": [
              "2CH.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwenye Amoni jwa ku Yuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 33:20"
          },
