              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni nganalinandiya pameso pa AMBUJE mpela muŵalinandiyicisye Manase babagwe.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.23",
            "verseOrgIds": [
              "2CH.33.23"
            ]
          }
