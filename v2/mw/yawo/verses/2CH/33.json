          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni ŵatesile yangalumbana pameso pa AMBUJE mpela muŵatendele Manase babagwe, soni ŵalambilaga ni kupeleka mbopesi kwa milungu ja cilendo jiŵapanganyisye babagwe. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.22",
            "verseOrgIds": [
              "2CH.33.22"
            ]
          }
        },
        {
