              "type": "text"
            }
          ]
        },
        {
          "text": "Amoni ŵaliji ni yaka 22 piŵajinjilaga ucimwene, nipo ŵalamulile ku Yelusalemu yaka yiŵili. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.33.21",
