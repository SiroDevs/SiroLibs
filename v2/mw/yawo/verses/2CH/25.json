        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.24",
            "verseOrgIds": [
              "2CH.25.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵawile Yowashi mwenye jwa ku Isalaeli, Amasiya mwenye jwa ku Yuda ŵatemi cijumi yaka 15. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.25",
            "verseOrgIds": [
              "2CH.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Masengo gosope giŵatesile Amasiya kutandilila pandanda mpaka pambesi galembedwe m'buku ja Mbili ja Ayimwene ŵa ku Yuda ni Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.26",
            "verseOrgIds": [
              "2CH.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutandilila ndaŵi jele Amasiya ŵajimucile AMBUJE, ŵandu ŵane ŵa ku Yelusalemu ŵamtendele jwalakwejo mtemela, nipo ŵatilile ku msinda wa Lakishi. Nambo amagongo ŵakwewo ŵatumile ŵandu ŵane kuti ŵakuye ku Lakishi, nipo piŵamsimene ŵamwulajile kukoko. ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.27",
            "verseOrgIds": [
              "2CH.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtembo wakwe ŵawujigele kwawula nawo ku Yelusalemu pa haci, nipo ŵawusicile m'malembe ga ayimwene mu msinda wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.25.28",
            "verseOrgIds": [
              "2CH.25.28"
            ]
          }
