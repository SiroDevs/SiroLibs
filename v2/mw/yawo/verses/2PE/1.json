                "loc": "LUK.9.28+LUK.9.29+LUK.9.30+LUK.9.31+LUK.9.32+LUK.9.33+LUK.9.34+LUK.9.35"
              },
              "items": [
                {
                  "text": "Luk 9:28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.17",
            "verseOrgIds": [
              "2PE.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloŵe gelega twagapikene kutyocela kwinani ligongo twaliji najo pampepe petumbi lyeswela lila.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2PE 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.18",
            "verseOrgIds": [
              "2PE.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2PE 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakuti tukumanyilila sambano kuti maloŵe ga ŵakulocesya gala gali gakuwona. Kuli kwambone kuti mlolecesye mpela nyali jakuŵala m'malo ga cipi, kuyicila pa ndaŵi jijikutanda kuca, pele ndondwa ja mng'andu pitijicitanda kuŵala m'mitima mwenu. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.19",
            "verseOrgIds": [
              "2PE.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2PE 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pandanda mpikanicisye kuti mundu pajikape ngaŵa mkomboleka gopolela maloŵe ga ŵakulocesya gakulembedwa m'Malemba. ",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.20",
            "verseOrgIds": [
              "2PE.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2PE 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pajatu maloŵe ga ŵakulocesya nganigayika mwa lisosa lya mundu, nambo Msimu Ŵaswela ŵaŵecetekasisye jemanjajo maloŵe gakutyocela kwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "2PE.1.21",
            "verseOrgIds": [
              "2PE.1.21"
            ]
          }
        }
      ]
    }
  ],
