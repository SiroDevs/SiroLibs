{
  "id": "ACT.24",
  "number": "24",
  "bookId": "ACT",
  "reference": "Mase 24",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "ACT 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akwimbidwa magambo ni Ayuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galigapite masiku msano jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.1",
            "verseOrgIds": [
              "ACT.24.1"
            ]
          }
        },
        {
          "text": " lina lyakwe Ananiya ŵajawile ku Kaisaleya ni acakulungwa ŵane pamo ni jwakwimila ŵandu pa magambo lina lyakwe Tetulo. Ŵawonecele pameso pa bwanamkubwa",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.1",
            "verseOrgIds": [
              "ACT.24.1"
            ]
          }
        },
        {
          "text": " Felikisi",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.1",
            "verseOrgIds": [
              "ACT.24.1"
            ]
          }
        },
        {
          "text": " ni kusala yiŵatesile Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.1",
            "verseOrgIds": [
              "ACT.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Paulo ŵamŵilasile kuti ajinjile, nipo Tetulo ŵatandite kuŵeceta magambo acitiji:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.2",
            "verseOrgIds": [
              "ACT.24.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakucimbicikwa, ulamusi wawo wambone utupele mtendele kwa ndaŵi jajilewu josopeji, nipo yindu yejinji yiŵele yilimkulinganyikwa kwa umbone wa cilambo cetu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.2",
            "verseOrgIds": [
              "ACT.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yosopeyi tukusayipocela kulikose nipo soni ndaŵi josope, soni tukusitwatogolela ŵalakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.3",
            "verseOrgIds": [
              "ACT.24.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngangusaka konanga ndaŵi jawo, nambo nguŵenda atutendele canasa ni kupikanila ngani jetu mwakata. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.4",
            "verseOrgIds": [
              "ACT.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Uwe tumsimene aju munduju, kuti ali jwakusokonesya mnope. Aŵele ali mkutandisya njojo sikati ja Ayuda pa cilambo cosope capasi nipo jweleju ni jwakulongolela jwa likuga line lyalikuŵilanjidwa Anasaleti.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.5",
            "verseOrgIds": [
              "ACT.24.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24:5",
              "type": "text"
            },
            {
              "text": "Anasaleti:",
              "type": "text"
            },
            {
              "text": "Aklistu ŵandanda ŵala mwine ŵakolanjidwaga lina lyeleli ligongo Yesu ŵaliji m'Nasaleti jwakutyocela ku Nasaleti. Alole soni pa Mat 2:23.",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.5",
            "verseOrgIds": [
              "ACT.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵasakaga kusakasya Nyumba ja AMBUJE, uwe twamkamwile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.6+ACT.24.7",
            "verseOrgIds": [
              "ACT.24.6",
              "ACT.24.7"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "f",
            "caller": "#"
          },
          "items": [
            {
              "text": "24:6",
              "type": "text"
            },
            {
              "text": "Uwe twamkamwile:",
              "type": "text"
            },
            {
              "text": "Malemba gane ajonjecesye kuti, “Twasakaga kumlamula twacimsyewe malingana ni malamusi getu. Nambo Lisiasi jwamkulungwa jwa asilikali ŵamkwakwile m'makono mwetu mwamacili. Kaneko Lisiasi ŵalamwile kuti ŵandu wosope ŵakumjimba magambo jwalakweju ayice kwa ŵalakwe.”",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.6+ACT.24.7",
            "verseOrgIds": [
              "ACT.24.6",
              "ACT.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga akumwusya munduju, ŵalakwe tamanyilile jika yosope yele yitukumjimbila magambo jweleju.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.8",
            "verseOrgIds": [
              "ACT.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayuda ŵajiticisye ya kumjimba magambo nipo ŵatite kuti yosopeyi yaliji yakuwona.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.9",
            "verseOrgIds": [
              "ACT.24.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akulicenjela pameso pa Felikisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.9",
            "verseOrgIds": [
              "ACT.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bwanamkubwa jula ŵamtesile Paulo kuti aŵecete, nipo Paulo ŵatite:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.10",
            "verseOrgIds": [
              "ACT.24.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ngumanyilila kuti ŵalakwe aŵele ŵakulamulila cilamboci kwa yaka yejinji, ni une ndili jwakusangalala kulicenjela pameso pa ŵalakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.10",
            "verseOrgIds": [
              "ACT.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wawo asyene jika tasimane umboni wakwe mwangasawusya, nganigamala masiku likumi ni gaŵili cijawulile une ku Yelusalemu kupopela. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.11",
            "verseOrgIds": [
              "ACT.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayuda nganasimana une ndili mkukangana ni jwalijose m'Nyumba ja AMBUJE, kapena kusimana une ndili mkutandisya njojo pasikati pa ŵandu m'nyumba sya mapopelo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.12",
            "verseOrgIds": [
              "ACT.24.12"
            ]
          }
        },
        {
          "text": " kapena palipose mu msindamo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.12",
            "verseOrgIds": [
              "ACT.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwali kapena tapelece umboni kwa ŵalakwe wa magambo gakunjimba sambano unega. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.13",
            "verseOrgIds": [
              "ACT.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo acipeci; ngwiticisya pameso pawo, kuti une ngusinamlambila Mlungu jwa acinangolo ŵetu pakukuya Litala",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.14",
            "verseOrgIds": [
              "ACT.24.14"
            ]
          }
        },
        {
          "text": " lyele lyakulitenda jemanjaji kuti lya unami. Nambo soni ngukulupilila cilicose cilembedwe m'Malamusi ga Mose",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.14",
            "verseOrgIds": [
              "ACT.24.14"
            ]
          }
        },
        {
          "text": " ni mabuku ga ŵakulocesya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.14",
            "verseOrgIds": [
              "ACT.24.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwete cikulupi cicoco mwa Mlungu cele cakwete ŵanduŵa, cakuti ŵandu wosope, ŵaswela mtima ni ŵakusakala, tacijimuka ku ŵawe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.15",
            "verseOrgIds": [
              "ACT.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ngutenda mwamacili gangu masiku gosope kuŵa ni nganisyo syambone pameso pa Mlungu ni ŵandu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.16",
            "verseOrgIds": [
              "ACT.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.16",
            "verseOrgIds": [
              "ACT.24.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pinaliji kwine kutyoka ku Yelusalemu kwa yaka yapanandi, napite kweleko kujigala mituka ja ŵandu ŵakulaga nipo soni kukutaga mbopesi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.17",
            "verseOrgIds": [
              "ACT.24.17"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.21.17+ACT.21.18+ACT.21.19+ACT.21.20+ACT.21.21+ACT.21.22+ACT.21.23+ACT.21.24+ACT.21.25+ACT.21.26+ACT.21.27+ACT.21.28"
              },
              "items": [
                {
                  "text": "Mase 21:17-28",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.17",
            "verseOrgIds": [
              "ACT.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jaliji ndaŵi jinatendaga yeleyi, ni pele jemanjaji ŵasimene une m'Nyumba ja AMBUJE ndili masile kutenda msyungu wakuliswejesya. Paliji pangali likuga lya ŵandu kapena njojo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.18",
            "verseOrgIds": [
              "ACT.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Ayuda ŵane ŵakutyocela kwa Asiya",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.19",
            "verseOrgIds": [
              "ACT.24.19"
            ]
          }
        },
        {
          "text": " ŵaliji papopo. Jemanjajo akajenele kuŵa apano pameso pawo kuti asale naga akwete cilicose cakwamba une. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.19",
            "verseOrgIds": [
              "ACT.24.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapena ŵakunde aŵa ŵanduŵa ŵali apanoŵa kuti asale naga ŵasimene ni cakulemwa ndaŵi jinaliji mu nganya jawo jajikulungwa ja magambo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.20",
            "verseOrgIds": [
              "ACT.24.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cakulemwa cangu mpaka ciŵe aci cakuti, nagumisile pinaliji pa nganya jawo kuti, ‘Akunjimba magambo une lelo ligongo ngukulupilila kuti ŵandu ŵawe tacijimuka ku ŵawe.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.21",
            "verseOrgIds": [
              "ACT.24.21"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.23.6"
              },
              "items": [
                {
                  "text": "Mase 23:6",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.21",
            "verseOrgIds": [
              "ACT.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Felikisi, ŵiŵasalilidwe cenene ya Litalali,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.22",
            "verseOrgIds": [
              "ACT.24.22"
            ]
          }
        },
        {
          "text": " ŵawugele magambogo acitiji, “Tinjilamula magambo genu pitayice Lisiasi, jwamkulungwa jwa asilikali.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.22",
            "verseOrgIds": [
              "ACT.24.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵamlamwile jwamkulungwa jwa asilikali kuti amlondeleje Paulo, nambo ampeje soni ufulu ni kwakunda acimjakwe kumpa yakusoŵa yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.23",
            "verseOrgIds": [
              "ACT.24.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo pameso pa Felikisi ni Dulusila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.23",
            "verseOrgIds": [
              "ACT.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
