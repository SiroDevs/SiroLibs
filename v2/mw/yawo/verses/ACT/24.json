              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piyamasile yaka yiŵili, Polokiyo Fesito",
          "type": "text",
          "attrs": {
            "verseId": "ACT.24.27",
            "verseOrgIds": [
              "ACT.24.27"
            ]
          }
        },
        {
          "text": " ŵajinjile m'malo ga Felikisi kuŵa bwanamkubwa. Felikisi ŵasosaga kuti Ayuda amnonyeleje, myoyo ŵamlesile Paulo jula m'nyumba ja akayidi.",
          "type": "text",
