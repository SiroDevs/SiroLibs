{
  "id": "ACT.27",
  "number": "27",
  "bookId": "ACT",
  "reference": "Mase 27",
  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
