{
  "id": "ACT.18",
  "number": "18",
  "bookId": "ACT",
  "reference": "Mase 18",
  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "ACT 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya ku Kolinto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe Paulo ŵatyosile kwa Atene ni ŵajawile ku Kolinto. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.1",
            "verseOrgIds": [
              "ACT.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko ŵamsimene Myuda jwine lina lyakwe Akwila, mlukosyo jwa ku Pontasi. Jwalakwe jwagambile kwika kwene kutyocela ku Itale pampepe ni ŵamkwakwe Pulisila, ligongo mwenye Klaudiyo ŵalamwile kuti, Ayuda wosope atyoce mcilambo ca ku Loma. Sambano Paulo ŵapite kukwalola jemanjajo, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.2",
            "verseOrgIds": [
              "ACT.18.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakuŵa jemanjajo ŵaliji amisili ŵakutota matenti mpela Paulojo, myoyo ŵatemi nawo ni kamulaga nawo masengo yimpepe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.3",
            "verseOrgIds": [
              "ACT.18.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyakupumula",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.4",
            "verseOrgIds": [
              "ACT.18.4"
            ]
          }
        },
        {
          "text": " lya Ayuda lililyose, Paulo ŵaliji mkuŵecetana ni ŵandu ku nyumba ja kupopelela, ni ŵaliji mkulinga kwapitikusya Ayuda ni Agiliki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.4",
            "verseOrgIds": [
              "ACT.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.4",
            "verseOrgIds": [
              "ACT.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice Sila ni Timoteo kutyocela ku Masedoniya, Paulo ŵapelece ndaŵi jakwe josope kulalicila maloŵe ga Mlungu, ni kwasimicisya Ayuda kuti Yesu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.5",
            "verseOrgIds": [
              "ACT.18.5"
            ]
          }
        },
        {
          "text": " ni Mkulupusyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.5",
            "verseOrgIds": [
              "ACT.18.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jemanjajo ŵalimbene najo ni kumŵecetela yangalumbana yejinji, Paulo ŵatyosile nipo ŵakung'undile luwundu lya mu yakuwala yakwe ni ŵasalile kuti, “Naga mkusimana ni yisawusyo yiliyose mligambeje mwacimsyene ngaŵa une. Kutandila sambano jino ngwawula kwa ŵandu ŵa mitundu jine.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.6",
            "verseOrgIds": [
              "ACT.18.6"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.6",
            "verseOrgIds": [
              "ACT.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Paulo ŵatyosile kweleko ni ŵapite kutama ku nyumba ja mundu jwine lina lyakwe Tito Yusito. Jwalakwe jwaliji jwakumlambila Mlungu, nipo nyumba jakwe jaliji pakuŵandikana ni nyumba ja kupopelela. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.7",
            "verseOrgIds": [
              "ACT.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Klisipo jwamkulungwa jwa ku nyumba ja kupopelelajo pampepe ni liŵasa lyakwe lyosope ŵakulupilile Ambuje. Nipo ŵandu ŵajinji ŵa ku Kolinto piŵapikene maloŵego ŵakulupilile mpaka ŵabatisidwe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.8",
            "verseOrgIds": [
              "ACT.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.8",
            "verseOrgIds": [
              "ACT.18.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilo cine Ambuje ŵamwonecele Paulo m'mesomkulola ni ŵamsalile kuti, “Mkasimjogopa kose, nambo mpitilisye kulalicila nipo mkatama jii, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.9",
            "verseOrgIds": [
              "ACT.18.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "paja Une ndili ni m'mwejo. Pangali mundu atamose jumo jutacimkwaya kuti amtendele yangalumbana, soni ngwete ŵandu ŵajinji mu msinda muno ŵali ŵangu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.10",
            "verseOrgIds": [
              "ACT.18.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Paulo ŵatemi kweleko kwa caka cimo ni miesi msano ni umo ali mkwiganya ŵandu maloŵe ga Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ayuda ŵamjigalile Paulo ku nganya ja Galiyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.11",
            "verseOrgIds": [
              "ACT.18.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Galiyo piŵaliji bwanamkubwa",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.12",
            "verseOrgIds": [
              "ACT.18.12"
            ]
          }
        },
        {
          "text": " jwa ku Akaya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.12",
            "verseOrgIds": [
              "ACT.18.12"
            ]
          }
        },
        {
          "text": " Ayuda wosope ŵapangene ni ŵamkamwile Paulo ni kumjigalila ku nganya ja magambo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.12",
            "verseOrgIds": [
              "ACT.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵatite, “Aju munduju akwanyenjelela ŵandu kuti amlumbeje Mlungu mlitala lyangajenelana kose ni malamusi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.13",
            "verseOrgIds": [
              "ACT.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.13",
            "verseOrgIds": [
              "ACT.18.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵatiji aŵecete Paulo, Galiyo ŵatite kwa Ayuda ŵala kuti, “Gakaŵe magambo gakuti mundu alemwecesye lilamusi, kapena amlemwecesye mjakwe, ni kuti pelepo ni ngampikanile jemanja Ayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.14",
            "verseOrgIds": [
              "ACT.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pakuti mkukangana ligongo lya maloŵe, ni mena nipo soni malamusi genu, lamulani mwacimsyene yeleyi. Une ngimba jwakulamula pa yindu ayi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.15",
            "verseOrgIds": [
              "ACT.18.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵatopwele ku nganyako. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.16",
            "verseOrgIds": [
              "ACT.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo likuga lyosopelyo lyamkamwile Sositeni, jwamkulungwa jwa nyumba jakupopelela jila, ni ŵamputile panganya papopo. Nambo Galiyo nganasamala kose yeleyi.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.17",
            "verseOrgIds": [
              "ACT.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akuwujila ku Antiokeya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.17",
            "verseOrgIds": [
              "ACT.18.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵatemi masiku gejinji ku Kolinto. Ŵalanjile acalongo acimjakwe ni ŵajinjile mcombo kwawula ku Siliya pampepe ni Pulisila ni Akwila. Nambo mkanatyoce, Paulo ŵamyosile umbo syakwe ku Kenkiliya, ligongo ŵatesile cilanga",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "text": " ni Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.18"
              },
              "items": [
                {
                  "text": "Num 6:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.18",
            "verseOrgIds": [
              "ACT.18.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo jemanjajo ŵayice ku Aefeso kuŵalesile Pulisila ni Akwila. Paulo jikape ŵajinjile m'nyumba jakupopelela ni ŵaŵecetanaga ni Ayuda. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.19",
            "verseOrgIds": [
              "ACT.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵala ŵamŵendile kuti atame nawo kwa masiku gejinji, nambo jwalakwe jwakanile. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.20",
            "verseOrgIds": [
              "ACT.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalanjile nipo ŵasalile kuti, “Naga Mlungu akusaka tinjiyika soni.” Nipo ŵatyosile ku Aefeso mcombo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
            "verseOrgIds": [
              "ACT.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.21",
            "verseOrgIds": [
              "ACT.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice ku Kaisaleya, ŵapite ku Yelusalemu kukuwukomasya mpingo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
            "verseOrgIds": [
              "ACT.18.22"
            ]
          }
        },
        {
          "text": " Kaneko ŵajawile ku Antiokeya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.22",
            "verseOrgIds": [
              "ACT.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵatemi kweleko masiku kwa kandaŵi, ŵatyosile nipo ŵajesilejesile mu upande ŵa Galatiya",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
              "ACT.18.23"
            ]
          }
        },
        {
          "text": " ni Filijiya, alimkwalimbikasya ŵakulijiganya",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
              "ACT.18.23"
            ]
          }
        },
        {
          "text": " wosope.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
              "ACT.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya Apolo ku Aefeso",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.23",
            "verseOrgIds": [
              "ACT.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myuda jwine lina lyakwe Apolo, juŵapagwile ku Alekisandiliya, ŵayice ku Aefeso. Jwaliji mundu jwakumanyilila kuŵeceta cenene ni kumanyilila Malemba. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.24",
            "verseOrgIds": [
              "ACT.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju ŵalijiganyisye ya kuŵa jwakulupilila jwa Ambuje, nipo ni cangu cakwe ŵaŵecetaga ni kwiganya ya Yesu mwakulongosoka cenene, atamose kuti ŵagambaga kumanyilila ya ubatiso ŵa Yohanepe basi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.25",
            "verseOrgIds": [
              "ACT.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Apolo ŵatandite kuŵeceta mwakulimba mtima m'nyumba ja kupopelela. Nambo piŵampikene Pulisila ni Akwila, ŵamjigele kuja najo kumangwawo ni ŵamsalile cenene ya Litala",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.26",
            "verseOrgIds": [
              "ACT.18.26"
            ]
          }
        },
        {
          "text": " lya Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.26",
            "verseOrgIds": [
              "ACT.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Apolo ŵaganisisye kwawula ku Akaya, myoyo acalongo acimjakwe ŵamlimbisye mtima pakwalembela cikalata ŵakulijiganya ŵa kweleko kuti mpocele cenene. Sambano Apolo piŵayice kweleko, ŵakamucisye kwejinji ŵele ŵiŵaliji ŵakulupilila ligongo lya umbone mtima ŵa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.27",
            "verseOrgIds": [
              "ACT.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja jwalakwe ŵasisyanile ni Ayuda pa luŵala, ni kwasimicisya kutyocela m'Malemba kuti Yesu ni Mkulupusyo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.18.28",
            "verseOrgIds": [
              "ACT.18.28"
            ]
          }
        }
      ]
    }
