              "ACT.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni ngaŵa mkutumicilidwa ni makono ga ŵandu, mpela kuti Jwalakwe akusasoŵa kandu. Pajatu asyene akusiŵapa ŵandu wosope umi, lipuje ni yine yosope. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.25",
            "verseOrgIds": [
              "ACT.17.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela kwa mundu jumo, Jwalakwe ŵapanganyisye mitundu josope ja ŵandu, kuti atame pa cilambo cosope capasi. Ŵakolocesye cilepe ndaŵi jawo jisyesyene, nipo soni malile gakutama gawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.26",
            "verseOrgIds": [
              "ACT.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵatesile yeleyi kuti ŵandu msoseje Jwalakwejo, kuti mwine ni kumsimana. Nambope Mlungu nganaŵa kose pakutalika ni jwalijose mwa jwetuwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.27",
            "verseOrgIds": [
              "ACT.17.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwine jwatite,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.28",
            "verseOrgIds": [
              "ACT.17.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.31",
            "verseOrgIds": [
              "ACT.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu piŵampikene Paulo aciŵecetaga ya kwimuka ku ŵawe, ŵane ŵaliji mkumseka, nambo ŵane ŵatite, “Tukusaka kupikana mciŵecetaga soni yeleyi.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.32",
            "verseOrgIds": [
              "ACT.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Paulo ŵatyosile pasikati pawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.33",
            "verseOrgIds": [
              "ACT.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo acalume ŵane ŵajinjile mwikuga lyakwe ni ŵakulupilile, mwa ŵele ŵanduwo ŵapali Diyonisiyo, jumo jwa nganya ja Aleopagi; ŵapali soni jwamkongwe lina lyakwe Damalisi, ni ŵandu ŵane soni.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.17.34",
            "verseOrgIds": [
              "ACT.17.34"
            ]
          }
        }
      ]
    }
