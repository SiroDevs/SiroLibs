                {
                  "text": "Det 18:15",
                  "type": "text"
                }
              ]
            },
            {
              "text": ",",
              "type": "text"
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.18.18"
              },
              "items": [
                {
                  "text": "18",
