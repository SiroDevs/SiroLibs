                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.22",
            "verseOrgIds": [
              "ACT.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
