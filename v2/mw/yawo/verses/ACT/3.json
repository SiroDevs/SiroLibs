{
  "id": "ACT.3",
  "number": "3",
  "bookId": "ACT",
  "reference": "Mase 3",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "ACT 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Petulo ŵamposisye mundu jwamlemale ngongolo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line Petulo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.1",
            "verseOrgIds": [
              "ACT.3.1"
            ]
          }
        },
        {
          "text": " ni Yohane",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.1",
            "verseOrgIds": [
              "ACT.3.1"
            ]
          }
        },
        {
          "text": " ŵapite ku Nyumba ja AMBUJE ndaŵi ja kupopela ja 3 koloko ligulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.1",
            "verseOrgIds": [
              "ACT.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵane ŵamnyakwile mundu jwine jwamlemale ngongolo cipagwile. Masiku gosope ŵamŵikaga pa mlango wa Nyumba ja AMBUJE, ŵakuŵilanjidwa, “Mlango wakusalala,” kuti jwelejo aŵendeje ŵandu wakwinjila m'Nyumbamo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.2",
            "verseOrgIds": [
              "ACT.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaweni Petulo ni Yohane alimkwinjila m'Nyumbamo, ŵaŵendile kuti amgaŵile mbiya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.3",
            "verseOrgIds": [
              "ACT.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵamlolecesye mundujo, nipo Petulo ŵatite, “Mtulole uwe.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.4",
            "verseOrgIds": [
              "ACT.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo jwalakwe ŵalolecesye, alimkwembecela kuti tapocele cindu kutyocela kwa jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.5",
            "verseOrgIds": [
              "ACT.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Petulo ŵatite, “Jwangali mbiya, nambo tinampe aco cingwete, mu lina lya Yesu Klistu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.6",
            "verseOrgIds": [
              "ACT.3.6"
            ]
          }
        },
        {
          "text": " jwa ku Nasaleti, mjende.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.6",
            "verseOrgIds": [
              "ACT.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ŵamkamwile mkono wakwe wamlyo ni ŵamjimice. Pelepo ngongolo syakwe ni yisukusuku yakwe nombe nayo yalimbangene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.7",
            "verseOrgIds": [
              "ACT.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasumbile, ni ŵajimi, ni ŵatandite kwenda nipo ŵajinjile m'Nyumba ja AMBUJE jila pampepe ni jemanjajo, ŵajendaga kwine alimkusumbasumba, nambo alimkulumba Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.8",
            "verseOrgIds": [
              "ACT.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu wosope ŵam'weni alimkwenda kwine alimkulumba Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.9",
            "verseOrgIds": [
              "ACT.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵam'manyilile mundu jula kuti ni jujojo juŵatamaga pa mlango wakusalala wa Nyumba ja AMBUJE nikuŵendaga, nipo ŵasimonjile mnope ni kulapa ligongo lya yele yiyamtendecele mundujo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.10",
            "verseOrgIds": [
              "ACT.3.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloŵe ga Petulo m'Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.10",
            "verseOrgIds": [
              "ACT.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jula ŵamkanilile Petulo ni Yohane, nipo ŵandu wosope ŵasimonjile, ni ŵawutucile kwipenu lyakuŵilanjidwa, “Lipenu lya Solomoni.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.11",
            "verseOrgIds": [
              "ACT.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayiweni yeleyi Petulo ŵaŵecete nawo ŵanduwo kuti, “Jemanja Aisalaeli, ana mkusimonga yeleyi? Ana uli mkutulolecesya uwe mpela kuti tukombwele kumjendesya munduju ni macili getu? Kapena mkupela kuti ligongo uwe tuli ŵakumlumba Mlungu mnope? ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.12",
            "verseOrgIds": [
              "ACT.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu juŵamlambilaga acinangolo ŵetu, Abulahamu,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.13",
            "verseOrgIds": [
              "ACT.3.13"
            ]
          }
        },
        {
          "text": " Isaki ni Yakobo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.13",
            "verseOrgIds": [
              "ACT.3.13"
            ]
          }
        },
        {
          "text": " ŵapelece lumbili kwa Yesu, jwakutumicila jwakwe. Nambo jemanja mwampelece kwa amagongo ŵakwe ni kumkana pameso pa Pilato,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.13",
            "verseOrgIds": [
              "ACT.3.13"
            ]
          }
        },
        {
          "text": " atamose Pilato ŵalamwile kuti amgopole Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.13",
            "verseOrgIds": [
              "ACT.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.3.15"
              },
              "items": [
                {
                  "text": "Eks 3:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.13",
            "verseOrgIds": [
              "ACT.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵaliji ŵaswela mtima ni ŵakulupicika, nambo jemanja mwamkanile, nipo m'malo mwakwe mwaŵendile Pilato kuti amgopolele jwaciswamba.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.3.14",
            "verseOrgIds": [
              "ACT.3.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.27.15+MAT.27.16+MAT.27.17+MAT.27.18+MAT.27.19+MAT.27.20+MAT.27.21+MAT.27.22+MAT.27.23"
              },
              "items": [
                {
                  "text": "Mat 27:15-23",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.15.6+MRK.15.7+MRK.15.8+MRK.15.9+MRK.15.10+MRK.15.11+MRK.15.12+MRK.15.13+MRK.15.14"
              },
              "items": [
                {
                  "text": "Mak 15:6-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
