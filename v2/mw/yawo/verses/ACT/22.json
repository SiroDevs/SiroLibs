          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo ŵandu ŵiŵatiga amwusye yiwusyo Paulo ŵawujile panyuma, nombe najo jwamkulungwa jula ŵatesile woga piŵamanyilile kuti ŵamtaŵile mundu jwali mlukosyo jwa Ciloma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akwima ku nganya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
