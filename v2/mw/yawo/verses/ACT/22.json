          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.29",
            "verseOrgIds": [
              "ACT.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa asilikali jula ŵasakaga kusimana cisyesyene ciŵamjimbilaga Ayuda magambo Paulo. Myoyo kundaŵi kwakwe ŵamgopwele Paulo unyolo ni ŵalamwile kuti acakulungwa ŵa ŵakutaga mbopesi ni wosope ŵanganya ja magambo kuti asimane. Kaneko ŵamjigele Paulo ni kumjimika pameso pa wosopewo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.30",
            "verseOrgIds": [
              "ACT.22.30"
            ]
          }
