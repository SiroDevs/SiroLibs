  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "ACT 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Acalongo acimjangu Ayuda, mumbikanile une pangulicenjela pameso penu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.1",
            "verseOrgIds": [
              "ACT.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵampikene jwalakwejo ali mkuŵeceta Cihebeli, ŵapundile kutama jii mnope; nipo Paulo ŵapitilisye kuŵeceta acitiji:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.2",
            "verseOrgIds": [
              "ACT.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Une ndili Myuda, napagwile ku Talisasi ku Silisiya, nambo ndeledwe amuno mu Yelusalemu, Gamaliele",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.3",
            "verseOrgIds": [
              "ACT.22.3"
            ]
          }
        },
        {
          "text": " ŵaliji mwalimu jwangu jwele juŵanjiganyisye cenene kusunga Malamusi ga acinangolo ŵetu. Nipo naliji jwakulimbicila mnope ya Mlungu, mpela mwele mumkutendela wosope ŵamli apano lelo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.3",
            "verseOrgIds": [
              "ACT.22.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.5.34+ACT.5.35+ACT.5.36+ACT.5.37+ACT.5.38+ACT.5.39"
              },
              "items": [
                {
                  "text": "Mase 5:34-39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.3",
            "verseOrgIds": [
              "ACT.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naliji mkwalagasya ŵandu mpaka kwawulaga ŵele ŵiŵaliji mkukuya Litala",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.4",
            "verseOrgIds": [
              "ACT.22.4"
            ]
          }
        },
        {
          "text": " lya Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.4",
            "verseOrgIds": [
              "ACT.22.4"
            ]
          }
        },
        {
          "text": " Nakamulaga acalume ni acakongwe ni kwataŵisya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.4",
            "verseOrgIds": [
              "ACT.22.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.8.3"
              },
              "items": [
                {
                  "text": "Mase 8:3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.26.9+ACT.26.10+ACT.26.11"
              },
              "items": [
                {
                  "text": "26:9-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.4",
            "verseOrgIds": [
              "ACT.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        },
        {
          "text": " ni wosope ŵanganya ja Ayuda mpaka atendele umboni kuti nguŵeceta yakuwona. Napocele yikalata kutyocela kwa jemanjajo yakwalembela acanasi ŵa Ciyuda ku Damasiko. Myoyo najawile kweleko kukwakamula ŵele ŵanduwo ni kwisa nawo akuno ku Yelusalemu ali ŵataŵidwe ni unyolo kuti apocele cilango.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akwasalila yakupitikuka mtima kwakwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.5",
            "verseOrgIds": [
              "ACT.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pinaliji pa ulendowo nipo ndili mkuŵandicila ku Damasiko ndaŵi jili mpela 12 koloko musi, mwacisisimucisya lilanguka lyekulungwa lyakuŵala mnope lyakutyocela kwinani lyasyungulile une. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.6",
            "verseOrgIds": [
              "ACT.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nagwile pasi nipo napikene maloŵe gakuti, ‘Saulo,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.7",
            "verseOrgIds": [
              "ACT.22.7"
            ]
          }
        },
        {
          "text": " Saulo! Ligongo cici mkusawusya une?’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.7",
            "verseOrgIds": [
              "ACT.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une nawusisye kuti, ‘Ana ŵani wawo, Ambuje?’ Nipo ŵatite, ‘Une Yesu jwa ku Nasaleti, jumkusawusya.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.8",
            "verseOrgIds": [
              "ACT.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acimjangu ŵinaliji nawo ŵaliweni lilangukalyo, nambo nganapikana kose maloŵe ga ŵele ŵiŵaŵecetaga ni une. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.9",
            "verseOrgIds": [
              "ACT.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nawusisye kuti, ‘Ana ndende cici, Ambuje?’ Nipo Ambuje ŵatite kwa une kuti, ‘Mjimuce nipo mjawule mkati mwa Damasiko, kweleko takamsalile yosope yapanganyisye Mlungu kuti myitende.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.10",
            "verseOrgIds": [
              "ACT.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Natatele meso ligongo lya lilanguka lyakuŵala mnopelyo, myoyo acimjangu ŵala ŵangamwile pa mkono ni kumbecesya ku Damasiko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.11",
            "verseOrgIds": [
              "ACT.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kweleko kwapali mundu jwine lina lyakwe Ananiya. Ŵaliji ŵakogopa Mlungu nipo kusamala Malamusi getu nipo Ayuda wosope ŵakweleko ŵampaga ulemu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.12",
            "verseOrgIds": [
              "ACT.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo ŵayice ni ŵajimi pakuŵandikana ni une, ni ŵatite, ‘Mlongo mjangu Saulo, mtande kulola soni.’ Ndaŵi jijojo natandite soni kulola nipo nam'weni jwalakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.13",
            "verseOrgIds": [
              "ACT.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵatite, ‘Mlungu jwa acinangolo ŵetu amsagwile m'mwejo kuti m'manyilile yele yakusaka, ni kumwona Jwakulungama jula nipo mpikane maloŵe gapakamwa pakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.14",
            "verseOrgIds": [
              "ACT.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuti ticimtendelaga umboni kwa ŵandu wosope, yele yimyiweni ni kupikana. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.15",
            "verseOrgIds": [
              "ACT.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi sambano mkwembecela cici? Mjimuce ni m'batisidwe, nipo ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        },
        {
          "text": " wenu tiwucityoka pakumlumbaga Jwalakwejo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akutumidwa kukulalicila kwa ŵandu ŵa mitundu jine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.16",
            "verseOrgIds": [
              "ACT.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nawujile ku Yelusalemu, nipo pinaliji mkupopela m'Nyumba ja AMBUJE, naweni Ambuje mesomkulola, ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.17",
            "verseOrgIds": [
              "ACT.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "ali mkuti kwangune, ‘Mjanguye mtyoce mu Yelusalemu muno mwacitema, ligongo ŵandu ŵakunokunoŵa ngajiticisya kose umboni wenu wamkusala ya Une.’ ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.18",
            "verseOrgIds": [
              "ACT.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo natite, ‘Ambuje, acimsyeneŵa akumanyilila cenene kuti najawulaga ku nyumba syakupopelela ni kuja kwataŵa ni kwaputa wosope ŵele ŵiŵakulupilile wawo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.19",
            "verseOrgIds": [
              "ACT.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo piŵawulajidwaga Sitefano mboni jenu, une naliji papopo. Najiticisye nipo une nasungaga yakuwala ya ŵandu ŵakuwulagawo.’",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.7.58"
              },
              "items": [
                {
                  "text": "Mase 7:58",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.20",
            "verseOrgIds": [
              "ACT.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ambuje ŵatite, ‘Tyokani, pakuti tinamtume kwakutalika kwa ŵandu ŵa mitundu jine.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.21",
            "verseOrgIds": [
              "ACT.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanduwo ŵampikanile Paulo cenene nambo piŵaŵecete maloŵe gakumalisyago, ŵandu ŵatandite kugumila kwakulimbika maloŵe gawo acitiji, “Mundu jwamti myiyi awulajidwe, ngakwenela kutama ni umi!” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.22",
            "verseOrgIds": [
              "ACT.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵaliji mkugumilape ni kupukunyaga yakuwala yawo soni kuponyaga luwundu mwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.23",
            "verseOrgIds": [
              "ACT.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo jwamkulungwa jwa asilikali ŵa Ciloma jula ŵalamwile kuti Paulo ajinjile najo m'nyumba ja asilikalijo. Ŵasalile kuti amkwapule Paulo kuti asale ligongo lyakwe cici Ayuda ŵaliji kumgumila jwalakwe camti myoyo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.24",
            "verseOrgIds": [
              "ACT.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo piŵamtaŵile kuti ampute jwalakwejo, Paulo ŵatite kwa jwamkulungwa jwa asilikali juŵajimi pelepo kuti, “Ana malamusi genu gakunda kumkwapula mlukosyo jwa Ciloma mkanajimbidwe magambo?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.25",
            "verseOrgIds": [
              "ACT.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa asilikali jula piŵapikene yeleyi, ŵapite kwa jwamkulungwa jwakwe ni ŵamwusisye kuti, “Ana yimkutendayi ni yapi? Mundu julatu ali mlukosyo jwa Ciloma.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.26",
            "verseOrgIds": [
              "ACT.22.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.26",
            "verseOrgIds": [
              "ACT.22.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni pelepo jwamkulungwa jwa asilikalijo ŵapite kwa Paulo ni ŵamwusisye kuti, “Musalile, ana m'mweji mli mlukosyo jwa Ciloma?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe ŵatite, “Elo.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 22:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.27",
            "verseOrgIds": [
              "ACT.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano jwamkulungwa jula ŵatite, “Une natesile yakusuma ni mbiya ulukosyo wanguwu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵatite, “Nambo une ndili mlukosyo pakupagwa.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.22.28",
            "verseOrgIds": [
              "ACT.22.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
