              },
              "items": [
                {
                  "text": "Mase 15:29",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 21:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.25",
            "verseOrgIds": [
              "ACT.21.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo Paulo ŵajigele ŵandu mcece ŵala, kundaŵi kwakwe ŵatesile pampepe msyungu ŵakuliswejesyawo. Kaneko Paulo ŵajinjile m'Nyumba ja AMBUJE ni ŵamsalile jwakutaga mbopesi lisiku lyakumalila msyungu wakuliswejesya, mpela soni lisiku lyakupeleka mbopesi jwalijose jwa jemanjajo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akumkamula Paulo m'Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 21:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.26",
            "verseOrgIds": [
              "ACT.21.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 21:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pigasigele panandi kumala masiku msano kwisa gaŵili ga msyungu wakuliswejesya ula, Ayuda ŵane ŵakutyocela ku Asiya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "text": " ŵamŵeni Paulo m'Nyumba ja AMBUJE mula. Nipo jemanjajo ŵalitandite likuga lya ŵandulyo ni kumkamula Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.27",
            "verseOrgIds": [
              "ACT.21.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 21:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵanduwo ŵagumisile acitiji, “Jemanja Aisalaeli, mtukamucisye! Aju munduju akupita mcijiganyaga ŵandu yakunyosya mtundu wetu, Malamusi ga Mose, nipo soni Nyumba ja AMBUJE. Nipo sambano ŵajinjisye ŵandu ŵa mitundu jine m'Nyumba ja AMBUJE muno ni kugasakasya malo gamaswelaga.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.28",
            "verseOrgIds": [
              "ACT.21.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ŵaŵecete yeleyi ligongo ŵamŵeni Tulofimo jwa ku Aefeso ali ni Paulo mu msinda, ni ŵaganisyaga yakuti Paulo ni ŵamjinjisye jwalakwejo m'Nyumba ja AMBUJEJO.)",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.20.4"
              },
              "items": [
                {
                  "text": "Mase 20:4",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 21:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.29",
            "verseOrgIds": [
              "ACT.21.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 21:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msinda wosope wasokonecele, ni ŵandu wosope ŵawutucile pampepe ni ŵamkamwile Paulo, ni ŵamwutile kusa kwa Nyumba ja AMBUJE jila. Mwacitemacitema, milango ja Nyumbajo jawugalidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.30",
            "verseOrgIds": [
              "ACT.21.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 21:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jiŵasakaga ŵandu kumwulaga Paulo, jwamkulungwa jwa likuga lya asilikali ŵa ngondo ŵa Ciloma ŵapocele utenga kuti mu msinda wosope wa Yelusalemu mwana njojo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.31",
            "verseOrgIds": [
              "ACT.21.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 21:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo jwalakwe ŵajigele acakulungwa ŵane pamo ni asilikali ŵa ngondo nipo wosope ŵawutucile kuŵaliji ŵanduwo. Ŵandu piŵam'weni jwalakwejo ni asilikaliwo, ŵamlesile kumputa Paulojo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.32",
            "verseOrgIds": [
              "ACT.21.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 21:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo jwamkulungwa jwa asilikali ŵangondojo ŵayice ni kumkamula Paulo nipo ŵamlamwile kuti amtaŵe ni maunyolo gaŵili. Kaneko ŵawusisye kuti, “Ana munduju nduni, soni atesile cici?” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.33",
            "verseOrgIds": [
              "ACT.21.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 21:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanduwo ŵajanjile yakulekangana mwagumila, ŵane yine soni ŵandu ŵane yawo. Myoyo papali lisegwe mwakuti jwamkulungwa jwa asilikali jula ŵalepele kuti asimane cisyesyene cicatendekwe. Myoyo ŵalamwile ŵandu ŵakwe kuti Paulojo amjigale, ajawule najo ku malo gakutama asilikali. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.34",
            "verseOrgIds": [
              "ACT.21.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 21:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice najo pa makwelelo, asilikali ŵala ŵam'nyakwile Paulo ligongo ŵanduwo ŵakalipe mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.35",
            "verseOrgIds": [
              "ACT.21.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wosopewo ŵakuyaga ali mkugumila kuti, “Mumwulaje jwelejo!”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akulicenjela msyene",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 21:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.36",
            "verseOrgIds": [
              "ACT.21.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵasigele panandi kwinjila m'nyumba jakutama asilikaliwo, Paulo ŵamŵendile jwamkulungwa jwa asilikali ŵala kuti, “Ana mpaka angunde kuti mbecete kandu kwa jemanja?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 21:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa asilikali jula ŵamwusisye kuti, “Ana mkusaŵecetaga Cigiliki?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.37",
            "verseOrgIds": [
              "ACT.21.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ana nganimŵa m'mwejo mu Iguputo jula juŵatandisye njojo masiku gapitega, ni kuyilongolelaga yigaŵenga 4,000 mpaka mcipululu?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 21:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.38",
            "verseOrgIds": [
              "ACT.21.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 21:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵajanjile kuti, “Une ndili Myuda, napagwile ku Talisasi ku msinda wa Silisiya. Conde mungunde kuti mbecete nawo ŵanduŵa.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.39",
            "verseOrgIds": [
              "ACT.21.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 21:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa asilikali ŵala ŵamkundile, nipo Paulo ŵajimi pa makwelelo acitenganyaga mkono wakwe kwa ŵandu kuti atame jii. Piŵatemi jii, Paulo ŵaŵecete kwa ŵanduwo mu Cihebeli.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.21.40",
            "verseOrgIds": [
              "ACT.21.40"
            ]
          }
        }
      ]
    }
  ],
