        "sid": "ACT 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akuŵenda kuti magambo gakwe alamule Mwenye jwa ku Loma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gali gapite masiku gatatu Fesito",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.1",
            "verseOrgIds": [
              "ACT.25.1"
            ]
          }
        },
        {
          "text": " ali ayice ku dela jawo, ŵapite ku Yelusalemu kutyocela ku Kaisaleya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.1",
            "verseOrgIds": [
              "ACT.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko acakulungwa ŵa ŵakutaga mbopesi nipo soni ŵakulongolela ŵa Ayuda, ŵamsalile ya magambo ga Paulo. Ŵamŵendile Fesito kuti ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.2",
            "verseOrgIds": [
              "ACT.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵasalalile mtima kuti ajawule najo Paulo ku Yelusalemu, pakuŵa ŵaliŵicile cilepe kuti atende ciswamba ca kumwulaga jwalakwejo mwitala. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.3",
            "verseOrgIds": [
              "ACT.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesito ŵajanjile kuti, “Paulo akusunjidwa m'nyumba ja akayidi ku Kaisaleya, nipo une tinjawule kweleko pangakaŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.4",
            "verseOrgIds": [
              "ACT.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo acakulungwa ŵenu alongane pampepe ni une kwawula ku Kaisaleya kuti akapelece umboni wa munduju naga ŵalemwisye.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.5",
            "verseOrgIds": [
              "ACT.25.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.5",
            "verseOrgIds": [
              "ACT.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesito ŵatemi nawo kwa masiku msano kwisa gatatu kapena likumi, kaneko ŵapite ku Kaisaleya. Kundaŵi kwakwe ŵatemi pa citengu cakwe cakulamulila Magambo ni ŵamŵilasile Paulo kuti ayice najo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.6",
            "verseOrgIds": [
              "ACT.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice Paulo, Ayuda ŵiŵayice kutyocela ku Yelusalemu ŵala ŵamsyungulile ni ŵatandite kusala yindu yakogoya yejinji yiŵatesile Paulo yakuti acimsyene ŵalepele kupeleka umboni ŵakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.7",
            "verseOrgIds": [
              "ACT.25.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Paulo ŵalicenjele msyene acitiji, “Une pangali cindesile cakasa Malamusi ga Ayuda kapena Nyumba ja AMBUJE atamose Mwenye jwa ku Loma.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.8",
            "verseOrgIds": [
              "ACT.25.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.8",
            "verseOrgIds": [
              "ACT.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Fesito ŵasakaga kuti Ayuda amnonyele, ni ligongo lyakwe ŵamwusisye Paulo kuti, “Ana mkusaka kwawula ku Yelusalemu kuti tukaŵecete magambo genu pameso pangu?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.9",
            "verseOrgIds": [
              "ACT.25.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.9",
            "verseOrgIds": [
              "ACT.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵatite, “Une njimi pameso pa nganya ja Mwenye jwa ku Loma, kweleko ni kutaŵecete magambo gangu. Ayudaŵa une nganinalemwecesya kandu kalikose, mpela mwakumanyilila ŵalakwe cenene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.10",
            "verseOrgIds": [
              "ACT.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga une ndemwisye, kapena kuti ndesile kandu kakwenela kuti une mbulajidwe, une ngangukana kuwulajidwako. Nambo naga yakumbecetelayi nganiyiŵa yakuwona, ni pangali mundu jutakombole kumbeleka kwa jemanjajo. Apo nguŵenda kuti Mwenye jwa ku Loma akalamule magambo gangu.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.11",
            "verseOrgIds": [
              "ACT.25.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.11",
            "verseOrgIds": [
              "ACT.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Fesito ŵaŵecetene ni ŵandu ŵa nganya jakwe nipo ŵamjanjile kuti, “Cambone mŵendile kuti akamlamule Mwenye jwa ku Loma, nipo kwa Mwenyeko timjawule.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.12",
            "verseOrgIds": [
              "ACT.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo pameso pa Agilipa ni Belenise",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.12",
            "verseOrgIds": [
              "ACT.25.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gali gapite masiku, Mwenye Agilipa pampepe ni Belenise ŵayice ku Kaisaleya kukwakomasya ni kwapocela Fesito. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.13",
            "verseOrgIds": [
              "ACT.25.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵatemi kweleko kwa masiku gapanandi, Fesito ŵamsalile mwenyejo magambo ga Paulo. Kwana mundu jwine akuno juŵamlesile Felikisi",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.14",
            "verseOrgIds": [
              "ACT.25.14"
            ]
          }
        },
        {
          "text": " m'nyumba ja akayidi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.14",
            "verseOrgIds": [
              "ACT.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pinapite ku Yelusalemu, acakulungwa ŵa ŵakutaga mbopesi ni acakulungwa ŵane ŵa Ayuda ŵasalile ya jwelejo ni ŵambendile kuti mbecete magambo gakwe nipo lamule kuti ŵalemwisye. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.15",
            "verseOrgIds": [
              "ACT.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo nasalile jemanjajo kuti nganiwuŵa msyungu wa Aloma",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.16",
            "verseOrgIds": [
              "ACT.25.16"
            ]
          }
        },
        {
          "text": " kumpeleka mundu jwakwimbidwa magambo mkanawonegane ni ŵakumjimba magambogo kuti alicenjele jika yakumŵecetelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.16",
            "verseOrgIds": [
              "ACT.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice akuno nganinjasa kose ndaŵi, kundaŵi kwakwe natemi pa citengu cakulamulila magambo, nipo nasalile kuti ayice najo mundujo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.17",
            "verseOrgIds": [
              "ACT.25.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakumjimba magambo ŵala piŵajimi, ŵalepele kupeleka umboni usyesyene ŵele une naliji mkuwuganicisya. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.18",
            "verseOrgIds": [
              "ACT.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵagambaga kusisyana najo pa ngani ja dini jawo, nipo soni ya mundu jwine juŵawile lina lyakwe Yesu, nambo Paulo akuti aliciŵela umi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.19",
            "verseOrgIds": [
              "ACT.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lunda lwamalile lwakuti asimane umboni usyesyene pa ngani jeleji. Myoyo nam'wusisye Paulo kuti naga akusaka kwawula ku Yelusalemu kuti magambo gakwe gakaŵecetedwe kweleko. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.20",
            "verseOrgIds": [
              "ACT.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Paulo ŵaŵendile kuti magambo gakwe tigalamulidwe ni Mwenye jwa ku Loma jwalakwe ali asunjidwe m'nyumba ja akayidi. “Ni nalamwile kuti asunjidweje mpaka ndili namtumisye kwa Mwenye jwa ku Loma.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.21",
            "verseOrgIds": [
              "ACT.25.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.21",
            "verseOrgIds": [
              "ACT.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agilipa ŵatite kwa Fesito, “None jwakwe ngusaka nampikane namsyene mundu jweleju.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fesito ŵatite, “Timumpikanile malaŵi.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.22",
            "verseOrgIds": [
              "ACT.25.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kundaŵi kwakwe Agilipa ni Belenise ŵayice ni ucimbicimbi wawukulungwa. Ŵajinjile mu nganya ja magambo pamo ni acakulungwa ŵa asilikali ni acakulungwa ŵa mu msindamo. Kaneko Fesito ŵalamwile kuti Paulo ajawule najo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.25.23",
            "verseOrgIds": [
              "ACT.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
