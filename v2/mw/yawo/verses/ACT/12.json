          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku liŵalisagwile, Helodi ŵawete yakuwala ya ucimwene ni kutama pa mpando wakwe wa ucimwene ni ŵatandite kuŵeceta kwa ŵanduwo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.21",
            "verseOrgIds": [
              "ACT.12.21"
            ]
          }
