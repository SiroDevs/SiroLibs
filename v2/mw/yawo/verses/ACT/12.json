              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanduwo ŵaŵecete mwakwesya maloŵe kuti, “Gelega ni maloŵe ga Mlungu, ngaŵa ga mundu wamba.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.22",
            "verseOrgIds": [
              "ACT.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo lilayika lya Ambuje, lyamputile Helodi ni ŵagwile pasi ligongo nganapeleka ulemu kwa Mlungu. Mbisu syamlile nipo ŵawile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.12.23",
            "verseOrgIds": [
              "ACT.12.23"
            ]
          }
        }
