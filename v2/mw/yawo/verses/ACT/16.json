{
  "id": "ACT.16",
  "number": "16",
  "bookId": "ACT",
  "reference": "Mase 16",
  "verseCount": 40,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "16",
        "style": "c",
        "sid": "ACT 16"
      },
      "items": [
        {
          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Timoteo akwapecesya Paulo ni Sila",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ŵayice ku Delibe ni ku Lisitala. Kweleko kwapali jwakulijiganya jwine lina lyakwe Timoteo. Mamagwe ŵaliji Myuda jwakulupilila, nambo babagwe ŵaliji Mgiliki.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.1",
            "verseOrgIds": [
              "ACT.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵakulupilila wosope ŵa ku Lisitala ni ŵa ku Ikoniyamu ŵaŵecetaga yambone ya Timoteo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.2",
            "verseOrgIds": [
              "ACT.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakuti Paulo ŵasacile kuti ajende najo Timoteojo. Ni ŵamwumbesye ligongo lyakuti Ayuda ŵiŵaliji kweleko, ŵamanyililaga kuti babawo Timoteo ali Mgiliki. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.3",
            "verseOrgIds": [
              "ACT.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jiŵapitaga m'misinda, ŵasalilaga malamusi ŵandu ŵakulupilila ŵala, gele ŵandumetume pampepe ni acakulungwa ŵa mpingo",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "text": " ŵa ku Yelusalemu ŵapanganyisye, kuti agasunjeje. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.4",
            "verseOrgIds": [
              "ACT.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo cikulupi ca mipingo caliji mkulimbangana mnope, nipo lisiku ni lisiku ŵandu ŵajinjilaga ŵajinji m'mipingomo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo ŵam'weni mundu jwa ku Masedoniya m'mesomkulola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.5",
            "verseOrgIds": [
              "ACT.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo pampepe ni acimjakwe ŵajesile mpaka ŵapundile upande ŵa Filijiya ni Galatiya,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "text": " ligongo lyakuti Msimu Ŵaswela ŵalekasisye kulalicila Ngani Syambone",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "text": " mu upande wa Asiya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.6",
            "verseOrgIds": [
              "ACT.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice m'malile ga Misiya, ni ŵalinjile kwinjila mcilambo ca Bitiniya, nambo Msimu wa Yesu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.7",
            "verseOrgIds": [
              "ACT.16.7"
            ]
          }
        },
        {
          "text": " nganiŵakunda kwinjila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.7",
            "verseOrgIds": [
              "ACT.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵajesile ni kupelenganya Misiya ni ŵajile kwika ku Tulowasi. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.8",
            "verseOrgIds": [
              "ACT.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi ja cilo, Paulo ŵam'weni mundu jwa ku Masedoniya m'mesomkulola ali ajimi lisi line ali mkuŵilanga kuti, “Mjombocele ku Masedoniya kuno, kuti mtukamucisye.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.9",
            "verseOrgIds": [
              "ACT.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo piŵayiweni yeleyi m'mesomkulola, twaliŵicile cile ulendo ŵakwawula ku Masedoniya, ligongo twaganisisye kuti ali Mlungu ni ŵatuŵilasile kuti tukalalicile Ngani Syambone kwa ŵandu kweleko.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lidiya jwa ku Filipi ŵagalawice mtima",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.10",
            "verseOrgIds": [
              "ACT.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ku Tulowasi twajesile mcombo kulunjika ku Samotilase, nipo ku ndaŵi kwakwe twayice ku Neapoli. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.11",
            "verseOrgIds": [
              "ACT.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela kweleko twajesile mu mkulipe mpaka twayice ku Filipi,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        },
        {
          "text": " msinda wawukulungwa wa Masedoniya, nipo soni boma ja Aloma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        },
        {
          "text": " Twatemi kweleko kwa masiku nditu. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.12",
            "verseOrgIds": [
              "ACT.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyakupumula",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.13",
            "verseOrgIds": [
              "ACT.16.13"
            ]
          }
        },
        {
          "text": " lya Ayuda twakopwece mu msindamo kwawula mungulugulu lusulo kutwaganicisyaga kuti kwana malo gakupopelela. Sambano uwe twatemi pasi ni kuŵecetanaga ni acakongwe ŵiŵasongene pelepo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.13",
            "verseOrgIds": [
              "ACT.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumo mwa jemanjajo juŵatupikene uwe, lina lyakwe lyaliji Lidiya. Jwaliji jwa kutyocela mu msinda wa Tiyatila, nipo masengo gakwe galiji gakusumisya nguwo syecejewu. Ŵaliji mundu jwa kupopela ni kogopa Mlungu, nipo Ambuje ŵamwugwile mtima wakwe kuti ayisunje yiŵaŵecetaga Paulo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.14",
            "verseOrgIds": [
              "ACT.16.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe pampepe ni ŵa mwiŵasa lyakwe ali amasile kubatisidwa, ŵatuŵendile kuti, “Naga ambweni kuti ndili mundu jwakulupilila Ambuje, kwende tukatameje ku nyumba jangu.” Nipo ŵatukanganice mpaka twapite nditu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo ni Sila ŵaponyisye m'nyumba ja akayidi ku Filipi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.15",
            "verseOrgIds": [
              "ACT.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line tuli mkwawula ku malo gakupopelela, twasimene najo kapolo jwa cisikana jwele juŵakamwilwe ni misimu jakusakala",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.16",
            "verseOrgIds": [
              "ACT.16.16"
            ]
          }
        },
        {
          "text": " jijamŵecetekasyaga ya pasogolo. Jwapatisyaga yipanje ambujegwe yele yiŵapelekaga ŵandu pakwasalila yindu yitiyawonecele. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.16",
            "verseOrgIds": [
              "ACT.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo jwakuyaga Paulo ni uwe, ali mkugumila kuti, “Aŵa ŵanduŵa ni ŵakutumicila Mlungu Jwakupunda yindu yosope, akulalicila kwa jemanja litala lya cikulupusyo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.17",
            "verseOrgIds": [
              "ACT.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kapolojo jwatesile yeleyi kwa masiku gejinji. Mwakuti Paulo ŵapesile nayo yeleyo mpaka ŵamgalawucile ni kujisalila misimu jakusakala jila kuti, “Mu lina lya Yesu Klistu",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        },
        {
          "text": " ngumlamula jemanja kuti mkopoce mwa jweleju.” Nipo ndaŵi jijojo misimu ja kusakala jila jakopwece. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.18",
            "verseOrgIds": [
              "ACT.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayiweni acambujegwe ŵala kuti mwa kapolojo ngapatila soni yipanje, ŵamkamwile Paulo pampepe ni Sila ni ŵajawile nawo kunganya ja acakulungwa ŵakuŵeceta magambo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.19",
            "verseOrgIds": [
              "ACT.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵayice nawo kwa acakulungwa ŵa nganya ni ŵasalile kuti, “Ŵandu aŵa ni Ayuda, nipo akusokonesya mu msinda mwetu muno. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.20",
            "verseOrgIds": [
              "ACT.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji akwiganya misyungu jakutindana ni jetuwe ŵandu ŵa Ciloma, nipo uwe ngaŵa mkujijiticisya kapena kujitendela masengo.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.21",
            "verseOrgIds": [
              "ACT.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵandu wosope wagungumucile Paulo ni Sila kuti alimbane nawo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.22",
            "verseOrgIds": [
              "ACT.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo acakulungwa ŵa nganya ŵala ŵapapwile yakuwala ya Paulo ni Sila, ni ŵalamwile kuti ŵakwapule ni yikoti. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.22",
            "verseOrgIds": [
              "ACT.16.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aliŵakwapwile mnope mula, ŵaponyisye m'nyumba ja akayidi, ni ŵamlamwile jwakulolela akayidijo kuti ŵasunje cenene kogopa kuti tacitila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.23",
            "verseOrgIds": [
              "ACT.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo lya maloŵe gelego, jwakulolela akayidijo ŵawugalile mcipinda camkati mnope m'nyumba ja akayidijo ni kwataŵilila sajo syawo makongwa ga usito.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.24",
            "verseOrgIds": [
              "ACT.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo pasikati cilo Paulo ni Sila ŵaliji mkupopela soni kwimbaga nyimbo sya kumlumba Mlungu, nipo akayidi ŵane ŵaliji mkwapikanila. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.25",
            "verseOrgIds": [
              "ACT.16.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwacisisimucisya catesile cisicinya mwamacili, mwakuti catenganyisye yilimbilimbi ya nyumba ja akayidijo. Ndaŵi jijojo matanga gosope gawugwice, ni maunyolo ga akayidi gagopwece. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.26",
            "verseOrgIds": [
              "ACT.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakulolela akayidi jula pijwajimwice, ŵagaweni matanga gosope ga nyumba ja akayidi gewugule, ŵaganisisye kuti akayidi atisile. Pelepo ŵaswekwile upanga ŵakwe kuti aliwulaje msyene. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.27",
            "verseOrgIds": [
              "ACT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Paulo ŵaŵecete mwakwesya maloŵe kuti, “Mkalipweteka jika! Uwe wosope tuli munomuno.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.28",
            "verseOrgIds": [
              "ACT.16.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apo jwakulolela akayidi jula ŵaŵilasisye nyali, ni ŵawutucile mkatimo, ni ŵaligwisisye pa sajo sya Paulo ni Sila alimkutetemela mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.29",
            "verseOrgIds": [
              "ACT.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo ŵakopocesye kusa ni ŵawusisye kuti, “Acambuje, ana ndende cici kuti ngulupuce?”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.30",
            "verseOrgIds": [
              "ACT.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ni Sila ŵamjanjile kuti, “Mkulupilile Ambuje Yesu, nipo timcikulupuka m'mwejo pampepe ni liŵasa lyenu.” ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.31",
            "verseOrgIds": [
              "ACT.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵamlalicile jwalakwejo maloŵe ga Mlungu pampepe ni ŵane wosope ŵa m'nyumba jakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.32",
            "verseOrgIds": [
              "ACT.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jijojo, atamose caliji cilo, jwakulolela akayidi jula ŵajigele Paulo ni Sila nipo ŵacapile maŵanga gawo. Soni papopo jwalakwe pampepe ni wosope ŵa mwiŵasa mwakwe ŵabatisidwe. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.33",
            "verseOrgIds": [
              "ACT.16.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Paulo ni Sila ŵapite nawo ku nyumba jakwe nipo ŵapele yakulya kuti alye. Nipo jwalakwe ni liŵasa lyakwe lyosope ŵasangalele mnope ligongo lyakuti sambano akukulupilila Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.34",
            "verseOrgIds": [
              "ACT.16.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pikwacele kundaŵi kwakwe, acakulungwa ŵa nganya ŵa Ciloma ŵala ŵatumile asilikali ni maloŵe gakuti, “Ŵagopole ŵandu ŵala ajawuleje.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 16:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.35",
            "verseOrgIds": [
              "ACT.16.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo jwakulolela akayidi jula ŵamsalile Paulo maloŵego acitiji, “Acakulungwa ŵa nganya atumisye maloŵe kuti tumgopole m'mwejo ni Sila. Jemanja sambano kopokani, nipo mjawuleje mu mtendele.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 16:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.36",
            "verseOrgIds": [
              "ACT.16.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Paulo ŵasalile asilikali ŵala kuti, “Uwe nganatusimana ni cileŵi cilicose cakwenela magambo, soni ŵatukwapwile pa luŵala pa ŵandu ŵajinji atamose kuti tuli alukosyo ŵa Ciloma, mpaka soni kutuŵika m'nyumba ja akayidi. Sambano akusaka kutukoposya mwa kutugwasya? Yeleyo ni iyayi! Ayice kunokuno kuti atukoposye acimsyenewo.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 16:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.37",
            "verseOrgIds": [
              "ACT.16.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 16:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilikali ŵala ŵapite kukwasalila acakulungwa ŵa nganya ŵala maloŵe gelega. Nipo ŵatesile woga piŵapikene kuti Paulo ni Sila ali alukosyo ŵa Ciloma. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.38",
            "verseOrgIds": [
              "ACT.16.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 16:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwakuti ŵajawile ni ŵaŵendile Paulo ni Sila kuti ŵakululucile, kaneko ŵakopwesye nipo ŵaŵendile kuti atyoce mu msindamo. ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.39",
            "verseOrgIds": [
              "ACT.16.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 16:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paulo ni Sila piŵakopwece m'nyumba ja akayidi mula ŵajawile ku nyumba ja Lidiya. Kweleko ŵasimene ni acimjawo nipo ŵalimbisye ni maloŵe ga Ambuje, ni ŵatyosile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.16.40",
            "verseOrgIds": [
              "ACT.16.40"
            ]
          }
        }
      ]
    }
