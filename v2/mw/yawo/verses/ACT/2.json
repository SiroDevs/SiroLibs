        {
          "text": "Paja Daudi",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.25",
            "verseOrgIds": [
              "ACT.2.25"
            ]
          }
        },
        {
          "text": " ŵaŵecete ya jwelejo kuti,",
          "type": "text",
          "attrs": {
