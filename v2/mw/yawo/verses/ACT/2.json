          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mlungu ŵamgopwele ku yipwetesi ya ciwa, ni ŵamjimwisye ku ŵawe, ligongo yaliji yangakomboleka kuti apundidwe ni ciwa.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.2.24",
            "verseOrgIds": [
              "ACT.2.24"
            ]
          }
        },
