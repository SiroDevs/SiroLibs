              },
              "items": [
                {
                  "text": "18:6-23",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.20",
            "verseOrgIds": [
              "ACT.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja kutandila kalakala mu msinda uliwose mwana ŵandu ŵakwiganya Malamusi ga Mose, nipo gaŵalanjidwaga maloŵe gakwe m'nyumba sya kupopelela lisiku lyakupumula",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        },
        {
          "text": " lya Ayuda lili lyose.”",
          "type": "text",
          "attrs": {
            "verseId": "ACT.15.21",
            "verseOrgIds": [
              "ACT.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cikalata kwa ŵandu ŵa mitundu jine ŵakulupilila",
          "type": "text"
        }
      ]
    },
    {
