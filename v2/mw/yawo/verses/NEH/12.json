    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mena ga ŵakutaga mbopesi ni Alefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ni Alefi ŵiŵawusile kutyocela ku ukapolo pamo ni Selubabele mwanace jwa Sheyatiyele ni jwakutaga mbopesi Yeswa ŵaliji aŵa: Selaya, Yelemiya, Esala, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.1",
            "verseOrgIds": [
              "NEH.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amaliya, Maluki, Hatushi,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2+NEH.12.3+NEH.12.4+NEH.12.5+NEH.12.6+NEH.12.7",
            "verseOrgIds": [
              "NEH.12.2",
              "NEH.12.3",
              "NEH.12.4",
              "NEH.12.5",
              "NEH.12.6",
              "NEH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ŵaliji acimlongola sikati ja ŵakutaga mbopesi ni acalongo acimjawo mu ndaŵi ja Yeswa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.2+NEH.12.3+NEH.12.4+NEH.12.5+NEH.12.6+NEH.12.7",
            "verseOrgIds": [
              "NEH.12.2",
              "NEH.12.3",
              "NEH.12.4",
              "NEH.12.5",
              "NEH.12.6",
              "NEH.12.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yisukulu ya Yoswa jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.9",
            "verseOrgIds": [
              "NEH.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yeswa ŵaliji babagwe Yoiyakimu, angangagwe Eliyashibu soni ambujegwe Yoiyada. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.10",
            "verseOrgIds": [
              "NEH.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoiyada ŵaliji babagwe Yonatani soni angangagwe ŵa Yaduwa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Acimlongola ŵa maŵasa ga ŵakutaga mbopesi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.11",
            "verseOrgIds": [
              "NEH.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NEH 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jele Yoiyakimu piŵaliji jwakutaga mbopesi, ŵakutaga mbopesi ŵakuyicisyaŵa ŵaliji acimlongola ŵa maŵasa gawo:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12+NEH.12.13+NEH.12.14+NEH.12.15+NEH.12.16+NEH.12.17+NEH.12.18+NEH.12.19+NEH.12.20+NEH.12.21",
            "verseOrgIds": [
              "NEH.12.12",
              "NEH.12.13",
              "NEH.12.14",
              "NEH.12.15",
              "NEH.12.16",
              "NEH.12.17",
              "NEH.12.18",
              "NEH.12.19",
              "NEH.12.20",
              "NEH.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mena ga maŵasa ga ŵakutaga mbopesi ni Alefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
