        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.12+NEH.12.13+NEH.12.14+NEH.12.15+NEH.12.16+NEH.12.17+NEH.12.18+NEH.12.19+NEH.12.20+NEH.12.21",
            "verseOrgIds": [
              "NEH.12.12",
              "NEH.12.13",
              "NEH.12.14",
              "NEH.12.15",
              "NEH.12.16",
              "NEH.12.17",
              "NEH.12.18",
              "NEH.12.19",
              "NEH.12.20",
              "NEH.12.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu ndaŵi ja Eliyashibu, Yoiyada, Yohanani, ni Yaduwa ŵiŵaliji acakulungwa ŵa ŵakutaga mbopesi, palembedwe mena ga acimlongola ŵa maŵasa ga Alefi ni ŵakutaga mbopesi, mpaka pa ndaŵi jiŵalamulilaga Mwenye Daliyasi jwa ku Pelesiya.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NEH 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.22",
            "verseOrgIds": [
              "NEH.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alefi ŵiŵaliji acimlongola ŵa maŵasa ŵalembesye mena gawo mu buku ja Mbili mpaka mu ndaŵi ja Yohanani cisukulu ca Eliyashibu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kugaŵa kwa masengo ga ku Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NEH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.23",
            "verseOrgIds": [
              "NEH.12.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hashabiya, Shelebiya, Yoswa mwanace jwa Kadimiyele, pamo ni acalongo acimjawo ŵakamusyanaga kwimba nyimbo syakumlumba Mlungu ni kumtogolela, mpela muŵalamulile jemanjajo Mwenye Daudi",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        },
        {
          "text": " mundu jwa Mlungu. Ŵalamwile jemanjajo kuti makuga gakwimba nyimbogo gapocelanganaga.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NEH 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.24",
            "verseOrgIds": [
              "NEH.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Acilonda ŵakuyicisyaŵa ŵalondelaga ku nyumba syakusunjilako katundu ciŵandika ni pa yipata ya ku Nyumba ja AMBUJE: Mataniya, Bakibukiya, Obadiya, Meshulamu, Talimoni ni Akubu.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NEH 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.25",
            "verseOrgIds": [
              "NEH.12.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ni ŵiŵapali pa ndaŵi ja Yoiyakimu mwanace jwa Yeswa soni cisukulu ca Yehosadaki, soni mu ndaŵi ja bwanamkubwa Nehemiya ni mu ndaŵi ja Esala, jwakutaga mbopesi juŵaliji soni mwalimu jwa Malamusi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kupeleka kwa lipupa lyakucinjilicisya msinda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NEH 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.26",
            "verseOrgIds": [
              "NEH.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NEH 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu piŵatiga kuti apelece lipupa lya msinda ŵa Yelusalemu, ŵaŵilasile Alefi wosope kutyocela kulikose kuŵatamaga kuti ayice ku Yelusalemu kukutenda msyungu wakupeleka lipupalyo mwalukondwa, mwakutogolela soni pakwimba nyimbo ni micekece ni yida yakwimbila ya ngonji. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.27",
            "verseOrgIds": [
              "NEH.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NEH 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maŵasa ga ŵakwimba ŵa ci Lefi gasongene malo gamo kutyocela ku malo gosope gakusyungulila msinda wa Yelusalemu ni ku misi ja Netofa, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.28",
            "verseOrgIds": [
              "NEH.12.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NEH 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Beti Giligala, Geba ni Asimafeti. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.29",
            "verseOrgIds": [
              "NEH.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ni Alefi ŵatesile msyungu wakuliswejesya acimsyene, ŵandu, yipata ni mapupa ga msinda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NEH 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.30",
            "verseOrgIds": [
              "NEH.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NEH 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une nayice nawo acakulungwakulungwa ŵa ku Yuda, nipo nakwesile nawo penani pa lipupa lya msindawo. Mwa jemanjajo nasagwile makuga gaŵili kuti gajendeje mwakuwusyungulila msindawo kwineku ali kumtogolela Mlungu. Likuga lyandanda lyajesile kumlyo penani pa lipupalyo mpaka kuja kwika ku Cipata ca Yiswani. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.31",
            "verseOrgIds": [
              "NEH.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hoshaya ŵayikaga panyuma pa jemanjajo pamo ni hafu ja acakulungwakulungwa ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.32",
            "verseOrgIds": [
              "NEH.12.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "NEH 12:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵayice ŵakutaga mbopesi ŵakuyicisyaŵa ŵiŵagombaga malipenga, ŵiŵajendaga mwakwakuya: Asaliya, Esala, Meshulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.33",
            "verseOrgIds": [
              "NEH.12.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NEH 12:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yuda, Benjamini, Shemaya ni Yelemiya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.34",
            "verseOrgIds": [
              "NEH.12.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NEH 12:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵayice Sakaliya mwanace jwa Yonatani, soni cisukulu ca Shemaya. (Acinangolo ŵakwe ŵaliji kupwatika Mataniya, Mikaya, ni Sakuli jwa mwiŵasa lya Asafu.) ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.35",
            "verseOrgIds": [
              "NEH.12.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NEH 12:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapali acalongo acimjakwe aŵa: Shemaya, Asalele, Milalayi, Gilalayi, Maai, Netanele, Yuda ni Hanani, jemanjaji ŵajimbaga yida ya Mwenye Daudi, mundu jwa Mlungu. Esala, mwalimu jwa Malamusi ni jwele juŵalongolelaga jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.36",
            "verseOrgIds": [
              "NEH.12.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NEH 12:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela ku Cipata ca Uliŵa jemanjajo ŵakwesile pa masitepe gakwawula ku msinda wa Daudi, pa litala lyakukuluma ni lipupa ca kumkuli kwa nyumba ja Daudi mpaka ku Cipata ca Mesi ca kungopoko lyuŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.37",
            "verseOrgIds": [
              "NEH.12.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "NEH 12:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likuga line lya ŵandu ŵiŵamtogolelaga Mlungu lyajile ku mciji, nipo nakuyisye jemanjajo, pamo ni hafu jine ja acimlongola ŵa ku Yuda. Twajesile mpaka kucipunda Sanja ja Ufuni mpaka twajile kwika ku Lipupa Lyetambasukuce. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.38",
            "verseOrgIds": [
              "NEH.12.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NEH 12:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutyocela kweleko twajesile mpaka ku Cipata ca Efelemu, Cipata ca Kala, Cipata ca Somba, Sanja ja Hananele, Sanja ja Licila, ni ku Cipata ca Ngondolo. Pambesi pakwe twajimi pa Cipata ca Alonda.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.39",
            "verseOrgIds": [
              "NEH.12.39"
            ]
          }
        }
      ]
    },
