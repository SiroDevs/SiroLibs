          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo makuga gaŵili gosopego gajile kukwima ciŵandika ni Nyumba ja AMBUJE pamo ni une ni hafu ja acakulungwakulungwa ŵiŵaliji ni une ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.40",
            "verseOrgIds": [
              "NEH.12.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "NEH 12:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mu likuga lyangu mwaliji mwana ŵakutaga mbopesi ŵakuyicisyaŵa ŵiŵagombaga malipenga: Eliyakimu, Maaseya, Miniyamini, Mikaya, Eliyoyenayi, Sakaliya, ni Hananiya. ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.41",
            "verseOrgIds": [
              "NEH.12.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "NEH 12:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵapali soni ŵakutaga mbopesi ŵakuyicisyaŵa, ŵiŵalongolelaga ŵakwimba nyimbo: Maaseya, Shemaya, Eliyesa, Usi, Yehohanani, Malikiya, Elamu ni Esele. Yesilahiya ni juŵalongolelaga ŵakwimba nyimbowo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.42",
            "verseOrgIds": [
              "NEH.12.42"
            ]
          }
        }
      ]
    },
