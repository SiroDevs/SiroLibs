          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelo ŵandu ŵapelece mbopesi syejinji, nipo ŵasengwile mnope, pakuti Mlungu ni juŵasengwesye jemanjajo. Nombe nawo acakongwe pamo ni ŵanace ŵakwe ŵasengwile. Nipo kusengwa kwa ŵandu ŵa ku Yelusalemu kwapikanice kwakutalika.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.12.43",
            "verseOrgIds": [
              "NEH.12.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kupeleka yindu yakamucisya pa mapopelo ku Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
