          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shalumu mwanace jwa Kolihose, juŵalamulilaga ku dela ja ku Misipa, ŵalinganyisye soni Cipata ca Uliŵa. Ŵalinganyisye soni cipataco ni kuŵika msakasa wakwe, matanga ni mipiciko jakwe. Ŵataŵile soni lipupa lya Litamanda lya Sela ciŵandika ni mgunda wa mwenye, mpaka kuja kwika ku masitepe gakutulucila pakukopoka mu msinda wa Daudi.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.15",
            "verseOrgIds": [
              "NEH.3.15"
            ]
          }
        }
