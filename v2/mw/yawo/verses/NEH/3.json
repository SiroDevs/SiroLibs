              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi ŵane ŵataŵile soni lipupa kutyocela pa Cipata ca Haci, jwalijose ŵataŵaga lipupa mwakulolegana ni nyumba jakwe.",
          "type": "text",
