    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akutaŵa soni mapupa ga msinda wa Yelusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amu ni muŵataŵile lipupa lya msinda wa Yelusalemu. Eliyashibu jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "text": " pamo ni ŵakutaga mbopesi acimjakwe ŵatandite kukamula masengo nipo ŵataŵile Cipata ca Ngondolo, cele ciŵacipelece kwa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "text": " nipo kaneko ŵaŵisile matanga gakwe. Lipupa liŵalipelece kwa AMBUJE lyajile kwika ku Sanja ja Licila, mpaka ku Sanja ja Hananele.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.1",
            "verseOrgIds": [
              "NEH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa ku Yeliko ŵataŵile mbali jine ja lipupalyo, nipo Sakuli mwanace jwa Imuli ŵataŵile mbali jine ja lipupalyo mwakuŵandikana ni mbali jijakwejo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.2",
            "verseOrgIds": [
              "NEH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa mwiŵasa lya Hasena ŵataŵile Cipata ca Somba. Jemanjajo ŵaŵisile migomba, ni kuŵicilila matanga ni yakuwugalila yakwe, soni ŵaŵisile mipiciko.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.3",
            "verseOrgIds": [
              "NEH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melemoti mwanace jwa Uliya soni cisukulu ca Hakosi, ŵataŵile mbali jine ja lipupalyo. Meshulamu mwanace jwa Belekiya, soni juŵaliji cisukulu ca Meshesabelo, ŵataŵile mbali jine ja lipupalyo nipo Sadoki mwanace jwa Baana nombe nawo ŵataŵile mbali jine ja lipupalyo.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.4",
            "verseOrgIds": [
              "NEH.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 3:4"
          },
          "items": [
            {
              "text": "4",
