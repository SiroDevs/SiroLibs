          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikiya mwanace jwa Lekabu juŵalamulilaga ku dela ja Betehakelemu, ŵalinganyisye soni Cipata ca Yiswani, ni kuŵicilila matanga ni mipiciko jakwe.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.14",
            "verseOrgIds": [
              "NEH.3.14"
            ]
          }
        }
      ]
