          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
