            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.12",
            "verseOrgIds": [
              "NEH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NEH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hanuni pamo ni ŵandu ŵiŵatamaga mu msinda wa Sanowa ŵalinganyisye soni Cipata ca ku ciŵata. Ŵaŵisile matanga ni kuŵika mipiciko, ni kutaŵa soni lipupa, lyele ulewu wakwe waliji mamita 400 mpaka kuja kwika ku Cipata ca Yiswani.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.13",
            "verseOrgIds": [
              "NEH.3.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
