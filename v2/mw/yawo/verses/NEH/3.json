              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Binuyi mwanace jwa Henadadi ŵataŵile mbali jine ja lipupalyo, kutyocela ku nyumba ja Asaliya mpaka pa ndumba ja lipupa.",
          "type": "text",
          "attrs": {
