              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NEH 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afundi ŵakusyana yisyano ya golidi ni ŵa malonda ŵataŵile soni mbali jakumalisya, kutyocela pa cipinda ca pandumba mpaka kuja kwika pa Cipata ca Ngondolo.",
