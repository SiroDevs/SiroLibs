          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikiya, fundi jwakusyana golidi, ŵataŵile soni mbali jine mpaka kuja kwika ku nyumba ja ŵakutumicila ku Nyumba ja AMBUJE soni ku nyumba ja ŵandu ŵa malonda, jele jijalolegene ni Cipata ca Mikifadi mpaka ku Nyumba ja AMBUJE, ciŵandika ni cipinda capenani pa ndumba ja kumpoto cakungopoko lyuŵa kwa lipupa.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.31",
            "verseOrgIds": [
              "NEH.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
