        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.10",
            "verseOrgIds": [
              "NEH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikiya mwanace jwa Halimu, kwisa soni Hashubu mwanace jwa Pahati Mowabu ŵataŵile mbali jimo ja lipupalyo pamo ni Sanja ja Ufuni.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.11",
            "verseOrgIds": [
              "NEH.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
