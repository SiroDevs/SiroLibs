            "sid": "NEH 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mpaka kuja kwika ciŵandika ni ku Cipata ca Mesi ni ku sanja jakucinjilicisya Nyumba ja AMBUJE jila.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.3.26",
            "verseOrgIds": [
              "NEH.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amisili ŵane ŵiŵataŵile nawo lipupa",
          "type": "text"
        }
      ]
    },
