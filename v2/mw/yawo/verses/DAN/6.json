              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jelejo Mwenye Daliyasi jwalembele yikalata kwa ŵandu ŵa mitundu josope, ngosyo syosope ni yiŵeceto yakulekanganalekangana pa cilambo cosope capasi, jwatite kuti, “Mtendele uŵe wejinji pasikati pa jemanja! ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.25",
            "verseOrgIds": [
              "DAN.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nguŵika lilamusi lyakuti, ŵandu wosope ŵa mu ucimwene wangu amjogope ni kumcimbicisya Mlungu jwa Daniele.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.6.26",
            "verseOrgIds": [
              "DAN.6.26"
            ]
          }
        }
      ]
