              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.12",
            "verseOrgIds": [
              "DAN.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambo m'mwe Daniele mŵe ciŵela ŵakulupicika mpaka pambesi. Kaneko timciwa, nambo pambesi timcijimuka ku ŵawe kuti timpocele mbote jenu.”",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.13",
            "verseOrgIds": [
              "DAN.12.13"
            ]
          }
        }
      ]
