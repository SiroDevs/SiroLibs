      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndaŵi jakumalisya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Pa ndaŵi jelejo lilayika lyekulungwa Mikaele,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "text": " jwakusiŵalondela ŵandu ŵenu, taciyika. Ndaŵi jelejo tijiciŵa ja yisawusyo yakogoya yamkaniyiwoneceje kala kosope, ali ampangenye mundu. Pa ndaŵijo ŵandu ŵenu tacikulupuka, wosope ŵele mena gawo galembedwe m'buku ja Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.12.1",
            "verseOrgIds": [
              "DAN.12.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
