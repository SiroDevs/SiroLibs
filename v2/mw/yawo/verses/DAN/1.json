            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Caka catatu ca Yehoiyakimu mwenye jwa ku Yuda, Nebukadinesa mwenye jwa ku Babiloniya jwayice ku msinda wa Yelusalemu, ni kuwusyungulila.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.1",
            "verseOrgIds": [
              "DAN.1.1"
            ]
          }
        },
        {
