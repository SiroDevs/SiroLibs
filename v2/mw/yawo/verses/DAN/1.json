            "number": "2",
            "style": "v",
            "sid": "DAN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamkamucisye kumpunda Yehoiyakimu, mwenye jwa ku Yuda, ni kusumula yida yine ya ku Nyumba ja AMBUJE. Nipo ŵajile nayo ku nyumba sya milungu ja ku Babiloniya, ni ŵayiŵisile m'malo gakusunjila yipanje.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.1.2",
            "verseOrgIds": [
              "DAN.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
