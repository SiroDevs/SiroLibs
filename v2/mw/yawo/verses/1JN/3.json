              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja ŵakunonyelwa, naga mtima wetu ngawukutusisya, tukomboleka kwima mwangali woga pameso pa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.21",
            "verseOrgIds": [
              "1JN.3.21"
            ]
          }
        },
