          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cele cakusalamula Mlungu cili cakuti tumkulupilileje mwanace jwakwe Yesu",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.23",
            "verseOrgIds": [
              "1JN.3.23"
            ]
          }
        },
        {
          "text": " Klistu, nambo soni kuti tunonyelaneje mpela muŵatulamulile jwalakwejo.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.23",
            "verseOrgIds": [
