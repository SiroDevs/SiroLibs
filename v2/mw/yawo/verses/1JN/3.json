          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusatupa cilicose cele tukusamŵenda ligongo lyakuti tukusakuya malamusi gakwe, nambo soni tukusatenda yakumsangalasya. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.3.22",
            "verseOrgIds": [
              "1JN.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
