              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umiwo piwawonecele, uwe twawuweni. Twatendele umboni nipo tukumlalicila jemanja ya umi wangamala,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "text": " uwaliji kwa Atati nipo wawonecele kwa uwe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.1.14"
              },
              "items": [
                {
                  "text": "Yoh 1:14",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.2",
            "verseOrgIds": [
              "1JN.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cele citwaciweni ni kucipikana, tukumlalicila, kuti jemanja pampepe ni uwe tuŵeje ŵakusyoŵekana ni Atati, soni ni Mwanagwawo, Yesu",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "text": " Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.3",
            "verseOrgIds": [
              "1JN.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukumlembela jemanja kuti lukondwa lwenu luŵeje lwemalilwe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu ali lilanguka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.4",
            "verseOrgIds": [
              "1JN.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awu uli utenga utupikene kutyocela kwa jwalakwejo nipo tukumlalicila jemanja ngani jitwapikene kutyocela kwa jwalakwejo, kuti Mlungu ali lilanguka nipo mwa jwalakwejo mwangali kose cipi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.5",
            "verseOrgIds": [
              "1JN.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga tukuŵeceta kuti tukusasyoŵekana najo jwalakwejo, citamileco tuli mkwendape mu cipi, ni kuti tukulambusya mu kuŵeceta ni mu yitendo yetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.6",
            "verseOrgIds": [
              "1JN.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga tukwenda mu lilanguka mpela jwalakwejo ali mu lilanguka, pelepo ni kuti tukutama mu kusyoŵekana najo. Soni miasi ja Yesu mwanace jwakwe, jikusatuswejesya ni kututyocesya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        },
        {
          "text": " uliwose. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.7",
            "verseOrgIds": [
              "1JN.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga tukuŵeceta kuti nganitukola ulemwa, tukulilambusya, soni mwa uwe mwangali usyesyene. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.8",
            "verseOrgIds": [
              "1JN.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga tukwiticisya ulemwa wetu, Mlungu jwali jwakulupicika ni jwakulungama, tacitukululucila ulemwa wetuwo. Tacituswejesya ni kututyocesya ungalumbana wetu wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.9",
            "verseOrgIds": [
              "1JN.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga tukuŵeceta kuti nganitukola ulemwa, pelepo tukumtenda Mlungu kuti ali jwa unami, nipo maloŵe gakwe nganigaŵa mwa uweji.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.10",
            "verseOrgIds": [
              "1JN.1.10"
            ]
          }
        }
      ]
    }
  ],
