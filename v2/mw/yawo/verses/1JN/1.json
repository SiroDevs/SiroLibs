            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukumlembela jemanja ya Jwalakwe jula jwele juŵapali kutyocela pandanda pene picapanganyidwaga cilambo capasi, jwele jutwampikene, kumwona ni meso getu ni kumkwaya ni magasa getu. Jwalakwejo ali Liloŵe lyakupeleka umi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.1.1",
            "verseOrgIds": [
              "1JN.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
