      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kupunda kwetu pa cilambo capasi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1JN 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwalijose jwakulupilila kuti Yesu ali Klistu,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.1",
            "verseOrgIds": [
              "1JN.5.1"
            ]
          }
        },
        {
          "text": " jwelejo ali Mwanace jwa Mlungu; jwalijose jwakwanonyela Atati akumnonyela soni mwanace jwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.1",
            "verseOrgIds": [
              "1JN.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1JN 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwelemu ni mutukusamanyililila kuti tukusitwanonyela ŵanace ŵa Mlungu, patukumnonyela Mlungu ni kugapikanila malamusi gakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.2",
            "verseOrgIds": [
              "1JN.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1JN 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kumnonyela Mlungu kuli kugapikanila malamusi gakwe, soni nganigaŵa gakusitopesya.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.3",
            "verseOrgIds": [
              "1JN.5.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.14.15"
              },
              "items": [
                {
                  "text": "Yoh 14:15",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.3",
            "verseOrgIds": [
              "1JN.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1JN 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jwali Mwanace jwa Mlungu akusacilamula cilambo capasi. Akusacilamula cilambo capasi ni cikulupi cetu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.4",
            "verseOrgIds": [
              "1JN.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ŵani ŵakusacilamula cilambo capasi? Ngaŵa jwine nambo jwakulupilila kuti Yesu",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.5",
            "verseOrgIds": [
              "1JN.5.5"
            ]
          }
        },
        {
          "text": " ali Mwanace jwa Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.5",
            "verseOrgIds": [
              "1JN.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya umboni wa Yesu Klistu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1JN 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.5",
            "verseOrgIds": [
              "1JN.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1JN 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu Klistu ni juŵayice kupitila mwa mesi ni miasi. Nganayika mwa mesipe, nambo mwa mesi ni miasi jakwe. Soni Msimu Ŵaswela ni uŵatendele umboni kuti yeleyi yili yakuwona, ligongo Msimuwo ali ŵakuwona. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.6",
            "verseOrgIds": [
              "1JN.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1JN 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pana mboni sitatu: ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.7",
            "verseOrgIds": [
              "1JN.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1JN 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msimu, mesi, ni miasi; yitatu yosopeyi yikupeleka umboni wakulandana. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.8",
            "verseOrgIds": [
              "1JN.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1JN 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukusapocela umboni wa ŵandu, nambo umboni wa Mlungu uli wakupunda umboni wa ŵandu. Umboniwo ni wele Mlungu uŵamtendele mwanace jwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.9",
            "verseOrgIds": [
              "1JN.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1JN 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umboniwo sambano uli wakuti Mlungu ŵatupele umi wangamala,",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.10",
            "verseOrgIds": [
              "1JN.5.10"
            ]
          }
        },
        {
          "text": " soni umiwo ukusasimanikwa mwa Mwanace jwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.10",
            "verseOrgIds": [
              "1JN.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1JN 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umboniwo sambano uli wakuti Mlungu ŵatupele umi wangamala, soni umiwo ukusasimanikwa mwa Mwanace jwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.11",
            "verseOrgIds": [
              "1JN.5.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JHN.3.36"
              },
              "items": [
                {
                  "text": "Yoh 3:36",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.11",
            "verseOrgIds": [
              "1JN.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwele jwakwete Mwanacejo, akwete umi. Jwele jwanganakola Mwanace jwa Mlungujo, jwangali umi.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.12",
            "verseOrgIds": [
              "1JN.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya umi wangamala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1JN 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.12",
            "verseOrgIds": [
              "1JN.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1JN 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumlembela jemanja yeleyi kuti m'manyilile kuti mkwete umi wangamala, jemanja ŵimkukulupilila mwa Mwanace jwa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.13",
            "verseOrgIds": [
              "1JN.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1JN 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukusalimba mtima pameso pa Mlungu pakuti jwalakwejo akusatupikana pa ndaŵi jitukuŵenda kandu kalikose mwakulingana ni lisosa lyakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.14",
            "verseOrgIds": [
              "1JN.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni naga tukumanyilila kuti akusatupikana pa cilicose citukusaŵenda, tukusamanyilila kuti tupocele yele yitumŵendile.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.15",
            "verseOrgIds": [
              "1JN.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1JN 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.15",
            "verseOrgIds": [
              "1JN.5.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1JN 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu akumwona mjakwe ali mkutenda ya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.16",
            "verseOrgIds": [
              "1JN.5.16"
            ]
          }
        },
        {
          "text": " yangamyikasya ku ciwa, apopele, nipo Mlungu tacipeleka umi kwa mjakwejo. Apatu nguŵeceta ya ulemwa wawuli wangamyikasya mundu ku ciwa. Nambo pana ulemwa wine wakwikasya ciwa, ya ulemwa welewo nganguŵeceta kuti mundu apopele. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.16",
            "verseOrgIds": [
              "1JN.5.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1JN 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cindu cilicose cicili cangalungama cili ulemwa, nambo pana ulemwa wine wangayikasya mundu ku ciwa. ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.17",
            "verseOrgIds": [
              "1JN.5.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukumanyilila kuti jwalijose jwali Mwanace jwa Mlungu, jwangapitilisya kulemwa. Yesu, Mwanace jwa Mlungu akusamsunga, soni jwakusakala jula ngaŵa kumkwaya.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.18",
            "verseOrgIds": [
              "1JN.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1JN 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.18",
            "verseOrgIds": [
              "1JN.5.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukumanyilila kuti tuli ŵakwe ŵa Mlungu, nipo kwa wosope ŵakwegamila ya pa cilambo cosope capasi ali m'myala mwa jwakusakala jula.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.19",
            "verseOrgIds": [
              "1JN.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1JN 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.19",
            "verseOrgIds": [
              "1JN.5.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukumanyilila kuti Mwanace jwa Mlungu jwayice, ni ŵatupele lunda kuti tum'manyilile Mlungu jwakuwona. Uwe tuli mwa jwalakwejo jwali jwakuwona, ligongo tuli mwa mwanace jwakwe Yesu Klistu. Jwalakwejo ali Mlungu jwakuwona nambo soni ali umi wangamala.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.20",
            "verseOrgIds": [
              "1JN.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1JN 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.20",
            "verseOrgIds": [
              "1JN.5.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1JN 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakunonyelwa ŵanangu, mliŵambasyeje mwacimsyene soni ngalambilaga milungu ja unami.",
          "type": "text",
          "attrs": {
            "verseId": "1JN.5.21",
            "verseOrgIds": [
              "1JN.5.21"
            ]
          }
        }
      ]
