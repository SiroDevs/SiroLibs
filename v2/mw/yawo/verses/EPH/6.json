          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukiko tacim'manyisya yosope ya une ni yele yingutenda. Jwalakweju ali mlongo mjetu jwakunonyelwa nipo soni jwakutumicila jwakulupicika pa masengo ga Ambuje.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.21",
            "verseOrgIds": [
              "EPH.6.21"
            ]
          }
        },
