          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu Atati ni Ambuje Yesu",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
          }
        },
        {
          "text": " Klistu ampeje jemanja acalongo acimjetu wosopemwe mtendele, ni cinonyelano nipo soni cikulupi. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.23",
            "verseOrgIds": [
              "EPH.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EPH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbone mtima ni mtendele yakutyocela kwa Mlungu Atati ni Ambuje Yesu Klistu yiŵe pa jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.24",
