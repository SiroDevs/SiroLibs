          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe ngumtuma jwalakweju kwa jemanja kuti am'manyisye ya mwele mutuŵelele, nipo kuti amlimbisye mtima. ",
          "type": "text",
          "attrs": {
            "verseId": "EPH.6.22",
            "verseOrgIds": [
