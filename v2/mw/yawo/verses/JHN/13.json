              },
              "items": [
                {
                  "text": "Mat 10:40",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.9.37"
              },
              "items": [
                {
                  "text": "Mak 9:37",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.9.48"
              },
              "items": [
                {
                  "text": "Luk 9:48",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
