          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libina, Adulamu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.12.15",
            "verseOrgIds": [
              "JOS.12.15"
            ]
          }
        },
        {
