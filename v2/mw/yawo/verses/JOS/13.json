            "sid": "JOS 13:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵaliji ali apelece soni mbali ja cilamboco kwa maŵasa ga lukosyo lwa Gadi mpela cawocawope. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.24",
            "verseOrgIds": [
              "JOS.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upande wawo wapwatikenye Yasa ni misinda josope ja Giliyadi, litika lya cilambo ca Aamoni mpaka ku Aloya, jijili kungopoko lyuŵa kwa Laba; ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.25",
            "verseOrgIds": [
              "JOS.13.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 13:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "cilambo cawo cajendelecele ku Lamati Misipa ni Betonimu, kutyocela ku Heshiboni mpaka ku Mahanaimu mpaka kumalile ga Lodebala. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.26",
            "verseOrgIds": [
              "JOS.13.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 13:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mciŵata ca Yolodani upande wawo wapwatice Beti Halamu, Beti Nimila, Sukoti, ni Safoni, misi jijasigele ja ucimwene wa Mwenye Sihoni jwa Heshiboni. Malile gawo ga kungapilo lyuŵa galiji Lusulo lwa Yolodani mpaka kumpoto ku Nyasa ja Galileya. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.27",
            "verseOrgIds": [
              "JOS.13.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeleji jaliji misinda ni misi jiŵapelece kwa maŵasa ga lukosyo lwa Gadi mpela gawogawope.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbali jiŵapelece Mose kungopoko lyuŵa kwa Manase",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 13:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.28",
            "verseOrgIds": [
              "JOS.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ŵaliji ali apelece kambali ka cilambo kwa maŵasa ga hafu ga lukosyo lwa Manase mpela kawokawope. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.29",
            "verseOrgIds": [
              "JOS.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upande wawo wajendelecele ku Mahanaimu ni japwatikenye Bashani josope, ucimwene wosope wa Ogi, mwenye jwa ku Bashani, yalumo soni ni misi 60 ja Yaili ku Bashani. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.30",
            "verseOrgIds": [
              "JOS.13.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Japwatikenye litika lya Giliyadi, nambo soni Ashitaloti ni Edileyi, mulikulungwa mwa misinda ja ucimwene wa Ogi ku Bashani. Gosopega gapelece kwa hafu ja maŵasa gigakopwece kutyocela kwa Makili mwanace jwa Manase.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 13:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.31",
            "verseOrgIds": [
              "JOS.13.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 13:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwelemu ni muŵagaŵile Mose cilambo ca kungopoko lyuŵa kwa Yeliko ni Yolodani piŵaliji ali mwilambo lya Mowabu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.32",
            "verseOrgIds": [
              "JOS.13.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 13:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Mose nginapeleka malo galigose ku lukosyo lwa Lefi. Jwalakwe ŵasalile jemanjajo kuti cipanje cawo caliji camti ticiŵe mbali jimo ja yakupeleka ya kwa AMBUJE Mlungu jwa Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.13.33",
            "verseOrgIds": [
              "JOS.13.33"
            ]
          }
        },
