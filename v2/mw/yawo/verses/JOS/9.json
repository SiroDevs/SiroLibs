                "loc": "EXO.23.32"
              },
              "items": [
                {
                  "text": "Eks 23:32",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.34.12"
              },
              "items": [
                {
                  "text": "34:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.2"
              },
              "items": [
                {
                  "text": "Det 7:2",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.7",
            "verseOrgIds": [
              "JOS.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵatite kwa Yoswa, “Uwe tuli ŵamasengo ŵenu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa ŵawusisye jemanjajo kuti, “Jemanja ali ŵani? Ana akutyocela kwapi?”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.8",
            "verseOrgIds": [
              "JOS.9.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko jemanjajo ŵamsalile aji nganiji kuti, “Uwe tutyocele ku cilambo cakwakutalika, bwana, ligongo tupikene ya AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "text": " Mlungu jwenu. Tupikene yosope yene yiŵayitesile mu Iguputo ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.9",
            "verseOrgIds": [
              "JOS.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni yiŵayitesile kwa ayimwene ŵaŵili ŵa Aamoli kungopoko lyuŵa kwa Lusulo lwa Yolodani: Mwenye Sihoni jwa ku Heshiboni ni Mwenye Ogi jwa ku Bashani, juŵatamaga ku Ashitaloti.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.10",
            "verseOrgIds": [
              "JOS.9.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30+NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Num 21:21-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.10",
            "verseOrgIds": [
              "JOS.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakulongolela ŵetu ni ŵandu wosope ŵakutama mcilambo cetu ŵatusalile kuti tujigaliletu yakulya ya pa ulendo ni kwawula kukuwonegana ni ŵalakwe. Uwe ŵatusalile kuti tuŵe ŵamasengo ŵa wawo ni kwaŵenda wawojo kuti atende mkamulano wa mtendele ni uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.11",
            "verseOrgIds": [
              "JOS.9.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Alole mkate wetuwu. Pitwatyokaga ku musi ni mkatewu kutanda ulendo wa kukuwonegana ni wawojo, waliji wa mtukuta. Nambo alole! Sambano ujumwile soni utandite kucesuka. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.12",
            "verseOrgIds": [
              "JOS.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitwagumbasyaga misaku ja mapende ga finyoji, galiji gasambano, nambo alole! Gapapwice. Yakuwala ni sapato syetu yipapwice ligongo lya ulendo welewu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.13",
            "verseOrgIds": [
              "JOS.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.13",
            "verseOrgIds": [
              "JOS.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli ŵapocele yakulya kutyocela kwa jemanjajo, nambo nginawusya kwa AMBUJE pa yeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.14",
            "verseOrgIds": [
              "JOS.9.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa ŵatesile mkamulano wa ulongo ni ŵandu ŵa ku Gibiyoni nipo ŵakundile jemanjajo kutama nawo. Ŵakulongolela ŵa likuga lya Aisalaeli ŵalumbile kuti tacisunga mkamulanowo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.15",
            "verseOrgIds": [
              "JOS.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gali gapite masiku gatatu citendekwele mkamulanowo, Aisalaeli ŵamanyilile kuti ŵanduŵa ŵatamaga pakuŵandika. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.16",
            "verseOrgIds": [
              "JOS.9.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano Aisalaeli ŵatandite kuliŵicila cile nipo panyuma pa masiku gatatu ŵayice ku misinda kuŵatamaga ŵanduŵa: Gibiyoni, Kefila, Beeloti, ni Kiliyati Yelimu. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.17",
            "verseOrgIds": [
              "JOS.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Aisalaeli ngimkiniŵawulaga jemanjajo, ligongo ŵakulongolela ŵawo ŵaliji ali alumbile kwa jemanjajo mu lina lya AMBUJE, Mlungu jwa Aisalaeli. Ŵandu wosope ŵadandawile kwa ŵakulongolela ya celeci, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.18",
            "verseOrgIds": [
              "JOS.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "nambo ŵajanjile kuti, “Uwe tuŵisile cilanga",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "text": " mwakulumbila kwa jemanjajo mu lina lya AMBUJE Mlungu jwa Aisalaeli. Sambano ngakomboleka kuti uwe twapwetece jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.19",
            "verseOrgIds": [
              "JOS.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukuŵajilwa kwaleka aŵe cijumi ligongo lya cilanga cetu; naga ngatukutenda myoyo, Mlungu tacitutumbilila uwe. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.20",
            "verseOrgIds": [
              "JOS.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalece aŵe umi, nambo kuti jemanjajo taŵe ŵakutukatila sasu ni kututecela mesi uwe.” Ayi ni yiŵaganisisye ŵakulongolelawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.21",
            "verseOrgIds": [
              "JOS.9.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yoswa ŵalamwile kuti ayice nawo ŵandu ŵa ku Gibiyoni kwa jwalakwe, ni ŵawusisye jemanjajo, “Ligongo cici mwatulambwisye uwe ni kutusalila kuti mkutyocela kwakutalika, kutendaga mli mkutama kunokuno? ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.22",
            "verseOrgIds": [
              "JOS.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo lyakuti mwatesile yeleyi, Mlungu amlwesisye. Ŵandu ŵenu taciŵa acikapolo ndaŵi syosope, tacikatanyaga sasu ni kutwicila mesi ga ku nyumba ja Mlungu jwangu.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.23",
            "verseOrgIds": [
              "JOS.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵajanjile kuti, “Bwana, uwe twatesile myiyi, ligongo ŵatulondecesye cenenepe kuti yaliji yakuwona kusyesyene kuti AMBUJE Mlungu jwenu ŵamlamulile jwakutumicila jwakwe Mose",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "text": " kuti ŵape jemanja cilambo cosope cene nipo kuti ŵawulaje pameso pawo ŵandu ŵakutama mwelemo. Twatesile yeleyi ligongo twakwete woga ni jemanja; twajogopecesyaga umi wetu mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.24",
            "verseOrgIds": [
              "JOS.9.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano tuli m'myala mwawo; atende ni uwe yakuganisya kuti yili yambone.” ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.25",
            "verseOrgIds": [
              "JOS.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ayi ni yiŵayitesile Yoswa: jwalakwe ŵacinjilicisye jemanjajo nipo nginiŵakunda Aisalaeli kuti ŵawulaje. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.26",
            "verseOrgIds": [
              "JOS.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo soni ndaŵi jijojo jwalakwe ŵasandwisye kuŵa acikapolo, kuti akateje sasu ni kutwicila mesi ga Aisalaeli ni ga pa malo pakupelecela mbopesi pa AMBUJE. Mpaka lelo jino apitilisyeje kupanganya gele masengoga ku malo gasagwile AMBUJE kuti ŵalambilejeko.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.9.27",
            "verseOrgIds": [
              "JOS.9.27"
            ]
          }
        }
      ]
