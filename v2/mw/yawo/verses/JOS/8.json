        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 8:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe Yoswa ŵaŵalasile mwakwesya malamusi gosope gene, kupwatika ya upile mpaka ya kulwesa yakwe, mpela muŵagalembele m'buku ja Malamusijo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.34",
            "verseOrgIds": [
              "JOS.8.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 8:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lililyose lya Malamusi ga Mose lyaŵalanjidwe ni Yoswa ku msongano wosopewo, uwakwete acakongwe ni ŵanace mpaka acalendo ŵakutama pasikati pawo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.35",
            "verseOrgIds": [
              "JOS.8.35"
            ]
          }
        }
