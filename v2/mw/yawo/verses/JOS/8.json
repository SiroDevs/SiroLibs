              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Yoswa ŵataŵile malo ga kupelecela mbopesi kwa AMBUJE, Mlungu jwa Aisalaeli petumbi lya Eba.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
