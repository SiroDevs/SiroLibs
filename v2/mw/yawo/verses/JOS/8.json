              },
              "items": [
                {
                  "text": "Det 27:2-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.30",
            "verseOrgIds": [
              "JOS.8.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 8:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malogo ŵagapanganyisye mpela muŵaŵecetele Mose,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "text": " jwakutumicila jwa AMBUJE, yiŵapele Aisalaeli, mpela mugakuŵecetela malamusi ga Mlungu kupitila mwa Mose: “Pakupelecela mbopesi pakulinganya ni maganga gangasepa ni yida ya yisyano.” Pelepo ŵapelece kwa AMBUJE mbopesi syakutinisya, nipo soni ŵapelece mbopesi syawo sya mkamulano.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.20.25"
              },
              "items": [
                {
                  "text": "Eks 20:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.31",
            "verseOrgIds": [
              "JOS.8.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 8:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo, Aisalaeli ali mkulola, Yoswa ŵapanganyisye pa maganga kope ja Malamusi giŵalembile Mose. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.32",
            "verseOrgIds": [
              "JOS.8.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 8:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli, ni ŵakulongolela ŵawo, acakulungwa ŵa ngondo ni ŵakulamula, atamose acalendo wa pasikati pawo, ŵajimi mbali siŵili sya Libokosi lya Cilanga ca AMBUJE, kulolegana ni ŵakutaga mbopesi ŵa ci Lefi ŵiŵalinyakwilewo. Hafu ja ŵandu ŵajimi ali agalawucisye nyuma syawo ku Litumbi lya Gelisimu ni litika linelyo nyuma syawo sili sigalawucile ku Litumbi lya Eba. Mose jwakutumicila jwa AMBUJE ŵaliji ali ŵalamwile jemanjajo kutenda yeleyi pijayice ndaŵi jakuti apocele upile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.8.33",
            "verseOrgIds": [
              "JOS.8.33"
            ]
          }
        },
