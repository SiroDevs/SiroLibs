              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Finihasi ni ŵakulongolela ŵala ŵawujilile kutyocela kwa ŵanace ŵa Lubeni ni Gadi, mcilambo ca Giliyadi, kuja ku cilambo ca Kenani kwa ŵanace ŵa Aisalaeli ni kwasalila yosope yene. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli ŵajikutile ni kumlapilila Mlungu. Jemanjajo nganaŵeceta soni ya kuja kutenda ngondo ni konanga cilambo ciŵatamaga ŵandu ŵa lukosyo lwa Lubeni ni Gadi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        }
      ]
    },
