        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa Lubeni ni Gadi ŵatite, “Aga malo gambopesiga gali mboni kwa uwe wosope ŵene kuti AMBUJE ali Mlungu.” Myoyo malogo ŵagapele lina lyakuti “Mboni.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
