        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finihasi jwakutaga mbopesi ni acalume likumi ŵakulongolela ŵiŵayice najo kutyocela ku mitundu ja kungapilo lyuŵa piŵapikene yiŵaŵecete ŵandu ŵa mitundu ja Lubeni, Gadi, ni kungopoko lyuŵa kwa Manase, ŵajikutile nayo. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.30",
            "verseOrgIds": [
              "JOS.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Finihasi mwanace jwa Eliyesa jwambopesi, ŵatite kwa jemanjajo, “Sambano tumanyilile kuti AMBUJE ali pasikati petu. Jemanja nganiŵajimucila AMBUJE, myoyo jemanja ŵakulupwisye ŵandu ŵa ku Isalaeli ku cilango ca AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
            "verseOrgIds": [
              "JOS.22.31"
            ]
          }
        }
      ]
    },
