              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 24:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mawupa ga Yosefe, giŵayice nago Aisalaeli kutyocela ku Iguputo, ŵagasicile ku Shekemu, mkacilambo kiŵasumile Yakobo kwa ŵanace ŵa Hamoli, baba ŵawo ŵa Shekemu, ni mbiya syakwanila masilifa",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        },
        {
          "text": " 100. Cele cilamboci casandwice ca yisukulu ya Yosefe.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.32",
            "verseOrgIds": [
              "JOS.24.32"
            ]
          }
        },
