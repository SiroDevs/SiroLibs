          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 24:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe, yili yitendekwe yeleyi, jwakutumicila jwa AMBUJE Yoswa mwanace jwa Nuni ŵawile ali jwa yaka 110. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.29",
            "verseOrgIds": [
              "JOS.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa ku Isalaeli ŵamsicile mcilambo cakwe ku Timunati Sela mcilambo ca kwitumbi ca Efelemu kumpoto kwa Litumbi lya Gaashi.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.30",
            "verseOrgIds": [
              "JOS.24.30"
            ]
          }
        },
