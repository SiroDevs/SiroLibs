              },
              "items": [
                {
                  "text": "Gen 25:24-26",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.8"
              },
              "items": [
                {
                  "text": "36:8",
                  "type": "text"
                }
              ]
