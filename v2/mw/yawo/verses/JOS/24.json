        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 24:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jiŵaliji cijumi Yoswa, ŵandu ŵa ku Isalaeli ŵatumicile AMBUJE, nipo panyuma pa ciwa cakwe jemanjajo ŵapitilisye kutenda myoyo ndaŵi josope jiŵaliji umi ŵakulongolela ŵiŵayiweni yosope yiŵatendele AMBUJE Aisalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.31",
            "verseOrgIds": [
              "JOS.24.31"
            ]
          }
        }
      ]
    },
