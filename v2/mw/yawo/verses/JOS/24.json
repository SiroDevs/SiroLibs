              "items": [
                {
                  "text": "Det 2:5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.4",
            "verseOrgIds": [
              "JOS.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Panyuma pakwe natumisye Mose",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "text": " ni Aloni",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "text": " kuti ŵakamusye acinangolo ŵenu, ni nayicisye yisawusyo yejinji pa cilambo ca Iguputo. Nambo nakopwesye mu Iguputo acinangolo ŵenuwo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Eks 3:1—12:42",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.5",
            "verseOrgIds": [
              "JOS.24.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndili nakopwesye acinangolo ŵenu, asilikali ŵa ku Iguputo ŵakuyisye acinangolowo ali akwesile mahaci ni mageleta. Nambo piŵayice pa Nyasa Jecejewu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.6",
            "verseOrgIds": [
              "JOS.24.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.14.1+EXO.14.2+EXO.14.3+EXO.14.4+EXO.14.5+EXO.14.6+EXO.14.7+EXO.14.8+EXO.14.9+EXO.14.10+EXO.14.11+EXO.14.12+EXO.14.13+EXO.14.14+EXO.14.15+EXO.14.16+EXO.14.17+EXO.14.18+EXO.14.19+EXO.14.20+EXO.14.21+EXO.14.22+EXO.14.23+EXO.14.24+EXO.14.25+EXO.14.26+EXO.14.27+EXO.14.28+EXO.14.29+EXO.14.30+EXO.14.31"
              },
              "items": [
                {
                  "text": "Eks 14:1-31",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.6",
            "verseOrgIds": [
              "JOS.24.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵalisile kwa une kuti nakamucisye nipo naŵisile liwunde lya cipi pasikati pa jemanjajo ni Aiguputo. Najitendesye nyasa kuti jisefuce nipo Aiguputo ŵamisilwe ni mesi. Jemanja akumanyilila yinatesile Aiguputo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.7",
            "verseOrgIds": [
              "JOS.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“ ‘Jemanja ŵatemi mcipululu kwa ndaŵi jelewu, ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.7",
            "verseOrgIds": [
              "JOS.24.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo namyicisye ku cilambo ca Aamoli, ŵiŵatamaga ku mbali ja kungopoko lyuŵa kwa Yolodani. Jemanjajo ŵamputile, nambo une nampundisye kwa jemanjajo. Jemanja mwajigele cilambo cawo, nipo najonasile pimwajawulaga pasogolo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.8",
            "verseOrgIds": [
              "JOS.24.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.21.21+NUM.21.22+NUM.21.23+NUM.21.24+NUM.21.25+NUM.21.26+NUM.21.27+NUM.21.28+NUM.21.29+NUM.21.30+NUM.21.31+NUM.21.32+NUM.21.33+NUM.21.34+NUM.21.35"
              },
              "items": [
                {
                  "text": "Num 21:21-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.8",
            "verseOrgIds": [
              "JOS.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye jwa Mowabu, Balaki mwanace jwa Sipola, ŵamenyene ni jemanja. Jwalakwe ŵatumisye maloŵe kwa Balamu mwanace jwa Bewoli ni kumŵenda kuti amlwese jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.9",
            "verseOrgIds": [
              "JOS.24.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "text": "Num 22:1—24:25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.9",
            "verseOrgIds": [
              "JOS.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo une ngamkaningunda kuti Balamu amlwese, m'malo mwakwe namtendesye kuti ampe upile jemanja, nipo mu lyele litalali une namkulupwisye m'magasa mwa Balaki. ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.10",
            "verseOrgIds": [
              "JOS.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja mwajombwece Yolodani ni kwika ku Yeliko. Asilikali ŵa ku Yeliko ŵamenyene ni jemanja, mpela muŵatendele Aamoli, Apelesi, Akenani, Ahiti, Agiligashi, Ahifi, ni Ayebusi. Nambo une namtendesye kuti mwapunde wosopewo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.11",
            "verseOrgIds": [
              "JOS.24.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.3.14+JOS.3.15+JOS.3.16+JOS.3.17"
              },
              "items": [
                {
                  "text": "Yos 3:14-17",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.6.1+JOS.6.2+JOS.6.3+JOS.6.4+JOS.6.5+JOS.6.6+JOS.6.7+JOS.6.8+JOS.6.9+JOS.6.10+JOS.6.11+JOS.6.12+JOS.6.13+JOS.6.14+JOS.6.15+JOS.6.16+JOS.6.17+JOS.6.18+JOS.6.19+JOS.6.20+JOS.6.21"
              },
              "items": [
                {
                  "text": "6:1-21",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.11",
            "verseOrgIds": [
              "JOS.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pimwajawulaga pasogolo, une natendesye kuti ajogope ni kutetemela pakusosa kuti natoposye ayimwene ŵaŵili ŵa Aamoli. Une napundile jemanjajo m'malo mwenu. Ngaŵaga macili genu kapena kuti yida yenu ni yiyakamwile masengo.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.23.28"
              },
              "items": [
                {
                  "text": "Eks 23:28",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.7.20"
              },
              "items": [
                {
                  "text": "Det 7:20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.12",
            "verseOrgIds": [
              "JOS.24.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une nampele cilambo cimkutamaci cele nganimcikamulila masengo soni misinda jakwe nganimtaŵa jemanja. Mkulya yisogosi ya finyo ni ya olifi",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        },
        {
          "text": " kutyocela ku yitela yiŵapandile ŵandu ŵiŵatamaga mwelemo jemanja mkanimŵice.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "JOS.24.13",
            "verseOrgIds": [
              "JOS.24.13"
            ]
          }
        },
        {
