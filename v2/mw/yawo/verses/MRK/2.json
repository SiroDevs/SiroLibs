              "MRK.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MRK 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Soni pangali mundu jwakusatotelela cigamba ca cakuwala casambano ni kucitotelela pa cakuwala cakalakala. Ligongo naga akutenda myoyo, cigamba ca nguwo ja sambano cila cikusakwinyata ni kunyocola cakuwala cakala cila, soni kupapuka kwakwe kukusaŵa kwakukulungwa kulekangana ni pandanda. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.21",
            "verseOrgIds": [
              "MRK.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni pangali mundu jwakusataga finyo jwasambano mu misaku ja mapende gakalakala, ligongo naga akutenda myoyo, finyojo jukusawulisya misakujo, mwakuti finyojo pamo ni misakujo yikusajonasika. Nambo finyo jwasambano jukwenela kutajidwa mu misaku ja sambano.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.22",
            "verseOrgIds": [
              "MRK.2.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Lisiku lyakupumula lya Ayuda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MRK 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.22",
            "verseOrgIds": [
              "MRK.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MRK 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku line lyakupumula lya Ayuda, Yesu ŵaliji mkwenda kupitila m'migunda ja tiligu. Ali mkwenda myoyo, ŵakulijiganya ŵakwe ŵatandite kupulula masace ga tiligu ni kulyaga.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.23.25"
              },
              "items": [
                {
                  "text": "Det 23:25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.23",
            "verseOrgIds": [
              "MRK.2.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Afalisi ŵamwusisye Yesu kuti, “Ana ligongo cici ŵakulijiganya ŵenu akutenda yigakukana Malamusi kuyitenda pa lisiku lyakupumula?”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MRK 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.24",
            "verseOrgIds": [
              "MRK.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵajanjile kuti, “Ana nganimŵalanga yiŵatesile Daudi",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "text": " pampepe ni acimjakwe pa ndaŵi jijakwete sala ni kusoŵa kandu kalikose?",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1SA.21.1+1SA.21.2+1SA.21.3+1SA.21.4+1SA.21.5+1SA.21.6"
              },
              "items": [
                {
                  "text": "1 Sam 21:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.25",
            "verseOrgIds": [
              "MRK.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MRK 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja jila ŵajinjile m'Nyumba ja AMBUJE ni kuja kulya mikate jakupelecedwa kwa Mlungu. Yeleyi yatendekwe pa ndaŵi jiŵaliji Abiyatala jwamkulungwa jwa ŵakutaga mbopesi",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.26",
            "verseOrgIds": [
              "MRK.2.26"
            ]
          }
        },
        {
          "text": " wosope. Mikate jelejo jaliji jangajenela kulidwa ni mundu jwine jwalijose, akaŵe ŵakutaga mbopesipe. Soni Daudijo ŵawugaŵenye mkatewo kwa acimjakwe ŵiŵaliji nawo ŵala.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.26",
            "verseOrgIds": [
              "MRK.2.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.24.9"
              },
              "items": [
                {
                  "text": "Lef 24:9",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
