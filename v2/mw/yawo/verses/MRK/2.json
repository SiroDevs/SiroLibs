        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.26",
            "verseOrgIds": [
              "MRK.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MRK 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu pakupitilisya maloŵe, ŵasalile Afalisiwo kuti, “Mlungu ŵaŵisile lisiku lyakupumula kuti liŵe lya kwakamusya ŵandu. Nganiŵapanganya ŵandu kuti aŵe acikapolo ŵa lisiku lyakupumula. ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.27",
            "verseOrgIds": [
              "MRK.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MRK 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Mwanace jwa Mundu akwete ulamusi wosope wakwayana ni yakwenela kuyitenda pa lisiku lyakupumula.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.2.28",
            "verseOrgIds": [
              "MRK.2.28"
            ]
          }
        }
      ]
