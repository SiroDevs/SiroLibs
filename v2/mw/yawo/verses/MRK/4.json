                "loc": "LUK.6.38"
              },
              "items": [
                {
                  "text": "Luk 6:38",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MRK 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo mundu jwakwete kandu tacimjonjecesya yine; nambo mundu jumkinakola kalikose tacisumulidwa.”",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.25",
            "verseOrgIds": [
              "MRK.4.25"
            ]
          }
        },
