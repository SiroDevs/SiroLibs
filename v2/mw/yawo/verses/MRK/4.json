          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasalile soni kuti, “Msamalileje pa maloŵe gamkugapikana. Mlingo wumkukamulisya masengo pa kwalamula ŵandu ŵane, Mlungu tacikamulisya masengo mlingo uwowo pakumlamula jemanja, soni mlingo wa jemanja taciwujonjecesya mnope.",
          "type": "text",
          "attrs": {
            "verseId": "MRK.4.24",
            "verseOrgIds": [
              "MRK.4.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
