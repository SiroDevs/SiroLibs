                {
                  "text": "Yes 13:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EZK.32.7"
              },
              "items": [
                {
                  "text": "Esek 32:7",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
