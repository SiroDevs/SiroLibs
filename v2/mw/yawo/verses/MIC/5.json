            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo AMBUJE tacileka Isalaeli kwa amagongo ŵakwe mpaka pa ndaŵi jakuti jwamkongwe aŵelece mwanace. Pelepo ŵakusigala ŵa mtundu wakwe taciwujila soni kwa Aisalaeli acimjakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo pitaciyika, tacalamulila ŵandu ŵakwe ni macili gagakutyocela kwa AMBUJE ni ucimbicimbi wa lina lya AMBUJE Mlungu jikape. Ŵandu ŵakwe tacitama mu mtendele, pakuti ukulungwa wakwe tiwucitamilicika pa cilambo cosope capasi, ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo tipaciŵa mtendele.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kulupusidwa kaneko kupegwa cilango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asiliya pitacijinjila mcilambo mwetu ni kutanda kumenyana ni uwe, tucatumicisya acimlongola ŵa ngondo ŵamacili msano ni ŵatatu kumenyana nawo. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo tacicipunda cilambo ca Asiliya ni upanga, soni tacicilamulila mwa ngondo cilambo ca Nimulodi. Tacitukulupusya kwa Asiliya jemanjajo pitacijinjila mcilambo mwetu kukumenyana ni uwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.10.8+GEN.10.9+GEN.10.10+GEN.10.11"
              },
              "items": [
                {
                  "text": "Gen 10:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wosope ŵakusigalila ŵa Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        },
        {
          "text": " taciŵa upile pasikati pa mitundu jejinji ja ŵandu mpela mangame gakutukutyocela kwa AMBUJE. Taciŵa soni mpela mawawa ga ula pa manyasi gagakumela kwene. Tacijegamila pa Mlungu, ngaŵaga pa ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wosope ŵakusigalila ŵa Yakobo taciŵa malweso pasikati pa ŵandu ŵa mitundu ja ŵandu mpela lisimba pasikati pa nyama sya mwitinji. Taciŵa mpela mwanace jwa lisimba pasikati pa likuga lya ngondolo, ŵele akusati naga asijinjilile akusasikamula ni kusipacukulanya. Pakusaŵa pali pangali ŵakusikulupusya. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isalaeli tacapunda amagongo ŵakwe ni kwajonanga wosope.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.9",
            "verseOrgIds": [
              "MIC.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akwasalila Aisalaeli kuti, “Pa lisiku lyelelyo tinjijonanga mahaci genu gosope soni tinjipasulanya mageleta genu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.10",
            "verseOrgIds": [
              "MIC.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjijonanga misinda ja mcilambo mwenu ni kugwisya mapupa genu gakumcinjilicisya. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.11",
            "verseOrgIds": [
              "MIC.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjisokonesya matipwi genu gosope nipo ngasipasimanikwa soni jwakulondola cisango pasikati penu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.12",
            "verseOrgIds": [
              "MIC.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjijonanga tumilungu twenu twakupanganya ni yala pamo ni yipilala ya maganga yakwimika yakulambililapo mcilambo mwenu. Ngisimyitindiŵalila soni yindu yimwapanganyisye ni magasa genu. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.13",
            "verseOrgIds": [
              "MIC.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjigwisya tumilungu twenu twakupanganya twa Ashela mcilambo mwenu ni konanga misinda jakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.14",
            "verseOrgIds": [
              "MIC.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa ukali ni mwakutumbila tinjipeleka cilango kwa mitundu josope ja ŵandu jele nganijimbikanila.”",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.15",
            "verseOrgIds": [
              "MIC.5.15"
            ]
          }
        }
      ]
    }
