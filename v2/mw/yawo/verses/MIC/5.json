            "style": "v",
            "sid": "MIC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuti, “M'mwe Betelehemu jwa ku Efulati, m'mwejo mli jimo ja misinda ja mwana mnope ku Yuda, nambo kutyocela mwa m'mwejo tinjiyika ni jwakulamulila pa Isalaeli, jwele ndanda jakwe jili jakalakala mnope.”",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
