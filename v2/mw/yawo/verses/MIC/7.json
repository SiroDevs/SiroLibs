                "loc": "LUK.12.53"
              },
              "items": [
                {
                  "text": "Luk 12:53",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo une tinjijegamila pa AMBUJE. Tinjiŵika mtima wangu pa Mlungu mkulupusyo jwangu. Mlungu jwangu tacimbikana.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cikulupusyo cikwika ni AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja amagongo ŵetu mkatuseka. Elo, twagwile nambo tucijimuka soni. Pandaŵi ajino tuli mcipi nambo AMBUJE tacitupa lilanguka. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twalemwecesye AMBUJE, sambano tukwenela kupimilila pa lutumbilo lwakwe mpaka pa ndaŵi jitacilamula magambo getu nipo panyuma pakwe tacitujinjisya mu lilanguka, nipo tuciwona cikulupusyo cakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amagongo wetu taciwona yeleyi, nipo tacitenda soni ŵandu uŵatuwusyaga kuti, “Ali kwapi AMBUJE, Mlungu jwenu?” Tuciwona kupundidwa kwawo nipo tacapondanya mpela matope ga mu msewu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja ŵandu ŵa ku Yelusalemu, tijiciyika ndaŵi jakutaŵa soni mapupa gakulicinjilicisya. Pandaŵi jelejo malile genu tacigakusya. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.11",
            "verseOrgIds": [
              "MIC.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jelejo, ŵandu ŵenu taciwujila kwa m'mwejo kutyocela ku Asiliya mpaka ku Iguputo, kutyocela soni ku Iguputo mpaka kuja kwika ku Lusulo lwa Yufuleti, kutyocela soni ku nyasa jine mpaka kuja kwika ku nyasa jijakwe, soni kutyocela kwitumbi line mpaka kuja kwika kwitumbi lijakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilambo capasi ticiciŵa cipululu ligongo lya yakusakala ya ŵandu ŵakutama mwelemo. Gelego tigaciŵa malipilo ga masengo gawo.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya canasa ca AMBUJE pa Aisalaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalakwe AMBUJE, ŵalongole ŵandu ŵawo ni simbo ja ŵalakwe jakwacinjilicisya jemanjajo. Mlolele ngondolo siŵasisagwile. Sambano sikutama jikape mu ukwete pasikati pa cilambo ca cajila. Nambo asikunde kuti sikalye ku mopo wambone, ku Bashani ni ku Giliyadi mpela musyatendelaga kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuti, “Tinjilosya yakumasya lunda, mpela pa ndaŵi jimwakopokaga kutyocela ku Iguputo.” ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.15",
            "verseOrgIds": [
              "MIC.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa mitundu jejinji pitaciyiwona yeleyo tacitenda soni, atamose kuti akole macili gamtuli. Tacigamba kamula pakamwa ni kusiŵa mapikanilo gawo mwakwasa mtima. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacikwaŵaga pa litaka mpela majoka, mpela soni yakupanganyidwa yine yakwaŵa. Taciyika ali mkutetemela ni ŵa woga kutyocela ku malo gawo gakucinjilicisidwa. Mwa woga tacigalawucila kwa ŵalakwe AMBUJE, Mlungu jwetu nipo tacitenda woga ni ŵalakwe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MIC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ŵani ŵali Mlungu mpela ŵalakwe, ŵele ŵakusakululucila ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        },
        {
          "text": " ni kuliŵalila yakulemwa ya ŵandu ŵawo ŵakusigala? Ŵalakwe ŵangatumbila mpaka kalakala, ligongo lyakuti akweti cinonyelo cangacenga. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MIC 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacitutendela soni uwe canasa. Taciyiliŵatila pasi yakulemwa yetu, ni kwasa ulemwa wetu wosope pasi pa nyasa. ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.19",
            "verseOrgIds": [
              "MIC.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MIC 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalakwe tacilosya kulupicika kwawo kwa ŵandu ŵawo yisukulu ya Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.20",
            "verseOrgIds": [
              "MIC.7.20"
            ]
          }
        },
        {
          "text": " ni Abulahamu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.20",
            "verseOrgIds": [
              "MIC.7.20"
            ]
          }
        },
        {
          "text": " mpela muŵatendele cilanga",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.20",
            "verseOrgIds": [
              "MIC.7.20"
            ]
          }
        },
        {
          "text": " kwa acinangolo ŵetu kalakala.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.20",
            "verseOrgIds": [
              "MIC.7.20"
            ]
          }
        }
      ]
    }
  ],
