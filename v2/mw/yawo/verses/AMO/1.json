              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo tinjitumisya moto pa mapupa gakuwucinjilicisya msinda wa Gasa, ni mapupago tigacijocedwa. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.7",
            "verseOrgIds": [
              "AMO.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjijonanga ŵandu wosope ŵakutama ku Ashidodi, soni mundu jwakukamulila simbo ja ucimwene wa ku Ashikeloni. Ni mkono wangu, tinjawulaga ŵandu ŵa mu msinda wa Ekiloni, nipo Afilisiti wosope ŵakusigalila tacijonasika.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.8",
            "verseOrgIds": [
              "AMO.1.8"
            ]
