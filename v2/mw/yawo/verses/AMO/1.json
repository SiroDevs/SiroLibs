        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.1.3",
            "verseOrgIds": [
              "AMO.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
