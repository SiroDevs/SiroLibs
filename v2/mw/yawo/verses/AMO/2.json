              "AMO.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Ŵandu ŵa ku Yuda akupitilisya kulemwa, myoyo tinjapa cilango. Jemanjajo anyosisye malamusi ga une AMBUJE, soni nganakuya majiganyo gangu. Jemanjajo jasokonesye milungu jawo ja unami jiŵatumicilaga acinangolo ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.4",
            "verseOrgIds": [
              "AMO.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni ligongo lyakwe tinjitumisya moto ku Yuda kuti ujoce mapupa ga ku Yelusalemu.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cilango ca Mlungu pa Isalaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.5",
            "verseOrgIds": [
              "AMO.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Ŵandu ŵa ku Isalaeli akupitilisya kulemwa, myoyo tinjapa cilango. Jemanjajo akusiŵasumisya ku ukapolo ŵandu ŵakucimbicikwa ŵele akusalepela kulipila ngongole syawo, soni ŵakulaga ŵele ŵakusalepela kulipila mbiya pa sapato siŵajigele. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.6",
            "verseOrgIds": [
              "AMO.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akusiŵalila masuku pa mtwe ŵandu ŵakulaga, soni ŵangasaka kwalolela ŵandu ŵakulagasidwa. Mundu ni babagwe akusagona ni mwali jumpepe jwele jwali kapolo, myoyo akusalinyosya lina lyangu lyeswela. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.7",
            "verseOrgIds": [
              "AMO.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanduwo akusagona pambali pa malo galigose gakumlambila Mlungu, pa yakuwala yiŵasumwile kwa ŵakulaga mpela cikole. Akusamwela finyo m'Nyumba ja AMBUJE jwawo, jwele jwamjigele kwa ŵandu ŵiŵakongwele jemanjajo mbiya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.8",
            "verseOrgIds": [
              "AMO.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "AMO 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nipo jemanja, ŵandu ŵangu, yaliji ligongo lya jemanja kuti najonasile Aamoli, ŵele ulewu wawo waliji mpela yitela ya mikungusa nambo soni macili gawo galiji mpela yitela ya mtundu.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.3.8+DEU.3.9+DEU.3.10+DEU.3.11"
              },
              "items": [
                {
                  "text": "Det 3:8-11",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.9",
            "verseOrgIds": [
              "AMO.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "AMO 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une namkopwesye jemanja ku cilambo ca Iguputo. Une ni junamlongolele jemanja mcipululu yaka 40, ni kumpa jemanja cilambo ca Aamoli kuti ciŵe cenu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.10",
            "verseOrgIds": [
              "AMO.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "AMO 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une nasagwile ŵane mwa ŵanace ŵenu kuti aŵe ŵakulocesya, ni ŵane soni kuti aŵe Anasili. Ana ngaŵaga myoyo, jemanja ŵandu ŵa ku Isalaeli? Une AMBUJE mbecete myoyo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "NUM.6.1+NUM.6.2+NUM.6.3+NUM.6.4+NUM.6.5+NUM.6.6+NUM.6.7+NUM.6.8"
              },
              "items": [
                {
                  "text": "Num 6:1-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.11",
            "verseOrgIds": [
              "AMO.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "AMO 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mwatendekasisye Anasiliwo kuti akase cilanga",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        },
        {
          "text": " cawo pakumwa finyo, ni kwalamula ŵakulocesya kuti akalocesya. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.12",
            "verseOrgIds": [
              "AMO.2.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "AMO 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane! Une tinjimtwinyicisya pasi kumangwenuko, nipo timcilila mpela ngolo jajigumbele ni tiligu. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.13",
            "verseOrgIds": [
              "AMO.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "AMO 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atamose mundu jwakuwutuka mnope ngasapakombola kutila; ŵamacili mnope ngisaŵa soni ni macili, nipo asilikali ngasapakombola kulupusya ma umi gawo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.14",
            "verseOrgIds": [
              "AMO.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "AMO 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwa mawukunje ngasapakombola kulimbicila, ŵakuwutuka mnope ngasakulupuka, soni ŵandu ŵakwela pa mahaci ngasakulupusya ma umi gawo. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.15",
            "verseOrgIds": [
              "AMO.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "AMO 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa lisiku lyelelyo atamose asilikali ŵakulimba mnope mitima, tacitila ali kwasa yida yawo ya ngondo.” AMBUJE aŵecete myoyo.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.16",
            "verseOrgIds": [
              "AMO.2.16"
            ]
          }
        }
      ]
    }
