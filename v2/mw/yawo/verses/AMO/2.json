          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni ligongo lyakwe tinjitumisya moto ku Mowabu ni koca mapupa ga ku Keliyoti. Ŵandu ŵa ku Mowabu taciwa mu masegwe ga ngondo, asilikali ali mkugumila ni kulisya malipenga. ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.2",
            "verseOrgIds": [
              "AMO.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjiwulaga jwakulamulila jwa ku Mowabu ni nduna syakwe.”",
          "type": "text",
          "attrs": {
            "verseId": "AMO.2.3",
            "verseOrgIds": [
              "AMO.2.3"
            ]
          }
        }
      ]
    },
