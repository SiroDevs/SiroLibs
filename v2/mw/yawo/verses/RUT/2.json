          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Lute ŵasalile kuti ŵawululaga mu mgunda wa mundu jwine lina lyakwe Bowasi.",
          "type": "text",
          "attrs": {
            "verseId": "RUT.2.19",
            "verseOrgIds": [
              "RUT.2.19"
            ]
          }
        }
      ]
