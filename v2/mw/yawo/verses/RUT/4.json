          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aminadabu ŵaŵelece Nashoni, Nashoni ŵaŵelece Salimoni, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.20",
            "verseOrgIds": [
              "RUT.4.20"
            ]
