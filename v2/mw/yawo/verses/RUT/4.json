              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Salimoni ŵaŵelece Bowasi, Bowasi ŵaŵelece Obedi, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.21",
            "verseOrgIds": [
              "RUT.4.21"
            ]
          }
