          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hesiloni ŵaŵelece Lamu, Lamu ŵaŵelece Aminadabu. ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.19",
            "verseOrgIds": [
