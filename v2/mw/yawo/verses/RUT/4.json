              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano yisukulu ya Pelesi ni ayi: Pelesi ŵaŵelece Hesiloni, ",
          "type": "text",
          "attrs": {
            "verseId": "RUT.4.18",
            "verseOrgIds": [
