              "type": "text"
            }
          ]
        },
        {
          "text": "Aga gali maloŵe giŵalembesye m'buku, jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
        {
          "text": " Yelemiya kwa Baluki mwanace jwa Neliya, caka ca mcece ca ucimwene wa Yehoiyakimu mwanace jwa Yosiya mwenye jwa ku Yuda:",
          "type": "text",
          "attrs": {
            "verseId": "JER.45.1",
            "verseOrgIds": [
              "JER.45.1"
            ]
          }
        },
