          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.1",
            "verseOrgIds": [
              "JER.2.1"
            ]
          }
        },
        {
          "text": " ŵasalile une acitiji kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.1",
            "verseOrgIds": [
              "JER.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "mjawule mkagombelesye kwa ŵandu ŵosope ŵa ku Yelusalemu ali mkupikana kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.2",
            "verseOrgIds": [
              "JER.2.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ulemwa wa acinangolo ŵakala ŵa Aisalaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.3",
            "verseOrgIds": [
              "JER.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane maloŵe ga AMBUJE jemanja ŵimli yisukulu ya Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.4",
            "verseOrgIds": [
              "JER.2.4"
            ]
          }
        },
        {
          "text": " nambo soni ŵimli ŵa mwiŵasa lya Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.4",
            "verseOrgIds": [
              "JER.2.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mlungu akwajimba magambo ŵandu ŵakwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakuyicisya ya ungakulupicika wa Aisalaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Aisalaeli ŵakanile kumpembeka Mlungu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.19",
            "verseOrgIds": [
              "JER.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Mlungu akuŵeceta kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.20",
            "verseOrgIds": [
              "JER.2.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Isalaeli akwenela kupegwa cilango",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.25",
            "verseOrgIds": [
              "JER.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Liŵasa lya Isalaeli tilicitenda soni, mpela mwakusatendela ŵawiyi naga ali akamwilwe. Jemanja Aisalaeli pamo ni ayimwene ŵenu, ŵakutaga ŵenu mbopesi ni ŵakulocesya ŵenu, wosopemwe timcitenda soni. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.26",
            "verseOrgIds": [
              "JER.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja wosope timcitenda soni ni kucisalila citela kuti, m'mwejo mli baba ŵetu, soni liganga lili mama ŵetu. Nambo une akusandumbilila, m'malo mwakugalawucila kwa Une. Nambo naga mli pa yipwetesi mkusimumbenda kuti yice kukumkamusya jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.27",
            "verseOrgIds": [
              "JER.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambi milungu jenu jili kwapi, ajila jimwalipanganyicisye mwacimsyene jila? Jiyicetu kuti jimkulupusye, pa ndaŵi jenu ja yipwetesi. Jemanja ŵandu ŵa ku Yuda, mkwete milungu jejinji, winji wakwe mpela mujitupile misinda jenu.” ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.28",
            "verseOrgIds": [
              "JER.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ligongo cici mkunjimba magambo? Ligongo cici soni jemanja mkunjimucila une? Napelece cilango kwa ŵanace ŵenu mwangapindula cilicose, jemanjajo nganalijiganya kalikose kutyocela ku cilango cinapelececo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.29",
            "verseOrgIds": [
              "JER.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela mulikusatendela lisimba lya ukali, jemanja mwawuleje ŵakulocesya ŵenu ni upanga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.30",
            "verseOrgIds": [
              "JER.2.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja ŵimli ŵa mpago awuno, mgapikanileje maloŵe ginguŵeceta unejiga. Ana mbele mpela cipululu kwa jemanja Aisalaeli, kapena ndili mpela cilambo ca cipi camti bii? Nambi ligongo cici sambano ŵandu ŵangu akuŵeceta kuti, uwe tuli alukosyo, soni tukusituyika kwa jemanja? ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.31",
            "verseOrgIds": [
              "JER.2.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana mwali akusaliŵalila yakulisalalisya nayo pa cilu, kapena mlombela kuliŵalila yakuwala yakwe ya ulombela? Nambope ŵandu ŵangu andiŵalile une kwa masiku gejinji. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.32",
            "verseOrgIds": [
              "JER.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja akusamanyilila cenene matala gakupatila maganja gapacisyepela. Atamose acakongwe ŵakusakala mnope, jemanja ni ŵimkusimwajiganyaga jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.33",
            "verseOrgIds": [
              "JER.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakuwala yenu yicejele ni miasi ja ŵandu ŵakulaga ŵangalemwa. Jemanja nginimwasimana ŵanduwo ali mkasanya majumba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.34",
            "verseOrgIds": [
              "JER.2.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atamose kuti yindu yili myoyo, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.34",
            "verseOrgIds": [
              "JER.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja mkuŵecetaga kuti, ‘Tuli ŵangalemwa, lutumbilo lwa Mlungu lutondweŵe sambano!’ Une tinjimjimbape magambo ligongo lyakuŵeceta kuti nganimlemwa. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.35",
            "verseOrgIds": [
              "JER.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana ligongo cici mkulinyosya mwacimsyene pagambaga kucengacenga matala genu! Iguputo tacimkamulisya liganga lya moto mpela muŵamtendekasisye jemanja soni Asiliya ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.36",
            "verseOrgIds": [
              "JER.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Timcikopoka kweleko jwalijose jwa jemanjaji ali akamwile makono ku mtwe. Une AMBUJE nakanile ŵimkusimwajegamila jemanja, nipo jemanjajo ngisamkamucisya atamose panandi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.2.37",
            "verseOrgIds": [
              "JER.2.37"
            ]
          }
        }
      ]
    }
  ],
