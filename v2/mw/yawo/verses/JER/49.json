                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAL.1.2+MAL.1.3+MAL.1.4+MAL.1.5"
              },
              "items": [
                {
                  "text": "Mala 1:2-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.7",
            "verseOrgIds": [
              "JER.49.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 49:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwujile ŵandu ŵa ku Dedani, mtile ni mkajuŵe ku yiŵata. Kusyene, une tinjipeleka cilango kwa yisukulu ya Esawu pa lisiku lyakwe lya kulamula. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.8",
            "verseOrgIds": [
              "JER.49.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 49:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ŵandu akukaŵa mipeleya akusaleka panandi mu nyambi, nambo naga ŵawiyi ayice ndaŵi ja cilo, akusamba kujigala ayo yakusakayo ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.9",
            "verseOrgIds": [
              "JER.49.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 49:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo une ndyosisye yipanje yosope ya yisukulu ya Esawu. Nigalosisye pakulanguka malo gawo gakuŵa, pangali soni pakuti mpaka ajuŵe. Ŵanace ŵawo, acalongo acimjawo ŵakwe ajonasice, pangali jwine jwasigele. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.10",
            "verseOrgIds": [
              "JER.49.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalece ŵanace ŵenu ŵamasijewo, tinalele une; soni mwalece acakongwe ŵenu ŵamasijewo angulupilileje une.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.11",
            "verseOrgIds": [
              "JER.49.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 49:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.11",
            "verseOrgIds": [
              "JER.49.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 49:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Naga ŵele ŵiŵaliji ŵangaŵajilwa kumwela mgawo wa cilango ayice amwe nditu. Kuli uli jemanja, ana mkuganisya kuti timciŵa ŵangapegwa cilango? Pepani, timcipegwape cilango, nipo timcimwa kwene mgawowo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.12",
            "verseOrgIds": [
              "JER.49.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngulumbila une namsyene, akuti myoyo AMBUJE. Msinda wa Bosila tiwuciŵa cindu cakunyalaya, citacicisekaga ŵandu, cangali kandu soni celwesece. Misi jakwe josope tijiciŵa masame mpaka kalakala.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.13",
            "verseOrgIds": [
              "JER.49.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 49:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.13",
            "verseOrgIds": [
              "JER.49.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 49:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbikene utenga wakutyocela kwa AMBUJE jwa mtenga atumidwe kwa ŵandu ŵa mitundu jine.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.14",
            "verseOrgIds": [
              "JER.49.14"
            ]
          }
        },
        {
          "text": " Akugumila kuti, “Msongane pamo kuti m'menyane ni ŵandu ŵa ku Edomu, jimukani kuti mliŵicile cile kuputa ngondo! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.14",
            "verseOrgIds": [
              "JER.49.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 49:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjimnondiya sikati ja mitundu josope, nipo ŵandu wosope tacimnyosya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.15",
            "verseOrgIds": [
              "JER.49.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupoka kwenu kumlambwisye, kogoya kwenu kumsokonesye, m'mwe ŵakutama mu mbanga, m'malwala, ku matumbi. Atamose mtaŵe cisusi cenu penani mnope mpela cijuni ca ngwasi, tinjimtulusya pelepo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.16",
            "verseOrgIds": [
              "JER.49.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 49:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.16",
            "verseOrgIds": [
              "JER.49.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 49:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuti, “Cilambo ca Edomu ticiciŵa cakutesya soni. Wosope ŵakupitamo tacitenda mselu, ni kusonyaga ligongo lyakonasika kwakwe kwakogoya. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.17",
            "verseOrgIds": [
              "JER.49.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 49:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela muwajonasicile msinda wa Sodomu ni Gomola pamo ni misi jakwe jakusyungulila. Myoyo soni ngasimuŵamo mundu jwalijose. Pangali ni jumo jose jutacijendamo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.18",
            "verseOrgIds": [
              "JER.49.18"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.19.24+GEN.19.25"
              },
              "items": [
                {
                  "text": "Gen 19:24-25",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.18",
            "verseOrgIds": [
              "JER.49.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 49:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela mulikusajogoyecesya lisimba lyakopoka mu ukweti wa Yolodani, likusajogoya ngondolo syasili syecinjilicisidwe cenene, Une soni mwacisisimucisya tinjatopocesya Aedomu kwakutalikangana ni kumangwawo. Kaneko tinjaŵicila jwakulamulila jwele jutinjimsosa une. Ana ŵani ŵampaka alandane ni une? Ana ŵani ŵampaka anjawusye ku nganya ja magambo? Ana mlongola jwakwe jwapi jwampaka asisyane ni une. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.19",
            "verseOrgIds": [
              "JER.49.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 49:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpikane ku yele yindesile yakwasisya ŵandu ŵa ku Edomu, ni yele yingusaka kutenda kwa ŵandu ŵa mu msinda wa Temani. Ŵanace ŵawo tacijigalidwa, nipo ŵandu wosope taciŵa ŵakudandawula mnope ni likungu lyawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.20",
            "verseOrgIds": [
              "JER.49.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 49:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilambo capasi ticicitetemela ligongo lya kugwa kwawo. Kulila kwawo tikucipikanika mpaka ku Nyasa Jecejewu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.21",
            "verseOrgIds": [
              "JER.49.21"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.21",
            "verseOrgIds": [
              "JER.49.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 49:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mtundu wine tiwucitenda kuguluka ni kuja kukugwila ku Bosila mpela ngwasi ja mapapiko getambasukuce. Pa lisiku lyelelo mitima ja ŵandu ŵa ngondo ŵa ku Edomu tijiciŵa mwinani ligongo lya woga, mpela jwamkongwe pa ndaŵi jakwe jakuŵeleka.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.22",
            "verseOrgIds": [
              "JER.49.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cilango ca AMBUJE pa msinda wa Damasiko",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 49:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.22",
            "verseOrgIds": [
              "JER.49.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 49:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi ni yakuŵeceta AMBUJE yakwamba Damasiko, “Ŵandu ŵa ku Hamati ni ku Alipadi ali ŵakudandawula mnope ligongo ŵapikene utenga wakusakala. Mtima wawo usitopelwe ni woga, soni uli wangatamilicika mpela nyasa jangatama bata.",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.23",
            "verseOrgIds": [
              "JER.49.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ISA.17.1+ISA.17.2+ISA.17.3"
              },
              "items": [
                {
                  "text": "Yes 17:1-3",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "AMO.1.3+AMO.1.4+AMO.1.5"
              },
              "items": [
                {
                  "text": "Amo 1:3-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ZEC.9.1"
              },
              "items": [
                {
                  "text": "Sak 9:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.23",
            "verseOrgIds": [
              "JER.49.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 49:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa mu msinda wa Damasiko ajasile mtima, akusosa kutila ligongo lyakukamulwa ni woga wekulungwa. Ali pa yipwetesi ni ululu yamti mpela ya jwamkongwe jwakuŵeleka mwanace. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.24",
            "verseOrgIds": [
              "JER.49.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 49:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msinda wakupikanika ula ulecedwe, wele uwaliji mkusangalala pa ndaŵi jelejo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.25",
            "verseOrgIds": [
              "JER.49.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 49:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ali ni ligongo lyakwe acacanda ŵakwe tacigwa m'maluŵala gakwe, nipo asilikali ŵakwe wosope tacijonanjidwa lisiku lyelelo ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.26",
            "verseOrgIds": [
              "JER.49.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjijoca mapupa gosope ga msinda wa Damasiko, moto wakwe tiwucitinisya nyumba sya macili Beni Hadadi.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya cilango ku lukosyo lwa Kedala ni msinda wa Hasoli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JER 49:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.27",
            "verseOrgIds": [
              "JER.49.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JER 49:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwamba ya lukosyo lwa Kedala ni ya ma ucimwene ga ku Hasoli gele Nebukadinesa mwenye jwa ku Babiloniya giŵagapundile, AMBUJE akuŵeceta kuti, “Nyakukani mkamenyane ni ŵandu ŵa ku Kedala ni kwajonanga ŵandu ŵa kungopoko lyuŵa! ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.28",
            "verseOrgIds": [
              "JER.49.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgwisye matenti gawo ni msumule ngondolo syawo. Mjigale nguwo ni katundu jwawo josope m'matentimo. Msumule soni ngamila",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.29",
            "verseOrgIds": [
              "JER.49.29"
            ]
          }
        },
        {
          "text": " syawo. Ŵandu tacigumilila jemanjajo acitiji kuti, ‘Yakogoya yimsyungulile!’",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.29",
            "verseOrgIds": [
              "JER.49.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JER 49:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.29",
            "verseOrgIds": [
              "JER.49.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JER 49:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jemanja ŵandu ŵa ku Hasoli, mtile, mjanguye, mkajuŵe kwakutalicila. Nebukadinesa, mwenye jwa ku Babiloniya, ali cile kuti amenyane ni jemanja, akuti myoyo AMBUJE, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.30",
            "verseOrgIds": [
              "JER.49.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Nyakukani! Mkapute ngondo ni mtundu wa ŵanduwo wawuli pa mtendele, ŵandu ŵakuganisya kuti ali pambone. Msinda wawo uli wangali yipata kapena maloko mwakuti ugambile kuŵa ŵangali citetelo.’",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.31",
            "verseOrgIds": [
              "JER.49.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JER 49:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.31",
            "verseOrgIds": [
              "JER.49.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JER 49:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mjigale ngamila ni yilangwa yawo yosope. Tinjapwilinganya ŵandu ŵakusasenga umbo syawo mu mbali, tinjiyika ni yakogoya pa jemanjajo kutyocela mbali syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.32",
            "verseOrgIds": [
              "JER.49.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hasoli taciŵa masame, malo gakutama masogo mpaka kalakala. Mwelemo ngisimutama soni mundu, akuti myoyo AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya cilango ca Edomu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JER 49:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.33",
            "verseOrgIds": [
              "JER.49.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JER 49:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sedekiya mwenye jwa ku Yuda, pa ndaŵi jiŵatandite kwene kulamulila, AMBUJE ŵaŵecete ni jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        },
        {
          "text": " Yelemiya yakwamba Elamu. Ŵatite kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.34",
            "verseOrgIds": [
              "JER.49.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 49:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵatite kuti, “Tinjiwulaga wosope ŵakamulisya masengo mipamba ja ŵandu ŵa ku Elamu uŵatendesyaga jemanjajo kuti aŵe ŵamacili. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.35",
            "verseOrgIds": [
              "JER.49.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JER 49:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjiyikasya mbungo pa ŵandu ŵa ku Elamu kutyocela ku mbali syosope, ni kwapwilinganya ŵandu, nipo ngasipasimanikwa cilambo cele ngasajawulako ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.36",
            "verseOrgIds": [
              "JER.49.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JER 49:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa ku Elamuwo tinjatesya woga pameso pa amagongo ŵawo nambo soni pameso pa ŵele ŵakusaka konanga ma umi gawo. Tinjatumbilila jemanjajo. Tinjawutusya ni lipanga mpaka kwawulaga. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.37",
            "verseOrgIds": [
              "JER.49.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JER 49:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjajonanga ayimwene ni acimlongola ŵawo, nipo tinjiŵika citengu cangu ca ucimwene ku Elamuko. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.38",
            "verseOrgIds": [
              "JER.49.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JER 49:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambope, pasogolo pakwe tinjipeleka ukoto kwa ŵandu ŵa ku Elamu.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.49.39",
            "verseOrgIds": [
              "JER.49.39"
            ]
          }
        }
      ]
    }
  ],
