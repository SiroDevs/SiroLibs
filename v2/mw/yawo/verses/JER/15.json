        },
        {
          "text": "Kaneko AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "text": " ŵasalile kuti, “Atamose kuti Mose",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
          "text": " ni Samuele akajime pameso pangu ni kwacondelela ŵandu ŵeleŵa, ngamkaninakolela canasa ŵandu ŵeleŵa. Mwatyosyani, kuti ngawona soni, ajawuleje basi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.1",
            "verseOrgIds": [
              "JER.15.1"
            ]
          }
        },
        {
