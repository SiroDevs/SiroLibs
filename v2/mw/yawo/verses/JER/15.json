          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga akamwusye kwakuŵajilwa kwawula jemanjajo, m'mwejo mkasalile kuti Une mbecete kuti:",
          "type": "text",
          "attrs": {
            "verseId": "JER.15.2",
            "verseOrgIds": [
              "JER.15.2"
            ]
          }
        },
