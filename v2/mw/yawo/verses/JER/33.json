        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Ŵamaciligosope akuŵeceta kuti, “Ku malo agano gagali mpela cipululu kwakuli kwangali mundu kapena yinyama, ni ku misinda jakwe josope tikuciŵa malo gakulicisya yilangwa kutacilanjilanga ŵakucinga ngondolo syawo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku misinda ja ku matumbi, ku ciŵata, kum'mwela ku Negebu, ku upande wa Benjamini, ku yilambo yakuŵandikana ni Yelusalemu nambo soni ku misinda ja Yuda, ngondolo tisicijawula pameso pa mundu jwakusiŵalanga, AMBUJE akuti myoyo.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
