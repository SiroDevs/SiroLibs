        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Ŵandu akusaŵeceta kuti malo agano gali masame, mwele mwamuli mwangali mundu kapena nyama. Nambo m'misinda ja ku Yuda ni m'misewu ja Yelusalemu mwamuli sii, mwangali mundu soni atamose nyama, timucipikanika ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "masegwe gakusangalala ni ga lukondwa, maloŵe ga lukondwa ga mlombela jwamlume ni jwamkongwe. M'Nyumba jangu soni timucipikanika nyimbo ja ŵandu wakuja kupeleka mbopesi syakutogolela Mlungu. Nyimbo jakwe tacitiji kuti,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
