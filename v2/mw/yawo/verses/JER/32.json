                {
                  "text": "2 Ayi 23:10",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.7.30+JER.7.31"
              },
              "items": [
                {
                  "text": "Yel 7:30-31",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JER.19.1+JER.19.2+JER.19.3+JER.19.4+JER.19.5+JER.19.6"
              },
              "items": [
                {
                  "text": "19:1-6",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.34",
            "verseOrgIds": [
              "JER.32.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JER 32:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apanganyisye malo gakupelecela mbopesi kwa Baala ku Ciŵata ca Benihinomu kuti apelecelepo ŵanace ŵawo ŵacalume ni ŵacakongwe mpela mbopesi kwa Moleki. Une ngininalamula jemanjajo kuti atende yeleyi, soni nganiyijinjila mu nganisyo syangu kuti jemanjajo mpaka atende cindu camti myiyi ni kwatendekasya ŵandu ŵa ku Yuda kuti alemwe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.32.35",
            "verseOrgIds": [
              "JER.32.35"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
