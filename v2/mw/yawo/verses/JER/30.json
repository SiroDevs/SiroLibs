              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.7",
            "verseOrgIds": [
              "JER.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Ŵamaciligosope Mlungu jwa Aisalaeli akuŵeceta kuti, “Pa lisiku lyelelo tinjiposokolanya likongwa lya ukapolo mlukosi mwawo, tinjikutula ngonji sisyataŵile. Aisalaeli ngasaŵa soni acikapolo kapena ŵandu ŵa cilendo. ",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.8",
            "verseOrgIds": [
              "JER.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacigamba kwatumicila AMBUJE, Mlungu jwawo, ni Daudi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        },
        {
          "text": " mwenye jwawo, jwele jutinjasagulila.”",
          "type": "text",
          "attrs": {
            "verseId": "JER.30.9",
            "verseOrgIds": [
              "JER.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
