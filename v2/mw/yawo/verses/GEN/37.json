          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵiji jelejo ni kuti Amidiyani ŵala ŵaliji ali amsumisye Yosefe ku Iguputo kwa Potifala, juŵaliji jwamkulungwa jwa asilikali ŵakulondela nyumba ja Mwenye jwa ku Iguputo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.37.36",
            "verseOrgIds": [
              "GEN.37.36"
            ]
          }
