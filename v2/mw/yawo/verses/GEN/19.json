            "sid": "GEN 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jumo jwa malayika gala ŵatite kwa Loti, “Yambone njiticisye. Ka msinda keleko nginikajonanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.21",
            "verseOrgIds": [
              "GEN.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mjanguye! Mwutuce! Une ngindenda kandu kalikose mpaka patimkayice m'mwejo kweleko.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loti ŵawutwice ni ŵajile kwika ku kamsinda kala. Ni ligongo lyakwe kamsindako ŵakakolasile lina lyakuti Sowali, ligongo Loti pakuŵeceta ni malayika gala ŵatite uli wawunondi.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.22",
            "verseOrgIds": [
              "GEN.19.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Konasika kwa Sodomu ni Gomola",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
