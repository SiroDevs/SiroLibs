            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Abulahamu",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "text": " ŵajimwice kundaŵindaŵipe, ni ŵawutucile kumalo galagala, gaŵajimi pameso pa AMBUJE gala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.27",
            "verseOrgIds": [
              "GEN.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ŵalolite ku misinda ja Sodomu ni Gomola ni ku ciŵata cila. Nipo ŵagambile kuliwona lyosi lili mkutuka tolo, kukopoka m'ciŵatamo mpela lyosi lyakukopoka mu ufuni. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.28",
            "verseOrgIds": [
              "GEN.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo, Mlungu piŵajonangaga misinda ja mciŵata jila, ŵalikumbucile lipopelo lya Abulahamu, nipo ŵamkulupwisye Loti ku moto wakogoya uwajonasile misinda jiŵatamaga Loti jila.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kutanda kwa Amowabu ni Aamoli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.29",
            "verseOrgIds": [
              "GEN.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Loti ŵa ŵakopwece mu msinda wa Sowali ni ŵajile kutama ku matumbi ni ŵanace ŵakwe ŵacakongwe ŵaŵili ŵala, ligongo ŵajogopaga kutama mu msindamo. Ni wosopewo ŵaliji mkutama mu mbanga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.30",
            "verseOrgIds": [
              "GEN.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwamkulungwa ŵamsalile mpwakwe kuti, “Baba ŵetu akucekulupa sambano, nambo soni pangali mundu jwalijose pa cilambo cosope capasi jwampaka atulombe. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.31",
            "verseOrgIds": [
              "GEN.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwende twakolelwesye baba ŵetuŵa ni finyo, kuti agone ni uwe kuti tupate ŵanace kupitila mwa baba ŵetu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.32",
            "verseOrgIds": [
              "GEN.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo cele ciloco ŵanacewo ŵapele finyo baba ŵawo. Ali atesile myoyo, jwamkulungwa jula ŵajinjile kuja kugona ni baba ŵawo. Pelepo ni kuti baba ŵawo ŵala ali akolelwe mnope, nipo nginayimanyilila yiyatendekwaga.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "GEN 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.33",
            "verseOrgIds": [
              "GEN.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kundaŵi kwakwe jwamkulungwa jula ŵamsalile mpwakwe jula kuti, “Une liso najile gona ni baba, kwende twape finyo cilo cino soni kuti akolelwe, kuti m'mwejo mkagone nawo, kuti tupate ŵanace kupitila mwa baba ŵetu.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.34",
            "verseOrgIds": [
              "GEN.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "GEN 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cilo celeco ŵapele finyo baba ŵawo soni kuti akolelwe. Nipo jwamnondi jula ŵagonile nawo baba ŵawo ŵala. Ndaŵi jelejo soni ni kuti baba ŵawowo ŵaliji ali akolelwe, ni nganayimanyilila yiyatendekwaga. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.35",
            "verseOrgIds": [
              "GEN.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "GEN 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵanace ŵacakongwe ŵanaŵaŵili ŵa Loti ŵakwete yitumbo kupitila mwa baba ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.36",
            "verseOrgIds": [
              "GEN.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "GEN 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwamkulungwa jula ŵaŵelece mwanace jwamlume ni ŵamkolasile lina lyakwe Mowabu. Jwelejo ni nangolo jwa Amowabu wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.37",
            "verseOrgIds": [
              "GEN.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "GEN 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwamnondi jula nombe najo ŵamkolasile lina lyakwe Benami. Jwelejo ni nangolo jwa ŵa Aamoni.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.19.38",
            "verseOrgIds": [
              "GEN.19.38"
            ]
          }
        }
      ]
    }
