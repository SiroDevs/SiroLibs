          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sala jakusile ni jajenele cilambo cosope, Yosefe ni ŵawugwile ngokwe syosope ni ŵasumisyaga ŵandu ŵa ku Iguputo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.56",
            "verseOrgIds": [
              "GEN.41.56"
            ]
          }
        },
        {
