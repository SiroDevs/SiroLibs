                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.54",
            "verseOrgIds": [
              "GEN.41.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "GEN 41:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ndaŵi jijajinjile sala mcilambo cosope ca Iguputo, ŵandu ŵamlililaga Mwenye jwa ku Iguputo kuti ŵape yakulya, Mwenye jwa ku Iguputo ŵasalile ŵandu wosope ŵa ku Iguputowo kuti, “Mjawule kwa Yosefe, yili yose yitakamlamule kutenda, mkayitende yindu yeleyo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.41.55",
            "verseOrgIds": [
              "GEN.41.55"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
