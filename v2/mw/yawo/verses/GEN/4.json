          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.4.22",
            "verseOrgIds": [
              "GEN.4.22"
            ]
          }
        },
