          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Simiyoni ni Lefi ni ŵajanjile kuti, “Pepani baba, ngakomboleka Shekemu kumsyusya mlumbugwetu kuŵa jwalilama.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.34.31",
