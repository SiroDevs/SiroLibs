            "sid": "GEN 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Esawu ŵalumbile ni kuwusumisya ukulungwa wakwe wakutanda kupagwa kwa Yakobo. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.33",
            "verseOrgIds": [
              "GEN.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "GEN 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo Yakobo ŵampele Esawu mkate ni ngunde sila. Ŵalile ni kumwela mesi ni ŵatyosile. Myoyo ŵanyosisye ukulungwa wakwe wandanda kupagwa.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.25.34",
            "verseOrgIds": [
              "GEN.25.34"
            ]
