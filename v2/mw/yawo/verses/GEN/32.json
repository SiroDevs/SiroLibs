      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwe jwajanjile kuti, “Lina lyangu Yakobo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.27",
            "verseOrgIds": [
              "GEN.32.27"
            ]
          }
        }
