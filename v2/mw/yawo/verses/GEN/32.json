              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ni ŵamwusisye mundu jula kuti, “Conde musalile lina lyenu.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
