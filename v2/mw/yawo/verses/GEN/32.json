              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo mundu jula ŵajanjile kuti, “Ligongo cici mkumbusya lina lyangu?” Ndaŵi jijojo mundu jula ŵampele upile Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.29",
            "verseOrgIds": [
              "GEN.32.29"
            ]
