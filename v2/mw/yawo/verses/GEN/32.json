            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "GEN 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ni ŵatite, “Nditu mbonegene najo Mlungu meso ni meso nambo nganimbwa.” Myoyo Yakobo ŵagapele malo gala lina lyakwe Peniele. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.30",
            "verseOrgIds": [
              "GEN.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "GEN 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lyamkopocele Yakobo alimkutyoka ku Penuwele, nipo ŵaliji mkutundajila ligongo lya malo gaŵatiningwice gala. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.31",
            "verseOrgIds": [
              "GEN.32.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe mpaka lelo jino, yisukulu yosope ya Isalaeli yangalya nyama ja pakulumbikanila pa ciga ni ciwunu, ligongo pa mtasi wa gele maloga ni pele Yakobo ŵaputidwe ni mundu jula.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.32.32",
            "verseOrgIds": [
              "GEN.32.32"
            ]
          }
