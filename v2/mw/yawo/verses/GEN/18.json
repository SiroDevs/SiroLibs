            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.19",
            "verseOrgIds": [
              "GEN.18.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "GEN 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵatite, “Ligongo mbili jakusakala ja Sodomu ni Gomola jili jajikulungwa mnope, ni kuti soni ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "text": " wawo uli wejinji, ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.20",
            "verseOrgIds": [
              "GEN.18.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tinjawule kuti ngalole naga yitendo yawo yili mpela mujipikanicile mbili jakusakalajo, naga nganiyiŵa myoyo, tingamanyilile.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "GEN 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.21",
            "verseOrgIds": [
              "GEN.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "GEN 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵane ŵaŵili ŵala ŵatyosile pelepo ni kwinjililaga ku Sodomu, nambo AMBUJE ŵasigele ni Abulahamu. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.22",
            "verseOrgIds": [
              "GEN.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "GEN 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ni ŵaŵandicile kwa AMBUJE ni ŵawusisye kuti, “Ana nditu timwajonanje ŵandu ŵangalemwa pamo ni ŵandu ŵakulemwa? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.23",
            "verseOrgIds": [
              "GEN.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "GEN 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi naga mwana ŵandu 50 ŵangalemwa mu msindamo, ana takawujonanjepe msinda wosopewo? Ana ngawukululucila ligongo lya ŵandu 50 ŵali mu msindawo? ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.24",
            "verseOrgIds": [
              "GEN.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditu ŵalakwe ngakomboleka kwajonanga ŵandu ŵangalemwa, pamo ni ŵandu ŵakulemwa. Yeleyi yangakomboleka soni wawo yeleyo ngatenda. Akatendeje myoyo ni yikaliji kuti ŵandu ŵangalemwa akapocelaga cilango pamo ni ŵandu ŵakulemwa. Kusyene, ŵalakwe ngakomboleka kutenda yindu yamti myoyo. Ana Ŵakulamula ŵa cilambo cosope capasi mpaka aŵe ŵangali cilungamo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "GEN 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.25",
            "verseOrgIds": [
              "GEN.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵajanjile kuti, “Naga ngasimane ŵandu 50 ŵangalemwa mu Sodomu, tingawulece msinda wosopewo ngawujonanga, ligongo lya ŵandu 50 ŵangalemwawo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "GEN 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.26",
            "verseOrgIds": [
              "GEN.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "GEN 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ŵajanjile kuti, “Nginguŵajilwa kuŵeceta ni ŵalakwe AMBUJE une ndili mundu wamba. ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.27",
            "verseOrgIds": [
              "GEN.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi naga ali asimene kuti pa ŵandu 50, apelembele ŵandu msano, ana mpakana akawujonanje msinda wosopewo ligongo lyakupelembela ŵandu msano?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "GEN 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵatite, “Nganjakuwujonanga naga ngasimane ŵandu 45 ŵangalemwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.28",
            "verseOrgIds": [
              "GEN.18.28"
            ]
          }
        }
      ]
    },
