          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ŵatite, “Conde, AMBUJE mkatumbila, timbecete soni kampepe, nambi naga mlimwasimene ŵandu ŵangalemwa likumi?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        }
      ]
