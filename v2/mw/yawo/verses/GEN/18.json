          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ni ŵatite, “Nganjakonanga msindawo naga ndili nasimene ŵandu 20 ŵangalemwa.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.31",
            "verseOrgIds": [
              "GEN.18.31"
            ]
