            "sid": "GEN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulahamu ni ŵatite soni, “Nambi naga muli mwana ŵandu 40 ŵangalemwa mu msindamo?”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "GEN 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ni ŵatite, “Ligongo lya ŵandu 40 ŵangalemwa, nganjakuwujonanga msindawo.”",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.29",
            "verseOrgIds": [
              "GEN.18.29"
            ]
          }
        }
      ]
    },
    {
