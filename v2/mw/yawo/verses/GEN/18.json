          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "GEN 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ŵajanjile kuti, “Naga ngasimane ŵandu ŵangalemwa likumi nginjakonanga msindawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.32",
            "verseOrgIds": [
              "GEN.18.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
