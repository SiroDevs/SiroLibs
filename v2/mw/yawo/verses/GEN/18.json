          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE piŵamasile kuŵeceta ni Abulahamu ŵatyosile. Nipo Abulahamu ŵawujile ku nyumba jawo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.18.33",
            "verseOrgIds": [
              "GEN.18.33"
            ]
          }
        }
