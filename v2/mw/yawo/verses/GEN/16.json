              },
              "items": [
                {
                  "text": "Agal 4:22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.15",
            "verseOrgIds": [
              "GEN.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "GEN 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abulamu ŵaliji ni yaka 86 pandaŵi jelejo.",
          "type": "text",
          "attrs": {
            "verseId": "GEN.16.16",
            "verseOrgIds": [
              "GEN.16.16"
            ]
          }
        }
      ]
