          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwalijose, mu Isalaeli kapena mlendo jwakutama pasikati pawo, jwakulya nyama jakuwa jika kapena nyama jakukamulwa ni cinyama cijakwe, acape yakuwala yakwe, ajoje, nambo taŵepe jwamsakale mpakana ligulo, ni panyuma pakwe taciŵa mundu jwamswejele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.15",
            "verseOrgIds": [
              "LEV.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
