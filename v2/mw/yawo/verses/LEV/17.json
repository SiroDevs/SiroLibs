          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga jwalijose jwa ku Isalaeli, kapena mlendo jwakutama najo, ali kwakusakula akujiwulaga nyama kapena cijuni, cakukundidwa kulya, ajipungulile miasi jakwe pasi, ni kujisilila ni litaka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.13",
            "verseOrgIds": [
