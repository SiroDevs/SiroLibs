          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umi wa cindu cilicose uli miasi, ni ligongo lyakwe AMBUJE alamwile kuti miasi josope ajipungulile pa malo gakupelecela mbopesi, kutyosya ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
          "text": " wa ŵandu. Miasi, jili umi, jikusatyosya ulemwa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.11",
            "verseOrgIds": [
              "LEV.17.11"
            ]
          }
        },
        {
