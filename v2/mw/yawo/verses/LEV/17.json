          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni ligongo lyakwe AMBUJE ŵasalile Aisalaeli kuti, jemanjajo kapena mlendo jwalijose jwakutama najo akalya nyama jilijose jana miasi ciŵela mkati mwakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.12",
            "verseOrgIds": [
              "LEV.17.12"
            ]
          }
        }
