          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuŵa mbopesi ja AMBUJE kumalo gane gali gose, gangaŵa pa mlango wa citenti cakusimanilana, mundu jwelejo amtyosye mwikuga lya ŵandu acimjakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.9",
