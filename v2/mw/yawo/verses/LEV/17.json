              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwalijose jwa ku Isalaeli kapena mlendo jwakutama pasikati pawo, jwakupeleka mbopesi jakutinisya kapena mbopesi ja mtundu wine uliwose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.17.8",
            "verseOrgIds": [
              "LEV.17.8"
            ]
