          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga mundujo ngakucapa yakuwala yakweyo, kapena naga ngakoga cilu cakwe, taciyiwona yipwetesi.",
          "type": "text",
