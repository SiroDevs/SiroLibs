        "sid": "LEV 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbopesi syakupeleka kwa AMBUJE sili syeswela",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "text": " ŵamsalile Mose",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.1",
            "verseOrgIds": [
              "LEV.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti amsalile Aloni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "text": " ni ŵanace ŵakwe ŵacalume kuti, “Mkalisakasya lina lyangu lyeswela, myoyo myicimbicisyeje yindu yakupeleka ŵandu ŵa ku Isalaeli kwa une. Une ndili AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.2",
            "verseOrgIds": [
              "LEV.22.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu jwalijose jwa yisukulu yenu, akuŵandicila yindu yeswela yapelece ŵandu ŵa ku Isalaeli kwa une, ali jwamsakale, akusatumicila soni pa malo gakupelecela mbopesi kwa yaka yosope. Une ndili AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.3",
            "verseOrgIds": [
              "LEV.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cisukulu cilicose ca Aloni cicikwete ulwele wawukulungwa wa pa cilu kapena jwakukopoka uwowu mcilu mwakwe, akalya yakulya yeswela mpaka ali aswejele. Jwakutaga mbopesi jwalijose akuŵa mundu jwamsakale naga akukwaya cindu cakuwa, kapena naga akukopoka mbeju ja ulume wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.4",
            "verseOrgIds": [
              "LEV.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Soni naga akukwaya cinyama cilicose cesakale kapena mundu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.5",
            "verseOrgIds": [
              "LEV.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi jwalijose jwakwayiye cindu cakusakala, akwenela kuŵa jwamsakale mpaka ligulo, soni akalya yakulya yeswela mpaka ali ajosile cilu cakwe cosope. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.6",
            "verseOrgIds": [
              "LEV.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ndaŵi jilikukapila lyuŵa, jwakutaga mbopesijo taŵe jwamswela. Akukomboleka kulya yakulya yeswelayo, pakuŵa yakulya yeleyi yili yawo ŵakutaga mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.7",
            "verseOrgIds": [
              "LEV.22.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akalya nyama jakuwa jika kapena jakukamulwa ni cilombo, ligongo tijimsakasye. Une ndili AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.8",
            "verseOrgIds": [
              "LEV.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi asunje malamusi gangu gimbelece. Naga ngakutenda myoyo taciŵa ŵakulemwa soni taciwa, ligongo nganagapikanila malamusi gangu gamaswela. Une ndili AMBUJE, jwele jungugaswejesya malamusi gangu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.9",
            "verseOrgIds": [
              "LEV.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu jwa mwiŵasa lya ŵakutaga mbopesipe, ni jwakuŵajilwa kulya yakulya yeswelayi, mundu wamba akalya yakulya yeleyi, atamose mundu jwakutama nawo ku nyumba ja jwakutaga mbopesi kapena jwamasengo jwakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.10",
            "verseOrgIds": [
              "LEV.22.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo kapolo jwa jwakutaga mbopesi, jwele jwamsumile ni mbiya syakwe, kapena jwapagwile m'nyumba mwakwe, akukomboleka kulya yakulya yakupocela jwakutaga mbopesijo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.11",
            "verseOrgIds": [
              "LEV.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mwanace jwamkongwe jwa jwakutaga mbopesi akulombedwa ni mundu wamba, ngaŵaga jwakutaga mbopesi, akalya nawo yakupeleka yeswelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.12",
            "verseOrgIds": [
              "LEV.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga mwanace jwamkongwejo akuŵa ali jwamasije kapena ulombela ŵakwe umasile, nambo nganakola mwanace, ni akuwujila kuja kutama ku nyumba ja babagwe. Akukomboleka kulya cakulya ca babagweco, cakupocela mpela jwakutaga mbopesi. Mundu jwa mwiŵasa lya jwakutaga mbopesipe ni jwakuŵajilwa kulya cakulya celeci. Ngaŵa mundu wamba. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.13",
            "verseOrgIds": [
              "LEV.22.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu wamba, jwamkanaŵa jwa mwiŵasa lya jwakutaga mbopesi, akulya yakulya pajika mwangamanyilila, akwenela kuwucisya cakulya calileco, mpela mwalilile kwa jwakutaga mbopesi. Ajonjecesye 20 pelesenti ja yakulya yalileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.14",
            "verseOrgIds": [
              "LEV.22.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi akasakasya mbopesi syeswela sya ŵandu ŵa ku Isalaeli syakusipeleka kwa une AMBUJE, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.15",
            "verseOrgIds": [
              "LEV.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "pakwakunda ŵandu wamba kulya yakulya yeswelayo, ligongo taŵe ŵandu ŵakulemwa soni wakwenela kupocela cilango. Une ndili AMBUJE, junguyiswejesya yakupelekayi.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.16",
            "verseOrgIds": [
              "LEV.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵalamwile Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.17",
            "verseOrgIds": [
              "LEV.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti akampe Aloni ni ŵanace ŵakwe ŵacalume, ni ŵandu wosope ŵa ku Isalaeli, malamusi aga. “Pandaŵi jakuti jwalijose jwa ku Isalaeli kapena mundu jwa cilendo jwakutama mcilambo ca Isalaeli akupeleka mbopesi jakutinisya, naga mbopesijo akujipeleka ligongo lyakusaka kukwanilisya cilanga",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "text": " ciŵaŵisile, kapena akupeleka mwagamba kusaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.18",
            "verseOrgIds": [
              "LEV.22.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 22:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kuti AMBUJE ajipocele jele mbopesiji, akwenela kupeleka ng'ombe, kapena ngondolo, kapena mbusi, nambo siŵeje sya mkambako syangalemala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.19",
            "verseOrgIds": [
              "LEV.22.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 22:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mkupeleka nyama jilijose jelemale, AMBUJE ngasajipocela.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.1"
              },
              "items": [
                {
                  "text": "Det 17:1",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.20",
            "verseOrgIds": [
              "LEV.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu akupeleka mbopesi jakwe ja mkamulano kwa AMBUJE, kanga akupeleka mbopesijo ligongo lyakusaka kugumbalicisya cilanga ciŵaŵisile, kanga akupeleka mbopesijo mwagamba kusaka. Naga mbopesijo jili ja ng'ombe, kapena ngondolo, kapena ja mbusi, kuti AMBUJE ajipocele jikwenela kuŵa jangalemala. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.21",
            "verseOrgIds": [
              "LEV.22.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 22:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapeleka kwa AMBUJE nyama jilijose jangalola, jelemale, jekatice ciŵalo, jajikwete yilonda yakukoposya uwowu pa cilu pakwe, jajikwete ulwele wakunyanya, kapena jajikwete yiŵenga pa cilu pakwe. Akapeleka mbopesi ja nyama ja mtundu welewo, kwa AMBUJE pa malo gakupelecela mbopesi, kuti jiŵe mbopesi ja yakulya. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.22",
            "verseOrgIds": [
              "LEV.22.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 22:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pimkupeleka mbopesi jenu jagamba kupeleka mwakusaka, mkukomboleka kupeleka atamose nyama jajikwete ciŵalo cine cakulekangana ni musikuŵela nyama syosope, nambo naga akupeleka mbopesi jakusaka kugumbalicisya cilanga ciŵaŵisile, nyama ja mtundu welewo AMBUJE ngajipocela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.23",
            "verseOrgIds": [
              "LEV.22.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 22:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapeleka kwa AMBUJE nyama jilijose jajicanyandile, kapena jajikatile mwamele, kapena jajikatice mwangosi yikolelo yakwe. Mkasimjipeleka mbopesi kwa AMBUJE, soni mkatendaga yeleyi mcilambo cenu. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.24",
            "verseOrgIds": [
              "LEV.22.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkapeleka mbopesi ja mkate kwa AMBUJE, ja nyama sya mtundu welewo, simpatile kwa ŵandu ŵa cilendo. AMBUJE ngasapocela mbopesisyo ligongo nyamasyo syelemale.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 22:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.25",
            "verseOrgIds": [
              "LEV.22.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 22:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndaŵi jakupagwa mwanace jwa ng'ombe kapena jwangondolo kapena jwa mbusi, mwanacejo akasamtyosya kwa mamagwe kwa masiku msano ni gaŵili. Nambo kutandila lisiku lya msano ni gatatu kuja msogolo mwakwe, jikomboleka kujitaga mbopesi ja yakulya kwa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.26+LEV.22.27",
            "verseOrgIds": [
              "LEV.22.26",
              "LEV.22.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 22:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkawulaga kupeleka mbopesi ng'ombe jamkolo ni mwanace jwakwe, ngondolo jamkolo ni mwanace jwakwe, kapena mbusi jamkolo ni mwanace jwakwe lisiku limo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.28",
            "verseOrgIds": [
              "LEV.22.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 22:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jimkutaga mbopesi jakwatogolela AMBUJE, mtaje mbopesijo pakukuya malamusi gakwe, kuti m'mwejo ampocele. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.29",
            "verseOrgIds": [
              "LEV.22.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlyeje lisiku lilyolyo, soni mkasalasya jine mpaka kundaŵi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 22:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.30",
            "verseOrgIds": [
              "LEV.22.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 22:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Myoyo mgapikanileje malamusi gangu ni kugakuya. Une ndili AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.31",
            "verseOrgIds": [
              "LEV.22.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkalisakasya lina lyangu lyeswela, nambo liŵe lina lyakucimbicikwa pasikati pa ŵandu ŵa ku Isalaeli. Une ndili AMBUJE, jungumswejesya jemanja, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.32",
            "verseOrgIds": [
              "LEV.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une ndili AMBUJE, junamkopwesye jemanja ku cilambo ca Iguputo, kuti m'mbe Mlungu jwenu.”",
          "type": "text",
          "attrs": {
            "verseId": "LEV.22.33",
            "verseOrgIds": [
              "LEV.22.33"
            ]
          }
        }
