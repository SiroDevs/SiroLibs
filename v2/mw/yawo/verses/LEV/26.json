              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "text": " ŵasasile kuti, “Mkasimlipanganyicisya yakusepa kapena kwimika yitusitusi yakusepa, kapena kwimika yipilala ya maganga ni kuyilambila. Une ndili AMBUJE Mlungu jwenu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.1",
            "verseOrgIds": [
              "LEV.26.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
