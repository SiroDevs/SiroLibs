          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelega ni malamusi gele AMBUJE ŵagaŵisile pa cilikati pa AMBUJE asyene ni ŵandu ŵa ku Isalaeli, kupitila mwa Mose",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        },
        {
          "text": " Petumbi lya Sinayi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.26.46",
            "verseOrgIds": [
              "LEV.26.46"
            ]
          }
        }
