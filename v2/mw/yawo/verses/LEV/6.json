            }
          ]
        },
        {
          "text": "AMBUJE ŵamlamwile Mose kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.24",
            "verseOrgIds": [
              "LEV.6.24"
            ]
