                "loc": "NUM.5.5+NUM.5.6+NUM.5.7+NUM.5.8"
              },
              "items": [
                {
                  "text": "Num 5:5-8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.1",
            "verseOrgIds": [
              "LEV.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu akwalemwecesya AMBUJE pakutenda yindu mwangakulupicika, ligongo lyakumnyenga mjakwe pakukana kumwucisya mjakwejo yindu yiŵamsunjisye, kapena kukana kuwusya cindu cawiyi, kapena cindu cakusumula mwamacili, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.2",
            "verseOrgIds": [
              "LEV.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kapena kulambusya kuti nganalokota yindu yayijasice, kapena kulumbila",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "text": " mwa unami pa yindu yele mundu jwalijose akukomboleka kulemwa nayo, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.3",
            "verseOrgIds": [
              "LEV.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "naga mundu akulemwa mu yindu yeleyi atesile ulemwa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4+LEV.6.5",
            "verseOrgIds": [
              "LEV.6.4",
              "LEV.6.5"
            ]
          }
        },
        {
          "text": " awusye yindu yiŵasumwile mwamacili yila, yindu yiŵajiŵile, yindu yiŵampele kusunga yila, cindu cakwasika ciŵalokwete cila, kapena kandu kiŵalumbile mwa unami. Akwenela kuwusya yindu yosopeyo ni konjecesya mbali jimo ja mbuwa msano pa mtengo wa cindu cilicose, ni tayipelece kwa msyene pa lisiku litacipeleka mbopesi jakwaŵenda AMBUJE kuti amkululucile ulemwa wakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.4+LEV.6.5",
            "verseOrgIds": [
              "LEV.6.4",
              "LEV.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayice kwa jwakutaga mbopesi, ni mbopesi jakupeleka kwa AMBUJE, jakwaŵenda kululucila ulemwa. Jikwenela kuŵa ngondolo jamkambako jangalemala, mtengo wakwe wa ngondolojo uŵe wa mbiya sya silifa,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "text": " pakuya mtengo wa nyama wakuŵalanjila ku Nyumba ja AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.6",
            "verseOrgIds": [
              "LEV.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ni jwakutaga mbopesi atende msyungu wakwaŵenda AMBUJE kumkululucila ulemwa mundujo, ulemwa wosope uŵatesile mundujo tacimkululucila AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbopesi sya nyama syakutinisya kwa mtundu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.7",
            "verseOrgIds": [
              "LEV.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamlamwile Mose kuti ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.8",
            "verseOrgIds": [
              "LEV.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵasalile Aloni",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "text": " pampepe ni ŵanace ŵakwe lilamusi lyakupelecela mbopesi syakutinisya. Mjiŵiceje nyama ja mbopesijo pa moto, pa malo gakupelecela mbopesi cilo camtundu mpaka kundaŵi, soni moto wa pa malo gakupelecela mbopesijo uŵe uli mkukolela. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.9",
            "verseOrgIds": [
              "LEV.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi awale mkanjo ni kabudula jwa nguwo ja bafuta, ni akokole liwu lya nyama jakutinisya jila, lili pa malo gakupelecela mbopesi, ni kulikusulila mungulugulu mwa malo gakupelecela mbopesipego. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.10",
            "verseOrgIds": [
              "LEV.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awule yakuwala yakwe, ni kuwala yakuwala ya ndaŵi syosope, ni alityosye liwu lyaliwunjice lila, ni kuja kuliŵika pa malo gamaswela kusa kwa masakasago. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.11",
            "verseOrgIds": [
              "LEV.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto uli pa malo gakupelecela mbopesi uŵe cikolelele, ukasima. Jwakutaga mbopesi aŵeje ali mkwisila motowo ni sasu kundaŵi kulikose, ni aŵiceje mbopesi jakutinisya pa malo gakupelecela mbopesigo, ni kutinisya soni mawuta ga mbopesi ja mkamulano.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.12",
            "verseOrgIds": [
              "LEV.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Moto uŵeje wakolela ndaŵi josope, ukasima, pa malo gakupelecela mbopesijo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbopesi sya utandi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.13",
            "verseOrgIds": [
              "LEV.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lilamusi lya mbopesi sya yakulya ni ali. Jumo jwa ŵakutaga mbopesi jwa ŵanace ŵa Aloni, tacijipeleka mbopesi ja yakulya kwa AMBUJE, pasogolo pa malo gakupelecela mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.14",
            "verseOrgIds": [
              "LEV.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo tacisapula ligasa limo lya utandi ŵambopesiwo pamo ni mawuta, ni ubani",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "text": " wosope uli pacanya pambopesi ja yakulya. Ayijoce pa moto pa malo gakupelecela mbopesi, kulosya kuti mbopesi josopejo jili jawo AMBUJE. Liwungo lya mbopesi jeleji lili lyakwanonyelesya AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.15",
            "verseOrgIds": [
              "LEV.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakutaga mbopesi alye yakulya yakusigalayo yili yangawanganya ni cakusasaŵilisya, alye yeleyi ali pa malo gamaswela, mluŵala lwa citenti cakusimanilana. AMBUJE ayipelece yakusigala kwa ŵakutaga mbopesi kuti yiŵe mbuwa jawo ja mbopesi ja yakulyayo. Yosopeyo yili yayiswela mnope mpela musikuŵela mbopesi sine sila sya kwaŵenda AMBUJE kululucila ulemwa ni mbopesi sya magambo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.16+LEV.6.17",
            "verseOrgIds": [
              "LEV.6.16",
              "LEV.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace wosope ŵacalume ŵa Aloni alyeje mbopesi syakutinisya syakupeleka kwa AMBUJE, lyeleli ni lilamusi lya yaka yosope, lyakwalamula ŵanace ŵenu ŵa msogolo, lyakwamanyisya yiŵalo yakuŵajilwa ndaŵi syosope kulya ya pa mbopesi syosope syakoca pa moto. Jwalijose jwakuyikwaya yindu yeleyi, jwangaŵa jwa mwiŵasa lya Aloni, taciyiwona yipwetesi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.18",
            "verseOrgIds": [
              "LEV.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamsalile Mose kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.19",
            "verseOrgIds": [
              "LEV.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mbopesi jakuŵajilwa kupeleka Aloni ni ŵanace ŵakwe ŵacalume kwa AMBUJE, pa lisiku lyakumŵika kuŵa jwakutaga mbopesi, pa kumpungulila mawuta pa mtwe pakwe, jiŵeje ja mtundu awu: Apelece mbopesi kwa AMBUJE ja utandi wambone wakwanila kilogalamu jimo, mpela mwakusapelecela mbopesi ja utandi ja masiku gosope, apelece litika kundaŵi ni litika line ligulo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.20",
            "verseOrgIds": [
              "LEV.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Awuwanganye utandiwo ni mawuta ni kuteleka mikate pa ciwaya. Ajitemanyetemanye mikatejo mpela mwakusatendela ni mbopesi sya utandi. Ayijoce pa moto kuti yikoposye liwungo lyambone lyakwanonyelesya AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.21",
            "verseOrgIds": [
              "LEV.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo jwakutaga mbopesi jwa mtundu wa Aloni, jwele jwa mpungulile mawuta pa mtwe pakwe kuŵa jakutaga mbopesi, jwakwinjila m'malo mwa Aloni, ajipeleceje mbopesi ja mtundu welewu kwa AMBUJE ndaŵi syosope mpela mwa lilamusi lya yaka yosope, ajitinisye mbopesi josopejo. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.22",
            "verseOrgIds": [
              "LEV.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbopesi jilijose ja utandi, jakupeleka jwakutaga mbopesi, ajitinisye josope jene, akalya iyayi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.6.23",
            "verseOrgIds": [
              "LEV.6.23"
            ]
          }
        }
      ]
    },
