          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.26+LEV.23.27+LEV.23.28+LEV.23.29+LEV.23.30+LEV.23.31+LEV.23.32"
              },
              "items": [
                {
                  "text": "Lef 23:26-32",
