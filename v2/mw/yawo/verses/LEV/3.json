          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwakutaga mbopesi ayijoce yosopeyi pa malo gakupelecela mbopesi, kuti ciŵe cakulya cakoca pa moto, ca liwungo lyambone. Mawuta gosope gali ga AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.3.16",
            "verseOrgIds": [
              "LEV.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
