        "style": "s1"
      },
      "items": [
        {
          "text": "Mbopesi syakuŵenda kululucila ulemwa wangatenda mwa mele",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
