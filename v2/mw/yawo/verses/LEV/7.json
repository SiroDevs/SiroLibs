          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelega ni malamusi ga mbopesi syakutinisya, sya utandi, syakwaŵenda AMBUJE kululucila ulemwa, sya magambo, syakupakasya mawuta, soni ni mbopesi sya mkamulano. ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.37",
            "verseOrgIds": [
              "LEV.7.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 7:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malamusi gelega ni giŵapelece AMBUJE kwa Mose Petumbi lya Sinayi lila, pa lisiku lyele AMBUJE liŵalamwile Aisalaeli kuti ayice ni mbopesi syawo kwa AMBUJEWO, ku cipululu ca Sinayi kula.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.7.38",
            "verseOrgIds": [
              "LEV.7.38"
            ]
          }
        }
      ]
