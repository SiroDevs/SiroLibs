        },
        {
          "text": "Sambano Yobu ŵajanjile AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.1",
            "verseOrgIds": [
              "JOB.42.1"
            ]
          }
        }
