          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Yobu ŵatemi cijumi yaka 140, mwakuti pa ndaŵi jelejo ŵayiweni yisukulu yakwe ni yisukulu ya m'mawuja yakwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.42.16",
            "verseOrgIds": [
              "JOB.42.16"
            ]
          }
        }
      ]
    },
