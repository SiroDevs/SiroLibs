          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.17",
            "verseOrgIds": [
              "JOB.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo mkinamalisye kuŵeceta, jwayice jwakutumicila jwine jwa mcece ni jwatite kuti, “Ŵanace ŵenu wosope ŵaliji mkutenda cindimba m'nyumba ja mkulugwawo, ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.1.18",
            "verseOrgIds": [
              "JOB.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 1:19"
          },
          "items": [
