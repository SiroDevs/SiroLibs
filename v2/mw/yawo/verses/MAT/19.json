      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵamsalile kuti, “Naga mkusaka kuŵa jwambone jwam'malilwe kusyesyene, mjawule mkasumisye yindu yosope yimkwete, nipo mbiya syakwe mkasipelece kwa ŵandu ŵakulaga, nipo cipanje timkacisimane kwinani, ni myice munguyeje.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.21",
            "verseOrgIds": [
              "MAT.19.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
