          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcanda jula ŵatite, “Malamusi gosopega mbele ndili mkugakuya, nambi cicisigalile soni ni cici?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.20",
            "verseOrgIds": [
              "MAT.19.20"
            ]
          }
        }
      ]
