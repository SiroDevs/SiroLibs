            "number": "23",
            "style": "v",
            "sid": "MAT 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵasalile ŵakulijiganya ŵakwe kuti, “Nditu ngumsalicisya kuti cili cindu cakusawusya kuti mundu jwakusicila akajinjile mu Ucimwene wa kwinani. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.23",
            "verseOrgIds": [
              "MAT.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo ngumsalicisya soni kuti, cili cindu cakusawusya kuti mundu jwakusicila akajinjile mu Ucimwene wa Mlungu",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        },
        {
          "text": " kulekangana ni kuti ngamila",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        },
        {
          "text": " jijinjile pebowo lya singano.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.24",
            "verseOrgIds": [
              "MAT.19.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
