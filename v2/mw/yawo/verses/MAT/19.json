          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakulijiganya ŵala piŵapikene yeleyi, ŵasimonjile mnope ni ŵawusisye kuti, “Nambi ŵani ŵitakakulupuce?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.25",
            "verseOrgIds": [
              "MAT.19.25"
            ]
          }
        }
      ]
    },
