            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵalolecesye jemanjajo ni ŵasalile kuti, “Yeleyi yili yangakomboleka ni ŵandu, nambo ni Mlungu yindu yosope yili yakomboleka.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.26",
            "verseOrgIds": [
              "MAT.19.26"
            ]
          }
        }
      ]
    },
