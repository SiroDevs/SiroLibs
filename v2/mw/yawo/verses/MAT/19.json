          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo jwalijose jwalesile mangwakwe, acalongo acimjakwe, kapena babagwe, kapena mamagwe, kapena ŵanace ŵakwe, kapena migunda ligongo lya une, jwalakwejo tacikola yosopeyo yejinji kupunda yiŵalesile kala yila, kaneko tacipocela umi wangamala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.29",
            "verseOrgIds": [
              "MAT.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵajinji ŵali ŵandanda sambano jino taciŵa ŵakumbesi, nipo ŵali ŵakumbesi sambano jino taciŵa ŵandanda.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.30",
            "verseOrgIds": [
              "MAT.19.30"
            ]
          }
        },
