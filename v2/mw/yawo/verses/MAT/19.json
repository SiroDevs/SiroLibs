          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Petulo",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        },
        {
          "text": " ŵajanjile kuti, “Alole, uwetu twalesile yosope ni kwakuya ŵalakwe. Ana sambano nikuti tucipocela cici?”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.27",
            "verseOrgIds": [
              "MAT.19.27"
            ]
          }
        }
      ]
