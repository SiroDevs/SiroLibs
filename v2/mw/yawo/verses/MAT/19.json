          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jula pijwapikene gele maloŵega, jwatengwice ni jwagambile kutyokapo yili yimpwetece mu mtima, ligongo jwaliji jwakusicila mnope.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.19.22",
            "verseOrgIds": [
              "MAT.19.22"
            ]
          }
        }
      ]
    },
