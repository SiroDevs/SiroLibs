                {
                  "text": "Mat 9:35",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.1.39"
              },
              "items": [
                {
                  "text": "Mak 1:39",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbili jakwe jajenele mcilambo cosope ca Siliya, mwakuti ŵandu ŵayikaga nawo kwa jwalakwe, ŵakulwala wosope ŵiŵaliji mkulaga ni yilwele ni yakupweteka yakulekanganalekangana, ŵandu ŵakamulwa ni misimu jakusakala,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "text": " ŵamjilinjili ni ŵalemale, jwalakwe ŵaposyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵajinji ŵamkuyaga kutyocela ku Galileya, ku dela jakolanjidwa Misinda Likumi,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        },
        {
          "text": " ku Yelusalemu, ku Yudeya ni pesi pa Lusulo lwa Yolodani.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        }
      ]
