                  "text": "Mat 3:2",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ŵaŵilasile ŵandu mcece ŵakuwulaga somba",
          "type": "text"
        }
      ]
    },
