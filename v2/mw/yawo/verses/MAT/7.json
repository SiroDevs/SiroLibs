                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya ŵandu ŵaŵili ŵakutaŵa majumba",
          "type": "text"
        }
      ]
    },
    {
