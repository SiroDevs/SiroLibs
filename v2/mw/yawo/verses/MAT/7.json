              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo tinjasalila mwangasisa kuti, ‘Ngingum'manyilila kose. Mtyoce apa ŵandu ŵa yitendo yakusakala.’",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.23",
            "verseOrgIds": [
              "MAT.7.23"
            ]
          }
        },
        {
