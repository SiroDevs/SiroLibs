              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu jwalijose jwakugapikana maloŵe ganguga ni kugakamulisya masengo, akulandana ni mundu jwalunda juŵataŵile nyumba jakwe pa lwala. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.24",
            "verseOrgIds": [
              "MAT.7.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pijaputile ula, cikumba cayice, nipo mbungo japujile ni kugomba pa nyumbajo, nambo nganijigwa kose, ligongo nyumbajo jataŵidwe pa lwala.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.7.25",
            "verseOrgIds": [
              "MAT.7.25"
            ]
          }
        }
