          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo Yesu ŵasalile ŵakulijiganya ŵakwe kuti, “Mundu jwakusaka kunguya une, akuŵajilwa kuliliŵalila msyene, nipo atwicile msalaba wakwe ni kunguya.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.24",
            "verseOrgIds": [
              "MAT.16.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
