              "MAT.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nditu ngumsalicisya jemanja kuti apali ŵandu ŵane panopano ŵele ngasawa mkinamwone Mwanace jwa Mundu ali mkwisa mu lumbili lwa ucimwene.”",
          "type": "text",
          "attrs": {
            "verseId": "MAT.16.28",
            "verseOrgIds": [
              "MAT.16.28"
            ]
