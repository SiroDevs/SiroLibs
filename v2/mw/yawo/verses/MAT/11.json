            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ngumsalicisya kuti pa lisiku lyakulamula, Mlungu tacitendela Taya ni Sidoni canasa kumpunda jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.22",
            "verseOrgIds": [
