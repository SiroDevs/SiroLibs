          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nipo m'mwe Kapelenaumu, ana mkuganisya kuti tacimkwesya mpaka kwinani? Iyayi, tacimponyela ku malo ga ŵandu ŵawe.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "text": " Ligongo yindu yamacili yiyatendekwe mwa m'mwejo, yikaŵe kuti yatendecele mu Sodomu, msindawo ukaliji ciŵela mpaka lelo jino.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.23",
            "verseOrgIds": [
              "MAT.11.23"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
