          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elo, Atati, pakuti amu ni muŵasacile ŵalakwe kuti yitendekwele.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.26",
            "verseOrgIds": [
              "MAT.11.26"
            ]
          }
        }
      ]
