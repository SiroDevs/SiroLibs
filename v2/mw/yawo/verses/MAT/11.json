          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Myice kwangune, jemanja wosope ŵakupela ni ŵakusitopelwa, nipo tinampumusye. ",
          "type": "text",
          "attrs": {
            "verseId": "MAT.11.28",
            "verseOrgIds": [
              "MAT.11.28"
            ]
          }
