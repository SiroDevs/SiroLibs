        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jwamlume jwalijose jwakwaleka ŵamkwakwe ni kuja kulombela ŵakongwe ŵane, jwalakwejo atesile cikululu. Soni jwamlume jutalombele ŵakongwewo, nombe najo akutenda cikululu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.16.18",
            "verseOrgIds": [
              "LUK.16.18"
            ]
          }
        },
