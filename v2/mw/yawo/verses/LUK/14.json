{
  "id": "LUK.14",
  "number": "14",
  "bookId": "LUK",
  "reference": "Luk 14",
  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LUK 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu akumposya mundu jwakulwala",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku line lyakupumula lya Ayuda, Yesu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "text": " ŵajile kukulya ku nyumba ja jumo jwa acakulungwa ŵa Afalisi",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "text": " nipo Afalisi ni ŵandu ŵane ŵaliji kumlolecesya jwalakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.1",
            "verseOrgIds": [
              "LUK.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Papopo, pasogolo pa Yesu ŵapali mundu juŵalwalaga ndaka. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.2",
            "verseOrgIds": [
              "LUK.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Yesu ŵawusisye aciŵalimu ŵa Malamusi",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "text": " ni Afalisi kuti, “Ana Malamusi gakusakunda kumposya mundu pa lisiku lyakupumula,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "text": " kapena iyayi?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.3",
            "verseOrgIds": [
              "LUK.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jemanjajo nganajanga kandu kalikose. Myoyo Yesu ŵamjigele mundu jwakulwalajo ni kumposya ni ŵamsalile kuti ajawuleje. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.4",
            "verseOrgIds": [
              "LUK.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵawusisye soni kuti, “Ana nduni mwa jemanja jwakwete mwanace, kapena ng'ombe ni jikugwila mcisima pa lisiku lyakupumula, ana ngamyicuwula ligongo lyakuti lili lisiku lyakupumula?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.12.11"
              },
              "items": [
                {
                  "text": "Mat 12:11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.5",
            "verseOrgIds": [
              "LUK.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵalepele kwanga ciwusyoci.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ya kulinondiya ni yakwapocela acalendo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.6",
            "verseOrgIds": [
              "LUK.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu piŵaweni kuti ŵandu ŵiŵaŵilanjidwe kukulya nawo ŵala ŵalisagulilaga malo ga ucimbicimbi, jwalakwejo ŵasalile citagu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "text": " aci cakuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.7",
            "verseOrgIds": [
              "LUK.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mundu jwine naga akumŵilanga jemanja ku cindimba ca ulombela, mkaja kutama pa malo ga ucimbicimbi, ligongo lyakuti mwine mwakwe ŵamŵilasile soni mundu jwine jwakucimbicika kupunda m'mwejo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PRO.25.6+PRO.25.7"
              },
              "items": [
                {
                  "text": "Mis 25:6-7",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.8",
            "verseOrgIds": [
              "LUK.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mundu juŵamŵilasile jemanja ŵana ŵaŵili jula akusayika ni kumsalila m'mwejo kuti, ‘Maloga mwape aŵa.’ Pelepo m'mwejo timtende soni pa ndaŵi jitimtyoceje pelepo kuja kukutama pa malo gangali ucimbicimbi gala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.9",
            "verseOrgIds": [
              "LUK.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga amŵilasile, mkatame pa malo gangali ucimbicimbi gala, mpaka mundu jwakuŵilasile jula atende kwika ni kukusalila kuti, ‘Mjangu, yikani mtame pa malo gakucimbicikwaga.’ Yeleyi tiyicimpa ucimbicimbi pameso pa ŵandu wosope, myoyo jemanjajo tacimwona m'mwejo kuti mli ŵakucimbicikwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.10",
            "verseOrgIds": [
              "LUK.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jwakulikwesya tacimtulusya, nipo jwakulitulusya tacimkwesya.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.11",
            "verseOrgIds": [
              "LUK.14.11"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.23.12"
              },
              "items": [
                {
                  "text": "Mat 23:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.18.14"
              },
              "items": [
                {
                  "text": "Luk 18:14",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.11",
            "verseOrgIds": [
              "LUK.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Yesu ŵaŵecete ni Mfalisi",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "text": " juŵamŵilasile jwalakwejo kuti, “Pandaŵi jimkukolosya cindimba ca yakulya ya ndaŵi ja musi kapena ca ndaŵi ja ligulo, mkasimwaŵilangaga acimjenupe, kapena acalongo acimjenupe, ŵa mwiŵasa mwenupe kapena acanasi ŵenu ŵakusicila. Naga mkutenda yeleyo, nombe nawo jemanjajo tacimŵilanga m'mwejo, kumwucisya yindu yimwatendele m'mwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.12",
            "verseOrgIds": [
              "LUK.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo m'mwejo pakukolosya cindimba, mwaŵilanjeje ŵandu ŵakulaga, ŵalemale ni ŵangalola. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.13",
            "verseOrgIds": [
              "LUK.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo nikuti timcikola upile, ligongo lyakuti jemanjajo ŵangali kandu kalikose kakuti amwucisye m'mwejo. Mlungu ni jutacimwucisya m'mwejo, pa ndaŵi jitacijimuka ŵandu ŵakulungama kutyocela ku malembe.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Citagu ca cindimba cekulungwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.14",
            "verseOrgIds": [
              "LUK.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mundu jwine juŵalyaga nawo yakulya, piŵapikene yeleyi ŵamsalile Yesu kuti, “Akwete upile mundu jutacilya nawo mu Ucimwene wa Mlungu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.15",
            "verseOrgIds": [
              "LUK.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Yesu ŵamsalile jwalakwejo kuti, “Mundu jwine ŵakolosisye cindimba ca yakulya nipo ŵaŵilasile ŵandu ŵajinji. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.16",
            "verseOrgIds": [
              "LUK.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pijakwanile ndaŵi jakuti ŵandu alye yakulya, jwalakwejo ŵamtumile jwamasengo jwakwe kuti akasalile ŵandu ŵiŵaŵilanjidwe ku cindimba cila kuti, ‘Ayice pakuti yosope yaliji tayale!’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.17",
            "verseOrgIds": [
              "LUK.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa ŵandu wosope ŵiŵaŵilanjidwe ŵala, jumo jumo jwatandite kupeleka magongo gakuti ngayika ku cindimbako. Jwandanda jwatite, ‘Sumile mgunda ni ngwenela kuti njawule ngawulole, pepani ngayika.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.18",
            "verseOrgIds": [
              "LUK.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwine jwatite, ‘Une sumile ng'ombe syakulima likumi ni ngusosa kuti ngasilinje, pepani ngayika.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.19",
            "verseOrgIds": [
              "LUK.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwine jwatite, ‘Une lombele jwamkongwe sampano, myoyo nganipakombola kwika kweleko.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.20",
            "verseOrgIds": [
              "LUK.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamasengo jula piŵawusile kweleko, ŵasalile ambujegwe ŵala yiyatendecekwe yila. Myoyo msyene nyumba jula ŵapile mtima ni ŵamsalile jwamasengo jula kuti, ‘Mjawule mwacitema m'matala ni m'misewu ja mu msinda ni mkaŵilanje ŵandu ŵakulaga, ŵalemale kapena ŵangalola ni myice nawo akuno.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.21",
            "verseOrgIds": [
              "LUK.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamasengo jula piŵawusile, jwatite kuti, ‘Ambuje ŵangu, ndesile yimwandamwile yila, nambo malo gaciŵela.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.22",
            "verseOrgIds": [
              "LUK.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko mbujegwe jula ŵamsalile jwamasengo jula kuti, ‘Mjawule ku misewo ni m'matala gakusa kwa ndenje, ni mkaŵilanje ŵandu ayice akuno kuti nyumba jangu jigumbale. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.23",
            "verseOrgIds": [
              "LUK.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumsalila yakuwona kuti, mwa ŵandu ŵiŵakanile pandanda ŵala pangali ni jumo jose jutapasye yakulya yangu.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.24",
            "verseOrgIds": [
              "LUK.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kuŵa jwakulijiganya jwa Yesu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.24",
            "verseOrgIds": [
              "LUK.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Likuga lyejinji lya ŵandu lyaliji mkwenda pamo ni Yesu, kaneko jwalakwejo jwagalawucile jemanjajo ni kwasalila kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.25",
            "verseOrgIds": [
              "LUK.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naga jwalijose akusaka kuŵa jwakulijiganya jwangu, akwenela kunonyela une kwapunda babagwe ni mamagwe, ŵamkwakwe ni ŵanace ŵakwe, acakulugwe ni acalumbugwe, soni kuwupunda atamose umi wakwe.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.37"
              },
              "items": [
                {
                  "text": "Mat 10:37",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.26",
            "verseOrgIds": [
              "LUK.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalijose jwangakutwicila msalaba wakwe ni kunguya une, ngaŵa mkukomboleka kuŵa jwakulijiganya jwangu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.14.27",
            "verseOrgIds": [
              "LUK.14.27"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.10.38"
              },
              "items": [
                {
                  "text": "Mat 10:38",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.16.24"
              },
              "items": [
                {
                  "text": "16:24",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
