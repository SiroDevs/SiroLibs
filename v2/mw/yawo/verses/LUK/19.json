          "text": "19",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ni Sakeyo",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 19:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.1",
            "verseOrgIds": [
              "LUK.19.1"
            ]
          }
        },
        {
          "text": " ŵajinjile mu msinda wa Yeliko pa ulendo wakwe uŵapelenganyaga kwawula ku Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.1",
            "verseOrgIds": [
              "LUK.19.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 19:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kweleko kwaliji kwana mundu jwamkulungwa jwa ŵakomesya msongo lina lyakwe Sakeyo soni ŵaliji ŵakusicila. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.2",
            "verseOrgIds": [
              "LUK.19.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 19:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju jwasakaga kuti amlole Yesu kuti ana ali mundu jwamti uli. Nambo ligongo lya msingu wakwe wejipi Sakeyojo ŵalepele kumwona Yesu ligongo lya winji wa ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.3",
            "verseOrgIds": [
              "LUK.19.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo jwalakwejo jwawutucile pasogolo ni jwakwesile mcitela ca mkuju kuti amwone Yesu pakuti jwalakwejo ŵaliji mkupita mwitala lilyolyo.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.4",
            "verseOrgIds": [
              "LUK.19.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 19:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.4",
            "verseOrgIds": [
              "LUK.19.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu piŵayice pa gele malogo ŵalolite mwinani ni ŵamsalile jwalakwejo kuti, “Sakeyo, tulukani mwacitema, pakuti lelo ngwenela kutama namwe ku nyumba jenu.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 19:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.5",
            "verseOrgIds": [
              "LUK.19.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 19:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sakeyo ŵatulwice mwacitema, kaneko ŵampocele Yesu mwalukondwa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.6",
            "verseOrgIds": [
              "LUK.19.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu piŵayiweni yeleyi ŵatandite kunyinyita kuti, “Munduju apite mpela mlendo ku nyumba ja mundu jwakulemwa.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 19:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.7",
            "verseOrgIds": [
              "LUK.19.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo Sakeyo ŵajimi ni ŵamsalile Yesu kuti, “Ambuje, tinjipeleka hafu ja yipanje yangu kwa ŵandu ŵakulaga. Naga najigele kandu kalikose kwa mundu mwakulambusya tinjimwucisya jwalakwejo kacece.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 19:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.8",
            "verseOrgIds": [
              "LUK.19.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 19:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ŵamsalile jwalakwejo kuti, “Lelo, cikulupusyo ciyice pa liŵasa alino, pakuti nombe najo ali mwanace jwa Abulahamu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.9",
            "verseOrgIds": [
              "LUK.19.9"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.9",
            "verseOrgIds": [
              "LUK.19.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwa Mundu",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        },
        {
          "text": " ayice kukusosasosa ni kukulupusya ŵandu ŵaŵasokonecele.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.11"
              },
              "items": [
                {
                  "text": "Mat 18:11",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Citagu ca mbiya likumi sya golidi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 19:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.10",
            "verseOrgIds": [
              "LUK.19.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 19:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu piŵaliji kumpikanila Yesu, jwalakwejo ŵapitilisye kuŵeceta ni kwasalila ŵanduwo citagu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "text": " ligongo ŵaliji ciŵandika ni msinda wa Yelusalemu, nipo ŵanduwo ŵaliji mkuganisya kuti Mlungu tawutamilisye Ucimwene wakwe mwangakaŵa. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.11",
            "verseOrgIds": [
              "LUK.19.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 19:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo jwatite, “Jwapali mundu jwine juŵaliji nduna nipo ŵapite ku cilambo cakwakutalika kuti akamjinjisye ucimwene nipo panyuma pakwe awujile kumusi. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.12",
            "verseOrgIds": [
              "LUK.19.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 19:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo jwaŵilasile ŵamasengo ŵakwe likumi nipo ŵampele mbiya likumi jwalijose jakwejakwe ni ŵasalile kuti, ‘Mkamulisye masengo mbiyasi pakutendela malonda kuti mpate mbiya sine syakonjecesya penani pa syelesi mpaka pitinjiwuja une.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.13",
            "verseOrgIds": [
              "LUK.19.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵa mcilambo mwakwemo ŵaŵenganaga najo, nipo ŵatumisye mitenga kukusala kuti, ‘Uwe ngatukusaka kuti mundu jweleju aŵe mwenye jwetu.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 19:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.14",
            "verseOrgIds": [
              "LUK.19.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 19:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Atamose kuti yaliji myoyo, jwalakwejo ŵamŵecicepe ucimwene ni ŵawujile kwawula kumangwakwe. Piŵayice kumangwakwe kula, ŵaŵilasile ŵamasengo ŵiŵapele mbiya ŵala ni cakulinga cakuti jwalakwejo amanyilile muŵapatile ŵamasengo ŵakwe ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.15",
            "verseOrgIds": [
              "LUK.19.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 19:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwandanda jwayice ni jwatite kuti, ‘Ambuje ŵangu, mbiya jimwambele jila mbindwile najo mbiya sine likumi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.16",
            "verseOrgIds": [
              "LUK.19.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 19:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbujegwe jula ŵamsalile kuti, ‘Mtesile cenene jwamasengo jwambone. Ligongo lyakuti mkulupicice pa yindu yamnono, sambano timŵe ŵakulamulila misinda likumi.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.17",
            "verseOrgIds": [
              "LUK.19.17"
            ]
          }
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.17",
            "verseOrgIds": [
              "LUK.19.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 19:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamasengo jwaŵili jwayice ni jwatite kuti, ‘Ambuje ŵangu, mbiya jimwambele jila mbindwile nasyo mbiya sine msano.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.18",
            "verseOrgIds": [
              "LUK.19.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbujegwe jula ŵamsalile kuti, ‘M'mwejo timciŵa jwakulamulila misinda msano.’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 19:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.19",
            "verseOrgIds": [
              "LUK.19.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 19:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jwamasengo jwine jwayice ni jwatite kuti, ‘Mbuje ŵangu, mbiya jenu jila aji, nagambile kujitaŵa pa mpango. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.20",
            "verseOrgIds": [
              "LUK.19.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 19:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naliji mkogopa ligongo m'mwejo mli mundu jwakusawusya, mkusajigala yele nganiyiŵa yenu, soni mkusagowola mbeju syele mkupanda jwakwe ngaŵa m'mwejo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.21",
            "verseOrgIds": [
              "LUK.19.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 19:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbuje jula jwajanjile kuti, ‘M'mwejo mli jwamasengo jwangalumbana, tinamlamule ni maloŵe genu pego gakutyocela mkamwa mwenu! Ana eti mwamanyililaga kuti une ndili mundu jwakusawusya, jwele jungusagowola yindu yele nganiyiŵa yangu, soni ngusagowola mbeju syele mkupanda jwakwe nganimba une. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.22",
            "verseOrgIds": [
              "LUK.19.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambi ligongo cici nganimja kuŵika mbiya jangujo ku banki, kuti une pakuwuja nisipocele pamo ni congola magasa cakwe?’",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.23",
            "verseOrgIds": [
              "LUK.19.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 19:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.23",
            "verseOrgIds": [
              "LUK.19.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 19:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Kaneko ŵasalile ŵandu ŵiŵaliji pelepo kuti, ‘Mumsumule mbiyasyo ni msipelece kwa jwamasengo jwakwete kala mbiya likumi jula.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.24",
            "verseOrgIds": [
              "LUK.19.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 19:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanduwo ŵamsalile kuti, ‘Ambuje, jwalakwejo akwete kala mbiya sine likumi.’ ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.25",
            "verseOrgIds": [
              "LUK.19.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 19:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo jwalakwejo jwajanjile kuti, ‘Ngumsalila kuti jwalijose jwakwete kandu, tacimjonjecesya yine, nambo jwakanakola tacimsumula yosope yakwete.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.26",
            "verseOrgIds": [
              "LUK.19.26"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.13.12"
              },
              "items": [
                {
                  "text": "Mat 13:12",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MRK.4.25"
              },
              "items": [
                {
                  "text": "Mak 4:25",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LUK.8.18"
              },
              "items": [
                {
                  "text": "Luk 8:18",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.26",
            "verseOrgIds": [
              "LUK.19.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo kwamba ya amagongo ŵangu ŵiŵasosaga kuti une ngaŵa mwenye jwawo ŵala, myice nawo apano ni mwawulaje une ndili mkulola.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ŵajinjile mu msinda wa Yelusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 19:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.27",
            "verseOrgIds": [
              "LUK.19.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 19:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu piŵamasile kuŵeceta yeleyi ŵalongolele ŵakulijiganya",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
          }
        },
        {
          "text": " ŵakwe ni kwawula ku msinda wa Yelusalemu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.28",
            "verseOrgIds": [
              "LUK.19.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 19:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaŵandicile misi ja Betifagi ni Betaniya, ciŵandika ni Litumbi lya Olifi, ŵatumile ŵakulijiganya ŵakwe ŵaŵili ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.29",
            "verseOrgIds": [
              "LUK.19.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 19:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni ŵasalile kuti, “Mjawule m'musi wumkuwuwona pasogolo penuwo; pitimkagambe kwinjila m'musimo timkasimane mwanace jwa bulu ali jwamtaŵilile jwele nganakweledwejepo ni mundu jwalijose. Jemanja mkamgopole ni mkayice najo akuno. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.30",
            "verseOrgIds": [
              "LUK.19.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga mundu jwalijose akamwusye kuti, ‘Ana mkugopolela cici?’ Jemanja mkasalile kuti Ambuje akwete najo masengo.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 19:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.31",
            "verseOrgIds": [
              "LUK.19.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 19:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakulijiganya ŵaŵili ŵala ŵajile kusimana yosope mpela muŵasalilile Yesu mula. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.32",
            "verseOrgIds": [
              "LUK.19.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaliji kumgopola mwanace jwa bulujo, acimsyene ŵawusisye kuti, “Ana ligongo cici mkugopola mwanace jwa bulujo?”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.33",
            "verseOrgIds": [
              "LUK.19.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 19:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.33",
            "verseOrgIds": [
              "LUK.19.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 19:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵajanjile kuti, “Ambuje akumsosa.” ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.34",
            "verseOrgIds": [
              "LUK.19.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 19:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakulijiganya ŵala ŵajile najo kwa Yesu mwanace jwa bulu jula. Kaneko ŵaŵisile yakuwala yawo pa bulujo ni ŵamtesile Yesujo kuti akwele. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.35",
            "verseOrgIds": [
              "LUK.19.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu piŵaliji mkupita ali akwesile pa bulujo, ŵandu ŵamcimbicisye jwalakwejo pakutandika yakuwala yawo mu msewu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 19:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.36",
            "verseOrgIds": [
              "LUK.19.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 19:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaliji mkuŵandicila ku Yelusalemu aciselelekaga Litumbi lya Olifi, likuga lyosope lya ŵakulijiganya ŵakwe lyatandite kumlumba Mlungu mwa lukondwa ni mwakwesya maloŵe ligongo lya masengo gosope ga macili ga Yesu giŵagaweni jemanjajo acitiji kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.37",
            "verseOrgIds": [
              "LUK.19.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Jwana upile mwenye jwele jwakwisa mu lina lya Ambuje! Mtendele uŵe kwinani, ni ucimbicimbi kwa Mlungu kwinani mnope!”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "PSA.118.26"
              },
              "items": [
                {
                  "text": "Mas 118:26",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LUK 19:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.38",
            "verseOrgIds": [
              "LUK.19.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afalisi",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        },
        {
          "text": " ŵane ŵiŵaliji mwikugamo ŵamsalile Yesu kuti, “Cemwalimu, ŵasalile ŵakulijiganya ŵawo alece yakutendayi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LUK 19:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.39",
            "verseOrgIds": [
              "LUK.19.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu jwajanjile kuti, “Ngumsalila kuti naga jemanjaji akuleka kugumila, maganga ni gitigatande kugumila.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu akwalilila ŵandu ŵa mu msinda wa Yelusalemu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LUK 19:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.40",
            "verseOrgIds": [
              "LUK.19.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LUK 19:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu piŵaŵandicile ni kuwuwona msinda wa Yelusalemu ŵawulilile. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.41",
            "verseOrgIds": [
              "LUK.19.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LUK 19:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakwejo jwatite kuti, “Lelo jino ŵandu ŵa mu msinda wa Yelusalemu ngakumanyilila cele citicapa jemanjajo mtendele! Sambano jino cindu celeco cisisice kwa jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.42",
            "verseOrgIds": [
              "LUK.19.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LUK 19:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi tijiciyika jele amagongo ŵenu tacimsyungulila jemanja ni kumtaŵila mapupa gakulimbangana kumsyungulila jemanja ni kumwugalila mbali syosope. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.43",
            "verseOrgIds": [
              "LUK.19.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacimjonanga jemanja pamo ni ŵanace wosope ŵali mkati mwa lipupa lyenu lyakulimbangana. Ngasaleka liganga pacanya pa lijakwe. Ayi tiyicitendekwa ligongo nganimwona kuti Mlungu ayice kukumkulupusya jemanja.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.19.44",
            "verseOrgIds": [
              "LUK.19.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ŵajiswejesye Nyumba ja AMBUJE",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LUK 19:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
