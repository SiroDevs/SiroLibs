              "attrs": {
                "loc": "MAT.25.30"
              },
              "items": [
                {
                  "text": "25:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.8.11+MAT.8.12"
              },
              "items": [
                {
                  "text": "Mat 8:11-12",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.28",
            "verseOrgIds": [
              "LUK.13.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 13:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu taciyika kutyocela mbali syosope ni kutama pasi kuti alye ni kusangalala mu Ucimwene wa Mlungu. ",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.29",
            "verseOrgIds": [
              "LUK.13.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 13:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pelepo ŵali kumbesi taciŵa ŵandanda, nipo ŵitaciŵa ŵandanda taciŵa ŵa ku mbesi.”",
          "type": "text",
          "attrs": {
            "verseId": "LUK.13.30",
            "verseOrgIds": [
              "LUK.13.30"
            ]
          }
        },
        {
