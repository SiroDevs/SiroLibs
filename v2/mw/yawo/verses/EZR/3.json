          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amisili ŵakutaŵa nyumba ŵala piŵataŵile yilimbilimbi ya Nyumba ja AMBUJE, ŵakutaga mbopesi ŵayice ali mkwimba malipenga ali awete mikanjo jawo, nipo Alefi ŵa mwiŵasa lya Asafu ŵayice ali mkwimba micekece, ni kwalumbaga AMBUJE pakukuya yiŵaŵecete Mwenye Daudi",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "text": " jwa ku Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
