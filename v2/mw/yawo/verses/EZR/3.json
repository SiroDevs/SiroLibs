          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ŵajimbaga mwakupocelangana, mwakwalumba ni mwakwatogolela AMBUJE, acitiji kuti,",
