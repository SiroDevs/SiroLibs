          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mtemela wakumasya malombela ni ŵandu ŵa mitundu jine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pandaŵi jiŵapopelaga Esala ni kwiticisya ulemwa wawo, aku ali mkulila ni kuligwisya pasi pameso pa Nyumba ja AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.1",
            "verseOrgIds": [
              "EZR.10.1"
            ]
          }
        },
        {
          "text": " Likuga lya acalume, acakongwe ni ŵanace ŵa ku Isalaeli lyamsonganile jwalakwejo, nipo ŵalilaga mnope. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.1",
            "verseOrgIds": [
              "EZR.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Shekaniya mwanace jwa Yehiyele ŵa mwiŵasa lya Elamu ŵamsalile Esala kuti, “Uwe twatesile yangakulupicika kwa Mlungu jwetu, pakwalomba acakongwe ŵa yilambo yine, nambope atamose yili myiyi cembeceyo cipali sikati ja Aisalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.2",
            "verseOrgIds": [
              "EZR.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano kwende tutende cilanga",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.3",
            "verseOrgIds": [
              "EZR.10.3"
            ]
          }
        },
        {
          "text": " kwa Mlungu jwetu kuti uwe citwalece acakongweŵa pamo ni ŵanace ŵawo, pakukuya yasalile AMBUJE ŵangu ni ŵandu ŵakusagajogopa malamusi ga Mlungu jwetu. Uwe tucitenda pakukuya yigakuti malamusi. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.3",
            "verseOrgIds": [
              "EZR.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelegatu gali masengo ga wawo, uwe tuli panyuma pa wawo; myoyo pakusacikwa kuti alimbe mtima ni kutenda masengoga.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.4",
            "verseOrgIds": [
              "EZR.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.4",
            "verseOrgIds": [
              "EZR.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Esala ŵatandite masengo gakwalumbilisya acakulungwa ŵambopesi, Alefi, ni Aisalaeli wosope, kuti tacitenda mpela muŵaŵecetele Sekaniya, nipo ŵandu wosope ŵalumbile. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.5",
            "verseOrgIds": [
              "EZR.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko Esala ŵatyosile ku Nyumba ja AMBUJE nipo ŵajile ku cipinda ca Yehohanani, mwanace jwa Eliyashibu, kwele kuŵacesisye kulila ligongo lya kungakulupicika kwa ŵandu ŵiŵawusile ku ukapolo ŵala. Pandaŵi jeleji nganalya mkate kapena kumwa cilicose.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.6",
            "verseOrgIds": [
              "EZR.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.6",
            "verseOrgIds": [
              "EZR.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵajenesye utenga mcilambo cosope ca Yuda ni ku msinda wa Yelusalemu, kwa ŵandu wosope ŵiŵawusile ku ukapolo ŵala kuti akasongane ku Yelusalemu, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.7",
            "verseOrgIds": [
              "EZR.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵalamwile soni kuti naga mundu jwalijose akulepela kwika mkanigamale masiku gatatu, ni kuti jwalakwejo tacisumulwa katundu jwakwe josope pakukuya malamusi ga mwenye, soni tacimtyosya mwikuga lya ŵandu ŵiŵawusile ku ukapolo ŵala. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.8",
            "verseOrgIds": [
              "EZR.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵandu wosope ŵa ku Yuda ni ku Benjamini ŵasongene ku Yelusalemu kanigamale masiku gatatu, lyeleli lyaliji lisiku lya 20 lya mwesi wa msano ni mcece. Ŵandu wosope ŵatemi pasi pa luŵala lwa Nyumba ja AMBUJE ni ŵaliji mkutetemela ligongo lya nganiji, soni ni ula jijagwaga mnope pa ndaŵijo.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.9",
            "verseOrgIds": [
              "EZR.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.9",
            "verseOrgIds": [
              "EZR.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esala jwakutaga mbopesi ŵajimi nipo ŵaŵecete kuti, “Jemanja mwalemwisye pakulombela acakongwe ŵa yilambo yine, myoyo mjonjecesye ulemwa ku cilambo cosope ca Isalaeli. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.10",
            "verseOrgIds": [
              "EZR.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano mjiticisye ulemwa wenu pameso pa AMBUJE, Mlungu jwele juŵamlambilaga acinangolo ŵenu, nipo mtendeje lisosa lyakwe. Mliŵambasye mwacimsyene pasikati pa ŵandu ŵa mitundu ja m'yilambo yineŵa nipo mwalece acakongwe ŵenu ŵa cilendowo.”",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵapikene maloŵego, ŵandu wosope ŵiŵasongenewo ŵajanjile mwakukwesya maloŵe kuti, “Wawo akuŵeceta yakuwona, nipo uwe citutende mpela mwaŵecetelemo.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.12",
            "verseOrgIds": [
              "EZR.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵanduwo ŵajonjecesye kuŵeceta kuti, “Uwe tupali ŵajinji, nambo soni ula jikugwa mwamacili mwakuti ngayikomboleka soni kuti tujime pamtetete mpela mututendelemu. Cine soni cili cakuti masengogatu nganigaŵa ga lisiku limpepe kapena gaŵili, ligongo tulemwisye mnope pa ngani jeleji. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.13",
            "verseOrgIds": [
              "EZR.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Twalece acimlongola ŵetu atujimilile uwe wosope, nipo mundu jwalijose jwakwete ŵakongwe ŵa cilambo cine ayice akuno pa ndaŵi jitasale wawo, pamo ni acakulungwa ni ŵakulamula ŵa msinda uliwose. Mwalitala lyeleli lutumbilo lwakogoya lwa Mlungu tulucityoka pa ngani jeleji.” ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.14",
            "verseOrgIds": [
              "EZR.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yonatani mwanace jwa Asahelo, ni Yahiseya mwanace jwa Tikifa ni ŵiŵasisisye pa ngani jeleji, nipo Meshulamu ni Shabetayi jwa ci Lefi ŵajiticisye. ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.15",
            "verseOrgIds": [
              "EZR.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ŵandu ŵiŵawusile kutyocela ku ukapolo ŵala ŵajiticisye yiŵakamulene yila, nipo Esala jwakutaga mbopesi ŵasagwile acalume ŵiŵaliji acimlongola ŵa maŵasa ni ŵalembile mena pakukuya maŵasa gawo. Pa lisiku lyandanda lya mwesi wa 10 ŵatandite kuwusya magambogo, ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.16",
            "verseOrgIds": [
              "EZR.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ŵamalisisye kuwusya magambo ga ŵandu ŵaŵawalombele acakongwe ŵa yilambo yine ŵala pa lisiku lyandanda lya mwesi wandanda wa caka cakuyicisyaco.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.17",
            "verseOrgIds": [
              "EZR.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Acalume ŵiŵalombele acakongwe ŵa mitundu jine",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.17",
            "verseOrgIds": [
              "EZR.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gakuyicisyaga ni mena ga ŵakutaga mbopesi ŵiŵalombele acakongwe ŵa yilambo yine:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        }
      ]
    }
