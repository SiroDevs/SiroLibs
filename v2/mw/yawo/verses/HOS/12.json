              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.1",
            "verseOrgIds": [
              "HOS.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HOS 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akwajimba magambo ŵandu ŵa ku Yuda. Tacipeleka cilango ku liŵasa lya Yakobo",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        },
        {
          "text": " ligongo lya ndamo syawo, tacawucisya mwakulingana ni yitendo yawo yakusakala. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.2",
            "verseOrgIds": [
              "HOS.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HOS 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Piŵaliji mcitumbo mwa mama ŵawo, Yakobo ŵakangene ni mlongo mjakwe, nipo piŵakusile ŵalimbene ni Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.25.26"
              },
              "items": [
                {
                  "text": "Gen 25:26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.32.24+GEN.32.25+GEN.32.26"
              },
              "items": [
                {
                  "text": "Gen 32:24-26",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.3",
            "verseOrgIds": [
              "HOS.12.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HOS 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalimbene ni lilayika nipo ŵapundile. Ŵalisile ni kuŵenda upile. Mlungu ŵasimene ni jwalakwejo ku Beteli, nipo kweleko kupitila mwa jwalakwejo ŵaŵecete ni uwe.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.28.10+GEN.28.11+GEN.28.12+GEN.28.13+GEN.28.14+GEN.28.15+GEN.28.16+GEN.28.17+GEN.28.18+GEN.28.19+GEN.28.20+GEN.28.21+GEN.28.22"
              },
              "items": [
                {
                  "text": "Gen 28:10-22",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.4",
            "verseOrgIds": [
              "HOS.12.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HOS 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwalakweju ali AMBUJE, Mlungu Jwamaciligosope. Ŵandu amkumbucileje jwalakwejo ni lina lyakwe lyakuti AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.5",
            "verseOrgIds": [
              "HOS.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo jemanja mwujile kwa jwalakwejo. Mkapikanileje ni kutenda cilungamo, ni kwembecela mwakufasa kuti Mlungu jwenujo atendepo kandu.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.6",
            "verseOrgIds": [
              "HOS.12.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE akuŵeceta kuti, “Aisalaeli ali mpela jwa malonda jwa unami, jwele jwakusakamulisya masengo masikelo ga unami. Akusanonyela kwalambusya ŵandu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.7",
            "verseOrgIds": [
              "HOS.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli akuŵeceta kuti, ‘Uwe tuli ŵakusicila, mwakuti tutesile upile. Pangali soni jutatugambe ligongo lyakuti tusicile mu matala gangaŵa ga cilungamo.’ ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.8",
            "verseOrgIds": [
              "HOS.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo une AMBUJE junamkopwesye ku Iguputo, tinjimtamika soni m'ma tenti mpela mumwatendelaga kalakala ku cipululu cila.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "LEV.23.42+LEV.23.43"
              },
              "items": [
                {
                  "text": "Lef 23:42-43",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.9",
            "verseOrgIds": [
              "HOS.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Naŵecete ni ŵakulocesya ni napele mesomkulola gejinji, soni kupitila mwa ŵakulocesyawo nakalamwisye ŵandu ŵangu. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.10",
            "verseOrgIds": [
              "HOS.12.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ku Giliyadi ŵandu akulambilape yindu yakupanganyidwa ni yala. Yindu yeleyi tiyicijonanjidwa. Ŵapelekaga mbopesi sya ng'ombe ku Giligala, nambo malo gakupelecela mbopesigo tinjigasandusya kuŵa mbuwa ja maganga m'migunda.”",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.11",
            "verseOrgIds": [
              "HOS.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HOS 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakobo ŵatilile ku Mesopotamiya kwele kuŵakamwile masengo kuti apate ŵakongwe. Ŵaliji mkulanga ngondolo kuti apate ŵakongwewo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.29.1+GEN.29.2+GEN.29.3+GEN.29.4+GEN.29.5+GEN.29.6+GEN.29.7+GEN.29.8+GEN.29.9+GEN.29.10+GEN.29.11+GEN.29.12+GEN.29.13+GEN.29.14+GEN.29.15+GEN.29.16+GEN.29.17+GEN.29.18+GEN.29.19+GEN.29.20"
              },
              "items": [
                {
                  "text": "Gen 29:1-20",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.12",
            "verseOrgIds": [
              "HOS.12.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HOS 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵatumisye jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.13",
            "verseOrgIds": [
              "HOS.12.13"
            ]
          }
        },
        {
          "text": " kukwakulupusya ŵandu ŵa ku Isalaeli kutyocela ku ukapolo ku Iguputo ni kwasamalila jemanjajo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.13",
            "verseOrgIds": [
              "HOS.12.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "EXO.12.50+EXO.12.51"
              },
              "items": [
                {
                  "text": "Eks 12:50-51",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.13",
            "verseOrgIds": [
              "HOS.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HOS 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵandu ŵa ku Isalaeli ŵalutandite lutumbilo lwa AMBUJE pa magambo gakuwulaga ŵandu, ali ni ligongo lyakwe AMBUJE tacapa cilango jemanjajo ligongo lyakwatendesya soni ŵalakwewo.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.12.14",
            "verseOrgIds": [
              "HOS.12.14"
            ]
          }
        }
      ]
    }
