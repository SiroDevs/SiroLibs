              "items": [
                {
                  "text": "12:7",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HOS 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.6",
            "verseOrgIds": [
              "HOS.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HOS 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mpela Adamu, jemanjajo akasile cilanga",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        },
        {
          "text": " cinatesile ni jemanjajo. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.7",
            "verseOrgIds": [
              "HOS.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HOS 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msinda wa Giliyadi uli wa ŵandu ŵakutenda yakusakala, mwakuti agamba kuwulagana basi. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.8",
            "verseOrgIds": [
              "HOS.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HOS 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpela jwawiyi akusamjuŵilila mundu, myoyo soni ŵakutaga mbopesi akusasongana kuti awulajeje ŵandu pa litala lyakuja ku Shekemu. Yakuwona akusatenda yaciswamba yejinji. ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.9",
            "verseOrgIds": [
              "HOS.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Niyiweni yindu yakunyalaya sikati ja Aisalaeli. Isalaeli ŵatesile ya cikululu, nombe nawo Aisalaeli ŵalisakesye pakulambila milungu jakupanganyidwa ni yala.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HOS 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.10",
            "verseOrgIds": [
              "HOS.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HOS 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambo Jemanja, ŵandu ŵa ku Yuda, mbisile ndaŵi jakuti mbelece cilango kwa jemanja pa yele yimkutenda.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.6.11",
            "verseOrgIds": [
              "HOS.6.11"
            ]
          }
        }
      ]
    }
