        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "“M'mwejo ni Aloni",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "text": " mwaŵalanje ŵandu ŵa Aisalaeli mwa maŵele gawo ni maŵasa gawo. Mlembe mena ga acalume wosope ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.2",
            "verseOrgIds": [
              "NUM.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ŵakwanile yaka 20 kapena kupunda pelepo, ŵali ŵakuŵajilwa kuputa ngondo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.3",
            "verseOrgIds": [
              "NUM.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwusye ku mtundu uliwose mwenye jumo jwa liŵasalyo kuti amkamucisye.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.4",
            "verseOrgIds": [
              "NUM.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aŵa ni acalume, ŵakulongolela ngosyo syawo, ŵiŵasagwile kutyocela m'maŵasa kuti akamucisye pa masengoga:",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.5+NUM.1.6+NUM.1.7+NUM.1.8+NUM.1.9+NUM.1.10+NUM.1.11+NUM.1.12+NUM.1.13+NUM.1.14+NUM.1.15+NUM.1.16",
            "verseOrgIds": [
              "NUM.1.5",
              "NUM.1.6",
              "NUM.1.7",
              "NUM.1.8",
              "NUM.1.9",
              "NUM.1.10",
              "NUM.1.11",
              "NUM.1.12",
              "NUM.1.13",
              "NUM.1.14",
              "NUM.1.15",
              "NUM.1.16"
            ]
          }
        }
      ]
    },
