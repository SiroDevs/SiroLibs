        "style": "s1"
      },
      "items": [
        {
          "text": "Kuŵalanjidwa kwandanda kwa Aisalaeli",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
