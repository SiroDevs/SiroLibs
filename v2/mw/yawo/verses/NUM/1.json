          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lyandanda lya mwesi waŵili mcaka caŵili Aisalaeli ali atyosile mcilambo ca Iguputo, AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "text": " ŵaŵecete kwa Mose",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
        {
          "text": " juŵaliji mu citenti cakusimanilana mcipululu ca Sinayi. Ŵatite kuti,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.1.1",
            "verseOrgIds": [
              "NUM.1.1"
            ]
          }
        },
