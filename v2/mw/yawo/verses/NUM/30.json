    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NUM 30:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pati jwamkongwe jwali mwali jwakutama m'nyumba ja babagwe alumbile kuti tacipeleka cindu kwa AMBUJE kapena alumbile kuti tacitendadi cindu, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.3",
            "verseOrgIds": [
              "NUM.30.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NUM 30:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "jwalakwejo akuŵajilwa kutenda yosope yene yiŵalumbileyo kapena kusalayo. Naga babagwewo akupikana ni ngaŵeceta cilicose akuŵajilwa kutenda yiŵalumbileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.4",
            "verseOrgIds": [
              "NUM.30.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga babagwewo akumlekasya kukwanilisya yiŵalumbileyo ali apikene, pangali lilamusi lyakumkanganicisya mwanacejo kutenda yiŵalumbileyo kapena yiŵasasileyo. AMBUJE tacimkululucila ligongo babagwe ŵamlekasisye.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NUM 30:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.5",
            "verseOrgIds": [
              "NUM.30.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 30:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga jwamkongwe jwangalombedwa akulumbila mwangaganicisya cenene kapena mwamele, panyuma pakwe ni akulombedwa, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.6",
            "verseOrgIds": [
              "NUM.30.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 30:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "akusosekwa kukwanilisya yosope yiŵalumbileyo kapena yiŵasasileyo. Naga ŵamkwakwewo akupikana ni ngaŵeceta cilicose akuŵajilwa kukwanilisya yiŵalumbileyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.7",
            "verseOrgIds": [
              "NUM.30.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga akumlekasya kukwanilisya kuyitenda yiŵalumbileyo apo pangali lilamusi lyakumkanganicisya kutenda yiŵalumbileyo. AMBUJE tacimkululucila jwalakwejo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 30:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.8",
            "verseOrgIds": [
              "NUM.30.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkongwe jwamasije kapena juŵamlesile ulombela ŵamkwakwe naga alumbile kapena kutenda cilanga",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "text": " kuti tacitenda cindu cilicose, akuŵajilwa kucitendadi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 30:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.9",
            "verseOrgIds": [
              "NUM.30.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 30:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga jwamkongwe jwamlombele akulumbila ni kutenda cilanga cakutenda cindu cilicose, akuŵajilwa kutenda cindu ciŵalumbile kapena kutenda cilangaco kuti tacicitenda. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.10",
            "verseOrgIds": [
              "NUM.30.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NUM 30:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naga ŵamkwakwe akupikana ni ngaŵeceta kandu, jwamkongwejo akuŵajilwa kutenda yosope yiŵalumbileyo kapena kutenda cilangayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.11",
            "verseOrgIds": [
              "NUM.30.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 30:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga ŵalumewo akwalekasya kutenda yiŵalumbileyo ali apikene, pangali lilamusi lyakumkanganicisya kutenda yiŵalumbileyo. AMBUJE tacimkululucila ligongo ŵamkwakwewo amlekasisye kusunga malumbilo gakwego. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.12",
            "verseOrgIds": [
              "NUM.30.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "NUM 30:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalume ŵawo akwete macili gakwalimbikasya ŵamkwakwewo atende yiŵalumbileyo kapena kumlekasya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.13",
            "verseOrgIds": [
              "NUM.30.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 30:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo lisiku lyapikene ya malumbilogo naga ngakulekasya, jwamkongwejo akuŵajilwa kutenda yosope yiŵalumbileyo kapena kutenda cilanga. Ni kuti jwamlumejo ajiticisye malumbilogo naga ngakulekasya pa lisiku lyapikenelyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.14",
            "verseOrgIds": [
              "NUM.30.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga panyuma pakwe akulekasya malumbilogo kutendaga ŵaliji ali apikene kala, jwamlumejo ni jutaŵe jwa ulemwa",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "text": " m'malo mwa jwamkongwejo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 30:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.15",
            "verseOrgIds": [
              "NUM.30.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 30:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gelega ni malamusi giŵapelece AMBUJE kwa Mose gakwamba ya kulumbila kwa jwamkongwe jwali jwangalombela nambo jwakutama m'nyumba ja babagwe kapena jwamkongwe jwali peŵasa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.16",
            "verseOrgIds": [
              "NUM.30.16"
            ]
          }
        }
      ]
    }
