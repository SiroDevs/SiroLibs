              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
          "text": " ŵasalile acakulungwa ŵa ngosyo sya ku Isalaeli ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.1",
            "verseOrgIds": [
              "NUM.30.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NUM 30:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti naga mundu jwamlume alumbile kuti tacipeleka cindu kwa AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "text": " kapena alumbile kuti tacitendadi cindu akakasa kulumbila",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
        {
          "text": " kwakweko. Nambo kuti atende yosope yiŵalumbileyo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.30.2",
            "verseOrgIds": [
              "NUM.30.2"
            ]
          }
        },
