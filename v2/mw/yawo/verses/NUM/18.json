                "loc": "LEV.27.30+LEV.27.31+LEV.27.32+LEV.27.33"
              },
              "items": [
                {
                  "text": "Lef 27:30-33",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.14.22+DEU.14.23+DEU.14.24+DEU.14.25+DEU.14.26+DEU.14.27+DEU.14.28+DEU.14.29"
              },
              "items": [
                {
                  "text": "Det 14:22-29",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.21",
            "verseOrgIds": [
              "NUM.18.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aisalaeli ŵane wosope akaŵandicila soni ku tenti kogopa kuliwulagasya. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.22",
            "verseOrgIds": [
              "NUM.18.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kutandila sambano mpaka msogolo Alefipe basi ni ŵitasamalileje tenti nipo udindo wosope wene uli m'myala mwawo. Lyele lilamusili lili mpaka kalakala likwakwaya soni wosope ŵali yisukulu yenu. Alefi ngasakola katundu jwawojwawope mpaka kalakala mu Isalaeli, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.23",
            "verseOrgIds": [
              "NUM.18.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo napele jemanjajo calikumi cakusapelekaga Aisalaeli kwa une mpela yakusonga yawo kuŵa mpela katundu jwawo. Ni ligongo lyakwe nasalile jemanjajo kuti akusakola katundu kapena cilambo cawocawope mu Isalaeli.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yakuŵajilwa kupeleka Alefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.24",
            "verseOrgIds": [
              "NUM.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵamlamwile Mose",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "text": " kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.25",
            "verseOrgIds": [
              "NUM.18.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "aŵecete kwa Alefi maloŵe gakuti: “Pati apocele kwa Aisalaeli calikumi cakupeleka AMBUJE kwa jemanja mpela katundu jwawo, jemanja mkuŵajilwa kupeleka calikumi ca yeleyo mpela yakusonga ya kwa AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.26",
            "verseOrgIds": [
              "NUM.18.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "NUM 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi yakusongayi tiyiciŵa yakulandana ni yakupeleka ya mundu jwakulima tiligu jwandanda kukomala ni finyo jwandanda kwiwula. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.27",
            "verseOrgIds": [
              "NUM.18.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "NUM 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwa lyele litalali jemanja soni timcipeleka yamsonjemsonje yayili ya kwa AMBUJE kutyocela ku cilicose calikumi cakucipocela kwa Aisalaeli. Jemanja timcipeleka yamsonjemsonje ya kwa AMBUJEYI kwa Aloni jwambopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.28",
            "verseOrgIds": [
              "NUM.18.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "NUM 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Apeleceje yakupunda kusalala mnope mwa yakupocelayo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.29",
            "verseOrgIds": [
              "NUM.18.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pati apelece yakupunda kusalala mnopeyo, asalasye yakusigalayo, mpela mwakusalacisya jwakulima yakusigala ali apelece yakupeleka yakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.30",
            "verseOrgIds": [
              "NUM.18.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja ni maŵasa genu mlyeje yisigeleyo kulikoseko, ligongo yiŵele malipilo genu ga masengo ga mu tenti. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.31",
            "verseOrgIds": [
              "NUM.18.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngasimkola magambo galigose pitimcilyapo, bola naga mli mpelece kwa AMBUJE yambone mnopeyo. Nambo mlolecesyeje kuti akasajisakasyaga mituka jakusagulidwa ja Aisalaeli pakulya mituka jilijose mkanimpelece kwa AMBUJE mituka jambonejo, naga mkutenda, timciwulajidwa.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.18.32",
            "verseOrgIds": [
              "NUM.18.32"
            ]
          }
        }
      ]
    }
