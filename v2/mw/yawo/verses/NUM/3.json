          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pakuŵapo ŵanace ŵacalume ŵandanda kupagwa ŵa Aisalaeli akwapunda Alefi pakutupa ni 273, jemanja akuŵajilwa kwawombola ŵanace ŵajonjecesyewo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.46",
            "verseOrgIds": [
              "NUM.3.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
