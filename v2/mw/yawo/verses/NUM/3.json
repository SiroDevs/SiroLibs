          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵatite kwa Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.11",
            "verseOrgIds": [
              "NUM.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "NUM 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Alefi sambano taŵe ŵangune. Pinawuleje ŵandanda kupagwa wosope ŵa mu Iguputo, namsagwile mwanace jwamlume jwandanda kupagwa jwa liŵasa lililyose lya Aisalaeli kuŵa jwangune ni cinyama cilicose candanda kupagwa. Sambano, m'malo mwakola ŵanace ŵacalume ŵandanda kupagwa ŵa Aisalaeli mpela ŵangune, ngwete Alefi, taciŵa ŵangune. Une ndili AMBUJE.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.12+NUM.3.13",
            "verseOrgIds": [
              "NUM.3.12",
              "NUM.3.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
