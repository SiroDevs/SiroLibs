        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "NUM 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mcipululu ca Sinayi AMBUJE ŵamlamwile Mose ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.14",
            "verseOrgIds": [
              "NUM.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "NUM 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti ŵalembe Alefi mwa maŵele ni maŵasa gawo, amlembe jwamlume jwalijose jwakwanile mwesi umo kapena kupunda, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.15",
            "verseOrgIds": [
              "NUM.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "NUM 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo Mose ŵatesile yeleyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.16",
            "verseOrgIds": [
              "NUM.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lefi ŵakwete ŵanace ŵacalume ŵatatu: Geleshoni, Kohati, ni Melali, ŵiŵaliji acinangolo ŵa maŵele mpela mwa mena gawo: Geleshoni ŵakwete ŵanace ŵacalume ŵaŵili aŵa: Libini ni Shimeyi, Kohati ŵakwete ŵanace ŵacalume mcece: Amulamu, Isala, Hebuloni, ni Usiyele, nipo Melali ŵakwete ŵanace ŵacalume ŵaŵili aŵa: Mali ni Mushi. Jemanjaji ŵaliji acinangolo ŵa maŵasa mpela mwa mena gawo.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17+NUM.3.18+NUM.3.19+NUM.3.20",
            "verseOrgIds": [
              "NUM.3.17",
              "NUM.3.18",
              "NUM.3.19",
              "NUM.3.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "NUM 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.17+NUM.3.18+NUM.3.19+NUM.3.20",
            "verseOrgIds": [
              "NUM.3.17",
              "NUM.3.18",
              "NUM.3.19",
              "NUM.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "NUM 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŵele lya Geleshoni lyakwete maŵasa ga Libini ni Shimeyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.21",
            "verseOrgIds": [
              "NUM.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "NUM 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cosope cene ca acalume ŵakwana mwesi umope kapena kupunda ŵiŵalembile caliji 7,500. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.22",
            "verseOrgIds": [
              "NUM.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "NUM 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyele liŵasali lyaliji mkutaŵa masakasa gawo kungapilo lyuŵa kunyuma kwa citenti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.23",
            "verseOrgIds": [
              "NUM.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "NUM 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eliyasafu mwanace jwa Layeli ni juŵaliji mwenye jwa lyele liŵasalyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.24",
            "verseOrgIds": [
              "NUM.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "NUM 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo ni ŵiŵaliji ŵakulamulila ŵa citentico, yakuwunicila yakwe ya mkati, ya kusa, likatani lya pa mlango pakwinjilila, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.25",
            "verseOrgIds": [
              "NUM.3.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "NUM 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "makatani ga malo gosope gakusyungulila citentico ni kumalo kwakupelecela mbopesi kwakwe, ni likatani lyakwinjilila ku malo ga mkati. Jemanjajo ŵakwete udindo wa masengo gosope gakwayana ni yele yinduyi.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.26",
            "verseOrgIds": [
              "NUM.3.26"
            ]
          }
        }
      ]
    },
