            "sid": "NUM 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵatite kwa Mose, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.5",
            "verseOrgIds": [
              "NUM.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NUM 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Myice nalo lukosyo lwa Lefi nipo mwasagule kuti aŵe ŵakutumicila ŵa Aloni jwakutaga mbopesi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.6",
            "verseOrgIds": [
              "NUM.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NUM 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo tacipanganya masengo ga jwalakwejo ni likuga lyosope lya ŵandu pasogolo pa citenti cakusimanilana. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.7",
            "verseOrgIds": [
              "NUM.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NUM 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjajo taciŵa ŵakulolela yida yosope ya mu citenti nipo tacapanganyicisya masengo Aisalaeli ŵane wosope. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.8",
            "verseOrgIds": [
              "NUM.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NUM 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Udindo wakwete Alefi ni ŵakwatumicila Aloni ni ŵanace ŵawo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.9",
            "verseOrgIds": [
              "NUM.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NUM 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "M'mwejo timcasagula Aloni ni ŵanace ŵawo kuti apanganyeje masengo ga ŵakutaga mbopesi, nipo jwine jwalijose jwakulinjilila kutenda yeleyo tacimwulaga.”",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.10",
            "verseOrgIds": [
              "NUM.3.10"
            ]
          }
        }
      ]
    },
