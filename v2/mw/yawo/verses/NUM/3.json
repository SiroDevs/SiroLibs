        },
        {
          "text": "AMBUJE ŵamsalile Mose kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.44",
            "verseOrgIds": [
              "NUM.3.44"
            ]
          }
        },
        {
