          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŵele lya Melali lyakwete maŵasa ga Mali ni Mushi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.33",
            "verseOrgIds": [
              "NUM.3.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "NUM 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cosope ca ŵanace ŵacalume ŵakwana mwesi umo kapena kupunda ŵiŵalembile caliji 6,200. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.34",
            "verseOrgIds": [
              "NUM.3.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "NUM 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyele liŵeleli lyaliji lyakuja kutaŵa masakasa gawo ku mbali ja kumpoto kwa Tenti, nipo Suliyeli mwanace jwa Abihayilo ni juŵaliji mwenye jwa liŵasalyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.35",
            "verseOrgIds": [
              "NUM.3.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "NUM 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji ŵapele masengo gakulinganya mafelemu ga Tenti, yisyano, njalamila, pasi pakwe, pamo ni yakutaŵila yakwe yosope. Udindo wawo waliji wa masengo gosope gakwayana ni yeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.36",
            "verseOrgIds": [
              "NUM.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "NUM 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo soni masengo gawo gane galiji gakulinganya sici, pasi, yicili, ni ngonji sya malo gakusa.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.37",
            "verseOrgIds": [
              "NUM.3.37"
            ]
          }
        }
      ]
    },
