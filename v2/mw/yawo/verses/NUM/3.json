          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ni kusipeleka mbiyasyo kwa Aloni ni ŵanace ŵawo.” ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.48",
            "verseOrgIds": [
              "NUM.3.48"
            ]
          }
        },
