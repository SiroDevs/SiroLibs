                {
                  "text": "Eks 13:2",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kalembela jwa Alefi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
