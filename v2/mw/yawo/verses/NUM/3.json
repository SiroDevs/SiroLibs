              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cosope ca acalume ŵakwana mwesi umo kapena kupunda ŵiŵalembile caliji 8,600. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.28",
            "verseOrgIds": [
              "NUM.3.28"
            ]
