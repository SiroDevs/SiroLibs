          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lyele liŵeleli lyaliji lyakuja kutaŵa masakasa gawo ku mbali ja kum'mwela kwa Tenti, ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.29",
            "verseOrgIds": [
              "NUM.3.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "NUM 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elisafani mwanace jwa Usiyele ni juŵaliji mwenye jwa liŵasalyo. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.30",
            "verseOrgIds": [
              "NUM.3.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "NUM 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji udindo wawo waliji ŵakulolela Libokosi lya Cilanga,",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "text": " tebulo, cakuŵikapo nyali, kumalo kwakupelecela mbopesi, yida yakupanganyicisya masengo ŵakutaga mbopesi ku Malo Gamaswela, ni likatani lya pa mlango pakwinjilila ku Cipinda Ceswela Mnope. Jemanjaji ŵakwete udindo wakwayana ni yele yinduyi. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.31",
            "verseOrgIds": [
              "NUM.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "NUM 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jwamkulungwa jwa Alefi ŵaliji Eliyesa mwanace jwa Aloni ŵakutaga mbopesi. Jwalakwe ŵalolelaga ŵiŵatendaga masengo ku Malo Gamaswela.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.32",
            "verseOrgIds": [
              "NUM.3.32"
            ]
          }
        }
      ]
    },
    {
