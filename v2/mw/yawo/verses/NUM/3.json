            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Liŵele lya Kohati lyakwete maŵasa ga Amulamu, Isala, Ahebuloni, ni Usiyele. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.27",
