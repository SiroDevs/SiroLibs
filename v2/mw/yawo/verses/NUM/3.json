          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ni Aloni ni ŵanace ŵawo ŵaliji ŵakutaŵa masakasa kusogolo kwa Tenti kungopoko lyuŵa. Jemanjaji masengo gawo galiji gakupanganya masengo m'malo mwa ŵandu ŵa Aisalaeli M'malo Gamaswela. Jwalijose juŵalinjilile kutenda yeleyo ŵamwuleje. ",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.38",
            "verseOrgIds": [
              "NUM.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "NUM 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ciŵalanjilo cosope cene ca Alefi ŵacalume ŵakwana mwesi umo kapena kupunda ŵiŵalembile Mose mwa maŵasa gawo mpela muŵalamulile AMBUJE, caliji 22,000.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.3.39",
            "verseOrgIds": [
              "NUM.3.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alefi akwinjila m'malo mwa ŵanace ŵacalume ŵandanda kupagwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
