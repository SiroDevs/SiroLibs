          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga ali jwakulupicika soni jwangali ulemwa, ngasigampweteka nipo tacipakombola kuŵeleka ŵanace.",
          "type": "text",
          "attrs": {
            "verseId": "NUM.5.28",
