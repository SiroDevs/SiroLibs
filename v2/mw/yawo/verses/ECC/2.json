            }
          ]
        },
        {
          "text": "Naga pangali jwalakwejo, ana ŵani mpaka apakombole kulya kapena kusangalala mwa jikape? ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
