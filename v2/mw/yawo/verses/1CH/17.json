              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵalakwe AMBUJE ali Mlungu, nipo aŵisile cilanga aci cakusimonjeka kwa une. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.17.26",
