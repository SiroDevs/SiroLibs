              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵacalume 14 ŵa Hemani ŵaliji Bukiya, Mataniya, Usiyele, Shebuyele, Yelimoti, Hananiya, Hanani, Eliyata, Gidati, Lomamti Yesele, Yoshibekasha, Maloti, Hotili ni Mahasiyoti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.4",
            "verseOrgIds": [
              "1CH.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵampele Hemani, jwakulocesya",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "text": " jwa mwenye ŵanace ŵacalume 14 ni ŵanace ŵacakongwe ŵatatu, pakukuya cilanga",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "text": " ca Mlungu cakuti tacimpa macili jwalakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.5",
            "verseOrgIds": [
              "1CH.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
