            "sid": "1CH 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace mcece ŵa Asafu ŵaliji Sakuli, Yosefe, Netaniya ni Asalela. Namlongola jwawo ŵaliji ni Asafu, soni ŵalalicilaga naga ali atumidwe ni mwenye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.2",
            "verseOrgIds": [
              "1CH.25.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
