          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace msano ni jumo ŵa Yedutuni ŵaliji Gedaliya, Seli, Yesaya, Shimeyi, Hashabiya ni Matitiya. Juŵalongolelaga jemanjaji ŵaliji Yedutuni baba ŵawo. Ŵalalicilaga nipo soni ŵajimbaga nyimbo ni yida yakwimbila ya ngonji, pakwatogolela AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.3",
            "verseOrgIds": [
              "1CH.25.3"
            ]
          }
        }
      ]
    },
