          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace wosopeŵa ŵajimbaga micekece ni yida yakwimbila ya ngonji ku Nyumba ja AMBUJE. Ŵakulongolela ŵawo ŵaliji baba ŵawo. Nipo Asafu, Yedutuni ni Hemani ŵalamulwaga ni mwenye.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.6",
            "verseOrgIds": [
              "1CH.25.6"
            ]
          }
        }
