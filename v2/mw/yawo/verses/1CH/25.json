              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwenye Daudi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "text": " pamo ni acimlongola ŵa ci Lefi ŵasagwile ŵandu ŵane ŵa mwiŵasa lya Alefi ŵakuyicisyaŵa kuti alongoleleje mapopelo m'Nyumba ja AMBUJE:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        },
        {
          "text": " Asafu, Hemani ni Yedutuni. Jemanjaji ŵaliji mkulalicila utenga wa AMBUJE kupitila mu kwimba nyimbo pakukamulisya masengo yida yakwimbila ya ngonji ni micekece. Mena ga ŵandu ŵaŵatendaga masengo m'Nyumba ja AMBUJE pamo ni mtundu wa masengo gawo ni aŵa:",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.1",
            "verseOrgIds": [
              "1CH.25.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
