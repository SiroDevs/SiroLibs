            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Makuga 24 ga ŵandu wosopeŵa ŵakwete umanyilisi pa yakwimbajimba; soni acalongo acimjawo ŵa ci Lefi ŵaliji ŵamlijiganye kwejinji kwajimbila AMBUJE. Paciŵalanjilo cosope ŵapali ŵandu 288.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.25.7",
            "verseOrgIds": [
              "1CH.25.7"
            ]
