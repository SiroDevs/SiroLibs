            "number": "28",
            "style": "v",
            "sid": "1CH 24:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mali ŵakwete ŵanace ŵaŵili, mena gawo galiji Eliyesa ni Kishi. Eliyesa nganakola ŵanace ŵacalume, nambo Kishi ni ŵiŵakwete mwanace jumo lina lyakwe Yelamele. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.28+1CH.24.29",
            "verseOrgIds": [
              "1CH.24.28",
              "1CH.24.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1CH 24:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mushi ŵakwete ŵanace ŵatatu, mena gawo galiji Mali, Eda ni Yelimoti.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.30",
            "verseOrgIds": [
              "1CH.24.30"
            ]
          }
        }
      ]
    },
    {
