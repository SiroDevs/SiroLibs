        {
          "text": "Masengo giŵakamulaga ŵandu ŵeleŵa galiji gakutumicila m'Nyumba ja AMBUJE",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        },
        {
          "text": " pakukuya msyungu wa Aloni nangolo jwawo, mpela mwele muŵalamulile AMBUJE Mlungu jwa Isalaeli.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.19",
            "verseOrgIds": [
              "1CH.24.19"
            ]
          }
        }
