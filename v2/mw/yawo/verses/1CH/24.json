          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Melali ŵaliji babagwe Mali, Mushi ni Yasiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.26",
            "verseOrgIds": [
              "1CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yasiya ŵakwete ŵanace ŵatatu, mena gawo galiji Shohamu, Sakuli ni Ibuli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.27",
            "verseOrgIds": [
              "1CH.24.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
