          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hebuloni ŵakwete ŵanace mcece: Jwandanda ŵaliji Yeliya, jwaŵili ŵaliji Amaliya, jwatatu ŵaliji Yahasiyele nipo jwamcece ŵaliji Yekamimu.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.24.23",
