            "number": "23",
            "style": "v",
            "sid": "1CH 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Daudi piŵaliji ku Hebuloni, asilikali ŵamlijiganye cenene ŵajinjile mu likuga lyakwe lya ngondo. Ŵayice kukumkamucisya Daudi kuti jwalakwejo ajinjile ucimwene m'malo mwa Saulo, mpela muŵaŵecetele AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.23+1CH.12.24+1CH.12.25+1CH.12.26+1CH.12.27+1CH.12.28+1CH.12.29+1CH.12.30+1CH.12.31+1CH.12.32+1CH.12.33+1CH.12.34+1CH.12.35+1CH.12.36+1CH.12.37",
            "verseOrgIds": [
