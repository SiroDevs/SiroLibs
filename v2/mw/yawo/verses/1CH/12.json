              "type": "text"
            }
          ]
        },
        {
          "text": "Asilikaliwo ŵatemi ku Hebuloniko pamo ni Daudi kwa masiku gatatu, ŵalyaga yakulya yele acalongo acimjawo ŵalinganyicisyaga. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.12.39",
