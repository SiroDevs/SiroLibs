          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1CH 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga ni mena ga ŵanace ŵa Daudi",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "text": " ŵaŵapagwile ku Hebuloni. Jwandanda kupagwa ŵaliji Aminoni, mamagwe ŵaliji Ahinowamu ŵa ku Yesilele. Jwaŵili kupagwa ŵaliji Daniele, nipo mamagwe ŵaliji Abigelo ŵa ku Kalimeli. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.1",
            "verseOrgIds": [
              "1CH.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1CH 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwatatu kupagwa ŵaliji Abisalomu, nipo mamagwe ŵaliji Maaka mwanace jwamkongwe jwa Mwenye Talimai ŵa ku Geshu. Mwanace jwamcece kupagwa ŵaliji Adoniya, mamagwe ŵaliji Hagiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.2",
            "verseOrgIds": [
              "1CH.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1CH 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwa msano kupagwa ŵaliji Shefatiya, mamagwe ŵaliji Abitala. Mwanace jwa msano ni jumo ŵaliji Itiliyamu, mamagwe ŵaliji Egila. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.3",
            "verseOrgIds": [
              "1CH.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace wosope msano ni jumo ŵapagwile ku Hebuloni pa ndaŵi jiŵalamulilaga Mwenye Daudi kweleko kwa yaka msano ni yiŵili, ni miesi msano ni umo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.5.4+2SA.5.5"
              },
              "items": [
                {
                  "text": "2 Sam 5:4-5",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1KI.2.11"
              },
              "items": [
                {
                  "text": "1 Ayi 2:11",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "1CH.29.27"
              },
              "items": [
                {
                  "text": "1 Mbi 29:27",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1CH 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ku Yelusalemuko ŵalamulileko yaka 33, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.4",
            "verseOrgIds": [
              "1CH.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "soni ŵanace ŵajinji ŵapagwile kukoko.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "2SA.11.3"
              },
              "items": [
                {
                  "text": "2 Sam 11:3",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1CH 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Betisheba ŵamkwawo Daudi ŵaŵelece ŵanace mcece mena gawo galiji Shimeya, Shobabu, Natani ni Solomoni. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.5",
            "verseOrgIds": [
              "1CH.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1CH 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakwete soni ŵanace ŵane msano ni mcece, mena gawo galiji Ibihali, Elishuwa, Elifeleti, Noga, Nefegi, Yafiya, Elishama, Eliyada ni Elifeleti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.6+1CH.3.7+1CH.3.8",
            "verseOrgIds": [
              "1CH.3.6",
              "1CH.3.7",
              "1CH.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kupwatika pa ŵanace ŵeleŵa, Daudi ŵakwete soni ŵanace ŵane ŵele ŵaŵaŵelecele mwa jwamasengo jwakwe. Ŵakwete mwanace jumo lina lyakwe lyaliji Tamala.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yisukulu ya Mwenye Solomoni",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1CH 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.9",
            "verseOrgIds": [
              "1CH.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1CH 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga ni mena ga yisukulu ya Mwenye Solomoni. Solomoni ŵaliji babagwe Lehobowamu. Lehobowamu ŵaliji babagwe Abiya, Abiya ŵaliji babagwe Asa, Asa ŵaliji babagwe Yehoshafati, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.10",
            "verseOrgIds": [
              "1CH.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1CH 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yehoshafati ŵaliji babagwe Yeholamu, Yeholamu ŵaliji babagwe Ahasiya, Ahasiya ŵaliji babagwe Yowashi, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.11",
            "verseOrgIds": [
              "1CH.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1CH 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yowashi ŵaliji babagwe Amasiya, Amasiya ŵaliji babagwe Asaliya, Asaliya ŵaliji babagwe Yotamu, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.12",
            "verseOrgIds": [
              "1CH.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1CH 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yotamu ŵaliji babagwe Ahasi, Ahasi ŵaliji babagwe Hesekiya, Hesekiya ŵaliji babagwe Manase, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.13",
            "verseOrgIds": [
              "1CH.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1CH 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Manase ŵaliji babagwe Amoni, Amoni ŵaliji babagwe Yosiya, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.14",
            "verseOrgIds": [
              "1CH.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1CH 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵa Yosiya ŵaliji Yohanani, Yehoiyakimu, Sedekiya, Shalumu ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.15",
            "verseOrgIds": [
              "1CH.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "nipo ŵanace ŵa Yehoiyakimu ŵaliji Yekoniya ni Sedekiya.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yisukulu ya Mwenye Yehoiyakini",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1CH 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.16",
            "verseOrgIds": [
              "1CH.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1CH 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga gali mena ga yisukulu ya Mwenye Yehoiyakini ŵaŵajigalidwe kwawula ku ukapolo ni ŵandu ŵa ku Babulo. Yehoiyakini ŵakwete ŵanace msano ni ŵaŵili, mena gawo galiji Sheyatiyele, ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.17",
            "verseOrgIds": [
              "1CH.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1CH 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malikilamu, Pedaya, Shenasala, Yekamiya, Hoshama ni Nedabiya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.18",
            "verseOrgIds": [
              "1CH.3.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1CH 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pedaya ŵakwete ŵanace ŵaŵili, mena gawo galiji Selubabele ni Shimeyi. Selubabele ŵakwete ŵanace ŵaŵili mena gawo galiji Meshulamu ni Hananiya, ŵakwete soni mwanace jwamkongwe lina lyakwe lyaliji Shelomiti. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.19",
            "verseOrgIds": [
              "1CH.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1CH 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakwete soni ŵanace ŵane msano, mena gawo Hashuba, Oheli, Belekiya, Hasadiya, ni Yusabu Hesedi. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.20",
            "verseOrgIds": [
              "1CH.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1CH 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hananiya ŵakwete ŵanace ŵaŵili, mena gawo galiji Pelatiya ni Yeshaya. Yesaya ŵaliji babagwe Lefayiya, Lefamiya ŵaliji babagwe Anani, Anani ŵaliji babagwe Obadiya, Obadiya ŵaliji babagwe Shekaniya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.21",
            "verseOrgIds": [
              "1CH.3.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1CH 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shekaniya ŵakwete mwanace jumo lina lyakwe lyaliji Shemaya. Ŵanace ŵacalume ŵa Shemaya ŵaliji Hatushi, Igali, Baliya, Neyaliya, ni Shafati. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.22",
            "verseOrgIds": [
              "1CH.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵa Neyaliya ŵaliji Eliyoyenayi, Hesekiya ni Asikilamu. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.23",
            "verseOrgIds": [
              "1CH.3.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1CH 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵanace ŵa Eliyoyenayi ŵaliji Hodafiya, Eliyashibu, Pelaya, Akubu, Yohanani, Delaya, ni Anani, wosope pamo ŵapali msano ni ŵaŵili.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.3.24",
            "verseOrgIds": [
              "1CH.3.24"
            ]
          }
        }
      ]
    }
