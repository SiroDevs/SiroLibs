              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ayi yili yisukulu ya Lubeni, mwanace jwandanda kupagwa jwa Yakobo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "text": " (Ligongo lyakuti ŵagonile nawo ŵakongwe ŵanondi ŵa baba ŵawo, ukulungwa wakwe wapelecedwe kwa Yosefe.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.5.1",
            "verseOrgIds": [
              "1CH.5.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
