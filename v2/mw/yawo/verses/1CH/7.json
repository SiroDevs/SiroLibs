              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwanace jwamkongwe jwa Efelemu ŵaliji Shela, jwele juŵataŵile msinda wa Beti Holoni kumkuli, ni msinda wa Useni Shela.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.24",
