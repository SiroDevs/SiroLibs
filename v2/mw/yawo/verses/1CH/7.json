            "number": "22",
            "style": "v",
            "sid": "1CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo Efelemu ŵalisile malilo ga ŵanace ŵawo kwa masiku gamajinji nipo acalongo acimjakwe ŵayice ku kwamyalasya. ",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.22",
            "verseOrgIds": [
              "1CH.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1CH 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaneko ŵamkwawo Efelemu ŵakwete cilu nipo ŵaŵelece mwanace jwamlume ni ŵampele lina lyakuti Beliya, ligongo lya yisawusyo pa liŵasa lyawo.",
          "type": "text",
          "attrs": {
            "verseId": "1CH.7.23",
            "verseOrgIds": [
              "1CH.7.23"
            ]
          }
        }
      ]
