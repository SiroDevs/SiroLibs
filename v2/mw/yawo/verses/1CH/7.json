              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Efelemu ŵakwete soni mwanace lina lyakwe Lefa, nipo yisukulu ya Efelemu yaliji Lesefe, Tela, Tahani, ",
          "type": "text",
          "attrs": {
