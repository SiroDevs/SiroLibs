              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ndaŵi jelejo, napopesile mwakwadandawulila AMBUJE, natite kuti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.3.23",
            "verseOrgIds": [
              "DEU.3.23"
