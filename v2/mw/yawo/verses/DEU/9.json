          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE piŵamtumile jemanja kutyocela ku Kadeshi Baneya kuti mkajinjile mcilambo ciŵaliji mkucipeleka kwa jemanja. Mwagakanile Malamusi ga AMBUJE Mlungu jwenu, soni nginimwakulupilila ni kwapikanila.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.9.23",
            "verseOrgIds": [
              "DEU.9.23"
            ]
          }
        },
