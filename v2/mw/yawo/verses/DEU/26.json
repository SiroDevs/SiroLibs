              "items": [
                {
                  "text": "1 Pet 2:9",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.18",
            "verseOrgIds": [
              "DEU.26.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 26:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tacimkusya jemanja kwapunda ŵandu ŵa ngosyo sine ŵaŵapanganyisye, ni timcililumba ni kulicimbicisya lina lyawo. Timciŵa ŵandu ŵa AMBUJE, mpela muŵatendele cilanga.”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.26.19",
            "verseOrgIds": [
              "DEU.26.19"
            ]
          }
        }
      ]
    }
