              "type": "text"
            }
          ]
        },
        {
          "text": "“Kaneko AMBUJE ŵasalile uneji ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti mŵele mli mgamba kwendajenda akunakuku, kusyungulila cilambo ca matumbi kwa ndaŵi jajilewu, sambano galawukani ni kujigala litala lyakwinjilila mbali ja kumpoto. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasalile kuti namsalile soni jemanja kuti, ‘Msigele panandi kwinjila cilambo ca matumbi ga Edomu, cilambo cakutama acalongo acimjenu, yisukulu ya Esawu. Jemanjajo pitakamwone jemanja takamjogope,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "GEN.36.8"
              },
              "items": [
                {
                  "text": "Gen 36:8",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "conde, mkaja kwatanda, ligongo une nganja kucipeleka cilambo cawoco kwa jemanja. Nacipelece cilambo ca matumbi ga Edomu, mbali ja Seyili, kwa yisukulu ya Esawu. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yakulya ni mesi gakumwa mkatende ga kusuma ni mbiya kwa jemanjajo.’",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        }
      ]
    },
    {
