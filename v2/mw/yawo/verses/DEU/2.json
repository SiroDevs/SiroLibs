          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Twajombwece Lusulo lwa Seledi mpela muŵatusalilile AMBUJE. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.13",
            "verseOrgIds": [
              "DEU.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi jitwajombokaga Lusulo lwa Seledi, paliji papite yaka 38, kutandila ndaŵi jitwatemi ku Kadeshi Baneya kula. Jele ndaŵijo, acalume wosope ŵiŵaputaga ngondo ŵaliji ali amasile kuwa, mpela muŵaŵecetele AMBUJE.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
