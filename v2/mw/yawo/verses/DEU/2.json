                "loc": "NUM.14.28+NUM.14.29+NUM.14.30+NUM.14.31+NUM.14.32+NUM.14.33+NUM.14.34+NUM.14.35"
              },
              "items": [
                {
                  "text": "Num 14:28-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵajonasile acalume ŵakuputa ngondo ŵala mpakana wosope ŵamasile kuwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        }
      ]
