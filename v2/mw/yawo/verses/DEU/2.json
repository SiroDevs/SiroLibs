          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Ali amasile kuwa, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.16",
            "verseOrgIds": [
              "DEU.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE ŵasalile uneji kuti, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.17",
            "verseOrgIds": [
              "DEU.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "‘Timjinjile mcilambo ca Mowabu lelo, pakupitila litala lya ku Ali. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.18",
            "verseOrgIds": [
              "DEU.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo patimkayice mungulugulu cilambo ca Aamoni, mkaja kuyisawusya yisukulu ya Loti, kapena kumenyana nawo ngondo. Pakuŵa cilamboco nacipelece kala kwa yisukulu ya Loti, kuti ciŵe cawo.’ ”",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
