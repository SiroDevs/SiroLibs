                "loc": "NUM.35.30"
              },
              "items": [
                {
                  "text": "Num 35:30",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.17.6"
              },
              "items": [
                {
                  "text": "Det 17:6",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "MAT.18.16"
              },
              "items": [
                {
                  "text": "Mat 18:16",
                  "type": "text"
                }
              ]
            },
            {
