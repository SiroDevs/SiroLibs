            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.21",
            "verseOrgIds": [
              "DEU.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mpikanileje mwakulupicika malamusi gosope ginamsalile. Mwanonyeleje AMBUJE Mlungu jwenu, ni kuyitenda yosope yakumlamula, soni mŵe ŵakulupicika kwa jwalakwe. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.22",
            "verseOrgIds": [
              "DEU.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano jemanja, patimkajinjileje ku cilamboco, AMBUJE takasitoposye ngosyo sine sya ŵandu syasili kweleko, soni timkasumule yilambo ya ŵandu ŵakupikanika ni ŵamacili kumpunda jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.23",
            "verseOrgIds": [
              "DEU.11.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 11:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo galigose gatimkaliŵate tigakaŵe genu. Malile ga cilambo cenuco tigakatandile ku mcipululu gali kum'mwela, mpakana kumpoto kwa matumbi ga Lebanoni, soni kumbali ja kungopoko lyuŵa kutandila ku Lusulo lwa Yufuleti mpaka ku Nyasa ja Mediteleniyani, jajili kungapilo lyuŵa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.1.3+JOS.1.4+JOS.1.5"
              },
              "items": [
                {
                  "text": "Yos 1:3-5",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.24",
            "verseOrgIds": [
              "DEU.11.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Malo galigose gatimkaliŵate m'cele cilamboco, AMBUJE Mlungu jwenu takatesye ŵandu kuti akamjogopeje jemanja, mpela mwele muŵatendele jwalakwejo cilanga",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "text": " ni jemanja, soni pangali mundu jutakamlekasye kutama mcilambomo.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 11:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.25",
            "verseOrgIds": [
              "DEU.11.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 11:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Lelo tinamsalile yindu yiŵili yakuti msagule, upile kapena malweso. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.26",
            "verseOrgIds": [
              "DEU.11.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 11:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Upile tiwuŵe pa jemanja, naga mkugapikanila Malamusi ga AMBUJE Mlungu jwenu, gele gangumpa lelo jinoga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.27",
            "verseOrgIds": [
              "DEU.11.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 11:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo malweso tigaŵe kwa jemanja, naga ngamkugapikanila malamusi gelega, soni naga mkulileka litala lingumlamula lelo jinoli, ni kugalawucila kwa milungu jine ni kujilambila, milungu jele jimkanimjilambileje citandilile kalakala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.28",
            "verseOrgIds": [
              "DEU.11.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 11:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "AMBUJE Mlungu jwenu pitakamjinjisye mcilambo cimkwawula kuja kutamaco, mkalalicile ya upile welewu mli mkwesile Petumbi lya Gelisimu, nambo mkalalicile malweso gelega mli mkwesile Petumbi lya Eba.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "DEU.27.11+DEU.27.12+DEU.27.13+DEU.27.14"
              },
              "items": [
                {
                  "text": "Det 27:11-14",
                  "type": "text"
                }
              ]
            },
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "JOS.8.33+JOS.8.34+JOS.8.35"
              },
              "items": [
                {
                  "text": "Yos 8:33-35",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.29",
            "verseOrgIds": [
              "DEU.11.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 11:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Matumbi gaŵili gelega gali cakungapilo lyuŵa kwa Lusulo lwa Yolodani, mcilambo ca Akenani ŵandu ŵele ŵakutama m'Ciŵata ca Yolodani, mwakuŵandikana ni yitela ya mtundu, ya ku Mole. Soni mwakuŵandikana ni msinda wa Giligala. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.30",
            "verseOrgIds": [
              "DEU.11.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 11:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Msigele pananditu komboka Lusulo lwa Yolodani, ni kuja kutama mcilambo cele cakumpa AMBUJE Mlungu jwenu. Patimkacipocele cele cilamboco ni kuja kutamilicika, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.31",
            "verseOrgIds": [
              "DEU.11.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 11:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "conde, mkalolecesye kuti mkugapikanila malamusi gosope gangumpa jemanja lelo jinoga.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.11.32",
            "verseOrgIds": [
              "DEU.11.32"
            ]
          }
        }
      ]
