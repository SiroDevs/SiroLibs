              "type": "text"
            }
          ]
        },
        {
          "text": "Mwapikanileje AMBUJE Mlungu jwenu, soni mwalambileje womwanja pewo jika. Mŵeje ŵakulupicika kwa womwanjawo jika, ni mŵiceje cilanga mu lina lyawope. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mwalumbeje AMBUJEWO pakuŵa ali Mlungu jwenu, ligongo mlolite ni meso genu yindu yayikulungwa ni yakogoya yamtendele. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
