              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.43",
            "verseOrgIds": [
              "DEU.32.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        },
        {
          "text": " ni Yoswa mwanace jwa Nuni, ŵagasasile pamtima maloŵe gosope ga nyimbo jeleji, Aisalaeli ŵaliji mkugapikana.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Maloŵe gambesi ga Mose",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "DEU 32:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.44",
            "verseOrgIds": [
              "DEU.32.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "DEU 32:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mose ali amasile kwajiganya ŵandu maloŵe ga nyimbo gosopega, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.45",
            "verseOrgIds": [
              "DEU.32.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "DEU 32:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵasalile soni kuti, “Mgakumbucileje cenene malamusi gele ginampele lelo jinoga. Mwasalile ŵanace ŵenu kuti agapikanileje mwakulupicika maloŵe gosope ga malamusiga. ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.46",
            "verseOrgIds": [
              "DEU.32.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "DEU 32:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maloŵega nganigaŵa maloŵe gangali mate. Nambo maloŵe gelega ni gali umi wenu. Mkagapikanileje malamusi gelega kuti mkatamilicice mcilambo cimkuja kutama pesi pa Yolodani.” ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.47",
            "verseOrgIds": [
              "DEU.32.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "DEU 32:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lisiku lilyolyo, AMBUJE ŵaŵecete ni Mose kuti,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.32.48",
            "verseOrgIds": [
              "DEU.32.48"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
