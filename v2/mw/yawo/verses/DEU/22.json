              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Nambo naga yasasile jwamlumejo yili yakuwona soni umboni wakulosya kuti jwamkongwejo ŵaliji mwali jwamkinam'manya jwamlume, ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.20",
            "verseOrgIds": [
              "DEU.22.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 22:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndaŵi jijojo ŵandu ŵa mu msindawo amjigale jwamkongwejo mpaka pa mlango wa nyumba ja babagwe ni amwulaje pakumsoma ni maganga. Ligongo mwalijo atesile cindu cakutesya soni pasikati pa mtundu wetu wa Isalaeli, pakutenda cikululu mkinalombedwe, ali ciŵela kutama m'nyumba ja babagwe. Naga mkutenda myoyo, timcityosya cakusakala ca mtundu welewo pasikati penu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.22.21",
            "verseOrgIds": [
              "DEU.22.21"
            ]
          }
        }
