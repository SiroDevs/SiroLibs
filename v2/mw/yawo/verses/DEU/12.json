        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.31",
            "verseOrgIds": [
              "DEU.12.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 12:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "“Mlolecesye kuti mkutenda yosope yene yinamlamwileyi. Mkajonjecesya kandu kane kapena kutyosya kandu kane.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.12.32",
