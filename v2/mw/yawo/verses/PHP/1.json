      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cikalataci cikutyocela kwa une Paulo ni Timoteo, ŵatuli ŵakutumicila ŵa Yesu",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "text": " Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.16.12"
              },
              "items": [
                {
                  "text": "Mase 16:12",
                  "type": "text"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tukulembela cikalataci kwa ŵandu wosope ŵa mu msinda wa Filipi",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "text": " ŵali mu umpepe ni Klistu Yesu nambo soni kwa acimlongola sikati ja acakulungwa ŵa mpingo",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "text": " ni ŵakwakamusya.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PHP 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.1",
            "verseOrgIds": [
              "PHP.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umbone mtima ni mtendele yakutyocela kwa Mlungu Atati ŵetu ni kwa Ambuje Yesu Klistu yiŵe ni jemanja.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Paulo akuwupopelela mpingo wa ku Filipi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PHP 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.2",
            "verseOrgIds": [
              "PHP.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PHP 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngusinamtogolela Mlungu jwangu ndaŵi syosope pingusakumbucila ya jemanja. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.3",
            "verseOrgIds": [
              "PHP.1.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PHP 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pingusinampopelela jemanja ndaŵi syosope, ngusimbopela mwa lukondwa ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.4",
            "verseOrgIds": [
              "PHP.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PHP 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo lya mwele mumŵele mli kungamucisya une pa masengo gakulalicila Ngani Syambone,",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
            ]
          }
        },
        {
          "text": " kutyocela lisiku limwatandite kulupilila mpaka sambano jino. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.5",
            "verseOrgIds": [
              "PHP.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PHP 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngusimicisya soni kuti Mlungu, juŵatandite kutenda yindu yambone mwa jemanja, tapitilisye kukamula masengo gambone mwa jemanja mpaka ali agamalisisye pa Lisiku litaciwuja Yesu Klistu. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.6",
            "verseOrgIds": [
              "PHP.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PHP 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndaŵi syosope ngusaganisya mwa lukondwa ya jemanja, pakuti ngusamnonyela jemanja. Pakuti jemanja wosope mkungamucisya une, pa ndaŵi jindili mu ukayidi muno nambo soni pingukamula masengo giŵambele Mlungu gakuwucenjela kuti Ngani Syambone sili syakuwona ni kwatendekasya ŵandu kuti akulupilile mwakulimbangana pa Ngani Syambone. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.7",
            "verseOrgIds": [
              "PHP.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mlungu ali mboni jangu kuti ngusinamsacilila mnope jemanja, pakuti ngusinamnonyela ni mtima wangu wosope, pakusyasya cinonyelo ciŵalosisye Klistu Yesu msyene.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PHP 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.8",
            "verseOrgIds": [
              "PHP.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PHP 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lipopelo lyangu lili lyakuti mnonyelaneje mnope jwine ni mjakwe, soni kuti mpakombole kumanyilila ayo yayili yakuwona ni kulamula mwakwenela, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.9",
            "verseOrgIds": [
              "PHP.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PHP 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "kuti pakutenda myoyo timpakombole kusagula ayo yayili yambone mnope. Pa Lisiku lyakwika kwa Klistu timcisimanikwa mli ŵaswela mtima, nambo soni ŵangali cileŵi cilicose. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.10",
            "verseOrgIds": [
              "PHP.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Umi wenu tiwuciŵa uli ugumbele ni yisogosi yakulungama yele timciyilosya mwakamucisidwa ni Yesu Klistu, kuti ŵandu wosope acimbicisye ni kumlumba Mlungu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kwa une, umi nijo Klistu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PHP 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.11",
            "verseOrgIds": [
              "PHP.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PHP 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ŵakulupilila acimjangu, ngusaka m'manyilile kuti yindu yiyindendekwele une yingamucisye kusyesyene pakwatendekasya ŵandu kuti akulupilile Ngani Syambone. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.12",
            "verseOrgIds": [
              "PHP.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PHP 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asilikali wosope ŵiŵaliji mkulondela nyumba ja mwenye, ni ŵane wosope akuno, akumanyilila kuti une ndili mu ukayidi ligongo lyakuti ngusinamtumicila Klistu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "note",
          "type": "tag",
          "attrs": {
            "style": "x",
            "caller": "#"
          },
          "items": [
            {
              "name": "ref",
              "type": "tag",
              "attrs": {
                "loc": "ACT.28.30"
              },
              "items": [
                {
                  "text": "Mase 28:30",
                  "type": "text"
                }
              ]
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.13",
            "verseOrgIds": [
              "PHP.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pa ligongo lyakuti ndili mu ukayidi, ŵakulupilila ŵajinji akulimba mtima mwa Ambuje, nipo akulalicila maloŵe ga Mlungu mwangali woga.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "PHP 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.14",
            "verseOrgIds": [
              "PHP.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "PHP 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yili yakuwona kuti apali ŵane ŵakusalalicila ya Klistu ligongo lya wiwu ni kunonyela ukangani. Nambo apali soni ŵane ŵakusalalicila ni mtima wakuwona. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.15",
            "verseOrgIds": [
              "PHP.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "PHP 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanjaji akusalalicila ligongo lya cinonyelo, pakuti akusamanyilila kuti Mlungu ambele une masengo gakucinjilicisya Ngani Syambone. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.16",
            "verseOrgIds": [
              "PHP.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo ŵandanda ŵala ŵangalalicila Klistu ni mtima wakuwona usyesyene. Akusagamba kulinonyela acimsyene, nambo soni akusagamba kusaka kunjonjecesya yipwetesi pa ndaŵi jindili mu ukayidi muno.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "PHP 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.17",
            "verseOrgIds": [
              "PHP.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "PHP 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana yana kandu mpela? Kanga akusalalicila mwa unami kanga mwakuwona, cekulungwa cili cakuti Klistu akulalicidwa pelepo, myoyo une tinjipitilisya kusengwa mnope, ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.18",
            "verseOrgIds": [
              "PHP.1.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "PHP 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "ligongo ngumanyilila kuti kupitila mu mapopelo genu ni cikamucisyo cakutyocela kwa Msimu wa Yesu Klistu une tinjigopoledwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.19",
            "verseOrgIds": [
              "PHP.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "PHP 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Myoyo ngwembecela ni kulupilila ni mtima wangu wosope kuti tikuciŵa kwangali soni. Nambope ngwembecela kuti tinjilimba mtima kuŵeceta kuti sambano jino mpela ndaŵi syosope Klistu acimbicikwe kupitila mwa uweji, kanga timbe cijumi kapena iyayi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.20",
            "verseOrgIds": [
              "PHP.1.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "PHP 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kwa une umi nijo Klistu, ni kuwa kuli kupindula. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.21",
            "verseOrgIds": [
              "PHP.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "PHP 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo naga pakupitilisya kutama cijumi mcilu acino ngukomboleka kupitilisya kwawusya msogolo masengo, myoyo ngangumanyilila citisagule sikati ja kupitilisya kutama cijumi kapena kuwa. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.22",
            "verseOrgIds": [
              "PHP.1.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "PHP 1:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Une singalilwe. Ngusacilisya kuti mbwe ni kuja kutama ni Klistu, pakuti yeleyi ni yayili yambone kwa une. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.23",
            "verseOrgIds": [
              "PHP.1.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "PHP 1:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nambo kwa ligongo lya jemanja, ngwenela kuti mbe cijumi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.24",
            "verseOrgIds": [
              "PHP.1.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "PHP 1:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngumanyilila kuti tinjiŵa cijumi. Tinjipitilisya kutama ni jemanja wosope ni kumkamusya kuti cikulupi cenu cikuleje, nambo soni kuti cimpe lukondwa kupunda pandanda. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.25",
            "verseOrgIds": [
              "PHP.1.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pitinjiyika kumangwenuko, timkole magongo gejinji gakulikwesya ligongo lya une kupitila mukulumbikana kwenu ni Klistu Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "PHP 1:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": " ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.26",
            "verseOrgIds": [
              "PHP.1.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "PHP 1:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sambano cakusosekwa mnope cili cakuti ndamo syenu siŵe syambone mpela musikuŵecetela Ngani Syambone syakwamba Klistu. Naga ndili jwakupakombola kwika kukumlola, yili yambone nditu, nambo soni atamose naga ngulepela kwika kukumlola jemanja, nambo ngusaka mbikaneje kuti jemanja mkulimbicila ni mtima umpepe. Ngusaka kupikana soni kuti mwakupikanganana ni mwakamucisyana kuputa ngondo ligongo lyakulupilila Ngani Syambone. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.27",
            "verseOrgIds": [
              "PHP.1.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "PHP 1:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkajogopa amagongo ŵenu; mŵeje ŵakulimba mtima ndaŵi syosope, yeleyi tiyicilosya kwa jemanjajo kuti tacilepela nipo jemanja timcipunda, ligongo lyakuti Ambuje ni ŵitacimtendela yeleyi. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.28",
            "verseOrgIds": [
              "PHP.1.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "PHP 1:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Paja jwalakwejo ŵampele jemanja upile wakuti mumtumicileje Klistu, ngaŵaga pagamba kulupililape mwa jwalakwejo, nambo soni pakupikana yakupweteka pamo ni jwalakwejo. ",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.29",
            "verseOrgIds": [
              "PHP.1.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "PHP 1:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jemanja soni mkuputa ngondo jilajila jimwambweni ndili mkuputa jila, sambano jino nguputa ngondo jilajila mpela mumkupikanilamu.",
          "type": "text",
          "attrs": {
            "verseId": "PHP.1.30",
            "verseOrgIds": [
              "PHP.1.30"
            ]
          }
        },
