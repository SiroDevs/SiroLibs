          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishaya ya ɗaga murya game da Isra'ila ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:27"
      },
      "items": [
        {
          "text": "\"Ko da yake yawan Isra'ilawa yana kama da yashi a bakin teku,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        }
      ]
