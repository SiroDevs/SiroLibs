      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:27"
      },
      "items": [
        {
          "text": "ragowa ce kaɗai za su sami ceto.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.27",
            "verseOrgIds": [
              "ROM.9.27"
            ]
          }
        }
      ]
    },
    {
