      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:28"
      },
      "items": [
        {
          "text": "hukuncinsa a bisan duniya da sauri kuma ba da ɓata lokaci ba.\"",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.28",
            "verseOrgIds": [
              "ROM.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ROM 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yana nan kamar yadda Ishaya ya riga ya faɗa.",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ROM 9:29"
      },
      "items": [
        {
          "text": "\"Da ba don Ubangiji Maɗaukaki",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ROM 9:29"
      },
      "items": [
        {
          "text": "ya bar mana zuriya ba,",
          "type": "text",
          "attrs": {
            "verseId": "ROM.9.29",
            "verseOrgIds": [
              "ROM.9.29"
            ]
          }
        }
      ]
    },
    {
