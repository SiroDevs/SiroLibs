  "verseCount": 36,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "MAT 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "An yanke kan Yohanna Mai Baftisma",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.6.14-MRK.6.29"
          },
          "items": [
            {
              "text": "Markus 6.14-29",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.7-LUK.9.9"
          },
          "items": [
            {
              "text": "Luka 9.7-9",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MAT 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "A lokacin nan sarki Hiridus ya ji labarin Yesu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.1",
            "verseOrgIds": [
              "MAT.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MAT 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "sai ya ce wa fadawansa, \"Wannan Yohanna Mai Baftisma ne; ya tashi daga matattu! Shi ya sa abubuwan banmamakin nan suke faruwa ta wurinsa.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.2",
            "verseOrgIds": [
              "MAT.14.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MAT 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "To, dā Hiridus ya kama Yohanna ya daure, ya kuma sa shi cikin kurkuku saboda Hiridiyas, matar ɗan'uwansa Filibus,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.3",
            "verseOrgIds": [
              "MAT.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MAT 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "gama Yohanna ya dinga ce masa, \"Ba daidai ba ne ka aure ta.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.4",
            "verseOrgIds": [
              "MAT.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MAT 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hiridus ya so yă kashe Yohanna, amma yana jin tsoron mutane, don sun ɗauka shi annabi ne.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.5",
            "verseOrgIds": [
              "MAT.14.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MAT 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A bikin tuna da ranar haihuwar Hiridus, diyar Hiridiyas ta yi musu rawa ta kuma gamsar da Hiridus ƙwarai,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.6",
            "verseOrgIds": [
              "MAT.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MAT 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "har ya yi alkawari da rantsuwa cewa zai ba ta duk abin da ta roƙa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.7",
            "verseOrgIds": [
              "MAT.14.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MAT 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da mahaifiyarta ta zuga ta, sai ta ce, \"Ba ni a cikin kwanon nan, kan Yohanna Mai Baftisma.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.8",
            "verseOrgIds": [
              "MAT.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MAT 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sarki ya yi baƙin ciki, amma saboda rantsuwarsa da kuma baƙinsa, sai ya ba da umarni a ba ta abin da ta roƙa",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.9",
            "verseOrgIds": [
              "MAT.14.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MAT 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya kuma sa aka yanke kan Yohanna a kurkuku.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.10",
            "verseOrgIds": [
              "MAT.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MAT 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aka kawo kansa cikin kwano aka ba yarinyar, ita kuma ta kai wa mahaifiyarta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.11",
            "verseOrgIds": [
              "MAT.14.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MAT 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Almajiran Yohanna suka zo suka ɗauki gawarsa suka binne. Sa'an nan suka je suka gaya wa Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.12",
            "verseOrgIds": [
              "MAT.14.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ya ciyar da dubu biyar",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.6.30-MRK.6.44"
          },
          "items": [
            {
              "text": "Markus 6.30-44",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "LUK.9.10-LUK.9.17"
          },
          "items": [
            {
              "text": "Luka 9.10-17",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JHN.6.1-JHN.6.14"
          },
          "items": [
            {
              "text": "Yohanna 6.1-14",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MAT 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'ad da Yesu ya ji abin da ya faru, sai ya shiga jirgin ruwa ya janye shi kaɗai zuwa wani wuri inda ba kowa. Da jin haka, taron mutane suka bi shi da ƙafa daga garuruwa.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.13",
            "verseOrgIds": [
              "MAT.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MAT 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da Yesu ya sauka ya kuma ga taro mai yawa, sai ya ji tausayinsu ya kuma warkar da marasa lafiyarsu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.14",
            "verseOrgIds": [
              "MAT.14.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MAT 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da yamma ta yi, sai almajiransa suka zo wurinsa suka ce, \"Wurin nan fa ba kowa, ga shi kuma rana ta kusa fāɗuwa. Ka sallami taron don su shiga ƙauyuka su nemi wa kansu abinci.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.15",
            "verseOrgIds": [
              "MAT.14.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MAT 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ya amsa,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.16",
            "verseOrgIds": [
              "MAT.14.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ba su bukata su tafi. Ku ku ba su wani abu su ci.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.16",
                "verseOrgIds": [
                  "MAT.14.16"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MAT 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suka ce, \"Burodi biyar da kifi biyu ne kawai muke da su a nan.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.17",
            "verseOrgIds": [
              "MAT.14.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MAT 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku kawo mini su a nan.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.18",
                "verseOrgIds": [
                  "MAT.14.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.18",
            "verseOrgIds": [
              "MAT.14.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "MAT 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai ya umarci mutanen su zazzauna a kan ciyawa. Da ya ɗauki burodi biyar da kifin biyun nan ya dubi sama, ya yi godiya ya kuma kakkarya burodin. Sa'an nan ya ba wa almajiransa, almajiran kuwa suka ba wa mutane.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.19",
            "verseOrgIds": [
              "MAT.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "MAT 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Duk suka ci suka ƙoshi, almajiran kuwa suka kwashe ragowar gutsattsarin cike da kwanduna goma sha biyu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.20",
            "verseOrgIds": [
              "MAT.14.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "MAT 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yawan waɗanda suka ci, sun yi wajen maza dubu biyar, ban da mata da yara.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.21",
            "verseOrgIds": [
              "MAT.14.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Yesu ya yi tafiya a kan ruwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.6.45-MRK.6.52"
          },
          "items": [
            {
              "text": "Markus 6.45-52",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "JHN.6.15-JHN.6.21"
          },
          "items": [
            {
              "text": "Yohanna 6.15-21",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "MAT 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nan da nan Yesu ya sa almajiran su shiga jirgin ruwa su sha gabansa, su haye zuwa ɗayan hayin, yayinda shi kuma yă sallami taron.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.22",
            "verseOrgIds": [
              "MAT.14.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Bayan ya sallame su, sai ya haura bisan gefen dutse shi kaɗai don yă yi addu'a. Da yamma ta yi, yana can shi kaɗai,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.23",
            "verseOrgIds": [
              "MAT.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "jirgin ruwan kuwa ya riga ya yi nesa da gaci, yana fama da raƙuman ruwa domin iska tana gāba da shi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.24",
            "verseOrgIds": [
              "MAT.14.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Wajen tsaro na huɗu na dare, sai Yesu ya nufe su, yana takawa a kan tafkin.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.25",
            "verseOrgIds": [
              "MAT.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "MAT 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sa'ad da almajiran suka gan shi yana takawa a kan tafkin, sai tsoro ya kama su. Suka yi ihu don tsoro suka ce, \"Fatalwa ce.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.26",
            "verseOrgIds": [
              "MAT.14.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "MAT 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma nan da nan Yesu ya ce musu,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.27",
            "verseOrgIds": [
              "MAT.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku yi ƙarfin hali! Ni ne. Kada ku ji tsoro.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.27",
                "verseOrgIds": [
                  "MAT.14.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "MAT 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai Bitrus ya amsa ya ce, \"Ubangiji in kai ne ka ce mini in zo wurinka a kan ruwan.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.28",
            "verseOrgIds": [
              "MAT.14.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "MAT 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Zo.\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.29",
                "verseOrgIds": [
                  "MAT.14.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "MAT 14:29"
      },
      "items": [
        {
          "text": "Sai Bitrus ya fita daga jirgin ruwan, ya taka a kan ruwan ya nufe wajen Yesu.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.29",
            "verseOrgIds": [
              "MAT.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "MAT 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amma da ya ga haukar iskar, sai ya ji tsoro, ya kuma fara nutsewa, sai ya yi ihu ya ce, \"Ubangiji, ka cece ni!\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.30",
            "verseOrgIds": [
              "MAT.14.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "MAT 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nan da nan Yesu ya miƙa hannu ya kamo shi ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.31",
            "verseOrgIds": [
              "MAT.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Kai mai ƙarancin bangaskiya, don me ka yi shakka?\"",
              "type": "text",
              "attrs": {
                "verseId": "MAT.14.31",
                "verseOrgIds": [
                  "MAT.14.31"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "MAT 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da suka hau jirgin ruwan, sai iskar ta kwanta.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.32",
            "verseOrgIds": [
              "MAT.14.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "MAT 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waɗanda suke cikin jirgin ruwan kuwa suka yi masa sujada, suna cewa, \"Gaskiya kai Ɗan Allah ne.\"",
          "type": "text",
          "attrs": {
            "verseId": "MAT.14.33",
            "verseOrgIds": [
              "MAT.14.33"
            ]
          }
        }
      ]
    },
