          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "suka kuwa roƙe shi yă bar marasa lafiya su taɓa ko da gefen rigarsa kawai, duk waɗanda suka taɓa shi kuwa suka warke.",
          "type": "text",
          "attrs": {
