    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "MAT 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yesu ya zazzaga dukan Galili, yana koyarwa a cikin majami'unsu, yana wa'azin labari mai daɗi na mulkin sama, yana kuma warkar da kowace cuta da rashin lafiyar mutane.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.23",
            "verseOrgIds": [
              "MAT.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "MAT 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Labarinsa ya bazu ko'ina a Suriya, mutane kuwa suka kawo masa dukan waɗanda suke fama da cututtuka iri-iri, da waɗanda suke da zafin ciwo, da masu aljanu, da waɗanda suke masu farfaɗiya, da shanyayyu, ya kuwa warkar da su.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.24",
            "verseOrgIds": [
              "MAT.4.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "MAT 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Taron mutane mai yawa daga Galili, Dekafolis,",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        },
        {
          "text": "Urushalima, Yahudiya da kuma yankin hayin Urdun suka bi shi.",
          "type": "text",
          "attrs": {
            "verseId": "MAT.4.25",
            "verseOrgIds": [
              "MAT.4.25"
            ]
          }
        }
      ]
    }
