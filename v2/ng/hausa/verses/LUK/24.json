              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Yana cikin sa musu albarka, sai ya rabu da su. Aka ɗauke shi zuwa cikin sama.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.51",
