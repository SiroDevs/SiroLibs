              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai suka yi masa sujada, suka koma Urushalima cike da murna sosai.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.24.52",
            "verseOrgIds": [
