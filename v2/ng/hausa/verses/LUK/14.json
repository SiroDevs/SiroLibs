          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "In ba zai iya ba, to, tun suna nesa, zai aika da wakilai, su je neman sharuɗan salama.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.32",
                "verseOrgIds": [
