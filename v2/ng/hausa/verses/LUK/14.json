        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ko kuma, wane sarki ne, in zai je yaƙi da wani sarki, ai, yakan fara zama ne, ya duba ya ga, ko da mutane dubu goma, shi zai iya ƙarawa da mai zuwa da dubu ashirin?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.31",
                "verseOrgIds": [
                  "LUK.14.31"
                ]
              }
            }
