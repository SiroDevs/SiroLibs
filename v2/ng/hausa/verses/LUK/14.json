        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "yana cewa, 'Wannan mutum ya fara gini, amma bai iya gamawa ba.'",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.30",
                "verseOrgIds": [
                  "LUK.14.30"
                ]
