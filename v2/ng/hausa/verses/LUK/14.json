              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Haka nan fa, kowane ne a cikinku, da ba ya rabu da abin da yake da shi ba, ba zai iya zama almajirina ba.",
              "type": "text",
              "attrs": {
