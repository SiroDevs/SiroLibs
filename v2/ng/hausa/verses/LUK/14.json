          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ba shi da wani amfani, ko ga ƙasa, ko ga juji, sai dai a zubar da shi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.35",
                "verseOrgIds": [
