        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ina gaya muku, babu ko ɗaya daga cikin mutanen nan da aka gayyata da zai ɗanɗana bikina.\"",
