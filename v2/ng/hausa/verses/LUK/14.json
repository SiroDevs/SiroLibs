        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gishiri fa yana da kyau, amma in gishiri ya rabu da daɗin ɗanɗanonsa, ta yaya za a sāke mai da daɗin ɗanɗanonsa?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.14.34",
