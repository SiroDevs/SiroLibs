      },
      "items": [
        {
          "text": "21",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Bayarwar gwauruwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.12.41-MRK.12.44"
          },
          "items": [
            {
              "text": "Markus 12.41-44",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 21:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Da Yesu ya ɗaga ido, sai ya ga waɗansu masu arziki suna sa baikonsu a ma'ajin haikalin.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.1",
            "verseOrgIds": [
              "LUK.21.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 21:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya kuma ga wata gwauruwa matalauciya, ta saka anini biyu.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.2",
            "verseOrgIds": [
              "LUK.21.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 21:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gaskiya ina faɗa muku, wacce nan gwauruwa matalauciya ta sa fiye da dukan sauran.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.3",
                "verseOrgIds": [
                  "LUK.21.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.3",
            "verseOrgIds": [
              "LUK.21.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 21:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Dukan mutanen nan sun ba da baikonsu daga cikin arzikinsu ne, amma ita daga cikin talaucinta, ta saka duk abin da take da shi na rayuwa.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.4",
                "verseOrgIds": [
                  "LUK.21.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Alamun ƙarshen zamani",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.24.1"
          },
          "items": [
            {
              "text": "Mattiyu 24.1",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.24.2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.13.1"
          },
          "items": [
            {
              "text": "Markus 13.1",
              "type": "text"
            }
          ]
        },
        {
          "text": ",",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.13.2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 21:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Waɗansu daga cikin almajiransa, suka fara magana a kan yadda aka yi wa haikalin ado da duwatsu masu kyau, da kuma kyautai da aka keɓe wa Allah. Amma Yesu ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.5",
            "verseOrgIds": [
              "LUK.21.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 21:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Wannan abin da kuke kallo a nan, lokaci yana zuwa da ba za a bar wani dutse a kan wani dutse ba. Kowannensu, za a rushe shi.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.6",
                "verseOrgIds": [
                  "LUK.21.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.24.3-MAT.24.14"
          },
          "items": [
            {
              "text": "Mattiyu 24.3-14",
              "type": "text"
            }
          ]
        },
        {
          "text": ";",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MRK.13.3-MRK.13.13"
          },
          "items": [
            {
              "text": "Markus 13.3-13",
              "type": "text"
            }
          ]
        },
        {
          "text": ")",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 21:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Suka tambaye shi suka ce, \"Malam, yaushe waɗannan za su faru? Kuma wace alama za tă nuna cewa suna dab da faruwa?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.7",
            "verseOrgIds": [
              "LUK.21.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 21:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya amsa ya ce,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ku lura, kada ku kuma a ruɗe ku. Gama da yawa za su zo a cikin sunana, suna cewa, 'Ai, ni ne shi,' da kuma, 'Lokaci ya yi kusa.' Kada ku bi su.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.8",
                "verseOrgIds": [
                  "LUK.21.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.8",
            "verseOrgIds": [
              "LUK.21.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 21:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Sa'ad da kuka ji labarin yaƙe-yaƙe, da juye juyen mulki, kada ku tsorota. Dole ne waɗannan abubuwa su fara faruwa, amma ƙarshen ba zai zo nan da nan ba.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.9",
                "verseOrgIds": [
                  "LUK.21.9"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 21:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai ya ce musu,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Al'umma za tă tasar wa al'umma, mulki zai tasar wa mulki.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.10",
                "verseOrgIds": [
                  "LUK.21.10"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.10",
            "verseOrgIds": [
              "LUK.21.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 21:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Za a yi manyan girgizar ƙasa, da yunwa, da annoba a wurare dabam-dabam, da kuma abubuwa masu bantsoro, da manyan alamu daga sama.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.11",
                "verseOrgIds": [
                  "LUK.21.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 21:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Amma kafin duk abubuwa nan, za a kama ku a tsananta muku. Za a kai ku majami'u, da kurkuku. Za a kuma kai ku gaban sarakuna da gwamnoni, kuma dukan waɗannan saboda sunana.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.12",
                "verseOrgIds": [
                  "LUK.21.12"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.12",
            "verseOrgIds": [
              "LUK.21.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 21:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Wannan zai sa ku zama shaidu a gare su.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.13",
                "verseOrgIds": [
                  "LUK.21.13"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.13",
            "verseOrgIds": [
              "LUK.21.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 21:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma ku yi ƙuduri, wato, ku shirya zuciyarku, a kan ba za ku damu ba kafin lokacin, game da yadda za ku kāre kanku.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.14",
                "verseOrgIds": [
                  "LUK.21.14"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.14",
            "verseOrgIds": [
              "LUK.21.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 21:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Gama zan ba ku kalmomi, da hikima waɗanda ba ko ɗaya daga cikin maƙiyanku, za su iya tsayayya da ku, ko su ƙaryata.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.15",
                "verseOrgIds": [
                  "LUK.21.15"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.15",
            "verseOrgIds": [
              "LUK.21.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 21:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Har iyayenku, da 'yan'uwanku maza, da danginku, da abokanku ma, duk za su bashe ku, su kuma kashe waɗansunku.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.16",
                "verseOrgIds": [
                  "LUK.21.16"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.16",
            "verseOrgIds": [
              "LUK.21.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 21:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Duk mutane za su ƙi ku saboda ni.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.17",
                "verseOrgIds": [
                  "LUK.21.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.17",
            "verseOrgIds": [
              "LUK.21.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 21:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Amma ko gashi ɗaya na kanku, ba zai hallaka ba.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.18",
                "verseOrgIds": [
                  "LUK.21.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.21.18",
            "verseOrgIds": [
              "LUK.21.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 21:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ta wurin tsayawa da ƙarfi, za ku sami rai.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.21.19",
                "verseOrgIds": [
                  "LUK.21.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "r"
      },
      "items": [
        {
          "text": "(",
          "type": "text"
        },
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "MAT.24.15-MAT.24.21"
