          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sai suka yi addu'a suka ce, \"Ubangiji, ka san zuciyar kowa. Nuna mana wanne a cikin waɗannan biyu da ka zaɓa",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.24",
            "verseOrgIds": [
              "ACT.1.24"
            ]
          }
        },
        {
