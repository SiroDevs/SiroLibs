        },
        {
          "text": "Saboda haka suka gabatar da mutane biyu. Yusuf mai suna Barsabbas (da aka kuma sani da Yustus) da kuma Mattiyas.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.23",
            "verseOrgIds": [
              "ACT.1.23"
            ]
          }
        },
