              "type": "text"
            }
          ]
        },
        {
          "text": "ya karɓi wannan aikin manzanci, wanda Yahuda ya bari don yă tafi wurin da yake nasa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.1.25",
            "verseOrgIds": [
              "ACT.1.25"
            ]
