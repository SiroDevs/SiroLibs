  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "ACT 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl nʼihu nzukọ ndị Juu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Pọl legidere ndị nzukọ a anya, ọ sịrị, \"Ụmụnna m, mụ onwe m ejirila ezi akọnuche bie ndụ m niile nʼihu Chineke ruokwa ụbọchị taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.1",
            "verseOrgIds": [
              "ACT.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a mere, Ananayas onyeisi nchụaja nyere iwu ka ndị nọ ya nso tie ya aka nʼọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.2",
            "verseOrgIds": [
              "ACT.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Pọl, sịrị ya, \"Otu a ka Chineke ga-esi tie gị, gị mgbidi e tere nzu. Ụdị onye ikpe dị aṅaa ka ị bụ i ji na-emebi iwu nʼonwe gị site nʼinye iwu ka e si otu a tie m ihe?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.3",
            "verseOrgIds": [
              "ACT.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị guzo ya nso sịrị, \"Ị na-ekwutọ onyeisi nchụaja Chineke?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.4",
            "verseOrgIds": [
              "ACT.23.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Pọl sịrị, \"Aghọtaghị m, ụmụnna m na ọ bụ onyeisi nchụaja. Nʼihi na akwụkwọ nsọ kwuru sị, 'Ekwula okwu ọjọọ ọbụla megide onye na-achị ndị nke gị.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.5",
            "verseOrgIds": [
              "ACT.23.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Pọl chọpụtara na otu ụzọ nʼime nzukọ ahụ bụ ndị otu Sadusii, ebe ndị ọzọ bụkwa ndị Farisii, o tiri mkpu nʼime nnọkọ ahụ sị, \"Ụmụnna m, abụ m onye Farisii na nwa ndị Farisii. A na-ekpe m ikpe taa nʼihi olileanya m nwere na mbilite nʼọnwụ nke ndị nwụrụ anwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.6",
            "verseOrgIds": [
              "ACT.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o kwusiri nke a esemokwu dapụtara nʼetiti ndị Farisii na ndị Sadusii. Ọgbakọ ahụ kewara.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.7",
            "verseOrgIds": [
              "ACT.23.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ndị Sadusii na-asị na mbilite nʼọnwụ maọbụ mmụọ ozi maọbụ mmụọ ọbụla adịghị. Ma ndị Farisii kweere nʼihe ndị a niile.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.8",
            "verseOrgIds": [
              "ACT.23.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpọtụ malitere na-ada ike ike. Ụfọdụ ndị ozizi iwu so nʼotu ndị Farisii biliri ọtọ malite ịrụ ụka nʼoke olu sị, \"Anyị ahụghị ihe ọjọọ nʼebe nwoke a nọ, ma gịnịkwa ma ọ bụrụ na ọ bụ mmụọ, maọbụ mmụọ ozi gwara ya okwu?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.9",
            "verseOrgIds": [
              "ACT.23.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esemokwu a bịara karịa, nke mere na onyeisi ọchịagha tụrụ egwu na ha ga-adọkasị Pọl. Ọ gwara ndị agha ya ka ha banye were ike kpọpụta ya, ziga ya nʼogige ndị agha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.10",
            "verseOrgIds": [
              "ACT.23.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị ya, Onyenwe anyị bịakwutere ya sị,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.11",
            "verseOrgIds": [
              "ACT.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Nwee obi ike, dịka i si gbaa ama banyere m na Jerusalem, ị ghaghị ịgbakwara m ama na Rom.\"",
              "type": "text",
              "attrs": {
                "verseId": "ACT.23.11",
                "verseOrgIds": [
                  "ACT.23.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Izuzu igbu Pọl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụtụtụ echi ya ụfọdụ ndị Juu zukọtara gbaa izu, ṅụọkwa iyi na ha agaghị eri nri maọbụ ṅụọ ihe ọbụla tutu ruo mgbe ha gburu Pọl.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.12",
            "verseOrgIds": [
              "ACT.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị zukọtara gbaa izu ọjọọ a karịrị iri mmadụ anọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.13",
            "verseOrgIds": [
              "ACT.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jekwuuru ndịisi nchụaja ha na ndị okenye, sị ha, \"Anyị kwekọtara ịhapụ iri maọbụ ịṅụ ihe ọbụla tutu ruo mgbe anyị gburu Pọl.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.14",
            "verseOrgIds": [
              "ACT.23.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, unu na nzukọ zienụ onyeisi ọchịagha ka ọ kpọpụtara unu ya. Meenụ ka unu na-achọ ịjụpụtasị eziokwu nʼọnụ ya nakwa itule ikpe ya nke ọma. Anyị dị njikere igbu ya nʼụzọ tupu ọ bịaruo unu nso.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.15",
            "verseOrgIds": [
              "ACT.23.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwa nwanne nwanyị Pọl nụrụ maka izuzu ọjọọ a. Ọ banyere nʼogige ndị agha kọọrọ Pọl.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.16",
            "verseOrgIds": [
              "ACT.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Pọl kpọrọ otu nʼime ndịisi agha ahụ gwa ya, \"Biko kpọrọ nwokorobịa a gaa nʼebe ọchịagha nọ, o nwere okwu dị mkpa ọ chọrọ ịgwa ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.17",
            "verseOrgIds": [
              "ACT.23.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọọrọ ya jekwuru onyeisi agha, sị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.18",
            "verseOrgIds": [
              "ACT.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "ACT 23:18"
      },
      "items": [
        {
          "text": "\"Pọl, onye mkpọrọ, kpọrọ m rịọ m ka m kpọtara gị nwokorobịa a nʼihi na o nwere ihe ọ chọrọ ịgwa gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.18",
            "verseOrgIds": [
              "ACT.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyeisi agha ahụ duuru ya nʼaka ya gaa nʼakụkụ ọzọ jụọ ya, \"Gịnị bụ ihe ị chọrọ ịkọrọ m?\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.19",
            "verseOrgIds": [
              "ACT.23.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Ndị Juu ụfọdụ ekwekọrịtala ịrịọ gị ka ị kpọpụta Pọl echi na nzukọ ụlọ ikpe. Ha ga-eme dịka ha nwere ihe dị mkpa ha chọrọ ịjụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.20",
            "verseOrgIds": [
              "ACT.23.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma aṅala ha ntị. Nʼihi na ihe karịrị iri mmadụ anọ na-ezo onwe ha na-eche inwude ya. Ndị a gbara ndụ na ha agaghị eri maọbụ ṅụọ ihe ọbụla tutu ruo mgbe ha gburu ya. Ha adịla njikere, ihe a na-eche bụ mkpebi gị nye arịrịọ ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.21",
            "verseOrgIds": [
              "ACT.23.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọchịagha ahụ zilagara nwokorobịa ahụ site nʼinye ya iwu, \"Emekwala ka onye ọbụla mata na ị bịara gwa m ihe dị otu a.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.22",
            "verseOrgIds": [
              "ACT.23.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl agaa Sizaria",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e mesịrị, ọ kpọrọ mmadụ abụọ nʼime ndịisi agha nye ha iwu sị, \"Gaanụ jikere narị ndị agha abụọ, na iri mmadụ asaa ndị na-agba ịnyịnya, tinyere narị ndị ikom abụọ ndị na-ama ùbe, ndị ga-aga Sizaria nʼelekere itoolu nke abalị a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.23",
            "verseOrgIds": [
              "ACT.23.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nyekwa Pọl ịnyịnya nke ọ ga-agba, ka e nwee ike duru ya gakwuru Feliks bụ gọvanọ nʼudo.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.24",
            "verseOrgIds": [
              "ACT.23.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "O dere akwụkwọ nʼolu dị otu a:",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.25",
            "verseOrgIds": [
              "ACT.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Klọdiọs Lisias,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 23:26"
      },
      "items": [
        {
          "text": "Na-edegara Feliks onye nsọpụrụ na-adịrị, onye na-achị akụkụ a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "ACT 23:26"
      },
      "items": [
        {
          "text": "Ana m ekele gị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.26",
            "verseOrgIds": [
              "ACT.23.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Juu jidere nwoke a chọọ igbu ya, ma mgbe m nụrụ na ọ bụ onye Rom, mụ na ndị agha m bịara napụta ya nʼaka ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.27",
            "verseOrgIds": [
              "ACT.23.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achọrọ m ịmata ihe mere ha ji ebo ya ebubo, nʼihi ya eduuru m ya gaa nʼọgbakọ ndị okenye ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.28",
            "verseOrgIds": [
              "ACT.23.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma achọpụtara m na ọ bụ ihe banyere iwu ha. Nʼeziokwu, o nweghị ihe ọbụla kwesiri iji tụọ ya mkpọrọ maọbụ ọnwụ nʼime ebubo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.29",
            "verseOrgIds": [
              "ACT.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara m banyere izuzu a na-agba megide nwoke a, ezitere m gị ya nʼegbughị oge. Enyekwara m ndị niile na-ebo ya ebubo iwu, ka ha bịa nʼihu gị kpee ọnụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.30",
            "verseOrgIds": [
              "ACT.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nʼabalị ahụ, ndị agha dubatara Pọl na Antipatris dịka e nyere ha nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.31",
            "verseOrgIds": [
              "ACT.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼechi ya, ha hapụrụ ya na ndị na-agba nʼelu ịnyịnya ka ha duru ya gawa, ebe ha laghachiri nʼogige ndị agha.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.32",
            "verseOrgIds": [
              "ACT.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha bịarutere Sizaria, ha nyere onyeisi obodo ahụ akwụkwọ ozi, ma kpọnyekwa ya Pọl.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.33",
            "verseOrgIds": [
              "ACT.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gọvanọ ahụ gụrụ akwụkwọ ozi ahụ, jụọ ya akụkụ ala o si pụta. Mgbe ọ matara na ọ bụ onye Silisia,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.34",
            "verseOrgIds": [
              "ACT.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ sịrị ya, \"Aga m enye okwu gị ezigbo ohere mgbe ndị na-ebo gị ebubo bịara.\" O nyekwara iwu ka e debe ya nʼobi Herọd nʼaka ndị nche.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.23.35",
            "verseOrgIds": [
              "ACT.23.35"
            ]
          }
        }
      ]
    }
  ],
