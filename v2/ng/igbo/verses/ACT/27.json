  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "ACT 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Pọl agaa Rom",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ACT 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e kpebiri na anyị ga-eso ụgbọ mmiri gaa Itali, e nyefere Pọl na ndị mkpọrọ ọzọ nʼaka onyeisi na-elekọta ndị mkpọrọ aha ya bụ Juliọs. Ọ bụ ọchịagha nke igwe ndị agha Ọgọstọs.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.1",
            "verseOrgIds": [
              "ACT.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ACT 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị banyere nʼụgbọ sitere Adramitiọm nke na-ejikere ịga nʼọnụ mmiri nke dị nʼakụkụ obodo Eshịa. Anyị nupuru nʼoke osimiri, Arịstakọs, onye Masidonia sitere na Tesalonaịka sokwa anyị nʼije a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.2",
            "verseOrgIds": [
              "ACT.27.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ACT 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼechi ya, anyị rutere Saịdọn. Juliọs nwere obiọma nʼebe Pọl nọ. Ọ hapụkwara ya ka o jegharịara onwe ya izute ndị enyi ya. Ndị a lekwara anyị ọbịa nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.3",
            "verseOrgIds": [
              "ACT.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ACT 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼịgakwa nʼihu na mmiri ahụ, anyị zutere ifufe mmiri nke mere na anyị gara nʼazụ ala Saiprọs.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.4",
            "verseOrgIds": [
              "ACT.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ACT 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị gafere ọnụ mmiri obodo Silisia na Pamfilia. Anyị bịaruru Mira nʼime obodo Lisia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.5",
            "verseOrgIds": [
              "ACT.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ACT 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka onye ọchịagha hụrụ ụgbọ onye Alegzandria nke na-aga Itali. O mere ka anyị banye nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.6",
            "verseOrgIds": [
              "ACT.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ACT 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụgbọ anyị ji, gara nwayọọ ọtụtụ ụbọchị na o siiri anyị ike irute Snidos. Ebe ọ bụ nʼoke ifufe ekweghị ka anyị gaa nʼihu, anyị enwekwaghị ike ịga nʼụzọ anyị, kama anyị si nʼazụ Kriit na ncherita ihu Salmone gafee.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.7",
            "verseOrgIds": [
              "ACT.27.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ACT 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị jikwa nwayọọ na-agba nʼakụkụ ọnụ mmiri ahụ tutu ruo mgbe anyị sitere nʼoke nsogbu rute ebe a na-akpọ ọnụ mmiri ọma, nke dị nso nʼobodo Lasia.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.8",
            "verseOrgIds": [
              "ACT.27.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ACT 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị tufuru oge nʼebe ahụ. Ije ụgbọ mmiri abụrụkwala nke jupụtakwara nʼihe ize ndụ ugbu a, nʼihi na mmemme Obubu ọnụ nke ndị Juu agafeela. Nʼihi nke a, Pọl dụrụ mmadụ niile ọdụ,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.9",
            "verseOrgIds": [
              "ACT.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ACT 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-asị, \"Ndị nwe m, a na m ahụta na njem a ga-abụ nke ihe egwu nke ga-eweta oke ịla nʼiyi. Ọ bụghị naanị nke ụgbọ mmiri na ibu o bu, ma metụtakwa ndụ anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.10",
            "verseOrgIds": [
              "ACT.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ACT 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọchịagha ahụ kwenyere nʼihe onyeisi ụgbọ na onye nwe ụgbọ kwuru karịa nke Pọl kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.11",
            "verseOrgIds": [
              "ACT.27.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ACT 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ebe ọnụ mmiri a abụghị ebe dị mma ịnọ nʼoge oyi, ndị ka nʼọnụọgụgụ họọrọ ka ụgbọ ahụ gaa nʼihu, nʼolileanya na a ga-eru Fonikisi ebe ha ga-anọdụ nʼoge oyi. Nke a bụ ọnụ mmiri dị na Kriit, nke chere ihu nʼọwụwa anyanwụ nʼakụkụ ugwu na akụkụ ndịda.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.12",
            "verseOrgIds": [
              "ACT.27.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ifufe nʼosimiri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ACT 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ikuku dị nwayọọ bidoro ifegharị site na ndịda, ha chere na nke a bụ ohere dịrị ha. Nʼihi ya, ha kwọpụrụ ụgbọ nyara ya na-aga nso nso ọnụ mmiri Kriit.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.13",
            "verseOrgIds": [
              "ACT.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ACT 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe na-adịghị anya, oke ifufe dị egwu nke si nʼagbata ugwu na ọwụwa anyanwụ kuru site nʼagwa etiti ahụ rịdata.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.14",
            "verseOrgIds": [
              "ACT.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ACT 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-anya ụgbọ ahụ gbalịsịrị ike na mbụ ichigharị ihu ụgbọ ahụ ka ọ gaa nʼọnụ mmiri, ma ọ pụghị ime. Anyị hapụrụ ya ka o soro ikuku.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.15",
            "verseOrgIds": [
              "ACT.27.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ACT 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, anyị kwọọrọ ụgbọ anyị gaa nʼazụ agwa etiti nta a na-akpọ Klọda. Nʼebe ahụ anyị jisiri ike kekwasị ụgbọ nta nke ụgbọ mmiri anyị na-adọkpụ nʼazụ nʼelu ụgbọ mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.16",
            "verseOrgIds": [
              "ACT.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ACT 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, anyị jiri ụdọ kee ụgbọ mmiri ahụ ime ka o sie ike karịa. Ndị na-anya ụgbọ ahụ tụrụ egwu na ikuku ga-eburu ụgbọ anyị gaa nʼọnụ mmiri na-achị ọkụ nke dị na Satis. Ha wedatara akwa e kobere nʼelu, nke na-enyere ikuku aka ibu ụgbọ mmiri. Emesịa, ha sooro ikuku mmiri ahụ na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.17",
            "verseOrgIds": [
              "ACT.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ACT 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe chi bọrọ, dịka osimiri ahụ na-etonye etonye, ndị na-eso ụgbọ bidoro ịtụbasị ngwongwo ndị dị nʼụgbọ ahụ nʼime osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.18",
            "verseOrgIds": [
              "ACT.27.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ACT 27:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke atọ ha tụbakwara ngwongwo e ji edozi ụgbọ mmiri na ọtụtụ ihe ọbụla nke aka ha ghọtara nʼime osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.19",
            "verseOrgIds": [
              "ACT.27.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ACT 27:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọtụtụ ụbọchị gara ma ọ dịghị anyanwụ maọbụ kpakpando wapụtaranụ, ma oke ifufe ọjọọ ahụ gara nʼihu na-amagharị, nʼikpeazụ olileanya anyị na a ga-azọpụta anyị gwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.20",
            "verseOrgIds": [
              "ACT.27.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ACT 27:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a niile, o nweghị onye ọbụla nri ọbụla bara ọnụ. Ma nʼikpeazụ. Pọl kwụụrụ ọtọ nʼetiti ha sị, \"Ndị ikom ibe m, ọ bụrụ na unu gere ntị nʼokwu m na mbụ, anyị agaraghị ahapụ Kriit. Anyị gara agbanarị mbibi na ịla nʼiyi nke a.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.21",
            "verseOrgIds": [
              "ACT.27.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ACT 27:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, ana m arịọ unu, nweenụ obi ike! Nʼihi na o nweghị onye ọbụla nʼime unu a ga-atụfu ndụ ya. Ọ bụ ezie na ụgbọ a ga-emikpu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.22",
            "verseOrgIds": [
              "ACT.27.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ACT 27:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nʼabalị gara aga, mmụọ ozi Chineke Onyenwe m, na onye m na-efekwa bịakwutere m,",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.23",
            "verseOrgIds": [
              "ACT.27.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ACT 27:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ sịrị, 'Atụla egwu Pọl, nʼihi na ị ghaghị iguzo nʼihu Siza. Nke ọzọkwa, Chineke emeela amara nye gị ndụ ndị a niile gị na ha so nʼụgbọ eme njem.'",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.24",
            "verseOrgIds": [
              "ACT.27.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ACT 27:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị ikom nweenụ obi ike! Nʼihi na enwere m ntụkwasị obi na Chineke ga-eme dị ka o siri gwa m.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.25",
            "verseOrgIds": [
              "ACT.27.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ACT 27:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, a ga-eburu ụgbọ mmiri anyị buba ya nʼotu agwa etiti.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.26",
            "verseOrgIds": [
              "ACT.27.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụgbọ imikpu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "ACT 27:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe dịka nʼetiti abalị nʼụbọchị nke iri na anọ ebili mmiri a, mgbe anyị na-erugharị nʼosimiri a na-akpọ Adratik, ndị na-anya ụgbọ chere na ala dị nso.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.27",
            "verseOrgIds": [
              "ACT.27.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "ACT 27:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha tụnyere ụdọ e kenyere igwe nʼọnụ ya nʼime osimiri chọpụta na omimi osimiri ahụ dị narị nzọ ụkwụ na iri abụọ nʼebe ahụ ha nọ. Ha gakwara nʼihu tụọkwa ụdọ ahụ ọzọ chọpụta na omimi osimiri ahụ dị iri nzọ ụkwụ itoolu.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.28",
            "verseOrgIds": [
              "ACT.27.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "ACT 27:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma egwu juru ha obi nʼihi na ha amaghị ma ha ga-ezute nkume nʼakụkụ ọnụ mmiri ahụ. Ha tụpụtara arịlịka anọ e ji ejide ụgbọ site nʼazụ ụgbọ ahụ ma na-arịọ chi ha maka chi ọbụbọ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.29",
            "verseOrgIds": [
              "ACT.27.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "ACT 27:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị na-eso ụgbọ ahụ kpebiri ịhapụ ya. Ha wedatara ụgbọ epeepe e dobere maka ihe mberede, mee dịka ha na-aga itinye arịlịka nʼọnụ ụgbọ mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.30",
            "verseOrgIds": [
              "ACT.27.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "ACT 27:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Pọl gwara ndị agha na ọchịagha ha okwu, \"Ọ bụrụ na ndị a anọgideghị nʼime ụgbọ a, agaghị azọpụta unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.31",
            "verseOrgIds": [
              "ACT.27.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "ACT 27:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ndị agha ahụ gbubiri ụdọ e jiri kee ụgbọ epeepe ahụ hapụ ụgbọ epeepe ahụ ka ọ daba nʼime osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.32",
            "verseOrgIds": [
              "ACT.27.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "ACT 27:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe chi bidoro ịbọ, Pọl rịọrọ mmadụ niile ka ha rie nri, na-asị, \"Taa mere ya ụbọchị iri na anọ unu nọ na nche, nọgidekwa nʼibu ọnụ, nʼerighị ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.33",
            "verseOrgIds": [
              "ACT.27.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "ACT 27:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ọdịmma nke ndụ unu, ana m arịọ unu ka unu rie ihe. Nʼihi na o nweghị onye ọbụla nʼime unu otu agịrị isi ya ga-ala nʼiyi.\"",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.34",
            "verseOrgIds": [
              "ACT.27.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "ACT 27:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o kwuchara nke a, o weere achịcha nye Chineke ekele nʼihu ha niile, nyawaa ya, malitekwa iri ya.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.35",
            "verseOrgIds": [
              "ACT.27.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "ACT 27:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu mgbe ahụ, obi ụtọ batara mmadụ niile nʼobi, ha bidokwara iri nri.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.36",
            "verseOrgIds": [
              "ACT.27.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "ACT 27:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị niile nọ nʼụgbọ ahụ dị narị mmadụ abụọ na iri asaa na isii.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.37",
            "verseOrgIds": [
              "ACT.27.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "ACT 27:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe anyị richara nri, ha buuru akpa ọka niile dị nʼụgbọ ahụ tụba ha nʼime osimiri ime ka ụgbọ ahụ gbaa mfe.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.38",
            "verseOrgIds": [
              "ACT.27.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Omimi nke ụgbọ mmiri ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "ACT 27:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe chi bọrọ, ha enwekwaghị ike ịghọta akụkụ mmiri nke ha nọ nʼime ya. Ma ha hụrụ obosara ala nta nke nwere ọnụ mmiri. Ha gbara izu ịchọpụta ma ọ ga-ekwe mee ka ụgbọ mmiri ahụ site nʼebe ahụ gafee.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.39",
            "verseOrgIds": [
              "ACT.27.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "ACT 27:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha chabisiri arịlịka niile ji ụgbọ ahụ, hapụ ha nʼime osimiri. Otu aka ahụkwa, ha tọpụrụ ụdọ ji ụmara e ji anyagharị ụgbọ. Mgbe ahụ, ha weliri akwa ifufe nke ọnụ ụgbọ nye ifufe, mekwa ka ụgbọ mmiri chee ihu nʼelu ala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.40",
            "verseOrgIds": [
              "ACT.27.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "ACT 27:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụgbọ mmiri ahụ gara maa isi na mkpumkpu aja mmiri, mikpuo nʼaja. Ọnụ ụgbọ ahụ mikpuru nke ukwuu mee ka isi ụgbọ ahụ laa elu, nke a nyere ebili mmiri a ohere iji ike tiwasịa azụ ụgbọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.41",
            "verseOrgIds": [
              "ACT.27.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "ACT 27:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha zubere igbu ndị mkpọrọ niile, ka onye ọbụla ghara igwuru mmiri site ya gbafuo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.42",
            "verseOrgIds": [
              "ACT.27.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "ACT 27:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye ọchịagha ahụ na-ezube ịzọpụta ndụ Pọl, nʼihi ya, o gbochiri ha nʼizuzu ha. Mgbe ahụ o nyere iwu ka ndị niile maara igwu mmiri buru ụzọ si nʼụgbọ ahụ wụba nʼime mmiri, gwuru mmiri gaa nʼelu ala.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.43",
            "verseOrgIds": [
              "ACT.27.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "ACT 27:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị fọdụrụ ga-eru nʼelu ala site nʼịghọnye aka na obodobo osisi maọbụ nʼihe ndị ọzọ dị iche iche si nʼahụ ụgbọ ahụ dapụta. Nʼụzọ dị otu ka mmadụ niile ji bụrụ ndị rutere nʼelu ala nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "ACT.27.44",
            "verseOrgIds": [
              "ACT.27.44"
            ]
          }
        }
      ]
    }
  ],
