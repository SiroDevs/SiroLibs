  "verseCount": 63,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "JOS 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Oke ndị Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOS 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ala ndị a ka e nyere ndị Juda dịka ikwu dị nʼebo ahụ si dị. Ikwu ọbụla ketara ala nke ha site nʼife nza. Ala Juda gbatịrị nnọọ ruo nʼoke ala Edọm, gbatịakwa ruo nʼọzara Zin, kwụsị nʼọnụ ọnụ ndịda ọzara a.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOS 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ ndịda, oke ala ha malitere nʼọnụ ọnụ ndịda osimiri Nnu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.2",
            "verseOrgIds": [
              "JOS.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOS 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebe akụkụ ndịda nrigo Akrabim, gafee ruo nʼọzara Zin, ma rigoo nʼakụkụ nke ndịda Kadesh Banea, gafee Hezrọn rigoruo na Aada, gba gburugburu gaa Kaka;",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.3",
            "verseOrgIds": [
              "JOS.15.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOS 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "site nʼebe ahụ ruo Azmọn, pụọ gbasoro iyi dị nʼoke ala ndị Ijipt gagide ruo nʼosimiri Mediterenịa. Nke a bụ oke ala nʼebe ndịda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.4",
            "verseOrgIds": [
              "JOS.15.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOS 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ha nʼọwụwa anyanwụ bụ oke osimiri Nnu, ruo nʼọnụ mmiri osimiri Jọdan.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "JOS 15:5"
      },
      "items": [
        {
          "text": "Oke ala ha nʼakụkụ ugwu bidoro nʼọnụ mmiri osimiri Jọdan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.5",
            "verseOrgIds": [
              "JOS.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOS 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "gbatịrị ruo Bet-Hogla, ma ruo nʼugwu Bet-Araba,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "text": "rukwaa na nkume Bohan, nwa Ruben.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.6",
            "verseOrgIds": [
              "JOS.15.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOS 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebe ahụ, ọ gbatịrị ruo na Ndagwurugwu Akọ na Debịa, tụgharịa gbatịrịkwa ruo Gilgal, na ncherita ihu ala ala Adumim nke dị nʼakụkụ ndịda ndagwurugwu ahụ. Site nʼebe ahụ ọ gbatịrị ruo na mmiri En-Shemesh, kwụsị na En-Rogel.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.7",
            "verseOrgIds": [
              "JOS.15.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOS 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ahụ gbagoro Ndagwurugwu nke Ben Hinom, rukwaa nʼakụkụ ndịda Jebus nʼebe e wuru obodo Jerusalem. Oke ala ahụ sitekwara ebe ahụ gbagoo ruo nʼelu dị nʼakụkụ ọdịda anyanwụ nke Ndagwurugwu Hinom, na nsọtụ ugwu nke Ndagwurugwu Refaim.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.8",
            "verseOrgIds": [
              "JOS.15.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOS 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼelu ugwu ebe ahụ, oke ala ahụ gbatịrị ruo na mmiri ime ala Neftoa, pụta site nʼebe ahụ ruo obodo niile dị nso ugwu Efrọn. Site nʼEfrọn, oke ala ahụ gbadara ruo Baala (nke aha ya ọzọ bụ Kiriat Jearim).",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.9",
            "verseOrgIds": [
              "JOS.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOS 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ahụ mere dịka ọ ga-agba Baala gburugburu nʼakụkụ ọdịda anyanwụ, site nʼebe ahụ pụta nʼugwu Sia, sitekwa nʼebe ahụ ruo nʼakụkụ ugwu Jearim (ya bụ Kesalon), gbatịa ruo na ndịda Bet-Shemesh, gafee ruo nʼọdịda anyanwụ oke ala Timna.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.10",
            "verseOrgIds": [
              "JOS.15.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOS 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sikwara ebe ahụ ruo ndịda ugwu Ekrọn, tụgharịa ruo Shikerọn, gafee ya, ruo nʼugwu Baala, sitekwa nʼebe ahụ ruo Jabneel, oke ala ahụ kwụsịrị nʼosimiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.11",
            "verseOrgIds": [
              "JOS.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOS 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ala ha nʼakụkụ ọdịda anyanwụ bụ ọnụ mmiri osimiri Mediterenịa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.12",
            "verseOrgIds": [
              "JOS.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "JOS 15:12"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "JOS 15:12"
      },
      "items": [
        {
          "text": "Ndị a bụ oke ala gbara ndị Juda gburugburu dịka ikwu ha niile si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Kaleb emerie Hebrọn na Debịa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOS 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka iwu",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JOS.15.13",
                "verseOrgIds": [
                  "JOS.15.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere si dị, Joshua nyere Kaleb nwa Jefune oke nʼetiti ndị Juda. O kenyere ya Kiriat Aaba, ya bụ, Hebrọn. Aaba bụ nna nna Anak.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.13",
            "verseOrgIds": [
              "JOS.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOS 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaleb sitere nʼobodo Hebrọn chụpụ ndị ikom atọ, bụ Sheshai, na Ahiman, na Talmai, ụmụ Anak nʼala ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.14",
            "verseOrgIds": [
              "JOS.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOS 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O si nʼebe ahụ bilie ịlụso ndị bi na Debịa ọgụ. Nke a na-akpọ Kiriat Sefa nʼoge mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.15",
            "verseOrgIds": [
              "JOS.15.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOS 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kaleb sịrị, \"Nwoke ọbụla ga-aga busoo Kiriat Sefa agha ma merie ya ka m ga-akpọnye Aksa, bụ nwa m nwanyị ka ọ bụrụ nwunye ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.16",
            "verseOrgIds": [
              "JOS.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOS 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Otniel, nwa Kenaz, nwa nwanne Kaleb, lụgburu obodo ahụ nʼagha. Nʼihi nke a, Kaleb kpọnyere ya Aksa, bụ nwa ya nwanyị ka ọ bụrụ nwunye ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.17",
            "verseOrgIds": [
              "JOS.15.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOS 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, mgbe Aksa bịakwutere Otniel, ọ kwagidere ya ka ọ rịọọ ala ubi site nʼaka nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        },
        {
          "text": "Mgbe Aksa si nʼelu ịnyịnya ibu ya rịdata, Kaleb jụrụ ya sị, \"Gịnị ka ị chọrọ ka m mere gị?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.18",
            "verseOrgIds": [
              "JOS.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOS 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ zaghachiri, \"Nyem onyinye pụrụ iche. Ebe ọ bụ na i nyela m ala Negev, biko nyekwa m isi mmiri ụfọdụ.\" Nʼihi nke a, Kaleb nyere ya isi mmiri mgbago na isi mmiri nke ndịda.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.19",
            "verseOrgIds": [
              "JOS.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOS 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe nketa ebo Juda dịka ikwu ha niile si dị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOS 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo niile nke ndị ebo Juda dị na Negev, nʼakụkụ ndịda nʼoke ala Edọm bụ ndị a:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:21"
      },
      "items": [
        {
          "text": "Kabzeel, Eda, Jaguo,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.21",
            "verseOrgIds": [
              "JOS.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOS 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kina, Dimona, Adada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.22",
            "verseOrgIds": [
              "JOS.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOS 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kedesh, Hazọ, Itnan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.23",
            "verseOrgIds": [
              "JOS.15.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOS 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zif, Telem, Bealot,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.24",
            "verseOrgIds": [
              "JOS.15.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOS 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazọ Hadata, Keriọt Hezrọn (ya bụ Hazoa),",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.25",
            "verseOrgIds": [
              "JOS.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOS 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amam, Shema, na Molada,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.26",
            "verseOrgIds": [
              "JOS.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOS 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza Gada, Heshmọn, Bet-Pelet,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.27",
            "verseOrgIds": [
              "JOS.15.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOS 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Haza Shual, Bịasheba, Biziotịa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.28",
            "verseOrgIds": [
              "JOS.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOS 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Baala, Iyim, Ezem,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.29",
            "verseOrgIds": [
              "JOS.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOS 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eltolad, Kesil, Homa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.30",
            "verseOrgIds": [
              "JOS.15.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOS 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ziklag, Madmanna, Sansanna,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.31",
            "verseOrgIds": [
              "JOS.15.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lebaot, Shilhim, Ain na Rimọn. Ọnụọgụgụ obodo ndị a dị iri abụọ na itoolu. Obodo nta ndị ọzọ gbara ha niile gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.32",
            "verseOrgIds": [
              "JOS.15.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo niile ndị a dị na ndịda ugwu ka e nyekwara ebo Juda. Obodo ndị a bụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:33"
      },
      "items": [
        {
          "text": "Eshtaol, Zora, Ashna,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.33",
            "verseOrgIds": [
              "JOS.15.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOS 15:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zanoa, En-Ganim, Tapụọa, Enam,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.34",
            "verseOrgIds": [
              "JOS.15.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOS 15:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jamut, Adulam, Soko, Azeka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.35",
            "verseOrgIds": [
              "JOS.15.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "JOS 15:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Shaaraim, Aditaịm na Gedera (maọbụ Gederotaịm). Ha niile dị obodo iri na anọ. Obodo nta ndị ọzọ gbakwara ha gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.36",
            "verseOrgIds": [
              "JOS.15.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "JOS 15:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebo Juda ketara Zenan, Hadasha, Migdal Gad,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.37",
            "verseOrgIds": [
              "JOS.15.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "JOS 15:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dilean, Mizpa, Jekteel,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.38",
            "verseOrgIds": [
              "JOS.15.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "JOS 15:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lakish, Bozkat, Eglọn,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.39",
            "verseOrgIds": [
              "JOS.15.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "JOS 15:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kabọn, Laamam, Kitlish,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.40",
            "verseOrgIds": [
              "JOS.15.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "JOS 15:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gederọt, Bet-Dagọn, Naama na Makeda. Obodo ndị a dị iri na isii, tinyekwara obodo nta ha. Ndị Juda ketakwara:",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.41",
            "verseOrgIds": [
              "JOS.15.41"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "JOS 15:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Libna, Eta, Ashan",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.42",
            "verseOrgIds": [
              "JOS.15.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "JOS 15:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ifta, Ashna, Nezib,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.43",
            "verseOrgIds": [
              "JOS.15.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "JOS 15:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keila, Akzib na Maresha. Ha niile dị obodo itoolu, tinyekwara obodo nta ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.44",
            "verseOrgIds": [
              "JOS.15.44"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "JOS 15:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ketakwara Ekrọn, na obodo nta ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.45",
            "verseOrgIds": [
              "JOS.15.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "JOS 15:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ha nwekwa obodo niile dị nʼakụkụ ọdịda anyanwụ Ekrọn, ndị dị nso nso Ashdọd, na obodo nta niile dị ha nso.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.46",
            "verseOrgIds": [
              "JOS.15.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "JOS 15:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ashdọd nʼonwe ya, na ụmụ obodo nta ya niile, na Gaza na obodo nta ya niile, ruo nʼiyi Ijipt, na ruo nʼoke osimiri Mediterenịa.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.47",
            "verseOrgIds": [
              "JOS.15.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "JOS 15:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nwetakwara ala ndị dị nʼugwu ugwu bụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "JOS 15:48"
      },
      "items": [
        {
          "text": "Shamia, Jatịa, Sokoh,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.48",
            "verseOrgIds": [
              "JOS.15.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "JOS 15:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dana, Kiriat-Sana (ya bụ Debịa),",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.49",
            "verseOrgIds": [
              "JOS.15.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "JOS 15:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anab, Eshtemo, Anim,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.50",
            "verseOrgIds": [
              "JOS.15.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "JOS 15:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Goshen, Họlọn na Gailo, ha niile dị obodo iri na otu tinyere obodo nta ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.51",
            "verseOrgIds": [
              "JOS.15.51"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "JOS 15:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obodo ndị ọzọ bụ Arab, Duma, Eshan,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.52",
            "verseOrgIds": [
              "JOS.15.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "JOS 15:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Janim, Bet-Tapụọa, Afeka,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.53",
            "verseOrgIds": [
              "JOS.15.53"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "JOS 15:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Humta, Kiriat Aba nke bụ Hebrọn na Zior, obodo itoolu tinyere obodo nta ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.54",
            "verseOrgIds": [
              "JOS.15.54"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "JOS 15:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maon, Kamel, Zif, Juta,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.55",
            "verseOrgIds": [
              "JOS.15.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "JOS 15:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jezril, na Jokdeam, Zanoa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.56",
            "verseOrgIds": [
              "JOS.15.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "JOS 15:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kain, Gibea na Timna, obodo iri tinyere obodo nta ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.57",
            "verseOrgIds": [
              "JOS.15.57"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "58",
            "style": "v",
            "sid": "JOS 15:58"
          },
          "items": [
            {
              "text": "58",
              "type": "text"
            }
          ]
        },
        {
          "text": "Halhaul, Bet Zoa, Gedoa,",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.58",
            "verseOrgIds": [
              "JOS.15.58"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "59",
            "style": "v",
            "sid": "JOS 15:59"
          },
          "items": [
            {
              "text": "59",
              "type": "text"
            }
          ]
        },
        {
          "text": "Maarat, Bet-Anot na Eltekọn, obodo isii tinyere obodo nta ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.59",
            "verseOrgIds": [
              "JOS.15.59"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "60",
            "style": "v",
            "sid": "JOS 15:60"
          },
          "items": [
            {
              "text": "60",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kiriat Baal, ya bụ, Kiriat Jearim na Raba, obodo abụọ tinyere obodo nta ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.15.60",
            "verseOrgIds": [
              "JOS.15.60"
            ]
          }
        }
      ]
