                "verseOrgIds": [
                  "JOS.22.34"
                ]
              }
            }
          ]
        },
        {
          "text": "bụkwa Chineke anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
