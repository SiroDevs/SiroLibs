                "verseOrgIds": [
                  "JOS.22.31"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka anyị chere. Ya mere, unu azọpụtala ndị Izrel site na mbibi gaara abịakwasị ha site nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.31",
