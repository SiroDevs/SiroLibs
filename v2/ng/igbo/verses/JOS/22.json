    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOS 22:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Finehaz, nwa Elieza, onye nchụaja, na ndị ndu ahụ laghachitere Kenan site na nzukọ ha na ụmụ Ruben na Gad na ọkara Manase mere nʼala Gilead kọọrọ Izrel ihe ha gatara.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.32",
            "verseOrgIds": [
              "JOS.22.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOS 22:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu a tọrọ ụmụ Izrel ụtọ. Ha ṅụrịrị ọṅụ, too Chineke otuto. Ha ekwukwaghị okwu ibu agha megide ụmụ Ruben, ụmụ Gad na ụmụ Manase, banyere ibibi ala ha bi nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.33",
            "verseOrgIds": [
              "JOS.22.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
