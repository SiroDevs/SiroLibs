            "number": "34",
            "style": "v",
            "sid": "JOS 22:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụ Ruben na ụmụ Gad kpọrọ ebe ịchụ aja ha wuru, \"Ebe ịchụ aja akaebe,\" nʼihi na ha sịrị, \"Ọ bụ ihe akaebe igosi mmadụ niile na",
          "type": "text",
          "attrs": {
            "verseId": "JOS.22.34",
            "verseOrgIds": [
              "JOS.22.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
