  "verseCount": 57,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "14",
        "style": "c",
        "sid": "LEV 14"
      },
      "items": [
        {
          "text": "14",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Usoro ido ụlọ na ndị ekpenta ọcha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 14:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.1",
                "verseOrgIds": [
                  "LEV.14.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis, sị,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.1",
            "verseOrgIds": [
              "LEV.14.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 14:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ndị a bụ usoro iwu gbasara onye ọrịa ekpenta nʼoge a na-eme mmemme ịdị ọcha ya, mgbe e dutere ya bịakwute onye nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.2",
            "verseOrgIds": [
              "LEV.14.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 14:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-apụ gaa nʼazụ ebe obibi nọdụ nʼebe ahụ lee ya ahụ, ịchọpụta ma ọrịa ekpenta ya ọ laala nʼezie. Ọ bụrụ na ọrịa ya alaala,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.3",
            "verseOrgIds": [
              "LEV.14.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 14:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja ga-enye iwu ka e weta nnụnụ abụọ dị ndụ, na ụfọdụ osisi sida, na eriri ogho uhie, na hisọp, maka onye ahụ a ga-emere mmemme ịdị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.4",
            "verseOrgIds": [
              "LEV.14.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 14:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-enye iwu ka e gbuo otu nʼime nnụnụ abụọ ahụ nʼelu mmiri e si nʼọdọ mmiri na-asọ asọ kute nke dị nʼime ite aja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.5",
            "verseOrgIds": [
              "LEV.14.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 14:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewere nnụnụ nke ọzọ dị ndụ, ya na osisi sida ahụ, na ogho uhie ahụ, na hisọp ahụ, denye ha nʼime ọbara nnụnụ ahụ e gburu nʼelu mmiri ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.6",
            "verseOrgIds": [
              "LEV.14.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 14:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye nchụaja ga-efe ọbara ahụ ugboro asaa nʼahụ onye ahụ a na-eme ka ọ dị ọcha site nʼọrịa ekpenta. Ọ ga-ekwupụtakwa na a gwọọla onye ahụ. Emesịa, ọ ga-ahapụ nnụnụ ahụ ka o felaa nʼọhịa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.7",
            "verseOrgIds": [
              "LEV.14.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 14:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ahụ e mere ka ọ dị ọcha ga-asacha uwe ya, kpụchaa ntutu isi ya, saakwa ahụ ya. Mgbe ahụ, ọ ga-adị ọcha. Emesịa, ọ ga-esoro ndị mmadụ biri nʼobodo. Ma ọ gaghị abanye nʼụlọ nke aka ya tutu ụbọchị asaa agafee.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.8",
            "verseOrgIds": [
              "LEV.14.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 14:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa, ọ ga-akpụchapụ ntutu isi ya, na afụọnụ ya, na ikuanya ya, na ajị ndị ọzọ dị ya nʼahụ. Ọ ga-asa uwe ya na ahụ ya niile. Mgbe ahụ, a ga-agụ ya nʼonye dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.9",
            "verseOrgIds": [
              "LEV.14.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 14:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼụbọchị nke asatọ, ọ ga-ewere ebule abụọ na-enweghị ntụpọ, na otu nne atụrụ nke na-enweghị ntụpọ gbara otu afọ, ya na iri iko ọka a kwọrọ nke ọma a gwakọtara mmanụ oliv maka aja mkpụrụ ọka, na otu iko mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.10",
            "verseOrgIds": [
              "LEV.14.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 14:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ lere ya ahụ sị na ha dị ọcha, ga-ewere aja ndị a, ha na onye ahụ a na-aga ime ka ọ dị ọcha chee nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.11",
                "verseOrgIds": [
                  "LEV.14.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼọnụ ụzọ ụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.11",
            "verseOrgIds": [
              "LEV.14.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 14:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ahụ, onye nchụaja ahụ ga-ewere otu nʼime ụmụ ebule ahụ, na otu iko mmanụ chụọ ya dịka onyinye aja ikpe ọmụma. Ọ ga-efufe ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.12",
                "verseOrgIds": [
                  "LEV.14.12"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka aja mfufe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.12",
            "verseOrgIds": [
              "LEV.14.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 14:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-egbu nwa ebule ahụ nʼakụkụ ebe nsọ ahụ, nʼebe a na-anọ egbu anụ aja mmehie na aja nsure ọkụ. Ọ bụ onye nchụaja ga-ewere anụ aja ikpe ọmụma a, dịka o were nke aja mmehie. Ọ bụ ihe dịkarịsịrị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.13",
            "verseOrgIds": [
              "LEV.14.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 14:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ ga-ewere ụfọdụ nʼime ọbara aja ikpe ọmụma ahụ, tee nʼọnụ ntị aka nri nke onye ahụ a na-eme ka ọ dị ọcha. Ọ ga-etekwa ya nʼisi mkpụrụ aka nke aka nri ya, na nʼelu isi mkpụrụ ụkwụ nke ụkwụ aka nri ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.14",
            "verseOrgIds": [
              "LEV.14.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 14:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa onye nchụaja ga-awụnyetụ mmanụ oliv ahụ nʼọbụaka nke aka ekpe ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.15",
            "verseOrgIds": [
              "LEV.14.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 14:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ ga-arụnye otu mkpịsịaka nri ya nʼime mmanụ dị nʼọbụaka ya, ọ ga-ewere mkpịsịaka ya fesa ụfọdụ nʼime ya ugboro asaa nʼihu Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.16",
            "verseOrgIds": [
              "LEV.14.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 14:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-ewere mmanụ ahụ fọdụrụ nʼọbụaka ya tee ya onye ahụ nʼọnụ ntị aka nri nke onye ahụ a na-aga ime ka ọ dị ọcha, na nʼisi mkpụrụ aka nke aka nri ya, na nʼisi mkpụrụ ụkwụ nke aka nri ya, nʼelu ọbara aja ikpe ọmụma ahụ mee.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.17",
            "verseOrgIds": [
              "LEV.14.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 14:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ete mmanụ ahụ fọdụrụ nʼaka ya, nʼisi onye ahụ a na-eme ka ọ dị ọcha. Onye nchụaja ga-ekpuchikwara ha mmehie ya nʼihu Onyenwe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.18",
            "verseOrgIds": [
              "LEV.14.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 14:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ahụ, onye nchụaja ga-achụ aja mmehie, kpuchiere onye ahụ a ga-eme ka ọ dị ọcha site na-adịghị ọcha ha mmehie ya. Emesịa, onye nchụaja ga-egbu aja nsure ọkụ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.19",
            "verseOrgIds": [
              "LEV.14.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 14:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "were ya na onyinye mkpụrụ ọka chụọrọ onye ahụ aja, maka ikpuchiri ya mmehie ya. Mgbe ahụ, a ga-agụ onye ahụ nʼonye dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.20",
            "verseOrgIds": [
              "LEV.14.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 14:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụrụ na ọ bụ ogbenye onye na-enweghị ike iweta ihe ndị a, ha aghaghị iwere otu nwa ebule dịka aja ikpe ọmụma nke a ga-efufe nʼihi aja ikpuchi mmehie ha, Ọ ga-ewetakwa iko ọka a kwọrọ nke ọma asaa maọbụ ihe ọtụtụ efaa a gwara mmanụ oliv dịka aja mkpụrụ ọka, ya na otu iko mmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.21",
            "verseOrgIds": [
              "LEV.14.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 14:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewetakwa nduru abụọ maọbụ kpalakwukwu abụọ, nke ọbụla o nwere ike iweta. Otu ga-abụ maka aja mmehie, nke ọzọ ga-abụ maka aja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.22",
            "verseOrgIds": [
              "LEV.14.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 14:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ ga-ewere ha nye onye nchụaja nʼọnụ ụzọ ụlọ nzute nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.23",
                "verseOrgIds": [
                  "LEV.14.23"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼụbọchị nke asatọ ya, maka ime ka ha dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.23",
            "verseOrgIds": [
              "LEV.14.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 14:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-ewerekwa nwa atụrụ aja ikpe ọmụma ahụ, ya na otu iko mmanụ oliv ahụ, fufee ha nʼihu ebe ịchụ aja nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.24",
                "verseOrgIds": [
                  "LEV.14.24"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.24",
            "verseOrgIds": [
              "LEV.14.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 14:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-egbu nwa atụrụ aja ikpe ọmụma ahụ, were ụfọdụ ọbara ya tee nʼọnụ ntị aka nri onye ahụ a na-aga ime ka ọ dị ọcha, na nʼisi mkpụrụ aka nke aka nri ya, na nʼisi mkpụrụ ụkwụ nke aka nri ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.25",
            "verseOrgIds": [
              "LEV.14.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 14:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ ga-awụnye ụfọdụ mmanụ oliv ahụ nʼọbụaka nke aka ekpe ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.26",
            "verseOrgIds": [
              "LEV.14.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 14:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ ga-ewere mkpịsịaka nri ya fesa ụfọdụ mmanụ ahụ nke dị nʼọbụaka ya ugboro asaa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.27",
                "verseOrgIds": [
                  "LEV.14.27"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.27",
            "verseOrgIds": [
              "LEV.14.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 14:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-etekwa ụfọdụ mmanụ ahụ dị nʼaka ya nʼebe ndị ahụ o tere ọbara ikpe ọmụma ahụ, nke bụ nʼọnụ ntị onye ahụ nke a na-eme ka ọ dị ọcha, na nʼisi mkpụrụ aka nke aka nri ya, na nʼisi mkpụrụ ụkwụ nke aka nri ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.28",
            "verseOrgIds": [
              "LEV.14.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 14:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmanụ nke fọdụrụ nʼaka ya ka onye nchụaja ga-ete nʼisi onye ahụ a na-eme ka ọ dị ọcha, ikpuchi mmehie ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.29",
                "verseOrgIds": [
                  "LEV.14.29"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.29",
            "verseOrgIds": [
              "LEV.14.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 14:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ọ ga-eji nduru abụọ ahụ maọbụ kpalakwukwu abụọ ahụ, nke ọbụla o nwere ike iweta, chụọ aja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.30",
            "verseOrgIds": [
              "LEV.14.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 14:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ga-abụ maka aja mmehie, nke ọzọ ga-abụ maka aja nsure ọkụ, ha na aja mkpụrụ ọka. Nʼụzọ dị otu a, onye nchụaja ga-ekpuchiri ya mmehie ya nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.31",
                "verseOrgIds": [
                  "LEV.14.31"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ onye ahụ a na-eme ka ọ dị ọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.31",
            "verseOrgIds": [
              "LEV.14.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 14:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ usoro iwu dịrị onye ọbụla e sitere nʼọrịa ekpenta mee ka ọ dị ọcha, onye aka ya na-erughị iweta ihe o kwesiri iweta, bụ nke e ji eme ka ọ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.32",
            "verseOrgIds": [
              "LEV.14.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrịa na-efe efe dị nʼụlọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 14:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.14.33",
                "verseOrgIds": [
                  "LEV.14.33"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.33",
            "verseOrgIds": [
              "LEV.14.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 14:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe unu banyere ala Kenan, bụ ala ahụ m na-enye unu, ọ bụrụ na o nwee ụlọ ọbụla m webatara ọrịa na-efe efe,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.34",
            "verseOrgIds": [
              "LEV.14.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 14:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "onyenwe ụlọ ahụ ga-ejekwuru onye nchụaja sị ya, 'Ahụla m ihe yiri ọrịa na-efe efe nʼụlọ m.'",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.35",
            "verseOrgIds": [
              "LEV.14.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 14:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ ga-enye iwu ka a kwapụsịa ihe niile dị nʼụlọ ahụ tupu ọ gaa lezie ụlọ ahụ anya, ka ihe niile dị nʼụlọ ahụ ghara ịbụ ihe rụrụ arụ, ma ọ bụrụ na achọpụta ọrịa na-efe efe nʼụlọ ahụ. Mgbe a kwapụtasịrị ihe dị nʼụlọ ahụ, onye nchụaja ga-aga lee ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.36",
            "verseOrgIds": [
              "LEV.14.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 14:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ele ntụpọ dị nʼahụ ụlọ ahụ. Ọ bụrụ na ntụpọ ahụ na-acha ahịhịa ndụ ahịhịa ndụ, maọbụ ọbara ọbara,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "text": "ọ bụrụkwa na ha miri emi karịa aja ụlọ ahụ nʼile anya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.37",
            "verseOrgIds": [
              "LEV.14.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 14:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja ga-esi nʼọnụ ụzọ ụlọ ahụ pụọ, kpọchie ụlọ ahụ ụbọchị asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.38",
            "verseOrgIds": [
              "LEV.14.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 14:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa, onye nchụaja ga-alọghachi bịa lee ụlọ ahụ ọzọ. Ọ bụrụ na ntụpọ ahụ agbasaala nʼaja ụlọ ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.39",
            "verseOrgIds": [
              "LEV.14.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 14:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja ga-enye iwu ka e tida akụkụ aja ụlọ ahụ bufuo ya nʼebe a na-ekpofu ihe rụrụ arụ nʼazụ obodo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.40",
            "verseOrgIds": [
              "LEV.14.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 14:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-enyekwa iwu ka a kpụchaa aja ụlọ niile dị nʼime ụlọ ahụ, bufukwaa aja niile a kpụchapụtara nʼebe a na-ekpofu ihe rụrụ arụ nʼazụ obodo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.41",
            "verseOrgIds": [
              "LEV.14.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 14:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-ebute nkume ọzọ jiri ha dochie ndị ahụ e bupụsịrị. A ga-ejikwa ụrọ ọhụrụ tee ụlọ ahụ ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.42",
            "verseOrgIds": [
              "LEV.14.42"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 14:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na ntụpọ ahụ apụta ọzọ, mgbe e bupụsịrị nkume ndị ahụ, ma mgbe a kpuchasịrị aja ụlọ ma techikwaa ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.43",
            "verseOrgIds": [
              "LEV.14.43"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 14:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nchụaja ga-abịa lee ya. Ọ bụrụ na ọ hụ na ntụpọ ahụ agbasaala ọzọ, ọ ga-agụ ụlọ ahụ dịka ihe rụrụ arụ, nʼihi na ntụpọ ahụ bụ ọrịa na-efe efe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.44",
            "verseOrgIds": [
              "LEV.14.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 14:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-enye iwu ka a kwatuo ụlọ ahụ bufukwaa ihe niile e jiri rụọ ya, nkume niile, osisi niile na ụrọ niile, nʼebe a na-ekpofu ihe rụrụ arụ nʼazụ obodo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.45",
            "verseOrgIds": [
              "LEV.14.45"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 14:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye ọbụla banyere nʼụlọ ahụ nʼoge e mechiri ya, ga-abụ onye rụrụ arụ ruo nʼoge uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.46",
            "verseOrgIds": [
              "LEV.14.46"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 14:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla dinara ala maọbụ rie nri nʼime ya, ga-asacha uwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.47",
            "verseOrgIds": [
              "LEV.14.47"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 14:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na onye nchụaja abịa hụ na ntụpọ ahụ apụtaghị ọzọ, mgbe e techara ụlọ ahụ ụrọ nke ugboro abụọ, ọ ga-agụ ya nʼụlọ dị ọcha, nʼihi na ọrịa ahụ na-efe efe alaala.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.48",
            "verseOrgIds": [
              "LEV.14.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 14:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ejikwa nnụnụ abụọ, na osisi sida, na ogho uhie, na osisi hisọp mee mmemme ido ihe ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.49",
            "verseOrgIds": [
              "LEV.14.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 14:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-egbu otu nʼime nnụnụ ndị ahụ nʼelu mmiri e si nʼiyi na-asọ asọ kute, nke dị nʼime ite aja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.50",
            "verseOrgIds": [
              "LEV.14.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 14:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-edenye osisi sida ahụ, na ogho uhie ahụ, na osisi hisọp ahụ, nʼime ọbara nnụnụ ahụ na mmiri ahụ. Ọ ga-efesa ọbara ahụ nʼụlọ ahụ ugboro asaa.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.51",
            "verseOrgIds": [
              "LEV.14.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 14:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ọbara nnụnụ ahụ, na mmiri ahụ, na nnụnụ nke ọzọ ahụ dị ndụ, na osisi sida ahụ na hisọp ahụ, na ogho uhie ahụ ka ọ ga-eji mee ka ụlọ ahụ dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.52",
            "verseOrgIds": [
              "LEV.14.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 14:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ahapụ nnụnụ ahụ dị ndụ ka o fepụ felaa nʼọhịa dị nʼazụ obodo. Nke a ga-abụ otu e si kpuchiere ụlọ ahụ mmehie ya. Ọ ga-adịkwa ọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.53",
            "verseOrgIds": [
              "LEV.14.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
            "sid": "LEV 14:54"
          },
          "items": [
            {
              "text": "54",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ usoro iwu metụtara ọrịa ekpenta, na ọkọ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.54",
            "verseOrgIds": [
              "LEV.14.54"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "55",
            "style": "v",
            "sid": "LEV 14:55"
          },
          "items": [
            {
              "text": "55",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ọrịa na-efe efe dị nʼuwe maọbụ nʼụlọ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.55",
            "verseOrgIds": [
              "LEV.14.55"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "56",
            "style": "v",
            "sid": "LEV 14:56"
          },
          "items": [
            {
              "text": "56",
              "type": "text"
            }
          ]
        },
        {
          "text": "maọbụ etuto, maọbụ ntụpọ, maọbụ ọnya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.56",
            "verseOrgIds": [
              "LEV.14.56"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "57",
            "style": "v",
            "sid": "LEV 14:57"
          },
          "items": [
            {
              "text": "57",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu ndị a ga-enye aka ịmata ihe rụrụ arụ maọbụ ihe na-adịghị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.14.57",
            "verseOrgIds": [
              "LEV.14.57"
            ]
          }
        }
      ]
    },
    {
