  "verseCount": 55,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "25",
        "style": "c",
        "sid": "LEV 25"
      },
      "items": [
        {
          "text": "25",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afọ izuike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 25:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.1",
                "verseOrgIds": [
                  "LEV.25.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu nʼugwu Saịnaị sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.1",
            "verseOrgIds": [
              "LEV.25.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 25:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel sị ha, 'Mgbe unu batara nʼala ahụ m ga-enye unu, unu ga-eme ka ala ahụ nwee afọ izuike nke ya nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.2",
                "verseOrgIds": [
                  "LEV.25.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.2",
            "verseOrgIds": [
              "LEV.25.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 25:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afọ isii ka unu ga-akụ ihe nʼubi, afọ isii ka unu ga-ewe ihe ubi, kwachaakwa alaka osisi vaịnị unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.3",
            "verseOrgIds": [
              "LEV.25.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 25:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe o ruru afọ nke asaa, unu ga-ahapụ ala ubi unu ka o zuo ike, afọ izuike nye",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.4",
                "verseOrgIds": [
                  "LEV.25.4"
                ]
              }
            }
          ]
        },
        {
          "text": ". Unu akụla ihe ọbụla nʼubi unu maọbụ kwachaa osisi vaịnị unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.4",
            "verseOrgIds": [
              "LEV.25.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 25:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu agaghị ewe ihe ubi ọbụla ga-epupụtara onwe ha nʼoge a, maọbụ tụtụọ mkpụrụ osisi vaịnị ndị ga-ada ada. Nʼihi na afọ ahụ bụ afọ ozuzu ike dịrị ala ubi niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.5",
            "verseOrgIds": [
              "LEV.25.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 25:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ubi puputara nʼala ahụ niile nʼafọ izuike ahụ bụ nri dịrị unu onwe unu, na ndị odibo nwoke na nwanyị unu niile, na onye i goro ọrụ, na onye ọbịa bi nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.6",
            "verseOrgIds": [
              "LEV.25.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 25:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ubi ahụ dịkwara anụ ụlọ gị, na anụ ọhịa bi nʼala gị. Ihe ọbụla puputara nʼala bụ ihe unu ga-eri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.7",
            "verseOrgIds": [
              "LEV.25.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Afọ iri ise nke inwere onwe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 25:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gụpụta afọ izuike asaa, afọ asaa, ụzọ asaa. Ngụkọ afọ izuike ndị a niile ga-enye iri afọ anọ na itoolu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.8",
            "verseOrgIds": [
              "LEV.25.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 25:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke iri nke ọnwa asaa, zipụ onye ga-egbu opi ike, ya bụ, nʼụbọchị mkpuchi mmehie, a ga-egbu opi ike nʼala Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.9",
            "verseOrgIds": [
              "LEV.25.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 25:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Doonụ afọ nke iri ise ahụ nsọ, kwusaakwa inwere onwe nye mmadụ niile nʼala ahụ niile. Afọ ahụ ga-abụ afọ inwere onwe",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "text": "nye unu. Onye ọbụla nʼime unu ga-alaghachi nʼihe onwunwe nke ezinaụlọ ya, onye ọbụla kwa ga-alaghachi nʼagbụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.10",
            "verseOrgIds": [
              "LEV.25.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 25:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afọ nke iri ise bụ afọ inwere onwe nye unu. A gaghị akụ ihe ọbụla nʼubi, a gakwaghị ewe ihe ubi ọbụla puputara nʼonwe ya, maọbụ mkpụrụ osisi vaịnị mịrị nʼonwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.11",
            "verseOrgIds": [
              "LEV.25.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 25:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ afọ inwere onwe, bụrụkwa afọ dị nsọ nye unu, nke onye ọbụla ga-eri naanị ihe e wetara nʼubi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.12",
            "verseOrgIds": [
              "LEV.25.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 25:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye ọbụla ga-alaghachi nʼihe onwunwe nke ya, nʼafọ inwere onwe a.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.13",
            "verseOrgIds": [
              "LEV.25.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 25:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na i resiri onye agbataobi gị ala, maọbụ na o nwere nke ọ zụrụ site nʼaka gị, unu aghọgbula ibe unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.14",
            "verseOrgIds": [
              "LEV.25.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 25:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-azụrụ ala site nʼaka onye agbataobi dịka ọnụọgụgụ afọ si dị site nʼafọ inwere onwe. Ha ga-eresi gị ya dịka ọnụọgụgụ afọ ole fọdụrụ maka ịkọ ihe nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.15",
            "verseOrgIds": [
              "LEV.25.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 25:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na a zụrụ ala ahụ nso nso mmemme iri afọ ise a, ọnụahịa ala ahụ ga-adị ala, ọ bụrụkwanụ na ọ dị anya site na mmemme ahụ, ọnụahịa ya ga-adị elu, nʼihi na ụgwọ onye ahụ na-akwụ bụ ụgwọ ugboro ole ọ ga-akụ ihe nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.16",
            "verseOrgIds": [
              "LEV.25.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 25:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu emegbula ibe unu kama tụọnụ egwu Chineke unu. Abụ m",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.17",
                "verseOrgIds": [
                  "LEV.25.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.17",
            "verseOrgIds": [
              "LEV.25.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 25:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Gbasoonụ ụkpụrụ m, ma lezie anya imezu ihe m nyere nʼiwu, ka unu nwee ike ibi obi udo nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.18",
            "verseOrgIds": [
              "LEV.25.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 25:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ala ga-amị mkpụrụ ya, unu ga-eriju afọ, birikwa nʼala ahụ nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.19",
            "verseOrgIds": [
              "LEV.25.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 25:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu nwere ike jụọ ajụjụ sị, \"Gịnị ka anyị ga-eri nʼafọ nke asaa ahụ ebe ọ bụ na anyị agaghị akụ ihe ọbụla, maọbụ wee ihe ubi ọbụla nʼafọ ahụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.20",
            "verseOrgIds": [
              "LEV.25.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 25:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ezitere unu ngọzị dị ukwuu nʼafọ nke isii, nke ga-eme ka ala mee ihe omume nke ga-ezuru unu afọ atọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.21",
            "verseOrgIds": [
              "LEV.25.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 25:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe unu ga-akụ ihe ubi nʼafọ nke asatọ unu ga na-eri site nʼowuwe ihe ubi ochie unu tutu ruo nʼafọ nke itoolu mgbe unu ga-ewebata ihe ubi ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.22",
            "verseOrgIds": [
              "LEV.25.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 25:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Chetanụ na ala bụ nke m, nʼihi nke a, o kwesighị ka unu ree ala ọbụla kpamkpam. Unu bụ naanị ndị ọbịa na ndị nlekọta nye m.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.23",
            "verseOrgIds": [
              "LEV.25.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 25:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼala obibi unu niile, unu ga-enye ohere maka mgbapụta ala erere ere.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.24",
            "verseOrgIds": [
              "LEV.25.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 25:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na otu onye nʼime unu aghọọ onye ogbenye si otu a ree ala ya, nwanna ya dị ya nso ga-abịa gbapụta ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.25",
            "verseOrgIds": [
              "LEV.25.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 25:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na-enweghị onye ga-agbapụta ala ahụ nye ha, ma ha mesịa ghọọ ndị bara ụba nwekwa ihe ga-ezu ịgbapụta ala ahụ nʼonwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.26",
            "verseOrgIds": [
              "LEV.25.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 25:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-agụ afọ ole gara site na mgbe o rere ala ahụ, nyeghachi ya ego ole o kwesiri inweta. Onye rere ala ga-alaghachikwa nʼala ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.27",
            "verseOrgIds": [
              "LEV.25.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 25:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onyenwe ya enweghị ike ịchọta ego ọ ga-eji gbara ya, ala ahụ ga-adị nʼaka onye ahụ zụrụ ya tutu ruo nʼafọ inwere onwe. Mgbe ahụ ọ ga-ewerekwa ala ahụ nyeghachi ya onye resiri ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.28",
            "verseOrgIds": [
              "LEV.25.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 25:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye ọbụla rere ụlọ obibi dị nʼobodo e ji mgbidi gbaa gburugburu nwere ikike mgbapụta ya naanị mgbe otu afọ zuru site na mgbe e rere ya. Nʼoge ahụ ka onye rere ya nwere ike ịgbaghachi ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.29",
            "verseOrgIds": [
              "LEV.25.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 25:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na a gbapụtaghị ya tupu otu afọ agafee, ụlọ ahụ dị nʼime obodo nwere mgbidi ga-abụ nke onye ahụ zụrụ ya mgbe niile, bụrụkwa nke ụmụ ụmụ ya. A gaghị enyeghachikwa ya mgbe afọ inwere onwe ruru.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.30",
            "verseOrgIds": [
              "LEV.25.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 25:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụlọ ndị dị nʼobodo nta na-enweghị mgbidi a ga-agụ ha dịka ihe dị nʼọhịa. E nwere ike ịgbapụta ha, ha bụkwa nke a ga-eweghachite mgbe afọ inwere onwe ruru.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.31",
            "verseOrgIds": [
              "LEV.25.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 25:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma banyere obodo niile nke ndị Livayị dị iche iche. Ha nwere ikike ịgbapụta ụlọ ha dị nʼime nketa ha mgbe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.32",
            "verseOrgIds": [
              "LEV.25.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 25:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe onwunwe ndị Livayị bụ nke e nwere ike ịgbapụta, bụ ndị a, ụlọ niile e rere nke dị nʼobodo ha nwere. Ọ ga-abụ nʼafọ inwere onwe ka aga enwetaghachi ha, nʼihi na ụlọ ndị ahụ dị nʼobodo ndị Livayị bụ naanị oke ha nwere nʼetiti ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.33",
            "verseOrgIds": [
              "LEV.25.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 25:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma a gaghị ere ala ebe ịta nri nke anụ ụlọ gbara obodo ha gburugburu ere, nʼihi ọ bụ ihe ha nwee nʼọha ruo ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.34",
            "verseOrgIds": [
              "LEV.25.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LEV 25:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na nwanne gị adaa ogbenye ruo na o nweghị ike inyere onwe ya aka, ọ dị gị nʼaka inyere ya aka, kpọbata ya ka ọ bịa biri nʼụlọ gị dịka ị ga-esi kpọbata onye ọbịa. Nʼụzọ dị otu a, ọ ga-anọgide biri nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.35",
            "verseOrgIds": [
              "LEV.25.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LEV 25:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụọ egwu Chineke, kwerekwa ka nwanna gị soro gị biri nʼala ahụ. A nakwala ụma maọbụ ọmụrụnwa ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.36",
            "verseOrgIds": [
              "LEV.25.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LEV 25:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị gaghị ana ọmụrụnwa nʼego i gbazinyere ha, maọbụ rie uru site na nri i resiri ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.37",
            "verseOrgIds": [
              "LEV.25.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "LEV 25:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.25.38",
                "verseOrgIds": [
                  "LEV.25.38"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu, onye kpọpụtara unu site nʼala Ijipt, inye unu ala Kenan, na ị bụ Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.38",
            "verseOrgIds": [
              "LEV.25.38"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "LEV 25:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na onye Izrel ọbụla adaa ogbenye, resi gị onwe ya, emela ka o jere gị ozi dịka onye ohu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.39",
            "verseOrgIds": [
              "LEV.25.39"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "LEV 25:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama ị ga-emeso ya mmeso dịka ị ga-esi meso onye ọrụ e goro ego, maọbụ dịka onye ọbịa nọ nʼetiti unu. Ọ ga-ejere gị ozi tutu ruo afọ inwere onwe.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.40",
            "verseOrgIds": [
              "LEV.25.40"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "LEV 25:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ ahụ, ị ga-ahapụ ha na ụmụ ha ka ha laghachikwuru ndị ikwu ha, si otu a nwetaghachi ala ubi dị nʼezinaụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.41",
            "verseOrgIds": [
              "LEV.25.41"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "42",
            "style": "v",
            "sid": "LEV 25:42"
          },
          "items": [
            {
              "text": "42",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na a kpọpụtara m ndị Izrel site nʼala Ijipt ka ha bụrụ ndị na-ejere m ozi. Ya mere, a gaghị ere ha mgbe ọbụla dịka ohu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.42",
            "verseOrgIds": [
              "LEV.25.42"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "43",
            "style": "v",
            "sid": "LEV 25:43"
          },
          "items": [
            {
              "text": "43",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gakwaghị emegbu ha nʼụzọ dị njọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        },
        {
          "text": "Tụọnụ egwu Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.43",
            "verseOrgIds": [
              "LEV.25.43"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "44",
            "style": "v",
            "sid": "LEV 25:44"
          },
          "items": [
            {
              "text": "44",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma unu nwere ike gbara ndị ohu nwoke maọbụ nwanyị site nʼetiti ndị mba ọzọ niile bi nʼakụkụ unu. Unu nwere ike site nʼebe ahụ zụta ndị ohu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.44",
            "verseOrgIds": [
              "LEV.25.44"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "45",
            "style": "v",
            "sid": "LEV 25:45"
          },
          "items": [
            {
              "text": "45",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu nwere ike ịzụ ndị ohu site nʼetiti ndị mbịarambịa bi nʼetiti unu, maọbụ site nʼetiti ndị agbụrụ ha a mụrụ nʼala Izrel. Ndị dị otu a ga-abụkwa ihe onwunwe unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.45",
            "verseOrgIds": [
              "LEV.25.45"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "46",
            "style": "v",
            "sid": "LEV 25:46"
          },
          "items": [
            {
              "text": "46",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu nwere ike kenye ha ụmụ unu dịka ihe nketa, ma mee ha ndị ohu unu ụbọchị ndụ ha niile. Ma unu agaghị eji aka ike chịa onye Izrel ibe unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.46",
            "verseOrgIds": [
              "LEV.25.46"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "47",
            "style": "v",
            "sid": "LEV 25:47"
          },
          "items": [
            {
              "text": "47",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na onye ọbịa bi nʼetiti unu aghọọ ọgaranya, ma otu nʼime ụmụnna unu adaa ogbenye were onwe ya resi onye ọbịa ahụ bi nʼetiti unu, maọbụ were onwe ya resi nwanna ndị ikwu onye ọbịa ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.47",
            "verseOrgIds": [
              "LEV.25.47"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "48",
            "style": "v",
            "sid": "LEV 25:48"
          },
          "items": [
            {
              "text": "48",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha nwere ikike ịgbapụta ya mgbe ha resiri onwe ha. Otu nʼime ụmụnna ya nwere ike gbapụta ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.48",
            "verseOrgIds": [
              "LEV.25.48"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "49",
            "style": "v",
            "sid": "LEV 25:49"
          },
          "items": [
            {
              "text": "49",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanne nne ya, maọbụ nwanne nna ya, maọbụ nwanna nʼikwu ha",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.49",
            "verseOrgIds": [
              "LEV.25.49"
            ]
          }
        },
        {
          "text": "ọbụla nwere ike ịgbapụta ya. Ọ nwekwara ike ịgbapụta onwe ya ma ọ bụrụ na ọ kpata ego.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.49",
            "verseOrgIds": [
              "LEV.25.49"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "50",
            "style": "v",
            "sid": "LEV 25:50"
          },
          "items": [
            {
              "text": "50",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya na onye ahụ o resiri onwe ya ga-agụ afọ ole ọ bụ site na mgbe o rere onwe ya ruo nʼafọ inwere onwe. Ego a ga-akwụ nʼihi ịgbapụta ya ga-abụ ego ọ ga-efu ịkwụ ohu ọzọ ụgwọ ịrụ ọrụ ọnụọgụgụ afọ ndị ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.50",
            "verseOrgIds": [
              "LEV.25.50"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "51",
            "style": "v",
            "sid": "LEV 25:51"
          },
          "items": [
            {
              "text": "51",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ nʼọtụtụ afọ fọdụrụ, ọ ga-esite nʼọnụ ego e rere ha kwụọ nke dị ukwu dịka ego mgbapụta ha. Naanị ihe ntakịrị ga-apụ nʼime ego ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.51",
            "verseOrgIds": [
              "LEV.25.51"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "52",
            "style": "v",
            "sid": "LEV 25:52"
          },
          "items": [
            {
              "text": "52",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ naanị afọ ole na ole fọdụrụ tupu afọ inwere onwe eruo, ọ ga-agụkọ ihe ego ahụ pụtara, kwụọ ya maka ịgbara onwe ya dịka o kwesiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.52",
            "verseOrgIds": [
              "LEV.25.52"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "53",
            "style": "v",
            "sid": "LEV 25:53"
          },
          "items": [
            {
              "text": "53",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-emeso ha dịka ndị ọrụ e goro ego kwa afọ, ma ị ga-ahụ na onye ha nọ nʼokpuru ya agaghị eji aka ike chịa ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.25.53",
            "verseOrgIds": [
              "LEV.25.53"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "54",
            "style": "v",
