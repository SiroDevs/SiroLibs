          "text": "16",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụbọchị mkpuchi mmehie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis okwu mgbe ụmụ ndị ikom Erọn abụọ ndị ahụ bịara nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.1",
                "verseOrgIds": [
                  "LEV.16.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.1",
            "verseOrgIds": [
              "LEV.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.2",
                "verseOrgIds": [
                  "LEV.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị Mosis, \"Gwa nwanne gị nwoke Erọn si ya ka ọ ghara ịbata mgbe ọbụla ọ chọrọ, nʼime Ebe ahụ Kachasị Nsọ nke dị nʼazụ akwa mgbochi, nke dị nʼihu ebe mkpuchi mmehie dị nʼelu igbe ọgbụgba ndụ ahụ, ma ọ bụghị ya ọ ga-anwụ. Nʼihi na aga m apụta ìhè nʼime igwe ojii dị nʼelu ebe mkpuchi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.2",
            "verseOrgIds": [
              "LEV.16.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Otu a ka Erọn ga-esi na-abata nʼEbe ahụ Kachasị Nsọ. Ọ ga-eweta nwa oke ehi nʼihi aja mmehie, na ebule ọ ga-eji chụọ aja nsure ọkụ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.3",
            "verseOrgIds": [
              "LEV.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eyikwasị onwe ya uwe mwụda ọcha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "text": "ya na uwe ime ahụ dị ọcha. Ọ ga-eke gburugburu ukwu ya ihe ike nʼukwu akwa ọcha, keekwa akwa ọcha nʼisi ya. Ndị a bụ uwe dị nsọ, nʼihi ya, ọ ga-ebu ụzọ saa ahụ tupu ọ na-eyi ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.4",
            "verseOrgIds": [
              "LEV.16.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-esi nʼaka ọgbakọ ụmụ Izrel nata mkpi abụọ nʼihi aja mmehie, na otu ebule nʼihi aja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.5",
            "verseOrgIds": [
              "LEV.16.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Erọn ga-eweta oke ehi nke ya, maka aja mmehie iji kpuchie mmehie nke ya na nke ezinaụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.6",
            "verseOrgIds": [
              "LEV.16.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ọ ga-ewere mkpi abụọ ndị ahụ chee ha nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.7",
                "verseOrgIds": [
                  "LEV.16.7"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼọnụ ụzọ ụlọ nzute ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.7",
            "verseOrgIds": [
              "LEV.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-efe nza nʼisi mkpi abụọ ahụ, ịchọpụta nke dịrị",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.8",
                "verseOrgIds": [
                  "LEV.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nke ọzọ abụrụ nke ọ ga-ahapụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.8",
            "verseOrgIds": [
              "LEV.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpi ahụ nza mara ga-abụ nke",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.9",
                "verseOrgIds": [
                  "LEV.16.9"
                ]
              }
            }
          ]
        },
        {
          "text": ", ya ka Erọn ga-egbu dịka aja mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.9",
            "verseOrgIds": [
              "LEV.16.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mkpi ahụ nke nza mara dịka ewu na-ewere ọnọdụ iburu mmehie ka a ga-eche na ndụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.10",
                "verseOrgIds": [
                  "LEV.16.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼihi iji ya mee mmemme mkpuchi mmehie, a ga-ahapụ ya ka o buru mmehie niile kpafuo nʼọzara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.10",
            "verseOrgIds": [
              "LEV.16.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Erọn ga-eweta oke ehi maka aja mmehie nke ya onwe ya, iji kpuchie mmehie ya na nke ezinaụlọ ya. Ọ ga-egbu oke ehi ahụ maka aja mmehie nke ya onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.11",
            "verseOrgIds": [
              "LEV.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-esite nʼebe ịchụ aja dị nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.12",
                "verseOrgIds": [
                  "LEV.16.12"
                ]
              }
            }
          ]
        },
        {
          "text": "were ihe ịgụ ọkụ jupụtara nʼicheku ọkụ. Ọ ga-ewerekwa ụda na-esi isi ụtọ ruru mkpoju aka abụọ, were ha bata nʼime akụkụ nke ọzọ nke akwa mgbochi ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.12",
            "verseOrgIds": [
              "LEV.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ọ ga-awụnye ụda ndị ahụ na-esi isi ụtọ nʼelu icheku ọkụ ahụ nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.13",
                "verseOrgIds": [
                  "LEV.16.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ka anwụrụ ọkụ nke ụda ndị a kpuchie ebe mkpuchi mmehie ahụ dị nʼelu Ihe Ama ahụ ka ọ ghara ịnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.13",
            "verseOrgIds": [
              "LEV.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ewebatakwa ụfọdụ ọbara oke ehi ahụ, jiri mkpịsịaka ya fesa ya nʼihu ebe mkpuchi mmehie ahụ, nʼakụkụ ọwụwa anyanwụ, fesakwa ya ugboro asaa nʼihu ebe mkpuchi mmehie ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.14",
            "verseOrgIds": [
              "LEV.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Emesịa, ọ ga-esi nʼebe ahụ pụọ gaa gbuo mkpi aja mmehie ụmụ Izrel, werekwa ọbara ya bata nʼazụ akwa mgbochi fesa ya nʼelu ebe mkpuchi mmehie ahụ, na nʼihu ya, dịka o jiri ọbara nwa oke ehi ahụ mee.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.15",
            "verseOrgIds": [
              "LEV.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, ọ ga-ekpuchiri Ebe ahụ Kachasị Nsọ mmehie ya, nʼihi mmehie na nnupu isi ụmụ Izrel, ihe ọbụla mmehie ndị ahụ bụ. Ọ ga-achụkwa ụdị aja a nʼihi ụlọ nzute ahụ, nʼihi na ọ dị nʼetiti ebe obibi rụrụ arụ nke ụmụ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.16",
            "verseOrgIds": [
              "LEV.16.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị onye ọbụla ọzọ ga-anọ nʼime ụlọ nzute ahụ, site nʼoge Erọn banyere nʼEbe ahụ Kachasị Nsọ ịchụ aja mkpuchi mmehie tutu ruo mgbe ọ pụtara, mgbe ọ chụchara aja mkpuchi mmehie maka onwe ya na ezinaụlọ ya, na maka ụmụ Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.17",
            "verseOrgIds": [
              "LEV.16.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe o si nʼebe ahụ pụta, gaa nʼebe ịchụ aja dị nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.18",
                "verseOrgIds": [
                  "LEV.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kpuchiere ya mmehie ya. Ọ ga-ewere ụfọdụ ọbara nwa oke ehi ahụ na nke mkpi ahụ tee ya na mpi niile dị nʼebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.18",
            "verseOrgIds": [
              "LEV.16.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eji mkpịsịaka ya fesa ụfọdụ ọbara ahụ nʼelu ebe ịchụ aja ahụ ugboro asaa iji hichapụ adịghị ọcha ya nʼihi ịrụ arụ ụmụ Izrel, na ido ya nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.19",
            "verseOrgIds": [
              "LEV.16.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe Erọn chụchara aja mkpuchi mmehie maka Ebe ahụ Kachasị Nsọ, ụlọ nzute, nakwa ebe ịchụ aja, ọ ga-akpụbata mkpi ahụ e debere ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.20",
            "verseOrgIds": [
              "LEV.16.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 16:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ebikwasị aka ya abụọ nʼisi ya, kwupụta ajọ omume na nnupu isi ụmụ Izrel niile, mmehie ha niile, bokwasị ha mkpi ahụ nʼisi. Ọ ga-ezipụ mkpi ahụ pụọ nʼime ọzara site nʼaka onye ahụ a họpụtara ime nke a.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.21",
            "verseOrgIds": [
              "LEV.16.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 16:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a, mkpi ahụ ga-eburu mmehie ndị ahụ niile baa nʼebe mmadụ ọbụla na-ebighị. Nwoke ahụ ga-ahapụkwa ya nʼọzara.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.22",
            "verseOrgIds": [
              "LEV.16.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 16:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ahụ, Erọn ga-aba nʼime ụlọ nzute ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "text": "yipụ uwe akwa ọcha ndị nchụaja ahụ niile o yi nʼahụ ya tupu ọ banye nʼEbe ahụ Kachasị Nsọ. Ọ ga-awụsa ha nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.23",
            "verseOrgIds": [
              "LEV.16.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 16:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eji mmiri saa ahụ ya nʼakụkụ ebe nsọ ahụ, yirikwa uwe efu ya. Mgbe ahụ, ọ ga-apụta bịa chụọ aja nsure ọkụ nke onwe ya, na aja nsure ọkụ nke ndị ahụ, maka ikpuchiri onwe ya, na ikpuchikwara ndị ahụ mmehie ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.24",
            "verseOrgIds": [
              "LEV.16.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 16:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-akpọkwa abụba anụ e ji chụọ aja mmehie ahụ ọkụ nʼelu ebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.25",
            "verseOrgIds": [
              "LEV.16.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 16:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe nwoke ahụ kpụgara mkpi ahụ nʼọzara hapụ ya, lọtara, ọ ga-asa ahụ ya na uwe ya tupu ọ laghachi nʼime obodo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.26",
            "verseOrgIds": [
              "LEV.16.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 16:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ehi nakwa mkpi maka ịchụ aja mmehie ahụ, bụ nke ewebatara ọbara ha nʼime Ebe ahụ Kachasị Nsọ, maka ikpuchi mmehie, ka aghaghị ibupụ nʼazụ ọmụma ụlọ ikwu; a ga-akpọ akpụkpọ ha, anụ ahụ ha na mgbịrị afọ ha niile ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.27",
            "verseOrgIds": [
              "LEV.16.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 16:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ga-akpọ ha ọkụ ga-asa uwe ya, saakwa ahụ ya tupu ọ laghachi nʼime obodo.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.28",
            "verseOrgIds": [
              "LEV.16.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 16:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a ga-abụrụ unu ụkpụrụ ebighị ebi. Nʼafọ ọbụla, unu ga-ebu ọnụ, hapụ ịrụ ọrụ ọbụla, nʼụbọchị iri nke ọnwa asaa. Iwu a dịrị nwa afọ ala maọbụ onye ọbịa bi nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.29",
            "verseOrgIds": [
              "LEV.16.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 16:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nʼụbọchị a ka a na-ekpuchiri unu mmehie unu, ime ka unu dịrị ọcha. Mgbe ahụ, unu ga-abụ ndị dị ọcha site na mmehie unu niile nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.30",
                "verseOrgIds": [
                  "LEV.16.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.30",
            "verseOrgIds": [
              "LEV.16.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 16:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ụbọchị izuike nye unu, bụrụkwa ụbọchị unu ga-ebu ọnụ. Iwu a enweghị mgbanwe!",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.31",
            "verseOrgIds": [
              "LEV.16.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 16:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja e tere mmanụ, nke e doro nsọ dịka onye nchụaja ịnọchi nna ya, ga-achụ aja mkpuchi mmehie ndị a, yirikwa akwa ọcha ahụ, bụ uwe nsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.32",
            "verseOrgIds": [
              "LEV.16.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 16:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ekpuchiri Ebe ahụ Kachasị Nsọ na ụlọ nzute, ebe ịchụ aja na ndị nchụaja, na mkpokọta ndị obodo niile mmehie ha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.33",
            "verseOrgIds": [
              "LEV.16.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LEV 16:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a ga-abụ iwu ebighị ebi nye unu. Otu ugboro nʼotu afọ ka a ga-ekpuchi mmehie maka mmehie ndị Izrel niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LEV 16:34"
      },
      "items": [
        {
          "text": "E mezuru ihe ndị a niile dịka",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.16.34",
                "verseOrgIds": [
                  "LEV.16.34"
                ]
              }
            }
          ]
        },
        {
          "text": "si nye ya Mosis nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.16.34",
            "verseOrgIds": [
              "LEV.16.34"
            ]
          }
        }
      ]
    }
  ],
