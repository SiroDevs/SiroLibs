  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "15",
        "style": "c",
        "sid": "LEV 15"
      },
      "items": [
        {
          "text": "15",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe nsọpụta ndị na-ebute adịghị ọcha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LEV 15:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.1",
                "verseOrgIds": [
                  "LEV.15.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara Mosis na Erọn okwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.1",
            "verseOrgIds": [
              "LEV.15.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LEV 15:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ụmụ Izrel okwu sị ha, 'Nwoke ọbụla ihe nsọpụta si nʼahụ ya na-asọpụta, bụ onye rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.2",
            "verseOrgIds": [
              "LEV.15.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LEV 15:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ahụ rụrụ arụ mgbe ihe ahụ si ya nʼahụ na-asọpụta, rụọkwa arụ mgbe ihe ahụ kwụsịrị ịsọ. Otu a ka ihe ọsụsọ ahụ si eme ka onye ahụ rụọ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.3",
            "verseOrgIds": [
              "LEV.15.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LEV 15:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ihe ọbụla onye ahụ ji anọdụ ala, maọbụ nke o ji dinaa bụ ihe rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.4",
            "verseOrgIds": [
              "LEV.15.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LEV 15:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla metụrụ ihe ndina ya aka ga-abụ onye rụrụ arụ ruo uhuruchi. Ọ ga-asa uwe ya, na ahụ ya mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.5",
            "verseOrgIds": [
              "LEV.15.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LEV 15:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla nọdụrụ ala nʼihe onye ahụ nọdụrụ ala nʼoge ahụ ọ bụ onye rụrụ arụ, ga-abụ onye rụrụ arụ ruo uhuruchi. Ọ ga-asa uwe ya, na ahụ ya mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.6",
            "verseOrgIds": [
              "LEV.15.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LEV 15:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye ọbụla metụrụ nwoke ahụ ihe si nʼahụ ya na-asọpụta aka ga-asa uwe ya na ahụ ya mmiri, bụrụ onye rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.7",
            "verseOrgIds": [
              "LEV.15.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LEV 15:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Onye ọbụla dị ọcha nke onye ahụ bụsara ọnụ mmiri ga-abụ onye rụrụ arụ ruo uhuruchi. Ọ ga-asa uwe ya na ahụ ya mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.8",
            "verseOrgIds": [
              "LEV.15.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LEV 15:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ihe ọbụla onye ahụ ji anọkwasị nʼelu anụmanụ ọ na-agba ga-abụ ihe rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.9",
            "verseOrgIds": [
              "LEV.15.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LEV 15:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla ga-eburu, maọbụ metụ ihe ọbụla o ji nọdụ ala aka ga-abụ onye rụrụ arụ ruo uhuruchi. Ọ ga-asa uwe ya na ahụ ya mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.10",
            "verseOrgIds": [
              "LEV.15.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LEV 15:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na nwoke ahụ rụrụ arụ ebughị ụzọ saa aka ya tupu o metụ mmadụ aka, onye ahụ o metụrụ aka ga-abụ onye rụrụ arụ ruo uhuruchi. Ọ ga-asa uwe ya na ahụ ya mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.11",
            "verseOrgIds": [
              "LEV.15.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LEV 15:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'A ga-etiwa ite aja ọbụla onye ahụ metụrụ aka, jiri mmiri ṅachaa ihe osisi ọbụla o metụrụ aka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.12",
            "verseOrgIds": [
              "LEV.15.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LEV 15:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe e mere ka onye ahụ bụrụ onye dị ọcha site nʼihe nsọpụta a, ọ ga-anọ ụbọchị asaa maka ịdị ọcha ya. Ọ ga-asa uwe ya na ahụ ya nʼime mmiri na-asọ asọ tupu ọ bụrụ onye dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.13",
            "verseOrgIds": [
              "LEV.15.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LEV 15:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asatọ, ọ ga-ewere nduru abụọ maọbụ ụmụ kpalakwukwu abụọ bịa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.14",
                "verseOrgIds": [
                  "LEV.15.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼọnụ ụzọ ụlọ nzute, were ha nye onye nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.14",
            "verseOrgIds": [
              "LEV.15.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LEV 15:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ga-eji ha chụọrọ ya aja nʼebe ahụ. Otu nʼime nnụnụ abụọ ahụ ga-abụ maka aja mmehie, nke ọzọ maka aja nsure ọkụ. Nʼụzọ dị otu a, ọ ga-ekpuchiri nwoke ahụ mmehie ya nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.15",
                "verseOrgIds": [
                  "LEV.15.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼihi ihe ọsụsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.15",
            "verseOrgIds": [
              "LEV.15.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LEV 15:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nwoke ọbụla mkpụrụ nwa ya si ya nʼamụ pụọ, ga-asa ahụ ya nke ọma, bụrụ onye rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.16",
            "verseOrgIds": [
              "LEV.15.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LEV 15:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-asacha ihe ọbụla mkpụrụ nwa ahụ metụrụ, maọbụ akwa maọbụ akpụkpọ anụ. Ha ga-abụ ihe rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.17",
            "verseOrgIds": [
              "LEV.15.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LEV 15:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe nwoke na nwanyị dinakọrọ, ma nwoke ahụ anyụpụta mkpụrụ nwa, ha abụọ ga-asa ahụ ha nke ọma, bụrụ ndị rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.18",
            "verseOrgIds": [
              "LEV.15.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LEV 15:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe ọbara si nwanyị nʼahụ pụọ dịka o kwesiri nʼoge a kara aka nʼọnwa ọbụla, nwanyị ahụ ga-abụ onye rụrụ arụ ụbọchị asaa. Onye ọbụla metụrụ ya aka nʼoge a ga-abụ onye rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.19",
            "verseOrgIds": [
              "LEV.15.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LEV 15:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ihe ọbụla o dinara nʼelu ya nʼoge a, maọbụ ihe ọ nọkwasịrị nʼelu ya ga-arụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.20",
            "verseOrgIds": [
              "LEV.15.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LEV 15:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla metụrụ ihe ndina ya aka, ga-asa uwe ya na ahụ ya. Ọ ga-abụ onye rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.21",
            "verseOrgIds": [
              "LEV.15.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LEV 15:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye metụrụ ihe o ji nọdụ ala aka ga-asa uwe ya na ahụ ya. Ọ ga-abụ onye rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.22",
            "verseOrgIds": [
              "LEV.15.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LEV 15:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwa na ọ bụ ihe ndina ya, maọbụ ihe ọzọ nke o ji nọdụ ala, onye ọbụla metụrụ ya aka ga-abụ onye rụrụ arụ ruo uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.23",
            "verseOrgIds": [
              "LEV.15.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LEV 15:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nwoke dinakwuru nwanyị ọbara si nʼahụ ya na-apụta, ọ bụrụ na ọbara ahụ emetụ ya, ọ ga-abụ onye rụrụ arụ abalị asaa. Ihe ndina ọbụla o dinara nʼelu ya ga-abụ ihe rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.24",
            "verseOrgIds": [
              "LEV.15.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LEV 15:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ọ bụrụ na ọbara si nwanyị nʼahụ na-apụta agafee oge o kwesiri ịkwụsị maọbụ na ọ pụtara nʼoge ọ na-ekwesighị ịpụta, nwanyị ahụ ga-anọgide bụrụ onye rụrụ arụ ogologo ụbọchị ndị ahụ niile ọbara ahụ si ya nʼahụ na-apụta.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.25",
            "verseOrgIds": [
              "LEV.15.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LEV 15:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọbụla o dinara nʼelu ya mgbe ọbara si ya nʼahụ na-apụta, maọbụ ihe ọbụla ọ nọdụrụ ala nʼelu ya, ga-abụ ihe rụrụ arụ, dịka mgbe ọbara nke oge a kara aka.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.26",
            "verseOrgIds": [
              "LEV.15.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LEV 15:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla metụrụ ihe ndina ya maọbụ ihe ọ nọdụrụ ala nʼelu ya aka, ga-arụ arụ ruo uhuruchi. Ọ ga-asakwa uwe ya na ahụ ya mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.27",
            "verseOrgIds": [
              "LEV.15.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LEV 15:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Mgbe ọbara ahụ kwụsịrị, ọ ga-agụ ụbọchị asaa site nʼoge ọ kwụsịrị. Mgbe abalị asaa ahụ zuru, ọ ga-abụ onye dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.28",
            "verseOrgIds": [
              "LEV.15.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LEV 15:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asatọ, ọ ga-ewere nduru abụọ maọbụ ụmụ kpalakwukwu abụọ, nye onye nchụaja nʼọnụ ụzọ ụlọ nzute.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.29",
            "verseOrgIds": [
              "LEV.15.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LEV 15:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nchụaja ahụ ga-eji otu chụọrọ ya aja mmehie, werekwa nke ọzọ chụọrọ ya aja nsure ọkụ. Nʼụzọ dị otu a, ọ ga-ekpuchiri ya mmehie ya nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "LEV.15.30",
                "verseOrgIds": [
                  "LEV.15.30"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼihi adịghị ọcha nke ihe ọsụsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.30",
            "verseOrgIds": [
              "LEV.15.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LEV 15:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Unu ga-ekewapụ ụmụ Izrel site nʼihe ndị ahụ na-emerụ ha, ka ha ghara ịnwụ nʼọnọdụ adịghị ọcha ha nʼihi imerụ ụlọ nzute m, nke dị nʼetiti ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.31",
            "verseOrgIds": [
              "LEV.15.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LEV 15:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ usoro iwu gbasara ndị ikom ihe si nʼahụ ha na-asọpụta, na ndị ikom rụrụ arụ nʼihi mkpụrụ nwa si ha nʼahụ pụọ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.32",
            "verseOrgIds": [
              "LEV.15.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LEV 15:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụkwa iwu dịrị nwanyị ọbara si nʼahụ ya pụọ nʼoge a kara aka, na nwoke maọbụ nwanyị ọbụla ihe si nʼahụ ya na-asọpụta, na nke dịrị nwoke ọbụla ya na nwanyị ga-edinakọ nʼoge nwanyị ahụ bụ onye rụrụ arụ.",
          "type": "text",
          "attrs": {
            "verseId": "LEV.15.33",
            "verseOrgIds": [
              "LEV.15.33"
            ]
          }
        }
      ]
    }
  ],
