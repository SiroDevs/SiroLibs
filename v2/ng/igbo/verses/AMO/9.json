      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:14"
      },
      "items": [
        {
          "text": "Ha ga-arụkwa ubi a gbara ogige, riekwa mkpụrụ si na ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
