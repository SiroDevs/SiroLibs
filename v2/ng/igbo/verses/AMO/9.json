      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:14"
      },
      "items": [
        {
          "text": "Ha ga-akụ ubi vaịnị a gbara ogige, ṅụọkwa mmanya si na ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.14",
            "verseOrgIds": [
              "AMO.9.14"
            ]
          }
        }
      ]
    },
