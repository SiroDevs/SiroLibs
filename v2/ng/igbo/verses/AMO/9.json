  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "AMO 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "A ga-ebibi Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "AMO 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m Onyenwe anyị ka ọ guzo nʼakụkụ ebe ịchụ aja, ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "\"Tie ọnụ ogidi ndị a ihe,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "ruo mgbe mbata ọnụ ụzọ ha niile mara jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Tipịasịa ha nʼisi mmadụ niile;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "aga m ejikwa mma agha gbuo ndị niile fọdụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "Ọ dịghị onye ga-agbapụ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:1"
      },
      "items": [
        {
          "text": "ọ dịkwaghị onye ga-ewezuga onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.1",
            "verseOrgIds": [
              "AMO.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "AMO 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ha egwuo ala ruo nʼala mmụọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "site nʼebe ahụ ka aka m ga-esi dọlie ha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "ọ bụrụkwa na ha arịgoruo ime eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:2"
      },
      "items": [
        {
          "text": "site nʼebe ahụ ka m ga-esi wedata ha nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.2",
            "verseOrgIds": [
              "AMO.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "AMO 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwa na ha ezoo onwe ha nʼelu Kamel",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "nʼebe ahụ ka m ga-esi chọpụta ha, kpụrụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "a sịkwa na ha ezoo onwe ha nʼala oke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:3"
      },
      "items": [
        {
          "text": "nʼebe ahụ ka m ga-enye ajụala nke mmiri iwu ka ọ taa ha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.3",
            "verseOrgIds": [
              "AMO.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "AMO 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na a dọta ha nʼagha mee ka ha gaa biri nʼala ndị mba ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "nʼebe ahụ aga m enye mma agha iwu ka o gbuo ha.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "AMO 9:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "\"Aga m elekwasị ha anya m abụọ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:4"
      },
      "items": [
        {
          "text": "nʼihi ime ha ihe ọjọọ, ọ bụghị ihe ọma.\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.4",
            "verseOrgIds": [
              "AMO.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "AMO 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyenwe anyị,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.5",
                "verseOrgIds": [
                  "AMO.9.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "onye na-emetụ ala aka mee ka ọ gbazee,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "ime ka ndị niile bi nʼala ruo ụjụ;",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "ala ya niile bilie na-ebili dịka mmiri nke osimiri Naịl,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:5"
      },
      "items": [
        {
          "text": "nke na-emesịakwa dajụọ dịka mmiri Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.5",
            "verseOrgIds": [
              "AMO.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "AMO 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-ewu ụlọ elu ya nʼeluigwe niile,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "na-eme ka ntọala ya dị nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "Onye na-akpọ mmiri nke osimiri oku,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "ma na-awụsa ha nʼala,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:6"
      },
      "items": [
        {
          "text": "aha ya bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.6",
                "verseOrgIds": [
                  "AMO.9.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.6",
            "verseOrgIds": [
              "AMO.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "AMO 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ na unu ndị Izrel",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "adịghị ka ndị Kush nʼebe m nọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.7",
                "verseOrgIds": [
                  "AMO.9.7"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "\"Ọ bụ na-esighị m nʼala Ijipt kpọpụta Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "site na Kafto kpọpụta ndị Filistia,",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "AMO 9:7"
      },
      "items": [
        {
          "text": "ma kpọpụtakwa ndị Aram site na Kia?",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.7",
            "verseOrgIds": [
              "AMO.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "AMO 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼezie, anya Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
            "verseOrgIds": [
              "AMO.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "AMO.9.8",
                "verseOrgIds": [
                  "AMO.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "dịkwasịrị",
          "type": "text",
          "attrs": {
            "verseId": "AMO.9.8",
