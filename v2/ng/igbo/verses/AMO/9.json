      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "AMO 9:14"
      },
      "items": [
        {
          "text": "\"Ha ga-ewugharị obodo niile tọgbọrọ nʼefu, birikwa nʼime ha.",
