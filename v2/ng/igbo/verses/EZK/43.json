    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 43:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụbọchị asaa, kwa ụbọchị ka ị ga-ewepụta otu mkpi, na nwa oke ehi, na nwa ebule site nʼigwe anụ ndị ahụ, chụọ aja mmehie. Ha niile ga-abụ ụmụ anụmanụ ndị na-enweghị ntụpọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.25",
            "verseOrgIds": [
              "EZK.43.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 43:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị asaa ka ha ga na-achụ aja ikpuchi mmehie nʼihi ebe ịchụ aja, mee ka ọ dị ọcha, site otu a doo ya nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.26",
            "verseOrgIds": [
              "EZK.43.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 43:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị nke asatọ, na nʼụbọchị ọbụla so ya, ndị nchụaja ga-achụ aja nsure ọkụ nʼebe ịchụ aja, chụọkwa aja udo. Mgbe ahụ, aga m anabatakwa unu. Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.27",
            "verseOrgIds": [
              "EZK.43.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.43.27",
                "verseOrgIds": [
                  "EZK.43.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.43.27",
            "verseOrgIds": [
              "EZK.43.27"
            ]
          }
        }
      ]
    }
