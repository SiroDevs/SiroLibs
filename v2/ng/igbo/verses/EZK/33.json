  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "EZK 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nlọghachi Izikiel dịka onye nche",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.1",
            "verseOrgIds": [
              "EZK.33.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.1",
                "verseOrgIds": [
                  "EZK.33.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.1",
            "verseOrgIds": [
              "EZK.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, gwa ndị gị okwu sị ha, 'Mgbe m wetara mma agha imegide mba ọbụla, ma ndị ala ahụ ahọpụta otu onye nʼetiti ha mee ya ka ọ ghọrọ ha onye nche,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.2",
            "verseOrgIds": [
              "EZK.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye ga-ahụ mma agha ka ọ na-abịakwasị ala ahụ, ọ bụrụ na o gbuo opi ike, ịdọ ndị bi na mba ahụ aka na ntị banyere mma agha nke na-abịa,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.3",
            "verseOrgIds": [
              "EZK.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụkwa na onye ọbụla anụ opi ike ahụ ma jụ ịnabatara onwe ya ịdọ aka na ntị ahụ, mma agha ahụ gbuo ya, ọbara ya ga-adịkwasị ya nʼisi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.4",
            "verseOrgIds": [
              "EZK.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha nụrụ ụda opi nke ịdọ aka na ntị ahụ ma ha geghị ntị. Ọ bụ ha wetaara onwe ha ịla nʼiyi. A sị na ha gere ntị ha gaara azọpụta ndụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.5",
            "verseOrgIds": [
              "EZK.33.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na onye nche elepụ anya hụ ndị agha ka ha na-abịa hapụ igbu opi ịdọ ndị mmadụ aka na ntị, ọnwụ ha dị nʼisi ya. Ha ga-anwụ nʼime mmehie ha, ma aga m ajụta ọbara ha site nʼaka onye nche ahụ.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.6",
            "verseOrgIds": [
              "EZK.33.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, emeela m gị ka ị bụrụ onye nche nye ụlọ Izrel. Nʼihi ya, gee ntị nʼihe m na-ekwu, ka ị dọọrọ m ha aka na ntị.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.7",
            "verseOrgIds": [
              "EZK.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m na-asị onye ajọ omume, gị onye na-emebi iwu, ị ghaghị ịnwụ! Ọ bụrụ na ị kwughị okwu, ime ka o chigharịa site nʼụzọ ya pụta, onye ahụ na-emebi iwu ga-anwụ nʼihi mmehie ya niile, ma nʼaka gị ka m ga-ajụta ọbara ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.8",
            "verseOrgIds": [
              "EZK.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na ị dọọ onye ajọ omume aka na ntị ka o chigharịa site nʼụzọ ya pụta, ma o meghị nke a, ha ga-anwụ nʼihi mmehie ha, ma ndụ gị onwe gị ka ị zọpụtara.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.9",
            "verseOrgIds": [
              "EZK.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, gwa ụlọ Izrel, 'Otu a ka unu na-ekwu, \"Njehie niile anyị na mmehie niile anyị adịla arọ nʼahụ anyị. Ọ bụkwa nʼime ya ka anyị na-ata ahụ. Olee otu anyị ga-esi dị ndụ?\" '",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.10",
            "verseOrgIds": [
              "EZK.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ha, 'Dịka m na-adị ndụ, otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.11",
            "verseOrgIds": [
              "EZK.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.11",
                "verseOrgIds": [
                  "EZK.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara, ọnwụ onye na-emebi iwu adịghị atọ m ụtọ, kama ọ na-atọ m ụtọ mgbe onye na-emebi iwu sitere nʼụzọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.11",
            "verseOrgIds": [
              "EZK.33.11"
            ]
          }
        },
        {
          "text": "ya chegharịa dịrị ndụ. Chigharịanụ, sitenụ nʼụzọ ọjọọ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.11",
            "verseOrgIds": [
              "EZK.33.11"
            ]
          }
        },
        {
          "text": "unu niile chigharịa. Nʼihi gịnị ka unu ga-eji nwụọ, unu bụ ụlọ Izrel?'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.11",
            "verseOrgIds": [
              "EZK.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi ya, nwa nke mmadụ, gwa ndị ala gị, 'Ezi omume nke onye na-eme ezi ihe agaghị azọpụta ya ma ọ bụrụ na ọ tụgharịa, mee ihe ọjọọ. Otu a kwa, mmehie niile nke onye na-emebi iwu agaghị eme ka ọ laa nʼiyi ma ọ bụrụ na o chegharịa pụọ site na mmehie.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.12",
            "verseOrgIds": [
              "EZK.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m asị onye ezi omume, na ọ ghaghị ịdị ndụ, ma onye dị otu a atụkwasị obi nʼezi omume ya mee ajọ ihe, ọ dịghị ihe ezi omume nke onye dị otu a mere nke a ga-echetakwa. Ha ga-anwụ nʼihi ajọ ihe ha mere.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.13",
            "verseOrgIds": [
              "EZK.33.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na m asị onye ajọ omume, 'Ị ghaghị ịnwụ,' ma onye ahụ esite na mmehie ya chigharịa, mee ihe ziri ezi na nke dị mma,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.14",
            "verseOrgIds": [
              "EZK.33.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na o nyeghachi ihe ebe ọ naara nʼaka ndị ọ gbazinyere ego, kwụghachi ihe niile o zuuru nʼohi, gbasoo ụkpụrụ ahụ niile bụ nke na-enye ndụ, gharakwa ime ajọ omume; onye dị otu a aghaghị ịdị ndụ, ọ gaghị anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.15",
            "verseOrgIds": [
              "EZK.33.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mmehie niile nke onye ahụ mere nke a ga-echeta megide ya. Nʼihi na o meela ihe ziri ezi na nke dịkwa mma, ọ gaghị ịdị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.16",
            "verseOrgIds": [
              "EZK.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ndị gị na-asị, 'Ụzọ Onyenwe anyị ezighị ezi.' Ma ọ bụ ụzọ ha bụ nke na-ezighị ezi.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.17",
            "verseOrgIds": [
              "EZK.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye ezi omume esite nʼezi omume ya chigharịa malite ime ihe ọjọọ, ọ ga-anwụ maka ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.18",
            "verseOrgIds": [
              "EZK.33.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZK 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na onye ajọ omume esite nʼajọ omume ya chigharịa malite ime ihe ziri ezi na nke dị mma, ọ ga-adị ndụ site nʼime nke a.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.19",
            "verseOrgIds": [
              "EZK.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZK 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma unu bụ ụlọ Izrel na-asị, 'Ụzọ Onyenwe anyị ezighị ezi.' Ma aga m ekpe onye ọbụla nʼime unu ikpe dịka ụzọ ya si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.20",
            "verseOrgIds": [
              "EZK.33.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkọwa maka ọdịda Jerusalem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZK 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo nʼafọ nke iri na abụọ nke e mere ka anyị jee biri na mba ọzọ, nʼọnwa nke iri, nʼụbọchị nke ise nke ọnwa ahụ, otu onye nʼime ndị sitere na Jerusalem gbapụ bịakwutere m gwa m sị, \"Obodo ahụ adaala.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.21",
            "verseOrgIds": [
              "EZK.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZK 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼanyasị, tupu onye ahụ gbapụrụ agbapụ abịa, aka",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.22",
                "verseOrgIds": [
                  "EZK.33.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ahụ, mee ka m nweekwa ike ikwu okwu ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.22",
            "verseOrgIds": [
              "EZK.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "EZK 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, okwu",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.23",
            "verseOrgIds": [
              "EZK.33.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.23",
                "verseOrgIds": [
                  "EZK.33.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru m ntị, sị,",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.23",
            "verseOrgIds": [
              "EZK.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "EZK 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nwa nke mmadụ, ndị ahụ bi nʼebe dakpọsịrị adakpọsị nʼala Izrel na-asị, 'Ebraham bụ otu nwoke, ma o nwetachara ala a niile! Ma anyị dị ukwuu, nʼihi enyela anyị ala dịka ihe nweta anyị.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.24",
            "verseOrgIds": [
              "EZK.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "EZK 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, gwa ha, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.25",
            "verseOrgIds": [
              "EZK.33.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.25",
                "verseOrgIds": [
                  "EZK.33.25"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Ebe ọ bụ na unu na-eri anụ nke ọbara dị nʼime ya, na-elekwasịkwa arụsị unu anya, na-awụsikwa ọbara, o kwesiri ka unu nweta ala a?",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.25",
            "verseOrgIds": [
              "EZK.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "EZK 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu na-atụkwasị obi unu na mma agha unu, unu na-eme ihe arụ dị iche iche, onye ọbụla nʼime unu na-emerụ nwunye onye agbataobi ya. Ọ bụkwa ala nke a ka unu ga-enweta?'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.26",
            "verseOrgIds": [
              "EZK.33.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "EZK 33:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa ha nke a, 'Otu a ka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.27",
            "verseOrgIds": [
              "EZK.33.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.27",
                "verseOrgIds": [
                  "EZK.33.27"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, dịka m na-adị ndụ, ndị niile fọdụrụ nʼobodo ahụ e tikpọrọ etikpọ ga-anwụcha site na mma agha. Ndị bi nʼọhịa ka anụ ọhịa ga-atagbu. Ndị niile bi nʼọgba na nʼebe niile e wusiri ike ga-anwụ site nʼọrịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.27",
            "verseOrgIds": [
              "EZK.33.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "EZK 33:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ala unu ghọọ ebe tọgbọrọ nʼefu. Nganga ya, na ike ya ga-agwụsị. Obodo niile dị nʼugwu Izrel ga-aghọ ebe e tikpọrọ etikpọ, mmadụ agakwaghị esite nʼebe ahụ gafee ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.28",
            "verseOrgIds": [
              "EZK.33.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "EZK 33:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-amakwa na mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.29",
            "verseOrgIds": [
              "EZK.33.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.29",
                "verseOrgIds": [
                  "EZK.33.29"
                ]
              }
            }
          ]
        },
        {
          "text": ", mgbe m mesiri ka ala ahụ ghọọ mkpọmkpọ ebe tọgbọrọ nʼefu, nʼihi ihe arụ niile nke ha mere.'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.29",
            "verseOrgIds": [
              "EZK.33.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "EZK 33:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, nwa nke mmadụ, ndị ala gị na-ekwu banyere gị nʼakụkụ mgbidi ha na nʼọnụ ụzọ ụlọ ha. Ha na-asịrịta onwe ha, 'Bịanụ ka anyị gaa nụrụ ozi sitere nʼọnụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.30",
            "verseOrgIds": [
              "EZK.33.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.33.30",
                "verseOrgIds": [
                  "EZK.33.30"
                ]
              }
            }
          ]
        },
        {
          "text": ".'",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.30",
            "verseOrgIds": [
              "EZK.33.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "EZK 33:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-abịakwute gị dịka ndị mmadụ si abịa, ha na-anọrọ ala nʼihu gị na-anụ ihe ị na-ekwu ma ha anaghị emepụta ya nʼomume: nʼihi na ha na-eji egbugbere ọnụ ha na-egosi ịhụnanya, ma obi ha nọ naanị na uru ọjọọ ha ga-enweta.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.31",
            "verseOrgIds": [
              "EZK.33.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "EZK 33:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼanya ha, ị dịka onye ji ezigbo olu na-ekwe ukwe ịhụnanya, dịka onye nwere olu ụtọ, nke na-abụ abụ dị ụtọ, na onye maara ka e si eti ịgba. Ha na-anụ ihe ị na-ekwu ma ha ejighị ya kpọrọ ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.32",
            "verseOrgIds": [
              "EZK.33.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "EZK 33:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma mgbe nke a bịara na mmezu, nʼihi ọ ghaghị ịbịa, ha ga-amata na onye amụma anọtụla nʼetiti ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.33.33",
            "verseOrgIds": [
              "EZK.33.33"
            ]
          }
        }
      ]
    }
  ],
