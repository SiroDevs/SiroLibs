  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EZK 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpere arụsị nʼụlọ ukwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZK 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke isii, nʼọnwa nke isii, nʼụbọchị nke ise nke ọnwa ahụ, mgbe mụ onwe m nọdụ ala nʼụlọ m, ndị okenye Juda na-anọdụkwa ala nʼihu m, aka Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.1",
            "verseOrgIds": [
              "EZK.8.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.8.1",
                "verseOrgIds": [
                  "EZK.8.1"
                ]
              }
            }
          ]
        },
        {
          "text": "dịkwasịrị m nʼahụ nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.1",
            "verseOrgIds": [
              "EZK.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZK 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m oyiyi yiri mmadụ. Akụkụ oyiyi a nke dị site nʼụkwụ ya ruo nʼala ya na-acha dịka ọkụ, sitekwanụ nʼụkwụ ya rigoo, ọ na-egbu nnọọ amụma dịka nkume amba dị oke ọnụahịa.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.2",
            "verseOrgIds": [
              "EZK.8.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZK 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oyiyi a setịpụrụ ihe dịka aka mmadụ, jiri ya jide m nʼagịrị isi m. Mgbe ahụ, Mmụọ nke Chineke buliri m elu nʼetiti ala na mbara eluigwe. Nʼime ọhụ nke Chineke, o buuru m jee Jerusalem, nʼọnụ ụzọ ama nke dị nʼugwu, nʼime ogige ya, ebe arụsị ahụ na-akpasu ekworo guzo.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.3",
            "verseOrgIds": [
              "EZK.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZK 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma, lee, ebube Chineke Izrel jupụtara nʼebe ahụ, dị ka m si hụ ya na mbụ na ndagwurugwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.4",
            "verseOrgIds": [
              "EZK.8.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZK 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Nwa nke mmadụ, welie anya gị lee nʼụzọ nke ugwu.\" Eweliri m anya m lee nʼụzọ ugwu, ma lee, nʼọnụ ụzọ e si abata nʼime ebe ịchụ aja, ahụrụ m oyiyi arụsị ekworo ka o guzo nʼakụkụ ugwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.5",
            "verseOrgIds": [
              "EZK.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZK 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Nwa nke mmadụ, ị na-ahụ ihe ha na-eme, arụ dị egwu nke ụlọ Izrel na-eme nʼebe a, ihe ndị ga-achụpụ m nʼebe dị anya site nʼebe nsọ m? Ma ị ga-ahụkwa ihe arụ ndị dị ukwuu karịa ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.6",
            "verseOrgIds": [
              "EZK.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZK 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka m guzo nʼọnụ ụzọ ogige ahụ, mgbe m lere anya, ahụrụ m oghere dị nʼaja ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.7",
            "verseOrgIds": [
              "EZK.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZK 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Nwa nke mmadụ, ugbu a gwupuo aja ụlọ a.\" Mgbe m gwupuru ya, ahụrụ m ọnụ ụzọ e si aba nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.8",
            "verseOrgIds": [
              "EZK.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZK 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Banye nʼime ka ị hụ ihe arụ ọjọọ niile nke ha na-eme nʼebe a.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.9",
            "verseOrgIds": [
              "EZK.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZK 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abanyere m hụ na ihe jupụtara nʼahụ ụlọ ahụ bụ naanị oyiyi e sere ese, nke ihe na-akpụ akpụ dịka agwọ dị iche iche, ngwere na anụmanụ rụrụ arụ dị iche iche, tinyekwara arụsị niile nke ụlọ Izrel na-efe.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.10",
            "verseOrgIds": [
              "EZK.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZK 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihu ihe ndị a, ka iri ndị okenye asaa nke ụlọ Izrel, ha na Jaazanaya nwa Shefan guzo nʼebe ahụ. Onye ọbụla nʼime ha ji ihe nsure ọkụ na-esi isi ụtọ nʼaka ya, anwụrụ ọkụ si nʼihe nsure ọkụ ndị a na-agbagokwa elu.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.11",
            "verseOrgIds": [
              "EZK.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZK 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Nwa nke mmadụ, ị hụla ihe ndị okenye ụlọ Izrel na-eme nʼọchịchịrị, onye ọbụla nʼime ụlọ ya nʼihu arụsị ya? Ma ha na-asị, '",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.8.12",
                "verseOrgIds": [
                  "EZK.8.12"
                ]
              }
            }
          ]
        },
        {
          "text": "adịghị ahụ anyị, O sitela nʼala anyị wezuga onwe ya.' \"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.12",
            "verseOrgIds": [
              "EZK.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZK 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọ, ọ sịrị m, \"Ị ga-ahụkwa oke ihe arụ karịrị ndị a ha na-eme!\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.13",
            "verseOrgIds": [
              "EZK.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZK 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka m bịakwa nʼọnụ ụzọ ahụ dị nʼakụkụ ugwu nke ụlọnsọ nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.8.14",
                "verseOrgIds": [
                  "EZK.8.14"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nʼebe ahụ, ahụrụ m ndị inyom nọ na-akwa akwa nʼihi Tamuz, chi ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.14",
            "verseOrgIds": [
              "EZK.8.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZK 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị m, \"Ị hụla ihe ndị a, nwa nke mmadụ? Ị ga-ahụkwa ihe arụ ndị dị ukwuu karịa ndị a.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.15",
            "verseOrgIds": [
              "EZK.8.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZK 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka m baa nʼime ogige dị nʼime ụlọ ukwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.8.16",
                "verseOrgIds": [
                  "EZK.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼebe ahụ, nʼọnụ ụzọ ụlọnsọ ukwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.8.16",
                "verseOrgIds": [
                  "EZK.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼagbata ebe ịchụ aja na mpụta ọnụ ụlọ ahụ, ka ihe ruru iri mmadụ abụọ na ise guzo, chee ihu ha nʼakụkụ ọwụwa anyanwụ na-efe anyanwụ. Ha gbakụtara ụlọnsọ ukwu nke",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZK.8.16",
                "verseOrgIds": [
                  "EZK.8.16"
                ]
              }
            }
          ]
        },
        {
          "text": "azụ mgbe ha na-eche ihu nʼọwụwa anyanwụ na-akpọ isiala nye anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.16",
            "verseOrgIds": [
              "EZK.8.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZK 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị m, \"Ị hụla nke a, nwa nke mmadụ? Ọ bụ ihe dị nta nye ụlọ Juda, bụ ime ihe arụ niile ndị a ha na-eme nʼebe a? Ha ga-ejikwa ihe ike mejupụta ala, siri otu a na-akpasu m iwe mgbe niile? Lee ka ha si nọgide na-akparị m, na-etinye alaka nʼimi ha.",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.17",
            "verseOrgIds": [
              "EZK.8.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZK 8:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, aga m eme ka ha nụrụ ụfụ iwe m, ọ dịkwaghị onye m ga-ahapụ. Ọ bụrụkwa na ha anọgide na-ebe akwa nʼoke olu, agaghị m aṅa ha ntị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZK.8.18",
            "verseOrgIds": [
              "EZK.8.18"
            ]
          }
        }
      ]
    }
  ],
