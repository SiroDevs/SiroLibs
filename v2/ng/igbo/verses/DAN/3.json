          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze nyere Shedrak, Mishak na Abednego ọkwa ọzọ dị elu karịa nke ha nwere na mbụ nʼala Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.3.30",
