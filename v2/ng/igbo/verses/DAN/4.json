  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "4",
        "style": "c",
        "sid": "DAN 4"
      },
      "items": [
        {
          "text": "4",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nebukadneza arọọ nrọ osisi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DAN 4:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ bụ Nebukadneza,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Na e zigara mmadụ niile, mba niile, na ndị na-asụ asụsụ dị iche iche nʼụwa ozi:",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pmo",
        "vid": "DAN 4:1"
      },
      "items": [
        {
          "text": "Ka ọ dịrị unu na mma!",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.1",
            "verseOrgIds": [
              "DAN.3.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DAN 4:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "E ji m obi ụtọ, na-eme ka unu mata ihe ịrịbama niile na ihe iju anya niile, nke Chineke Onye kachasị ihe niile elu meere m.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.2",
            "verseOrgIds": [
              "DAN.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DAN 4:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee ka ihe ịrịbama ya,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "na ihe ịtụnanya ya si dị ukwuu!",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "Alaeze ya bụ nke na-adị site ebighị ebi ruo ebighị ebi;",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:3"
      },
      "items": [
        {
          "text": "ọchịchị ya na-adịgidekwa site nʼọgbọ ruo nʼọgbọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DAN 4:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m, bụ Nebukadneza nọ nʼafọ ojuju na ihe ịga nke ọma nʼụlọeze m.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.4",
            "verseOrgIds": [
              "DAN.4.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DAN 4:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arọrọ m nrọ, nke mere ka ụjọ tụọ m. Ihe niile m hụrụ na nrọ mgbe m dina ala nʼelu akwa mere ka oke ụjọ tụọ m.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.5",
            "verseOrgIds": [
              "DAN.4.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DAN 4:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, enyere m iwu ka a kpọọ ndị amamihe niile m nwere na Babilọn ka ha bịa nʼihu m, bịa kọwaara m isi nrọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.6",
            "verseOrgIds": [
              "DAN.4.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DAN 4:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị mgbaasị, ndị dibịa, ndị Kaldịa na ndị na-agba afa bịara, a kọọrọ",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.7",
            "verseOrgIds": [
              "DAN.4.4"
            ]
          }
        },
        {
          "text": "m ha nrọ ahụ m rọrọ, ma ha enweghị ike ịgwa m nkọwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.7",
            "verseOrgIds": [
              "DAN.4.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DAN 4:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼikpeazụ, Daniel batara nʼihu m, onye aha ya bụ Belteshaza dịka aha chi m si dị, onye mmụọ nke chi niile dị nsọ bi nʼime ya. Akọọrọ m ya ihe ahụ m rọrọ na nrọ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.8",
            "verseOrgIds": [
              "DAN.4.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DAN 4:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Asịrị m, \"Belteshaza, onyeisi ndị nkọwa ihe niile. Amaara m na mmụọ nke chi niile dị nsọ bi nʼime gị. Amakwaara m na o nweghị ihe omimi ọbụla ga-esiri gị ike ịchọpụta ọsịsa ya. Ugbu a, nke a bụ nrọ m, kọwaara m ihe ọ pụtara.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.9",
            "verseOrgIds": [
              "DAN.4.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DAN 4:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m dina nʼelu akwa, nke a bụ ihe m hụrụ. E nwere otu osisi nke toro nʼetiti ụwa, ogologo",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.10",
            "verseOrgIds": [
              "DAN.4.7"
            ]
          }
        },
        {
          "text": "ya dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.10",
            "verseOrgIds": [
              "DAN.4.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DAN 4:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osisi a toro sie ike, ịdị elu ya rukwara nʼeluigwe, a na-ahụkwa ya anya site na nsọtụ nke ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.11",
            "verseOrgIds": [
              "DAN.4.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DAN 4:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwụkwọ ya dị mma ile anya, alaka ya jupụtakwara na mkpụrụ hiri nne, o gbokwara mkpa nri nye mmadụ niile. Ụmụ anụmanụ niile nke ọhịa na-abịakwa nʼokpuru ndo ya izuike. Ụmụ nnụnụ niile nke eluigwe na-ebikwa nʼalaka ya. Ọ bụkwa site na ya ka a na-azụ ihe niile dị ndụ nri.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.12",
            "verseOrgIds": [
              "DAN.4.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DAN 4:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe m nọkwa na-arọ nrọ ahụ, ahụrụ m otu nʼime ndị mmụọ ozi Chineke ka o si nʼeluigwe na-arịdata.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.13",
            "verseOrgIds": [
              "DAN.4.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DAN 4:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tiri mkpu nʼolu dị ike sị, 'Gbudanụ osisi ukwu ahụ, gbukasịakwa alaka ya niile. Kụpụsịanụ akwụkwọ ndụ niile dị nʼelu ya. Ghasaakwanụ mkpụrụ ya niile, ka ụmụ anụmanụ si nʼokpuru ndo ya gbapụ, ka ụmụ nnụnụ site nʼalaka ya fepụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.14",
            "verseOrgIds": [
              "DAN.4.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DAN 4:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama hapụnụ ogwe osisi ahụ na mgbọrọgwụ ya ka ha dịrị nʼime ala, ebe e ji ụdọ igwe na ụdọ bronz kee ya gburugburu, ebe ahịhịa ndụ gbakwara ya gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:15"
      },
      "items": [
        {
          "text": "\" 'Ka igirigi nke eluigwe zoo ya nʼahụ, ka ahịhịa bụrụkwa nri ọ ga-eri, ya na ụmụ anụmanụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.15",
            "verseOrgIds": [
              "DAN.4.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DAN 4:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka uche ya gbanwee ghọọ nke anụ ọhịa, ghara ibu nke mmadụ, afọ asaa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.16",
            "verseOrgIds": [
              "DAN.4.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DAN 4:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nke a bụ mkpebi nke mmụọ ozi ahụ nọ na nche. Ọ bụkwa mkpebi e nyere site nʼokwu nke dị nsọ, ka ụwa niile mata na Onye kachasị ihe niile elu, na-achịkwa nʼalaeze niile dị nʼụwa. Ọ bụ ya na-ewerekwa alaeze ndị a nye onye ọbụla ọ chọrọ, ọ bụladị ndị mmadụ a na-ahụta dịka ndị dị ala karịsịa.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.17",
            "verseOrgIds": [
              "DAN.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DAN 4:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ nrọ ahụ, mụ bụ eze Nebukadneza rọrọ, ugbu a, Belteshaza, gwa m ihe bụ nkọwa ya. Nʼihi na ndị amamihe niile nọ nʼalaeze m enweghị ike ịkọwara m ya. Ma amaara m na i nwere ike ịkọwara m ya, nʼihi na mmụọ nke chi ndị ahụ dị nsọ dị nʼime gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.18",
            "verseOrgIds": [
              "DAN.4.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s3"
      },
      "items": [
        {
          "text": "Daniel akọwaa nrọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DAN 4:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Daniel (onye a na-akpọkwa Belteshaza), nọ nʼoke ihe iju anya nʼihi na echiche ya mere ka ọma jijiji. Ya mere, eze sịrị, \"Belteshaza, atụkwala egwu nʼihi nrọ a maọbụ ihe ọ pụtara.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "DAN 4:19"
      },
      "items": [
        {
          "text": "Belteshaza zara sị, \"Onyenwe m, ka nrọ a dịrị ndị kpọrọ gị asị, ka nkọwa ya dịkwara ndị iro gị.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.19",
            "verseOrgIds": [
              "DAN.4.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DAN 4:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Osisi ahụ ị hụrụ nke buru ibu, tokwa ogologo ma dịkwa ike, nke elu ya na-emetụ mbara eluigwe, nke ndị niile bi nʼụwa hụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.20",
            "verseOrgIds": [
              "DAN.4.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DAN 4:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke nwekwara akwụkwọ ndụ dị mma, na nke jupụtara na mkpụrụ, nke na-egboro mmadụ niile mkpa nri, nke ụmụ anụmanụ ọhịa niile na-ebi nʼokpuru ndo ya, nke ụmụ nnụnụ niile nke eluigwe nwere akwụ ebe obibi ha,",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.21",
            "verseOrgIds": [
              "DAN.4.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DAN 4:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "osisi ahụ bụ gị onwe gị, eze. Nʼihi na i toola bụrụ onye dị ike na onye dị ukwuu. Ịdị ukwu gị eruola nʼeluigwe. Ọchịchị gị eruokwala nʼakụkụ niile nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.22",
            "verseOrgIds": [
              "DAN.4.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DAN 4:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ahụ, ị hụkwara onye dị nsọ na-enyocha omume ndị mmadụ nke si nʼeluigwe rịdata na-asị, 'Gbutuonụ osisi a, laa ya nʼiyi, ma unu hapụ ogwe ya ka ahịhịa ndụ gbaa ya gburugburu, ka e jirikwa ụdọ igwe na bronz kee ya gburugburu; hapụ ya ka igirigi nke eluigwe zokwasị ya. Hapụkwa ya ka o soro anụ ọhịa taa ahịhịa dịka nri ya tutu afọ asaa a gafee.'",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.23",
            "verseOrgIds": [
              "DAN.4.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DAN 4:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Eze, nke a bụ nkọwa nrọ ị rọrọ, Onye kachasị ihe niile elu enyela iwu nke na-aghaghị imezu megide onyenwe m eze.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.24",
            "verseOrgIds": [
              "DAN.4.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DAN 4:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-achụpụ gị site nʼebe ndị mmadụ nọ. A ga-achụgakwa gị nʼebe gị na ụmụ anụmanụ ga-ebi nʼọhịa, Ebe ahụ ka ị ga-anọ taa ahịhịa dịka oke ehi, igirigi nke eluigwe ga-ezokwasịkwa gị. Ọnụọgụgụ afọ asaa ga-agabiga tutu ruo mgbe ị nabatara na Onye kachasị ihe niile elu na-achị achị nʼalaeze niile nke mmadụ, na ọ bụkwa nʼaka onye ọbụla ọ chọrọ ka ọ na-enyefe ha.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.25",
            "verseOrgIds": [
              "DAN.4.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DAN 4:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka e siri nye nʼiwu ka a hapụ ogwe osisi ahụ na mgbọrọgwụ ya nʼime ala. Nke a na-egosi na ị ga-emecha nwetaghachi alaeze gị mgbe ị nabatara na Eluigwe na-achị achị.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.26",
            "verseOrgIds": [
              "DAN.4.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DAN 4:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, biko eze, kweere nabata ndụmọdụ m, kwụsị ime mmehie, mee ihe ziri ezi, werekwa omume ileta ndị ogbenye dochie nʼọnọdụ ajọ omume gị. Eleghị anya, ihe ga na-agara gị nke ọma.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.27",
            "verseOrgIds": [
              "DAN.4.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s3"
      },
      "items": [
        {
          "text": "Mmezu nrọ ahụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DAN 4:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe ndị a niile bịakwasịrị eze Nebukadneza.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.28",
            "verseOrgIds": [
              "DAN.4.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DAN 4:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọnwa iri na abụọ gafesịrị ọ nọ na-agagharị nʼelu ụlọ dị nʼụlọeze nʼobodo Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.29",
            "verseOrgIds": [
              "DAN.4.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DAN 4:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma eze sịrị, \"Ebe a, ọ bụghị Babilọn dị ukwu, nke m wuuru onwe m dịka ebe obibi m, site nʼike m dị ukwu na maka ebube ọchịchị m?\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.30",
            "verseOrgIds": [
              "DAN.4.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DAN 4:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ ka kpụ okwu ahụ nʼọnụ, otu olu si nʼeluigwe kwuo okwu, \"Ihe a ka e kpebiri megide gị, eze Nebukadneza. Site taa gaa nʼihu ị gaghị abụkwa eze na-achị alaeze a.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.31",
            "verseOrgIds": [
              "DAN.4.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DAN 4:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-esi nʼetiti ndị mmadụ chụpụ gị, ka ị gaa soro ụmụ anụmanụ biri nʼọhịa. Ị ga-atakwa ahịhịa dịka oke ehi, afọ asaa ga-agasị tutu ruo mgbe ị ghọtara na ọ bụ Onye kachasị ihe niile elu na-achị achị nʼalaeze dị niile nke ụwa. Ọ na-enyefekwa ha nʼaka onye ọbụla ọ chọrọ ka ọ chịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.32",
            "verseOrgIds": [
              "DAN.4.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DAN 4:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu oge ahụ kwa, okwu ndị a e kwuru banyere Nebukadneza mezuru. E sitere nʼetiti ụmụ mmadụ chụpụ ya, ọ gakwara nʼọhịa taa ahịhịa dịka oke ehi, igirigi nke eluigwe dekwara ahụ ya ruo mgbe ajị dị ya nʼahụ toro ogologo dịka nku ugo, mbọ ụkwụ na aka ya dịkwa ka mbọ ụmụ nnụnụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.33",
            "verseOrgIds": [
              "DAN.4.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DAN 4:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe oge a gafesịrị, mụ bụ Nebukadneza leliri anya m elu. Mgbe ahụ kwa ka m ghọrọ mmadụ nwere uche ọzọ. Etokwara m, ma kpọọkwa isiala nye Onye ahụ kachasị ihe niile elu, sọpụrụkwa Onye ahụ na-adị ndụ ruo mgbe niile ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.34",
            "verseOrgIds": [
              "DAN.4.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "Onye ọchịchị ya na-adịghị agwụ agwụ,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:34"
      },
      "items": [
        {
          "text": "onye alaeze ya na-adị site nʼọgbọ ruo nʼọgbọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DAN 4:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ niile bi nʼụwa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "bụ ihe efu nʼihu ya.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "Nʼihi na ọ na-eme ihe ọbụla ọ chọrọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "nʼetiti usuu ndị bi nʼeluigwe,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "na nʼetiti ndị bi nʼụwa.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "O nweghị onye pụrụ igbochi ya,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "DAN 4:35"
      },
      "items": [
        {
          "text": "maọbụ onye pụrụ ịjụ ya sị ya, \"Gịnị mere iji mee ihe ndị a?\"",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DAN 4:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe uche m laghachiri dịka mmadụ, enwetaghachikwara m ugwu na nsọpụrụ na alaeze m. Ndị na-adụ m ọdụ laghachikwara bịakwute m, ha na ndị na-ejere m ozi. E mekwara ka m bụrụkwa eze ọzọ nʼalaeze m. Ugwu na nsọpụrụ m nwere ugbu a karịrị ugwu na nsọpụrụ m nwere nʼoge gara aga.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.36",
            "verseOrgIds": [
              "DAN.4.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DAN 4:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, mụ bụ Nebukadneza na-eto, na-asọpụrụ Eze nke eluigwe, nʼihi na ọrụ ya niile dị mma, ụzọ ya niile kwụ ọtọ. Nʼihi na o nwere ike ijide ndị nganga kwanye ha ọnụ nʼime ntụ.",
          "type": "text",
          "attrs": {
            "verseId": "DAN.4.37",
            "verseOrgIds": [
              "DAN.4.34"
            ]
          }
        }
      ]
    }
  ],
