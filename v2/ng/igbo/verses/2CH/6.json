  "verseCount": 42,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "2CH 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Solomọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn sịrị, \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.1",
                "verseOrgIds": [
                  "2CH.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwuola na ọ ga-ebi nʼoke igwe ojii.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.1",
            "verseOrgIds": [
              "2CH.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ewuola m ụlọnsọ pụrụ iche, maa mma nye gị, ebe ị ga-ebi ruo mgbe ebighị ebi!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.2",
            "verseOrgIds": [
              "2CH.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ọgbakọ Izrel niile na-eguzo nʼebe ahụ, eze chigharịrị onwe ya chee ha ihu, gọzie ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.3",
            "verseOrgIds": [
              "2CH.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:4"
      },
      "items": [
        {
          "text": "\"Otuto dịrị",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.4",
                "verseOrgIds": [
                  "2CH.6.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke Izrel. Onye ji aka ya abụọ mezuo nkwa ahụ o ji ọnụ ya kwee nna m Devid. Nʼihi na o kwuru sị,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.4",
            "verseOrgIds": [
              "2CH.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Site nʼụbọchị ahụ m si nʼala Ijipt kpọpụta ndị m, ahọpụtaghị m obodo ọbụla nʼebo ọbụla nke Izrel, ka e wuru m ụlọnsọ ka Aha m dịrị nʼebe ahụ, maọbụ họpụta onye ọbụla ka ọ bụrụ onyendu ndị m Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.5",
            "verseOrgIds": [
              "2CH.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a, a họrọla m Jerusalem ka ọ bụrụ ebe Aha m ga-adị, ahọrọkwala m Devid ị bụ onye ga-achị ndị m Izrel.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.6",
            "verseOrgIds": [
              "2CH.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nna m, Devid bu nʼobi iwu ụlọnsọ ukwu nye Aha",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.7",
                "verseOrgIds": [
                  "2CH.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.7",
            "verseOrgIds": [
              "2CH.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.8",
                "verseOrgIds": [
                  "2CH.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị nna m, Devid, 'I mere nke ọma ibu nʼobi, iwu ụlọnsọ ukwu nye Aha m.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.8",
            "verseOrgIds": [
              "2CH.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọ dị, ọ bụghị gị ga-ewu ya, kama nwa gị nwoke nke si nʼahụ gị pụta ga-ewu ụlọnsọ ahụ nye Aha m.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.9",
            "verseOrgIds": [
              "2CH.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "emezuola nkwa ahụ o kwere. A nọchiela m nna Devid, ana m anọdụ nʼocheeze nke Izrel dịka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwere na nkwa. Ewuokwala m ụlọnsọ ukwu nye Aha",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.10",
                "verseOrgIds": [
                  "2CH.6.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.10",
            "verseOrgIds": [
              "2CH.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ahụ ka m dọbara igbe ọgbụgba ndụ, nʼime ya ka ọgbụgba",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.11",
                "verseOrgIds": [
                  "2CH.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dị, bụ nke ya na ụmụ Izrel gbara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.11",
            "verseOrgIds": [
              "2CH.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Ido Nsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn guzoro nʼihu ebe ịchụ aja",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.12",
                "verseOrgIds": [
                  "2CH.6.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", na nʼihu ọgbakọ ụmụ Izrel niile, gbasapụ aka ya abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.12",
            "verseOrgIds": [
              "2CH.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn ji bronz kpụọ ihe nrigoro ịnọ gwa ọha mmadụ okwu. Ogologo ihe nrigoro ahụ, obosara ya ruru mita abụọ na ọkara mita abụọ na ọkara. Ịdị elu ya ruru otu mita na ọkara. O debere ya nʼetiti ebe mpụta nke ogige ụlọnsọ ukwu ahụ. O guzoro nʼelu ihe nrigo ahụ, nʼihu ọgbakọ Izrel niile, gbuo ikpere nʼala, gbasaa aka ya abụọ chilie ha elu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.13",
            "verseOrgIds": [
              "2CH.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 6:14"
      },
      "items": [
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.14",
                "verseOrgIds": [
                  "2CH.6.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke nke Izrel, ọ dịghị Chineke dịka gị nʼeluigwe maọbụ nʼụwa. Gị onye na-edebe ọgbụgba ndụ ịhụnanya gị na ndị ohu gị, bụ ndị ji obi ha niile na-eso ụzọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.14",
            "verseOrgIds": [
              "2CH.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mezuokwala nkwa niile i kwere nna m Devid, bụ ohu gị. I ji ọnụ gị kwee nkwa a, ma taa, i jirila aka gị mezuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.15",
            "verseOrgIds": [
              "2CH.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, O!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.16",
                "verseOrgIds": [
                  "2CH.6.16"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke nke Izrel, mezukwaa nkwa niile i kwere Devid nna m, mgbe ị sịrị, 'Ọ bụrụ na ụmụ ụmụ gị elezie anya bie ndụ dịka iwu m si dị nʼihu m, nʼihe niile ha na-eme, dịka gị onwe gị mere, agaghị achọ onye ga-anọ nʼihu nʼocheeze Izrel nʼime ha.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.16",
            "verseOrgIds": [
              "2CH.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.17",
                "verseOrgIds": [
                  "2CH.6.17"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke nke Izrel, ka okwu gị, bụ nkwa nke i kwere ohu gị Devid bịa na mmezu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.17",
            "verseOrgIds": [
              "2CH.6.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụ ezie na Chineke ga-ebinyere ụmụ mmadụ nʼelu ụwa? Lee, eluigwe, ọbụladị ebe kachasị elu nke eluigwe ezughị ịba gị. Olee otu ụlọ a nke m wuru ga-esi bata gị!",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.18",
            "verseOrgIds": [
              "2CH.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.6.19",
                "verseOrgIds": [
                  "2CH.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m, ṅaa ntị nʼekpere ohu gị, na arịrịọ ọ na-arịọ maka ebere. Nụrụ akwa na ekpere nke ohu gị na-ekpe nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.19",
            "verseOrgIds": [
              "2CH.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko, mee ka anya gị abụọ ghere oghe nʼebe ụlọnsọ ukwu a dị, ehihie na nʼabalị, bụ ebe a i kwuru sị, na i ga-akpọkwasị Aha gị nʼebe ahụ. Biko, ka ị nụrụ ekpere ohu gị ga-ekpe banyere ebe a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.20",
            "verseOrgIds": [
              "2CH.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nụrụkwa arịrịọ niile nke ohu gị na nke ndị gị Izrel niile, mgbe ọbụla ha chere ihu ha nʼebe a nʼekpere. Biko, site nʼeluigwe bụ ebe obibi gị nụrụ, mgbe ị nụrụ biko, gbagharakwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.21",
            "verseOrgIds": [
              "2CH.6.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe onye ọbụla mehiere mmadụ ibe ya, a kpọọ ya oku ka ọ bịa ṅụọ iyi, onye dị otu a bịa guzo nʼebe a, nʼihu ebe ịchụ aja gị a, ṅụọ iyi ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.22",
            "verseOrgIds": [
              "2CH.6.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, nụrụ olu ya nʼeluigwe ma mee ihe ziri ezi, kpeekwa ikpe nʼetiti ndị ohu gị. Maa onye mejọrọ ikpe site nʼịtụkwasị nʼisi ha ihe o metara, meekwa ka onye aka ya dị ọcha nwere onwe ya, site nʼimeso ha dịka ezi omume ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.23",
            "verseOrgIds": [
              "2CH.6.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ndị iro meriri ndị gị Izrel, nʼihi na ha mehiere megide gị, ọ bụrụ na ha alọghachite, too aha gị, na-ekpe ekpere, na-arịọ arịrịọ nʼihu gị nʼụlọnsọ ukwu a,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.24",
            "verseOrgIds": [
              "2CH.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "biko, site nʼeluigwe nụrụ ekpere ha, gbaghara mmehie ndị gị Izrel. Meekwa ka ha lọghachita nʼala ahụ nke i nyere ha na nna nna ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.25",
            "verseOrgIds": [
              "2CH.6.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe e gbochiri eluigwe, mee na mmiri adịghị ezokwa, nʼihi na ndị gị emehiela megide gị, ọ bụrụ na ha echee ihu nʼebe a kpee ekpere, too aha gị, si na mmehie ha chegharịa, nʼihi na ịtaala ha ahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.26",
            "verseOrgIds": [
              "2CH.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "biko, site nʼeluigwe nụrụ ma gbagharakwa mmehie ndị ohu gị, ndị gị Izrel. Kuziere ha ezi ụzọ ha ga-esi bie ndụ ma zidata mmiri ozuzo nʼala ahụ nke i nyere ndị gị ka ọ bụrụ ihe nketa ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.27",
            "verseOrgIds": [
              "2CH.6.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ụnwụ, maọbụ ajọ ọrịa na-efe efe ga-adakwasị ala a, maọbụ ọrịa na-eripịa ihe ubi, maọbụ ọmụma ebu; maọbụ igurube, maọbụ ụkpana, maọbụ mgbe ndị iro ga-anọchibido ha nʼobodo ha niile, ihe mbibi niile maọbụ ọrịa ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.28",
            "verseOrgIds": [
              "2CH.6.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "ekpere ọbụla maọbụ arịrịọ nke onye ọbụla nʼetiti ndị gị Izrel kpere ma rịọọ, nʼihi ịghọta ihe otiti na ihe mgbu niile, ha gbasapụ aka ha, ma chee ihu ha nʼebe ụlọnsọ ukwu dị;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.29",
            "verseOrgIds": [
              "2CH.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, site nʼeluigwe bụ ebe obibi gị nụrụ arịrịọ ha. Gbaghara ma meekwa; mesoo onye ọbụla dịka ihe niile ha na-eme si dị, ebe ọ bụ na ị maara obi ha niile (nʼihi na naanị gị maara obi ụmụ mmadụ),",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.30",
            "verseOrgIds": [
              "2CH.6.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ka ha tụọ egwu gị, jeekwa ije nʼirubere gị isi nʼoge niile ha na-ebi nʼala ahụ nke i nyere nna nna anyị ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.31",
            "verseOrgIds": [
              "2CH.6.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma banyere onye mba ọzọ, onye na-esonyeghị na ndị gị Izrel, kama o si nʼala ebe dị anya bịa nʼihi ukwu gị, nʼaka gị dị ike na ogwe aka gị e setipụrụ esetipụ. Mgbe ha bịara kpee ekpere nʼụlọnsọ a,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.32",
            "verseOrgIds": [
              "2CH.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, site nʼeluigwe ebe obibi gị nụrụ arịrịọ ha. Mekwaa ihe niile nke onye mba ọzọ ahụ na-arịọ nʼekpere, ka ndị niile nke ụwa mara aha gị, tụọkwa egwu gị, dịka ndị nke gị bụ Izrel na-eme. Ka ha matakwa na-akpọkwasịrị Aha gị nʼụlọ a nke m wuru.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.33",
            "verseOrgIds": [
              "2CH.6.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2CH 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ndị gị ga-aga ibu agha megide ndị iro ha, nʼebe ọbụla ị na-eziga ha, mgbe ha chere ihu ha nʼụzọ obodo a nke ị họpụtara na nʼụlọnsọ ukwu a m wuru nye Aha gị, kpee ekpere,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.34",
            "verseOrgIds": [
              "2CH.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2CH 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, site nʼeluigwe nụrụ ekpere na arịrịọ amara ha, mezukwa ihe ha na-arịọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.35",
            "verseOrgIds": [
              "2CH.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2CH 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ha mehiere megide gị, nʼihi na ọ dịghị mmadụ ọbụla na-adịghị emehie, ị wee iwe megide ha, rara ha nyefee nʼaka ndị iro, ndị ga-adọkpụrụ ha nʼagha gaa nʼobodo ọzọ, maọbụ obodo dị anya maọbụ nke dị nso;",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.36",
            "verseOrgIds": [
              "2CH.6.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2CH 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na ha anọrọ nʼala ahụ a dọkpụrụ ha gaa, chegharịa nʼobi ha, nọrọ nʼala ebe a dọtara ha nʼagha, rịọọ gị, sị, 'Anyị emehiela, anyị emeela ihe nʼadịghị mma, meekwa ajọ omume.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.37",
            "verseOrgIds": [
              "2CH.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2CH 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ha ejiri obi ha na mmụọ ha niile chegharịa, nʼala ebe ndọta nʼagha ha, bụ ebe a kpọrọ ha gaa, ma kpee ekpere nye gị chee ihu ha nʼụzọ ala a nke i nyere nna nna ha, nʼobodo a nke ị họpụtara, ya na nʼụlọnsọ ukwu a m wuru nye Aha gị",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.38",
            "verseOrgIds": [
              "2CH.6.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2CH 6:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, site nʼeluigwe, ebe obibi gị, nụrụ ekpere ha na arịrịọ ha niile, nyekwara ha aka. Gbaghara ndị gị, bụ ndị mehiere megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.39",
            "verseOrgIds": [
              "2CH.6.39"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "40",
            "style": "v",
            "sid": "2CH 6:40"
          },
          "items": [
            {
              "text": "40",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a, Chineke m, biko ka anya gị na ntị gị ghere oghe nʼekpere niile a na-ekpe nʼebe a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.6.40",
            "verseOrgIds": [
              "2CH.6.40"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "41",
            "style": "v",
            "sid": "2CH 6:41"
          },
          "items": [
            {
              "text": "41",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, bilie, O",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke, bata nʼebe izuike gị,",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "gị na igbe ọgbụgba ndụ nke ike gị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm1",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Ka ndị nchụaja gị, O",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke, yiri nzọpụta dịka uwe.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qm2",
        "vid": "2CH 6:41"
      },
      "items": [
        {
          "text": "Ka ndị gị kwesiri ntụkwasị obi ṅụrịa ọṅụ nʼihi ịdị mma gị.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
