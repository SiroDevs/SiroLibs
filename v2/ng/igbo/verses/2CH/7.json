  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "2CH 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ido ụlọnsọ ukwu nsọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, mgbe Solomọn kpesịrị ekpere a, ọkụ sitere nʼeluigwe daa repịa aja nsure ọkụ ahụ na aja ahụ niile. Ebube",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.1",
                "verseOrgIds": [
                  "2CH.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "jupụtakwara nʼụlọnsọ ukwu ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.1",
            "verseOrgIds": [
              "2CH.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja enweghị ike ịbanye nʼime ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.2",
                "verseOrgIds": [
                  "2CH.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼihi ebube",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.2",
                "verseOrgIds": [
                  "2CH.7.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nke jupụtara ụlọnsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.2",
            "verseOrgIds": [
              "2CH.7.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọha ndị Izrel niile hụrụ ọkụ ahụ si nʼelu daa, hụkwa ebube",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "ka o guzo nʼelu ụlọnsọ ukwu ahụ, ha dara nʼala kpọọ isiala nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.3",
                "verseOrgIds": [
                  "2CH.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", kelee ya ekele sị:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "\"Nʼihi na Ọ dị mma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 7:3"
      },
      "items": [
        {
          "text": "ịhụnanya ya na-adịgide ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.3",
            "verseOrgIds": [
              "2CH.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze na ndị a niile chụrụ aja dị iche iche nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.4",
                "verseOrgIds": [
                  "2CH.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.4",
            "verseOrgIds": [
              "2CH.7.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn chụrụ aja ehi nke dị puku iri abụọ na abụọ, na ewu na atụrụ dị narị puku na iri abụọ. Ya mere, Eze na ndị ahụ niile si otu a doo ụlọnsọ Chineke nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.5",
            "verseOrgIds": [
              "2CH.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja guzo nʼihu ọrụ ha, ha na ndị Livayị. Ha jiri ngwa egwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.6",
                "verseOrgIds": [
                  "2CH.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nke eze Devid mere maka ị na-eto",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.6",
                "verseOrgIds": [
                  "2CH.7.6"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụkwa nke o ji mgbe o nyere ekele, na-asị, \"Ịhụnanya ya na-adị ruo ebighị ebi.\" Na ncherita ihu ndị Livayị, ndị nchụaja fụrụ opi ike ha mgbe ndị Izrel guzooro ọtọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.6",
            "verseOrgIds": [
              "2CH.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn doro etiti ogige dị nʼihu ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.7",
                "verseOrgIds": [
                  "2CH.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ nsọ. Nʼebe ahụ ka ọ nọ chụọ aja nsure ọkụ, aja onyinye mkpụrụ ọka na aja abụba udo. O mere nke a nʼihi na ebe ịchụ aja bronz nke ọ rụrụ enweghị ike ịbata aja nsure ọkụ niile, aja mkpụrụ ọka niile nakwa aja abụba ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.7",
            "verseOrgIds": [
              "2CH.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Solomọn mere mmemme a nʼoge ahụ, ụbọchị asaa, ya na ndị Izrel niile. Ọ bụ nzukọ dị ukwuu. Ndị mmadụ bịara sitere na Lebo Hamat ruo na mmiri iyi Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.8",
            "verseOrgIds": [
              "2CH.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asatọ, ha nwere ọgbakọ, nʼihi na ha mere mmemme nke ido ebe ịchụ aja nsọ nʼime ụbọchị asaa, meekwa mmemme",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "text": "ahụ abalị asaa ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.9",
            "verseOrgIds": [
              "2CH.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nʼụbọchị nke iri abụọ na atọ nʼọnwa nke asaa, o zilagara ndị ahụ niile nʼụlọ ha, nʼịṅụrị ọṅụ na obi ụtọ nʼihi ihe ọma niile nke",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.10",
                "verseOrgIds": [
                  "2CH.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Devid na Solomọn na ndị ya Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.10",
            "verseOrgIds": [
              "2CH.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "e mee ka Solomọn hụ ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Solomọn rụchara ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", na ụlọeze, mezukwaa ihe niile bụ nke o bu nʼobi ime nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.11",
                "verseOrgIds": [
                  "2CH.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nakwa nʼụlọeze nke ya onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.11",
            "verseOrgIds": [
              "2CH.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.12",
                "verseOrgIds": [
                  "2CH.7.12"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka ọ hụ ya nʼọhụ abalị sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2CH 7:12"
      },
      "items": [
        {
          "text": "\"Anụla m ekpere gị, ahọrọkwala m ebe a nye onwe m, ka ọ bụrụ ebe ịchụ aja.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.12",
            "verseOrgIds": [
              "2CH.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mgbe ọbụla m mere ka mmiri ghara izo, maọbụ zidata igurube ka ha bịa bibie ihe ubi unu, maọbụ zidata ọrịa nʼetiti unu,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.13",
            "verseOrgIds": [
              "2CH.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na ndị m ndị a kpọkwasịrị aha m, ewedata onwe ha nʼala, kpee ekpere, chọsie ihu m ike, sitekwa na mmehie ha chigharịa, aga m esite nʼeluigwe za ekpere ha, gbaghara ha mmehie ha, mee ka ala ha dịrị ndu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.14",
            "verseOrgIds": [
              "2CH.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya m ga-eghere oghe mgbe niile; otu a kwa, ntị m ga-egherekwa oghe ịhụ na ịnụ ekpere niile a na-ekpe nʼụlọnsọ a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.15",
            "verseOrgIds": [
              "2CH.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Edoola m ụlọnsọ a nsọ nye onwe m, ka Aha m dị nʼebe ahụ ruo ebighị ebi; anya m abụọ na obi m ga-adịkwa nʼebe ahụ ụbọchị niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.16",
            "verseOrgIds": [
              "2CH.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, bie ndụ nʼikwesị ntụkwasị obi nʼihu m dịka Devid nna gị mere, na-eme ihe niile m nyere nʼiwu, debe ụkpụrụ m na iwu m niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.17",
            "verseOrgIds": [
              "2CH.7.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ocheeze ọchịchị gị guzosie ike, dịka mụ na nna gị Devid gbara na ndụ, mgbe m sịrị, 'Ị ghaghị inwe onye nnọchite anya nʼocheeze nke ga-achị Izrel.'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.18",
            "verseOrgIds": [
              "2CH.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ unu alaghachi azụ, gbakụta ụkpụrụ na iwu niile, bụ nke m nyere unu azụ, pụọ gbasoro chi ndị ọzọ ife ha ofufe, na ịkpọ isiala nye ha,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.19",
            "verseOrgIds": [
              "2CH.7.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, aga m esite nʼala m, bụ nke m nyere ha, hopu Izrel. Aga m ajụkwa ụlọnsọ a m doro nsọ nye Aha m, meekwa ka ọ ghọọ ihe e ji atụ ilu na ihe ịkpa ọchị nʼetiti ndị niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.20",
            "verseOrgIds": [
              "2CH.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na ụlọnsọ ukwu a kachasị elu ugbu a, ma ọnọdụ ya ga-eju ndị niile ga-esi nʼakụkụ ya gafee anya, ha ga-asị, 'Gịnị mere",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.21",
                "verseOrgIds": [
                  "2CH.7.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ji mee ala a na ụlọnsọ a, ihe dị otu a?'",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.21",
            "verseOrgIds": [
              "2CH.7.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ ga-aza, 'Ọ bụ nʼihi na ha gbakụtara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.7.22",
                "verseOrgIds": [
                  "2CH.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke nna nna ha, onye kpọpụtara ha site nʼala Ijipt azụ, makụọ chi ndị ọzọ, na-akpọ isiala na-efekwa ha ofufe. Ọ bụ nʼihi nke a ka O ji mee ka ihe ọjọọ niile ndị a bịakwasị ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.7.22",
            "verseOrgIds": [
              "2CH.7.22"
            ]
          }
        }
      ]
    }
  ],
