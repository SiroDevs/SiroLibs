            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.30.19",
                "verseOrgIds": [
                  "2CH.30.19"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nke nna nna ha, ọ bụladị ma ọ bụrụ na ha adịghị ọcha dịka iwu nke ebe nsọ si dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.30.19",
            "verseOrgIds": [
              "2CH.30.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
