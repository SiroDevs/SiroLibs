  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "24",
        "style": "c",
        "sid": "2CH 24"
      },
      "items": [
        {
          "text": "24",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joash edozie ụlọnsọ ukwu Onyenwe anyị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 24:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joash gbara afọ asaa mgbe e mere ya eze, ọ chịrị iri afọ anọ na Jerusalem. Aha nne ya bụ Zibịa onye Bịasheba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.1",
            "verseOrgIds": [
              "2CH.24.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 24:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joash mere ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.2",
                "verseOrgIds": [
                  "2CH.24.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼafọ niile nke Jehoiada bụ onye nchụaja, dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.2",
            "verseOrgIds": [
              "2CH.24.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 24:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiada lụtaara ya ndị inyom abụọ, ndị mụtaara ya ụmụ ndị ikom na ụmụ ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.3",
            "verseOrgIds": [
              "2CH.24.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 24:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, Joash kpebiri ime ka ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.4",
                "verseOrgIds": [
                  "2CH.24.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.4",
            "verseOrgIds": [
              "2CH.24.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 24:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọkọtara ndị nchụaja na ndị Livayị niile sị ha, \"Gaanụ nʼobodo Juda niile nakọta ego ụtụ afọ nʼaka ndị Izrel niile, maka iwuzi ụlọnsọ Chineke unu. Meenụ ya ugbu a.\" Ma ndị Livayị emeghị ya ngwangwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.5",
            "verseOrgIds": [
              "2CH.24.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 24:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eze kpọrọ Jehoiada bụ onyeisi nchụaja sị ya, \"Gịnị mere i mebeghị ka ndị Livayị gaa nakọtaa, site nʼaka ndị bi nʼobodo Juda niile, na nʼobodo Jerusalem, ego ụtụ nke Mosis ohu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.6",
                "verseOrgIds": [
                  "2CH.24.6"
                ]
              }
            }
          ]
        },
        {
          "text": "na ọgbakọ ụmụ Izrel nyere nʼiwu maka ụlọ ikwu nke iwu ọgbụgba ndụ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.6",
            "verseOrgIds": [
              "2CH.24.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 24:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a ụmụ ndị ikom Atalaya, nwanyị ọjọọ ahụ tipuru ụlọnsọ Chineke, bukọrọ ihe nsọ niile e ji efe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.7",
                "verseOrgIds": [
                  "2CH.24.7"
                ]
              }
            }
          ]
        },
        {
          "text": "dị nʼime ya maka Baal.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.7",
            "verseOrgIds": [
              "2CH.24.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 24:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eze nyere iwu ka e wuo igbe onyinye, nke a ga-adọba nʼọnụ ụzọ e si abanye ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.8",
                "verseOrgIds": [
                  "2CH.24.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.8",
            "verseOrgIds": [
              "2CH.24.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 24:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A kpọsara ya na Juda na Jerusalem niile sị ka ha wetara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.9",
                "verseOrgIds": [
                  "2CH.24.9"
                ]
              }
            }
          ]
        },
        {
          "text": "ụtụ nke Mosis ohu Chineke kwagidere ụmụ Izrel nʼọzara na ha ga na-atụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.9",
            "verseOrgIds": [
              "2CH.24.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 24:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi na ndị mmadụ niile jiri obi ụtọ tụta ụtụ ha. Ha jiri onyinye ha bịa tụnye ha nʼigbe onyinye ahụ, tutu rụọ mgbe o juru nʼọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.10",
            "verseOrgIds": [
              "2CH.24.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 24:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọbụla ndị Livayị bubataara ndị ozi eze igbe ahụ, ha hụ na-atụjuola ya ego, ode akwụkwọ eze ya na onyeozi nke onyeisi nchụaja ga-awụpụta ihe dị nʼigbe, ma bughachi okpokoro igbe ahụ nʼọnọdụ ya. Otu a ka ha mere ọtụtụ oge ruo mgbe ha nwetara ọtụtụ ego dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.11",
            "verseOrgIds": [
              "2CH.24.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 24:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze na Jehoiada weere ego ahụ niile nyefee ha nʼaka ndị ọrụ ụlọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.12",
                "verseOrgIds": [
                  "2CH.24.12"
                ]
              }
            }
          ]
        },
        {
          "text": "dị nʼaka, ha chọtara ndị ọka na-edo nkume, na ndị ọkpọ ǹtu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        },
        {
          "text": "Ha tinyere ọrụ ime ka ụlọnsọ ahụ dị ọhụrụ nʼaka ndị a. Ha gokwara ndị ụzụ bịara kpụọ ihe niile gbasara bronz na igwe e ji rụọ ọrụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.12",
            "verseOrgIds": [
              "2CH.24.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 24:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị e nyefere ọrụ ahụ nʼaka ji obi ha niile rụọ ọrụ nke mere na ọrụ ahụ gara nʼihu nke ọma. Ha rụziri ụlọnsọ ukwu Chineke dịka atụmatụ ya mbụ si dị, meekwa ya ka o sie ike karịa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.13",
            "verseOrgIds": [
              "2CH.24.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 24:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha rụsịrị ọrụ niile, ha weghachitere ego fọdụrụ, nye ya eze na Jehoiada, ha were ya rụta ngwa ije ozi maka ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.14",
                "verseOrgIds": [
                  "2CH.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", ngwa ije ozi na ihe isure aja nsure ọkụ, na ngaji, ya na efere dị iche iche, na ihe ọlaọcha na ọlaedo. A na-achụ aja nsure ọkụ nʼụlọnsọ nye",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.14",
                "verseOrgIds": [
                  "2CH.24.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ụbọchị niile Jehoiada dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.14",
            "verseOrgIds": [
              "2CH.24.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 24:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jehoiada mere nnọọ agadi, jupụtakwa nʼọtụtụ afọ, ọ nwụrụ mgbe ọ gbara narị afọ na iri afọ atọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.15",
            "verseOrgIds": [
              "2CH.24.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 24:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "E liri ya nʼebe a na-eli ndị eze nʼobodo Devid nʼihi ihe ọma niile o meere Izrel na Chineke na ụlọnsọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.16",
            "verseOrgIds": [
              "2CH.24.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ajọọ omume Joash",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 24:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jehoiada nwụsịrị, ndịisi Juda bịara ịkwanyere eze Joash ugwu. O gekwara ha ntị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.17",
            "verseOrgIds": [
              "2CH.24.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 24:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha hapụrụ ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.18",
                "verseOrgIds": [
                  "2CH.24.18"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna nna ha, fee ogidi Ashera na arụsị ndị ọzọ. Nʼihi ikpe ọmụma ha wetaara onwe ha, iwe Chineke dakwasịrị Juda na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.18",
            "verseOrgIds": [
              "2CH.24.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 24:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.19",
                "verseOrgIds": [
                  "2CH.24.19"
                ]
              }
            }
          ]
        },
        {
          "text": "zitere ọtụtụ ndị amụma, ndị bịara buo amụma maka ịkpọghachi ha azụ, ma ha mesiri obi ha ike, jụ ige ntị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.19",
            "verseOrgIds": [
              "2CH.24.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 24:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Mmụọ nke Chineke bịakwasịrị Zekaraya nwa Jehoiada onye nchụaja. O guzoro nʼihu ọha na eze gwa ha okwu sị; \"Otu a ka Chineke sịrị, 'Gịnị mere unu ji enupu isi nʼiwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.20",
                "verseOrgIds": [
                  "2CH.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "? Ihe agaghị agara unu nke ọma. Unu agbakụtala",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.20",
                "verseOrgIds": [
                  "2CH.24.20"
                ]
              }
            }
          ]
        },
        {
          "text": "azụ, ugbu a, ya onwe ya agbakụtakwala unu azụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.20",
            "verseOrgIds": [
              "2CH.24.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 24:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndịisi Juda niile gbara izu megide ya, sitekwa nʼiwu eze nyere ha ji nkume tugbuo ya nʼogige ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.21",
                "verseOrgIds": [
                  "2CH.24.21"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.21",
            "verseOrgIds": [
              "2CH.24.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 24:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Joash echetaghị ebere nke nna Zekaraya bụ Jehoiada meere ya kama o gburu nwa ya. Ma mgbe ọ na-anwụ, ọ sịrị, \"Ka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.22",
                "verseOrgIds": [
                  "2CH.24.22"
                ]
              }
            }
          ]
        },
        {
          "text": "hụkwa mmeso ọjọọ a ma kwụọkwa unu ụgwọ ajọ omume unu niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.22",
            "verseOrgIds": [
              "2CH.24.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 24:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo ka ọ gbara otu afọ, ndị agha Aram bịara imegide Joash, ha wakporo Juda na Jerusalem gbuo ndị ndu niile site nʼetiti ndị mmadụ. Ha zigaara eze ha nọ na Damaskọs ihe niile ha kwatara nʼike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.23",
            "verseOrgIds": [
              "2CH.24.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 24:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị na ndị Aram kpọọ naanị ndị ikom ole na ole bịa,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.24",
                "verseOrgIds": [
                  "2CH.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "raara igwe ndị agha dị ukwuu ranye ha nʼaka. Nʼihi na Juda gbakụtara",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.24.24",
                "verseOrgIds": [
                  "2CH.24.24"
                ]
              }
            }
          ]
        },
        {
          "text": "azụ, bụ Chineke nke nna nna ha, e mezuru ihe niile e kpere nʼikpe nʼahụ Joash.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.24",
            "verseOrgIds": [
              "2CH.24.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 24:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị agha Aram lara, hapụ Joash nʼọnọdụ mmerụ ahụ dị ukwuu, ndịisi ozi ya gbara izu gbuo ya, nʼihi ogbugbu o gburu nwa Jehoiada, onye nchụaja. Ha gburu ya mgbe o dina nʼihe ndina ya. Emesịa, ha liri ya nʼobodo Devid, ma ọ bụghị nʼebe a na-eli ndị eze.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.25",
            "verseOrgIds": [
              "2CH.24.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 24:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị gbara izu gbuo ya bụ Zabad, onye nne ya bụ Shimeat onye Amọn, na Jehozabad, onye nne ya bụ Shimrit onye Moab.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.26",
            "verseOrgIds": [
              "2CH.24.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 24:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile gbasara Joash na ụmụ ya, na amụma niile e buru banyere ya, na otu e si wuzie ụlọnsọ ukwu Chineke, ka e dere nʼakwụkwọ akụkọ ndị eze Izrel niile. Mgbe Joash nwụrụ, Amazaya nwa ya ghọrọ eze Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.24.27",
            "verseOrgIds": [
              "2CH.24.27"
            ]
          }
        }
      ]
    }
  ],
