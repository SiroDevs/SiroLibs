  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "2CH 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Eze nwanyị Sheba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze nwanyị Sheba nụrụ akụkọ Solomọn, ọ bịara Jerusalem ka o were ọtụtụ ajụjụ siri ike nwalee ya. O du ọtụtụ ndị ozi bara ụba bịa, tinyere ọtụtụ ịnyịnya kamel ndị bu ụda dị iche iche, ọtụtụ ọlaedo na ọtụtụ nkume dị oke ọnụahịa dị iche iche. Ọ bịakwutere Solomọn, ya na ya kparịtara ụka banyere ihe niile nke dị ya nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.1",
            "verseOrgIds": [
              "2CH.9.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn zara ya ajụjụ ya niile. Ọ dịkwaghị ihe siiri ya ike ịkọwara ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.2",
            "verseOrgIds": [
              "2CH.9.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze nwanyị Sheba hụrụ amamihe Solomọn, ma hụkwa ụlọeze o wuru,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.3",
            "verseOrgIds": [
              "2CH.9.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ihe oriri a na-adọkwasị nʼelu tebul ya, usoro ọnọdụ nke ndịisi ọchịchị ya, na ndị guzo na-ejere ya ozi nʼuwe ha yi, ndị na-ebu iko ihe ọṅụṅụ nʼuwe ha, na aja nsure ọkụ niile ọ na-achụ nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.9.4",
                "verseOrgIds": [
                  "2CH.9.4"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọ dịkwaghị ihe ọzọ ọ maara ọ ga-eme, maọbụ kwuo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.4",
            "verseOrgIds": [
              "2CH.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị eze, \"Akụkọ niile m nọ nʼala nụ banyere ihe niile ị rụpụtara na amamihe gị bụ eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.5",
            "verseOrgIds": [
              "2CH.9.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ekwenyeghị m ihe ha kwuru tutu ruo mgbe m bịara jiri anya m abụọ hụ ha. Nʼezie, ihe m nụrụ erughị ọkara nke ịdị ukwuu amamihe gị. Ị tụkwasịla ihe nʼakụkọ m nụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.6",
            "verseOrgIds": [
              "2CH.9.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, ụdị ọṅụ ndị gị na-enwe. Lee, ụdị ọṅụ nke ndị ozi na-enwe, bụ ndị na-eguzo nʼihu gị mgbe niile na-anụ okwu amamihe gị.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.7",
            "verseOrgIds": [
              "2CH.9.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngọzị dịrị",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.9.8",
                "verseOrgIds": [
                  "2CH.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, onye nwere mmasị nʼebe ị nọ. O debere gị nʼocheeze ya dịka eze ịchị nʼaha",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.9.8",
                "verseOrgIds": [
                  "2CH.9.8"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị. Nʼihi ịhụnanya nke Chineke gị nwere nʼebe Izrel nọ, na mmasị ya ime ka ha guzosie ike ruo mgbe ebighị ebi. O meela gị eze ha, ka ị debe ikpe ziri ezi na ezi omume.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.8",
            "verseOrgIds": [
              "2CH.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, O nyere Solomọn onyinye ọlaedo ịdị arọ ya dị puku kilogram anọ, nyekwa ya ụda dị iche iche, na nkume oke ọnụahịa dị iche iche. Enwebeghị ụdị ụda dịka ndị ahụ eze nwanyị Sheba nyere eze Solomọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.9",
            "verseOrgIds": [
              "2CH.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ohu Hiram na ndị ohu Solomọn bubatara ọlaedo site nʼỌfịa. Ha butekwara osisi algụm, na nkume dị oke ọnụahịa dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.10",
            "verseOrgIds": [
              "2CH.9.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze ji osisi algụm ndị ahụ mee nkwasa nrigo nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.9.11",
                "verseOrgIds": [
                  "2CH.9.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", na nke ụlọeze. O jikwa ya meere ndị na-abụ abụ ụbọ akwara na une. O nwebeghị oge ọzọ e nwere ụdị ngwa egwu e ji osisi ọma dị otu a kwaa nʼala Juda niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.11",
            "verseOrgIds": [
              "2CH.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn nyekwara eze nwanyị Sheba ihe niile ọ chọrọ na ihe niile bụ nke ọ rịọrọ. O nyere ya karịa ihe niile o wetaara ya. Emesịa, ọ hapụrụ laghachi nʼala nke aka ya, ya na ndị na-ejere ya ozi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.12",
            "verseOrgIds": [
              "2CH.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ebube ibu eze Solomọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọtụtụ ịdị arọ nke ọlaedo Solomọn na-enweta kwa afọ bụ puku kilogram iri abụọ na atọ,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.13",
            "verseOrgIds": [
              "2CH.9.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-agụnyeghị uru nke na-esi nʼaka ndị na-atụ mgbereahịa na ndị na-azụ ahịa. Ọzọkwa, ndị eze niile nke dị Arebịa na ndịisi na-achị obodo niile nke ala ahụ, na-enwetara Solomọn ọlaọcha na ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.14",
            "verseOrgIds": [
              "2CH.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn kpụrụ narị ọta ọlaedo ukwu abụọ site nʼọlaedo etipịara etipịa. Ọ bụ ọlaedo ịdị arọ ya ruru kilogram isii ka e ji kpụọ ọta ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.15",
            "verseOrgIds": [
              "2CH.9.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpụkwara narị ọta nta atọ, nke sitere na ọlaedo etipịara etipịa. Ọ bụ ọlaedo ịdị arọ ya ruru kilogram atọ na ọkara ka eji kpụọ ọta ọbụla. Eze debere ha nʼụlọeze nʼOke Ọhịa Lebanọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.16",
            "verseOrgIds": [
              "2CH.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze mekwara ocheeze dị ukwu nke e ji ọdụ enyi na ọlaedo a nụchara anụcha machie",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.17",
            "verseOrgIds": [
              "2CH.9.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ocheeze ahụ nwere ihe nrigo isii na ihe ịtụkwasị ụkwụ eji ọlaọcha rụọ nke ejikọtara nʼahụ ya. E nwere ebe ntụkwasị aka nʼakụkụ abụọ ya, nke nwere oyiyi ọdụm abụọ guzo nʼakụkụ nke ọbụla nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.18",
            "verseOrgIds": [
              "2CH.9.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọdụm iri na abụọ na-eguzo nʼelu ihe nrigo isii ahụ, otu nʼakụkụ isi abụọ nke ihe nrigo ọbụla. Ọ dịkwaghị alaeze ọzọ dị nke e mere ihe dị otu a nye.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.19",
            "verseOrgIds": [
              "2CH.9.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile Solomọn nwere nke e ji aṅụ ihe bụ ọlaedo ka e ji mee ha. Ngwongwo niile nke dị nʼime ụlọeze nʼOke Ọhịa Lebanọn bụkwa ọlaedo a nụchara anụcha ka e ji kpụọ ha. Ọ dịghị ihe e ji ọlaọcha kpụọ, nʼihi na-agụnyeghị ọlaọcha dịka ihe ọbụla nʼoge Solomọn.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.20",
            "verseOrgIds": [
              "2CH.9.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze nwere ọtụtụ ụgbọ mmiri e ji azụ ahịa nke ndị ohu Hiram na-elekọta. Otu ugbo nʼafọ atọ, ka ụgbọ ndị a na-alọta buru ọlaedo, ọlaọcha na ọdụ enyi, enwe na adaka dị iche iche bata.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.21",
            "verseOrgIds": [
              "2CH.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn bara ụba nʼakụ, nweekwa amamihe karịa ndị eze niile dị nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.22",
            "verseOrgIds": [
              "2CH.9.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị eze niile nke ụwa na-achọ ihu Solomọn, ka ha nụta okwu amamihe nke Chineke tinyere nʼobi ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.23",
            "verseOrgIds": [
              "2CH.9.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọbụla bịakwutere ya na-ebutere ya onyinye ịnata ihuọma, ya bụ ngwa ọlaọcha na ọlaedo, na uwe dị iche iche, ngwa agha, ụda dị iche iche, ịnyịnya na ịnyịnya muul, nke a bụ kwa afọ, kwa afọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.24",
            "verseOrgIds": [
              "2CH.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn nwere ụlọ anụmanụ dị puku anọ maka ịnyịnya na ụgbọ agha, nwekwa puku ịnyịnya iri na abụọ ndị o dobere nʼobodo ụgbọ agha dị iche iche, na nʼebe eze nọ na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.25",
            "verseOrgIds": [
              "2CH.9.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chịrị ndị eze niile site nʼosimiri Yufretis ruo nʼala ndị Filistia, rukwaa oke ala ndị Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.26",
            "verseOrgIds": [
              "2CH.9.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze mere ka ọlaọcha baa ụba na Jerusalem, dịka nkume efu. O mekwara ka osisi sida dịka osisi sikamọ nke dị nʼala ala ugwu dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.27",
            "verseOrgIds": [
              "2CH.9.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-esite nʼIjipt na nʼala ndị ọzọ dị iche iche atụbatara Solomọn ịnyịnya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.28",
            "verseOrgIds": [
              "2CH.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọnwụ Solomọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere Ihe ndị ọzọ mere nʼoge ọchịchị Solomọn, site na mmalite ruo nʼọgwụgwụ, ọ bụ na-edeghị ha nʼakwụkwọ Netan onye amụma, nʼime akwụkwọ amụma Ahija, onye Shilo, nakwa nʼọhụ Ido onye ọhụ ụzọ, banyere Jeroboam nwa Nebat?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.29",
            "verseOrgIds": [
              "2CH.9.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn chịrị Izrel niile iri afọ anọ na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.30",
            "verseOrgIds": [
              "2CH.9.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sooro nna nna ya ha dina nʼọnwụ. E lie ya nʼobodo Devid bụ nna ya. Rehoboam nwa ya ghọkwara eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.9.31",
            "verseOrgIds": [
              "2CH.9.31"
            ]
          }
        }
      ]
    }
  ],
