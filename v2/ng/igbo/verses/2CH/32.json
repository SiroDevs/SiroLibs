  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "32",
        "style": "c",
        "sid": "2CH 32"
      },
      "items": [
        {
          "text": "32",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Senakerib abaa mba ibuso Jerusalem agha",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 32:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hezekaya ji ikwesi ntụkwasị obi rụchaa ọrụ ndị a niile, Senakerib bụ eze Asịrịa, bịara nʼime Juda megide ya. Ọ nọchibidoro obodo niile nke e wusiri ike, na-eche na ọ ga-emeri ha nye onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.1",
            "verseOrgIds": [
              "2CH.32.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 32:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o doro eze anya na Senakerib bịara ka o buo agha megide Jerusalem,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.2",
            "verseOrgIds": [
              "2CH.32.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 32:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya mere ngwangwa kpọkọta ụmụ eze niile na ndịisi agha ya. Mgbe ha zukọtara, ha kpebiri iwuchi isi iyi ahụ niile na-esi nʼazụ obodo na-asọpụta. Ha mekwara otu a.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.3",
            "verseOrgIds": [
              "2CH.32.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 32:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kpọkọtara ọtụtụ ndị ọrụ, ndị gara gbochie isi iyi niile, mee ka mmiri gharakwa ịsọpụta nʼala ahụ niile. Ha mere nke a nʼihi na ha achọghị ka eze ndị Asịrịa na ndị agha ya nweta mmiri ha ga-aṅụ mgbe ha bịaruru ibuso Jerusalem agha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.4",
            "verseOrgIds": [
              "2CH.32.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 32:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya wuzikwara mgbidi obodo ahụ, wusie ha ike nʼebe niile ọ na-ada ada. O wukwara mgbidi ọzọ gburugburu mgbidi nke ochie ahụ. O wusikwara ebe siri ike nke Milo dị nʼobodo Devid ike, kpụọkwa ọtụtụ ngwa agha na ọta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.5",
            "verseOrgIds": [
              "2CH.32.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 32:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tinyere ndị agha niile nọ nʼobodo ahụ nʼokpuru ndịisi agha na-achị ha, mee ka ha niile zukọta nʼọnụ ụzọ ama nke obodo. Nʼebe ahụ ka ọ nọ gwa ha okwu sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.6",
            "verseOrgIds": [
              "2CH.32.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 32:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dịrịnụ ike, unu adakwala mba. Unu atụla ụjọ maọbụ daa mba nʼihi eze Asịrịa na usuu ndị agha ya, nʼihi na onye dịnyeere anyị ka ya ike.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.7",
            "verseOrgIds": [
              "2CH.32.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 32:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe nọnyere ya bụ ogwe aka nke anụ ahụ, ma nke nọnyere anyị bụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.8",
            "verseOrgIds": [
              "2CH.32.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.8",
                "verseOrgIds": [
                  "2CH.32.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke anyị, inyere anyị aka na ibu agha anyị niile.\" Okwu a, nke Hezekaya bụ eze Juda kwuru, mere ka ndị Juda nwee agbamume.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.8",
            "verseOrgIds": [
              "2CH.32.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 32:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe e mesiri, mgbe Senakerib eze Asịrịa na ndị agha ya niile nọchibidoro Lakish, o zipụrụ ndị ọrụ ya gaa Jerusalem, ka ha jiri ozi a gaa maka Hezekaya, bụ eze Juda na ndị Juda niile ndị nọ nʼebe ahụ:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.9",
            "verseOrgIds": [
              "2CH.32.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 32:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nke a bụ ihe Senakerib, bụ eze Asịrịa sịrị: Ọ bụ na gịnị ka ntụkwasị obi gị dabere, mere i ji nọgidesie ike na Jerusalem nʼọnọdụ nnọchibido a?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.10",
            "verseOrgIds": [
              "2CH.32.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 32:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hezekaya na-asị, '",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.11",
            "verseOrgIds": [
              "2CH.32.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.11",
                "verseOrgIds": [
                  "2CH.32.11"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke anyị ga-azọpụta anyị site nʼaka eze Asịrịa,' ọ bụ aghụghọ ka ọ na-aghọ unu. Ọ na-eduhie unu, na-achọ ka unu nwụọ nʼagụụ nakwa akpịrị ịkpọ nkụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.11",
            "verseOrgIds": [
              "2CH.32.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 32:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị Hezekaya na onwe ya wezugara ebe ya niile dị elu na ebe ịchụ aja ya niile, na-asị Juda na Jerusalem, 'Unu aghaghị ịkpọ isiala nʼotu ebe ịchụ aja, chụọkwa aja nʼelu ya'?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.12",
            "verseOrgIds": [
              "2CH.32.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 32:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu amaghị ihe mụ na nna m ha bụ ndị bu m ụzọ chịa mere ndị ala ọzọ? Chi niile nke mba ndị ahụ niile ha nwere ike zọpụta ala ha site nʼaka m?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.13",
            "verseOrgIds": [
              "2CH.32.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 32:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ onye nʼetiti chi niile nke mba ndị a niile, bụ ndị nna nna m ha bibiri, napụtarala ndị ya site nʼaka m? Aṅaa ka chi unu ga-esi zọpụta unu site nʼaka m?",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.14",
            "verseOrgIds": [
              "2CH.32.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2CH 32:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ekwela ka Hezekaya duhie unu, rafuokwa unu otu a. Unu ekwenyekwarala ya, nʼihi na ọ dịghị chi ọbụla maọbụ nke mba ọbụla maọbụ alaeze ọbụla pụrụ ịnapụta ndị ya site nʼaka m maọbụ nʼaka nna m ha. Ka ọ bụrụzie chi unu ga-abụ nke ga-anapụta unu site nʼaka m!\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.15",
            "verseOrgIds": [
              "2CH.32.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2CH 32:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị otu a ka ndị ozi Senakerib ahụ ji leda",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.16",
            "verseOrgIds": [
              "2CH.32.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.16",
                "verseOrgIds": [
                  "2CH.32.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke, na Hezekaya anya kwuokwa okwu mkparị megide ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.16",
            "verseOrgIds": [
              "2CH.32.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2CH 32:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Senakerib dekwara akwụkwọ mkparị ndị ọzọ, nke ọ nọ nʼime ya kwuluo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.17",
            "verseOrgIds": [
              "2CH.32.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.17",
                "verseOrgIds": [
                  "2CH.32.17"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke Izrel, na-asị, \"Dịka chi ndị ala ọzọ niile enweghị ike zọpụta ndị ha site nʼaka m, otu a kwa, Chineke nke Hezekaya apụghịkwa ịzọpụta ndị ya site nʼaka m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.17",
            "verseOrgIds": [
              "2CH.32.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2CH 32:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha ji oke olu kpọkuo ndị Jerusalem, bụ ndị nọ na mgbidi ahụ nʼasụsụ Hibru, imenye ha egwu nakwa ime ka ụjọ tụọ ha, ka ha nwee ike were obodo ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.18",
            "verseOrgIds": [
              "2CH.32.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2CH 32:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha kwuru okwu ọjọọ dị iche iche banyere Chineke nke Jerusalem, dịka ha si kwuo megide chi niile nke ndị ọzọ dị nʼụwa, bụ ọrụ aka mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.19",
            "verseOrgIds": [
              "2CH.32.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2CH 32:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Hezekaya bụ eze, na Aịzaya onye amụma, nwa Emọz, kpọkuru Chineke nke eluigwe nʼekpere.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.20",
            "verseOrgIds": [
              "2CH.32.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2CH 32:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.21",
                "verseOrgIds": [
                  "2CH.32.21"
                ]
              }
            }
          ]
        },
        {
          "text": "zipụrụ otu mmụọ ozi, onye gara tigbuo ndị agha niile bụ dike, ndị ọchịagha na ndịisi niile nọ nʼọmụma ụlọ ikwu nke eze Asịrịa. Ya mere, Senakerib ji oke ihere laghachi nʼala ya. Ma mgbe ọ gara nʼụlọ chi ya, ụfọdụ nʼime ụmụ ya ndị ikom, ndị bụ anụ ahụ na ọbara ya, were mma agha gbuo ya nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.21",
            "verseOrgIds": [
              "2CH.32.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2CH 32:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.22",
            "verseOrgIds": [
              "2CH.32.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.22",
                "verseOrgIds": [
                  "2CH.32.22"
                ]
              }
            }
          ]
        },
        {
          "text": "si zọpụta Hezekaya na ndị Jerusalem, site nʼaka Senakerib eze Asịrịa, na sitekwa nʼaka ndị iro ya ndị ọzọ. Udo dịkwara nʼala ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.22",
            "verseOrgIds": [
              "2CH.32.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2CH 32:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼoge ahụ, Hezekaya ghọrọ eze a maara aha ya na mba niile dị Juda gburugburu. Ọtụtụ mmadụ bidokwara ibutere",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.23",
            "verseOrgIds": [
              "2CH.32.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.23",
                "verseOrgIds": [
                  "2CH.32.23"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye dị iche iche na Jerusalem. Hezekaya nʼonwe ya nwetakwara onyinye nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.23",
            "verseOrgIds": [
              "2CH.32.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nganga, Ọganihu, na ọnwụ Hezekaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2CH 32:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼoge ahụ, Hezekaya rịara ọrịa, ruo na ọ gaara anwụ. Ma o kpere ekpere rịọ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.24",
            "verseOrgIds": [
              "2CH.32.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.24",
                "verseOrgIds": [
                  "2CH.32.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ọ gwọọ ya. Ọ zara ekpere ya, gosikwa ya ihe ịrịbama dị ebube.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.24",
            "verseOrgIds": [
              "2CH.32.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2CH 32:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Hezekaya ejighị obi ya niile kelee Chineke ekele nʼihi na nganga batara ya nʼobi. Nke a mere ka iwe wee",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.25",
            "verseOrgIds": [
              "2CH.32.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.25",
                "verseOrgIds": [
                  "2CH.32.25"
                ]
              }
            }
          ]
        },
        {
          "text": "megide ya na ndị Jerusalem na Juda.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.25",
            "verseOrgIds": [
              "2CH.32.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2CH 32:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Hezekaya na ndị Jerusalem wedara onwe ha nʼala, iwe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.26",
            "verseOrgIds": [
              "2CH.32.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.32.26",
                "verseOrgIds": [
                  "2CH.32.26"
                ]
              }
            }
          ]
        },
        {
          "text": "dajụrụ nʼebe ha nọ, ọ takwaghị ha ahụhụ nʼoge niile ahụ Hezekaya dị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.26",
            "verseOrgIds": [
              "2CH.32.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2CH 32:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Hezekaya ghọrọ eze bara ọgaranya, bụrụkwa onye a na-asọpụrụ. O wuru ụlọakụ maka ichebe ọlaọcha ya na ọlaedo, na nkume dị oke ọnụahịa, na ụda na-esi isi ụtọ, na ọta na efere ọlaedo ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.27",
            "verseOrgIds": [
              "2CH.32.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2CH 32:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wukwara ọtụtụ ụlọ ọzọ ebe a na-echebe ọka, na mmanya vaịnị ọhụrụ, na mmanụ oliv. O wukwara ụlọ anụmanụ maka ọtụtụ igwe ewu na atụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.28",
            "verseOrgIds": [
              "2CH.32.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2CH 32:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wukwara ọtụtụ obodo nta dị iche iche, nweekwa ọtụtụ igwe anụ ụlọ, na igwe ehi, nʼihi na Chineke mere ka ọ baa ụba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.29",
            "verseOrgIds": [
              "2CH.32.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2CH 32:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya bụkwa onye gbochiri mmiri iyi Gaihọn nʼakụkụ elu elu ya, gwuo olulu ebe mmiri ahụ si sọgharịa na-asọbata nʼakụkụ ọdịda anyanwụ nke obodo Devid. Ihe niile o mere gaara ya nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.30",
            "verseOrgIds": [
              "2CH.32.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2CH 32:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị ozi nke ndị na-achị Babilọn zitere ka ha jụọ ya banyere ihe ebube ahụ nke mere nʼala ahụ, Chineke hapụrụ ya i nwalee ya, ka ọ mara ihe niile dị ya nʼobi.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.31",
            "verseOrgIds": [
              "2CH.32.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2CH 32:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Hezekaya, na ọrụ ebere niile nke ọ rụrụ ka edere nʼakwụkwọ ọhụ onye amụma bụ Aịzaya, nwa Emọz, dịkwa nʼakwụkwọ akụkọ ndị eze Juda na Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.32",
            "verseOrgIds": [
              "2CH.32.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2CH 32:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hezekaya sooro ndị nna nna ya dinaa nʼọnwụ, e lie ya nʼugwu nʼebe ili ndị nna nna Devid dị. Ndị Juda niile na ndị niile bi na Jerusalem kwanyere ya ugwu nʼọnwụ ya. Manase nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.32.33",
            "verseOrgIds": [
              "2CH.32.33"
            ]
          }
        }
      ]
    }
  ],
