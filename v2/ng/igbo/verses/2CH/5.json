  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "2CH 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2CH 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a rụzuru ọrụ niile nke eze Solomọn nwere ịrụ maka ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.1",
                "verseOrgIds": [
                  "2CH.5.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ, o webatara ihe niile Devid bụ nna ya doro nsọ nʼime ya, ya bụ ọlaọcha, ọlaedo na ngwongwo ndị ọzọ niile. O tinyere ha nʼụlọakụ dị nʼụlọnsọ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.1",
            "verseOrgIds": [
              "2CH.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbubata igbe ọgbụgba ndụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2CH 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn kpọkọtara ndị okenye Izrel niile, na ndịisi ebo Izrel niile, na ndịisi ezinaụlọ Izrel niile na Jerusalem, maka ị site na Zayọn, bụ obodo Devid bugota igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.2",
                "verseOrgIds": [
                  "2CH.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.2",
            "verseOrgIds": [
              "2CH.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2CH 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Izrel niile gbakọtara bịakwute eze nʼoge a na-eme mmemme nʼọnwa Etanim, nke bụ ọnwa asaa nʼafọ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.3",
            "verseOrgIds": [
              "2CH.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2CH 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị okenye Izrel niile bịarutere, ndị Livayị buliri igbe ọgbụgba ndụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.4",
            "verseOrgIds": [
              "2CH.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2CH 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bugotara igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.5",
                "verseOrgIds": [
                  "2CH.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", ya na ụlọ nzute, na ngwongwo niile dị nsọ dị nʼime ya. Ndị nchụaja bụ ndị Livayị buliri ha elu.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.5",
            "verseOrgIds": [
              "2CH.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2CH 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Solomọn na ọgbakọ Izrel niile, bụ ndị zukọtara nʼebe ọ nọ, nọ nʼihu igbe ọgbụgba ndụ ahụ, na-achụ aja ọtụtụ atụrụ na ọtụtụ ehi nke a na-apụghị ịgụta ọnụ maọbụ gbakọta ọnụọgụgụ ha nʼihi ịba ụba.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.6",
            "verseOrgIds": [
              "2CH.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2CH 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja bubatara igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.7",
                "verseOrgIds": [
                  "2CH.5.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ nʼime ime ụlọnsọ ukwu ahụ, nʼime Ebe Kachasị Nsọ, dọba ya nʼokpuru nku cherubim ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.7",
            "verseOrgIds": [
              "2CH.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2CH 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cherubim ndị ahụ gbasara nku ha nʼelu igbe ọgbụgba ndụ ahụ, kpuchie ya na okporo osisi ndị ahụ e ji ebu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.8",
            "verseOrgIds": [
              "2CH.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2CH 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okporo osisi ndị a dị oke ogologo, na isi ha sitere nʼigbe ọgbụgba ndụ ahụ na-apụta, na e nwere ike ị site nʼihu ime ime ebe nsọ ahụ hụ ha anya, ma onye na-anọghị nʼEbe Nsọ ahụ adịghị ahụ ha. Ha ka dịkwa nʼebe ahụ ruo taa",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.9",
            "verseOrgIds": [
              "2CH.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2CH 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ihe dị nʼime igbe ọgbụgba ndụ ahụ, karịakwa mbadamba nkume abụọ ahụ Mosis tinyere nʼime ya nʼugwu Horeb, nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.10",
                "verseOrgIds": [
                  "2CH.5.10"
                ]
              }
            }
          ]
        },
        {
          "text": "na ụmụ Izrel gbara ndụ, mgbe ha si nʼala Ijipt pụta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.10",
            "verseOrgIds": [
              "2CH.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2CH 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị nchụaja sitere nʼEbe Nsọ Kachasị Ebe Nsọ pụta, nʼihi na ndị nchụaja ahụ niile doro onwe ha nsọ nʼagbanyeghị usuu nke onye ọbụla nʼime ha si pụta.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.11",
            "verseOrgIds": [
              "2CH.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2CH 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị Livayị bụ ndị ọbụ abụ, ya bụ Asaf, Heman, Jedutun na ụmụ ha ndị ikom na ndị ikwu ha guzoro onwe ha nʼakụkụ ọwụwa anyanwụ nke ebe ịchụ aja. Ha yi uwe ezi akwa ọcha ma na-akpọ ụbọ akwara, na-akụkwa ogene ọla. Ndị nchụaja dị otu narị na iri abụọ (120) nʼọnụọgụgụ. Ndị na-afụ opi sokwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.12",
            "verseOrgIds": [
              "2CH.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2CH 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọbụ abụ ahụ na ndị na-afụ opi jikọrọ onwe ha ọnụ were otu olu bụkuo",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ ekele na otuto. Ndị na-afụ opi, na ndị na-akụ ọla na-ada ụda, na ndị ji ngwa egwu ndị ọzọ sonyeere ha, welie olu ha elu too",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼabụ sị:",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "\"Nʼihi na Ọ dị mma",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "Ịhụnanya ya na-adị ruo ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2CH 5:13"
      },
      "items": [
        {
          "text": "Mgbe ahụ igwe ojii jupụtara nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.13",
                "verseOrgIds": [
                  "2CH.5.13"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.13",
            "verseOrgIds": [
              "2CH.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2CH 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke mere na ndị nchụaja enwekwaghị ike jee ozi ha, nʼihi igwe ojii ahụ, nʼihi na ebube",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2CH.5.14",
                "verseOrgIds": [
                  "2CH.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "jupụtara nʼime ụlọnsọ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "2CH.5.14",
            "verseOrgIds": [
              "2CH.5.14"
            ]
          }
        }
      ]
    }
  ],
