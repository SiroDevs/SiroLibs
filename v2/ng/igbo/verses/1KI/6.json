  "verseCount": 38,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "1KI 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomọn ewuo Ụlọnsọ Ukwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn bidoro iwu ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.1",
                "verseOrgIds": [
                  "1KI.6.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ nʼọnwa Zif,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        },
        {
          "text": "bụ ọnwa nke abụọ nʼafọ nke anọ nke ịbụ eze ya. Ọ bụkwa nʼafọ nke mere ya narị afọ anọ na iri afọ asatọ site nʼoge ndị Izrel si nʼala Ijipt pụta.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.1",
            "verseOrgIds": [
              "1KI.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọnsọ nke eze Solomọn wuuru",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.2",
                "verseOrgIds": [
                  "1KI.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "dị iri mita abụọ na asaa nʼogologo, mita itoolu nʼobosara, ebe ịla elu ya dịkwa mita iri na anọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.2",
            "verseOrgIds": [
              "1KI.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mpụta ọnụ ụlọ nke dị nʼihu ụlọ ezumezu nke ụlọnsọ ahụ dị mita itoolu nʼogologo nke gbakwunyere ihe nʼobosara ụlọnsọ ahụ, dịrịkwa mita anọ na ọkara nʼobosara ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.3",
            "verseOrgIds": [
              "1KI.6.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "O meere ụlọnsọ ahụ oghereikuku kpara nkpa nʼime ma saa mbara nʼezi, nʼebe elu elu mgbidi ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.4",
            "verseOrgIds": [
              "1KI.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼakụkụ mgbidi ụlọ ezumezu ahụ nakwa mgbidi nke ime ebe nsọ ahụ, o wuru okpukpu gburugburu ụlọ ahụ, nke nwere ọtụtụ ụlọ nta dị iche iche gbaa gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.5",
            "verseOrgIds": [
              "1KI.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obosara okpukpu ụlọ nke dịkarịsịrị ala",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        },
        {
          "text": "bụ mita abụọ na ọkara, obosara okpukpu nke ụlọ etiti dị mita atọ, otu a kwa, obosara okpukpu ụlọ nke atọ dị mita atọ na ọkara. Mgbe e wuru mgbidi gbara ụlọnsọ ukwu ahụ gburugburu, e wukwara ihe dịka aka nʼakụkụ mgbidi ahụ niile. Ọ bụ nʼelu ihe ndị a dịka aka ka e dokwasịrị osisi e ji wuo ọnụụlọ nta ndị ahụ. Nʼụzọ dị otu a, ka e ji gbochie ịmanye ihe ọbụla nʼaja ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.6",
            "verseOrgIds": [
              "1KI.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a na-ewu ụlọnsọ ukwu ahụ, ọ bụ naanị nkume awara nke ọma nʼebe a nọ gwupụta ha ka eji wuo ya. O nweghị onye nụrụ ụzụ itipịa nkume, maọbụ ụzụ ịwa osisi, maọbụ ụdị mkpọtụ ahụ ngwa ọrụ mkpirisi igwe na-eme, nʼebe a nọ wuo ụlọnsọ ukwu ahụ, mgbe a na-ewu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.7",
            "verseOrgIds": [
              "1KI.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnụ ụzọ e si abata nʼọnụ ụlọ ndị dị nʼokpukpu ụlọ elu nke mbụ dị nʼakụkụ aka nri nke ụlọnsọ ukwu ahụ. E nwekwara ụzọ nrigo e wuru e si abanye nʼọnụ ụlọ ndị dị nʼokpukpu ndị dị nʼetiti. A na-esitekwa na nke a rigoro ruo na nke atọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.8",
            "verseOrgIds": [
              "1KI.6.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o wusiri ụlọnsọ ukwu a, Solomọn jiri ibe osisi na osisi dị obosara e si nʼosisi sida mepụta, wuo ihe mgbachị elu ụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.9",
            "verseOrgIds": [
              "1KI.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ọtụtụ ọnụụlọ nta nʼakụkụ mgbidi gbara ụlọnsọ ukwu ahụ gburugburu. Ọ bụkwa osisi sida ka e ji jikọta mgbidi ụlọ ahụ na ọnụụlọ nta ndị ahụ. Ịdị elu nke ọbụla nʼime ha bụ mita abụọ na ọkara.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.10",
            "verseOrgIds": [
              "1KI.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.11",
                "verseOrgIds": [
                  "1KI.6.11"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere Solomọn ntị,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.11",
            "verseOrgIds": [
              "1KI.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Banyere ụlọnsọ ukwu a i na-ewu, ọ bụrụ na i mee ihe m gwara gị, gbasoo ihe niile m nyere gị nʼiwu, ma mezuo okwu m niile, aga m esite na gị mezuo nkwa ahụ m kwere nna gị Devid.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.12",
            "verseOrgIds": [
              "1KI.6.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ebikwa nʼetiti ndị Izrel, agaghị m ahapụkwa ndị m, Izrel.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.13",
            "verseOrgIds": [
              "1KI.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Solomọn wusiri ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.14",
            "verseOrgIds": [
              "1KI.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji osisi sida dị obosara machie ahụ ime ụlọnsọ ukwu ahụ site nʼakụkụ ala ruo nʼelu ya. E jikwa osisi junipa machie ala ụlọ ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.15",
            "verseOrgIds": [
              "1KI.6.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji osisi sida kewapụta ihe ruru mita itoolu nʼazụ ụlọnsọ ukwu ahụ, site nʼala ụlọ ahụ ruo nʼelu, nʼihi iwepụta site nʼụlọnsọ ahụ, ime ime ebe nsọ, nke bụ Ebe Kachasị Nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.16",
            "verseOrgIds": [
              "1KI.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ ezumezu nke dị nʼihu ọnụụlọ a dị iri mita na asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.17",
            "verseOrgIds": [
              "1KI.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụ ime ụlọnsọ ukwu ahụ bụ osisi sida, nke a tụrụ ihe ọtụtụ nke oyiyi afụfa ọhịa na okoko osisi wasara awasa nʼelu ya. Ihe niile dị nʼime ụlọ ahụ bụ osisi sida, adịghị ahụ nkume ọbụla anya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.18",
            "verseOrgIds": [
              "1KI.6.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kwadokwara ebe nsọ ahụ, ebe dị nʼime ime ụlọ ahụ, maka idebe igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.19",
                "verseOrgIds": [
                  "1KI.6.19"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.19",
            "verseOrgIds": [
              "1KI.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ime ime ebe nsọ ahụ, dị mita iri nʼogologo, obosara ya dịkwa mita iri, ịdị elu ya dịkwa mita iri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "text": "O ji ọlaedo a nụchara anụcha machie ahụ ime ụlọ a niile, jiri osisi sida machie ebe nchụaja ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.20",
            "verseOrgIds": [
              "1KI.6.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 6:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn ji ọlaedo a nụchara anụcha machie ahụ ime ụlọnsọ ukwu ahụ. Ọ gbatịrị ụdọ ọlaedo gafere nʼihu ime ime ebe nsọ ahụ, nke e jikwa ọlaedo machie.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.21",
            "verseOrgIds": [
              "1KI.6.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 6:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, o ji ọlaedo machie ime ya niile. O jikwa ọlaedo machie ebe ịchụ aja nke dịịrị ime ime ebe nsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.22",
            "verseOrgIds": [
              "1KI.6.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 6:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere cherubim abụọ, nke e ji osisi oliv tụọ nʼime ime ebe nsọ ahụ, ịdị elu nke ọbụla bụ mita ise.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.23",
            "verseOrgIds": [
              "1KI.6.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 6:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cherub nke mbụ nwere nku abụọ, otu nku dị mita abụọ na ụma atọ nʼogologo, nku nke ọzọ dịkwa mita abụọ na ụma atọ nʼogologo. Ya bụ, mita ise site na ụma isii, site nʼọnụ otu nku ruo nʼọnụ nku nke ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.24",
            "verseOrgIds": [
              "1KI.6.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 6:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cherub nke abụọ dịkwa iri mita na ụma isii, nʼihi na cherubim abụọ ndị a bụ otu nʼọtụtụ nakwa nʼibu ibu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.25",
            "verseOrgIds": [
              "1KI.6.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 6:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịdị elu nke cherub ọbụla ruru mita ise na ụma isii.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.26",
            "verseOrgIds": [
              "1KI.6.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 6:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tinyere cherubim ndị a nke gbasapụrụ nku ha nʼime ime Ebe Nsọ Kachasị Nsọ nke ụlọnsọ ukwu. Ọnụ ọnụ nke nku cherub ọbụla na-emetụ otu akụkụ ahụ ụlọ ahụ, ebe ọnụ ọnụ nke nku cherub ọbụla na-emetụ na nke ibe ya nʼetiti ọnụụlọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.27",
            "verseOrgIds": [
              "1KI.6.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 6:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jiri ọlaedo machie cherubim ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.28",
            "verseOrgIds": [
              "1KI.6.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "1KI 6:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼahụ aja ụlọnsọ ukwu ahụ gbaa gburugburu, ma nʼime ọnụụlọ nke dị nʼime na ndị dị na mpụta, ka ọ pịkwasịrị oyiyi cherubim, osisi nkwụ na okoko osisi wara awa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.29",
            "verseOrgIds": [
              "1KI.6.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "1KI 6:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jikwa ọlaedo machie ala ụlọ nke ọnụụlọ niile dị nʼime ụlọ, na ọnụụlọ ndị dị na mpụta ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.30",
            "verseOrgIds": [
              "1KI.6.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "1KI 6:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ji osisi oliv mee ibo ọnụ ụzọ mbata nke ime ime ebe nsọ ahụ, osisi ndị a bụ otu ụzọ nʼụzọ ise nke obosara ebe nsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.31",
            "verseOrgIds": [
              "1KI.6.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "1KI 6:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼahụ ibo abụọ ahụ nke si nʼosisi oliv, ọ tụnyere oyiyi cherubim abụọ, igu nkwụ na okoko osisi wara awa. O ji ọlaedo etipịara etipịa machie oyiyi cherubim na igu nkwụ ndị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.32",
            "verseOrgIds": [
              "1KI.6.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "1KI 6:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a kwa, o ji osisi oliv mee mbudo ibo ọnụ ụzọ e si abata nʼụlọ ezumezu ahụ, nke bụ otu ụzọ na nkewa anọ nke obosara ụlọ ezumezu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.33",
            "verseOrgIds": [
              "1KI.6.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "1KI 6:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jikwa osisi junipa mee ibo abụọ a na-emechikọta nʼotu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.34",
            "verseOrgIds": [
              "1KI.6.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "1KI 6:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ pịrị oyiyi cherubim na oyiyi nkwụ, na oyiyi okoko osisi wara awa, jiri ọlaedo techie ibo ndị ahụ na oyiyi a pịkwasịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.35",
            "verseOrgIds": [
              "1KI.6.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "1KI 6:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wuru ogige nʼime ụlọnsọ ukwu ahụ. Ọ bụ ahịrị nkume atọ e doziri edozi na otu ahịrị osisi sida a kwachara nke ọma ka e ji wuo ogige a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.36",
            "verseOrgIds": [
              "1KI.6.36"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "1KI 6:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼọnwa Ziv, nʼafọ nke anọ, nke ịbụ eze Solomọn ka a tọrọ ntọala ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.6.37",
                "verseOrgIds": [
                  "1KI.6.37"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.37",
            "verseOrgIds": [
              "1KI.6.37"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "1KI 6:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼime afọ iri na otu, nʼọnwa Bul,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        },
        {
          "text": "ya bụ ọnwa nke asatọ, ka e wusiri ụlọnsọ ukwu ahụ, nʼihe niile ya dịka ntụziaka e nyere si dị. Ọ bụ afọ asaa ka o weere ya i ji rụchaa ụlọnsọ ukwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.6.38",
            "verseOrgIds": [
              "1KI.6.38"
            ]
          }
        }
      ]
    }
  ],
