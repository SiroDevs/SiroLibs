  "verseCount": 28,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "1KI 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Solomọn arịọ maka amamihe",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1KI 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn na Fero eze Ijipt jikọtara onwe ha nʼotu, ọ lụrụ nwa nwanyị Fero. Ọ kpọbatara ya nʼobodo Devid ruo mgbe o wusiri ụlọeze ya na ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.1",
                "verseOrgIds": [
                  "1KI.3.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", na mgbidi gbara Jerusalem gburugburu.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.1",
            "verseOrgIds": [
              "1KI.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1KI 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, ndị Izrel ka na-achụ aja ha nʼebe dị elu niile, nʼihi na ewubeghị ụlọnsọ ukwu nye aha",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.2",
                "verseOrgIds": [
                  "1KI.3.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.2",
            "verseOrgIds": [
              "1KI.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1KI 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Solomọn gosiri ịhụnanya nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.3",
                "verseOrgIds": [
                  "1KI.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ, site na ịgbaso ntụziaka niile nke Devid nna ya nyere ya, ọ bụ naanị na ọ chụrụ ọtụtụ aja dị iche iche, na ihe nsure ọkụ na-esi isi ụtọ nʼebe dị elu dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.3",
            "verseOrgIds": [
              "1KI.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1KI 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze gara Gibiọn nʼihi ịchụ aja, nʼihi na ebe ahụ bụ ebe kachasị mkpa, dị elu. Solomọn chụrụ otu puku aja nsure ọkụ nʼelu ebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.4",
            "verseOrgIds": [
              "1KI.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1KI 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na Gibiọn,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.5",
            "verseOrgIds": [
              "1KI.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.5",
                "verseOrgIds": [
                  "1KI.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka Solomọn hụ ya anya na nrọ nke abalị, Chineke sịrị ya, \"Rịọọ ihe ọbụla ị chọrọ ka m nye gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.5",
            "verseOrgIds": [
              "1KI.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1KI 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Solomọn zara sị, \"I gosila ohu gị bụ nna m Devid obi ebere dị ukwuu, nʼihi na ọ bụ onye kwesiri ntụkwasị obi nye gị, onye ezi omume nakwa onye obi ya ziri ezi. Ị nọgidela na-egosi ya obi ebere dị ukwuu, nyekwa ya nwa nwoke ga-anọkwasị nʼocheeze ya nʼụbọchị taa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.6",
            "verseOrgIds": [
              "1KI.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1KI 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "1KI.3.7",
                "verseOrgIds": [
                  "1KI.3.7"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke m, i meela ohu gị eze nʼọnọdụ nna m, bụ Devid. Ma abụ m naanị nwantakịrị",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "text": "na-amaghị otu esi apụ ma na-abatakwa.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.7",
            "verseOrgIds": [
              "1KI.3.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1KI 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ohu gị nọ nʼebe a, nʼetiti ndị gị ị họpụtara, ndị bara ụba nke ukwuu, ndị a na-adịghị agụta ọnụ nʼihi nʼọnụọgụgụ ha babigara ụba oke.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.8",
            "verseOrgIds": [
              "1KI.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1KI 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nye ohu gị uche nghọta nke m ga-eji chịa ndị gị, na ịghọta ihe dị iche nʼetiti ezi ihe na ajọ ihe. Nʼihi na onye pụrụ ịchịkọta ndị gị a dị ukwuu?\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.9",
            "verseOrgIds": [
              "1KI.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1KI 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ masịrị Onyenwe anyị na Solomọn rịọrọ nke a.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.10",
            "verseOrgIds": [
              "1KI.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1KI 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Chineke zara sị ya, \"Nʼihi na ị rịọrọ amamihe na nghọta ị ga-eji chịa ndị m, ma ị rịọghị m ka m nye gị ndụ ogologo, maọbụ akụnụba, maọbụ ọnwụ nye ndị iro gị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.11",
            "verseOrgIds": [
              "1KI.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1KI 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme dịka ihe ị rịọrọ si dị. Aga m enye gị obi maara ihe na uche ịghọta ihe ziri ezi, nke ga-abụ na ọ dịghị onye ọbụla dịka gị, ọ dịghịkwa onye ọbụla ga-adị ka gị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.12",
            "verseOrgIds": [
              "1KI.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1KI 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, aga m enyekwa gị ihe ndị ahụ ị na-arịọghị m, akụnụba, na nsọpụrụ, ka ọ ga-abụ nʼụbọchị niile nke ndụ gị, ị gaghị enwe onye ọbụla ga-adị ka gị nʼetiti ndị eze niile.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.13",
            "verseOrgIds": [
              "1KI.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1KI 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụkwa na i jee ije nʼụzọ m niile, debe iwu m, meekwa ihe m gwara gị, dịka nna gị Devid mere, aga m enye gị ogologo ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.14",
            "verseOrgIds": [
              "1KI.3.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1KI 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Solomọn si nʼụra teta, ghọtakwa na ọ bụ nrọ ka ọ na-arọ.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:15"
      },
      "items": [
        {
          "text": "Ọ lọtara na Jerusalem bata guzo nʼihu igbe ọgbụgba ndụ Onyenwe anyị, chụọ aja nsure ọkụ na aja udo. Emesịa, o meere ndị na-ejere ya ozi oke oriri.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.15",
            "verseOrgIds": [
              "1KI.3.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe ziri ezi Solomọn kpere",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1KI 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, ụmụ nwanyị akwụna abụọ bịakwutere eze, guzo nʼihu ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.16",
            "verseOrgIds": [
              "1KI.3.16"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.16",
            "verseOrgIds": [
              "1KI.3.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1KI 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nʼime ha gwara ya sị, \"Onyenwe m, mụ na nwanyị a bi nʼotu ụlọ. Anyị abụọ dịkwa ime. Ma eburu m ya ụzọ mụọ nwa nke m.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.17",
            "verseOrgIds": [
              "1KI.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1KI 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị atọ gasịrị ka m mụsịrị nwa, ya onwe ya mụkwara nwa nke ya. Naanị anyị abụọ bi, o nweghị onye ọzọ binyere anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.18",
            "verseOrgIds": [
              "1KI.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1KI 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma nʼotu abalị, nwa ya nwụrụ mgbe o dinakwasịrị ya nʼoge ọ na-arahụ ụra.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.19",
            "verseOrgIds": [
              "1KI.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1KI 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o biliri nʼetiti abalị, chọpụtara na nwa ya anwụọla, o kuuru ya nibe ya nʼakụkụ m, kurukwanụ nwa nke m dị ndụ nibe nʼakụkụ ya onwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.20",
            "verseOrgIds": [
              "1KI.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "1KI 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼisi ụtụtụ, mgbe m tetara nʼụra chọọ inye nwa m ara, achọpụtara m na ọ nwụọla. Ma mgbe m leziri ya anya nke ọma ka chi bọrọ, ahụrụ m na nwa mụ na ya dina abụghị nwa nke m mụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.21",
            "verseOrgIds": [
              "1KI.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "1KI 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, nwanyị nke ọzọ kwuru sị, \"Mba, nwantakịrị ahụ dị ndụ bụ nwa m, ma nke nwụrụ anwụ bụ nwa gị.\" Nwanyị nke mbụ zara sị,",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:22"
      },
      "items": [
        {
          "text": "\"Mba, ọ bụghị eziokwu; nwa nke nwụrụ anwụ bụ nke gị, ma nke dị ndụ bụ nke m.\" Otu a ka ha si na-arụrịta ụka nʼihu eze.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.22",
            "verseOrgIds": [
              "1KI.3.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "1KI 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze kwuru sị, \"Onye nke a na-asị, 'Nwa m bụ nke dị ndụ, ma nke gị bụ nke nwụrụ anwụ,' mgbe onye nke ọzọ na-asị, 'Mba! Nwa gị bụ nke nwụrụ anwụ, ma nke m bụ nke dị ndụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.23",
            "verseOrgIds": [
              "1KI.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "1KI 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze sịrị, \"Wetara m mma agha.\" Ya mere, ha wetaara eze mma agha.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.24",
            "verseOrgIds": [
              "1KI.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "1KI 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze nyere iwu sị, \"Kpọwaa nwa ahụ dị ndụ ụzọ abụọ, were otu ọkara nye otu onye, werekwa nke ọzọ nye onye nke ọzọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.25",
            "verseOrgIds": [
              "1KI.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "1KI 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwanyị ahụ nwa ya dị ndụ jupụtara nʼọmịiko nʼebe nwa ya nọ, ọ gwara eze sị, \"Biko, onyenwe m, kunye ya nwantakịrị ahụ dị ndụ. Egbukwala ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1KI 3:26"
      },
      "items": [
        {
          "text": "Ma onye nke ọzọ sịrị, \"Kpọwaa ya abụọ. Nwa a agaghị abụ nke gị, ọ gaghị abụkwa nke m.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.26",
            "verseOrgIds": [
              "1KI.3.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "1KI 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze kpebiri ikpe sị, \"Kuru nwantakịrị a dị ndụ kunye ya nwanyị ahụ chọrọ ka ọ dị ndụ. Egbula ya, nʼihi na nwanyị ahụ bụ nne ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.27",
            "verseOrgIds": [
              "1KI.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "1KI 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Izrel niile nụrụ otu eze si kpebie ikpe a, ha sitere nʼịtụ egwu nye eze nsọpụrụ, nʼihi na ha hụrụ na o si nʼaka Chineke nweta amamihe",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.28",
            "verseOrgIds": [
              "1KI.3.28"
            ]
          }
        },
        {
          "text": "ikpe ikpe ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "1KI.3.28",
            "verseOrgIds": [
              "1KI.3.28"
            ]
          }
        }
      ]
    }
  ],
