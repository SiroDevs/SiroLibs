      "items": [
        {
          "text": "nʼihi na ụmụ nwanyị ahụ a hapụrụ naanị ya ga-adị ọtụtụ",
          "type": "text",
          "attrs": {
            "verseId": "GAL.4.27",
            "verseOrgIds": [
