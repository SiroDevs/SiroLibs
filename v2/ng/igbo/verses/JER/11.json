  "verseCount": 23,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "JER 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Edebezughị ọgbụgba ndụ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ okwu nke sị nʼebe",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.1",
                "verseOrgIds": [
                  "JER.11.1"
                ]
              }
            }
          ]
        },
        {
          "text": "nọ bịakwute Jeremaya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.1",
            "verseOrgIds": [
              "JER.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gee ntị nʼihe niile metụtara ọgbụgba ndụ a, gwakwa ndị Juda, na ndị bi na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.2",
            "verseOrgIds": [
              "JER.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ha na nke a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.3",
                "verseOrgIds": [
                  "JER.11.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel kwuru, 'Onye a bụrụ ọnụ ka mmadụ ahụ bụ nke na-adịghị edebe ihe niile banyere ọgbụgba ndụ a,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.3",
            "verseOrgIds": [
              "JER.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "bụ nke m nyere nna nna unu ha, mgbe m si nʼIjipt, site nʼoke ọkụ e ji agbaze igwe, kpọpụta ha.' Asịrị m, Ruberenụ m isi, meekwa ihe niile m nyere unu nʼiwu, unu ga-abụ ndị m, mụ onwe m kwa ga-abụkwa Chineke unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.4",
            "verseOrgIds": [
              "JER.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Mgbe ahụ, aga m emezu iyi ahụ m ṅụụrụ nna nna unu ha, inye ha ala mmiri ara ehi na mmanụ aṅụ na-eru na ya,' ya bụ, ala ahụ unu bi nʼime ya taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "JER 11:5"
      },
      "items": [
        {
          "text": "Azara m sị, \"Amen,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.5",
                "verseOrgIds": [
                  "JER.11.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.5",
            "verseOrgIds": [
              "JER.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.6",
                "verseOrgIds": [
                  "JER.11.6"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Kpọsaa okwu ndị a nʼobodo Juda niile, na nʼokporoụzọ Jerusalem niile, 'Geenụ ntị nʼiwu nke ọgbụgba ndụ ahụ, ma mezuo ihe o kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.6",
            "verseOrgIds": [
              "JER.11.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼoge ahụ m si nʼala Ijipt kpọpụta nna nna unu ha ruo taa, adọọla m unu aka na ntị mgbe mgbe sị, \"Ruberenụ m isi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.7",
            "verseOrgIds": [
              "JER.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha jụrụ ige ntị. Ha akpọkwaghị okwu m mkpa dịrị ha. Kama ha jegharịrị nʼisiike nke obi ọjọọ ha. Ọ bụ nke a mere m ji mee ka ọbụbụ ọnụ niile nke ya na ọgbụgba ndụ ahụ so bịakwasị ha, dịka m buru ụzọ nye nʼiwu, ma ihe ndị a emeghị ka ha jezie ije.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.8",
            "verseOrgIds": [
              "JER.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
            "verseOrgIds": [
              "JER.11.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.9",
                "verseOrgIds": [
                  "JER.11.9"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m sị, \"Achọpụtala na-enwere njikọta na ịgba izu mmegide nʼetiti ndị Juda na ndị bi na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.9",
            "verseOrgIds": [
              "JER.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha alaghachila azụ nʼụdị mmehie ahụ nna nna ha mehiere, bụ ndị ahụ jụrụ ige ntị nʼokwu m. Ha agbasoola chi ndị ọzọ na-efe ha. Ụlọ Izrel na ụlọ Juda adịghị edebekwa ọgbụgba ndụ ahụ mụ na nna nna ha gbara.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.10",
            "verseOrgIds": [
              "JER.11.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, nke a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.11",
                "verseOrgIds": [
                  "JER.11.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Aga m eme ka mbibi, nke ha na-enweghị ike ịgbanarị, bịakwasị ha. Ọ bụrụkwa na ha akpọkuo m agaghị m aṅa ntị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.11",
            "verseOrgIds": [
              "JER.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị obodo Juda na ndị bi na Jerusalem ga-apụ kpọkuo chi ndị ahụ niile ha na-achụrụ aja ihe nsure ọkụ na-esi isi ụtọ, ma chi ndị a agaghị enyere ha aka mgbe mbibi a bịakwasịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.12",
            "verseOrgIds": [
              "JER.11.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị, bụ Juda, nwere ọtụtụ chi dị iche iche dịka obodo dị nʼime gị si dị ọtụtụ. Ebe ịchụ aja i wukwara nʼihi ịchụrụ chi ahụ na-eweta ihere bụ Baal aja ihe nsure ọkụ na-esi isi ụtọ, dịkwa ọtụtụ dịka okporoụzọ dị na Jerusalem.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.13",
            "verseOrgIds": [
              "JER.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ekperela ndị a ekpere, arịọkwala arịrịọ ọbụla nʼihi ha. Nʼihi na agaghị m ege ntị mgbe ha ga-akpọku m nʼoge ihe mgbu ha.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.14",
            "verseOrgIds": [
              "JER.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gịnị ka onye m hụrụ nʼanya na-eme nʼime ụlọnsọ ukwuu m,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "mgbe ya na ọtụtụ ndị ọzọ na-ejikọta onwe ha nʼotu ịtụ atụmatụ ihe ọjọọ?",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "Anụ e doro nsọ apụghị ime ka ahụhụ unu kwesiri ịnata hapụ ịbịakwasị unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "A sị na o si otu a dịrị, mgbe ahụ, unu pụrụ ịṅụrị ọṅụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:15"
      },
      "items": [
        {
          "text": "mgbe unu na-eme ihe ọjọọ unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.15",
            "verseOrgIds": [
              "JER.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.16",
                "verseOrgIds": [
                  "JER.11.16"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere gị bụ Osisi oliv dị ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "nke na-amị mkpụrụ mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "Ma ọ bụ olu mkpọtụ nke oke mmiri ozuzo",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "ka ọ ga-eji mụkwasị gị ọkụ;",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:16"
      },
      "items": [
        {
          "text": "alaka gị ga-agbajisikwa.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.16",
            "verseOrgIds": [
              "JER.11.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.17",
                "verseOrgIds": [
                  "JER.11.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile bụ onye ahụ kụnyere gị nʼala, e nyela iwu na mbibi ga-abịakwasị gị, nʼihi na ndị Izrel na Juda emeela ihe ọjọọ, kpasuo m iwe site nʼịchụ aja ihe nsure ọkụ na-esi isi ụtọ nye Baal.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.17",
            "verseOrgIds": [
              "JER.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzube ọjọọ megide Jeremaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
            "verseOrgIds": [
              "JER.11.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.18",
                "verseOrgIds": [
                  "JER.11.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kpughere izuzu ọjọọ ha nye m; amatakwara m ihe ha na-ezube, nʼihi na o gosiri m ya nʼoge ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.18",
            "verseOrgIds": [
              "JER.11.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 11:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m dị ka nwa atụrụ dị nwayọọ nke e du na-aga ebe a ga-egbu ya. Ma aghọtaghị m na ọ bụ m ka ha zubererị nzube ọjọọ megide. Ha kwuru sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "\"Bịanụ ka anyị bibie osisi a na mkpụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "Ka anyị site nʼala ndị dị ndụ wezuga ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:19"
      },
      "items": [
        {
          "text": "ka a hapụ ichetakwa aha ya ọzọ\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.19",
            "verseOrgIds": [
              "JER.11.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 11:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.20",
                "verseOrgIds": [
                  "JER.11.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, ị bụ onye na-ekpe ikpe ziri ezi,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "na-anwapụtakwa obi mmadụ na mmụọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "Mee ka m hụ mgbe ị ga-abọ ọbọ megide ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 11:20"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ nʼaka gị ka m na-etinye okwu a metụtara m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.20",
            "verseOrgIds": [
              "JER.11.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 11:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nke a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.21",
                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu banyere ndị Anatot ahụ na-achọ ịnapụ gị ndụ gị, ndị ahụ na-asị gị, \"Ebukwala amụma site nʼaha",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.21",
                "verseOrgIds": [
                  "JER.11.21"
                ]
              }
            }
          ]
        },
        {
          "text": "ka ị ghara ịnwụ nʼaka anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.21",
            "verseOrgIds": [
              "JER.11.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 11:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.11.22",
                "verseOrgIds": [
                  "JER.11.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru, sị, \"Aga m ata ha ahụhụ. Ụmụ okorobịa ha ga-anwụ site na mma agha, ụnwụ ga-egbukwa ụmụ ha ndị ikom na ndị inyom.",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.22",
            "verseOrgIds": [
              "JER.11.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 11:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nweghị ndị ga-afọdụ ndụ nʼime ha nʼihi na a ga-eme ka oke mbibi bịakwasị ndị Anatot nʼafọ ahụ m ga-ata ha ahụhụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.11.23",
            "verseOrgIds": [
              "JER.11.23"
            ]
          }
        }
      ]
    }
