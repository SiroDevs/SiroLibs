  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "33",
        "style": "c",
        "sid": "JER 33"
      },
      "items": [
        {
          "text": "33",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkwa banyere nlọghachi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 33:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Jeremaya ka nọ dịka onye mkpọrọ nʼogige ụlọ ndị nche, okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.1",
                "verseOrgIds": [
                  "JER.33.1"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru ya ntị nke ugboro abụọ, sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.1",
            "verseOrgIds": [
              "JER.33.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 33:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye ahụ kere ụwa kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", onye kpụrụ ya mee ya ka o guzosie ike, Onye aha ya bụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.2",
                "verseOrgIds": [
                  "JER.33.2"
                ]
              }
            }
          ]
        },
        {
          "text": ":",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.2",
            "verseOrgIds": [
              "JER.33.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 33:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Kpọkuo m, aga m aza gị, gosi gị ihe dị ukwuu dị iche iche, na ihe siri ike na nghọta nke ị na-amaghị.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.3",
            "verseOrgIds": [
              "JER.33.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 33:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nke a bụ ihe",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.4",
                "verseOrgIds": [
                  "JER.33.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke Izrel, kwuru banyere ụlọ ndị ahụ niile dị nʼobodo, na ụlọeze niile nke ndị eze Juda, bụ nke akwadara maka iji megide nnọchibido niile na mma agha",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.4",
            "verseOrgIds": [
              "JER.33.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 33:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼagha a na-alụso ndị Babilọn. 'Aga eji ozu ndị mmadụ ahụ niile m ga-etigbu site nʼiwe m na nʼọnụma m kpojuo ha. Aga m ezo ihu m site nʼebe obodo a nọ, nʼihi ajọ omume ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.5",
            "verseOrgIds": [
              "JER.33.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 33:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ma otu ọ dị, aga m agwọ ya, mee ka ahụ sie ya ike. Aga m agwọ ndị m, meekwa ka ha nwe udo nʼebe ọ bara ụba. Ha ga-ebikwa nʼudo na-enweghị egwu ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.6",
            "verseOrgIds": [
              "JER.33.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 33:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m emekwa ka ndị Izrel na ndị Juda a dọtara nʼagha lọta. Aga m ewugharịkwa ha dịka ụlọ, mee ka ha dịrị ka ha dị na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.7",
            "verseOrgIds": [
              "JER.33.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 33:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ha dị ọcha site na mmehie ha niile, nke ha mere megide m. Aga m agbaghara ha mmehie ha na nnupu isi ha niile megide m.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.8",
            "verseOrgIds": [
              "JER.33.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 33:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, obodo a ga-aghọkwa ihe ga-eme ka mba niile nke ụwa mara m, ka ha ṅụrịa ọṅụ nʼime m, tookwa m, ma wetara m nsọpụrụ, mgbe ha ga-anụ ihe ọma niile m meere obodo a. Ha ga-atụkwa oke egwu, maakwa jijiji, nʼihi ezi ihe ahụ niile na nʼihi udo ahụ niile nke mụ onwe m mere ka o rute ha aka.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.9",
            "verseOrgIds": [
              "JER.33.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 33:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.10",
                "verseOrgIds": [
                  "JER.33.10"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Unu na-asị banyere ebe a, \"Ọ bụ mkpọmkpọ ebe, ebe ụmụ mmadụ na ụmụ anụmanụ na-ebighị nʼime ya.\" Ma nʼobodo Juda, ya na okporoụzọ niile dị na Jerusalem, nke tọgbọrọ nʼefu ugbu a, nke mmadụ maọbụ anụmanụ na-ebighị nʼime ya, a ga-emesịa nụkwa",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.10",
            "verseOrgIds": [
              "JER.33.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 33:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "olu ọṅụ na obi ụtọ, na olu ndị ikom na ndị inyom na-alụ di na nwunye, na olu ndị ahụ niile na-eweta onyinye ekele nʼụlọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", ndị ahụ ga-asị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "\" ' \"Nyenụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile ekele",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "Ịhụnanya ya na-adịgidekwa ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "JER 33:11"
      },
      "items": [
        {
          "text": "Nʼihi na aga m eme ka ndị ala a, nke a dọtara nʼagha lọta, dịkwa ka ha dị na mbụ,' otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.11",
                "verseOrgIds": [
                  "JER.33.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.11",
            "verseOrgIds": [
              "JER.33.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 33:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.12",
                "verseOrgIds": [
                  "JER.33.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru, 'Nʼebe a, nke bụ mkpọmkpọ ebe ugbu a, nke mmadụ maọbụ anụmanụ na-ebighị nʼime ya, ka a ga-emesịa nweekwa ebe ịta nri nke igwe ewu na atụrụ, nʼime obodo niile, ebe ndị ọzụzụ atụrụ ga-eduru igwe ewu na atụrụ ha gaa izuike.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.12",
            "verseOrgIds": [
              "JER.33.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 33:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime obodo niile nke dị nʼala ugwu ugwu, na nʼobodo niile nke dị na mgbada ugwu niile nke Negev, nʼoke ala Benjamin, nʼime obodo nta niile nke gbara Jerusalem gburugburu, na nʼime obodo niile nke Juda. Igwe ewu na atụrụ ga-agabigakwa ọzọ nʼokpuru aka abụọ nke onye na-agụ ha ọnụ.' Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.13",
                "verseOrgIds": [
                  "JER.33.13"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.13",
            "verseOrgIds": [
              "JER.33.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 33:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Ụbọchị ndị ahụ na-abịa,' ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.14",
                "verseOrgIds": [
                  "JER.33.14"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara, 'mgbe m ga-emezu ezi nkwa ahụ m kwere ụlọ Izrel na ụlọ Juda.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.14",
            "verseOrgIds": [
              "JER.33.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 33:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" 'Nʼụbọchị ndị ahụ, na nʼoge ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:15"
      },
      "items": [
        {
          "text": "aga m eme ka Alaka ezi omume pupụta site nʼezinaụlọ Devid.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:15"
      },
      "items": [
        {
          "text": "Ọ ga-eme ihe ziri ezi, kpeekwa ikpe ziri ezi nʼala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.15",
            "verseOrgIds": [
              "JER.33.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 33:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ndị ahụ, ka a ga-azọpụta Juda,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:16"
      },
      "items": [
        {
          "text": "Jerusalem ga-ebikwa nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JER 33:16"
      },
      "items": [
        {
          "text": "Nke a bụ aha a ga-akpọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JER 33:16"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.16",
                "verseOrgIds": [
                  "JER.33.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Onye Nzọpụta, bụ ezi omume anyị.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.16",
            "verseOrgIds": [
              "JER.33.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 33:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.17",
                "verseOrgIds": [
                  "JER.33.17"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'O nweghị oge a ga-ahapụ inweta otu onye site nʼezinaụlọ Devid onye ga-anọ nʼocheeze ụlọ Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.17",
            "verseOrgIds": [
              "JER.33.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 33:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịkwaghị mgbe a ga-ahapụ inweta onye ga-esite nʼetiti ndị nchụaja na ndị Livayị, nke ga-eguzo nʼihu m ụbọchị niile ịchụ aja nsure ọkụ, na i wetara m onyinye ịnata ihuọma, na ịchụrụ m aja dị iche iche.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.18",
            "verseOrgIds": [
              "JER.33.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JER 33:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.19",
                "verseOrgIds": [
                  "JER.33.19"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Jeremaya ntị sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.19",
            "verseOrgIds": [
              "JER.33.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JER 33:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.20",
                "verseOrgIds": [
                  "JER.33.20"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Ọ bụrụ na unu nwere ike ime ka ọgbụgba ndụ m na ehihie, na ọgbụgba ndụ mụ na abalị ghara ịdịkwa, ime ka ehihie na abalị gharakwa ịpụta nʼoge ha,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.20",
            "verseOrgIds": [
              "JER.33.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JER 33:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ ọgbụgba ndụ nke mụ na Devid ohu m gbara, na ọgbụgba ndụ nke m mere ka ọ dịrị nʼetiti mụ na ndị Livayị, bụ ndị nchụaja na-eje ozi ha nʼihu m, agaghị adịkwa. A gaghị enwekwa onye ga-esi nʼezinaụlọ Devid nke ga-anọkwasị nʼocheeze ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.21",
            "verseOrgIds": [
              "JER.33.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JER 33:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m eme ka ụmụ ụmụ Devid ohu m, na ndị Livayị, bụ ndị na-eje ozi ha nʼihu m, dị ukwuu nʼọnụọgụgụ dịka kpakpando dị na mbara eluigwe; ha ga-adịkwa ukwuu dịka uzuzu dị nʼọnụ mmiri osimiri nke a na-apụghị ịgụta ọnụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.22",
            "verseOrgIds": [
              "JER.33.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JER 33:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.23",
                "verseOrgIds": [
                  "JER.33.23"
                ]
              }
            }
          ]
        },
        {
          "text": "ruru Jeremaya ntị sị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.23",
            "verseOrgIds": [
              "JER.33.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JER 33:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ị hụla ajụjụ ndị a na-ajụ? Ha na-ajụ na-asị, '",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.24",
                "verseOrgIds": [
                  "JER.33.24"
                ]
              }
            }
          ]
        },
        {
          "text": "ọ jụla agbụrụ abụọ ndị a ọ họpụtara?' Nʼihi ya, ha na-elelị ndị m, ha adịghị agụkwa ha dịka mba.",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.24",
            "verseOrgIds": [
              "JER.33.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JER 33:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.33.25",
                "verseOrgIds": [
                  "JER.33.25"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Ọ bụrụ na m emeghị ka ọgbụgba ndụ dịrị nʼetiti mụ na ehihie na abalị, meekwa ka iwu na-achị eluigwe na ụwa guzosie ike,",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.25",
            "verseOrgIds": [
              "JER.33.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JER 33:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "mgbe ahụ, agaara m ajụ ụmụ ụmụ Jekọb, na ụmụ ụmụ Devid ohu m. Agaraghị m ahọpụta otu nʼime ụmụ ya ka ọ chịa ụmụ ụmụ Ebraham na Aịzik na Jekọb. Ma aga m eme ka ndị ha a dọtara nʼagha lọta; aga m enwekwa obi ebere nʼahụ ha.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.33.26",
            "verseOrgIds": [
              "JER.33.26"
            ]
          }
        }
      ]
    }
  ],
