  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "41",
        "style": "c",
        "sid": "JER 41"
      },
      "items": [
        {
          "text": "41",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 41:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnwa nke asaa, Ishmel nwa Netanaya, nwa Elishama, onye si nʼagbụrụ eze, na onye naara abụ otu nʼime ndịisi ozi eze, duuru ndị ikom iri bịa nʼụlọ Gedaliya nwa Ahikam na Mizpa. Mgbe Gedaliya soo ha niile na-eri nri,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.1",
            "verseOrgIds": [
              "JER.41.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 41:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmel nwa Netanaya na mmadụ iri ndị ahụ ya na ha so, biliri jiri mma agha tigbuo Gedaliya nwa Ahikam, nwa Shefan, bụ onye eze Babilọn họpụtara dịka onye na-achị ala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.2",
            "verseOrgIds": [
              "JER.41.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 41:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmel gbukwara ndị ikom Juda niile ha na Gedaliya nọ na Mizpa, gbukwaa ndị agha Babilọn nọkwa nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.3",
            "verseOrgIds": [
              "JER.41.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 41:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị na-eso ụbọchị ahụ ha gbusịrị Gedaliya, tupu mmadụ ọbụla anụ ihe banyere ya,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.4",
            "verseOrgIds": [
              "JER.41.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 41:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "o nwere iri mmadụ asatọ, bụ ndị kpụchara afụọnụ ha, dọwasịa uwe ha, gbukasịakwa onwe ha ahụ, sitere nʼobodo Shekem, na Shaịlo na Sameria buuru onyinye ịnata ihuọma, na ihe nsure ọkụ na-esi isi ụtọ na-abịa nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.41.5",
                "verseOrgIds": [
                  "JER.41.5"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.5",
            "verseOrgIds": [
              "JER.41.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 41:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmel nwa Netanaya sitere na Mizpa pụọ izute ha, na-akwa akwa mgbe ọ na-aga. Mgbe o zutere ha, ọ sịrị ha, \"Bịakwutenụ Gedaliya nwa Ahikam.\"",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.6",
            "verseOrgIds": [
              "JER.41.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 41:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha batara nʼobodo, Ishmel nwa Netanaya na ndị ikom ahụ bụ ndị so ya, gburu ndị ahụ tụnye ozu ha nʼime olulu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.7",
            "verseOrgIds": [
              "JER.41.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 41:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mmadụ iri nʼime ndị ahụ gwara Ishmel okwu sị ya, \"Biko, egbula anyị, nʼihi na anyị nwere ọka wiiti na ọka balị, na mmanụ aṅụ anyị zoro nʼime ọhịa.\" Nʼihi ya, o gbughị ha, kama ọ hapụrụ ha ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.8",
            "verseOrgIds": [
              "JER.41.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 41:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olulu ahụ Ishmel tụnyere ozu Gedaliya na ozu ndị ọzọ ahụ niile bụ olulu nke Asa bụ eze gwuru maka ichebe Jerusalem mgbe Baasha eze Izrel na-ebuso ya agha. Ọ bụkwa ozu ndị mmadụ ka Ishmel, nwa Netanaya kpojuru nʼime olulu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.9",
            "verseOrgIds": [
              "JER.41.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 41:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishmel dọtakwara ndị niile fọdụrụ nʼime Mizpa nʼagha. Ọ dọtara ụmụ ndị inyom eze nʼagha, dọtakwa ndị ahụ niile a hapụrụ nʼebe ahụ, bụ ndị ahụ Nebuzaradan, ọchịagha ndị nche eze mere ka Gedaliya nwa Ahikam bụrụ onye na-achị ha. Ishmel nwa Netanaya dọtara ha niile nʼagha duru ha na-achọ ịgbapụ gaa nʼala ndị Amọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.10",
            "verseOrgIds": [
              "JER.41.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 41:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Johanan nwa Kariya, na ndịisi agha ahụ niile ya na ha nọ nụrụ ihe ọjọọ Ishmel nwa Netanaya mere,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.11",
            "verseOrgIds": [
              "JER.41.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 41:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha duuru ndị agha ha niile pụọ ibuso Ishmel nwa Netanaya agha. Ha chụkwutere ya nʼebe dị nso nʼiyi ukwu Gibiọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.12",
            "verseOrgIds": [
              "JER.41.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 41:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị ahụ niile Ishmel dọtara nʼagha hụrụ Johanan nwa Kariya na ndịisi agha so ya, ha ṅụrịrị ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.13",
            "verseOrgIds": [
              "JER.41.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 41:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ niile Ishmel dọtara nʼagha na Mizpa, chigharịrị gafee nʼebe Johanan nwa Kariya nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.14",
            "verseOrgIds": [
              "JER.41.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 41:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Ishmel nwa Netanaya, na mmadụ asatọ nʼime ndị agha ya, gbapụrụ ọsọ gbanarị Johanan. Ha gbalagara nʼala ndị Amọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.15",
            "verseOrgIds": [
              "JER.41.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mgbapụ ọsọ gaa Ijipt",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 41:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Johanan nwa Kariya na ndịisi agha niile ya na ha so duuru ndị ahụ niile ha napụtara site nʼaka Ishmel pụọ, bụ ndị ahụ Ishmel nwa Netanaya dọtara nʼagha na Mizpa, mgbe o buuru ụzọ gbuo Gedaliya nwa Ahikam. Ndị ọzọ Johanan si na Gibiọn durukwa bụ ndị a, ndị agha, na ndị inyom, na ụmụntakịrị, na ndịisi ụlọ ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.16",
            "verseOrgIds": [
              "JER.41.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 41:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha duuru ha na-aga, ma kwụsị nʼobodo Gerut Kimham, nke dị nso na Betlehem, ebe ha bu nʼobi ịga Ijipt,",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.17",
            "verseOrgIds": [
              "JER.41.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 41:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "nʼihi ịgbanarị ndị Babilọn. Ha tụrụ egwu ihe ndị Babilọn ga-eme ha nʼihi ogbugbu Ishmel nwa Netanaya gburu Gedaliya nwa Ahikam, onye eze Babilọn họpụtara ka ọ bụrụ onye na-achị ala ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.41.18",
            "verseOrgIds": [
              "JER.41.18"
            ]
          }
        }
      ]
    }
  ],
