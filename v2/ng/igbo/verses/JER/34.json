              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ndu Juda na Jerusalem na ndị ozi eze na ndị nchụaja na ndị niile bi nʼala a ndị si nʼetiti ọkara nwa ehi ahụ gabiga",
          "type": "text",
          "attrs": {
            "verseId": "JER.34.19",
            "verseOrgIds": [
              "JER.34.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
