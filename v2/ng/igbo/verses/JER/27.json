                "verseOrgIds": [
                  "JER.27.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru banyere ogidi niile ndị ahụ, na Oke osimiri bronz ahụ, na ihe ndọkwasị niile, na ihe niile fọdụrụ nʼobodo a,",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19",
            "verseOrgIds": [
              "JER.27.19"
            ]
          }
        },
