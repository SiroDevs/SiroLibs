  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "27",
        "style": "c",
        "sid": "JER 27"
      },
      "items": [
        {
          "text": "27",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Juda ga-aghọ onye na-ejere Nebukadneza ozi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JER 27:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mmalite ọchịchị Zedekaya, nwa Josaya eze Juda, okwu ndị a si nʼọnụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.1",
                "verseOrgIds": [
                  "JER.27.1"
                ]
              }
            }
          ]
        },
        {
          "text": "rute Jeremaya ntị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.1",
            "verseOrgIds": [
              "JER.27.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JER 27:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.2",
                "verseOrgIds": [
                  "JER.27.2"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m, \"Jiri akpụkpọ anụ dị warawara na ụfọdụ okporo igwe, meere onwe gị ụdị agbụ ahụ a na-amanye ụmụ ehi nʼolu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "text": "nyakwasị ya nʼolu gị.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.2",
            "verseOrgIds": [
              "JER.27.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JER 27:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, zigara ndị eze Edọm, na Moab, na Amọn, na Taịa, na Saịdọn ozi site nʼọnụ ndị ozi ha bịara Jerusalem iwetara Zedekaya eze Juda ozi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.3",
            "verseOrgIds": [
              "JER.27.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JER 27:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Zie ha ozi ha ga-ezi ndị nwe ha, sị, 'Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.4",
                "verseOrgIds": [
                  "JER.27.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke Izrel kwuru, sị, \"Zienụ ndị nna unu ukwu ozi a, sị,",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.4",
            "verseOrgIds": [
              "JER.27.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JER 27:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ site nʼike aka m, na site nʼogwe aka m, nke e setịrị eseti, ka m ji mee ụwa, na mmadụ, na anụmanụ dị nʼime ya. Mụ onwe m ka ọ dịkwara ikpebi itinye ha niile nʼaka onye ọbụla m họpụtara dịka o si dị m mma.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.5",
            "verseOrgIds": [
              "JER.27.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JER 27:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, ana m ewere alaeze unu niile nyefee ya nʼaka onye na-ejere m ozi bụ Nebukadneza eze Babilọn; aga m emekwa ka ọ bụladị ụmụ ajọ anụ ọhịa mee ihe o nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.6",
            "verseOrgIds": [
              "JER.27.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JER 27:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba niile ga-akpọ isiala nye ya; ha ga-akpọkwa isiala nye nwa ya na nwa nwa ya, tutu ruo mgbe m kpebiri na oge ha ezuola. Mgbe ahụ, aga m eme ka ọtụtụ mba na ọtụtụ ndị eze merie ya.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.7",
            "verseOrgIds": [
              "JER.27.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JER 27:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\" ' \"Ma ọ bụrụkwa na mba maọbụ alaeze ọbụla ajụ ife Nebukadneza, bụ eze Babilọn, maọbụ jụ ijere ya ozi dịka ohu,",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "text": "aga m eji mma agha na ụnwụ na ọrịa na-efe efe, taa mba ahụ ahụhụ, tutu ruo mgbe m bibiri ya site nʼaka ya. Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.8",
                "verseOrgIds": [
                  "JER.27.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.8",
            "verseOrgIds": [
              "JER.27.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JER 27:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, unu aṅala ndị amụma unu, na ndị na-ajụ mmụọ ase, na ndị na-akọwara unu nrọ, na ndị mmụọ ọjọọ si nʼọnụ ha ekwu okwu, na ndị mgbaasị ntị. Unu aṅala ha ntị mgbe ha na-asị unu, 'Unu agaghị abụ ndị ohu eze Babilọn.'",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.9",
            "verseOrgIds": [
              "JER.27.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JER 27:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ naanị amụma ụgha ka ha na-eburu unu, okwu ụgha nke ga-eme ka e site nʼala unu wezuga unu, bulaa unu ala dị anya. Aga m esi nʼala unu chụsaa unu. Unu ga-alakwa nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.10",
            "verseOrgIds": [
              "JER.27.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JER 27:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na mba ọbụla ekwere ịbụ ohu eze Babilọn, kwenyekwa ife ya ofufe, mba ahụ ka m ga-eme ka ọ nọgide nʼala nke aka ya. Ọ ga-akọ ala ahụ, birikwa nʼime ya. Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.11",
                "verseOrgIds": [
                  "JER.27.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwubiri.\" ' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.11",
            "verseOrgIds": [
              "JER.27.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JER 27:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ozi ahụ ka m ziri Zedekaya, bụ eze Juda. Asịrị m, \"Were olu",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "text": "gị nyefee eze Babilọn nʼaka dịka ohu, feekwa ya na ndị ya, ị ga-adịkwa ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.12",
            "verseOrgIds": [
              "JER.27.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JER 27:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi gịnị ka gị na ndị gị ga-eji nwụọ site na mma agha, na site nʼụnwụ na ọrịa na-efe efe, dịka nke",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.13",
                "verseOrgIds": [
                  "JER.27.13"
                ]
              }
            }
          ]
        },
        {
          "text": "kwurula banyere mba ọbụla nke na-agaghị efe eze Babilọn?",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.13",
            "verseOrgIds": [
              "JER.27.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JER 27:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Egela ntị nʼokwu ndị amụma na-agwa gị sị, 'Unu agaghị efe eze Babilọn,' nʼihi na ọ bụ okwu ụgha ka ha na-agwa unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.14",
            "verseOrgIds": [
              "JER.27.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JER 27:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Ọ bụghị m zitere ha,' otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.15",
                "verseOrgIds": [
                  "JER.27.15"
                ]
              }
            }
          ]
        },
        {
          "text": "kwupụtara. 'Ha ji aha m na-ebu amụma ụgha. Nʼihi ya, aga m achụpụ unu, unu ga-alakwa nʼiyi, unu na ndị amụma ahụ na-eburu unu amụma.' \"",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.15",
            "verseOrgIds": [
              "JER.27.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JER 27:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, agwara m ndị nchụaja na ndị mmadụ niile okwu sị ha, \"Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.16",
                "verseOrgIds": [
                  "JER.27.16"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru: Unu egela ndị amụma ahụ ntị, bụ ndị na-asị unu, 'Na mgbe na-adịghị anya a ga-ebughachi ngwongwo ahụ e si nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.16",
                "verseOrgIds": [
                  "JER.27.16"
                ]
              }
            }
          ]
        },
        {
          "text": "bulaa Babilọn.' Ọ bụ amụma ụgha ka ha na-eburu unu.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.16",
            "verseOrgIds": [
              "JER.27.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JER 27:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu egela ha ntị. Feenụ eze Babilọn, nʼihi na ọ bụ naanị site nʼụzọ ahụ ka unu ga-esi dịrị ndụ. Nʼihi gịnị ka unu ga-eji kwenye ka obodo a ghọọ mkpọmkpọ ebe?",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.17",
            "verseOrgIds": [
              "JER.27.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JER 27:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ nʼezie na ọ bụ okwu",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.18",
                "verseOrgIds": [
                  "JER.27.18"
                ]
              }
            }
          ]
        },
        {
          "text": "si nʼọnụ ndị amụma a na-apụta, ha rịọọnụ",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
              "JER.27.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "JER.27.18",
                "verseOrgIds": [
                  "JER.27.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile arịrịọ ka ọ hapụ ikwe ka e bukọrọ ngwongwo fọdụrụ nʼime ụlọnsọ nakwa ndị fọdụrụ nʼụlọeze Juda, na nʼime Jerusalem bulaa Babilọn.",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.18",
            "verseOrgIds": [
