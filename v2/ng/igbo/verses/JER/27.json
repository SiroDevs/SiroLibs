              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "JER.27.19",
            "verseOrgIds": [
              "JER.27.19"
            ]
