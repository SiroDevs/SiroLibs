  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "EZR 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwugharị ebe ịchụ aja",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o ruru ọnwa asaa nʼafọ, ndị Izrel nọkwa nʼobodo ha niile, ndị mmadụ zukọtara nʼotu na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.1",
            "verseOrgIds": [
              "EZR.3.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Jeshua, nwa Jozadak na ndị nchụaja ndị ọzọ, na Zerubabel nwa Shealtiel na ndị na-enyere ya aka malitere iwugharị ebe ịchụ aja Chineke Izrel maka ịchụ aja nsure ọkụ nʼelu ya dịka Mosis onye nke Chineke si nye nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.2",
            "verseOrgIds": [
              "EZR.3.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị oke egwu maka ndị niile gbara ha gburugburu, ha gara nʼihu wughachikwa ebe ịchụ aja ahụ na ntọala ya chụọkwa aja nʼelu ya nye",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.3",
                "verseOrgIds": [
                  "EZR.3.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ aja nsure ọkụ nke ụtụtụ na nke uhuruchi.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.3",
            "verseOrgIds": [
              "EZR.3.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha mekwara mmemme ụlọ Ikwu dịka e dere ya nʼiwu Mosis, chụọkwa aja nsure ọkụ dị iche iche nʼụbọchị niile nke mmemme ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.4",
            "verseOrgIds": [
              "EZR.3.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, ha chụrụ aja nsure ọkụ nke a na-achụ mgbe niile, na nke aja maka ọnwa ọhụrụ, na aja ndị ọzọ maka mmemme ndị ọzọ dị nsọ a kara aka nke",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.5",
                "verseOrgIds": [
                  "EZR.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ha chụkwara aja onyinye nke ha ji nye",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.5",
                "verseOrgIds": [
                  "EZR.3.5"
                ]
              }
            }
          ]
        },
        {
          "text": "onyinye afọ ofufu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.5",
            "verseOrgIds": [
              "EZR.3.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị nchụaja bidoro ịchụ aja nsure ọkụ nye",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.6",
                "verseOrgIds": [
                  "EZR.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼabalị mbụ nke ọnwa nke asaa. Ọ bụ ezie na a tọbeghị ntọala ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.6",
                "verseOrgIds": [
                  "EZR.3.6"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.6",
            "verseOrgIds": [
              "EZR.3.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwugharị ụlọnsọ ukwu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nyere ndị ọrụ na-edo nkume na ndị ọkpọ ǹtu ego, nyekwa ndị Saịdọn na ndị Taịa ihe oriri, na ihe ọṅụṅụ na mmanụ oliv, ka ha nwee ike isite nʼosimiri Lebanọn budata osisi sida ndị ahụ rute Jopa, dịka ikike Sairọs bụ eze Peshịa si kwadoo ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.7",
            "verseOrgIds": [
              "EZR.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼọnwa nke abụọ nke afọ abụọ site mgbe ha bịarutere nʼụlọ Chineke na Jerusalem. Mmadụ niile ahụ lọtara Juda so rụọ ọrụ. Zerubabel nwa Shealtiel, Jeshua nwa Jozadak na ndị fọdụrụ na ụmụnne ha, bụ ndị nchụaja na ndị Livayị, na ndị niile si na ndọta nʼagha lọta Jerusalem, malitere ịrụ ọrụ ahụ. Ha họpụtara ndị Livayị niile gbara iri afọ abụọ rigoo ka ha lekọta ihe banyere ọrụ ụlọ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.8",
                "verseOrgIds": [
                  "EZR.3.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.8",
            "verseOrgIds": [
              "EZR.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jeshua na ụmụ ya ndị ikom, na ụmụnne ya, Kadmiel na ụmụ ya, ndị si nʼikwu Hodavaya, ha na ụmụ Henadad na ụmụ ha, na ụmụnna ha, ha niile bụ ndị Livayị, jikọtara aka na-elekọta ndị na-arụ ụlọnsọ ukwu Chineke ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.9",
            "verseOrgIds": [
              "EZR.3.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị na-ewu ụlọ tọrọ ntọala ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.10",
                "verseOrgIds": [
                  "EZR.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ahụ, ndị nchụaja ahụ niile yii uwe ha jide opi nʼaka. Otu a kwa ndị Livayị, ụmụ ndị ikom Asaf jikwa ogene ha na-eto",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.10",
                "verseOrgIds": [
                  "EZR.3.10"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka usoro iwu Devid, eze Izrel nyere ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.10",
            "verseOrgIds": [
              "EZR.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ji abụ otuto na ekele bụkuo",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.11",
                "verseOrgIds": [
                  "EZR.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "abụ sị:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "EZR 3:11"
      },
      "items": [
        {
          "text": "\"Ọ dị mma,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "EZR 3:11"
      },
      "items": [
        {
          "text": "ịhụnanya ya nʼebe Izrel nọ na-adị ruo ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m",
        "vid": "EZR 3:11"
      },
      "items": [
        {
          "text": "Mmadụ niile jiri oke olu too",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.3.11",
                "verseOrgIds": [
                  "EZR.3.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼihi ntọala ụlọnsọ ukwu ahụ ha tọrọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.11",
            "verseOrgIds": [
              "EZR.3.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụfọdụ ndị merela agadi nʼetiti ndị nchụaja, na ndị Livayị, na ndị ndu nke ikwu dị iche iche, bụ ndị chetara ụlọnsọ ukwu ahụ Solomọn wuru, kwara akwa hie nne, mgbe ndị ọzọ nọ na-eti mkpu ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.12",
            "verseOrgIds": [
              "EZR.3.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, e sitere nʼebe dị nnọọ anya nụ ụzụ ọṅụ na ụda akwa ndị mmadụ ahụ. Ma o nweghị onye nwere ike ịkọwata nke bụ mkpu akwa maọbụ mkpu ọṅụ, nʼihi na ụzụ ahụ dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.3.13",
            "verseOrgIds": [
              "EZR.3.13"
            ]
          }
        }
      ]
    }
  ],
