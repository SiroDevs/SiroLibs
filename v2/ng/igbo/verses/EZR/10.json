  "verseCount": 44,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "EZR 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkwupụta mmehie",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EZR 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Ezra na-ekpe ekpere, na-ekwupụta mmehie ndị a, na-akwa akwa, na-atụ onwe ya nʼala nʼihu ụlọ Chineke, igwe ndị Izrel dị ukwuu, bụ ndị nwoke, na nwanyị, na ụmụntakịrị gbara ya gburugburu soro ya na-akwa akwa dị ilu.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.1",
            "verseOrgIds": [
              "EZR.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EZR 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Shekanaya nwa Jehiel, onye agbụrụ Elam, sịrị Ezra, \"Anyị emehiela megide Chineke anyị, nʼihi nʼịlụ ndị inyom mba ọzọ ndị gbara anyị gburugburu. Ma otu ọ dị, olileanya ka dịrị ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.2",
            "verseOrgIds": [
              "EZR.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EZR 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a ka anyị gbaa ndụ nʼihu Chineke anyị, izilaga ndị inyom ndị mba ọzọ ndị a na ụmụ ha dịka ndụmọdụ onyenwe m Ezra, na ndị na-atụ egwu iwu Chineke anyị si dị. Ka e mee ihe ndị a dịka iwu si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.3",
            "verseOrgIds": [
              "EZR.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EZR 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko, bilie gwa anyị ụzọ anyị ga-esi dozie ihe niile mebiri emebi. Anyị ga-eme ihe i kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.4",
            "verseOrgIds": [
              "EZR.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EZR 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ezra biliri jụọ ndịisi ndị nchụaja na ndị Livayị, na Izrel niile, ma ha ga-eme ihe Shekanaya kwuru. Ha niile ṅụrụ iyi kwenye na ha ga-eme ya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.5",
            "verseOrgIds": [
              "EZR.10.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EZR 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ezra si nʼihu ụlọ Chineke pụọ banye nʼime ọnụụlọ Jehohanan, nwa Eliashib. Mgbe ọ nọ nʼebe ahụ, o righị nri ọbụla, ọ ṅụghị mmiri ọbụla, nʼihi na ọ nọgidere na-eru ụjụ nʼihi ekwesighị ntụkwasị obi nke ndị si nʼebe a dọtara ha nʼagha lọta.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.6",
            "verseOrgIds": [
              "EZR.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EZR 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E zisara ozi na Juda na Jerusalem niile na a chọrọ ịhụ ndị niile si esi lọta na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.7",
            "verseOrgIds": [
              "EZR.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EZR 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndịisi na ndị okenye kpebiri na onye ọbụla nke na-abịaghị nʼụbọchị atọ, dịka atụmatụ ha si dị, na a ga-anara onye ahụ akụ niile o nwere, kewapụkwa onye ahụ site na mkpọkọta ndị Izrel e mere ka ha gaa biri nʼala ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.8",
            "verseOrgIds": [
              "EZR.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EZR 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị atọ ahụ zuru, ndị ikom Juda na Benjamin niile zukọrọ na Jerusalem. Nʼụbọchị nke iri abụọ nke ọnwa itoolu, mmadụ niile zukọrọ nọdụ nʼama dị nʼihu ụlọnsọ Chineke. Mmiri dị ukwuu zoro nʼụbọchị ahụ. Ụjọ tụkwara ndị ahụ niile zukọrọ nʼihi oke mmiri ozuzo ahụ na nʼihi okwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.9",
            "verseOrgIds": [
              "EZR.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EZR 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Ezra onye nchụaja, biliri ọtọ, sị ha, \"Unu emehiela, nʼihi na unu lụrụ ndị inyom mba ọzọ, si otu a tụkwasị ihe nʼikpe ọmụma dịrị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.10",
            "verseOrgIds": [
              "EZR.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EZR 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, sọpụrụnụ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.10.11",
                "verseOrgIds": [
                  "EZR.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke nna nna unu ha, meekwanụ ihe bụ nzube ya. Kewapụnụ onwe unu site nʼebe ndị mba ọzọ nọ, nakwa ebe nwunye ndị unu si mba ọzọ lụta.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.11",
            "verseOrgIds": [
              "EZR.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EZR 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nzukọ niile ahụ zara nʼotu olu sị. \"Okwu gị ziri ezi, Anyị aghaghị ime dịka i kwuru.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.12",
            "verseOrgIds": [
              "EZR.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EZR 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha zakwara sị, \"Nke a abụghị ihe anyị ga-eme nʼotu ụbọchị maọbụ nʼụbọchị abụọ, nʼihi na aka ọtụtụ mmadụ nʼime anyị dị na mmehie ahụ. Mmiri na-ezosikwa ike, anyị enwekwaghị ike ịnọgide ruo oge dị anya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.13",
            "verseOrgIds": [
              "EZR.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EZR 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ndịisi anyị guzobe mkpọkọta niile. Ka ndị niile nọ nʼobodo anyị ndị lụrụ nwanyị site na mba ọzọ bịa nʼoge a kara aka, ha na ndị okenye na ndị ikpe nke obodo ọbụla, ruo mgbe oke iwe Chineke banyere okwu a sitere nʼebe anyị nọ pụọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.14",
            "verseOrgIds": [
              "EZR.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EZR 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị na-ekweghị ka e mee ya otu a bụ naanị Jonatan nwa Asahel na Jazeia nwa Tikva, na Meshulam na Shabetai onye Livayị.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.15",
            "verseOrgIds": [
              "EZR.10.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EZR 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị ahụ niile si esi lọta, mere dịka mkpebi ahụ si dị. Ezra họpụtara ụfọdụ ndị ikom, ndị bụ ndịisi ezinaụlọ, e si nʼezinaụlọ ọbụla họpụta otu onye. E dekwara aha ndị niile a họpụtara nʼakwụkwọ. Ya mere, nʼụbọchị mbụ nke ọnwa iri, ndị a malitere inyocha okwu ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.16",
            "verseOrgIds": [
              "EZR.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EZR 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọnwa atọ gasịrị, ya bụ, nʼabalị mbụ nke ọnwa mbụ nʼafọ, ha rụchara ọrụ banyere ndị ikom lụrụ ndị inyom mba ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.17",
            "verseOrgIds": [
              "EZR.10.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị lụrụ ndị mba ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EZR 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A chọpụtara nʼetiti ụmụ ndị nchụaja, na ndị a lụrụ ndị inyom si na mba ọzọ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "EZR 10:18"
      },
      "items": [
        {
          "text": "Ndị si nʼikwu Jeshua nwa Jozadak na ụmụnne ya bụ,",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:18"
      },
      "items": [
        {
          "text": "Maaseia, Elieza, Jarib na Gedaliya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.18",
            "verseOrgIds": [
              "EZR.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EZR 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile jikọrọ aka kpebiekwa na ha ga-ezila ndị nwunye ha. Onye ọbụla wetara ebule site nʼigwe atụrụ dịka ihe ikpe ọmụma.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.19",
            "verseOrgIds": [
              "EZR.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EZR 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị si nʼikwu Imea bụ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:20"
      },
      "items": [
        {
          "text": "Hanani, na Zebadaya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.20",
            "verseOrgIds": [
              "EZR.10.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EZR 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ikwu Harim:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.21",
            "verseOrgIds": [
              "EZR.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:21"
      },
      "items": [
        {
          "text": "Maaseia, Ịlaịja, Shemaya, Jehiel na Uzaya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.21",
            "verseOrgIds": [
              "EZR.10.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EZR 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị si nʼikwu Pashua:",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.22",
            "verseOrgIds": [
              "EZR.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li2",
        "vid": "EZR 10:22"
      },
      "items": [
        {
          "text": "Elioenai, Maaseia, Ishmel, Netanel, Jozabad, na Eleasa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.10.22",
            "verseOrgIds": [
              "EZR.10.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
