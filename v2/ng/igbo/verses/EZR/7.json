              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otuto dịrị",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
