          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Keleekwa Chineke onye nyere m ihuọma nʼihu ndị ndụmọdụ ya, na nʼihu ụmụ eze, bụ ndịisi ọchịchị dị ike. Nʼihi na aka",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "EZR.7.28",
                "verseOrgIds": [
                  "EZR.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke m nọnyeere m. Eji m obi ike chịkọta ndịisi site nʼIzrel ka ha soro m gaa.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.28",
            "verseOrgIds": [
              "EZR.7.28"
            ]
          }
        }
