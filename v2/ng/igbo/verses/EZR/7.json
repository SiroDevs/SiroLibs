                "verseOrgIds": [
                  "EZR.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nna nna anyị ha, onye mere ka eze kpebie ime ka ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
