                "verseOrgIds": [
                  "EZR.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": "dị na Jerusalem dị mma ile anya.",
          "type": "text",
          "attrs": {
            "verseId": "EZR.7.27",
            "verseOrgIds": [
              "EZR.7.27"
            ]
          }
        },
        {
