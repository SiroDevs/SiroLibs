  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "2SA 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid gụkọtara ndị ya na ha so ma họpụta ndịisi agha. Doo ụfọdụ ka ha chịa ọtụtụ puku ndị agha, ụfọdụ ka ha chịa ọtụtụ narị ndị agha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.1",
            "verseOrgIds": [
              "2SA.18.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid zipụrụ ndị agha ya, otu ụzọ nʼime ụzọ atọ nʼokpuru Joab, Ọ họpụtakwara Abishai, nwanne Joab, nwa Zeruaya, ka ọ chịa otu ụzọ. Ma otu ụzọ nke fọdụrụ ka o tinyere nʼaka Itai onye Gat. Eze gwara ndị agha ahụ sị, \"Mụ onwe m ga-edu unu gaa agha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.2",
            "verseOrgIds": [
              "2SA.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ndị ikom ahụ sịrị, \"Ị gaghị apụkwa ọzọ nʼihi na ọ bụrụ na anyị atụgharịa bido ịgba ọsọ, ọ bụrụkwa na otu ọkara nʼime anyị anwụọ, nke ahụ agaghị emetụ ha nʼobi. Naanị gị ka ha na-achọ. Ị dịkwa mkpa karịa puku ndị agha iri. Ọ ga-akara anyị mma ugbu a ka ị na-ezitere anyị inyeaka site nʼime obodo.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.3",
            "verseOrgIds": [
              "2SA.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze zara nʼikpeazụ sị, \"Ihe ọbụla dị mma nʼanya unu ka m ga-eme.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:4"
      },
      "items": [
        {
          "text": "Ya mere, eze guzoro nʼakụkụ ọnụ ụzọ ama dịka ndị ikom ya niile na-apụ nʼusu nke ọtụtụ narị, nakwa nʼusu nke ọtụtụ puku.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.4",
            "verseOrgIds": [
              "2SA.18.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze nyere ndịisi agha ya, bụ Joab, Abishai na Itai, iwu sị ha, \"Bikonu, nʼihi m, werenụ nwayọọ nʼebe nwokorobịa ahụ bụ Absalọm nọ.\" Ndị agha niile nụkwara mgbe eze nyere ndịisi niile iwu a banyere Absalọm.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.5",
            "verseOrgIds": [
              "2SA.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha Devid si nʼobodo pụọ izute ndị Izrel nʼagha. Alụrụ agha a nʼọhịa Ifrem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.6",
            "verseOrgIds": [
              "2SA.18.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị agha Devid tigbukwara ndị agha Izrel. Ha gburu iri puku ndị agha abụọ nʼụbọchị ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.7",
            "verseOrgIds": [
              "2SA.18.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agha ahụ gbasara nʼelu ala ahụ niile. Ndị nwụrụ nʼọhịa nʼetiti ụmụ Izrel karịrị ndị e gburu egbu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.8",
            "verseOrgIds": [
              "2SA.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Absalọm zutere ndị agha Devid. Ọ na-anọkwasị nʼelu ịnyịnya ya nʼoge a, dịka ịnyịnya ahụ sitere nʼokpuru osisi ook ukwu dị nʼọhịa ahụ na-agbafee, agịrị isi ya konyere nʼalaka osisi ahụ, tụhịkọtaakwa, nke mere na ọ kwụrụ nʼetiti eluigwe na ala. Ma ịnyịnya ya gbaara na-aga.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.9",
            "verseOrgIds": [
              "2SA.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu nʼime ndị ikom ahụ hụrụ ya, kọọrọ Joab, \"Lee, ahụrụ m Absalọm ebe ọ kwụ nʼelu osisi ook.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.10",
            "verseOrgIds": [
              "2SA.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab sịrị nwoke ahụ onye gwara gị, \"Gịnị, ị hụrụ ya? Gịnị mere i tigbughị ya ka o ruo nʼala nʼebe ahụ? Mgbe ahụ, agaara m enye gị shekel ọlaọcha iri, na belịt a na-enye onye bụ dike nʼagha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.11",
            "verseOrgIds": [
              "2SA.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwoke ahụ zara sị, \"A sịkwarị na e nyere m puku ọlaọcha nʼaka m a, agaraghị m egbu ya. Nʼihi na anyị niile nụrụ mgbe eze na-agwa gị na Abishai na Itai sị, 'Lezienụ anya banyere nwokorobịa bụ Absalọm, nʼihi m.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.12",
            "verseOrgIds": [
              "2SA.18.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sị na m gburu ya, ọ ga-abụ imegide eze. Ọ ga-emesiekwa chọpụta onye mere ya. Ma gị onwe gị agaraghị apụta kwuchite ọnụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.13",
            "verseOrgIds": [
              "2SA.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab sịrị, \"Ọ bụghị otu a ka m ga na-eche nʼihu gị.\" Ya mere, ọ chịịrị ùbe atọ nʼaka ya, dubaa ha nʼobi Absalọm, mgbe Absalọm ka dị ndụ makwụrụ nʼelu osisi ook.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.14",
            "verseOrgIds": [
              "2SA.18.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ okorobịa iri ndị na-ebu ihe agha Joab gbara Absalọm gburugburu, tigbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.15",
            "verseOrgIds": [
              "2SA.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Joab fụrụ opi ike nke mere ka ndị agha Devid na-achụ ndị Izrel kwụsị ịchụ ha ọsọ, nʼihi na Joab kwụsịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.16",
            "verseOrgIds": [
              "2SA.18.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha buuru ozu Absalọm tụba ya nʼolulu ukwu dị nʼoke ọhịa ahụ, werekwa nkume tụọ ya nʼelu. Ndị agha Izrel niile gbalara nʼụlọ ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.17",
            "verseOrgIds": [
              "2SA.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge Absalọm dị ndụ, o wuuru onwe ya ogidi ncheta. O wuru ogidi a na Ndagwurugwu Eze, nʼihi na o chere nʼime onwe ya sị, \"Enweghị m nwa nwoke ga-aza aha m.\" Ya mere, ọ gụrụ ogidi ahụ aha nke ya onwe ya. Ọ bụkwa Ogidi Absalọm ka a na-akpọ ya ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.18",
            "verseOrgIds": [
              "2SA.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iru ụjụ Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 18:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ahimaaz, nwa Zadọk,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "text": "bịakwutere Joab sị ya, \"Biko, ka m gbara ọsọ gaa zie eze oziọma a, na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.19",
                "verseOrgIds": [
                  "2SA.18.19"
                ]
              }
            }
          ]
        },
        {
          "text": "azọpụtala ya site nʼaka ndị iro ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.19",
            "verseOrgIds": [
              "2SA.18.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 18:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Joab zara sị ya, \"Ọ bụghị gị ga-ezi eze ozi taa. I nwere ike ime ya mgbe ọzọ, ma ọ bụghị taa, nʼihi na nwa eze nwụrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.20",
            "verseOrgIds": [
              "2SA.18.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 18:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab gwara otu nwoke onye Kush sị ya, \"Gaa gwa eze ihe ị hụrụ.\" Nwoke ahụ kpọrọ isiala, gbapụ ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.21",
            "verseOrgIds": [
              "2SA.18.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 18:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahimaaz nwa Zadọk rịọkwara Joab ọzọ sị ya, \"Otu ọbụla o si dị, biko kwere ka m gbaso onye Kush a.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:22"
      },
      "items": [
        {
          "text": "Ma Joab zara sị, \"Nwa m nwoke, gịnị mere i ji chọọ ị ga? I nweghị ozi ọbụla ị ga-ezi nke ga-ewetara gị ụgwọ ọrụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.22",
            "verseOrgIds": [
              "2SA.18.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 18:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ rịọrọ sị, \"Otu ọbụla o si dị, hapụ m ka m gaa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:23"
      },
      "items": [
        {
          "text": "Nʼikpeazụ Joab kwenyere sị ya, \"Ọ dị mma, gbara ọsọ gaa.\" Ahimaaz sitere nʼụzọ dị mkpụmkpụ nke gafere obosara ala Jọdan buru nwoke Kush ahụ ụzọ gbaruo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.23",
            "verseOrgIds": [
              "2SA.18.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 18:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid nọ nʼọnụ ụzọ ama nʼoge a. Mgbe onye nche rigoruru nʼelu mgbidi ebe ọ na-anọ, ọ hụrụ otu nwoke ka ọ na-agba ọsọ naanị ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.24",
            "verseOrgIds": [
              "2SA.18.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 18:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nche ahụ kpọrọ Devid oku gwa ya na o nwere onye na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:25"
      },
      "items": [
        {
          "text": "Ma eze zara ya sị, \"Ọ bụrụ naanị ya, o nwere oziọma.\" Mgbe onyeozi ahụ na-abịaru nso,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.25",
            "verseOrgIds": [
              "2SA.18.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 18:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye nche ahụ lepụkwara anya hụ otu nwoke ọzọ ka o ji ọsọ na-abịa naanị ya. Ọ kpọkwara oku ọzọ sị, \"Onye ọzọ na-abịakwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:26"
      },
      "items": [
        {
          "text": "Eze zara sị, \"Onye ahụ ga-enwekwa oziọma.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.26",
            "verseOrgIds": [
              "2SA.18.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 18:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nche ahụ zara sị, \"Onye nke mbụ na-abịa dị ka Ahimaaz, nwa Zadọk,\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:27"
      },
      "items": [
        {
          "text": "Eze zara sị, \"Ọ bụ ezi mmadụ, ọ bụkwa oziọma ka o ji na-abịa.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.27",
            "verseOrgIds": [
              "2SA.18.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 18:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Ahimaaz kpọrọ eze oku sị, \"Udo!\" Ọ kpọrọ isiala nye eze. Kpuokwa ihu ya nʼala sị, \"Ngọzị na-adịrị",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.28",
                "verseOrgIds": [
                  "2SA.18.28"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị. Onye nke mebiri nzube ndị ahụ niile weliri aka imegide onyenwe m bụ eze.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.28",
            "verseOrgIds": [
              "2SA.18.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 18:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ ya sị, \"Oleekwanụ maka nwokorobịa ahụ bụ Absalọm? Ọ nọkwa nʼudo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:29"
      },
      "items": [
        {
          "text": "Ahimaaz zara sị, \"Mgbe Joab zipụrụ ohu eze, na mụ onwe m, oke ụzụ dị, ma amaghị m ihe kpatara ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.29",
            "verseOrgIds": [
              "2SA.18.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 18:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze gwara ya sị, \"Chere nʼebe a.\" Ahimaaz chigharịrị chere.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.30",
            "verseOrgIds": [
              "2SA.18.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 18:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, onye Kush ahụ bịarutere sị, \"Onyenwe m bụ eze, nụrụ oziọma a. Taa",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.18.31",
                "verseOrgIds": [
                  "2SA.18.31"
                ]
              }
            }
          ]
        },
        {
          "text": "ekpepụtala gị site nʼịnapụta gị nʼaka ndị niile biliri imegide gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.31",
            "verseOrgIds": [
              "2SA.18.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 18:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ onye Kush ahụ, \"Nwokorobịa ahụ bụ Absalọm, ọ nọkwa nʼudo?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 18:32"
      },
      "items": [
        {
          "text": "Onye Kush ahụ zaghachiri, \"Ka ndị iro onyenwe m bụ eze na ndị niile na-ebili imejọ gị dị ka nwokorobịa ahụ!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.32",
            "verseOrgIds": [
              "2SA.18.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 18:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Okwu a metụrụ eze nʼahụ nke ukwuu, o biliri rigoo nʼụlọ nke dị nʼọnụ ụzọ ama, nọdụ nʼebe ahụ kwaa akwa. Ọ nọ na-akwa akwa mgbe ọ na-aga, na-eti mkpu akwa na-asị, \"O, nwa m, Absalọm! O nwa m, nwa m, Absalọm. A sịkwarị na m nwụrụ nʼọnọdụ gị! O, Absalọm nwa m, nwa m oo!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.18.33",
            "verseOrgIds": [
              "2SA.19.1"
            ]
          }
        }
      ]
    }
  ],
