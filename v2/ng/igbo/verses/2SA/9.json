  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "2SA 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid na Mefiboshet",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, Devid jụrụ ajụjụ sị, \"O nwere onye fọdụrụ ndụ nʼezinaụlọ Sọl? Achọrọ m igosi onye ahụ obi ebere nʼihi Jonatan.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.1",
            "verseOrgIds": [
              "2SA.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nụrụ ihe banyere otu nwoke aha ya bụ Ziba, onye bụ otu nʼime ndị ohu Sọl. O ziri ozi ka a kpọọ ya. Mgbe ọ bịara nʼihu Devid, eze jụrụ ya sị, \"Ọ bụ gị bụ Ziba?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:2"
      },
      "items": [
        {
          "text": "Ọ zara sị, \"E, onyenwe m, ọ bụ m ohu gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.2",
            "verseOrgIds": [
              "2SA.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ ya sị, \"Ọ dị onye fọdụrụ ndụ nʼezinaụlọ Sọl? Ọ bụrụ na ọ dị onye fọdụrụ, achọrọ m igosi ya ụdị obiọma Chineke na-egosi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:3"
      },
      "items": [
        {
          "text": "Ziba zara ya sị, \"Otu nwa nwoke Jonatan, nke dara ngwụrọ nọ ndụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.3",
            "verseOrgIds": [
              "2SA.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ, \"Ebee ka ọ nọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:4"
      },
      "items": [
        {
          "text": "Ziba zaghachiri, \"Ọ nọ na Lo Deba, nʼụlọ Makia, nwa Amiel.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.4",
            "verseOrgIds": [
              "2SA.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere eze Devid ziri ka e site nʼobodo Lo Deba, nʼụlọ Makia nwa Amiel kpọta ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.5",
            "verseOrgIds": [
              "2SA.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mefiboshet nwa Jonatan, nwa Sọl, bịara nʼebe Devid nọ, o hulatara isi, kpọọrọ ya isiala, nʼọnọdụ nsọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:6"
      },
      "items": [
        {
          "text": "Mgbe ahụ, Devid kpọrọ ya aha sị, \"Mefiboshet,\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 9:6"
      },
      "items": [
        {
          "text": "Mefiboshet zara sị ya, \"A bụ m ohu gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.6",
            "verseOrgIds": [
              "2SA.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Devid sịrị ya, \"Atụla egwu, nʼezie, aga m egosi gị obiọma nʼihi nna gị Jonatan. Aga m enyeghachi gị ala niile nna nna gị Sọl nwere. Ma ị ga-eso soro m na-eri nri na tebul m oge niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.7",
            "verseOrgIds": [
              "2SA.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboshet dara nʼala nʼihu eze sị, \"Eze, onye ka m bụ i ji egosi nkịta nwụrụ anwụ dịka m obi ebere?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.8",
            "verseOrgIds": [
              "2SA.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze kpọrọ Ziba ohu Sọl ahụ sị ya, \"Enyeghachila m nwa nwa nna gị ukwu ihe niile Sọl na ụlọ ya nwere.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.9",
            "verseOrgIds": [
              "2SA.9.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị na ụmụ gị ndị ikom na ndị ozi gị ga-arụ ọrụ nʼubi ya ịrụpụta nri. Ma Mefiboshet, nwa nwa nna gị ukwu ga na-eri ihe na tebul m.\" Ziba, nwere ụmụ ndị ikom iri na ise, na iri ndị ozi abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.10",
            "verseOrgIds": [
              "2SA.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị eze, \"Onyenwe m, ohu gị ga-eme ihe niile eze nyere m nʼiwu.\" Site nʼoge ahụ, Mefiboshet riri nri na tebul",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        },
        {
          "text": "Devid dịka ọ bụ otu nʼime ụmụ ndị ikom eze.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.11",
            "verseOrgIds": [
              "2SA.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mefiboshet nwekwara otu nwa nwoke aha ya bụ Mika. Ziba na ndị niile bi nʼụlọ ya niile ghọrọ ndị ohu Mefiboshet.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.12",
            "verseOrgIds": [
              "2SA.9.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Mefiboshet biri na Jerusalem nʼihi na ọ bụ na tebul eze ka ọ na-eri nri mgbe niile. Ọ bụ onye dara ngwụrọ nʼụkwụ ya abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.9.13",
            "verseOrgIds": [
              "2SA.9.13"
            ]
          }
        }
      ]
    }
  ],
