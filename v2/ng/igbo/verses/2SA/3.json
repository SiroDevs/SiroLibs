  "verseCount": 39,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "3",
        "style": "c",
        "sid": "2SA 3"
      },
      "items": [
        {
          "text": "3",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 3:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agha dị nʼetiti ndị ụlọ Sọl na ụlọ Devid dịịrị ruo oge toro ogologo. Ma ka Devid na-aga nʼihu na-esiwanye ike, ụlọ Sọl na-aga azụ na-ada ada.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.1",
            "verseOrgIds": [
              "2SA.3.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ụmụ Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 3:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "A mụtaara ọtụtụ ụmụ ndị ikom nye Devid mgbe ọ nọ na Hebrọn.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:2"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:2"
      },
      "items": [
        {
          "text": "Ọkpara ya bụ Amnọn nke, Ahinoam bụ nwanyị Jezril mụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.2",
            "verseOrgIds": [
              "2SA.3.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 3:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke abụọ bụ Kiliab, nke Abigel, nwunye ochie Nebal, onye Kamel mụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:3"
      },
      "items": [
        {
          "text": "Nke atọ bụ Absalọm, nke Maaka nwa nwanyị Talmai, bụ eze Geshua",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        },
        {
          "text": "mụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.3",
            "verseOrgIds": [
              "2SA.3.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 3:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke anọ bụ Adonaịja, nwa nwoke Hagit.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1",
        "vid": "2SA 3:4"
      },
      "items": [
        {
          "text": "Nke ise bụ Shefataya nwa Abital;",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.4",
            "verseOrgIds": [
              "2SA.3.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 3:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke isii bụ Itream, nwa nwoke Egla nwunye Devid.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.5",
            "verseOrgIds": [
              "2SA.3.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "2SA 3:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4",
        "vid": "2SA 3:5"
      },
      "items": [
        {
          "text": "Ndị a ka a mụtaara Devid na Hebrọn.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abna adịnyere Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 3:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo, mgbe agha na-aga nʼihu nʼetiti ụlọ Sọl na ụlọ Devid, na Abna nọ na-eme ka ọnọdụ ya sie ike nʼụlọ Sọl.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.6",
            "verseOrgIds": [
              "2SA.3.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 3:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Sọl nwererịị otu iko nwanyị aha ya bụ Rizpa, nwa Aịa. Ishboshet jụrụ Abna ajụjụ sị, \"Gịnị mere gị na iko nwanyị nna m ji dinaa?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.7",
            "verseOrgIds": [
              "2SA.3.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 3:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwe were Abna nke ukwuu nʼihi ihe Ishboshet kwuru. Ya mere, ọ zara, \"Ọ bụ isi nkịta nke ụlọ Juda ka m bụ? Taa ka m ji obi m niile na-ejere ụlọ nna gị, bụ Sọl, na ezinaụlọ ya, na ndị enyi ya ozi. Ewerebeghị m gị nyefee nʼaka Devid. Ma lee, ugbu a i na-ebo m ebubo ajọ omume nʼihe metụtara nwanyị a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.8",
            "verseOrgIds": [
              "2SA.3.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 3:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka Chineke mesoo Abna mmeso, otu ọbụla mmeso ahụ si dị njọ, ma ọ bụrụ na m emereghị Devid ihe ndị ahụ niile",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.9",
                "verseOrgIds": [
                  "2SA.3.9"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼịṅụ iyi kwee nkwa inye ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.9",
            "verseOrgIds": [
              "2SA.3.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 3:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịnapụ ụlọ Sọl alaeze ahụ, na ime ka ocheeze Devid guzosie ike nʼebe Izrel niile na Juda niile nọ, site na Dan ruo Bịasheba.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.10",
            "verseOrgIds": [
              "2SA.3.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 3:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ishboshet ekwughị ihe ọbụla nʼihi na ọ na-atụ Abna egwu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.11",
            "verseOrgIds": [
              "2SA.3.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 3:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngwangwa, Abna zipụrụ ndị ozi ka ha jekwuru Devid sị ya, \"Onye nwee ala a? Ka mụ na gị gbaa ndụ. Aga m enyere gị aka kpọghachite ndị Izrel ka ha dịnyeere gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.12",
            "verseOrgIds": [
              "2SA.3.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 3:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid sịrị, \"Ọ dị mma. Mụ na unu ga-agba ndụ. Ma ọ dị otu ihe m chọrọ nʼaka unu. Unu agaghị ahụ ihu m anya ma ọ bụrụ na unu eduteghị Mikal, nwa Sọl, mgbe unu ga-abịa ịhụ m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.13",
            "verseOrgIds": [
              "2SA.3.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 3:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid ziri Ishboshet nwa Sọl ozi sị ya, \"Dulatara m nwunye m Mikal, nʼihi na ọ bụ narị apị ndị Filistia ka m ji lụtara ya onwe m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.14",
            "verseOrgIds": [
              "2SA.3.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 3:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na-atụfughị oge, Ishboshet nyere iwu ka e site nʼaka di ya bụ Paltiel, nwa Laish, kpọpụta ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.15",
            "verseOrgIds": [
              "2SA.3.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 3:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha du ya na-aga, Paltiel sogidere ya nʼazụ na-akwa akwa tutu ha eruo Bahurim. Nʼebe ahụ ka Abna nọ sị ya, \"Laghachi ugbu a.\" Ọ tụgharịrị laa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.16",
            "verseOrgIds": [
              "2SA.3.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 3:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abna na ndị okenye Izrel kparịtara ụka. Ọ chetaara ha sị ha, \"Ọ dịla anya kemgbe unu na-achọ ka Devid bụrụ eze unu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.17",
            "verseOrgIds": [
              "2SA.3.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 3:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a meenụ ya, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.18",
                "verseOrgIds": [
                  "2SA.3.18"
                ]
              }
            }
          ]
        },
        {
          "text": "kweere Devid nkwa, 'Site nʼaka ohu m bụ Devid ka m ga-esi zọpụta ndị m bụ Izrel site nʼaka ndị Filistia, nakwa site nʼaka ndị iro ha niile.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.18",
            "verseOrgIds": [
              "2SA.3.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 3:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abna gwakwara ndị Benjamin okwu. Emesịa, o jere Hebrọn ịgwa Devid ihe niile ndị Izrel na ndị Benjamin zubere ime.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.19",
            "verseOrgIds": [
              "2SA.3.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 3:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abna, ya na iri ndị ikom abụọ so gakwuru Devid na Hebrọn. Mgbe ha ruru, Devid meere ha oke oriri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.20",
            "verseOrgIds": [
              "2SA.3.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 3:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Abna sịrị Devid, \"Ka m gaa ngwangwa ga kpọkọtaa ndị Izrel niile, nye onyenwe m bụ eze, ka gị na ha gbaa ndụ, ka ị bụrụ eze ndị niile mkpụrụobi gị na-achọsi ike.\" Ya mere Devid zilara Abna. Ọ laa nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.21",
            "verseOrgIds": [
              "2SA.3.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Joab egbuo Abna",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 3:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu mgbe ahụ, ndị ikom Devid na Joab si nʼebe ha gara ịpụnara ndị mmadụ ihe lọta, bukọrọ ọtụtụ ihe nkwata. Ma Abna anọghịkwa na Hebrọn ya na Devid, nʼihi na Devid ezipụla ya, ọ pụọla nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.22",
            "verseOrgIds": [
              "2SA.3.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 3:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Joab na ndị agha ya lọtara, a kọọrọ ya na Abna, nwa Nea, bịara hụ eze, na ọ laakwala nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.23",
            "verseOrgIds": [
              "2SA.3.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 3:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere Joab jekwuuru eze sị ya, \"Gịnị ka i mere? Lee, Abna bịakwutere gị. Gịnị mere i ji hapụ ya ka ọ laa? Lee ya ugbu a, ọ laala!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.24",
            "verseOrgIds": [
              "2SA.3.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 3:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị maara onye Abna nwa Nea bụ? Ọ bịara ịghọ gị aghụghọ, na inyocha njegharị gị, ịchọpụta ihe niile ị na-eme.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.25",
            "verseOrgIds": [
              "2SA.3.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 3:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Joab si nʼihu Devid pụta, o zipụrụ ndị ozi ka ha sochie Abna azụ, gwa ya ka ọ laghachi. Ha hụrụ ya nʼolulu mmiri Sira. O sokwara ha laghachi, ma Devid amaghị ihe banyere nke a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.26",
            "verseOrgIds": [
              "2SA.3.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 3:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Abna lọghachiri na Hebrọn, Joab duuru ya gaa nʼakụkụ ọnụ ụzọ ama, dịka ọ chọrọ ka ha kparịtaa ụka. Ngwangwa, ọ mịpụtara nwa mma ya, jiri ya magbuo Abna, nʼihi ịbọ ọbọ ọbara nwanne ya, bụ Asahel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.27",
            "verseOrgIds": [
              "2SA.3.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 3:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe emesịrị, Devid nụrụ banyere ya, ọ sịrị, \"Aka m dị ọcha, ya na nke alaeze m nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.28",
                "verseOrgIds": [
                  "2SA.3.28"
                ]
              }
            }
          ]
        },
        {
          "text": "banyere ọbara Abna, nwa Nea.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.28",
            "verseOrgIds": [
              "2SA.3.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 3:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ikpe ọmụma a dakwasị Joab nʼisi, nakwa ezinaụlọ nna ya niile, ka a gharakwa ịhụ nʼụlọ Joab onye na-adịghị arịa ọrịa ahụ ihe ntokasị, maọbụ ọrịa ekpenta, maọbụ onye ji mkpara eji akpa akwa, maọbụ onye ga-anwụ site na mma agha, maọbụ onye ụkọ nri adịghị akọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.29",
            "verseOrgIds": [
              "2SA.3.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 3:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Joab na Abishai nwanne ya gburu Abna, nʼihi na Abna gburu nwanne ha Asahel nʼagha Gibiọn.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.30",
            "verseOrgIds": [
              "2SA.3.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 3:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Devid kpọrọ Joab na ndị niile so ya sị ha, \"Dọwaanụ uwe unu, yikwasị onwe unu akwa mkpe, jegharịakwanụ nʼọnọdụ iru ụjụ nʼihi Abna.\" Eze, bụ Devid nʼonwe ya so ndị bu ozu Abna nʼazụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.31",
            "verseOrgIds": [
              "2SA.3.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2SA 3:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha liri Abna na Hebrọn. Eze na ndị Izrel niile kwara akwa nʼakụkụ ili ahụ nʼihi Abna.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.32",
            "verseOrgIds": [
              "2SA.3.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2SA 3:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze bụrụ abụ akwa nʼihi Abna, sị,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:33"
      },
      "items": [
        {
          "text": "\"O kwesiri ka Abna nwụọ dịka onye nzuzu?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.33",
            "verseOrgIds": [
              "2SA.3.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2SA 3:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kekwaghị aka gị abụọ ihe.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "E kekwaghị ụkwụ gị abụọ agbụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Ị nwụrụ dịka onye ndị ajọ omume gburu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 3:34"
      },
      "items": [
        {
          "text": "Mmadụ niile bekwara akwa ọzọ nʼihi ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.34",
            "verseOrgIds": [
              "2SA.3.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2SA 3:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị mmadụ bịakwutere Devid rịọọ ka o ritụ ihe, mgbe ìhè ụbọchị ka dị, ma Devid ṅụrụ iyi sị, \"Ka Chineke mesoo m mmeso, otu ọbụla mmeso ahụ si dị njọ, ma ọ bụrụ na m edetụ achịcha maọbụ ihe ọbụla ọzọ ọnụ tutu ruo mgbe anyanwụ dara.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.35",
            "verseOrgIds": [
              "2SA.3.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "2SA 3:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị mmadụ nụrụ ihe o kwuru, okwu ahụ tọkwara ha ụtọ. Nʼezie, ihe niile eze mere tọrọ ha ụtọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.36",
            "verseOrgIds": [
              "2SA.3.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "2SA 3:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ndị mmadụ niile nọ ebe ahụ ka Izrel niile matara na eze amaghị ihe banyere ọnwụ Abna, nwa Nea.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.37",
            "verseOrgIds": [
              "2SA.3.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "38",
            "style": "v",
            "sid": "2SA 3:38"
          },
          "items": [
            {
              "text": "38",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid jụrụ ndị ikom ya ajụjụ sị, \"Unu ghọtakwara na onye a dara nʼIzrel taa bụ nwa eze na onye dị mkpa?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.38",
            "verseOrgIds": [
              "2SA.3.38"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "39",
            "style": "v",
            "sid": "2SA 3:39"
          },
          "items": [
            {
              "text": "39",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie na m bụ onye",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.39",
                "verseOrgIds": [
                  "2SA.3.39"
                ]
              }
            }
          ]
        },
        {
          "text": "tere mmanụ ịbụ eze, ma o nweghị ihe m pụrụ ime ụmụ ndị ikom Zeruaya ndị a, nʼihi na ha dị ike karịa m. Ka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.3.39",
                "verseOrgIds": [
                  "2SA.3.39"
                ]
              }
            }
          ]
        },
        {
          "text": "kwụghachi onye ọjọọ ihe ọjọọ ọ mere.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.3.39",
            "verseOrgIds": [
              "2SA.3.39"
            ]
          }
        }
      ]
    }
  ],
