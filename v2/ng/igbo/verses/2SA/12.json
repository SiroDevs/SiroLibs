  "verseCount": 31,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "12",
        "style": "c",
        "sid": "2SA 12"
      },
      "items": [
        {
          "text": "12",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Netan abaara Devid mba",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 12:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.1",
            "verseOrgIds": [
              "2SA.12.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.1",
                "verseOrgIds": [
                  "2SA.12.1"
                ]
              }
            }
          ]
        },
        {
          "text": "zigara Netan ka o jekwuru Devid. Mgbe Netan bịakwutere Devid, ọ kọọrọ ya akụkọ a, \"E nwere ndị ikom abụọ bi nʼotu obodo, otu bụ ọgaranya ma nke ọzọ bụ ogbenye.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.1",
            "verseOrgIds": [
              "2SA.12.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 12:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ọgaranya a nwere ọtụtụ igwe atụrụ na igwe ehi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.2",
            "verseOrgIds": [
              "2SA.12.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 12:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nwoke ogbenye ahụ enweghị ihe ọbụla karịa otu nwa nne atụrụ nta nke ọ zụtara. Ọ zụlitere ya, o tolite nʼetiti ya na ụmụ ya. Ọ na-eri nri site na ihe oriri ya, na-aṅụ mmiri site nʼiko mmiri ya, nʼobi ya ka ọ na-edinakwa. Ọ nọ ọnọdụ dịka nwa nwanyị nye ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.3",
            "verseOrgIds": [
              "2SA.12.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 12:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Otu ụbọchị, onye ọbịa bịara nʼụlọ onye ọgaranya ahụ. Ma kama ọgaranya ahụ ga-ewere otu atụrụ maọbụ ehi nke ya siere onye ọbịa ya nri, ọ gara were nne atụrụ ogbenye ahụ, gbuo ya, jiri ya siere ọbịa ya nri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.4",
            "verseOrgIds": [
              "2SA.12.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 12:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid were oke iwe megide nwoke ahụ, ọ sịrị Netan, \"Ana m aṅụ iyi nʼaha",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.5",
            "verseOrgIds": [
              "2SA.12.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.5",
                "verseOrgIds": [
                  "2SA.12.5"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ndụ na onye mere ihe dị otu a aghaghị ịnwụ!",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.5",
            "verseOrgIds": [
              "2SA.12.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 12:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-ejikwa nwa atụrụ okpukpu anọ kwụghachi ogbenye ahụ ụgwọ otu atụrụ ahụ o weere, nʼihi na onye ọgaranya ahụ egosighị na o nwere obi ebere ọbụla.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.6",
            "verseOrgIds": [
              "2SA.12.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 12:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Netan sịrị Devid, \"Ọ bụ gị bụ nwoke ahụ! Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.7",
            "verseOrgIds": [
              "2SA.12.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.7",
                "verseOrgIds": [
                  "2SA.12.7"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel sịrị, 'Mụ onwe m tere gị mmanụ ịbụ eze Izrel, mụ onwe m napụtakwara gị site nʼaka Sọl.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.7",
            "verseOrgIds": [
              "2SA.12.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 12:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyere m gị ụlọ nna gị ukwu, nyefekwa ndị inyom nna gị ukwu nʼaka gị, na alaeze Izrel na Juda, ka ha bụrụ nke gị. Ma ọ bụrụ na nke a ezughị, agaara m atụkwasịrị gị ihe ndị a niile okpukpu okpukpu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.8",
            "verseOrgIds": [
              "2SA.12.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 12:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji lelịa okwu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.9",
                "verseOrgIds": [
                  "2SA.12.9"
                ]
              }
            }
          ]
        },
        {
          "text": "anya, mee ihe a jọgburu onwe ya? Nʼihi na i jirila mma agha gbuo Ụraya onye Het, zurukwa nwunye ya nʼohi. Ọ bụkwa mma agha ndị Amọn ka i ji gbuo ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.9",
            "verseOrgIds": [
              "2SA.12.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 12:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, nʼihi ihe a i mere, mma agha agaghị esi nʼezinaụlọ gị pụọ, nʼihi na i ledara m anya kpọrọ nwunye Ụraya onye Het ka ọ bụrụ nwunye gị.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.10",
            "verseOrgIds": [
              "2SA.12.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 12:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ihe a ka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.11",
                "verseOrgIds": [
                  "2SA.12.11"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, 'Aga m eme ka ihe ọjọọ si nʼezinaụlọ gị bilie megide gị. Nʼihu gị ka m ga-eduru ndị nwunye gị dunye otu onye dị gị nnọọ nso, ya na ha ga-edinakọ nʼehihie ọcha, nʼihu ndị Izrel niile.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.11",
            "verseOrgIds": [
              "2SA.12.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 12:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mere mmehie gị na nzuzo, ma aga m eme nke a na mbara, nʼihu Izrel niile.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.12",
            "verseOrgIds": [
              "2SA.12.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 12:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid sịrị Netan, \"Emehiela m megide",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.13",
                "verseOrgIds": [
                  "2SA.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": ".\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 12:13"
      },
      "items": [
        {
          "text": "Netan zara sị ya, \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.13",
                "verseOrgIds": [
                  "2SA.12.13"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼonwe ya agbagharakwala gị mmehie gị, ị gaghị anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.13",
            "verseOrgIds": [
              "2SA.12.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 12:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼihi na i meela ka ndị iro",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
            "verseOrgIds": [
              "2SA.12.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.14",
                "verseOrgIds": [
                  "2SA.12.14"
                ]
              }
            }
          ]
        },
        {
          "text": "nwe ohere ikwulu na ilelị ya anya, nwa nwoke ahụ amụụrụ gị ga-anwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.14",
            "verseOrgIds": [
              "2SA.12.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 12:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Netan lara,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.15",
                "verseOrgIds": [
                  "2SA.12.15"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ka nwantakịrị ahụ nwunye Ụraya mụụrụ Devid daa ọrịa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.15",
            "verseOrgIds": [
              "2SA.12.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 12:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid rịọrọ Chineke arịrịọ banyere nwantakịrị ahụ. O buru ọnụ, dinaa nʼala efu abalị ahụ niile nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.16",
                "verseOrgIds": [
                  "2SA.12.16"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.16",
            "verseOrgIds": [
              "2SA.12.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 12:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, ndị okenye ụlọ ya rịọrọ Devid ka o bilie rie nri, ma ọ jụrụ iri ihe ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.17",
            "verseOrgIds": [
              "2SA.12.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 12:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa, nwantakịrị ahụ nwụrụ. Mgbe ahụ, ndị na-ejere Devid ozi tụrụ egwu otu ha ga-esi gwa ya na nwantakịrị ahụ anwụọla. Nʼihi na ha kwuru nʼime onwe ha sị, \"Mgbe nwantakịrị ahụ ka dị ndụ, anyị gwara ya okwu ma o geghị anyị ntị. Anyị ga-esi aṅaa gwa ya na nwantakịrị ahụ anwụọla? O nwere ike imerụ onwe ya ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.18",
            "verseOrgIds": [
              "2SA.12.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 12:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid hụrụ na ha na-ekwurịta okwu nʼetiti onwe ha na nzuzo; ọ matara na nwa ahụ anwụọla. Ọ jụrụ ha sị, \"Nwata ahụ ọ nwụọla?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 12:19"
      },
      "items": [
        {
          "text": "Ha zara sị ya, \"E, ọ nwụọla!\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.19",
            "verseOrgIds": [
              "2SA.12.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 12:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid sitere nʼala ebe o dina, bilie, saa ahụ, gbanwee uwe ya, baa nʼụlọ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.20",
                "verseOrgIds": [
                  "2SA.12.20"
                ]
              }
            }
          ]
        },
        {
          "text": ", kpọọrọ ya isiala. Ọ lọghachiri nʼụlọ ya nye iwu ka e wetara ya ihe oriri. O rikwara nri.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.20",
            "verseOrgIds": [
              "2SA.12.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 12:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "O juru ndị na-ejere ya ozi anya, nʼihi ya ha jụrụ ya ajụjụ si, \"Gịnị mere i ji eme omume dị otu a? Mgbe nwantakịrị ahụ nọ ndụ, i buru ọnụ, kwaakwa akwa, ma ugbu a, nwa ahụ anwụọla, ị kwụsịla iru ụjụ. Ugbu a, ị biliela na-erikwa nri.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.21",
            "verseOrgIds": [
              "2SA.12.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 12:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid zara ha sị, \"Eburu m ọnụ, kwaakwa akwa mgbe nwa ahụ nọ ndụ, nʼihi na ekwuru m sị, 'ma eleghị anya,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.22",
                "verseOrgIds": [
                  "2SA.12.22"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-enwe ọmịiko nʼebe m nọ mee ka nwa ahụ dị ndụ.'",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.22",
            "verseOrgIds": [
              "2SA.12.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 12:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a ọ nwụrụ, gịnịkwa ka m nwere dịka uru ibu ọnụ ọzọ? M pụrụ ime ka ọ dị ndụ ọzọ? Aga m alakwuru ya, ma ọ gaghị alaghachikwutekwa m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.23",
            "verseOrgIds": [
              "2SA.12.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 12:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid kasiri Batsheba nwunye ya obi, emesịa, mgbe ya na ya dinakọrọ, ọ tụụrụ ime ọzọ mụọ nwa nwoke onye ha kpọrọ aha ya Solomọn. Ma",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.24",
                "verseOrgIds": [
                  "2SA.12.24"
                ]
              }
            }
          ]
        },
        {
          "text": "hụrụ nwantakịrị ahụ nʼanya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.24",
            "verseOrgIds": [
              "2SA.12.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 12:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "O zigara ozi site nʼaka Netan, onye amụma, ka a gụọ ya Jedidaya nʼihi",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.12.25",
                "verseOrgIds": [
                  "2SA.12.25"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.25",
            "verseOrgIds": [
              "2SA.12.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 12:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Joab busoro Raba obodo ndị Amọn agha dọta isi obodo eze ha nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.26",
            "verseOrgIds": [
              "2SA.12.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 12:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab zigara Devid ozi sị ya, \"Ebuola m agha megide Raba dọta isi mmiri ọṅụṅụ ya nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.27",
            "verseOrgIds": [
              "2SA.12.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 12:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a chịkọtaa ndị agha fọdụrụ bịa lụpụchaa agha a, ka ị dọta obodo a nʼagha. Ọ bụrụ na i meghị otu a, aga m adọta obodo a nʼagha, a ga-akpọkwasịkwa ya aha m.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.28",
            "verseOrgIds": [
              "2SA.12.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 12:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Devid duuru ndị agha Izrel jeruo Raba, buso ya agha, meriekwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.29",
            "verseOrgIds": [
              "2SA.12.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2SA 12:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Devid kpupuru okpueze nke dị nʼisi eze ha, e kpunye ya nʼisi nke ya onwe ya. Ịdị arọ nke okpueze ahụ ruru kilogram ọlaedo iri atọ na anọ, nke e ji nkume ndị dị oke ọnụahịa chọọ mma. Devid sitekwara nʼobodo ahụ kwakọrọ ọtụtụ ihe nkwata nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.30",
            "verseOrgIds": [
              "2SA.12.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2SA 12:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kpọpụtara ndị nọ nʼebe ahụ, manye ha nʼịrụ ọrụ nke e ji mma nkwọ e ji awa osisi, na igwe e ji egwu ala na anyụike nʼarụ. O mere ka ha rụọ ọrụ nʼebe a na-akpụ blọk brik. Devid mekwara otu ihe a nʼobodo niile nke ụmụ Amọn. Emesịa, ya na ndị agha ya niile laghachiri na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.12.31",
            "verseOrgIds": [
              "2SA.12.31"
            ]
          }
        }
      ]
    }
  ],
