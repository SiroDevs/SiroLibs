  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "2SA 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Devid emerie ndị Amọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ihe ndị a gasịrị, eze ndị Amọn",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "text": "nwụrụ. Hanọn nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.1",
            "verseOrgIds": [
              "2SA.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Devid chere sị, \"Aga m egosi Hanọn nwa Nahash obi ebere dịka nna ya si gosi m obi ebere.\" Ya mere, Devid zipụrụ ndị ozi ka ha gaa kasịe ya obi nʼihi ọnwụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:2"
      },
      "items": [
        {
          "text": "Mgbe ndị ikom Devid rutere nʼala ndị Amọn,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.2",
            "verseOrgIds": [
              "2SA.10.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndịisi ala Amọn sịrị Hanọn bụ onyenwe ha, \"Ị na-eche na Devid na-akwanyere nna gị ụgwụ site na izite ndị ozi ya ka ha bịa kasịe gị obi? Ọ bụ na Devid eziteghị ha ịbịakwute gị, naanị ka ha bịa mee nledo nʼobodo a, nyochapụta ya ma kwatuo ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.3",
            "verseOrgIds": [
              "2SA.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, Hanọn jidere ndị ozi Devid nʼike, kpụchapụ otu mpaghara afụọnụ nwoke ọbụla, bipụkwa uwe mwụda ha nʼetiti ike ha, zilaga ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.4",
            "verseOrgIds": [
              "2SA.10.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara Devid ihe mere, o zipụrụ ndị ozi ka ha gaa zute ndị ikom ahụ, nʼihi na e mere ha ihe ihere nʼebe ọ dị ukwuu. Eze sịrị, \"Nọdụnụ na Jeriko ruo mgbe afụọnụ unu tolitere, mgbe ahụ unu ga-alọta.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.5",
            "verseOrgIds": [
              "2SA.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị Amọn chọpụtara na ha abụrụla ihe ịsọ oyi nʼebe Devid nọ, ha gara goo iri puku ndị agha abụọ ji ụkwụ eje site nʼAram, Bet-Rehob nakwa Zoba. Ha gokwara eze Maaka ya na puku ndị ikom, tinyekwara iri puku ndị ikom na puku abụọ ọzọ site nʼala Tob.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.6",
            "verseOrgIds": [
              "2SA.10.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Devid nụrụ nke a, o zipụrụ Joab na ndị agha ya niile bụ dike na dimkpa nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.7",
            "verseOrgIds": [
              "2SA.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị Amọn pụtara doo onwe ha nʼusoro ibu agha, nʼọnụ ụzọ ama nke obodo ha. Ma ndị Aram, ndị si Zoba na Rehob, na ndị ikom Tob na Maaka, nọpụrụ onwe ha na mbara ala.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.8",
            "verseOrgIds": [
              "2SA.10.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Joab hụrụ na agha dị megide ya nʼihu na azụ, ọ họpụtara ụfọdụ ndị ọkachamara site nʼetiti ndị agha Izrel, doo ha nʼusoro izute ndị Aram.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.9",
            "verseOrgIds": [
              "2SA.10.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "O tinyere ndị ikom fọdụrụ nʼokpuru ọchịchị Abishai, nwanne ya, zipụkwa ha izute ndị Amọn nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.10",
            "verseOrgIds": [
              "2SA.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Joab sịrị, \"Ọ bụrụ na ndị agha Aram akarịa m ike, pụta bịa nyere m aka; ma ọ bụrụkwanụ na ndị Amọn akarịa gị ike, aga m apụta bịa napụta gị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.11",
            "verseOrgIds": [
              "2SA.10.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwee obi ike, ka anyị lụọ ọgụ a dịka ndị dị ike, nʼihi ndị anyị, na obodo niile nke Chineke anyị. Ka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.10.12",
                "verseOrgIds": [
                  "2SA.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "meekwa ihe dị mma nʼanya ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.12",
            "verseOrgIds": [
              "2SA.10.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Joab na ndị agha so ya bịara nso ibuso ndị Aram agha, ha sitere nʼihu ha gbapụ ọsọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.13",
            "verseOrgIds": [
              "2SA.10.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Amọn hụrụ ka ndị Aram na-agbapụ ọsọ, ha onwe ha gbakwara ọsọ nʼihu Abishai, gbaba nʼime obodo. Ya mere, Joab sitere nʼịlụso ndị Amọn agha lọghachi, bịa na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.14",
            "verseOrgIds": [
              "2SA.10.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị Aram hụrụ na ndị Izrel tigburu ha; ha lara, chịkọtaa onwe ha ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.15",
            "verseOrgIds": [
              "2SA.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hadadeza mere ka a kpọta ndị Aram site nʼofe ọzọ nke Osimiri Yufretis. Ha gara Hilam, ha na ọchịagha ndị agha Hadadeza, a na-akpọ Shobak, onye na-edu ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.16",
            "verseOrgIds": [
              "2SA.10.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe a gwara Devid banyere nke a, ọ chịkọtara ndị Izrel niile, gafee Jọdan, jeruo Hilam. Ndị Aram doro usoro agha ha izute Devid, lụsokwaa ya agha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.17",
            "verseOrgIds": [
              "2SA.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha sitere nʼihu ndị Izrel gbaa ọsọ, Devid gburu narị ndị ikom asaa na-anya ụgbọ agha nke ịnyịnya na-adọkpụ. Gbukwaa iri puku ndị agha anọ na-eji ụkwụ eje. O tidara Shobak, bụ ọchịagha ndị agha ha, ọ nwụọ nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.18",
            "verseOrgIds": [
              "2SA.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ndị eze niile nọ nʼokpuru ọchịchị Hadadeza hụrụ na Izrel etigbuola ha, ha mere ka ha na ndị Izrel dịrị nʼudo, bụrụkwa ndị nọ nʼokpuru ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2SA 10:19"
      },
      "items": [
        {
          "text": "Ya mere, ndị Aram tụrụ egwu inyere ụmụ Amọn aka ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.10.19",
            "verseOrgIds": [
              "2SA.10.19"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "2SA.11",
    "number": "11",
