  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "2SA 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nkwa Chineke kwere Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2SA 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O ruo mgbe eze nọsara ahụ nʼụlọeze ya, mgbe",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.1",
            "verseOrgIds": [
              "2SA.7.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.1",
                "verseOrgIds": [
                  "2SA.7.1"
                ]
              }
            }
          ]
        },
        {
          "text": "mekwara ka o site nʼaka ndị iro ya nọ gburugburu zuru ike,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.1",
            "verseOrgIds": [
              "2SA.7.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2SA 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ sịrị Netan, bụ onye amụma, \"Lee, mụ onwe m na-ebi nʼụlọ sida, ma igbe ọgbụgba ndụ Chineke dị nʼime ụlọ ikwu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.2",
            "verseOrgIds": [
              "2SA.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2SA 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netan zaghachiri eze sị, \"Ihe ọbụla dị gị nʼobi gaa nʼihu mee ya, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.3",
                "verseOrgIds": [
                  "2SA.7.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nọnyeere gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.3",
            "verseOrgIds": [
              "2SA.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2SA 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼabalị ahụ, okwu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.4",
                "verseOrgIds": [
                  "2SA.7.4"
                ]
              }
            }
          ]
        },
        {
          "text": "rutere Netan ntị, na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.4",
            "verseOrgIds": [
              "2SA.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2SA 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaa gwa ohu m Devid sị ya, 'Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.5",
                "verseOrgIds": [
                  "2SA.7.5"
                ]
              }
            }
          ]
        },
        {
          "text": "kwuru, Ọ bụ gị ga-ewuru m ụlọ ebe m ga-ebi?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.5",
            "verseOrgIds": [
              "2SA.7.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2SA 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ebibeghị m nʼụlọ site nʼụbọchị m si nʼIjipt kpọpụta ndị Izrel ruo taa. Kama ana m ejegharị site otu ebe gaa ebe ọzọ, were ụlọ ikwu mere ebe obibi m.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.6",
            "verseOrgIds": [
              "2SA.7.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2SA 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ọbụla m na-ejegharị nʼetiti ndị Izrel niile, ọ dị mgbe m sịrị onye ọbụla nʼime ndị ọchịchị ha, ndị m nyere iwu ka ha zụọ ndị m Izrel, sị, \"Gịnị mere unu ewubereghị m ụlọ sida?\" '",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.7",
            "verseOrgIds": [
              "2SA.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2SA 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a, gwa Devid bụ ohu m, sị, 'Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.8",
            "verseOrgIds": [
              "2SA.7.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.8",
                "verseOrgIds": [
                  "2SA.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile kwuru: Mụ onwe m sitere nʼọhịa ebe ịta nri nke ụmụ anụ ụlọ, sikwa nʼebe ị na-azụ igwe ewu na atụrụ kpọpụta gị. Mee gị onye na-achị ndị m Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.8",
            "verseOrgIds": [
              "2SA.7.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2SA 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anọnyekwara m gị nʼebe ọbụla ị gara, kpochapụ ndị iro gị niile site nʼihu gị. Ugbu a, aga m eme ka aha gị dị ukwuu, dịka aha ndị ikom dịkarịsịrị ukwuu nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.9",
            "verseOrgIds": [
              "2SA.7.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2SA 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m ahọpụta otu ebe nʼihi ndị m Izrel, kụkwa ha dịka osisi ka ha biri nʼebe obibi nke aka ha; ka ha ghara ị bụkwa ndị a na-esogbu ọzọ. Ndị ajọ mmadụ agaghị emegbukwa ha dịka ha mere na mbụ,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.10",
            "verseOrgIds": [
              "2SA.7.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2SA 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "dịka ha na-emekwa siterị na mgbe m họpụtara ndị ndu nye ndị m Izrel. Aga m enyekwa gị ezumike site nʼebe ndị iro gị niile nọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2SA 7:11"
      },
      "items": [
        {
          "text": "\" '",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.11",
                "verseOrgIds": [
                  "2SA.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwupụtara gị, na",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.11",
                "verseOrgIds": [
                  "2SA.7.11"
                ]
              }
            }
          ]
        },
        {
          "text": "ya onwe ya, ga-eguzobere gị ụlọ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.11",
            "verseOrgIds": [
              "2SA.7.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2SA 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị gị nʼụwa zuru, mgbe i ga-esoro nna nna gị ha dinaa nʼọnwụ, aga m eme ka otu mkpụrụ gị bilie nọchie ọnọdụ gị, onye bụ anụ ahụ na ọbara gị, aga m emekwa ka alaeze ya guzosie ike.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.12",
            "verseOrgIds": [
              "2SA.7.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2SA 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya ga-ewuru m ụlọ. Aga m eme ka ocheeze nke alaeze ya guzosie ike ruo mgbe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.13",
            "verseOrgIds": [
              "2SA.7.13"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.13",
            "verseOrgIds": [
              "2SA.7.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2SA 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ga-abụrụ ya nna. Ya onwe ya ga-abụkwara m nwa. Ọ bụrụ na o jehie, aga m eji mkpanaka mmadụ taa ya ahụhụ. Werekwa ihe otiti si nʼaka ndị mmadụ dụọ ya ọdụ.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.14",
            "verseOrgIds": [
              "2SA.7.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2SA 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma agaghị ewezuga ịhụnanya m site nʼebe ọ nọ, dịka m si wezuga ya site nʼebe Sọl nọ, bụ onye m wezugara site nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.15",
            "verseOrgIds": [
              "2SA.7.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2SA 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụlọ gị na alaeze gị ga-adịgide ruo mgbe ebighị ebi nʼihu m. A ga-eme ka ocheeze gị bụrụ ihe guzosiri ike ruo mgbe ebighị ebi.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.16",
            "verseOrgIds": [
              "2SA.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2SA 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Netan ziri Devid ozi dịka okwu niile nke ọhụ ahụ si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.17",
            "verseOrgIds": [
              "2SA.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Devid",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2SA 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze Devid banyere nọdụ ala nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.18",
                "verseOrgIds": [
                  "2SA.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", sị:",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "2SA 7:18"
      },
      "items": [
        {
          "text": "\"Onye ka m bụ, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.18",
                "verseOrgIds": [
                  "2SA.7.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", gịnịkwa ka ezinaụlọ m bụ, na ị mere ka m bịaruo nʼogogo ha otu a?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.18",
            "verseOrgIds": [
              "2SA.7.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2SA 7:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.19",
                "verseOrgIds": [
                  "2SA.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", dịka a ga-asị na nke a bụ ihe dị nta nʼanya gị. Ugbu a, i kwuola banyere ọdịnihu nke ụlọ ohu gị, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.19",
                "verseOrgIds": [
                  "2SA.7.19"
                ]
              }
            }
          ]
        },
        {
          "text": ", nke a bụkwa ụkpụrụ metụtara mmadụ efu.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.19",
            "verseOrgIds": [
              "2SA.7.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2SA 7:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gịnị ọzọ ka Devid ga-agwa gị? O, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.20",
            "verseOrgIds": [
              "2SA.7.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.20",
                "verseOrgIds": [
                  "2SA.7.20"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nʼihi na ị maara ohu gị nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.20",
            "verseOrgIds": [
              "2SA.7.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2SA 7:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi okwu gị na dịka ọchịchọ obi gị si dị, i meela ihe a dị ukwuu, meekwa ka ohu gị mata ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.21",
            "verseOrgIds": [
              "2SA.7.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2SA 7:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.22",
                "verseOrgIds": [
                  "2SA.7.22"
                ]
              }
            }
          ]
        },
        {
          "text": ", lee ka i si dị ukwuu! Ọ dịghị onye dịka gị. Ọ dịkwaghị Chineke ọzọ dị ma ọ bụghị gị, dịka anyị nụrụ ya na ntị anyị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.22",
            "verseOrgIds": [
              "2SA.7.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2SA 7:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olee ndị dịka ndị gị, bụ Izrel, bụ otu mba nʼelu ụwa nke Chineke gara ịgbapụta dịka otu ndị nye onwe ya, na iji mere onwe ya aha, rụọkwa ọrụ ịtụnanya dị egwu dịkwa ukwuu nʼihi ha, site nʼịchụpụ mba dị iche iche na chi niile ha site nʼihu ndị gị, bụ ndị ị gbapụtara site nʼIjipt?",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.23",
            "verseOrgIds": [
              "2SA.7.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2SA 7:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "I meela ka ndị gị Izrel guzosie ike, dịka ndị nke gị ruo mgbe ebighị ebi. Ma gị onwe gị kwa,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.24",
                "verseOrgIds": [
                  "2SA.7.24"
                ]
              }
            }
          ]
        },
        {
          "text": ", abụrụla Chineke ha.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.24",
            "verseOrgIds": [
              "2SA.7.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2SA 7:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.25",
                "verseOrgIds": [
                  "2SA.7.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke, debe nkwa a nke i kwere banyere ohu gị na ụlọ ya ka ọ dịrị ruo mgbe ebighị ebi. Mezukwaa ihe niile dịka nkwa gị si dị",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.25",
            "verseOrgIds": [
              "2SA.7.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2SA 7:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka aha gị bụrụ ihe dị ukwuu ruo mgbe ebighị ebi. Mgbe ahụ, ndị mmadụ ga-asị, '",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.26",
                "verseOrgIds": [
                  "2SA.7.26"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, bụ Chineke na-achị Izrel' A ga-emekwa ka ụlọ ohu gị bụ Devid guzosie ike nʼanya gị.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.26",
            "verseOrgIds": [
              "2SA.7.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2SA 7:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"O",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.27",
                "verseOrgIds": [
                  "2SA.7.27"
                ]
              }
            }
          ]
        },
        {
          "text": ", Onye pụrụ ime ihe niile, Chineke Izrel, nʼihi na ị kpugheerela ohu gị ihe a, na-asị, 'Aga m ewuru gị ụlọ.' Ya mere, ohu gị ji nwee obi ike ikpere gị ekpere a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.27",
            "verseOrgIds": [
              "2SA.7.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2SA 7:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "O, Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.28",
                "verseOrgIds": [
                  "2SA.7.28"
                ]
              }
            }
          ]
        },
        {
          "text": ", ị bụ Chineke nʼezie. Okwu gị kwesiri ntụkwasị obi.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "text": "I kweekwala ohu gị nkwa ihe ọma ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.28",
            "verseOrgIds": [
              "2SA.7.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2SA 7:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a biko, ka ọ masị gị ịgọzi ụlọ ohu gị, ka ọ dịgide nʼihu gị ruo mgbe ebighị ebi. Nʼihi na gị, o Onye kachasị ihe niile elu, bụ",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2SA.7.29",
                "verseOrgIds": [
                  "2SA.7.29"
                ]
              }
            }
          ]
        },
        {
          "text": "ekwuola ya, sitekwa na ngọzị gị, ụlọ ohu gị ga-abụkwa ihe a gọziri agọzi ruo mgbe ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2SA.7.29",
            "verseOrgIds": [
              "2SA.7.29"
            ]
          }
        }
      ]
    }
