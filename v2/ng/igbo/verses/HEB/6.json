  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "HEB 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HEB 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya bụ ka anyị na-aga nʼihu nʼihe mmụta zuru ezu, ka anyị gharakwa ịnọgide nʼihe mmụta mbụ ahụ nke anyị nwere banyere Kraịst. Anyị agaghị alaghachi azụ ịtọ ntọala nchegharị ọzọ site nʼọrụ ndị nwụrụ anwụ nʼokwukwe nʼebe Chineke nọ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.1",
            "verseOrgIds": [
              "HEB.6.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HEB 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-akụzi banyere ime baptizim na ibikwasị aka nʼisi na onyinye nke Mmụọ Nsọ, na mbilite nʼọnwụ na ikpe ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.2",
            "verseOrgIds": [
              "HEB.6.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HEB 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị ga-eme nke a ma Chineke kwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.3",
            "verseOrgIds": [
              "HEB.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HEB 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ dịghị mfe ịkpọghachi ndị dara ada ọzọ, bụ ndị natarala ihe ahụ na mbụ, ndị detụkwara onyinye amara dị iche iche nke si nʼeluigwe bịa ire, ndị ketakwara oke Mmụọ Nsọ,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.4",
            "verseOrgIds": [
              "HEB.6.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HEB 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ndị detụkwara ịdị mma nke okwu Chineke ahụ ire na ike nke ụwa na-abịa,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.5",
            "verseOrgIds": [
              "HEB.6.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HEB 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma mesịa dahie nʼonwe ha, ọ bụ ihe siri ike ịkpọghachite ha ruo nchegharị. Ha na akpọgidekwa Ọkpara Chineke nʼobe ọzọ, na emenyekwa ya ihere nʼihu ọha mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.6",
            "verseOrgIds": [
              "HEB.6.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HEB 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ala ahụ nke na-amị mmiri na-ezokwasị nʼelu ya mgbe niile, na-amịpụta mkpụrụ bara ụba nye ndị e ji maka ha kọọ ya, na-enweta ngọzị nʼaka Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.7",
            "verseOrgIds": [
              "HEB.6.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HEB 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na o puo naanị ogwu na ahịhịa, ọ baghị uru ọbụla. Kama, ọ ga-abụ ihe a bụrụ ọnụ, nke ọgwụgwụ ya ga-abụ ịkpọ ya ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.8",
            "verseOrgIds": [
              "HEB.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HEB 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụ ezie na anyị na-ekwu otu a, ezi ndị enyi m, anyị nwere ntụkwasị obi maka ihe dị ezi mma banyere unu, bụ ihe ndị ha na nzọpụta so bịa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.9",
            "verseOrgIds": [
              "HEB.6.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HEB 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke abụghị onye na-ekpe ikpe nʼezighị ezi. Ọ gaghị echefu ọrụ niile unu rụrụ ya. Ọ gaghị echefu ịhụnanya niile unu gosiri nʼihi ya site nʼịgara ndị nsọ ozi, dịka unu na-aga nʼihu na-emekwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.10",
            "verseOrgIds": [
              "HEB.6.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HEB 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị chọrọ ka onye ọbụla nʼime unu nọgidesie ike nʼotu ịnụ ọkụ nʼobi ahụ ruo ọgwụgwụ ihe niile, ka unu nwee olileanya inwezu ihe niile unu na-atụ anya ya mgbe oge ruru.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.11",
            "verseOrgIds": [
              "HEB.6.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HEB 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị achọghị ka unu bụrụ ndị umengwụ, kama ka unu bụrụ ndị na-eṅomi ndụ ahụ jiri okwukwe na ntachiobi nweta ihe ahụ e kwere na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.12",
            "verseOrgIds": [
              "HEB.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Chineke adịghị agbanwe uche ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HEB 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Chineke kwere Ebraham nkwa, o ji onwe ya ṅụọ iyi, nʼihi na ọ dịghị onye ọzọ dị ukwuu karịa ya,",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.13",
            "verseOrgIds": [
              "HEB.6.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HEB 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-asị, \"Nʼezie aga m agọzi gị, nyekwa gị ọtụtụ ụmụ ụmụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.14",
            "verseOrgIds": [
              "HEB.6.14"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.14",
            "verseOrgIds": [
              "HEB.6.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HEB 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebraham nwere ndidi, natakwa ihe e kwere ya na nkwa.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.15",
            "verseOrgIds": [
              "HEB.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HEB 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ mmadụ na-eji ndị ka ha ukwuu ṅụọ iyi, iyi aṅụrụ nʼụzọ dị otu a na-eme ka ihe e kwuru guzosie ike ma wezugakwa ịrụ ụka niile nʼetiti mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.16",
            "verseOrgIds": [
              "HEB.6.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HEB 6:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, mgbe Chineke chọrọ igosi ndị ahụ ga-eketa nkwa ahụ, ụdịdị izuzu ya, o jiri ịṅụ iyi mee ka o doo ha anya na izuzu ya adịghị agbanwe agbanwe.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.17",
            "verseOrgIds": [
              "HEB.6.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "HEB 6:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ọ ga-abụ site nʼihe abụọ na-enweghị mgbanwe, nke na-agaghị ekwe omume izi Chineke dịka onye ụgha, anyị bụ ndị gbara ọsọ ndụ ga-enweta agbamume siri ike iji jide olileanya e dobeere anyị.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.18",
            "verseOrgIds": [
              "HEB.6.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "HEB 6:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị nwere olileanya a dị ka arịlịka nke mkpụrụobi nke guzosiri ike ma bụrụkwa nke e chekwara. Ọ na-abanye nʼime ime ebe nchụaja ahụ nʼazụ akwa mgbochi",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.19",
            "verseOrgIds": [
              "HEB.6.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "HEB 6:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebe Jisọs onye buru anyị ụzọ, abanyela nʼihi anyị; ọ ghọlara anyị onyeisi nchụaja ruo mgbe ebighị ebi dị ka usoro Melkizedek si dị.",
          "type": "text",
          "attrs": {
            "verseId": "HEB.6.20",
            "verseOrgIds": [
              "HEB.6.20"
            ]
          }
        }
      ]
    }
  ],
