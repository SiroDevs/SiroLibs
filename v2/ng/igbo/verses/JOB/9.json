  "verseCount": 35,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "9",
        "style": "c",
        "sid": "JOB 9"
      },
      "items": [
        {
          "text": "9",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Job",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 9:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Job zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.1",
            "verseOrgIds": [
              "JOB.9.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 9:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼezie, amaara m na ihe ndị a bụ eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:2"
      },
      "items": [
        {
          "text": "Ma mmadụ dị ndụ ọ ga-esi aṅaa gosi na ya bụ onye aka ya dị ọcha nʼihu Chineke?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.2",
            "verseOrgIds": [
              "JOB.9.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 9:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na Chineke ekpebie ịjụ mmadụ ajụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:3"
      },
      "items": [
        {
          "text": "ebee ka mmadụ ahụ nọ nke nwere ike ịza ọ bụladị otu nʼime ajụjụ dị iche iche Chineke ga-ajụ ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.3",
            "verseOrgIds": [
              "JOB.9.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 9:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Amamihe ya dị ukwuu, ike ya sara mbara,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:4"
      },
      "items": [
        {
          "text": "onye guzogidere ya ma hapụ imerụ ahụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.4",
            "verseOrgIds": [
              "JOB.9.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 9:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-enugharị ugwu ukwu ma ha adịghị ama nke a,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:5"
      },
      "items": [
        {
          "text": "na-akwatụ ha nʼiwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.5",
            "verseOrgIds": [
              "JOB.9.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 9:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-enugharịkwa ụwa site na ntọala ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:6"
      },
      "items": [
        {
          "text": "mee ka ogidi ya maa jijiji.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.6",
            "verseOrgIds": [
              "JOB.9.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 9:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-agwa anyanwụ okwu mee ka ọ kwụsị ịcha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:7"
      },
      "items": [
        {
          "text": "ọ na-emenyụ ìhè kpakpando na-enye.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.7",
            "verseOrgIds": [
              "JOB.9.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 9:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Naanị ya gbasara mbara eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:8"
      },
      "items": [
        {
          "text": "ọ na-agakwa ije nʼelu ebili mmiri nke oke osimiri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.8",
            "verseOrgIds": [
              "JOB.9.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 9:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya mere kpakpando Bịaa, na Orion",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:9"
      },
      "items": [
        {
          "text": "na Pleiades, na kpakpando niile nke ndịda eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.9",
            "verseOrgIds": [
              "JOB.9.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 9:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-arụ ọtụtụ ọrụ ebube nke mmadụ na-enweghị ike ịghọta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:10"
      },
      "items": [
        {
          "text": "ihe ịrịbama nke ọnụ na-enweghị ike ịgụta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.10",
            "verseOrgIds": [
              "JOB.9.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 9:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ na-esi nʼakụkụ m agafe, enweghị m ike ịhụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:11"
      },
      "items": [
        {
          "text": "mgbe ọ na-agabiga, adịghị m amata na ọ bụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.11",
            "verseOrgIds": [
              "JOB.9.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 9:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ọ pụnara ihe, onye na-akwụsị ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:12"
      },
      "items": [
        {
          "text": "Onye kwa pụrụ ịjụ ya si, 'Gịnị ka ị na-eme?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.12",
            "verseOrgIds": [
              "JOB.9.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 9:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke adịghị eme ka iwe ya laghachi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:13"
      },
      "items": [
        {
          "text": "ọbụladị ndị inyeaka Rehab, ruru ala nʼụkwụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.13",
            "verseOrgIds": [
              "JOB.9.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 9:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Onye kwanụ ka m bụ, m ga-eji nwee ike iguzo nʼihu ya ịjụ ya ajụjụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:14"
      },
      "items": [
        {
          "text": "maọbụ mụ na ya ịrụrịta ụka?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.14",
            "verseOrgIds": [
              "JOB.9.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 9:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị na aka m dị ọcha, apụghị m ịsa ya okwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:15"
      },
      "items": [
        {
          "text": "kama m ga-arịọ onye ikpe m ka o mere m ebere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.15",
            "verseOrgIds": [
              "JOB.9.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 9:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na m kpọọ ya oku, ọ za m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:16"
      },
      "items": [
        {
          "text": "ekwenyeghị m na ọ ga-ege m ntị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.16",
            "verseOrgIds": [
              "JOB.9.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 9:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eji oke ifufe tirie m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:17"
      },
      "items": [
        {
          "text": "meekwa ka ihe mgbu m baa ụba na-enweghị ihe butere ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.17",
            "verseOrgIds": [
              "JOB.9.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 9:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaghị ekwe ka iku ume m lọghachi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.18",
            "verseOrgIds": [
              "JOB.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:18"
      },
      "items": [
        {
          "text": "kama ọ ga-eji iru ụjụ kpuchie m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.18",
            "verseOrgIds": [
              "JOB.9.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 9:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ ihe e ji ike eme, lee na ọ dị ike nke ukwuu!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.19",
            "verseOrgIds": [
              "JOB.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:19"
      },
      "items": [
        {
          "text": "Ọzọ ọ bụrụ nʼikpe ziri ezi, onye pụrụ iguzogide ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.19",
            "verseOrgIds": [
              "JOB.9.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 9:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na aka m dị ọcha, ọnụ m ga-ama m ikpe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.20",
            "verseOrgIds": [
              "JOB.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:20"
      },
      "items": [
        {
          "text": "ọ bụrụ na abụ m onye na-enweghị ịta ụta, ọ ga-agụ m nʼonye ikpe mara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.20",
            "verseOrgIds": [
              "JOB.9.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 9:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ ezie na abụ m onye ikpe na-amaghị",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:21"
      },
      "items": [
        {
          "text": "ejighị m onwe m kpọrọ ihe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:21"
      },
      "items": [
        {
          "text": "nʼezie ana m eleda ndụ m anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.21",
            "verseOrgIds": [
              "JOB.9.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 9:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ihe ahụ ka ọ bụ; nʼihi ya ka m ji asị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.22",
            "verseOrgIds": [
              "JOB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:22"
      },
      "items": [
        {
          "text": "'Ọ na-ala ndị ezi omume na ndị ajọ omume nʼiyi.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.22",
            "verseOrgIds": [
              "JOB.9.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 9:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ịpịa ụtarị wetara ọnwụ mberede,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.23",
            "verseOrgIds": [
              "JOB.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:23"
      },
      "items": [
        {
          "text": "ọ na-achị enweghị olileanya nke ndị na-enweghị ihe ha mere ọchị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.23",
            "verseOrgIds": [
              "JOB.9.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 9:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ala dabara nʼaka ndị na-emebi iwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:24"
      },
      "items": [
        {
          "text": "ọ na-ekpuchi ndị ọkaikpe anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:24"
      },
      "items": [
        {
          "text": "Ọ bụrụ na ọ bụghị ya na-eme ya, onye kwanụ bụ onye ahụ na-eme ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.24",
            "verseOrgIds": [
              "JOB.9.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 9:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ụbọchị ndụ m dị gara gara karịa onye ọgba ọsọ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.25",
            "verseOrgIds": [
              "JOB.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:25"
      },
      "items": [
        {
          "text": "ha na-agafekwa na-ahụtụghị ọṅụ anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.25",
            "verseOrgIds": [
              "JOB.9.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 9:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-agafe dịka ụgbọ mmiri papịrọs,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.26",
            "verseOrgIds": [
              "JOB.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:26"
      },
      "items": [
        {
          "text": "dịka mgbe ugo na-efeda ngwangwa ijide anụ ọ ga-eri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.26",
            "verseOrgIds": [
              "JOB.9.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 9:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na m sị, 'Aga m echefu mkpesa m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.27",
            "verseOrgIds": [
              "JOB.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:27"
      },
      "items": [
        {
          "text": "aga m agbanwe ihu m, nwee ihu ọchị.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.27",
            "verseOrgIds": [
              "JOB.9.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 9:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nsogbu m niile ka na-atụ m egwu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.28",
            "verseOrgIds": [
              "JOB.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:28"
      },
      "items": [
        {
          "text": "nʼihi na amara m na ị gaghị ewere m dịka onye aka ya dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.28",
            "verseOrgIds": [
              "JOB.9.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 9:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe m bụrịị onye ikpe mara,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.29",
            "verseOrgIds": [
              "JOB.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:29"
      },
      "items": [
        {
          "text": "nʼihi gịnị ka m ji na-adọgbu onwe m nʼefu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.29",
            "verseOrgIds": [
              "JOB.9.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "JOB 9:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na m jiri ncha saa ahụ m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.30",
            "verseOrgIds": [
              "JOB.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:30"
      },
      "items": [
        {
          "text": "werekwa soda saa aka m abụọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.30",
            "verseOrgIds": [
              "JOB.9.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "JOB 9:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "ị ga-enuba m nʼolulu apịtị",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.31",
            "verseOrgIds": [
              "JOB.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:31"
      },
      "items": [
        {
          "text": "nke pụrụ ime ka uwe m yi nʼahụ m kpọọ m asị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.31",
            "verseOrgIds": [
              "JOB.9.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "JOB 9:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụghị mmadụ efu dịka m nke m ga-aza ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.32",
            "verseOrgIds": [
              "JOB.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:32"
      },
      "items": [
        {
          "text": "ka anyị abụọ kpọrịtaa onwe anyị ikpe nʼụlọikpe.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.32",
            "verseOrgIds": [
              "JOB.9.32"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "JOB 9:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "A sịkwarị na e nwere onye odozi okwu nʼetiti mụ na gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.33",
            "verseOrgIds": [
              "JOB.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:33"
      },
      "items": [
        {
          "text": "onye ga-ebikwasị anyị abụọ aka ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.33",
            "verseOrgIds": [
              "JOB.9.33"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "JOB 9:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye ga-ewepụ mkpara Chineke site nʼebe m nọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.34",
            "verseOrgIds": [
              "JOB.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:34"
      },
      "items": [
        {
          "text": "ka oke egwu ya gharakwa ịtụ m ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.34",
            "verseOrgIds": [
              "JOB.9.34"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "JOB 9:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ ka m ga-ekwu okwu na-atụghị ya egwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.35",
            "verseOrgIds": [
              "JOB.9.35"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 9:35"
      },
      "items": [
        {
          "text": "ma ka ọ dị ugbu a ọ dịghị ihe m nwere ike ime.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.9.35",
            "verseOrgIds": [
              "JOB.9.35"
            ]
          }
        }
      ]
    }
