  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "JOB 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ m tiwara etiwa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "ụbọchị m niile dị mkpụmkpụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:1"
      },
      "items": [
        {
          "text": "ili na-echere ịnabata m.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.1",
            "verseOrgIds": [
              "JOB.17.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie ndị na-akwa emo gbara m gburugburu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:2"
      },
      "items": [
        {
          "text": "anya m na-elekwasịkwa mkpasu iwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.2",
            "verseOrgIds": [
              "JOB.17.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Debere m ihe ebe nʼebe gị Chineke nọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:3"
      },
      "items": [
        {
          "text": "Olee onye ọzọ pụrụ ịnara m nʼakaebe?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.3",
            "verseOrgIds": [
              "JOB.17.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "I mechiela uche ha ka ha ghara inwe nghọta;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:4"
      },
      "items": [
        {
          "text": "ya mere, i gaghị ekwe ka ha nwee mmeri.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.4",
            "verseOrgIds": [
              "JOB.17.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na mmadụ ekwujọọ enyi ya ka o were nweta uru dị nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:5"
      },
      "items": [
        {
          "text": "anya ụmụ ya ga-ada mba.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.5",
            "verseOrgIds": [
              "JOB.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chineke emeela ka m bụrụ okwu ilu nye onye ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:6"
      },
      "items": [
        {
          "text": "meekwa ka m bụrụ onye ha na-agbụsa asọ mmiri nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.6",
            "verseOrgIds": [
              "JOB.17.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya m na-ahụ inyogho inyogho nʼihi iru ụjụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:7"
      },
      "items": [
        {
          "text": "ahụ m aghọọla onyinyo nke ihe m bụ na mbụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.7",
            "verseOrgIds": [
              "JOB.17.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-eme ihe ziri ezi na-akụja mgbe ha hụrụ nke a;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:8"
      },
      "items": [
        {
          "text": "ndị aka ha dị ọcha na-enwe mkpali megide ndị ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.8",
            "verseOrgIds": [
              "JOB.17.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma otu ọbụla ọ dị, ndị ezi omume ga-aga nʼihu nʼiso ụzọ ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:9"
      },
      "items": [
        {
          "text": "ndị aka ha dị ọcha ga-aga nʼihu nʼịdị ike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.9",
            "verseOrgIds": [
              "JOB.17.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma bịanụ, unu niile, bidonụ okwu unu ọzọ!",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:10"
      },
      "items": [
        {
          "text": "Agaghị m achọta onye maara ihe nʼetiti unu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.10",
            "verseOrgIds": [
              "JOB.17.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị m niile agafeela, atụmatụ m abụrụla ihe lara nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:11"
      },
      "items": [
        {
          "text": "Ma ọchịchọ nke obi m",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.11",
            "verseOrgIds": [
              "JOB.17.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-edo abalị nʼọnọdụ ehihie;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:12"
      },
      "items": [
        {
          "text": "nʼihu ọchịchịrị ka ìhè dị nso.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.12",
            "verseOrgIds": [
              "JOB.17.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na ebe obibi m na-ele anya ya bụ ili,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:13"
      },
      "items": [
        {
          "text": "ọ bụrụ na m agbasaa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        },
        {
          "text": "ihe ndina m nʼelu ọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.13",
            "verseOrgIds": [
              "JOB.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "a sikwa na m asị ire ure, 'Nna m ka ị bụ,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:14"
      },
      "items": [
        {
          "text": "maọbụ sị ikpuru 'Nne m' maọbụ 'Nwanne m nwanyị,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.14",
            "verseOrgIds": [
              "JOB.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "ebeekwa ka olileanya m dị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:15"
      },
      "items": [
        {
          "text": "Onye pụrụ ịhụ ma m nwere olileanya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.15",
            "verseOrgIds": [
              "JOB.17.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Olileanya m ọ ga-arịda ruo nʼọnụ ụzọ ama nke ọnwụ?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 17:16"
      },
      "items": [
        {
          "text": "Anyị ga-esokọta rịdaruo nʼuzuzu?\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.17.16",
            "verseOrgIds": [
              "JOB.17.16"
            ]
          }
        }
      ]
    }
  ],
