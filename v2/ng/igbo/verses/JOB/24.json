        "vid": "JOB 24:24"
      },
      "items": [
        {
          "text": "a na-eweda ha nʼala chikọtakwa ha dịka ndị ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
              "JOB.24.24"
            ]
