              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka okpomọkụ na ọkọchị si eme ka mkpụrụ mmiri oyi gbazee,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
