              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-ebuli ha elu nwa mgbe nta, ma e mesịa, ha anọkwaghị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.24",
            "verseOrgIds": [
