              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Chineke na-eji ike ya dọkpụrụ ndị dị ike nke ukwuu pụọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
