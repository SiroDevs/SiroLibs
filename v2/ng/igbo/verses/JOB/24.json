      "attrs": {
        "style": "q2",
        "vid": "JOB 24:19"
      },
      "items": [
        {
          "text": "otu a ka ala ili si ewere ndị mehiere nʼike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.19",
            "verseOrgIds": [
              "JOB.24.19"
            ]
          }
