      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:18"
      },
      "items": [
        {
          "text": "ala ha ketara bụ ihe a bụrụ ọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.18",
            "verseOrgIds": [
              "JOB.24.18"
            ]
          }
        }
      ]
