      "attrs": {
        "style": "q2",
        "vid": "JOB 24:21"
      },
      "items": [
        {
          "text": "ha adịghị elekọta nwanyị di ya nwụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.21",
            "verseOrgIds": [
