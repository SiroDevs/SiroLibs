      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 24:17"
      },
      "items": [
        {
          "text": "ha na ihe egwu nke ọchịchịrị bụ enyi.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
              "JOB.24.17"
            ]
          }
