              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼebe ha niile nọ, etiti abalị bụ ụtụtụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.17",
            "verseOrgIds": [
