              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ nwere ike ime ka ha dabere na ntụkwasị obi na o nweghị ihe pụrụ ịmetụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.23",
