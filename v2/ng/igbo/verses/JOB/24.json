        "style": "q2",
        "vid": "JOB 24:22"
      },
      "items": [
        {
          "text": "ọ bụ ezie na ha bụ ndị ihe na-agara nke ọma, ma ha enweghị nkwa nke ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.24.22",
            "verseOrgIds": [
              "JOB.24.22"
