      "attrs": {
        "style": "q2",
        "vid": "JOB 3:20"
      },
      "items": [
        {
          "text": "Gịnị bụ uru ndụ nye onye mkpụrụobi ya jupụtara nʼihe ilu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.20",
            "verseOrgIds": [
