          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi gịnị ka e ji enye ndị nọ nʼọnọdụ nhụju anya ìhè?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.20",
