        "style": "q2",
        "vid": "JOB 3:18"
      },
      "items": [
        {
          "text": "ha adịghị anụkwa ịba mba nke ndị na-eji aka ike achị ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.18",
            "verseOrgIds": [
