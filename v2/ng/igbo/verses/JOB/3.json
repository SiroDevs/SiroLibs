          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị bụ uru ya nye ndị na-echere ọnwụ ma ọ dịghị abịa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.21",
