              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ahụ ka ndị nọ nʼagbụ na-enwere onwe ha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.3.18",
            "verseOrgIds": [
