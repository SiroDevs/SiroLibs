          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 36:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ ya na-eme ka ukuru mmiri rigoro nʼelu mgbe anwụ na-acha,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.27",
            "verseOrgIds": [
              "JOB.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:27"
      },
      "items": [
        {
          "text": "nke a na-aghọ mmiri ozuzo nye iyi niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.27",
            "verseOrgIds": [
              "JOB.36.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 36:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Igwe ojii na-awụdata mmiri dị nʼime ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:28"
      },
      "items": [
        {
          "text": "mee ka mmiri ozuzo dị ukwuu zokwasị ụmụ mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.28",
            "verseOrgIds": [
              "JOB.36.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
