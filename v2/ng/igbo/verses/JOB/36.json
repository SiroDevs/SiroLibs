      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 36:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"E buliela Chineke elu nʼike ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:22"
      },
      "items": [
        {
          "text": "onye bụ onye ozizi dịka ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.22",
            "verseOrgIds": [
              "JOB.36.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 36:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye họpụtaara ya ụzọ ọ ga-agbaso,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.23",
            "verseOrgIds": [
              "JOB.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:23"
      },
      "items": [
        {
          "text": "maọbụ sị ya 'I meela ajọ ihe'?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.23",
            "verseOrgIds": [
              "JOB.36.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
