          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Cheta ka i bulie ọrụ aka ya elu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.24",
            "verseOrgIds": [
              "JOB.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:24"
      },
      "items": [
        {
          "text": "bụ nke ụmụ mmadụ torola site nʼabụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.24",
            "verseOrgIds": [
              "JOB.36.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 36:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmadụ niile ahụzuola ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:25"
      },
      "items": [
        {
          "text": "ụmụ mmadụ nọ nʼebe dị anya na-ele ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.25",
            "verseOrgIds": [
              "JOB.36.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 36:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, Chineke dị ukwuu, karịa nghọta anyị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 36:26"
      },
      "items": [
        {
          "text": "Ọnụọgụgụ afọ ya karịrị mmadụ ịchọpụta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.36.26",
            "verseOrgIds": [
              "JOB.36.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
