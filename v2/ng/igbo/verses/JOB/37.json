          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gwa anyị ihe anyị ga-azaghachi ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
