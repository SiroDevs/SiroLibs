      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:20"
      },
      "items": [
        {
          "text": "Ọ dị mmadụ ọbụla ga-achọ ka e loda ya?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.20",
            "verseOrgIds": [
              "JOB.37.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
