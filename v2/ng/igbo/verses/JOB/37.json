      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:22"
      },
      "items": [
        {
          "text": "Chineke na-eji ebube dị egwu na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.22",
            "verseOrgIds": [
              "JOB.37.22"
