      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:21"
      },
      "items": [
        {
          "text": "mgbe ifufe ji ngwangwa gabiga mee ka o nwuo ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.21",
            "verseOrgIds": [
              "JOB.37.21"
