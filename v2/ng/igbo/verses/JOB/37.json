  "verseCount": 24,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "37",
        "style": "c",
        "sid": "JOB 37"
      },
      "items": [
        {
          "text": "37",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 37:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼihi nke a, obi m na-ama jijiji,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:1"
      },
      "items": [
        {
          "text": "na-amali elu site nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.1",
            "verseOrgIds": [
              "JOB.37.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 37:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gee ntị! Gee ntị nụrụ ụda olu ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:2"
      },
      "items": [
        {
          "text": "na ụzụ nke si nʼọnụ ya apụta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.2",
            "verseOrgIds": [
              "JOB.37.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 37:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-atọpụ amụma ya ka ọ na-ejeru nʼokpuru eluigwe niile,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:3"
      },
      "items": [
        {
          "text": "ọ na-ezisakwa ya ebe niile ụwa sọtụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.3",
            "verseOrgIds": [
              "JOB.37.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 37:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a gasịa, ihe ọzọ na-eso ya bụ mbigbọ nke olu ike ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "ụda olu ya na ada ụda dịka egbe eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "mgbe olu ahụ dara dakwasị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:4"
      },
      "items": [
        {
          "text": "ọ naghị egbochi amụma igbu egbu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.4",
            "verseOrgIds": [
              "JOB.37.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 37:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụzọ dị ebube ka olu Chineke si ada dịka egbe eluigwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:5"
      },
      "items": [
        {
          "text": "ọ na-eme ọtụtụ ihe ukwuu nke anyị na-apụghị ịghọta.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.5",
            "verseOrgIds": [
              "JOB.37.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 37:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ bụ ya na-agwa snoo okwu sị: 'Daa nʼelu ala,'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:6"
      },
      "items": [
        {
          "text": "na-agwakwa mmiri ozuzo okwu sị, 'Zoo nnukwu mmiri ozuzo.'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.6",
            "verseOrgIds": [
              "JOB.37.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 37:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mmadụ o kere mata akaọrụ ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:7"
      },
      "items": [
        {
          "text": "ọ na-emekwa ka mmadụ ọbụla kwụsị ịdọgbu onwe ya nʼọrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.7",
            "verseOrgIds": [
              "JOB.37.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 37:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ anụmanụ bi nʼọhịa na-agbaba zoo onwe;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:8"
      },
      "items": [
        {
          "text": "ha na-anọgide nʼebe obibi ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.8",
            "verseOrgIds": [
              "JOB.37.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 37:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ifufe na-esite nʼụlọ ya na-abịa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:9"
      },
      "items": [
        {
          "text": "oyi na-esitekwa nʼikuku na-agbasa agbasa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.9",
            "verseOrgIds": [
              "JOB.37.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 37:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iku ume Chineke na-emepụta mkpụrụ mmiri,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:10"
      },
      "items": [
        {
          "text": "ogbu mmiri na-akpụkọtakwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.10",
            "verseOrgIds": [
              "JOB.37.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 37:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-eme ka igwe ojii jupụta na mmiri;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:11"
      },
      "items": [
        {
          "text": "na-eme ka amụma gbuo nʼime igwe ojii.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.11",
            "verseOrgIds": [
              "JOB.37.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 37:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na ntụziaka ya ka ha na-echigharị onwe ha gburugburu",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:12"
      },
      "items": [
        {
          "text": "imezu ihe ọbụla ọ chọrọ ka ha mee",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:12"
      },
      "items": [
        {
          "text": "nʼelu ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.12",
            "verseOrgIds": [
              "JOB.37.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 37:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-ewebata igwe ojii maka ịta ndị mmadụ ahụhụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:13"
      },
      "items": [
        {
          "text": "na-eweta ya maka ime ka mmiri zokwasị elu ala igosi ịhụnanya ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.13",
            "verseOrgIds": [
              "JOB.37.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 37:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Job, gee ntị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:14"
      },
      "items": [
        {
          "text": "Tulee ọrụ ebube niile Chineke na-arụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.14",
            "verseOrgIds": [
              "JOB.37.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 37:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị maara otu Chineke si achịkọta igwe ojii",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:15"
      },
      "items": [
        {
          "text": "na-eme ka amụma gbuo?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.15",
            "verseOrgIds": [
              "JOB.37.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 37:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị maara otu Chineke si kwụba igwe ojii na mbara eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:16"
      },
      "items": [
        {
          "text": "nke bụ ọrụ ebube onye ihe ọmụma ya zuruoke?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.16",
            "verseOrgIds": [
              "JOB.37.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 37:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị onye uwe i yi nʼahụ na-ekpo gị ọkụ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:17"
      },
      "items": [
        {
          "text": "mgbe ụwa dere jii nʼihi ifufe na-esite na ndịda na-abịa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.17",
            "verseOrgIds": [
              "JOB.37.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
