              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ụmụ mmadụ na-atụ egwu ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.24",
            "verseOrgIds": [
              "JOB.37.24"
            ]
