      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:19"
      },
      "items": [
        {
          "text": "ebe ọ bụ na anyị apụghị ido okwu anyị nʼusoro nʼihi ọchịchịrị nke anyị nọ nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.19",
            "verseOrgIds": [
              "JOB.37.19"
            ]
          }
        }
