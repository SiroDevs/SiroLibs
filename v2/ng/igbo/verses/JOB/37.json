      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 37:23"
      },
      "items": [
        {
          "text": "nʼikpe ikpe ya ziri ezi na ezi omume ya bara ụba, ọ naghị emegbu mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.37.23",
            "verseOrgIds": [
              "JOB.37.23"
            ]
          }
