  "verseCount": 29,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "20",
        "style": "c",
        "sid": "JOB 20"
      },
      "items": [
        {
          "text": "20",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Zofa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 20:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Zofa onye Neama zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.1",
            "verseOrgIds": [
              "JOB.20.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 20:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Enweghị udo nke echiche m na-akpali m izaghachi",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:2"
      },
      "items": [
        {
          "text": "nʼihi na anọ m na mwute dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.2",
            "verseOrgIds": [
              "JOB.20.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 20:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụla m okwu mkparị nke ileda anya nye m,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:3"
      },
      "items": [
        {
          "text": "ma nghọta m na-akpalịte m ịzaghachi gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.3",
            "verseOrgIds": [
              "JOB.20.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 20:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼezie, ị maara otu ọ dị site na mgbe ochie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:4"
      },
      "items": [
        {
          "text": "ya bụ kemgbe e debere mmadụ nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.4",
            "verseOrgIds": [
              "JOB.20.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 20:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Obi ụtọ nke onye na-emebi iwu na-adị nwa mgbe nta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:5"
      },
      "items": [
        {
          "text": "ọṅụ nke ndị na-amaghị Chineke na-anọ naanị nwa oge.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.5",
            "verseOrgIds": [
              "JOB.20.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 20:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị na ịnya isi ya ga-eru eluigwe,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:6"
      },
      "items": [
        {
          "text": "na isi ya ga-emetụkwa igwe ojii;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.6",
            "verseOrgIds": [
              "JOB.20.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 20:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ ga-ala nʼiyi ebighị ebi, dịka nsị ya onwe ya nyụrụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:7"
      },
      "items": [
        {
          "text": "ndị maara ya ga-ajụ, 'Olee ebe ọ nọ?'",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.7",
            "verseOrgIds": [
              "JOB.20.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 20:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-efelaga dịka nrọ, agaghị achọtakwa ya mgbe ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:8"
      },
      "items": [
        {
          "text": "dịka ọhụ abalị nke e chefuru echefu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.8",
            "verseOrgIds": [
              "JOB.20.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 20:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya hụrụ ya na mbụ agaghị ahụkwa ya ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:9"
      },
      "items": [
        {
          "text": "ebe obibi ya agaghị elegidekwa ya anya ọzọ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.9",
            "verseOrgIds": [
              "JOB.20.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 20:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ya ga-achọ ihuọma site nʼaka ndị ogbenye;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:10"
      },
      "items": [
        {
          "text": "aka ya abụọ kwa ga-enyeghachi akụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.10",
            "verseOrgIds": [
              "JOB.20.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 20:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkpụkpụ ya nke jupụtara nʼike okorobịa",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:11"
      },
      "items": [
        {
          "text": "ga-eso ya bụrụ ihe a ghanyere na ntụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.11",
            "verseOrgIds": [
              "JOB.20.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 20:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọ bụ ezie na ihe ọjọọ na-atọ ya ụtọ nʼọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:12"
      },
      "items": [
        {
          "text": "na ọ na-ezokwa ya nʼokpuru ire ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.12",
            "verseOrgIds": [
              "JOB.20.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 20:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụ ezie na ọ pụghị nʼịhapụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:13"
      },
      "items": [
        {
          "text": "ọ na-edebe ya nʼọnụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.13",
            "verseOrgIds": [
              "JOB.20.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 20:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma nri ọ na-eri ga-aghọ ihe gbara ụka nʼafọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:14"
      },
      "items": [
        {
          "text": "ọ ga-aghọkwa elo agwọ nʼime afọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.14",
            "verseOrgIds": [
              "JOB.20.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 20:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-agbọpụta akụnụba niile o lodara;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:15"
      },
      "items": [
        {
          "text": "Chineke ga-eme ka o si nʼafọ ya gbọpụtachaa ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.15",
            "verseOrgIds": [
              "JOB.20.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 20:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-amịcha elo agwọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:16"
      },
      "items": [
        {
          "text": "eze agwọ ajụala ga-egbu ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.16",
            "verseOrgIds": [
              "JOB.20.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 20:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gaghị anụ ụtọ mmiri si nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:17"
      },
      "items": [
        {
          "text": "bụ iyi nke na-asọ asọ nke jupụtara na mmanụ aṅụ na mmiri ara ehi rahụrụ arahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.17",
            "verseOrgIds": [
              "JOB.20.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 20:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọ rụpụtara ka ọ ga-eji kwụghachi ụgwọ o ji na-erighị ma otu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
            "verseOrgIds": [
              "JOB.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:18"
      },
      "items": [
        {
          "text": "Uru ọ zụtara nʼahịa agaghị abụrụ ya ihe ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.18",
            "verseOrgIds": [
              "JOB.20.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 20:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ kpagburu ndị ogbenye, hapụ ha na-enweghị olileanya ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.19",
            "verseOrgIds": [
              "JOB.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:19"
      },
      "items": [
        {
          "text": "ọ nakọtakwara ụlọ nke ọ na-ewughị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.19",
            "verseOrgIds": [
              "JOB.20.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 20:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Nʼezie, ọ gaghị enwe izuike site nʼoke ọchịchọ ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.20",
            "verseOrgIds": [
              "JOB.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:20"
      },
      "items": [
        {
          "text": "ọ gaghị azọpụtakwa onwe ya site nʼụlọakụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.20",
            "verseOrgIds": [
              "JOB.20.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 20:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị ihe fọdụụrụ ya iripịa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.21",
            "verseOrgIds": [
              "JOB.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:21"
      },
      "items": [
        {
          "text": "ọganihu ya agaghị adịgide.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.21",
            "verseOrgIds": [
              "JOB.20.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 20:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼetiti ihe niile o nwere ka mkpagbu ga-abịakwasị ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.22",
            "verseOrgIds": [
              "JOB.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:22"
      },
      "items": [
        {
          "text": "oke ịta ahụhụ ga-adakwasị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.22",
            "verseOrgIds": [
              "JOB.20.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 20:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o rijuru afọ",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:23"
      },
      "items": [
        {
          "text": "ka Chineke ga-eme ka iwe ya dị ọkụ megide ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:23"
      },
      "items": [
        {
          "text": "iti aka Chineke ga-adakwasị ya dịka mmiri ozuzo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.23",
            "verseOrgIds": [
              "JOB.20.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 20:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na o si na ngwa agha e ji igwe kpụọ gbalaga,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.24",
            "verseOrgIds": [
              "JOB.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:24"
      },
      "items": [
        {
          "text": "àkụ nke e ji ọla bronz kpụọ ọnụ ya ga-amapu ya ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.24",
            "verseOrgIds": [
              "JOB.20.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 20:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼazụ ya ka ọ na-esi mịpụta ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:25"
      },
      "items": [
        {
          "text": "site nʼumeju ya ka a ga-esi mịpụta ọnụ ya na-egbu amụma.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 20:25"
      },
      "items": [
        {
          "text": "Oke egwu dị iche iche ga-abịakwasị ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.25",
            "verseOrgIds": [
              "JOB.20.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 20:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke ọchịchịrị nọ na-echere akụnụba ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "JOB 20:26"
      },
      "items": [
        {
          "text": "ọkụ nke a na-afụnwughị afụnwu ga-erepịa ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:26"
      },
      "items": [
        {
          "text": "ọ ga-erechapụkwa ihe niile fọdụrụ nʼụlọ ikwu ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.26",
            "verseOrgIds": [
              "JOB.20.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 20:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eluigwe ga-ekpughe ikpe ọmụma ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.27",
            "verseOrgIds": [
              "JOB.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:27"
      },
      "items": [
        {
          "text": "ụwa niile ga-ebili megide ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.27",
            "verseOrgIds": [
              "JOB.20.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "JOB 20:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Idee mmiri ga-ebupu ụlọ ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.28",
            "verseOrgIds": [
              "JOB.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:28"
      },
      "items": [
        {
          "text": "oke mmiri okwukwo nʼụbọchị iwe Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.28",
            "verseOrgIds": [
              "JOB.20.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "JOB 20:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ oke nke Chineke debeere ndị na-emebi iwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.29",
            "verseOrgIds": [
              "JOB.20.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 20:29"
      },
      "items": [
        {
          "text": "ya bụkwa ihe nketa nke Chineke kwadooro ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.20.29",
            "verseOrgIds": [
              "JOB.20.29"
            ]
          }
        }
      ]
