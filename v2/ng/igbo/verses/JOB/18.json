  "verseCount": 21,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "18",
        "style": "c",
        "sid": "JOB 18"
      },
      "items": [
        {
          "text": "18",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Okwu Bildad",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 18:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ Bildad onye Shua zara sị:",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.1",
            "verseOrgIds": [
              "JOB.18.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 18:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ruo ole mgbe ka ị ga-ekwubi okwu ndị a ị na-ekwu?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:2"
      },
      "items": [
        {
          "text": "Nwee ezi uche ka anyị kparịtaa ụka.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.2",
            "verseOrgIds": [
              "JOB.18.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 18:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere i ji were anyị dịka anụ ọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:3"
      },
      "items": [
        {
          "text": "gụọ anyị dịka ndị na-enweghị uche nʼanya gị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.3",
            "verseOrgIds": [
              "JOB.18.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 18:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị onye na-eji iwe adọkasị onwe gị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "a ga-ahapụ ụwa nʼihi gị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:4"
      },
      "items": [
        {
          "text": "Ka a ga-enupu oke nkume nʼọnọdụ ha?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.4",
            "verseOrgIds": [
              "JOB.18.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 18:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"A na-afụnyụ oriọna nke onye na-emebi iwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:5"
      },
      "items": [
        {
          "text": "ire ọkụ ya ga-akwụsịkwa inwu enwu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.5",
            "verseOrgIds": [
              "JOB.18.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 18:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ìhè nke dị nʼime ụlọ ikwu ya na-abụ ọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:6"
      },
      "items": [
        {
          "text": "oriọna nke dị nʼakụkụ ya na-anyụkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.6",
            "verseOrgIds": [
              "JOB.18.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 18:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ike agakwaghị adị na nzọ ukwu ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:7"
      },
      "items": [
        {
          "text": "atụmatụ ya onwe ya ga-atụda ya nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.7",
            "verseOrgIds": [
              "JOB.18.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 18:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụkwụ ya na-eduba ya nʼọnya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:8"
      },
      "items": [
        {
          "text": "ọ na-akpagharị na-adaba nʼime oghere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.8",
            "verseOrgIds": [
              "JOB.18.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 18:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọnya na-ejide ikiri ụkwụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:9"
      },
      "items": [
        {
          "text": "ọnya ahụ na-ejidesi ya ike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.9",
            "verseOrgIds": [
              "JOB.18.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 18:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "E zobere ya ụdọ ọnya igbudu nʼala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:10"
      },
      "items": [
        {
          "text": "ihe e ji ejide ya na-echere ya nʼụzọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.10",
            "verseOrgIds": [
              "JOB.18.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 18:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe egwu na-emenye ya ụjọ nʼakụkụ niile,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:11"
      },
      "items": [
        {
          "text": "na-agbasokwa nzọ ụkwụ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.11",
            "verseOrgIds": [
              "JOB.18.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 18:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịla nʼiyi na-achọsi ya ike;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:12"
      },
      "items": [
        {
          "text": "mbibi nọkwa na njikere na-eche mgbe ọ ga-ada.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.12",
            "verseOrgIds": [
              "JOB.18.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 18:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mbibi na-eripịa akụkụ anụ ahụ ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:13"
      },
      "items": [
        {
          "text": "ọkpara ọnwụ na-eripịa ahụ ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.13",
            "verseOrgIds": [
              "JOB.18.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 18:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esi na nchekwa nke ụlọ ikwu ya dọpụta ya",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:14"
      },
      "items": [
        {
          "text": "duru ya jekwuru eze nke ihe egwu niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.14",
            "verseOrgIds": [
              "JOB.18.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 18:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkụ na-ebi nʼime ụlọ ikwu ya;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:15"
      },
      "items": [
        {
          "text": "a ga-efesasị nkume na-enwu ọkụ nʼebe obibi ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.15",
            "verseOrgIds": [
              "JOB.18.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 18:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbọrọgwụ ya na-akpọ nkụ nʼime ala,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:16"
      },
      "items": [
        {
          "text": "alaka ya ga-akpọnwụ nʼelu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.16",
            "verseOrgIds": [
              "JOB.18.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 18:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị echeta echiche ya nʼụwa ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:17"
      },
      "items": [
        {
          "text": "o nweghị onye ọbụla na-echetakwa aha ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.17",
            "verseOrgIds": [
              "JOB.18.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 18:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-esite nʼìhè chụba ya nʼọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 18:18"
      },
      "items": [
        {
          "text": "otu a kwa, a na-achụpụkwa ya site nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.18.18",
            "verseOrgIds": [
              "JOB.18.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
