  "verseCount": 27,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "JOB 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "JOB 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kpọọ oku ma ị chọọ, ma onyekwanụ ga-aza gị?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:1"
      },
      "items": [
        {
          "text": "Ole ndị dị nsọ ị ga-agbakwuru?",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.1",
            "verseOrgIds": [
              "JOB.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "JOB 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke iwe na-egbu onye nzuzu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:2"
      },
      "items": [
        {
          "text": "ekworo na-egbu onye na-enweghị uche.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.2",
            "verseOrgIds": [
              "JOB.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "JOB 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m ahụla onye nzuzu ka ọ na-agba mgbọrọgwụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:3"
      },
      "items": [
        {
          "text": "mana mberede, abụrụ ụlọ ya ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.3",
            "verseOrgIds": [
              "JOB.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "JOB 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ ya na-anọpụ anya site nʼebe nchebe dị,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:4"
      },
      "items": [
        {
          "text": "a na-azọpịa ha nʼọnụ ụzọ ama, ọ dịkwaghị onye na-anapụta ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.4",
            "verseOrgIds": [
              "JOB.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "JOB 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye agụụ na-agụ na-eripịa ihe o wetara nʼubi;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "ọ na-ewere ihe ubi ndị a ọ bụladị site nʼetiti ogwu;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:5"
      },
      "items": [
        {
          "text": "akụnụba ya ka onye akpịrị na-akpọ nkụ ga-achụso.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.5",
            "verseOrgIds": [
              "JOB.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "JOB 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọnọdụ ọjọọ adịghị esite nʼala pupụta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:6"
      },
      "items": [
        {
          "text": "ma ọ bụkwanụ nsogbu adịghịkwa esite nʼala walite.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.6",
            "verseOrgIds": [
              "JOB.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "JOB 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama, a mụrụ mmadụ nye nsogbu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:7"
      },
      "items": [
        {
          "text": "dịka ire ọkụ si esite nʼọkụ a kwanyere na-amali elu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.7",
            "verseOrgIds": [
              "JOB.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "JOB 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ọ bụrụ na m bụ gị, m ga-ekpesara Chineke;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:8"
      },
      "items": [
        {
          "text": "ya ka m ga-akọsara ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.8",
            "verseOrgIds": [
              "JOB.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "JOB 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na Chineke na-arụ ọrụ ịtụnanya karịrị nghọta,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:9"
      },
      "items": [
        {
          "text": "ọrụ ebube nke a na-apụghị ịgụta ọnụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.9",
            "verseOrgIds": [
              "JOB.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "JOB 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya na-enye elu ụwa mmiri ozuzo,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:10"
      },
      "items": [
        {
          "text": "ma na-ezigakwa mmiri nʼubi niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.10",
            "verseOrgIds": [
              "JOB.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "JOB 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-ebuli ndị dị ala elu,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:11"
      },
      "items": [
        {
          "text": "na-emekwa ka ndị na-eru ụjụ nọ nʼebe a na-echebe ha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.11",
            "verseOrgIds": [
              "JOB.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "JOB 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-emebi nzube niile nke ndị aghụghọ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:12"
      },
      "items": [
        {
          "text": "ka aka ha ghara imezu ihe ha zubere.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.12",
            "verseOrgIds": [
              "JOB.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "JOB 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-ejide ndị oke amamihe nʼaghụghọ ha niile,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:13"
      },
      "items": [
        {
          "text": "mee ka atụmatụ ndị aghụghọ bụrụ ihe e kpochapụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.13",
            "verseOrgIds": [
              "JOB.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "JOB 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọchịchịrị na-abịakwasị ha nʼoge ehihie,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:14"
      },
      "items": [
        {
          "text": "nʼetiti ehihie ha na-asọ ìsì dịka ndị nọ nʼọchịchịrị nke abalị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.14",
            "verseOrgIds": [
              "JOB.5.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "JOB 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-azọpụta ndị mkpa na-akpa, site na mma agha dị ha nʼọnụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:15"
      },
      "items": [
        {
          "text": "ọ na-anapụtakwa ha site nʼaka ndị dị ike.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.15",
            "verseOrgIds": [
              "JOB.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "JOB 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, ndị ogbenye na-enwe olileanya,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:16"
      },
      "items": [
        {
          "text": "ikpe ezighị ezi na-emechikwa ọnụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.16",
            "verseOrgIds": [
              "JOB.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "JOB 5:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ngọzị na-adịrị mmadụ ahụ Chineke na-adọ aka na ntị;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:17"
      },
      "items": [
        {
          "text": "ya mere, ajụla ịdọ aka na ntị nke Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.17",
            "verseOrgIds": [
              "JOB.5.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "JOB 5:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọ na-etihịa mmadụ ahụ ma na-ekechikwa ọnya ha;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:18"
      },
      "items": [
        {
          "text": "Ọ na-eti mmadụ ihe, ma aka ya na-agwọkwa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.18",
            "verseOrgIds": [
              "JOB.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "JOB 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-anapụta gị site nʼụzọ nsogbu isii,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.19",
            "verseOrgIds": [
              "JOB.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:19"
      },
      "items": [
        {
          "text": "mee ka ihe ọjọọ hapụ irute gị na nsogbu nke asaa.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.19",
            "verseOrgIds": [
              "JOB.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "JOB 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-echebe gị ka ị hapụ ịnwụ nʼoge ụnwụ;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.20",
            "verseOrgIds": [
              "JOB.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:20"
      },
      "items": [
        {
          "text": "chebekwa gị ka mma agha hapụ ịmetụ gị nʼoge agha.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.20",
            "verseOrgIds": [
              "JOB.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "JOB 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-abụ onye a na-echebe site na nkwutọ nke ire ndị ga-ekwutọ gị.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.21",
            "verseOrgIds": [
              "JOB.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:21"
      },
      "items": [
        {
          "text": "Ị gaghị atụkwa egwu mgbe mbibi bịara.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.21",
            "verseOrgIds": [
              "JOB.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "JOB 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-achị ọchị nʼoge ụnwụ na nʼoge mbibi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.22",
            "verseOrgIds": [
              "JOB.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:22"
      },
      "items": [
        {
          "text": "ị gaghị atụkwa egwu ajọ anụ ọhịa dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.22",
            "verseOrgIds": [
              "JOB.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "JOB 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na gị na nkume niile dị nʼọhịa ga-agba ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.23",
            "verseOrgIds": [
              "JOB.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:23"
      },
      "items": [
        {
          "text": "gị na anụ ọhịa ga-anọkwa nʼudo.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.23",
            "verseOrgIds": [
              "JOB.5.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "JOB 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-amata na ụlọ ikwu gị dị nʼudo;",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.24",
            "verseOrgIds": [
              "JOB.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:24"
      },
      "items": [
        {
          "text": "ị ga-agụkọ ihe niile i nwere chọpụta na o nweghị nke na-efu efu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.24",
            "verseOrgIds": [
              "JOB.5.24"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "JOB 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-amata na ụmụ gị ga-adị ọtụtụ,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.25",
            "verseOrgIds": [
              "JOB.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:25"
      },
      "items": [
        {
          "text": "matakwa na ụmụ ụmụ gị dị ukwuu nʼọnụọgụgụ dịka ahịhịa dị nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.25",
            "verseOrgIds": [
              "JOB.5.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "JOB 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-aba nʼili gị mgbe i mere nnọọ ezigbo agadi,",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.26",
            "verseOrgIds": [
              "JOB.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:26"
      },
      "items": [
        {
          "text": "dịka ọka a ghọrọ mgbe oge ya ruru.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.26",
            "verseOrgIds": [
              "JOB.5.26"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "JOB 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anyị enyochaala ihe a, hụ na ọ bụ eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.27",
            "verseOrgIds": [
              "JOB.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "JOB 5:27"
      },
      "items": [
        {
          "text": "Ya mere nụrụ ya, ma jiri ya rụọ ọrụ na ndụ gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "JOB.5.27",
            "verseOrgIds": [
              "JOB.5.27"
            ]
          }
        }
      ]
    }
