        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere Nehemaya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "NEH 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ okwu Nehemaya nwa Hakalaya:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "NEH 1:1"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 1:1"
      },
      "items": [
        {
          "text": "Nʼọnwa Kislev,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "text": "nke afọ ahụ mere ya iri afọ abụọ nke ọchịchị Ataksekses",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "text": "mgbe m nọ nʼụlọeze dị na Susa,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.1",
            "verseOrgIds": [
              "NEH.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "NEH 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "otu nwanne m nwoke aha ya bụ Hanani,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        },
        {
          "text": "na ụfọdụ ndị ọzọ sitere Juda bịara ileta m. Ajụrụ m ha ajụjụ otu ihe si agara ndị Juu ahụ fọdụrụ, ndị si ebe dị iche iche lọta, jụọkwa ha maka Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.2",
            "verseOrgIds": [
              "NEH.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "NEH 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha zara si: \"Ndị ahụ niile lọtara",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        },
        {
          "text": "nọ nʼoke nsogbu na ihere. A kụdara mgbidi Jerusalem; e sukwara ọnụ ụzọ ama ya niile ọkụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.3",
            "verseOrgIds": [
              "NEH.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "NEH 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m nụrụ okwu ndị a, anọdụrụ m ala kwaa nnọọ akwa. Nʼezie, ajụrụ m iri ihe ọbụla ọtụtụ ụbọchị, nʼihi na eji m oge m niile kpee ekpere rịọ Chineke nke eluigwe arịrịọ,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.4",
            "verseOrgIds": [
              "NEH.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "NEH 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "si ya:",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm",
        "vid": "NEH 1:5"
      },
      "items": [
        {
          "text": "\"Gị,",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "NEH.1.5",
                "verseOrgIds": [
                  "NEH.1.5"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nke eluigwe, onye dị ukwu na onye dịkwa egwu; gị onye na-edebe ọgbụgba ndụ ịhụnanya nke ndị ahụ hụrụ ya nʼanya na-edebekwa iwu ya niile. Biko nụrụ arịrịọ m.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.5",
            "verseOrgIds": [
              "NEH.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "NEH 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Leda anya ebere gị ka ị nụrụ arịrịọ mụ bụ ohu gị na-arịọ gị ehihie na nʼabalị. Ana m ekwupụta mmehie anyị bụ ụmụ Izrel, ma nke m na ezinaụlọ nna m mere megide gị.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.6",
            "verseOrgIds": [
              "NEH.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "NEH 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị emela ihe jọrọ njọ megide gị. Anyị edebeghị iwu gị na ụkpụrụ gị nke i nyere ohu gị Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.7",
            "verseOrgIds": [
              "NEH.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "NEH 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Chetakwa ntụziaka inyere Mosis bụ ohu gị, na-asị, 'Ọ bụrụ na unu emehie, mụ onwe m ga-achụsa unu nʼetiti mba dị iche iche.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.8",
            "verseOrgIds": [
              "NEH.1.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "NEH 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụrụ na unu alaghachikwute m, debe ihe niile m nyere unu nʼiwu, a sikwa na a chụsara unu mee ka unu gbasaa ga nʼakụkụ niile nke ụwa, aga m achịkọta unu mee ka unu laghachi na Jerusalem bụ obodo m họpụtara nye Aha m.'",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.9",
            "verseOrgIds": [
              "NEH.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "pm"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "NEH 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Anyị bụ ndị ohu gị, bụrụkwa ndị i ji aka gị dị ike zọpụta.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.10",
            "verseOrgIds": [
              "NEH.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "NEH 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Biko, Onyenwe anyị, nụrụ ekpere mụ bụ ohu gị, nụrụkwa ekpere ndị ohu gị niile ọ na-atọ ụtọ ịtụ egwu aha gị. Mee ka ihe gara ohu gị nke ọma taa site nʼimere ya ebere nʼihu nwoke a.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        },
        {
          "text": "\"",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "NEH 1:11"
      },
      "items": [
        {
          "text": "Nʼoge ahụ abụ m onye na-ebu ihe ọṅụṅụ eze.",
          "type": "text",
          "attrs": {
            "verseId": "NEH.1.11",
            "verseOrgIds": [
              "NEH.1.11"
            ]
          }
        }
      ]
    }
  ],
