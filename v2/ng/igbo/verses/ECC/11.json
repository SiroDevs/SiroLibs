  "verseCount": 10,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "ECC 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịgbasapụ aka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gbasapụ aka gị nʼinye onyinye",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:1"
      },
      "items": [
        {
          "text": "nʼihi na mgbe ọtụtụ ụbọchị gasịrị ị ga-anata ụgwọ ọrụ gị.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.1",
            "verseOrgIds": [
              "ECC.11.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kee akụ gị ụzọ asaa maọbụ ụzọ asatọ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:2"
      },
      "items": [
        {
          "text": "nʼihi na ị maghị ụdị ihe ndaba ọjọọ nwere ike ịbịakwasị gị nʼobodo.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.2",
            "verseOrgIds": [
              "ECC.11.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eluigwe rujiri,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "mmiri ga-ezo;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "mgbe osisi dara, maọbụ nʼugwu maọbụ na ndịda,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:3"
      },
      "items": [
        {
          "text": "ebe ahụ ka ọ na-atọgbọ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.3",
            "verseOrgIds": [
              "ECC.11.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye na-ele ikuku anya agaghị akụ mkpụrụ ọbụla,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:4"
      },
      "items": [
        {
          "text": "onye na-ele igwe ojii anya agaghị ewe ihe ubi.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.4",
            "verseOrgIds": [
              "ECC.11.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka mmadụ na-apụghị ịmata ụzọ ikuku si aga",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "maọbụ otu ndụ ọhụrụ si ebido nʼime afọ nwanyị dị ime,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "otu a ka o si dịrị ma mmadụ apụghị ịghọta ọrụ Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:5"
      },
      "items": [
        {
          "text": "onye mere ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.5",
            "verseOrgIds": [
              "ECC.11.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ghaa mkpụrụ gị nʼụtụtụ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "esepụkwala aka nʼanyasị,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "nʼihi na ị maghị nke ga-eto,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "maọbụ nke a maọbụ nke ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:6"
      },
      "items": [
        {
          "text": "ha niile nwere ike too nke ọma.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.6",
            "verseOrgIds": [
              "ECC.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Cheta Chineke nʼokorobịa gị",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ìhè dị ụtọ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:7"
      },
      "items": [
        {
          "text": "ọ na-amasịkwa anya ịhụ ìhè anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.7",
            "verseOrgIds": [
              "ECC.11.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na mmadụ adị ndụ ọtụtụ afọ,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "ya ṅụrịa nʼime ihe niile,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "ma ya cheta ụbọchị ọchịchịrị",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "ga-adị ọtụtụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:8"
      },
      "items": [
        {
          "text": "Ihe niile ndị na-abịa bụ ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.8",
            "verseOrgIds": [
              "ECC.11.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nwa okorobịa, ọ bụ ihe oke ọṅụ na ị bụ okorobịa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "Ya mere, ka obi gị nye gị ọṅụ nʼụbọchị niile nke okorobịa gị.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "Mee ihe niile ị chọrọ ime;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "gbasookwa ihe niile nke anya gị na-ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "Kama, ghọtakwa nke a,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:9"
      },
      "items": [
        {
          "text": "na ị ghaghị ịza ajụjụ nʼihu Chineke nʼihi ihe niile i mere.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.9",
            "verseOrgIds": [
              "ECC.11.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, wezuga nchegbu site nʼobi,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:10"
      },
      "items": [
        {
          "text": "wezugakwa nsogbu nke ahụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 11:10"
      },
      "items": [
        {
          "text": "nʼihi na okorobịa na ịdị ike bụ ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.11.10",
            "verseOrgIds": [
              "ECC.11.10"
            ]
          }
        }
      ]
    }
  ],
