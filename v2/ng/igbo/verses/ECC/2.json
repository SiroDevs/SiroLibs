{
  "id": "ECC.2",
  "number": "2",
  "bookId": "ECC",
  "reference": "Ekiliziastis 2",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 26,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "ECC 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ịgbaso ihe na-enye aṅụrị enweghị isi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "ECC 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echere m nʼime obi m sị, Ugbu a, aga m eji ihe na-enye obi aṅụrị nwaa gị site otu a chọpụta ihe dị mma, ma nke a bụkwa ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.1",
            "verseOrgIds": [
              "ECC.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "ECC 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ọchị,\" ka m sịrị na \"ọ bụ ihe nzuzu. Ikpori ndụ, uru gịnị ka ọ bara?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.2",
            "verseOrgIds": [
              "ECC.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "ECC 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Echere m nʼobi ụtọ m ga-esite nʼịṅụ mmanya. Agbasokwara m ụzọ ibi ndụ nzuzu ma obi m nọ nnọọ na-edu m site nʼamamihe. Olileanya m bụ na m ga-esi otu a chọta ụzọ kachasị mma ndị mmadụ nwere ike iji bie mkpụmkpụ ndụ ha nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.3",
            "verseOrgIds": [
              "ECC.2.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "ECC 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arụpụtara m ọtụtụ ihe dị iche iche, ewuru m ụlọ nye onwe m ma nweekwa ubi vaịnị.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.4",
            "verseOrgIds": [
              "ECC.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "ECC 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ewuru m ubi a gbara ogige ebe izuike, ma kụọkwa osisi na-amị mkpụrụ dị iche iche nʼime ha,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.5",
            "verseOrgIds": [
              "ECC.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "ECC 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "wuore onwe m ọdọ mmiri ebe a ga-esi na-agba ubi m niile mmiri.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.6",
            "verseOrgIds": [
              "ECC.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "ECC 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agbatara m ndị ohu nwoke na nwanyị, nweekwa ndị ohu ọzọ a mụrụ nʼụlọ m. Enwekwara m ọtụtụ igwe ehi na anụ ụlọ karịa eze niile ndị bu m ụzọ chịa na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.7",
            "verseOrgIds": [
              "ECC.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "ECC 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achịkọtara m ọlaọcha na ọlaedo nye onwe m, na akụnụba nke ọtụtụ ndị eze na-achị ala ha na-atụtara m. E nwetakwara m nye onwe m ndị ikom na ndị inyom ndị na-abụ abụ. Enwekwara ndị iko nwanyị nʼebe ọ bara ụba. Ihe ụtọ niile ndị na-amasị obi nwa mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.8",
            "verseOrgIds": [
              "ECC.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "ECC 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, aghọrọ m onye dị ukwuu karịa eze niile ndị burula m ụzọ chịa na Jerusalem. Ma nʼime ihe ndị a niile, anya doro m, ihe niile ka m ji amamihe tulee.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.9",
            "verseOrgIds": [
              "ECC.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "ECC 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ọbụla m chọrọ, ka m na-ewere;",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:10"
      },
      "items": [
        {
          "text": "egbochighị m onwe m aṅụrị ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 2:10"
      },
      "items": [
        {
          "text": "Obi m ṅụrịrị ọṅụ site nʼọrụ niile,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:10"
      },
      "items": [
        {
          "text": "nke a bụkwa oke m ketara na ndọgbu niile m dọgburu onwe m.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.10",
            "verseOrgIds": [
              "ECC.2.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "ECC 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m tulere ihe banyere ihe ndị a niile m tinyetụrụ aka,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:11"
      },
      "items": [
        {
          "text": "otu m si dọgbuo onwe m nʼọrụ banyere ha,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 2:11"
      },
      "items": [
        {
          "text": "mkpebi m bụ na ha niile bụ ihe efu, dịka ịchọ ijide ifufe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:11"
      },
      "items": [
        {
          "text": "Nʼezie, ihe niile bụ ihe efu, ha abakwaghị uru.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.11",
            "verseOrgIds": [
              "ECC.2.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Amamihe na nzuzu enweghị isi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "ECC 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Atụgharịrị m bido ịmụ ihe banyere amamihe,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:12"
      },
      "items": [
        {
          "text": "na ịyị ara na nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 2:12"
      },
      "items": [
        {
          "text": "Olee ihe ọzọ nke onye ga-anọchi anya eze ga-eme,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:12"
      },
      "items": [
        {
          "text": "karịa ihe ndị ahụ e merela na mbụ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.12",
            "verseOrgIds": [
              "ECC.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "ECC 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achọpụtara m na amamihe dị mma karịa nzuzu,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:13"
      },
      "items": [
        {
          "text": "dịka ìhè si dị mma karịa ọchịchịrị.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.13",
            "verseOrgIds": [
              "ECC.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "ECC 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na onye maara ihe na-ahụ ụzọ",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:14"
      },
      "items": [
        {
          "text": "ma isi kpuru onye nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 2:14"
      },
      "items": [
        {
          "text": "Ma achọpụtakwara m",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:14"
      },
      "items": [
        {
          "text": "na otu ihe ndaba na-adabara onye amamihe na onye nzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.14",
            "verseOrgIds": [
              "ECC.2.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "ECC 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agwara m onwe m okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 2:15"
      },
      "items": [
        {
          "text": "\"Dịka onye nzuzu ga-anwụ, otu ahụ kwa ka m ga-anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:15"
      },
      "items": [
        {
          "text": "Gịnị bụ uru amamihe m niile bara?\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 2:15"
      },
      "items": [
        {
          "text": "Ekwuru m nʼobi m sị,",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:15"
      },
      "items": [
        {
          "text": "\"Ihe a bụkwa ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.15",
            "verseOrgIds": [
              "ECC.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "ECC 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na onye maara ihe na onye nzuzu bụ ndị a na-agaghị echeta ihe banyere ogologo oge dị nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "ECC 2:16"
      },
      "items": [
        {
          "text": "Nʼụbọchị ndị na-abịa nʼihu, a gaghị echeta ha.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "ECC 2:16"
      },
      "items": [
        {
          "text": "Onye amamihe na onye nzuzu aghaghị ịnwụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.16",
            "verseOrgIds": [
              "ECC.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndọgbu nʼọrụ abaghị uru",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "ECC 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, akpọrọ m ịdị ndụ asị, nʼihi na ọrụ a na-arụ nʼokpuru anyanwụ wutere m. Ihe efu ka ọ bụ; ọ dị ka ịchụgharị ifufe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.17",
            "verseOrgIds": [
              "ECC.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "ECC 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe niile m gbalịrị ịrụpụta ka m kpọrọ asị, nʼihi na amaara m na emesịa, aga m ahapụrụ ha onye ọzọ na-abịa nʼazụ m.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.18",
            "verseOrgIds": [
              "ECC.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "ECC 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye maara ma ọ ga-abụ onye maara ihe ma ọ ga-abụkwanụ onye nzuzu? Ma ihe niile m ji amamihe ǹka m na ike m rụpụta nʼokpuru anyanwụ ga-abụ nke ya! Ihe a bụ ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.19",
            "verseOrgIds": [
              "ECC.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "ECC 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, o wutere m nʼobi na m dọgburu onwe m nʼọrụ nʼokpuru anyanwụ.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.20",
            "verseOrgIds": [
              "ECC.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "ECC 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na mmadụ nwere ike jiri amamihe, na ihe ọmụma na ǹka dọgbuo onwe ya nʼọrụ, emesịa, ha ahapụrụ onye na-enweghị mgbe ọ rụrụ ọrụ ọbụla ihe ndị ahụ niile. Nke a bụkwa ihe efu, na oke ihe ndakwasị.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.21",
            "verseOrgIds": [
              "ECC.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "ECC 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị bụ uru mmadụ na-enweta na ndọgbu niile ọ na-adọgbu onwe ya nʼọrụ nʼokpuru anyanwụ?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.22",
            "verseOrgIds": [
              "ECC.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "ECC 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nʼụbọchị ha niile jupụtara naanị nʼihe mgbu na iru ụjụ, ọ bụladị nʼabalị, obi ha anaghị ezu ike. Ihe ndị a bụkwa ihe efu.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.23",
            "verseOrgIds": [
              "ECC.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "ECC 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, ekpebiri m na ọ dịghị ihe ọzọ ga-abara mmadụ uru karịakwa naanị ịnọdụ ala rie nri, ṅụọkwa ihe ma chọta ojuju afọ nʼọrụ ya. Achọpụtakwara m na ọ bụladị nke a si nʼaka Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.24",
            "verseOrgIds": [
              "ECC.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "ECC 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị onye pụrụ iri maọbụ ṅụọ ma o siteghị na Chineke?",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.25",
            "verseOrgIds": [
              "ECC.2.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "ECC 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ndị na-eme ihe na-atọ ya ụtọ, ka Chineke na-enye amamihe na ihe ọmụma, na ọṅụ; ma ọ na-enye onye mmehie ọrụ ịkpakọta na ịchịkọba akụnụba nke ọ ga-enyefe nʼaka onye ahụ ihe ya dị Chineke mma. Nke a bụkwa ihe efu; ịchụso ifufe.",
          "type": "text",
          "attrs": {
            "verseId": "ECC.2.26",
            "verseOrgIds": [
              "ECC.2.26"
            ]
          }
        }
      ]
    }
  ],
