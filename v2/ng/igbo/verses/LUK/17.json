{
  "id": "LUK.17",
  "number": "17",
  "bookId": "LUK",
  "reference": "Luk 17",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "17",
        "style": "c",
        "sid": "LUK 17"
      },
      "items": [
        {
          "text": "17",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmehie na okwukwe na ije ozi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "LUK 17:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ndị na-eso ụzọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ihe ndị nke na-eme ka mmadụ jehie aghaghị ịdị, ma ahụhụ ga-adịrị onye ọbụla ọnọdụ ndị a ga-esi nʼaka ya bịa.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.1",
                "verseOrgIds": [
                  "LUK.17.1"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.1",
            "verseOrgIds": [
              "LUK.17.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "LUK 17:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ ga-akara gị mma ka e kenye gị nkume igwe nri nʼolu, tụnye gị nʼime oke osimiri, karịa na ị ga-eduhie otu nʼime ụmụntakịrị ndị a ụzọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.2",
                "verseOrgIds": [
                  "LUK.17.2"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.2",
            "verseOrgIds": [
              "LUK.17.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "LUK 17:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Kpachapụrụnụ onwe unu anya!",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:3"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na nwanna gị e mejọọ gị, baara ya mba. Ọ bụrụ na o chegharịa, gbaghara ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.3",
                "verseOrgIds": [
                  "LUK.17.3"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.3",
            "verseOrgIds": [
              "LUK.17.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "LUK 17:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bụrụkwa na o mejọọ gị ugboro asaa nʼotu ụbọchị, rịọkwa gị ugboro asaa sị, 'E chegharịala m,' ị ghaghị ịgbaghara ya.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.4",
                "verseOrgIds": [
                  "LUK.17.4"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "LUK 17:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ozi ya sịrị ya, \"Onyenwe anyị, mee ka okwukwe anyị dị ukwuu!\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.5",
            "verseOrgIds": [
              "LUK.17.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "LUK 17:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onyenwe anyị zara,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.6",
            "verseOrgIds": [
              "LUK.17.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụrụ na unu nwere okwukwe nke ha ka mkpụrụ mọstaadị, unu nwere ike ị sị osisi ukwu a, Ka e site na mgbọrọgwụ hopu gị ma kụọkwa gị nʼime oke osimiri, ọ ga-erubere unu isi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.6",
                "verseOrgIds": [
                  "LUK.17.6"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "LUK 17:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụ onye nʼime unu nke nwere ohu onye si ebe ọ gara rụọ ọrụ maọbụ ịzụ atụrụ lọbata, ga-asị ya, 'Mee ngwangwa nọdụ ala rie nri'?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.7",
                "verseOrgIds": [
                  "LUK.17.7"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.7",
            "verseOrgIds": [
              "LUK.17.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "LUK 17:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ gaghị asị ya, 'Siere m nri ọsịịsọ, kwadoo onwe gị jere m ozi ka m na-eri na aṅụkwa ihe ọṅụṅụ; emesịa ị ga-eri nri ma ṅụọ ihe ọṅụṅụ nke gị'?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.8",
                "verseOrgIds": [
                  "LUK.17.8"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.8",
            "verseOrgIds": [
              "LUK.17.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "LUK 17:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ ga-ekele ohu ahụ nʼihi na ọ rụrụ ọrụ o kwesiri ịrụ?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.9",
                "verseOrgIds": [
                  "LUK.17.9"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.9",
            "verseOrgIds": [
              "LUK.17.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "LUK 17:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼotu aka ahụ, mgbe unu rụchara ọrụ niile unu kwesiri ịrụ, ihe unu ga-ekwu bụ, 'Anyị bụ ụmụ ohu na-ekwesighị ekwesi, anyị emeela ihe anyị kwesiri ime.' \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.10",
                "verseOrgIds": [
                  "LUK.17.10"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgwụgwọ ndị ekpenta iri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "LUK 17:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ọ na-aga Jerusalem, o sitere nʼụzọ dị nʼagbata Sameria na Galili.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.11",
            "verseOrgIds": [
              "LUK.17.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "LUK 17:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ banyere nʼotu obodo nta, ndị ekpenta iri sitere nʼebe dị anya zute ya.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.12",
            "verseOrgIds": [
              "LUK.17.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "LUK 17:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha tiri mkpu nʼoke olu sị, \"Jisọs nna anyị ukwuu, mere anyị ebere.\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.13",
            "verseOrgIds": [
              "LUK.17.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "LUK 17:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hụrụ ha, ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Gaanụ gosi ndị nchụaja onwe unu.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.14",
                "verseOrgIds": [
                  "LUK.17.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Dị ka ha na-aga, e mere ka ha dị ọcha.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.14",
            "verseOrgIds": [
              "LUK.17.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "LUK 17:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe otu nʼime ha chọpụtara na a gwọọla ya, ọ laghachiri azụ, jiri oke olu na-eto Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.15",
            "verseOrgIds": [
              "LUK.17.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "LUK 17:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dara nʼala nʼụkwụ ya, kelee ya. Ọ bụ onye Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.16",
            "verseOrgIds": [
              "LUK.17.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "LUK 17:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jisọs jụrụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọ bụghị mmadụ iri ka e mere ka ha dị ọcha, ebeekwanụ ka itoolu ndị ọzọ nọ?",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.17",
                "verseOrgIds": [
                  "LUK.17.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.17",
            "verseOrgIds": [
              "LUK.17.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "LUK 17:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ọ bu naanị onye mba ọzọ a lọghachiri inye Chineke otuto?\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.18",
                "verseOrgIds": [
                  "LUK.17.18"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.18",
            "verseOrgIds": [
              "LUK.17.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "LUK 17:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.19",
            "verseOrgIds": [
              "LUK.17.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Bilie, laa, okwukwe gị agwọọla gị.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.19",
                "verseOrgIds": [
                  "LUK.17.19"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọbịbịa nke alaeze Chineke",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "LUK 17:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ndị Farisii jụrụ ya sị, Olee mgbe alaeze Chineke ga-abịa? O kwuru,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ọbịbịa alaeze Chineke agaghị a bụ nʼụzọ a ga-eji anya efu hụ ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.20",
                "verseOrgIds": [
                  "LUK.17.20"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.20",
            "verseOrgIds": [
              "LUK.17.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "LUK 17:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ha agaghịkwa asị, 'Lee, ọ nọ nʼebe a,' maọbụ, 'nʼebe ahụ,' nʼihi nʼezie, alaeze Chineke nọ nʼetiti unu. \"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.21",
                "verseOrgIds": [
                  "LUK.17.21"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "LUK 17:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ọ gwara ndị na-eso ụzọ ya,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Oge na-abịa mgbe ọ ga-agụsi unu agụụ ike ịhụ otu nʼime ụbọchị nke Nwa nke Mmadụ, ma unu agaghị ahụ ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.22",
                "verseOrgIds": [
                  "LUK.17.22"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.22",
            "verseOrgIds": [
              "LUK.17.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "LUK 17:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ha ga-asị unu, 'Lee, nʼebe ahụ,' maọbụ, 'Lee, nʼebe a,' unu agala, unu esokwala ha.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.23",
                "verseOrgIds": [
                  "LUK.17.23"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.23",
            "verseOrgIds": [
              "LUK.17.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "LUK 17:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼihi na Nwa nke Mmadụ nʼụbọchị ya ga-adị ka amụma nke eluigwe nke na-enye ìhè na mbara eluigwe site nʼotu ebe ruo nʼebe nke ọzọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.24",
                "verseOrgIds": [
                  "LUK.17.24"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.24",
            "verseOrgIds": [
              "LUK.17.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "LUK 17:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma ọ ghaghị ibu ụzọ hụọ ọtụtụ ahụhụ, ọgbọ a ga-ajụkwa ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.25",
                "verseOrgIds": [
                  "LUK.17.25"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "LUK 17:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dị ka ọ dị nʼụbọchị Noa, otu a ka ọ ga-adịkwa nʼụbọchị Nwa nke Mmadụ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.26",
                "verseOrgIds": [
                  "LUK.17.26"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.26",
            "verseOrgIds": [
              "LUK.17.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "LUK 17:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ha nọ na-eri na-aṅụ, na-alụ nwunye na-ekekwa ụmụ ha di, ruo mgbe Noa banyere nʼụgbọ mmiri. Oke iju mmiri ahụ bịakwara laa ha nʼiyi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.27",
                "verseOrgIds": [
                  "LUK.17.27"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "LUK 17:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Otu a ka ọ dịkwa nʼoge Lọt. Ha nọ na-eri, na-aṅụ, na-azụrịtakwa ahịa, na-akụ mkpụrụ, na-arụkwa ụlọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.28",
                "verseOrgIds": [
                  "LUK.17.28"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.28",
            "verseOrgIds": [
              "LUK.17.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "LUK 17:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ma nʼụbọchị ahụ Lọt si nʼobodo Sọdọm pụta, ọkụ na nkume dị ọkụ sitere nʼeluigwe zoo ka mmiri, laa ha niile nʼiyi.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.29",
                "verseOrgIds": [
                  "LUK.17.29"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "LUK 17:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Otu a ka ọ ga-adịkwa nʼụbọchị a ga-eme ka Nwa nke Mmadụ pụta ìhè.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.30",
                "verseOrgIds": [
                  "LUK.17.30"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.30",
            "verseOrgIds": [
              "LUK.17.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "LUK 17:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Nʼụbọchị ahụ, onye ọbụla nọ nʼelu ụlọ, ma ihe ya dị nʼime ụlọ, arịtukwala ịba nʼime ụlọ iburu ngwongwo ndị ahụ. Nʼotu aka ahụ, onye ọbụla nọ nʼubi, ya ghara ịlọghachita.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.31",
                "verseOrgIds": [
                  "LUK.17.31"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.31",
            "verseOrgIds": [
              "LUK.17.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "LUK 17:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Chetakwanụ nwunye Lọt.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.32",
                "verseOrgIds": [
                  "LUK.17.32"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.32",
            "verseOrgIds": [
              "LUK.17.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "LUK 17:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Onye ọbụla chọrọ iche ndụ ya nche ka ọ ga-efunarị, ma onye ọbụla na-atụfu ndụ ya ga-echebe ya.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.33",
                "verseOrgIds": [
                  "LUK.17.33"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.33",
            "verseOrgIds": [
              "LUK.17.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "LUK 17:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Asị m unu, nʼanyasị ahụ mmadụ abụọ ga-edina nʼotu akwa, a ga-ewepụ otu nʼime ha hapụ onye nke ọzọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.34",
                "verseOrgIds": [
                  "LUK.17.34"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.34",
            "verseOrgIds": [
              "LUK.17.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "LUK 17:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ụmụ nwanyị abụọ ga na-akwọ ọka nʼotu ebe, a ga-ewere otu ma hapụ nke ọzọ.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.35",
                "verseOrgIds": [
                  "LUK.17.35"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.35",
            "verseOrgIds": [
              "LUK.17.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "LUK 17:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Ụmụ nwoke abụọ ga-anọ nʼubi, a ga-ewere otu onye hapụ nke ọzọ.",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.36",
                "verseOrgIds": [
                  "LUK.17.36"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "LUK 17:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha jụrụ ya sị, \"Olee ebe, Onyenwe anyị?\"",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "LUK 17:37"
      },
      "items": [
        {
          "text": "Ọ sịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "LUK.17.37",
            "verseOrgIds": [
              "LUK.17.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ebe ọbụla ozu dị, ka udele na-ezukọta.\"",
              "type": "text",
              "attrs": {
                "verseId": "LUK.17.37",
                "verseOrgIds": [
                  "LUK.17.37"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
