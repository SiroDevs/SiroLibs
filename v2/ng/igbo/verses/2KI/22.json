  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "22",
        "style": "c",
        "sid": "2KI 22"
      },
      "items": [
        {
          "text": "22",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwụkwọ iwu a chọtara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 22:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Afọ asatọ ka Josaya gbara mgbe ọ malitere ịbụ eze Juda. Iri afọ atọ na otu ka ọ chịrị na Jerusalem. Aha nne ya bụ Jedida, nwa Adaya onye Bozkat.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.1",
            "verseOrgIds": [
              "2KI.22.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 22:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.2",
                "verseOrgIds": [
                  "2KI.22.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", gbasookwa ụzọ niile nke nna nna ya Devid kpamkpam, o sighị nʼụzọ a wezuga onwe ya gaa nʼaka nri maọbụ nʼaka ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.2",
            "verseOrgIds": [
              "2KI.22.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 22:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri na asatọ nke ọchịchị ya, eze Josaya, zigara ode akwụkwọ bụ Shefan nwa Azalaya, onye bụkwa nwa nwa Meshulam, ka ọ gaa nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.3",
            "verseOrgIds": [
              "2KI.22.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.3",
                "verseOrgIds": [
                  "2KI.22.3"
                ]
              }
            }
          ]
        },
        {
          "text": ". Ọ sịrị ya,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.3",
            "verseOrgIds": [
              "2KI.22.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 22:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gakwuru Hilkaya onyeisi nchụaja, sị ya, gụkọta ego nke e webatara nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.4",
                "verseOrgIds": [
                  "2KI.22.4"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ nke ndị na-eche ọnụ ụzọ nakọtara site nʼaka ndị mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.4",
            "verseOrgIds": [
              "2KI.22.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 22:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwa ha ka ha nyefee ya nʼaka ndị ikom ahọpụtara maka ilekọta ọrụ nʼụlọnsọ ahụ. Ka ndị ikom a kwụọ ndị ọrụ na-arụzi ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.5",
                "verseOrgIds": [
                  "2KI.22.5"
                ]
              }
            }
          ]
        },
        {
          "text": "ụgwọ ọrụ,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.5",
            "verseOrgIds": [
              "2KI.22.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 22:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ya bụ, inye ya ndị ọkpọ ǹtu, ndị na-ewu ụlọ, na ndị na-edo nkume ụlọ. Ha jirikwa ego ahụ zụta osisi na nkume a wara awa, maka i ji dozie ụlọnsọ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.6",
            "verseOrgIds": [
              "2KI.22.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 22:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mkpa ka ha gụzie otu ha si mefuo ego nke e nyefere ha nʼaka, nʼihi na ọrụ ha egosila na ha kwesiri ntụkwasị obi.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.7",
            "verseOrgIds": [
              "2KI.22.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 22:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkaya onyeisi nchụaja, sịrị Shefan ode akwụkwọ, \"Achọtala m Akwụkwọ Iwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "text": "nʼime ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.8",
                "verseOrgIds": [
                  "2KI.22.8"
                ]
              }
            }
          ]
        },
        {
          "text": ".\" O nyere ya Shefan, onye nke gụkwara ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.8",
            "verseOrgIds": [
              "2KI.22.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 22:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Shefan, bụ ode akwụkwọ, bịakwutere eze, gwa ya sị, \"Ndị ozi gị enyefela ego niile nke dị nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.9",
                "verseOrgIds": [
                  "2KI.22.9"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼaka ndị ọrụ na nʼaka ndị nlekọta nọ nʼụlọnsọ Onyenwe anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.9",
            "verseOrgIds": [
              "2KI.22.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 22:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Shefan bụ ode akwụkwọ, gwara eze sị, \"O nwere akwụkwọ Hilkaya, onye nchụaja nyere m.\" Shefan gụpụtara ihe dị nʼakwụkwọ a nʼihu eze.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.10",
            "verseOrgIds": [
              "2KI.22.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 22:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze nụrụ okwu niile dị nʼime Akwụkwọ Iwu ahụ, ọ dọwara uwe ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.11",
            "verseOrgIds": [
              "2KI.22.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 22:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nyere Hilkaya bụ onyeisi nchụaja, Ahikam nwa Shefan, Akboa nwa Mikaya, Shefan ode akwụkwọ na Asaya, bụ onye ọrụ eze, iwu, sị ha,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.12",
            "verseOrgIds": [
              "2KI.22.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 22:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaanụ jụta",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.13",
                "verseOrgIds": [
                  "2KI.22.13"
                ]
              }
            }
          ]
        },
        {
          "text": "ase, nʼisi m na nʼisi ndị m, na Juda niile, banyere ihe niile e dere nʼakwụkwọ a nke a chọtara. Nʼihi na ọnụma",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.13",
                "verseOrgIds": [
                  "2KI.22.13"
                ]
              }
            }
          ]
        },
        {
          "text": "dị ukwuu bụ nke na-ere ọkụ megide anyị, nʼihi na ndị bu anyị ụzọ erubeghị isi nʼokwu nke akwụkwọ iwu a, ha agbasoghị ihe niile e dere nʼime ya banyere anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.13",
            "verseOrgIds": [
              "2KI.22.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 22:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hilkaya onye nchụaja, Ahikam, Akboa, Shefan na Asaya, jekwuuru Hulda, bụ onye amụma nwanyị. Onye bụ nwunye Shalum, nwa Tikva, nwa Hahas, ọ bụ onye na-elekọta uwe. Hulda na-ebi na mpaghara Jerusalem e wuru ọhụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.14",
            "verseOrgIds": [
              "2KI.22.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 22:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị ha, \"Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.15",
            "verseOrgIds": [
              "2KI.22.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.15",
                "verseOrgIds": [
                  "2KI.22.15"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke nke Izrel kwuru: Gwanụ nwoke ahụ ziri unu ka unu bịakwutem, sị,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.15",
            "verseOrgIds": [
              "2KI.22.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 22:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "'Otu a ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.16",
            "verseOrgIds": [
              "2KI.22.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.16",
                "verseOrgIds": [
                  "2KI.22.16"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ekwu: Ana m aga iweta mbibi ga-adakwasị ebe a na ndị niile bi nʼime ya, dịka ihe niile e dere nʼime akwụkwọ nke eze Juda gụrụ, si dị.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.16",
            "verseOrgIds": [
              "2KI.22.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 22:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ha ajụla m, gbakụta m azụ, chụọ aja nsure ọkụ na-esi isi ụtọ nye chi ndị ọzọ, kpasuo m iwe site na arụsị niile nke aka ha mepụtara. Iwe m ga-adị ọkụ megide ebe a, ọ gaghị akwụsịkwa.'",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.17",
            "verseOrgIds": [
              "2KI.22.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 22:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gwanụ eze Juda, onye ahụ zitere unu ịjụta ase site nʼọnụ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.18",
            "verseOrgIds": [
              "2KI.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.18",
                "verseOrgIds": [
                  "2KI.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": "sị ya, 'Ihe ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.18",
            "verseOrgIds": [
              "2KI.22.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.22.18",
                "verseOrgIds": [
                  "2KI.22.18"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke Izrel na-ekwu banyere okwu ndị ahụ ị nụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.22.18",
            "verseOrgIds": [
