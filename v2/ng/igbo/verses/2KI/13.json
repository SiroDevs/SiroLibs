  "verseCount": 25,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "13",
        "style": "c",
        "sid": "2KI 13"
      },
      "items": [
        {
          "text": "13",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoahaz eze Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 13:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke iri abụọ na atọ nke ọchịchị eze Joash nwa Ahazaya na Juda, ka Jehoahaz nwa Jehu malitere ịbụ eze nʼIzrel nʼobodo Sameria. Ọ chịkwara na Sameria afọ iri na asaa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.1",
            "verseOrgIds": [
              "2KI.13.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 13:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Kama Jehoahaz bụ eze ọjọọ. O mere ihe jọrọ njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.2",
                "verseOrgIds": [
                  "2KI.13.2"
                ]
              }
            }
          ]
        },
        {
          "text": ". O soro ụzọ ọjọọ niile nke Jeroboam nwa Nebat, onye dubara ndị Izrel na mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.2",
            "verseOrgIds": [
              "2KI.13.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 13:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, iwe were",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.3",
                "verseOrgIds": [
                  "2KI.13.3"
                ]
              }
            }
          ]
        },
        {
          "text": "nke ukwuu megide Izrel. O mere ka ha nọrọ nʼokpuru ọchịchị Hazael eze Aram na Ben-Hadad nwa ya ogologo oge.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.3",
            "verseOrgIds": [
              "2KI.13.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 13:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Jehoahaz kpere ekpere rịọọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼoge a ka o nyere ya aka,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.4",
                "verseOrgIds": [
                  "2KI.13.4"
                ]
              }
            }
          ]
        },
        {
          "text": "gere ya ntị, nʼihi na Chineke hụrụ mmegbu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "text": "nke eze Aram na-emegbu ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.4",
            "verseOrgIds": [
              "2KI.13.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 13:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.5",
                "verseOrgIds": [
                  "2KI.13.5"
                ]
              }
            }
          ]
        },
        {
          "text": "họpụtaara Izrel onye nzọpụta, ha sitere nʼaka ike ndị Aram nwere onwe ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "text": "Izrel biri nʼụlọ nke aka ha dịka ha biiri nʼoge gara aga.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.5",
            "verseOrgIds": [
              "2KI.13.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 13:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ha esighị na mmehie niile nke ụlọ Jeroboam wezuga onwe ha, bụ nke o jiri mee ka Izrel mehie, kama ha nọ na-ejegharị nʼime ha. Ọzọkwa, ogidi Ashera ka guzoro na Sameria.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.6",
            "verseOrgIds": [
              "2KI.13.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 13:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị ihe fọdụrụ na ndị agha Jehoahaz ma ọ bụghị naanị iri ndị agha ise na-agba ịnyịnya, na ụgbọ agha iri, na puku ndị agha iri. Nʼihi na eze Aram alaala ndị nke fọdụrụ nʼiyi, meekwa ka ha dịrị ka uzuzu mgbe a na-azọcha mkpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.7",
            "verseOrgIds": [
              "2KI.13.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 13:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ gbasara ọchịchị Jehoahaz, na ihe niile o mere, na ihe ọ rụpụtara, e deghị ha nʼakwụkwọ akụkọ ihe ndị eze Izrel mere nʼoge ha?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.8",
            "verseOrgIds": [
              "2KI.13.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 13:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahaz sooro ndị nna nna ya ha dina nʼọnwụ, e lie ya na Sameria. Nwa ya Jehoash nọchiri anya ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.9",
            "verseOrgIds": [
              "2KI.13.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoash eze Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 13:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ iri atọ na asaa nke ịbụ eze Joash na Juda, ka Jehoash nwa Jehoahaz malitere ị bụ eze Izrel na Sameria. Ọ chịrị afọ iri na isii.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.10",
            "verseOrgIds": [
              "2KI.13.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 13:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe jọrọ njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.11",
                "verseOrgIds": [
                  "2KI.13.11"
                ]
              }
            }
          ]
        },
        {
          "text": ". O siteghị na mmehie Jeroboam nwa Nebat wezuga onwe ya, mmehie nke Jeroboam dubara Izrel ime. Jehoash nọgidere nʼime ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.11",
            "verseOrgIds": [
              "2KI.13.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 13:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akụkọ gbasara ọchịchị Jehoash, na ihe niile o mere, na ihe ọ rụpụtara, tinyere agha o buru megide Amazaya eze Juda, e deghị ha nʼakwụkwọ akụkọ ihe ndị eze Izrel mere nʼoge ha?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.12",
            "verseOrgIds": [
              "2KI.13.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 13:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoash soro nna nna ya ha dina nʼọnwụ, Jeroboam anọchie nʼocheeze ya. E liri Jehoash na Sameria, nʼebe e liri ndị eze Izrel ndị ibe ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.13",
            "verseOrgIds": [
              "2KI.13.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 13:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge a, Ịlaisha nọ nʼọrịa nke ọ ga-esite na ya anwụ. Jehoash, bụ eze Izrel gara ịhụ ya, ọ kwara akwa mgbe ọ hụrụ ya sị, \"Nna m, nna m, usuu ụgbọ agha na usuu ndị na-agba ịnyịnya Izrel!\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.14",
            "verseOrgIds": [
              "2KI.13.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 13:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha gwara ya okwu sị, \"Wepụta ụta na àkụ ụfọdụ.\" O mere dịka Ịlaisha gwara ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.15",
            "verseOrgIds": [
              "2KI.13.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 13:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha gwakwara eze Izrel okwu sị ya, \"Jide ụta ahụ nʼaka gị abụọ.\" Mgbe o jidere ụta ahụ Ịlaisha tụkwasịrị aka nke ya nʼaka eze.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.16",
            "verseOrgIds": [
              "2KI.13.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 13:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịlaisha gwara ya sị, \"Meghee oghereikuku ahụ chere ihu nʼọwụwa anyanwụ.\" O meghere ya. Mgbe ahụ Ịlaisha gwara ya sị, \"Gbapụ àkụ.\" Eze gbapụrụ àkụ. Ịlaisha kwuru sị, \"Àkụ mmeri",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.17",
                "verseOrgIds": [
                  "2KI.13.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", àkụ mmeri megide Aram. Ị ga-ebibi ndị Aram kpamkpam nʼAfek.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.17",
            "verseOrgIds": [
              "2KI.13.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 13:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ sịrị, \"Chilite àkụ ndị ahụ,\" ọ chilitere ha. Ịlaisha gwara eze Izrel, \"Gbaa ha nʼala.\" Ọ gbara ha nʼala ugboro atọ, ma kwụsị.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.18",
            "verseOrgIds": [
              "2KI.13.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 13:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma onye nke Chineke ahụ were iwe sị ya, \"Ị gaara apịa ya nʼala ugboro ise maọbụ isii. Mgbe ahụ, ị gaara enwe ike merie ndị Aram bibie ha kpamkpam. Ma ugbu a, ọ bụ naanị ugbo atọ ka ị ga-emeri ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.19",
            "verseOrgIds": [
              "2KI.13.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 13:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Ịlaisha nwụrụ. E likwara ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 13:20"
      },
      "items": [
        {
          "text": "Nʼoge ahụ, ọtụtụ ndị na-apụnara mmadụ ihe nʼike na-esi nʼala ndị Moab na-abịa nʼala Izrel izu ohi site nʼọnwa nke atọ nʼafọ ọhụrụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.20",
            "verseOrgIds": [
              "2KI.13.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 13:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụbọchị, mgbe ụfọdụ ndị ikom na-eli otu nwoke nwụrụ anwụ, ha hụrụ ndị a na-apụnara mmadụ ihe nʼike. Nʼihi nke a, ha mere ngwangwa site nʼụjọ tụbanye nwoke ahụ nʼili Ịlaisha. Mgbe ozu nwoke ahụ dara metụ ọkpụkpụ Ịlaisha ahụ, nwoke ahụ nwụrụ anwụ megharịrị ahụ bilie, guzo nʼụkwụ ya abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.21",
            "verseOrgIds": [
              "2KI.13.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 13:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Hazael, eze Aram, busoro Izrel agha ụbọchị niile nke ndụ Jehoahaz eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.22",
            "verseOrgIds": [
              "2KI.13.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 13:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.13.23",
                "verseOrgIds": [
                  "2KI.13.23"
                ]
              }
            }
          ]
        },
        {
          "text": "meere ha amara, nwee ọmịiko nʼebe ha nọ, ma gosikwa ha na ihe banyere ha na-emetụ ya nʼobi nʼihi ọgbụgba ndụ ya na Ebraham na Aịzik na Jekọb. Ruo taa, o kweghị ka e bibie ha, maọbụ ka e site nʼihu ya chụpụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.23",
            "verseOrgIds": [
              "2KI.13.23"
            ]
          }
        }
