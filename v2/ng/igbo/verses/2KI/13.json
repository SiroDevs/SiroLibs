          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa, Hazael eze Aram nwụrụ, Ben-Hadad nwa ya nọchikwara nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.24",
            "verseOrgIds": [
              "2KI.13.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 13:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoash nwa Jehoahaz, weghachitere obodo niile nke ọ naara nʼaka nna ya Jehoahaz site nʼaka Ben-Hadad nwa Hazael. Ugboro atọ ka Jehoash meriri ya, site otu a weghachi obodo niile nke Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.13.25",
            "verseOrgIds": [
              "2KI.13.25"
            ]
          }
        }
