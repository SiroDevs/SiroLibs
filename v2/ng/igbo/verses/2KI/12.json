        },
        {
          "text": "Ndị ozi ya gbara izu ọjọọ megide Joash, gbukwaa ya na Bet Milo, nʼụzọ e si aga Sila.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.12.20",
