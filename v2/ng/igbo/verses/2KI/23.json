  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "23",
        "style": "c",
        "sid": "2KI 23"
      },
      "items": [
        {
          "text": "23",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọgbụgba ndụ eze na ndị Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 23:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze zigara ozi kpọkọta ndị okenye Juda na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.1",
            "verseOrgIds": [
              "2KI.23.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 23:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gara nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.2",
                "verseOrgIds": [
                  "2KI.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ya na ndị ikom Juda niile, ndị niile bi na Jerusalem, na ndị nchụaja, na ndị amụma niile, na ndị mmadụ niile, site nʼonye nta ruo na onye ukwu. Ọ gụpụtara na ntị onye ọbụla okwu niile si nʼakwụkwọ ọgbụgba ndụ ahụ, bụ nke achọtara nʼime ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.2",
                "verseOrgIds": [
                  "2KI.23.2"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.2",
            "verseOrgIds": [
              "2KI.23.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 23:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze guzoro nʼakụkụ ogidi, kwee nkwa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.3",
                "verseOrgIds": [
                  "2KI.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", ịgbaso",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.3",
                "verseOrgIds": [
                  "2KI.23.3"
                ]
              }
            }
          ]
        },
        {
          "text": ", na iji obi ya niile, na mkpụrụobi ya niile, debe ihe niile o nyere nʼiwu, nʼihe ama ya niile na ụkpụrụ ya niile. O si otu a mee ka okwu niile nke ọgbụgba ndụ ahụ e dere nʼakwụkwọ guzosie ike. Mgbe ahụ, ndị mmadụ niile kwekwara nkwa idebe ọgbụgba ndụ ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.3",
            "verseOrgIds": [
              "2KI.23.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 23:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze nyere Hilkaya onyeisi nchụaja na ndị nchụaja na-esote nʼọkwa, na ndị na-eche ọnụ ụzọ mbata, iwu ka ha site nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.4",
                "verseOrgIds": [
                  "2KI.23.4"
                ]
              }
            }
          ]
        },
        {
          "text": "kwapụtasịa ngwongwo niile e mere nye Baal, na Ashera, na usuu ihe niile nke mbara eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "text": "O sunyere ha niile ọkụ nʼazụ Jerusalem, nʼọhịa dị na Ndagwurugwu Kidrọn, buru ntụ ha bulaa Betel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.4",
            "verseOrgIds": [
              "2KI.23.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 23:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chụdara ndị nchụaja arụsị ndị ahụ niile, bụ ndị eze Juda họpụtara isure ihe na-esi isi ụtọ nʼelu ebe dị elu nke obodo Juda nakwa ebe dị ọkụ. Nʼihi na ndị nchụaja ndị a achụọla aja, surekwaa ihe nsure ọkụ na-esi isi ụtọ nʼebe ịchụ aja dị nʼelu ugwu niile dị nʼobodo dị iche iche na Juda, nakwa ndị dị gburugburu Jerusalem. Ha bụ ndị surere ihe nsure ọkụ na-esi isi ụtọ nye Baal, na anyanwụ, ọnwa na kpakpando, nyekwa usuu niile nke mbara eluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.5",
            "verseOrgIds": [
              "2KI.23.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 23:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sikwa nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.6",
                "verseOrgIds": [
                  "2KI.23.6"
                ]
              }
            }
          ]
        },
        {
          "text": "bupụ ogidi chi Ashera,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "text": "wezuga ya nʼazụ Jerusalem, na Ndagwurugwu Kidrọn. Ebe ahụ ka ọ nọ suo ya ọkụ, supịa ya ka ọ ghọọ ntụ, fesaa ya nʼebe a na-eli ndị mmadụ efu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.6",
            "verseOrgIds": [
              "2KI.23.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 23:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ kwadakwara ụlọ obibi ụmụ ndị ikom na-agba akwụna dị nọ nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.7",
                "verseOrgIds": [
                  "2KI.23.7"
                ]
              }
            }
          ]
        },
        {
          "text": ". Nʼebe ndị inyom na-anọ na-akpara Ashera akwa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.7",
            "verseOrgIds": [
              "2KI.23.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 23:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka ndị nchụaja niile site nʼobodo Juda niile bịa, o merụkwara ebe ịchụ aja niile nke dị elu, site na Geba ruo Bịasheba, ebe ndị nchụaja ndị a nọrọ suree ihe nsure ọkụ na-esi isi ụtọ. Ọ kwatụrụ ọnụ ụzọ ama nke dị nʼebe ọnụ ụzọ ama Joshua, onye bụ gọvanọ obodo, nke dị nʼakụkụ aka ekpe nke ọnụ ụzọ ama obodo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.8",
            "verseOrgIds": [
              "2KI.23.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 23:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma e kweghị ka ndị nchụaja ahụ jee ozi nʼụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.9",
                "verseOrgIds": [
                  "2KI.23.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dị na Jerusalem, ma o nyere ha ike iso ndị nchụaja ndị ọzọ rie achịcha a na-ejighị ihe na-eko achịcha mee.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.9",
            "verseOrgIds": [
              "2KI.23.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 23:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya merụrụ Tofet, laa ya nʼiyi. Tofet bụ ebe ịchụ aja dị na Ndagwurugwu nke Ben Hinom. O mere nke a igbochi mmadụ ọbụla iji nwa ya nwoke, maọbụ nwa ya nwanyị chụọrọ chi Molek aja nsure ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.10",
            "verseOrgIds": [
              "2KI.23.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 23:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "O sitere nʼọnụ ụzọ ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.11",
                "verseOrgIds": [
                  "2KI.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "wepụ ịnyịnya ndị ahụ ndị eze Juda doro nsọ nye anyanwụ. Ịnyịnya ndị a dị nʼogige ụlọnsọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.11",
                "verseOrgIds": [
                  "2KI.23.11"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼebe dị nso nʼụlọ onyeozi aha ya bụ Netan-Melek. Josaya kpọrọ ụgbọ agha ndị a niile e doro nsọ nye anyanwụ ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.11",
            "verseOrgIds": [
              "2KI.23.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 23:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya kwadara ebe ịchụ aja niile nke ndị eze Juda wukwasịrị nʼelu ụlọeze, nʼelu elu ụlọ Ehaz. Ọ kwadakwara ebe ịchụ aja niile nke Manase wuru nʼime ogige abụọ nke ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.12",
                "verseOrgIds": [
                  "2KI.23.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", kporo ha kpofuo nʼime Ndagwurugwu Kidrọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.12",
            "verseOrgIds": [
              "2KI.23.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 23:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze merụkwara ebe ịchụ aja niile dị nʼakụkụ ọwụwa anyanwụ obodo Jerusalem nʼakụkụ ndịda nke Ugwu Mbibi, nke Solomọn eze Izrel wuru nye chi Ashtọret, ihe arụ ndị Saịdọn, na chi Kemosh, ihe arụ ndị Moab, na chi Molek, ihe arụ ụmụ Amọn.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.13",
            "verseOrgIds": [
              "2KI.23.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 23:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya kwadakwara ogidi nkume niile, gbutuo ihe arụsị Ashera niile, werekwa ọkpụkpụ ndị mmadụ wụsa nʼelu ala ahụ niile.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.14",
            "verseOrgIds": [
              "2KI.23.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 23:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya kwadakwara ogidi niile dị na Betel, nke Jeroboam nwa Nebat wuru mgbe o dubara ndị Izrel na mmehie. Ọ kwadara ebe ịchụ aja dị nʼebe ahụ, kụjisie nkume e doro nʼebe ahụ, gwerie ha dịka ntụ. Ọ kpọkwara arụsị Ashera ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.15",
            "verseOrgIds": [
              "2KI.23.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 23:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya legharịkwara anya gburugburu hụ ọtụtụ ili dị nʼelu ugwu. O ziri ndị ohu ya ka ha gaa chịpụtasịa ọkpụkpụ dị nʼili ahụ niile, kpọọ ha ọkụ nʼelu ebe ịchụ aja imerụ ya, dịka okwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.16",
                "verseOrgIds": [
                  "2KI.23.16"
                ]
              }
            }
          ]
        },
        {
          "text": "si dị, nke onye nke Chineke kwupụtara mgbe o buru amụma banyere ihe ndị a.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.16",
            "verseOrgIds": [
              "2KI.23.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 23:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Josaya jụrụ ndị guzo nʼebe ahụ ajụjụ sị, \"Ọ bụ ili onye bụ nke a?\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "2KI 23:17"
      },
      "items": [
        {
          "text": "Ndị ikom obodo ahụ zara sị, \"Ọ bụ ili onye nke Chineke ahụ si Juda bịa buo amụma megide ebe ịchụ aja Betel. O buru amụma na ihe ndị a ị na-eme ebe ịchụ aja a ga-emezu.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.17",
            "verseOrgIds": [
              "2KI.23.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 23:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Josaya zara sị ha, \"Hapụnụ ya ka o guzoro onwe ya. Ka nwoke ọbụla gharakwa ịchịpụta ọkpụkpụ ya.\" Ha hapụrụ ọkpụkpụ ya, hapụkwa ọkpụkpụ onye amụma ahụ si Sameria bịa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.18",
            "verseOrgIds": [
              "2KI.23.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 23:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka o mere na Betel, otu a ka Josaya wepụrụ ma merụkwaa ebe ịchụ aja niile dị nʼebe niile dị elu nke ndị eze Izrel wuru nʼobodo niile nke Sameria, bụ ebe ịchụ aja kpasuru",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.19",
                "verseOrgIds": [
                  "2KI.23.19"
                ]
              }
            }
          ]
        },
        {
          "text": "iwe.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.19",
            "verseOrgIds": [
              "2KI.23.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 23:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "O gburu ndị nchụaja chi ndị a niile nʼelu ebe ịchụ aja ha, suo ọkpụkpụ ha ọkụ nʼelu ebe ịchụ aja ha. Mgbe o mesịrị ihe ndị a, ọ laghachiri na Jerusalem.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.20",
            "verseOrgIds": [
              "2KI.23.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "2KI 23:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze nyere ndị Juda niile iwu sị ha, \"Meerenụ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.21",
                "verseOrgIds": [
                  "2KI.23.21"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu Mmemme Ngabiga, dịka e dere ya nʼakwụkwọ ọgbụgba ndụ a.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.21",
            "verseOrgIds": [
              "2KI.23.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "2KI 23:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O nwebeghị mgbe e mere ụdị Mmemme Ngabiga dịka nke a nʼoge ọbụla, site nʼụbọchị ndị ikpe bụ ndị duru Izrel maọbụ nʼụbọchị ndị eze Izrel na eze niile chịrị Juda, ọ dịghị nke yiri Mmemme Ngabiga a.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.22",
            "verseOrgIds": [
              "2KI.23.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "2KI 23:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ bụ nʼafọ nke iri na asatọ nke ọchịchị eze Josaya, nʼime Jerusalem ka a nọ mee Mmemme Ngabiga a nye",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.23",
                "verseOrgIds": [
                  "2KI.23.23"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.23",
            "verseOrgIds": [
              "2KI.23.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "2KI 23:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, Josaya gara nʼihu kpochapụ ndị niile na-ajụta mmụọ ọjọọ ase, na ndị dibịa afa, na arụsị",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "text": "ezinaụlọ dị iche iche, na arụsị a pịrị apị, na ihe arụ niile nke a hụrụ nʼime Juda na Jerusalem niile. O mere nke a ka e mezuo ihe niile e dere nʼime akwụkwọ ahụ Hilkaya onye nchụaja chọtara nʼụlọ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.24",
                "verseOrgIds": [
                  "2KI.23.24"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.24",
            "verseOrgIds": [
              "2KI.23.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "2KI 23:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị eze ọzọ nʼime ndị niile buru ya ụzọ chịa nke dịka Josaya, onye chigharịkwutere",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.25",
                "verseOrgIds": [
                  "2KI.23.25"
                ]
              }
            }
          ]
        },
        {
          "text": ". Onye ji obi ya niile, na mmụọ ya niile na ike ya niile debe iwu niile e nyere Mosis.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        },
        {
          "text": "Ọ dịkwaghị eze ọzọ dịka ya, onye biliri mgbe ọ nwụsịrị.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.25",
            "verseOrgIds": [
              "2KI.23.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "2KI 23:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe ndị a emeghị ka iwe ọkụ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.26",
                "verseOrgIds": [
                  "2KI.23.26"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ewe megide Juda dajụọ, bụ iwe a kpasuru ya nʼihi ihe ọjọọ niile nke Manase mere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.26",
            "verseOrgIds": [
              "2KI.23.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "2KI 23:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere,",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.27",
                "verseOrgIds": [
                  "2KI.23.27"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Aga m ekpochapụ Juda niile site nʼihu m, dịka m si kpochapụ Izrel niile. Aga m ajụkwa obodo ahụ m họpụtara, bụ Jerusalem, jụkwa ụlọnsọ ukwu a nke m kwuru banyere ya sị, 'Nʼime ya ka Aha m ga-adị.' \"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.27",
            "verseOrgIds": [
              "2KI.23.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "2KI 23:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Josaya na ihe niile o mere, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ihe mere nʼoge ndị eze Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.28",
            "verseOrgIds": [
              "2KI.23.28"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "2KI 23:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge Josaya bụ eze, Fero Neko, eze Ijipt, gbagoro gaa nʼakụkụ osimiri Yufretis inyere eze Asịrịa aka. Eze Josaya pụkwara izute ya nʼagha, ma Neko zutere ya nʼagha, gbuo ya na Megido.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.29",
            "verseOrgIds": [
              "2KI.23.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "2KI 23:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-ejere Josaya ozi sị na Megido buru ozu ya nʼime ụgbọ agha bulata ya na Jerusalem, lie ya nʼili nke aka ya. Ndị ala ahụ kpọọrọ Jehoahaz nwa nwoke Josaya, tee ya mmanụ, mee ya eze nʼọnọdụ nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.30",
            "verseOrgIds": [
              "2KI.23.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Jehoahaz eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "2KI 23:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoahaz gbara iri afọ abụọ na atọ mgbe o bidoro ịchị, ma ọ chịrị na Jerusalem ọnwa atọ. Aha nne ya bụ Hamutal, nwa Jeremaya onye Libna.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.31",
            "verseOrgIds": [
              "2KI.23.31"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "2KI 23:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ihe dị njọ nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.23.32",
                "verseOrgIds": [
                  "2KI.23.32"
                ]
              }
            }
          ]
        },
        {
          "text": "dịka ndị eze buru ya ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.32",
            "verseOrgIds": [
              "2KI.23.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "2KI 23:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Fero Neko keere ya agbụ na Ribla nʼala Hamat, ime ka ọ ghara ịchịkwa na Jerusalem. Neko kwagidere ndị Juda ka ha tụọrọ ya ụtụ narị talenti ọlaọcha, na otu talenti ọlaedo.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.33",
            "verseOrgIds": [
              "2KI.23.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "2KI 23:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Fero Neko mere Eliakịm nwa nwoke Josaya, eze, nʼọnọdụ Josaya bụ nna ya. Ọ gụgharịrị aha Eliakịm ka ọ bụrụ Jehoiakim. Ma o duuru Jehoahaz gaa Ijipt, ebe ọ nọ nwụọ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.34",
            "verseOrgIds": [
              "2KI.23.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "2KI 23:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jehoiakim kwụrụ Fero Neko ọlaọcha na ọlaedo ahụ ọ nara nʼaka ya. Ka o nwee ike mee nke a, o kere ụtụ nʼala ahụ, werekwa ike nara ndị ala ahụ ọlaọcha na ọlaedo, dịka mkpebi ha si dị banyere ihe onye ahụ ga-akwụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.23.35",
            "verseOrgIds": [
              "2KI.23.35"
            ]
          }
        }
      ]
    },
