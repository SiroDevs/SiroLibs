          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ehaz eze Juda",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "2KI 16:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "text": "nwa Jotam, malitere ịbụ eze Juda nʼafọ nke iri na asaa nke ọchịchị eze Peka nwa Remalaya eze Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.1",
            "verseOrgIds": [
              "2KI.16.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "2KI 16:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz gbara iri afọ abụọ mgbe ọ malitere ịbụ eze. Afọ iri na isii ka ọ chịkwara nʼime Jerusalem, ma o meghị ihe ziri ezi nʼanya",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.2",
                "verseOrgIds": [
                  "2KI.16.2"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke ya, dịka nna ya Devid mere.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.2",
            "verseOrgIds": [
              "2KI.16.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "2KI 16:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gbasoro ụzọ niile nke ndị eze Izrel, ọbụladị i ji nwa ya nwoke chụọ aja nʼọkụ. Ọ gbasoro omenaala niile rụrụ arụ nke ndị mba ọzọ, ndị ahụ",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.3",
                "verseOrgIds": [
                  "2KI.16.3"
                ]
              }
            }
          ]
        },
        {
          "text": "chụpụrụ site nʼihu ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.3",
            "verseOrgIds": [
              "2KI.16.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "2KI 16:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chụrụ aja surekwaa ihe nsure ọkụ aja na-esi isi ụtọ nʼebe niile dị elu, nʼelu ugwu niile, na nʼokpuru osisi ndụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.4",
            "verseOrgIds": [
              "2KI.16.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "2KI 16:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Rezin eze Aram na Peka nwa Remalaya, eze Izrel rigooro ịga buso Jerusalem agha, gbakwaa Ehaz gburugburu. Ma ha emerighị ya nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.5",
            "verseOrgIds": [
              "2KI.16.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "2KI 16:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, Rezin eze Aram dọtaghachiri obodo Elat nye onwe ya, site na ị chụpụ ndị Juda bi nʼElat. Ndị Edọm bara nʼobodo Elat, ha bikwa nʼebe ahụ ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.6",
            "verseOrgIds": [
              "2KI.16.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "2KI 16:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz zigara ndị ozi ka ha gaa zie Tiglat-Pilesa, eze ndị Asịrịa ozi, sị ya, \"Abụ m ohu gị, onyenwe m ka ị bụ. Bịa napụta m site nʼaka eze ndị Aram na eze ndị Izrel, ndị na-ebuso m agha.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.7",
            "verseOrgIds": [
              "2KI.16.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "2KI 16:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz weere ọlaedo na ọlaọcha ahụtara nʼime ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.8",
                "verseOrgIds": [
                  "2KI.16.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", na nke dị nʼakụ niile dị nʼụlọeze zigara eze Asịrịa dịka onyinye.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.8",
            "verseOrgIds": [
              "2KI.16.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "2KI 16:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze ndị Asịrịa ṅara ya ntị site nʼibuso obodo Damaskọs agha na imeri ya. O gburu Rezin, bulaa mmadụ niile bi nʼime ya nʼike ka ha gaa biri nʼobodo Kia.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.9",
            "verseOrgIds": [
              "2KI.16.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "2KI 16:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze Ehaz gara Damaskọs izute Tiglat-Pilesa bụ eze Asịrịa. Ọ hụrụ otu ebe nchụaja nke dị na Damaskọs. O zigaara Ụraya onye nchụaja oyiyi ebe ịchụ aja ahụ. O dekwara ihe gbasara ya nʼakwụkwọ, nke ga-akọwa otu e si ewu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.10",
            "verseOrgIds": [
              "2KI.16.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "2KI 16:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, Ụraya onye nchụaja, wuru ebe ịchụ aja nke dị ka nke ahụ Ehaz hụrụ na Damaskọs. O wuchara ya tupu eze alọta.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.11",
            "verseOrgIds": [
              "2KI.16.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "2KI 16:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe eze si Damaskọs lọta na Juda, ọ hụrụ ebe ịchụ aja ahụ, bịaruo ya nso, doo onyinye ịchụ aja ya nʼelu ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.12",
            "verseOrgIds": [
              "2KI.16.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "2KI 16:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ chụrụ aja nsure ọkụ, na aja ihe nsure ọkụ na-esi isi ụtọ, na aja onyinye mkpụrụ ọka. Ọ wụkwasịrị onyinye ihe ọṅụṅụ nʼelu ebe ịchụ aja ahụ, fesakwa ọbara aja udo ya niile nʼelu ebe ịchụ aja ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.13",
            "verseOrgIds": [
              "2KI.16.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "2KI 16:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "O wepụrụ ebe ịchụ aja bronz nke dị nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.14",
                "verseOrgIds": [
                  "2KI.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", o sitere nʼebe ọ dị nʼihu ụlọnsọ ahụ, nʼetiti ebe ịchụ aja ọhụrụ na ụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.14",
                "verseOrgIds": [
                  "2KI.16.14"
                ]
              }
            }
          ]
        },
        {
          "text": ", bute ya nʼakụkụ ugwu nke ebe ịchụ aja ọhụrụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.14",
            "verseOrgIds": [
              "2KI.16.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "2KI 16:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze Ehaz nyere Ụraya, bụ onyeisi nchụaja iwu, sị, \"Ọ bụ nʼelu ebe ịchụ aja ọhụrụ a ka ị ga na-esure aja nsure ọkụ ụtụtụ niile, na onyinye mkpụrụ ọka nke uhuruchi niile, na aja nsure ọkụ eze, na onyinye mkpụrụ ọka nke eze, na aja na onyinye nke ndị niile nʼala a, ya na onyinye mkpụrụ ọka ha niile na onyinye ihe ọṅụṅụ ha niile. Fekwasị ọbara niile e ji chụọ aja nsure ọkụ na aja ndị ọzọ nʼelu ebe ịchụ aja ahụ. Ma ebe ịchụ aja ọla ahụ ga-adịrị m iji jụta ase.\"",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.15",
            "verseOrgIds": [
              "2KI.16.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "2KI 16:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụraya onye nchụaja mere ihe niile dịka eze Ehaz nyere ya nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.16",
            "verseOrgIds": [
              "2KI.16.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "2KI 16:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze bụ Ehaz wepụrụ ihe njikọ niile jikọrọ ihe ndọkwasị ahụ niile a na-ebugharị ebugharị. O wepụrụ efere ukwu ịdọba mmiri a dọkwasịrị nʼelu ehi ọla ahụ dị nʼokpuru ya, ma dọkwasị ya nʼelu nkume.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.17",
            "verseOrgIds": [
              "2KI.16.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "2KI 16:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi imekwa ka obi tọọ eze Asịrịa ụtọ, o wepụrụ ụzọ a na-esite maka ụbọchị izuike nke e wuru nʼime ụlọnsọ, na ụzọ mbata eze si abanye nʼụlọnsọ ukwu",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "2KI.16.18",
                "verseOrgIds": [
                  "2KI.16.18"
                ]
              }
            }
          ]
        },
        {
          "text": ".",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.18",
            "verseOrgIds": [
              "2KI.16.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "2KI 16:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma banyere ihe ndị ọzọ niile mere nʼoge ọchịchị Ehaz, na ihe ndị o mere, ọ bụ na e deghị ha nʼakwụkwọ akụkọ ihe mere nʼoge ndị eze Juda?",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.19",
            "verseOrgIds": [
              "2KI.16.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "2KI 16:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ehaz soro nna nna ya ha dina nʼọnwụ, e lie ya nʼebe e liri ha nʼobodo Devid. Hezekaya nwa ya ghọrọ eze nʼọnọdụ ya.",
          "type": "text",
          "attrs": {
            "verseId": "2KI.16.20",
            "verseOrgIds": [
              "2KI.16.20"
            ]
          }
        }
      ]
    }
  ],
