      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:10"
      },
      "items": [
        {
          "text": "\"Aga m ala ịnyịnya unu nʼiyi site nʼetiti unu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.10",
            "verseOrgIds": [
