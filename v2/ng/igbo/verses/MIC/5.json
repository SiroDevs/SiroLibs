      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "nke na-azọda na-adọkasị mgbe ọ na-agabiga,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
