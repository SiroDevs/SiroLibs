  "verseCount": 15,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "MIC 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Onyendu si Betlehem",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a doo ndị agha gị nʼusoro, gị obodo nke usuu ndị agha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "nʼihi na e jirila mgbidi gbaa gị gburugburu ibuso gị agha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "Ha ga-eji mkpara",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:1"
      },
      "items": [
        {
          "text": "tie onyendu Izrel na nti.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.1",
            "verseOrgIds": [
              "MIC.4.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma gị onwe gị, Betlehem Efrata,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "ọ bụ ezie na ị bụ obodo dị nta nʼetiti ndị ikwu Juda niile,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "ma onye ahụ ga-achị Izrel",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "ga-esi na gị pụta,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "bụ onye ahụ mmalite ya sitere na mgbe ochie,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:2"
      },
      "items": [
        {
          "text": "sitekwa na mgbe ebighị ebi gara aga.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.2",
            "verseOrgIds": [
              "MIC.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, a ga-arara ha nye",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "tutu ruo mgbe onye ahụ ime na-eme mụpụtara nwa ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "Mgbe ahụ, ụmụnna ya niile ahụ fọdụrụ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:3"
      },
      "items": [
        {
          "text": "ga-alọghachikwuru ndị Izrel.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.3",
            "verseOrgIds": [
              "MIC.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-eguzo zụọ igwe ewu na atụrụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "site nʼike nke",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.5.4",
                "verseOrgIds": [
                  "MIC.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "na site nʼịdị ukwuu nke aha",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.5.4",
                "verseOrgIds": [
                  "MIC.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "Ndị ya ga-anọkwa na-enweghị nsogbu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:4"
      },
      "items": [
        {
          "text": "nʼihi na ịdị ukwuu ya ga-eru na nsọtụ niile nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.4",
            "verseOrgIds": [
              "MIC.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mgbapụta na Mbibi",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụkwa udo anyị.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "Mgbe ndị Asịrịa ga-abata nʼala anyị nʼike,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "sikwa nʼebe niile e wusiri ike nke anyị na-agafe,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "anyị ga-ahọpụta ndị ọzụzụ atụrụ asaa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:5"
      },
      "items": [
        {
          "text": "ọ bụladị ndịisi asatọ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.5",
            "verseOrgIds": [
              "MIC.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye ga-eji mma agha chịa ala Asịrịa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "jirikwa mma agha a mịpụtara amịpụta chịa ala Nimrọd.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "Ọ ga-anapụta anyị site nʼaka ndị Asịrịa ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "mgbe ha ga-eji ike bata nʼala anyị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:6"
      },
      "items": [
        {
          "text": "ma zọrọkwa ije gafee oke ala anyị.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.6",
            "verseOrgIds": [
              "MIC.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị fọdụrụ afọdụ nke Jekọb",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "ga-adị nʼetiti ọtụtụ ndị mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "dịka igirigi si nʼebe Onyenwe anyị nọ abịa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "maọbụ dịka mmiri ozuzo ntakịrị na-ezokwasị ahịhịa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "nke na-adịghị ele anya mmadụ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:7"
      },
      "items": [
        {
          "text": "maọbụ chere ụmụ mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.7",
            "verseOrgIds": [
              "MIC.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị fọdụrụ afọdụ nke Jekọb",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "ga-adịkwa nʼetiti ọtụtụ ndị mmadụ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "dị ka ọdụm nʼetiti anụ ọhịa niile dị iche iche,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
              "MIC.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 5:8"
      },
      "items": [
        {
          "text": "e, dịka nwa ọdụm nʼetiti igwe atụrụ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.5.8",
            "verseOrgIds": [
