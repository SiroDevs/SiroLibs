  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "7",
        "style": "c",
        "sid": "MIC 7"
      },
      "items": [
        {
          "text": "7",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nhụju anya nke Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 7:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụhụ dịrị m!",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "Adị m ka onye na-achịkọta mkpụrụ osisi vaịnị nʼọkọchị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "mgbe a ghọkọtachara mkpụrụ dị nʼubi vaịnị.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "O nweghị ụyọkọ mkpụrụ vaịnị ọbụla fọdụrụ nke e nwere ike ịta,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:1"
      },
      "items": [
        {
          "text": "o nwekwaghị mkpụrụ fiig buru ụzọ chaa nke agụ ya na-agụsị m ike",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.1",
            "verseOrgIds": [
              "MIC.7.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 7:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ezi omume agwụla nʼụwa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "ọ dịkwaghị otu onye na-eme ihe ziri ezi fọdụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "Ha niile na-echere oghere ịkwafu ọbara,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:2"
      },
      "items": [
        {
          "text": "ha ji ụgbụ na-achụta nta, onye ọbụla na-achụ ụmụnne ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.2",
            "verseOrgIds": [
              "MIC.7.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 7:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọrụ nke aka ha abụọ na-arụpụta nke ọma bụ ajọ omume.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "Onyeisi na-ana onyinye,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "onye ọkaikpe na-eri ngarị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "ndị dị ike na-atụpụta ihe masịrị ha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:3"
      },
      "items": [
        {
          "text": "si otu a na-akpagbu eziokwu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.3",
            "verseOrgIds": [
              "MIC.7.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 7:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye nke kachasị ibe ya ịdị mma nʼime ha dịka uke.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Onye nke na-eme ihe ziri ezi nʼime ha jọrọ njọ karịa ogige ogwu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Ma ugbu a, ụbọchị Chineke na-eleta gị abịala,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "ụbọchị ahụ ndị nche gị na-akụ ekwe ịdọ aka na ntị.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:4"
      },
      "items": [
        {
          "text": "Ugbu a bụ oge ihe ịgba gharịị nye ha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.4",
            "verseOrgIds": [
              "MIC.7.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 7:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ekwenyerela onye agbataobi gị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "atụkwasịla onye bụ ezi enyi gị obi.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "Kpachara anya gị, nʼihe gbasara okwu ọnụ gị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:5"
      },
      "items": [
        {
          "text": "ọbụla dị nʼebe nwunye gị nọ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.5",
            "verseOrgIds": [
              "MIC.7.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 7:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na nwa na-elelị nna ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "Nwa nwanyị na-ebili megide nne ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "Nwunye nwa megidekwa nne di ya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:6"
      },
      "items": [
        {
          "text": "ndị iro mmadụ bụ ndị ezinaụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.6",
            "verseOrgIds": [
              "MIC.7.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 7:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mụ onwe m, ana m ele",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.7",
                "verseOrgIds": [
                  "MIC.7.7"
                ]
              }
            }
          ]
        },
        {
          "text": "anya nʼihi inyeaka ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "Eji m olileanya na-echere Chineke Onye nzọpụta m.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:7"
      },
      "items": [
        {
          "text": "Chineke m ga-anụ olu m.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.7",
            "verseOrgIds": [
              "MIC.7.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Izrel ga-ebili",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 7:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Achịkwala m ọchị gị onye iro m.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Mgbe m dara, aga m ebilitekwa.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "text": "Mgbe m nọ nʼime ọchịchịrị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:8"
      },
      "items": [
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.8",
                "verseOrgIds": [
                  "MIC.7.8"
                ]
              }
            }
          ]
        },
        {
          "text": "nʼonwe ya ga-abụ ihe m.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.8",
            "verseOrgIds": [
              "MIC.7.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 7:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na m emehiela megide ya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "aga m anabatara onwe m ahụhụ nke ọnụma",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.9",
                "verseOrgIds": [
                  "MIC.7.9"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "tutu ruo mgbe ọ ga-ekpe ikpe m,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "mee ka m guzosie ike.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "Ọ ga-akpọpụta m nʼìhè;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:9"
      },
      "items": [
        {
          "text": "aga m elekwasịkwa ezi omume ya anya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.9",
            "verseOrgIds": [
              "MIC.7.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 7:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị iro m ga-ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "ihere ga-ekpuchi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "onye ahụ sịrị m,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "\"Olee ebe",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.10",
                "verseOrgIds": [
                  "MIC.7.10"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ahụ nọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "Aga m eji anya m hụ mgbe ọ ga-ada,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "ọ bụladị dịka e si na-azọ ya ụkwụ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:10"
      },
      "items": [
        {
          "text": "dịka apịtị dị nʼokporoụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.10",
            "verseOrgIds": [
              "MIC.7.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 7:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị a ga-ewugharị mgbidi gị niile na-abịa;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.11",
            "verseOrgIds": [
              "MIC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:11"
      },
      "items": [
        {
          "text": "ụbọchị a ga-eme ka oke ala gị saa mbara.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.11",
            "verseOrgIds": [
              "MIC.7.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 7:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị ahụ, ha ga-abịakwute gị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:12"
      },
      "items": [
        {
          "text": "site na Asịrịa ruo na obodo niile nke Ijipt,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:12"
      },
      "items": [
        {
          "text": "sitekwa nʼIjipt ruo Yufretis,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:12"
      },
      "items": [
        {
          "text": "site nʼosimiri ruo osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:12"
      },
      "items": [
        {
          "text": "sitekwa nʼugwu ruo nʼugwu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.12",
            "verseOrgIds": [
              "MIC.7.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 7:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ụwa ga-aghọ ebe tọgbọrọ nʼefu nʼihi ndị bi nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:13"
      },
      "items": [
        {
          "text": "iji kwụọ ha ụgwọ ihe ọjọọ niile ha mere.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.13",
            "verseOrgIds": [
              "MIC.7.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekpere na otuto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 7:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Were mkpanaka gị zụọ ndị gị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:14"
      },
      "items": [
        {
          "text": "bụ igwe ewu na atụrụ nke ihe nketa gị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:14"
      },
      "items": [
        {
          "text": "ndị bi naanị ha nʼoke ọhịa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:14"
      },
      "items": [
        {
          "text": "nʼebe ịta nri nke ahịhịa ndụ jupụtara.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:14"
      },
      "items": [
        {
          "text": "Kwere ka ha taa ahịhịa ndụ nke Bashan, na nke Gilead,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:14"
      },
      "items": [
        {
          "text": "dịka na mgbe ochie.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.14",
            "verseOrgIds": [
              "MIC.7.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 7:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Dịka nʼụbọchị ahụ unu sitere nʼIjipt pụta,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.15",
            "verseOrgIds": [
              "MIC.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:15"
      },
      "items": [
        {
          "text": "aga m egosi ha ọrụ ịtụnanya m niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.15",
            "verseOrgIds": [
              "MIC.7.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 7:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba dị iche iche ga-ahụ ya, ihere ga-emekwa ha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:16"
      },
      "items": [
        {
          "text": "nʼime ịdị ike ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:16"
      },
      "items": [
        {
          "text": "Ha ga-ekpuchi aka nʼọnụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:16"
      },
      "items": [
        {
          "text": "ntị ga-echikwa ha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.16",
            "verseOrgIds": [
              "MIC.7.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "MIC 7:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha ga-aracha aja dịka agwọ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:17"
      },
      "items": [
        {
          "text": "na dịka anụ dị iche iche, nke na-akpụ akpụ nʼala.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:17"
      },
      "items": [
        {
          "text": "Ha ga-eji ịma jijiji si nʼebe ha e wusiri ike pụta.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:17"
      },
      "items": [
        {
          "text": "Nʼihi egwu ha, ha ga-abịakwute",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.7.17",
                "verseOrgIds": [
                  "MIC.7.17"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke anyị.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:17"
      },
      "items": [
        {
          "text": "Ha ga-atụkwa egwu gị.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.17",
            "verseOrgIds": [
              "MIC.7.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "MIC 7:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye bụ chi ahụ dịka gị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "nke na-agbaghara ma na-ehichapụ mmehie na njehie",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "nke ndị fọdụrụ afọdụ nʼetiti ihe nketa gị?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "Ị naghị anọgide na-ewe iwe ruo mgbe ebighị ebi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 7:18"
      },
      "items": [
        {
          "text": "kama ị bụ onye ọ na-atọ ụtọ inwe obi ebere.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.7.18",
            "verseOrgIds": [
              "MIC.7.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
