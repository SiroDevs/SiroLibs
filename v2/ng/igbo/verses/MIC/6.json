  "verseCount": 16,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "6",
        "style": "c",
        "sid": "MIC 6"
      },
      "items": [
        {
          "text": "6",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ikpe",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "megide Izrel",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "MIC 6:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Geenụ ntị nʼihe Onyenwe anyị na-ekwu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "\"Bilienụ ọtọ, ma kwuonụ nʼihu ugwu niile ụzọ m siri mejọọ unu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:1"
      },
      "items": [
        {
          "text": "Ka ugwu nta niile nụkwa ihe i nwere ikwu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.1",
            "verseOrgIds": [
              "MIC.6.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "MIC 6:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ma ugbu a geenụ ntị, unu ugwu niile,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "geenụ ntị, unu ntọala ebighị ebi niile nke ụwa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.2",
                "verseOrgIds": [
                  "MIC.6.2"
                ]
              }
            }
          ]
        },
        {
          "text": "nwere ikpe megide ndị nke ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:2"
      },
      "items": [
        {
          "text": "Ọ bụkwa Izrel ka ọ ga-arụso ụka.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.2",
            "verseOrgIds": [
              "MIC.6.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "MIC 6:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu bụ ndị m, gịnị ka m mere unu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:3"
      },
      "items": [
        {
          "text": "Gwanụ m ụzọ m si boo unu ibu arọ? Zaanụ m.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.3",
            "verseOrgIds": [
              "MIC.6.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "MIC 6:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na e si m nʼala Ijipt kpọpụta unu.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "Agbapụtara m unu site na ịbụ ohu,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "nye unu Mosis",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:4"
      },
      "items": [
        {
          "text": "na Erọn na Miriam ka ha nyere unu aka.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.4",
            "verseOrgIds": [
              "MIC.6.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "MIC 6:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị m, chetanụ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "ihe Balak eze Moab zubere",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "na ihe Belam nwa Beoa zara ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "Chetanụ njem unu site nʼobodo Shitim ruo obodo Gilgal,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:5"
      },
      "items": [
        {
          "text": "ka unu hụ nzọpụta nke Onyenwe anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.5",
            "verseOrgIds": [
              "MIC.6.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "MIC 6:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị ka m ga-eji bịa nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.6",
                "verseOrgIds": [
                  "MIC.6.6"
                ]
              }
            }
          ]
        },
        {
          "text": ",",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "ịkpọ isiala nʼihu Chineke onye dị oke elu?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "M ga-eji onyinye aja nsure ọkụ bịa nʼihu ya",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:6"
      },
      "items": [
        {
          "text": "nke e ji ụmụ ehi gbara otu afọ chụọ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.6",
            "verseOrgIds": [
              "MIC.6.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "MIC 6:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-atọ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.7",
                "verseOrgIds": [
                  "MIC.6.7"
                ]
              }
            }
          ]
        },
        {
          "text": "ụtọ, bụ ọtụtụ puku ebule,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "ya na iri puku mmanụ na-asọ dịka iyi?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "Aga m eji nwa mbụ m chụọ aja njehie m,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:7"
      },
      "items": [
        {
          "text": "maọbụ mkpụrụ nke ahụ m chụọ aja maka mmehie nke mkpụrụobi m?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.7",
            "verseOrgIds": [
              "MIC.6.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "MIC 6:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na o gosila gị, gị mmadụ, ihe dị mma.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Gịnịkwa bụ ihe ahụ",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.8",
                "verseOrgIds": [
                  "MIC.6.8"
                ]
              }
            }
          ]
        },
        {
          "text": "na-achọ nʼaka gị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "Ọ bụ na ọ bụghị ikpe ziri ezi, na ịhụ ime ebere nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:8"
      },
      "items": [
        {
          "text": "na iji obi dị umeala soro Chineke gị na-eje ije?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.8",
            "verseOrgIds": [
              "MIC.6.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ahụhụ Izrel na ikpe ọmụma ya",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "MIC 6:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gee ntị! Olu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "MIC.6.9",
                "verseOrgIds": [
                  "MIC.6.9"
                ]
              }
            }
          ]
        },
        {
          "text": "na-ada na-akpọku ndị obodo ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "nʼezie, ịtụ egwu gị bụ inwe amamihe.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:9"
      },
      "items": [
        {
          "text": "\"Nụrụnụ olu mkpanaka na Onye hiwere ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.9",
            "verseOrgIds": [
              "MIC.6.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "MIC 6:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-abụ na m ga-echezọ akụ ị kpara nʼụzọ na-ezighị ezi, gị ụlọ ajọ omume,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:10"
      },
      "items": [
        {
          "text": "ya na ihe ọtụtụ nke na-erughị eru unu ji ere ahịa, bụ nke abụrụ ọnụ?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.10",
            "verseOrgIds": [
              "MIC.6.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "MIC 6:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "M ga-asị onye na-eji ihe ọtụtụ aghụghọ azụ ahịa,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:11"
      },
      "items": [
        {
          "text": "na onye bu akpa nke ihe ọtụtụ aghụghọ dị iche iche juru nʼime ya na aka ya dị ọcha?",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.11",
            "verseOrgIds": [
              "MIC.6.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "MIC 6:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ọgaranya unu bụ ndị na-eme ihe ike,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:12"
      },
      "items": [
        {
          "text": "ndị mmadụ nọ nʼime gị na-agha ụgha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:12"
      },
      "items": [
        {
          "text": "ire ha na-ekwu naanị okwu aghụghọ.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.12",
            "verseOrgIds": [
              "MIC.6.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "MIC 6:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, ebidola m ịla unu nʼiyi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.13",
            "verseOrgIds": [
              "MIC.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:13"
      },
      "items": [
        {
          "text": "na ime ka unu bụrụ ndị e bibiri nʼihi mmehie unu",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.13",
            "verseOrgIds": [
              "MIC.6.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "MIC 6:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-eri nri ma afọ agaghị eju unu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:14"
      },
      "items": [
        {
          "text": "afọ agaghị ejukwa unu eju.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:14"
      },
      "items": [
        {
          "text": "Unu ga-ewezuga ihe, ma unu agaghị echekwa ha,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:14"
      },
      "items": [
        {
          "text": "nʼihi na ihe ọbụla unu nwere ike chekwaa, ka m ga-ewere nyefee nʼaka mma agha.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.14",
            "verseOrgIds": [
              "MIC.6.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "MIC 6:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu ga-akụ mkpụrụ, ma unu agaghị ewe ihe ubi,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:15"
      },
      "items": [
        {
          "text": "unu ga-azọchapụta mmanụ oliv, ma unu agaghị ete ya nʼahụ unu;",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:15"
      },
      "items": [
        {
          "text": "unu ga-azọchapụtakwa mmanya site na mkpụrụ vaịnị, ma unu agaghị aṅụ mmanya ya.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.15",
            "verseOrgIds": [
              "MIC.6.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "MIC 6:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu edebela ụkpụrụ niile bụ nke Omri,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "na omenaala niile nke ụlọ Ehab,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "unu gbasokwara ndụmọdụ ha niile.",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "Nʼihi ya, aga m enyefe unu nʼaka mbibi",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "mee ka ndị gị ghọọkwa ihe ọchị,",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "MIC 6:16"
      },
      "items": [
        {
          "text": "unu ga-aghọkwara mba niile ihe nkọcha.\"",
          "type": "text",
          "attrs": {
            "verseId": "MIC.6.16",
            "verseOrgIds": [
              "MIC.6.16"
            ]
          }
        }
      ]
    }
