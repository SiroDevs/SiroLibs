{
  "id": "REV.5",
  "number": "5",
  "bookId": "REV",
  "reference": "Mkpughe 5",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "REV 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwụkwọ kọwara ihe na-aga ime",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ahụrụ m akwụkwọ e dere ihe ihu na azụ, nke a fụkọrọ afụkọ, kakwasịkwa ya akara asaa, ka ọ dị nʼaka nri onye ahụ nọkwasịrị nʼelu ocheeze ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.1",
            "verseOrgIds": [
              "REV.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụkwara m otu mmụọ ozi dị ukwuu, ka ọ na-ekwusa okwu nʼoke olu na-asị, \"Ọ bụ onye kwesiri ịnyakapụ akara ndị a ma saghee akwụkwọ ahụ a fụkọrọ afụkọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.2",
            "verseOrgIds": [
              "REV.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ọ dịghị onye ọbụla pụrụ ịsaghe akwụkwọ ahụ maọbụ ilenye ya anya a hụrụ nʼeluigwe, maọbụ nʼụwa, maọbụ nʼokpuru ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.3",
            "verseOrgIds": [
              "REV.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwara m akwa nʼobi ilu nʼihi na ọ dịghị onye ọbụla a hụrụ tozuru oke ịsaghe akwụkwọ ahụ maọbụ ileba anya nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.4",
            "verseOrgIds": [
              "REV.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, otu onye nʼime ndị okenye ahụ gwara m sị, \"Akwala akwa. Lee, Ọdụm ebo Juda, bụ mgbọrọgwụ Devid, emeriela. Ọ pụrụ ịnyakapụ akara asaa ahụ ma saghekwaa akwụkwọ ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.5",
            "verseOrgIds": [
              "REV.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ahụrụ m Nwa Atụrụ na-eguzo nʼetiti ocheeze ahụ dịka e gburu ya egbu. Anụ anọ ahụ dị ndụ na ndị okenye ahụ gbara ya gburugburu. O nwekwara mpi asaa na anya asaa, nke bụ mmụọ asaa nke Chineke, ndị e zipụrụ nʼime ụwa niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.6",
            "verseOrgIds": [
              "REV.5.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ gara nʼihu were akwụkwọ ahụ site nʼaka nri onye ahụ na-anọkwasị nʼelu ocheeze ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.7",
            "verseOrgIds": [
              "REV.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ weere ya, anụ anọ ahụ dị ndụ na iri ndị okenye abụọ na anọ ndị ahụ dara nʼala nʼihu Nwa Atụrụ ahụ. Ha niile nʼotu nʼotu jikwa ụbọ akwara na efere e ji ọlaedo mee, nke ihe jupụtara nʼime ha bụ ụda na-esi isi ụtọ, bụ ekpere ndị nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.8",
            "verseOrgIds": [
              "REV.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-abụ abụ ọhụrụ na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 5:9"
      },
      "items": [
        {
          "text": "\"I kwesiri ịnara akwụkwọ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 5:9"
      },
      "items": [
        {
          "text": "na ịnyakapụ akara ya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 5:9"
      },
      "items": [
        {
          "text": "nʼihi na e gburu gị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 5:9"
      },
      "items": [
        {
          "text": "ma site nʼọbara gị, ị gbataara Chineke ndị mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 5:9"
      },
      "items": [
        {
          "text": "ndị si nʼebo niile, na asụsụ niile, na ndị niile, na mba niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.9",
            "verseOrgIds": [
              "REV.5.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị chịkọtaala ha, mee ha otu alaeze na ndị nchụaja na-ejere Chineke anyị ozi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.10",
            "verseOrgIds": [
              "REV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 5:10"
      },
      "items": [
        {
          "text": "Ha ga-achịkwa achị nʼụwa.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.10",
            "verseOrgIds": [
              "REV.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, elere m anya, hụ ma nụkwa olu nke ọtụtụ ndị mmụọ ozi, nke ọnụọgụgụ ha ruru puku kwụrụ puku, na nde kwụrụ nde. Ha gbara ocheeze ahụ gburugburu, na anụ anọ ahụ dị ndụ na ndị okenye ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.11",
            "verseOrgIds": [
              "REV.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-abụ abụ nʼoke olu na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 5:12"
      },
      "items": [
        {
          "text": "\"O kwesiri bụ Nwa Atụrụ ahụ e gburu egbu",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 5:12"
      },
      "items": [
        {
          "text": "ịnara ike na akụnụba na amamihe na ike",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 5:12"
      },
      "items": [
        {
          "text": "na nsọpụrụ na otuto na ngọzị.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.12",
            "verseOrgIds": [
              "REV.5.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, anụrụ m ka ihe niile nọ nʼeluigwe na ndị nọ nʼụwa na ndị nọ nʼokpuru ụwa, na ndị nọ nʼokpuru oke osimiri na-eti mkpu abụ na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 5:13"
      },
      "items": [
        {
          "text": "\"Ka ngọzị, na nsọpụrụ niile, na otuto niile, na ike niile",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 5:13"
      },
      "items": [
        {
          "text": "dịrị onye ahụ na-anọkwasị nʼocheeze ahụ, na Nwa Atụrụ ahụ",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 5:13"
      },
      "items": [
        {
          "text": "ruo mgbe niile ebighị ebi!\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.13",
            "verseOrgIds": [
              "REV.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anụ anọ ahụ dị ndụ zakwara sị, \"Amen!\" Ndị okenye ahụ dakwara nʼala nʼihu ya kpọọ isiala nye ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.5.14",
            "verseOrgIds": [
              "REV.5.14"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "REV.6",
    "number": "6",
    "bookId": "REV"
  },
  "previous": {
    "id": "REV.4",
    "number": "4",
