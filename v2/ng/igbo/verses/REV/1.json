{
  "id": "REV.1",
  "number": "1",
  "bookId": "REV",
  "reference": "Mkpughe 1",
  "copyright": "Biblica® Open Igbo Contemporary Bible™ Copyright © 1980, 1988, 2019, 2020 by Biblica, Inc. Used with permission. All rights reserved worldwide.",
  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "REV 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ihe e dere nʼakwụkwọ a",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpughe banyere Jisọs Kraịst, nke Chineke nyere ya igosi ndị ohu ya, ime ka ha mata ihe ndị ahụ na-aga ime nʼoge na-adịghị anya. O mere ka amata nke a site na izite mmụọ ozi ya ka ọ bịakwute ohu ya Jọn,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.1",
            "verseOrgIds": [
              "REV.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "onye a gbara ama banyere ihe niile ọ hụrụ, okwu Chineke, na ọgbụgba ama Jisọs Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.2",
            "verseOrgIds": [
              "REV.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ngọzị na-adịrị onye ahụ na-agụpụta okwu ndị a dị nʼamụma a. Ngọzị na-adịkwara ndị na-anụ ya, ma nabata ihe e dere nʼime ya nʼobi ha. Nʼihi na oge mmezu ha dị nso.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.3",
            "verseOrgIds": [
              "REV.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ekele na otuto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ m Jọn na-ede akwụkwọ a,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Na-edere ya nzukọ asaa dị na mpaghara Eshịa:",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:4"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:4"
      },
      "items": [
        {
          "text": "Ka amara na udo nke sitere na Onye ahụ na-adị, Onye ahụ dịkwaarị, na Onye ahụ na-aga ịbịa dịrị unu, sitekwa nʼebe Mmụọ asaa",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "text": "ahụ na-eguzo nʼihu ocheeze ya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.4",
            "verseOrgIds": [
              "REV.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "sitekwa nʼaka Jisọs Kraịst, onye bụ onyeama kwesiri ntụkwasị obi, na onye mbụ sitere na ndị nwụrụ anwụ bilie, nakwa onye na-achị ndị eze niile nke ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "REV 1:5"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "REV 1:5"
      },
      "items": [
        {
          "text": "Nye onye ahụ hụrụ anyị nʼanya ma meekwa ka anyị site nʼọbara ya nwere onwe anyị pụọ na mmehie.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.5",
            "verseOrgIds": [
              "REV.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mere ka anyị bụrụ alaeze, ndị nchụaja nye Nna ya bụ Chineke. Ọ bụ ya ka otuto niile na ike niile dịịrị ruo mgbe niile ebighị ebi. Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.6",
            "verseOrgIds": [
              "REV.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Lee, ọ na-abịa ya na igwe ojii.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "Anya niile ga-ahụkwa ya,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "ọ bụladị ndị ahụ niile mapuru ya ahụ, ha ga-ahụ ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "Mmadụ niile nọ nʼụwa \"ga-erukwa ụjụ nʼihi ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "qc",
        "vid": "REV 1:7"
      },
      "items": [
        {
          "text": "Otu a ka ọ ga-adị! Amen.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.7",
            "verseOrgIds": [
              "REV.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu a ka Onyenwe anyị Chineke kwuru, \"Abụ m Alfa na Omega, onye na-adị, onye ahụ dịkwaarị, na onye ahụ na-aga ịbịa, bụ onye pụrụ ime ihe niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.8",
            "verseOrgIds": [
              "REV.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọhụ Jọn hụrụ banyere Kraịst",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mụ onwe m, Jọn, nwanne unu nwoke, onye unu na ya na-enwekọ ahụhụ na nʼalaeze, na ntachiobi nke bụ oke anyị nʼime Jisọs. Anọ m nʼogbe ala ntakịrị mmiri gbara gburugburu a na-akpọ Patmọs nʼihi okwu Chineke na-agba ama banyere Kraịst.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.9",
            "verseOrgIds": [
              "REV.1.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị Onyenwe anyị, anọ m nʼime Mmụọ ma nụ otu oke olu dara ụda dị ka opi ike nʼazụ m,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.10",
            "verseOrgIds": [
              "REV.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-ekwu,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.11",
            "verseOrgIds": [
              "REV.1.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Dee ihe ị na-ahụ ugbu a nʼakwụkwọ zigara ya nzukọ asaa dị nʼEfesọs na Smyrna na Pegamọm na Tiatira na Sardis, na Filadelfia na Laodisia.\"",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.11",
                "verseOrgIds": [
                  "REV.1.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m chigharịrị, lee anya ịhụ onye na-agwa m okwu, ahụrụ m ihe ịdọba oriọna asaa e ji ọlaedo kpụọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.12",
            "verseOrgIds": [
              "REV.1.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼetiti ihe ịdọba oriọna ndị a, ahụrụ m otu onye yiri nwa nke mmadụ,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "text": "ka o guzo. O yikwasịrị onwe ya uwe mwụda. Ma o nwere ihe okike na-acha ọlaedo e ji kee gburugburu obi ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.13",
            "verseOrgIds": [
              "REV.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Isi ya na agịrị isi ya na-acha vaa dịka ogho ọcha, dịka akụmmiri igwe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "text": "Anya ya abụọ yiri ire ọkụ na-enwusi ike.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.14",
            "verseOrgIds": [
              "REV.1.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụkwụ ya abụọ dị ka bronz a nụchasịrị nnọọ nke ọma hichapụkwa ya. Olu okwu ya na-ada dị ka ụzụ mmiri na-achị achị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.15",
            "verseOrgIds": [
              "REV.1.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "O jidere kpakpando asaa nʼaka nri ya, mma agha dị nkọ nwere ihu abụọ sikwa nʼọnụ ya na-apụta. Ihu ya na-egbu maramara dịka anyanwụ na-acha nʼike ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.16",
            "verseOrgIds": [
              "REV.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m hụrụ ya, adara m nʼala nʼụkwụ ya dịka onye nwụrụ anwụ. Ma o weere aka nri ya metụ m nʼahụ na-ekwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Atụla egwu. Abụ m Mmalite na Ọgwụgwụ.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.17",
                "verseOrgIds": [
                  "REV.1.17"
                ]
              }
            }
          ]
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.1.17",
            "verseOrgIds": [
              "REV.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "Abụ m onye ahụ na-adị ndụ. Anwụrụ m anwụ, ma lee, ana m adị ndụ ruo mgbe niile ebighị ebi. Ọ bụkwa m ji ọtụghe igodo nke ọnwụ na nke ọkụ ala mmụọ.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.18",
                "verseOrgIds": [
                  "REV.1.18"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "REV 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "wj"
          },
          "items": [
            {
              "text": "\"Ya mere, detuo ihe niile ị hụrụla, ihe dị ugbu a na ihe gaje ime na mgbe na adịghị anya.",
              "type": "text",
              "attrs": {
                "verseId": "REV.1.19",
                "verseOrgIds": [
                  "REV.1.19"
                ]
              }
            }
          ]
        },
        {
