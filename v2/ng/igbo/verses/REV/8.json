  "verseCount": 13,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "REV 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyakapụ akara nke asaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe o meghere akara nke asaa, akụkụ niile nke eluigwe dara jụụ ruo ihe dị ka iri nkeji atọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.1",
            "verseOrgIds": [
              "REV.8.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ahụrụ m ndị mmụọ ozi asaa, ndị na-eguzo nʼihu Chineke. E nyere ha opi ike nʼotu nʼotu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.2",
            "verseOrgIds": [
              "REV.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmụọ ozi ọzọ nke ji ite igwe ntakịrị e ji ọlaedo kpụọ bịara guzo nʼihu ebe ịchụ aja. E nyere ya ọtụtụ ụda na-esi isi ụtọ ka o jiri chụọ aja, ya na ekpere ndị nsọ niile, nʼebe ịchụ aja e jiri ọlaedo wuo, nʼihu ocheeze ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.3",
            "verseOrgIds": [
              "REV.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anwụrụ ọkụ nke ihe ahụ na-esi isi ụtọ, ya na ekpere ndị nsọ sitere nʼaka mmụọ ozi ahụ rigoo elu nʼihu Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.4",
            "verseOrgIds": [
              "REV.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ kwa, mmụọ ozi ahụ weere ọkụ sitere nʼebe ịchụ aja ahụ tinye ya nʼime ite igwe ntakịrị ahụ, tụda ya, ka ọ danye nʼime ụwa. Mgbe o mere nke a, ụzụ egbe eluigwe dara, amụma gbukwara nʼụzọ dị oke egwu. Ala ọma jijiji dakwasịkwara ebe niile nʼụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.5",
            "verseOrgIds": [
              "REV.8.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị mmụọ ozi afụọ opi ike",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ndị mmụọ ozi asaa ahụ ndị ji opi asaa ahụ jikeere onwe ha ịfụ opi ike ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.6",
            "verseOrgIds": [
              "REV.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmụọ ozi nke mbụ fụrụ opi ike ya, a tụdara mkpụrụ mmiri na ọkụ a gwakọtara ya na ọbara nʼime ụwa. Nke a mere ka otu ụzọ nʼime ụzọ atọ nke osisi rechapụrụ ọkụ, e rechapụkwara ahịhịa ndụ niile ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.7",
            "verseOrgIds": [
              "REV.8.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmụọ ozi nke abụọ fụkwara opi ike ya, a tụdara ihe yiri ugwu dị ukwuu na-enwu ọkụ nʼime osimiri. Nke a mere ka otu ụzọ nʼime ụzọ atọ e kere osimiri niile chagharịa ghọọ ọbara.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.8",
            "verseOrgIds": [
              "REV.8.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ụzọ nʼime ụzọ atọ nke ihe niile dị ndụ dị nʼime osimiri nwụrụ. Otu ụzọ nʼime ụzọ atọ e kere ụgbọ mmiri niile dị nʼelu osimiri lara nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.9",
            "verseOrgIds": [
              "REV.8.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmụọ ozi nke atọ fụrụ opi ike ya, otu kpakpando dịkarịsịrị ukwuu nke na-enwu dị ka ọwaọkụ sitere na mbara eluigwe danye nʼime otu ụzọ nʼime ụzọ atọ e kere iyi niile na isi iyi niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.10",
            "verseOrgIds": [
              "REV.8.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aha kpakpando ahụ bụ Ilu ilu. Otu ụzọ nʼime ụzọ atọ nke mmiri malitere ilu ilu, ọtụtụ mmadụ nwụrụ nʼihi mmiri a na-elu ilu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.11",
            "verseOrgIds": [
              "REV.8.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe mmụọ ozi nke anọ fụrụ opi ike ya, e mere ka otu akụkụ nʼime akụkụ atọ e kere anyanwụ gbaa ọchịchịrị. Otu a kwa, otu akụkụ nʼime akụkụ atọ e kere ọnwa gbara ọchịchịrị. Ya na otu akụkụ nʼime atọ e kere kpakpando niile. Nke a mere ka anyanwụ hapụ inyekwa ìhè ya nʼuju dịka o si eme na mbụ. Otu ụzọ nʼime ụzọ atọ e kere ehihie ghọkwara oke ọchịchịrị, ọ dịkwa otu a nʼoge anyasị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.12",
            "verseOrgIds": [
              "REV.8.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Elere m anya, hụ ma nụkwa otu ugo ka ọ na-efegharị nʼetiti mbara eluigwe na-eti mkpu nʼolu ike na-asị, \"Ahụhụ! Ahụhụ! Ahụhụ dịrị mmadụ niile bi nʼụwa nʼihi ụda opi ike nke ndị mmụọ ozi atọ ndị a ga-afụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.8.13",
            "verseOrgIds": [
              "REV.8.13"
            ]
          }
        }
      ]
    }
  ],
