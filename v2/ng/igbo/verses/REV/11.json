  "verseCount": 19,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "11",
        "style": "c",
        "sid": "REV 11"
      },
      "items": [
        {
          "text": "11",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ndị ama abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "REV 11:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Enyere m ihe ọtụtụ osisi achara e ji atụ ihe. Agwara m sị m, \"Gaa tụọ ụlọnsọ ukwu Chineke, ma tụọkwa ebe ịchụ aja dị nʼụlọnsọ ahụ, gụọ ọnụọgụgụ ndị niile na-akpọ isiala nʼebe ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.1",
            "verseOrgIds": [
              "REV.11.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "REV 11:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma atụkwala ogige nke dị na mpụta ụlọnsọ ahụ, nʼihi na ewerela ya nye ndị mba ọzọ. Ha ga-azọtọkwa obodo nsọ ahụ ụkwụ iri ọnwa anọ na abụọ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.2",
            "verseOrgIds": [
              "REV.11.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "REV 11:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m enye mmadụ abụọ ndị ga-agbara m ama ike ka ha buo amụma otu puku ụbọchị na narị ụbọchị abụọ na iri ụbọchị isii (1,260), ha ga-eyi akwa mkpe.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.3",
            "verseOrgIds": [
              "REV.11.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "REV 11:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị a bụ osisi oliv abụọ ahụ na ihe ịdọba oriọna abụọ ahụ, ndị na-eguzo nʼihu Onye nwe ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.4",
            "verseOrgIds": [
              "REV.11.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "REV 11:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụrụ na onye ọbụla achọọ imerụ ha ahụ, ọkụ ga-esi ha nʼọnụ pụta rechapụ ndị iro ha. Ọ bụrụ na onye ọbụla achọọ imerụ ha ahụ, a ga-egbu ya nʼụzọ dị otu a.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.5",
            "verseOrgIds": [
              "REV.11.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "REV 11:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "A ga-enyekwa ha ike imechi eluigwe ime ka mmiri ozuzo ọbụla ghara izo nʼụwa nʼime afọ atọ na ọkara ahụ ha ga-ebu amụma ha. A ga-enyekwa ha ike ime ka osimiri na mmiri nta niile ghọọ ọbara. Ha ga-enwekwa ike ime ka ụdị ọrịa dị iche iche bịakwasị ụwa niile nʼoge ọbụla ha chepụtara nʼobi ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.6",
            "verseOrgIds": [
              "REV.11.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "REV 11:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha gbazuru ama ha, anụ ọhịa ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "text": "nke na-esite nʼime olulu Abis ahụ ga-ebuso ha agha merie ha, gbukwaa ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.7",
            "verseOrgIds": [
              "REV.11.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "REV 11:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha nwụchara, ozu ha ga-atọgbọrọ nʼokporoụzọ nke obodo ukwu ahụ nke a na-akpọ na mmụọ Sọdọm na Ijipt, ebe a kpọgburu Onyenwe ha nʼobe.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.8",
            "verseOrgIds": [
              "REV.11.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "REV 11:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "A gaghị ekwenyekwa ka onye ọbụla lie ozu ha. Ma ndị niile dị iche iche nʼụwa, nʼebo niile, na asụsụ niile, na mba niile ga-agba ozu ha gburugburu ụbọchị atọ na ọkara nʼebe a tọgbọrọ ha na-ele ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.9",
            "verseOrgIds": [
              "REV.11.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "REV 11:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị niile bi nʼụwa ga-aṅụrị ọṅụ, nyerịta ibe ha onyinye dị iche iche, kpọọ oriri dị iche iche iji ṅụrịa ọṅụ nʼihi ogbugbu e gburu ndị amụma abụọ ahụ, ndị wetaara ha oke nhụju anya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.10",
            "verseOrgIds": [
              "REV.11.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "REV 11:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe ụbọchị atọ na ọkara gafesịrị, Chineke ga-eme ka Mmụọ ya na-enye ndụ banyekwa nʼime ha, ha bilitere ọtọ, oke egwu jidere ndị niile hụrụ ha.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.11",
            "verseOrgIds": [
              "REV.11.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "REV 11:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nụrụ oke olu si nʼeluigwe daa na-asị, \"rigotanụ nʼelu.\" Ha siri nʼigwe ojii, rigoro nʼeluigwe ebe ndị iro ha ga-anọ na-ele ha anya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.12",
            "verseOrgIds": [
              "REV.11.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "REV 11:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma nʼotu oge ahụ, nʼotu awa ahụ, ala ọma jijiji dịkarịsịrị oke egwu mara nke mere ka otu akụkụ nʼime akụkụ iri nke obodo ahụ niile daa. Ndị nwụrụ nʼoge ala ọma jijiji a dịkwa puku mmadụ asaa. Ma ndị niile fọdụrụ sitere nʼoke egwu nye Chineke nke eluigwe otuto.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.13",
            "verseOrgIds": [
              "REV.11.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "REV 11:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a ahụhụ nke abụọ ahụ agafeela. Ma mgbe na-adịghị anya, ahụhụ nke atọ na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.14",
            "verseOrgIds": [
              "REV.11.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Opi nke asaa",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "REV 11:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka mmụọ ozi nke asaa fụrụ opi ike ya, oke olu dị iche iche dara ike ike nʼeluigwe, na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 11:15"
      },
      "items": [
        {
          "text": "\"Alaeze niile nke ụwa",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 11:15"
      },
      "items": [
        {
          "text": "abụrụla alaeze Onyenwe anyị, na nke Kraịst ya.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 11:15"
      },
      "items": [
        {
          "text": "Ya onwe ya ga-achịkwa ruo mgbe niile ebighị ebi.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.15",
            "verseOrgIds": [
              "REV.11.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "m"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "REV 11:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, iri ndị okenye abụọ na anọ ahụ nọ nʼocheeze ndị ahụ dị nʼihu ocheeze Chineke dara nʼala kpọọ isiala nye Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.16",
            "verseOrgIds": [
              "REV.11.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "REV 11:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-asị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 11:17"
      },
      "items": [
        {
          "text": "\"Anyị na-enye gị otuto, gị Onyenwe anyị Chineke, Onye pụrụ ime ihe niile.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 11:17"
      },
      "items": [
        {
          "text": "Onye na-adị, na onye dịkwaarị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 11:17"
      },
      "items": [
        {
          "text": "nʼihi na i werela oke ike gị niile nʼaka gị",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 11:17"
      },
      "items": [
        {
          "text": "malitekwa ịchị ọchịchị.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.17",
            "verseOrgIds": [
              "REV.11.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "REV 11:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mba niile were oke iwe megide gị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 11:18"
      },
      "items": [
        {
          "text": "ma ugbu a bụ oge gị iweso ha iwe dị ọkụ.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 11:18"
      },
      "items": [
        {
          "text": "Ugbu a bụ oge ikpe ndị nwụrụ anwụ ikpe",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 11:18"
      },
      "items": [
        {
          "text": "na ịkwụghachi ndị ohu gị bụ ndị amụma ụgwọ ọrụ ha,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 11:18"
      },
      "items": [
        {
          "text": "na ndị nsọ na ndị gị niile, bụ ndị na-atụ egwu aha gị,",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "REV 11:18"
      },
      "items": [
        {
          "text": "bụ ndị dị nta na ndị dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "REV 11:18"
      },
      "items": [
        {
          "text": "Oge eruokwala mgbe ịla nʼiyi ndị na-emebi ụwa ga-adị.\"",
          "type": "text",
          "attrs": {
            "verseId": "REV.11.18",
            "verseOrgIds": [
              "REV.11.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
