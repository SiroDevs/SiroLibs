  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "HAB 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "HAB 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ozi Habakuk onye amụma natara.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.1",
            "verseOrgIds": [
              "HAB.1.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkpesa Habakuk",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "HAB 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.1.2",
                "verseOrgIds": [
                  "HAB.1.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", ruo ole mgbe ka m ga-anọgide na-eti mkpu",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:2"
      },
      "items": [
        {
          "text": "ma ị dịghị ege ntị?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:2"
      },
      "items": [
        {
          "text": "Ruo ole mgbe ka m ga na-etiku gị na-asị, \"Ihe ike, ihe ike!\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:2"
      },
      "items": [
        {
          "text": "ma ị dịghị azọpụta?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.2",
            "verseOrgIds": [
              "HAB.1.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "HAB 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi gịnị ka i ji eme m ka m na-ahụ ihe ọjọọ?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:3"
      },
      "items": [
        {
          "text": "Gịnị mere i ji anagide mmegbu?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:3"
      },
      "items": [
        {
          "text": "Mbibi na ihe ike dị nʼihu m,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:3"
      },
      "items": [
        {
          "text": "na ịlụ ọgụ, na esemokwu jupụtakwara ebe niile.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.3",
            "verseOrgIds": [
              "HAB.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "HAB 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi ya, iwu na-ada mba,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:4"
      },
      "items": [
        {
          "text": "ikpe ziri ezi adịghị agakwa nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:4"
      },
      "items": [
        {
          "text": "Ndị ajọ mmadụ na-agba ndị ezi omume gburugburu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:4"
      },
      "items": [
        {
          "text": "nke mere ka ikpe ziri ezi ghọọ ihe gbagọrọ agbagọ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.4",
            "verseOrgIds": [
              "HAB.1.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọsịsa",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "HAB 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Legide mba niile anya, ka i hụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "Lee, ka o ju gị anya nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "Nʼihi na agaje m ime ihe nʼụbọchị ndụ unu,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "nke unu na-agaghị ekwenye,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:5"
      },
      "items": [
        {
          "text": "ọ bụladị ma akọọrọ unu ya.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.5",
            "verseOrgIds": [
              "HAB.1.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "HAB 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na lee, agaje m ime ka ndị Kaldịa bilie,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:6"
      },
      "items": [
        {
          "text": "bụ mba ahụ na-adịghị eme ebere, na ndị na-eme ngwangwa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:6"
      },
      "items": [
        {
          "text": "Ha bụ ndị na-ebu agha na-ejegharị na mba niile,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:6"
      },
      "items": [
        {
          "text": "ndị na-esite nʼaka ike na-enweta ebe obibi nke na-abụghị nke ha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.6",
            "verseOrgIds": [
              "HAB.1.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "HAB 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ mba a na-atụ ụjọ, na ndị dịkwa egwu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:7"
      },
      "items": [
        {
          "text": "Ha bụ iwu nye onwe ha, ihe ha tụpụtara ka ha na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:7"
      },
      "items": [
        {
          "text": "Ọ bụ onwe ha ka ha na-ebuli elu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.7",
            "verseOrgIds": [
              "HAB.1.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "HAB 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ịnyịnya ha nwere ụkwụ nkọ karịa agụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "Ha na-akpa ike karịa nkịta ọhịa nke na-ejegharị nʼanyasị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "Ndị ịnyịnya agha ha na-awụ ọsọ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "ndị ha na-agba ịnyịnya na-esitekwa ebe dị anya na-abịa.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:8"
      },
      "items": [
        {
          "text": "Dịka ugo nke na-efedata i buru nri ọ ga-eri.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.8",
            "verseOrgIds": [
              "HAB.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "HAB 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha niile na-abịa ime ihe ike.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:9"
      },
      "items": [
        {
          "text": "Ha ji ọsọ na-abịa dịka oke ifufe nke ọzara.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:9"
      },
      "items": [
        {
          "text": "Ha na-abịa ịchịkọta ndị a dọtara nʼagha dịka ha bụ uzuzu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.9",
            "verseOrgIds": [
              "HAB.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "HAB 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-akwa ndị eze emo,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:10"
      },
      "items": [
        {
          "text": "jirikwa ndịisi ọchịchị na-eme ihe ọchị.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:10"
      },
      "items": [
        {
          "text": "Ha na-achị ebe niile e wusiri ike ọchị,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:10"
      },
      "items": [
        {
          "text": "na-ekpokọtakwa aja nʼazụ mgbidi niile ịlụta ha nʼagha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.10",
            "verseOrgIds": [
              "HAB.1.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "HAB 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, ha na-esi nʼebe ahụ gabiga dịka ifufe, na-agabigakwa",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.11",
            "verseOrgIds": [
              "HAB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:11"
      },
      "items": [
        {
          "text": "ndị mehierenụ, bụrụkwa ndị ikpe mara, ndị ike ha bụ chi ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.11",
            "verseOrgIds": [
              "HAB.1.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mkpesa Habakuk nke ugboro abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "HAB 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.1.12",
                "verseOrgIds": [
                  "HAB.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", Ọ bụ na ị dịghị site mgbe niile ebighị ebi?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:12"
      },
      "items": [
        {
          "text": "Chineke m, na Onye Nsọ m, Ị gaghị anwụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:12"
      },
      "items": [
        {
          "text": "Gị,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "HAB.1.12",
                "verseOrgIds": [
                  "HAB.1.12"
                ]
              }
            }
          ]
        },
        {
          "text": ", họpụtara ha maka ikpe ikpe.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:12"
      },
      "items": [
        {
          "text": "Gị, oke nkume m, emeela ka ha bụrụ ndị ga-enweta ahụhụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.12",
            "verseOrgIds": [
              "HAB.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "HAB 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma anya gị dị ọcha nke ukwuu, na ọ dịghị elekwasị ajọ ihe anya;",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:13"
      },
      "items": [
        {
          "text": "ị naghị anabatakwa mmegbu.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:13"
      },
      "items": [
        {
          "text": "Ma gịnị mere i ji gba ndị aghụghọ nkịtị?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:13"
      },
      "items": [
        {
          "text": "Gịnị mere i ji gba nkịtị mgbe ndị ajọ omume na-eloda",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:13"
      },
      "items": [
        {
          "text": "ndị bụ ndị ezi omume karịa ha?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.13",
            "verseOrgIds": [
              "HAB.1.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "HAB 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "I meela ndị mmadụ ka ha dịrị ka azụ nke osimiri,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.14",
            "verseOrgIds": [
              "HAB.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:14"
      },
      "items": [
        {
          "text": "e, dịka anụ na-akpụ akpụ nke oke osimiri, nke na-enweghị onye na-achị ha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.14",
            "verseOrgIds": [
              "HAB.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "HAB 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Onye iro nke ajọ omume juru obi, na-eji nko ya na-egbu ha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.15",
            "verseOrgIds": [
              "HAB.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:15"
      },
      "items": [
        {
          "text": "Ọ na-ejikwa nko ụgbụ ya na-ejide ha.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.15",
            "verseOrgIds": [
              "HAB.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:15"
      },
      "items": [
        {
          "text": "Ọ na-achịkọta ha nʼụgbụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.15",
            "verseOrgIds": [
              "HAB.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:15"
      },
      "items": [
        {
          "text": "si otu a na-aṅụrị ọṅụ, ma na-etegharịkwa egwu ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.15",
            "verseOrgIds": [
              "HAB.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "HAB 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, ọ na-achụ aja",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.16",
            "verseOrgIds": [
              "HAB.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:16"
      },
      "items": [
        {
          "text": "na-esurekwa ihe nsure ọkụ na-esi isi ụtọ nye ụgbụ ya,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.16",
            "verseOrgIds": [
              "HAB.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "HAB 1:16"
      },
      "items": [
        {
          "text": "nʼihi na ọ bụ ụgbụ ya na-eme ka ọ na-ebi ezi ndụ,",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.16",
            "verseOrgIds": [
              "HAB.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:16"
      },
      "items": [
        {
          "text": "na-erikwa nri kachasị mma",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.16",
            "verseOrgIds": [
              "HAB.1.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "HAB 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-aga nʼihu mgbe niile na-awụpụ ihe o ji ụgbụ ya gbute",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.17",
            "verseOrgIds": [
              "HAB.1.17"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "HAB 1:17"
      },
      "items": [
        {
          "text": "na-ala mba niile nʼiyi, dịka o si masị ya, na-egosighị obi ebere ọbụla?",
          "type": "text",
          "attrs": {
            "verseId": "HAB.1.17",
            "verseOrgIds": [
              "HAB.1.17"
            ]
          }
        }
      ]
    }
  ],
