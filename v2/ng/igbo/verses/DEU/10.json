  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "10",
        "style": "c",
        "sid": "DEU 10"
      },
      "items": [
        {
          "text": "10",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mbadamba nkume abụọ ọzọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 10:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.1",
                "verseOrgIds": [
                  "DEU.10.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m, sị, \"Wapụta mbadamba nkume abụọ dịka nke mbụ, were ha bịakwute m nʼelu ugwu. Ọzọ, wuokwara onwe gị igbe osisi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.1",
            "verseOrgIds": [
              "DEU.10.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 10:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Aga m edekwasị nʼelu mbadamba nkume ndị a, okwu niile nke dị nʼelu mbadamba nkume ndị mbụ, bụ nke ị tụpịasịrị. Ị ga-etinyekwa ha nʼime igbe ahụ.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.2",
            "verseOrgIds": [
              "DEU.10.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 10:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, eji m osisi akashia kwaa igbe ahụ. A wapụtakwara m mbadamba nkume abụọ yiri ndị nke mbụ, were ha rigoro ugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.3",
            "verseOrgIds": [
              "DEU.10.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 10:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.4",
                "verseOrgIds": [
                  "DEU.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "dere nʼelu mbadamba nkume ahụ ihe ndị ahụ o dere na mbụ, bụ iwu iri ndị ahụ o gwara unu nʼelu ugwu site nʼime ọkụ, nʼụbọchị mkpọkọta ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.4",
                "verseOrgIds": [
                  "DEU.10.4"
                ]
              }
            }
          ]
        },
        {
          "text": "nyekwara m ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.4",
            "verseOrgIds": [
              "DEU.10.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 10:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe m si nʼugwu ahụ rịdata, etinyere m mbadamba nkume abụọ ahụ nʼime igbe ahụ m kwara, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.5",
                "verseOrgIds": [
                  "DEU.10.5"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere m nʼiwu. Ha dịkwa nʼebe ahụ ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.5",
            "verseOrgIds": [
              "DEU.10.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 10:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ụmụ Izrel gara ije site nʼolulu mmiri nke Bene Jaakan garuo Mosera, nʼebe ahụ ka Erọn nọ nwụọ, e lie ya nʼebe ahụ. Elieza, bụ ọkpara ya nọchiri ọnọdụ ya dịka onye nchụaja.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.6",
            "verseOrgIds": [
              "DEU.10.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 10:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site nʼebe ahụ, ha gagidere ije ruo Gudgoda, sitekwa na ya ruo Jotbata, ala nke iyi na-asọ asọ juru nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.7",
            "verseOrgIds": [
              "DEU.10.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 10:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "kewapụtara ebo Livayị ibu igbe ọgbụgba ndụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": ", na iguzo nʼihu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.8",
                "verseOrgIds": [
                  "DEU.10.8"
                ]
              }
            }
          ]
        },
        {
          "text": "ijere ya ozi na ikwupụta ngọzị nʼaha ya, dịka ha sị eme ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.8",
            "verseOrgIds": [
              "DEU.10.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 10:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nke a mere ndị Livayị enweghị oke maọbụ ihe nketa nʼetiti ndị Izrel ibe ha;",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.9",
                "verseOrgIds": [
                  "DEU.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ ihe nketa ha, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.9",
                "verseOrgIds": [
                  "DEU.10.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu gwara ha.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.9",
            "verseOrgIds": [
              "DEU.10.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 10:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, anọọla m nʼelu ugwu ahụ iri ụbọchị anọ, ehihie na abalị, dịka m mere nʼoge mbụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.10",
                "verseOrgIds": [
                  "DEU.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "gekwara m ntị nʼoge ugbu a. Ọ bụghị ọchịchọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.10",
                "verseOrgIds": [
                  "DEU.10.10"
                ]
              }
            }
          ]
        },
        {
          "text": "ibibi unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.10",
            "verseOrgIds": [
              "DEU.10.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 10:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.11",
                "verseOrgIds": [
                  "DEU.10.11"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m, \"Bilie, gaa ka i duru ndị a gaa na njem ha, ka ha banye, ma nwetakwa ala ahụ nke m kwere nna nna ha na nkwa inye ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.11",
            "verseOrgIds": [
              "DEU.10.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Sọpụrụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 10:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, Izrel, gịnị ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.12",
                "verseOrgIds": [
                  "DEU.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-ana nʼaka gị ma ọ bụghị ka ị tụọ egwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.12",
                "verseOrgIds": [
                  "DEU.10.12"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị, jee ije na nrube isi nye ya, ịhụ ya nʼanya, na iwere obi gị niile na mmụọ gị niile fee ya ofufe,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.12",
            "verseOrgIds": [
              "DEU.10.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 10:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "na ilezi anya debezuo iwu na ụkpụrụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.13",
            "verseOrgIds": [
              "DEU.10.13"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.13",
                "verseOrgIds": [
                  "DEU.10.13"
                ]
              }
            }
          ]
        },
        {
          "text": ", ndị m na-enye gị taa, nʼihi ọdịmma gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.13",
            "verseOrgIds": [
              "DEU.10.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 10:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụwa na eluigwe na ebe niile kachasị elu nke eluigwe, na ihe niile dị nʼime ha, bụ nke",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
            "verseOrgIds": [
              "DEU.10.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.14",
                "verseOrgIds": [
                  "DEU.10.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.14",
            "verseOrgIds": [
              "DEU.10.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 10:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.15",
            "verseOrgIds": [
              "DEU.10.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.15",
                "verseOrgIds": [
                  "DEU.10.15"
                ]
              }
            }
          ]
        },
        {
          "text": "nwere mmasị nʼahụ nna nna unu ha, hụkwa ha nʼanya, ọ họrọ unu, na naanị ụmụ ha niile, site nʼetiti mba niile dịka ọ dị taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.15",
            "verseOrgIds": [
              "DEU.10.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 10:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, biekwanụ obi unu ugwu, kwụsịkwanụ ibi ndụ nke isiike.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.16",
            "verseOrgIds": [
              "DEU.10.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 10:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.17",
                "verseOrgIds": [
                  "DEU.10.17"
                ]
              }
            }
          ]
        },
        {
          "text": ", bụ Chineke unu bụ Chineke kachasị chi niile, bụrụkwa Onyenwe kachasị ndị nwenụ niile. Chineke ukwu ahụ, onye dị ike dịkwa egwu, onye na-adịghị ele mmadụ anya nʼihu, ọ nakwaghị eri ngarị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.17",
            "verseOrgIds": [
              "DEU.10.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 10:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ na-alụrụ ndị na-enweghị nna, na ụmụ nwanyị na-enweghị di ọgụ. Ọ na-ahụ ndị ọbịa nʼanya, na-enyekwa ha nri na uwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.18",
            "verseOrgIds": [
              "DEU.10.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 10:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, unu onwe unu kwa, hụnụ ndị ọbịa nʼanya, nʼihi na unu onwe unu bụrụrị ndị ọbịa nʼala Ijipt.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.19",
            "verseOrgIds": [
              "DEU.10.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 10:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Tụọ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.20",
                "verseOrgIds": [
                  "DEU.10.20"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị egwu, feekwa ya ofufe. Ya ka ị ga-arapara nʼahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "text": "ọ bụkwa naanị nʼaha ya ka ị ga-aṅụ iyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.20",
            "verseOrgIds": [
              "DEU.10.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 10:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ya bụ onye ị ga-eto otuto, ọ bụ ya bụ Chineke gị, onye rụrụ gị ọrụ ndị ahụ dị oke egwu na ebube, nke gị onwe gị ji anya gị hụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.21",
            "verseOrgIds": [
              "DEU.10.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 10:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nna nna unu ndị gara nʼIjipt dị naanị iri mmadụ asaa, ma ugbu a,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.22",
            "verseOrgIds": [
              "DEU.10.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.10.22",
                "verseOrgIds": [
                  "DEU.10.22"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị emeela ka ịmụbaa dịka kpakpando nke mbara igwe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.10.22",
            "verseOrgIds": [
              "DEU.10.22"
            ]
          }
        }
      ]
    }
  ],
