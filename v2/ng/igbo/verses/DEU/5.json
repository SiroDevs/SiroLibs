          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị akwala iko.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.18",
            "verseOrgIds": [
              "DEU.5.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 5:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị ezula ohi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.19",
            "verseOrgIds": [
              "DEU.5.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 5:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị agbala ama ụgha megide onye agbataobi gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.20",
            "verseOrgIds": [
              "DEU.5.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 5:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị enwela anya ukwu nʼebe nwunye onye agbataobi gị dị. Gị enwekwala agụụ inwetara onwe gị ụlọ onye agbataobi gị, maọbụ nʼebe ala ya, maọbụ ohu ya nwoke, maọbụ ohu ya nwanyị, maọbụ ehi ya, maọbụ ịnyịnya ibu ya, ma ọ bụkwanụ nʼihe ọbụla nke onye agbataobi nwere dị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.21",
            "verseOrgIds": [
              "DEU.5.21"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 5:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iwu ndị a ka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.22",
                "verseOrgIds": [
                  "DEU.5.22"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼolu ike kwupụta nye ọgbakọ unu niile nʼelu ugwu ahụ, site nʼọkụ ahụ na igwe ojii ahụ na oke ọchịchịrị ahụ. O nweghị okwu ọzọ o tụkwasịrị nʼelu ya. O mechara dee ha na mbadamba nkume abụọ, nye m ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.22",
            "verseOrgIds": [
              "DEU.5.22"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 5:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe unu nụrụ oke olu ahụ kwuru okwu site nʼoke ọchịchịrị ahụ, hụkwa ire ọkụ ahụ dị egwu na-enwu nʼelu ugwu, ndịisi unu, ndị ndu ebo ọbụla na ndị okenye unu bịakwutere m.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.23",
            "verseOrgIds": [
              "DEU.5.23"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 5:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu sịrị, \"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.24",
                "verseOrgIds": [
                  "DEU.5.24"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke anyị egosila anyị ebube ya, na ịdị ukwu ya, anyị anụkwala olu ya site nʼime ọkụ ahụ. Taa anyị ahụla na mmadụ pụrụ ịdị ndụ ọbụladị ma Chineke kpanyere ha ụka.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.24",
            "verseOrgIds": [
              "DEU.5.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 5:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ugbu a nʼihi gịnị ka anyị ga-eji nwụọ? Ọkụ a, nke na-enwusi ike ga-erechapụ anyị. Anyị ga-anwụ ma ọ bụrụ na anyị anụ olu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.25",
                "verseOrgIds": [
                  "DEU.5.25"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị gaa nʼihu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.25",
            "verseOrgIds": [
              "DEU.5.25"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 5:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na onye dị nʼetiti mmadụ, nke nụrụ olu Chineke dị ndụ ka ọ na-ekwu okwu site nʼetiti ọkụ, dịka anyị nụrụ ma dịrị ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.26",
            "verseOrgIds": [
              "DEU.5.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 5:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gaa nso nụtara anyị ihe",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.27",
                "verseOrgIds": [
                  "DEU.5.27"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị na-ekwu, mgbe ahụ, gwa anyị ihe ọbụla bụ nke ọ gwara gị, anyị ga-anụ, mekwa ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.27",
            "verseOrgIds": [
              "DEU.5.27"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 5:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.28",
                "verseOrgIds": [
                  "DEU.5.28"
                ]
              }
            }
          ]
        },
        {
          "text": "nụrụ olu okwu mgbe unu gwara m okwu,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.28",
                "verseOrgIds": [
                  "DEU.5.28"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m, \"Anụla m ihe ndị a gwara gị. Ihe niile ha kwuru ziri ezi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.28",
            "verseOrgIds": [
              "DEU.5.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 5:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lee, ọ ga-adị nnọọ mma ma mkpụrụobi ha dị otu a, ịtụ egwu m, na idebe ihe niile m nyere ha nʼiwu, ka ihe gaara ha na ụmụ ha nke ọma mgbe niile ebighị ebi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.29",
            "verseOrgIds": [
              "DEU.5.29"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 5:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gaa, gwa ha ka ha laghachi nʼụlọ ikwu ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.30",
            "verseOrgIds": [
              "DEU.5.30"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 5:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma gị onwe gị, guzo nʼebe a nʼakụkụ m, ka m nye gị iwu m na ụkpụrụ m niile, ị ga-akụziri ha idebe iwu m, ha aghakwaghị idebe ha nʼala ahụ m gaje inye ha ka ha nweta.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.31",
            "verseOrgIds": [
              "DEU.5.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 5:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Lezienụ anya ime ihe ndị ahụ niile",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.32",
                "verseOrgIds": [
                  "DEU.5.32"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke unu nyere unu nʼiwu. Unu esitela na ha wezuga onwe unu gaa nʼaka nri maọbụ nʼaka ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.32",
            "verseOrgIds": [
              "DEU.5.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 5:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jegharịanụ ije nʼụzọ niile",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.33",
                "verseOrgIds": [
                  "DEU.5.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu nyere unu nʼiwu, ka unu dịrị ndụ, baa ụba, ma meekwa ka ndụ unu dị ogologo nʼala ahụ unu na-aga inweta.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.33",
            "verseOrgIds": [
              "DEU.5.33"
            ]
          }
        }
      ]
    }
  ],
