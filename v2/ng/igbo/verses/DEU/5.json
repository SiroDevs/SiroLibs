  "verseCount": 33,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "DEU 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu iri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mosis kpọkọtara Izrel niile gwa ha okwu sị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DEU 5:1"
      },
      "items": [
        {
          "text": "Geenụ ntị, unu Izrel, nʼụkpụrụ ndị a na iwu ndị a niile m na-agụpụta na ntị unu taa, mụtanụ ha, hụkwanụ na unu debere ha!",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.1",
            "verseOrgIds": [
              "DEU.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.2",
                "verseOrgIds": [
                  "DEU.5.2"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị gbara ndụ nʼugwu Horeb.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.2",
            "verseOrgIds": [
              "DEU.5.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.3",
                "verseOrgIds": [
                  "DEU.5.3"
                ]
              }
            }
          ]
        },
        {
          "text": "na nna nna anyị ha gbara ndụ, kama ọ bụ anyị na ya, anyị niile ndị dị ndụ taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.3",
            "verseOrgIds": [
              "DEU.5.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.4",
                "verseOrgIds": [
                  "DEU.5.4"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼetiti ọkụ gwa unu okwu ihu na ihu nʼugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.4",
            "verseOrgIds": [
              "DEU.5.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "E guzoro m nʼetiti unu na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.5",
                "verseOrgIds": [
                  "DEU.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": "mgbe ahụ, ikwupụtara unu okwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.5",
                "verseOrgIds": [
                  "DEU.5.5"
                ]
              }
            }
          ]
        },
        {
          "text": ", nʼihi na unu tụrụ egwu ọkụ ahụ, unu arịgoghịkwa nʼugwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "DEU 5:5"
      },
      "items": [
        {
          "text": "Ọ sịrị:",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.5",
            "verseOrgIds": [
              "DEU.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li4"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Mụ onwe m bụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke unu, onye kpọpụtara unu site nʼIjipt, bụ ala nke ịbụ ohu.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Gị enwela chi ọzọ tinyere m.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.7",
            "verseOrgIds": [
              "DEU.5.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị emerela onwe gị arụsị a pịrị apị, nʼoyiyi nke ụdị ọbụla nke yiri ihe dị nʼeluigwe maọbụ nke yiri ihe dị nʼụwa, nʼokpuru ya maọbụ nʼime mmiri, nʼokpuru ụwa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.8",
            "verseOrgIds": [
              "DEU.5.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị akpọla isiala nye ha, efekwala ha ofufe, nʼihi na Mụ onwe m bụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.9",
                "verseOrgIds": [
                  "DEU.5.9"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị, abụ m Chineke ekworo. Onye na-ata ụmụ na ụmụ ụmụ ahụhụ, nʼihi ajọ omume nke ndị mụrụ ha, ọ bụladị ruo nʼọgbọ nke atọ na nke anọ, nke ndị ahụ kpọrọ m asị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.9",
            "verseOrgIds": [
              "DEU.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma na-egosi ịhụnanya nye puku ọgbọ niile nke ndị hụrụ m nʼanya, bụ ndị na-edebe ihe niile m nyere nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.10",
            "verseOrgIds": [
              "DEU.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gị ejikwala aha",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.11",
                "verseOrgIds": [
                  "DEU.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "bụ Chineke gị eme ihe efu, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.11",
                "verseOrgIds": [
                  "DEU.5.11"
                ]
              }
            }
          ]
        },
        {
          "text": "agaghị agụ onye ji aha ya eme ihe efu dịka onye ikpe na-amaghị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.11",
            "verseOrgIds": [
              "DEU.5.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Debe ụbọchị izuike site nʼido ya nsọ, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.12",
                "verseOrgIds": [
                  "DEU.5.12"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nyere gị nʼiwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.12",
            "verseOrgIds": [
              "DEU.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼime ụbọchị isii ka ị ga-eje ozi gị niile. Ọ bụkwa nʼime ha ka ị ga-arụzu ọrụ gị niile,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.13",
            "verseOrgIds": [
              "DEU.5.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "ma ụbọchị nke asaa bụ ụbọchị izuike nke",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.14",
                "verseOrgIds": [
                  "DEU.5.14"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị. Ị gaghị arụ ọrụ ọbụla nʼụbọchị ahụ, gị onwe gị, nwa gị nwoke na nwa gị nwanyị, onye ọrụ gị nwoke, onye ọrụ gị nwanyị, ehi gị, ịnyịnya ibu gị maọbụ anụ ụlọ gị ọbụla, ọ bụladị onye ọbịa bi nʼobodo gị, ka ohu gị nwoke na ohu gị nwanyị zuru ike dịka gị onwe gị si ezu ike.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.14",
            "verseOrgIds": [
              "DEU.5.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 5:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị ga-echetakwa na ị bụ ohu nʼala Ijipt, ma",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.15",
                "verseOrgIds": [
                  "DEU.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke mere ka i si nʼohu pụta. Ọ bụ ike ya dị ukwuu ka o ji napụta gị. Ọ bụ ya mere",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.15",
                "verseOrgIds": [
                  "DEU.5.15"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị ji nye iwu na ị ga-edebe ụbọchị izuike nsọ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.15",
            "verseOrgIds": [
              "DEU.5.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "li1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 5:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Sọpụrụ nne gị na nna gị, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.16",
                "verseOrgIds": [
                  "DEU.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị nyere gị nʼiwu, ka ụbọchị ndụ gị dị ogologo, ka ihe dịkwara gị mma nʼala ahụ nke",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.5.16",
                "verseOrgIds": [
                  "DEU.5.16"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke gị na-enye gị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.5.16",
            "verseOrgIds": [
              "DEU.5.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
