  "verseCount": 37,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "DEU 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mwagharị nʼọzara",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "DEU 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị laghachiri azụ chee ihu nʼọzara nʼụzọ gawara Osimiri Uhie, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.1",
                "verseOrgIds": [
                  "DEU.2.1"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m. Ọtụtụ afọ ka anyị nọ na-awagharị gburugburu ugwu Sia.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.1",
            "verseOrgIds": [
              "DEU.2.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "DEU 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.2",
                "verseOrgIds": [
                  "DEU.2.2"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.2",
            "verseOrgIds": [
              "DEU.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "DEU 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Unu agbaala ala ugwu ugwu a gburugburu ogologo oge, cheenụ ihu nʼakụkụ ugwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.3",
            "verseOrgIds": [
              "DEU.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "DEU 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye ụmụ Izrel iwu ndị a: 'Unu ga-aga site nʼala ụmụnna unu ndị Edọm gafee. Ndị Edọm bụ ụmụ ụmụ Ịsọ, onye biri na Sia. Ha ga-atụ egwu mgbe ha nụrụ na unu ga-esi nʼala ha gafee, ma kpachapụnụ anya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.4",
            "verseOrgIds": [
              "DEU.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "DEU 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu akpasukwala ha ka ha lụsoo unu ọgụ, nʼihi na agaghị m enye unu ala ọbụla sitere nʼala ha, ọ bụladị ebe ga-ezuru unu ịzọkwasị ụkwụ unu. Enyela m Ịsọ ala niile nke ugwu Sia dịka nke aka ya.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.5",
            "verseOrgIds": [
              "DEU.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "DEU 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Jirinụ ọlaọcha kwụọ ha ụgwọ nri ọbụla unu riri, jirikwanụ ọlaọcha kwụọ ha ụgwọ nʼihi mmiri ọbụla unu ṅụrụ.' \"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.6",
            "verseOrgIds": [
              "DEU.2.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "DEU 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.7",
                "verseOrgIds": [
                  "DEU.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu agọziela unu nʼihe ọbụla bụ akaọrụ unu. O cheela nzọ ụkwụ unu nche iri afọ anọ ndị a niile unu wagharịrị nʼọzara ukwuu a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.7",
                "verseOrgIds": [
                  "DEU.2.7"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu anọnyerela unu, ọ dịkwaghị ihe kọrọ unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.7",
            "verseOrgIds": [
              "DEU.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "DEU 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ya mere, anyị sitere nʼala ụmụnna anyị bụ ụmụ Ịsọ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        },
        {
          "text": "ndị bi na Sia gafee. Anyị hapụkwara ụzọ Araba nke si Elat na Eziọn Geba, tụgharịa gawa elu elu ụzọ ọzara Moab.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.8",
            "verseOrgIds": [
              "DEU.2.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "DEU 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.9",
                "verseOrgIds": [
                  "DEU.2.9"
                ]
              }
            }
          ]
        },
        {
          "text": "dọrọ anyị aka na ntị sị, \"Unu esogbula maọbụ lụso ndị Moab ọgụ nʼihi na unu enweghị oke nʼala ha, nʼihi na enyela m ụmụ ụmụ Lọt ala Ar ka ọ bụrụ ihe nketa nke ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.9",
            "verseOrgIds": [
              "DEU.2.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "DEU 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "(Ndị biri nʼebe ahụ na mgbe gara aga bụ ndị Emim, agbụrụ ha gbara dimkpa dịkwa ọtụtụ nʼọnụọgụgụ. Ha toro ogologo dịka ndị Anak.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.10",
            "verseOrgIds": [
              "DEU.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "DEU 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-eche na ha bụ ndị Refaim, dịka ndị Anak, ma ndị Moab na-akpọ ha ndị Emim.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.11",
            "verseOrgIds": [
              "DEU.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "DEU 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe gara aga ọ bụ ndị Hor bi na Sia, ma ndị Edọm, ụmụ Ịsọ, chụpụrụ ha. Ha bibiri ndị Hor bichikwaa ala ha, dịka ụmụ Izrel si bichie nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.12",
                "verseOrgIds": [
                  "DEU.2.12"
                ]
              }
            }
          ]
        },
        {
          "text": "nyere ha dịka ihe nketa.)",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.12",
            "verseOrgIds": [
              "DEU.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "DEU 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.13",
                "verseOrgIds": [
                  "DEU.2.13"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara anyị okwu sị, \"Ugbu a bilienụ, gafee Ndagwurugwu Zered.\" Anyị bilikwara gafee.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.13",
            "verseOrgIds": [
              "DEU.2.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "DEU 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Iri afọ atọ na asatọ gasịrị, site na mgbe anyị hapụrụ Kadesh Banea ruo mgbe anyị gafere Ndagwurugwu Zered! Nʼoge a, ọgbọ ndị ikom ahụ niile na-alụ agha anwụchaala site nʼọmụma ụlọ ikwu, dịka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.14",
                "verseOrgIds": [
                  "DEU.2.14"
                ]
              }
            }
          ]
        },
        {
          "text": "ṅụrụ ha nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.14",
            "verseOrgIds": [
              "DEU.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "DEU 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "E, aka",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.15",
                "verseOrgIds": [
                  "DEU.2.15"
                ]
              }
            }
          ]
        },
        {
          "text": "dị megide ha, ruo mgbe o mere ka ha niile nwụchaa site nʼọmụma ụlọ ikwu ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.15",
            "verseOrgIds": [
              "DEU.2.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "DEU 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe onye nke ikpeazụ nʼime ndị niile a tozuru ije agha nwụchara,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.16",
            "verseOrgIds": [
              "DEU.2.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "DEU 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.17",
                "verseOrgIds": [
                  "DEU.2.17"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị m,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.17",
            "verseOrgIds": [
              "DEU.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "DEU 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Taa, ụmụ Izrel ga-esi na Ar gafee oke ala ndị Moab.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.18",
            "verseOrgIds": [
              "DEU.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "DEU 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe unu bara nʼala ndị Amọn, unu esogbula ha, unu alụsola ha ọgụ, nʼihi na agaghị m enye unu ala ndị Amọn. Enyela m ụmụ ụmụ Lọt ala ahụ dịka ihe onwunwe ha.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.19",
            "verseOrgIds": [
              "DEU.2.19"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "DEU 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị bi nʼebe a na mbụ bụ ndị Refaim, ma ụmụ Amọn na-akpọ ha ndị Zamzum.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.20",
            "verseOrgIds": [
              "DEU.2.20"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "DEU 2:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụ agbụrụ dị ukwuu nʼọnụọgụgụ, siekwa ike nke ukwuu, ha toro ogologo dịka ụmụ Anak.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.21",
            "verseOrgIds": [
              "DEU.2.21"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.21",
                "verseOrgIds": [
                  "DEU.2.21"
                ]
              }
            }
          ]
        },
        {
          "text": "sitere nʼaka ndị Amọn laa ha nʼiyi, bụ ndị chụpụrụ ha ma bichie nʼobodo ha.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.21",
            "verseOrgIds": [
              "DEU.2.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "DEU 2:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.22",
                "verseOrgIds": [
                  "DEU.2.22"
                ]
              }
            }
          ]
        },
        {
          "text": "mekwara otu ihe ahụ nye ndị agbụrụ Ịsọ bụ ndị bi nʼugwu Sia mgbe ọ lara ndị Hor bụ ụzọ biri nʼebe ahụ nʼiyi. Ha chụpụrụ ha, bichie ala ha ruo taa.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.22",
            "verseOrgIds": [
              "DEU.2.22"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "23",
            "style": "v",
            "sid": "DEU 2:23"
          },
          "items": [
            {
              "text": "23",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ebe ọzọkwa",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.23",
                "verseOrgIds": [
                  "DEU.2.23"
                ]
              }
            }
          ]
        },
        {
          "text": "mere ihe dị otu a bụ mgbe o mere ka ndị Kafto laa ndị Avim nʼiyi. Ha bichiri obodo nta niile ndị Avim nwere nke dị gburugburu ebe ahụ rukwaa Gaza.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.23",
            "verseOrgIds": [
              "DEU.2.23"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmeri Saịhọn eze Heshbọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "24",
            "style": "v",
            "sid": "DEU 2:24"
          },
          "items": [
            {
              "text": "24",
              "type": "text"
            }
          ]
        },
        {
          "text": "Emesịa,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.24",
            "verseOrgIds": [
              "DEU.2.24"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.24",
                "verseOrgIds": [
                  "DEU.2.24"
                ]
              }
            }
          ]
        },
        {
          "text": "sịrị, \"Gafeenụ ndagwurugwu dị warawara nke Anọn, baakwanụ nʼalaeze Saịhọn, onye Amọrị, eze obodo Heshbọn. Lụsonụ ya agha, bichiekwanụ nʼala ya nʼihi na enyefeela m ya bụ eze na ala ya nʼaka unu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.24",
            "verseOrgIds": [
              "DEU.2.24"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "25",
            "style": "v",
            "sid": "DEU 2:25"
          },
          "items": [
            {
              "text": "25",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site taa gaa nʼihu, aga m etinye egwu na ụjọ nʼobi ndị niile bi nʼokpuru mbara eluigwe. Ha ga-anụ akụkọ unu tụọ oke egwu, maakwa jijiji nʼihi unu.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.25",
            "verseOrgIds": [
              "DEU.2.25"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "26",
            "style": "v",
            "sid": "DEU 2:26"
          },
          "items": [
            {
              "text": "26",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esitere m nʼọzara Kedemot zipụ ndị ozi, ka ha jekwuru Saịhọn, eze Heshbọn, zie ya ozi na anyị chọrọ udo, sị,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.26",
            "verseOrgIds": [
              "DEU.2.26"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "27",
            "style": "v",
            "sid": "DEU 2:27"
          },
          "items": [
            {
              "text": "27",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Kwere ka anyị site nʼobodo gị gafee. Ọ bụ naanị nʼokporoụzọ ka anyị ga-anọ. Anyị agaghị atụgharị gaa nʼaka nri maọbụ nʼaka ekpe.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.27",
            "verseOrgIds": [
              "DEU.2.27"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "28",
            "style": "v",
            "sid": "DEU 2:28"
          },
          "items": [
            {
              "text": "28",
              "type": "text"
            }
          ]
        },
        {
          "text": "Renye anyị ihe oriri anyị ga-eri na mmiri anyị ga-aṅụ nʼọnụ ahịa ọlaọcha. Naanị kweere ka anyị gabiga nʼụkwụ ala,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.28",
            "verseOrgIds": [
              "DEU.2.28"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "29",
            "style": "v",
            "sid": "DEU 2:29"
          },
          "items": [
            {
              "text": "29",
              "type": "text"
            }
          ]
        },
        {
          "text": "dịka ụmụ Ịsọ, bụ ndị bi na Sia, nakwa ndị Moab bi nʼobodo Ar meere anyị, ruo mgbe anyị gafere Jọdan banye nʼala ahụ",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.29",
                "verseOrgIds": [
                  "DEU.2.29"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị na-enye anyị.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.29",
            "verseOrgIds": [
              "DEU.2.29"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "30",
            "style": "v",
            "sid": "DEU 2:30"
          },
          "items": [
            {
              "text": "30",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma Saịhọn, eze Heshbọn, ekweghị ka anyị si nʼala ya gafee. Nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.30",
                "verseOrgIds": [
                  "DEU.2.30"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke unu mere ka mmụọ ya sie ike, meekwa ka o mesie obi ya ike, ka o si otu a nyefee ya nʼaka unu dịka ọ mere ugbu a.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.30",
            "verseOrgIds": [
              "DEU.2.30"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "31",
            "style": "v",
            "sid": "DEU 2:31"
          },
          "items": [
            {
              "text": "31",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.31",
            "verseOrgIds": [
              "DEU.2.31"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.31",
                "verseOrgIds": [
                  "DEU.2.31"
                ]
              }
            }
          ]
        },
        {
          "text": "gwara m sị, \"Lee, amalitela m iwere Saịhọn na obodo a nyefee unu nʼaka. Ngwanụ, malitenụ ibuso ya agha! Merienụ ya, nwetakwanụ ala ya.\"",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.31",
            "verseOrgIds": [
              "DEU.2.31"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "32",
            "style": "v",
            "sid": "DEU 2:32"
          },
          "items": [
            {
              "text": "32",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Saịhọn na ndị agha ya niile pụtara izute anyị nʼagha nʼebe a na-akpọ Jehaz,",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.32",
            "verseOrgIds": [
              "DEU.2.32"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "33",
            "style": "v",
            "sid": "DEU 2:33"
          },
          "items": [
            {
              "text": "33",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.33",
                "verseOrgIds": [
                  "DEU.2.33"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị nyefere ya nʼaka anyị. Anyị gburu ya, gbukwaa ụmụ ya ndị ikom niile, na ndị agha ya niile.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.33",
            "verseOrgIds": [
              "DEU.2.33"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "34",
            "style": "v",
            "sid": "DEU 2:34"
          },
          "items": [
            {
              "text": "34",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, anyị meriri obodo ya niile, bibiekwa ha niile kpamkpam, ma ndị ikom, ma ndị inyom, ma ụmụntakịrị. Anyị ahapụghị mmadụ onye ndụ.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.34",
            "verseOrgIds": [
              "DEU.2.34"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "35",
            "style": "v",
            "sid": "DEU 2:35"
          },
          "items": [
            {
              "text": "35",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe ndị anyị bukọọrọ bụ naanị anụ ụlọ, na ngwongwo ndị ọzọ dị iche iche anyị si nʼobodo ndị anyị meriri kwata.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.35",
            "verseOrgIds": [
              "DEU.2.35"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "36",
            "style": "v",
            "sid": "DEU 2:36"
          },
          "items": [
            {
              "text": "36",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị lụgburu ndị niile bi nʼobodo dị site nʼAroea ruo nʼọnụ ndagwurugwu dị warawara nke Anọn, na site nʼetiti ndagwurugwu ahụ ruo Gilead. O nweghị obodo ọbụla rara anyị ahụ imeri, nʼihi na",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.36",
                "verseOrgIds": [
                  "DEU.2.36"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke nyefere ha niile nʼaka anyị.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.36",
            "verseOrgIds": [
              "DEU.2.36"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "37",
            "style": "v",
            "sid": "DEU 2:37"
          },
          "items": [
            {
              "text": "37",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma dịka usoro iwu",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "DEU.2.37",
                "verseOrgIds": [
                  "DEU.2.37"
                ]
              }
            }
          ]
        },
        {
          "text": "Chineke anyị si dị, anyị abanyeghị ala ndị Amọn ọbụla maọbụ ruokwa nʼala dị nʼakụkụ iyi Jabọk nso, maọbụ nʼobodo ndị ahụ niile dị nʼugwu.",
          "type": "text",
          "attrs": {
            "verseId": "DEU.2.37",
            "verseOrgIds": [
              "DEU.2.37"
            ]
          }
        }
      ]
    }
  ],
