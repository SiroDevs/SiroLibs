  "verseCount": 20,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "2",
        "style": "c",
        "sid": "1TH 2"
      },
      "items": [
        {
          "text": "2",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọrụ Pọl rụrụ na Tesalonaịka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "1TH 2:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu onwe unu maara, ụmụnna, na ọbịbịa anyị bịakwutere unu abụghị ihe lara nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.1",
            "verseOrgIds": [
              "1TH.2.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "1TH 2:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị tara ahụhụ na mbụ e mekwara anyị ihe ihere na Filipai dịka unu maara, ma site nʼinyeaka Chineke anyị nwere obi ike ịgwa unu oziọma ya, ọ bụladị mgbe a na-eguzogide anyị nʼebe ọ dị ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.2",
            "verseOrgIds": [
              "1TH.2.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "1TH 2:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na arịrịọ anyị na-arịọ unu esiteghị na njehie pụta maọbụ nʼọchịchọ nke na-adịghị ọcha ma ọ bụkwanụ nʼaghụghọ.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.3",
            "verseOrgIds": [
              "1TH.2.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "1TH 2:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼaka nke ọzọ, anyị na-ekwu okwu dị ka ndị ozi Chineke nwapụtara, ndị o tinyere ọrụ oziọma a nʼaka na ntụkwasị obi idebe. Anyị adịghị agbalị ime ihe ga-atọ mmadụ ụtọ, kama anyị chọrọ ime ihe ga-atọ Chineke ụtọ, bụ onye na-enyocha echiche obi anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.4",
            "verseOrgIds": [
              "1TH.2.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "1TH 2:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mgbe ọbụla, dị ka unu maara, anyị kwuru okwu nrafu maọbụ were ụzọ aghụghọ zoo anya ukwu anyị nwere. Chineke bụ onye akaebe anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.5",
            "verseOrgIds": [
              "1TH.2.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "1TH 2:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ dịghị mgbe anyị chọrọ ka ndị mmadụ ọbụla maọbụ unu, maọbụ ndị ọzọ, too anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.6",
            "verseOrgIds": [
              "1TH.2.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "1TH 2:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ ezie, dị ka ndị ozi Kraịst, anyị gara abụ ibu arụ nye unu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "1TH 2:7"
      },
      "items": [
        {
          "text": "Kama, anyị biri nʼetiti unu site nʼịdị nwayọọ dị ka ndị bụ nne na-azụ ụmụntakịrị ha, na-elekọta ha.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.7",
            "verseOrgIds": [
              "1TH.2.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "1TH 2:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na anyị hụrụ unu nʼanya nke ukwuu ruo na ọ bụghị naanị na anyị kwusaara unu oziọma Chineke kama anyị nyekwara unu ndụ anyị. Nʼihi na unu dị anyị nʼobi nke ukwu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.8",
            "verseOrgIds": [
              "1TH.2.8"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "1TH 2:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie ụmụnna m, amaara m na unu ga-echeta otu anyị si rụọ ọrụ hụjuokwa anya nʼetiti unu. Anyị na-arụ ọrụ ehihie na abalị ịhụ na anyị rụtara ego ga-ezuru anyị, nʼihi na anyị achọghị ịbụ oke ibu nye onye ọbụla mgbe anyị na-ezisara unu oziọma Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.9",
            "verseOrgIds": [
              "1TH.2.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "1TH 2:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu onwe unu bụkwa ndị akaebe dị ka Chineke si bụrụ onye akaebe, na mmekọrịta anyị na unu bụ ndị kwere ekwe, bụ nwekọrịta dị ọcha na nke ezi omume, na nke ịta ụta ọbụla na-adịghị na ya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.10",
            "verseOrgIds": [
              "1TH.2.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "1TH 2:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na anyị mesoro onye ọbụla nʼime unu dị ka nna si emeso ụmụ nke ya,",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.11",
            "verseOrgIds": [
              "1TH.2.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "1TH 2:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "na-agba unu ume, na-akasị unu obi, na-akwagidekwa unu na unu kwesiri ibi ndụ kwesiri ụmụ Chineke, onye kpọbatara unu nʼime alaeze ya na ebube ya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.12",
            "verseOrgIds": [
              "1TH.2.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "1TH 2:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi nke a, anyị ga-aga nʼihu na-ekele Chineke na-esepụghị aka, nʼihi na mgbe unu nabatara okwu Chineke, bụ nke unu nụrụ nʼọnụ anyị, unu anabataghị ya dị ka okwu mmadụ, kama otu ọ dịkwa nʼeziokwu, ya bụ okwu Chineke, nke na-arụsikwa",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        },
        {
          "text": "ọrụ ike nʼime unu bụ ndị kweere ya.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.13",
            "verseOrgIds": [
              "1TH.2.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "1TH 2:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Unu onwe unu, ụmụnna m, ghọọnụ ndị na-eṅomi nzukọ nke Chineke nʼime Kraịst Jisọs, ndị nọ na Judịa. Nʼihi na unu onwe unu hụkwara otu ụdị ahụhụ ahụ nʼaka ndị ala unu, dị ka ha onwe ha hụrụ nʼaka ndị Juu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.14",
            "verseOrgIds": [
              "1TH.2.14"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "1TH 2:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị gburu ndị amụma, gbukwaa Onyenwe anyị Jisọs. Ugbu a ha na-akpagbukwa anyị na-achụpụ anyị. Ha na-emegide Chineke na mmadụ niile",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.15",
            "verseOrgIds": [
              "1TH.2.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "1TH 2:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "site nʼigbochi anyị izisara ndị mba ọzọ oziọma ka a ghara ịzọpụta ha. Ha na-esite nʼụzọ dị otu a na-eme ka iko mmehie ha na-eju. Ma ikpe Chineke adakwasịlarị ha.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.16",
            "verseOrgIds": [
              "1TH.2.16"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nzube Pọl",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "1TH 2:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu ọ dị, ụmụnna anyị, mgbe anyị si nʼetiti unu pụọ, nọọ nwa oge nta, ọnọdụ a mere anyị ndị na-enweghị nne na nna (maọbụ na-anụ ahụ ọ bụghị nʼime mmụọ), nʼihi otu unu si gụọ anyị agụụ, anyị gbalịrị ihu unu.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.17",
            "verseOrgIds": [
              "1TH.2.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "1TH 2:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anyị gbalịsịrị ike ịbịakwute unu, karịsịa, mụ onwe m bụ Pọl gbalịrị, gbalịa ịbịa, ma ekwensu gbochiri anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.18",
            "verseOrgIds": [
              "1TH.2.18"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "1TH 2:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na olee ihe bụ olileanya anyị, maọbụ ọṅụ anyị, maọbụ okpueze anyị, nke anyị ga-eji nyaa isi mgbe a ga-eme ka anyị niile guzo nʼihu Onyenwe anyị Jisọs Kraịst, mgbe ọ ga-abịa? Ọ bụ na ọ bụghị unu onwe unu?",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.19",
            "verseOrgIds": [
              "1TH.2.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "1TH 2:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, unu onwe unu bụ ọṅụ na otuto anyị.",
          "type": "text",
          "attrs": {
            "verseId": "1TH.2.20",
            "verseOrgIds": [
              "1TH.2.20"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "1TH.3",
    "number": "3",
    "bookId": "1TH"
  },
