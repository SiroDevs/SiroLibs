      "attrs": {
        "style": "q1",
        "vid": "HOS 13:14"
      },
      "items": [
        {
          "text": "Gị ọnwụ, olee ebe ajọọ ọrịa gị niile na-efe efe dị?",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.14",
            "verseOrgIds": [
