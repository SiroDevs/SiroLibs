          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m anapụta ha site nʼike nke Ala mmụọ.",
          "type": "text",
          "attrs": {
            "verseId": "HOS.13.14",
            "verseOrgIds": [
              "HOS.13.14"
            ]
