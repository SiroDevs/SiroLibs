  "verseCount": 22,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "1",
        "style": "c",
        "sid": "EST 1"
      },
      "items": [
        {
          "text": "1",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Ọdịda eze nwanyị Vashti",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 1:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nke a bụ ihe mere nʼoge ọchịchị eze Sekses, bụ Sekses nke chiri alaeze",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "text": "nwere mpaghara dị iche iche nke karịrị otu narị na iri abụọ na asaa (127), nke gbasakwara site nʼIndia rụọ Kush.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.1",
            "verseOrgIds": [
              "EST.1.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 1:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼoge ahụ, isi ọchịchị obodo eze Sekses bụ Susa",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "text": "ebe ocheeze ya dịkwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.2",
            "verseOrgIds": [
              "EST.1.2"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 1:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼafọ nke atọ nke ọchịchị ya, o mere mmemme oke oriri nye ndịisi ọrụ ya niile. Ndị ọzọ ọ kpọkwara bụ ndịisi agha nke Peshịa na Midia, na ụmụ eze, na ndị ọchịchị sitere na mba dị iche iche ọ na-achị.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.3",
            "verseOrgIds": [
              "EST.1.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 1:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mmemme a were otu narị na iri ụbọchị asatọ (180). Eze jikwa oge a gosi akụnụba, na ịma mma na ebube nke alaeze ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.4",
            "verseOrgIds": [
              "EST.1.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 1:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ụbọchị ndị a gafesịrị, eze kpọrọ oke oriri nọrọ ụbọchị asaa nʼubi a gbara ogige dị nʼụlọeze, nye ndị niile nọ na Susa, site nʼonye ukwu ruo nʼonye nta.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.5",
            "verseOrgIds": [
              "EST.1.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 1:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ịchọ mma e ji dozie ogige ahụ bụ ezi akwa mgbochi dị ọcha, nke e ji ogho ọcha kpaa na nke e jikwa ogho na-acha anụnụ anụnụ kpaa. E jikwa eriri ogho dị ezi ọcha na nke na-acha odo odo kekọtaa akwa mgbochi ndị ahụ, nʼihe mgbaaka ọlaọcha dị nʼogidi nkume dị oke ọnụahịa e wuru nʼebe ahụ. A dọbakwara oche",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "text": "ọlaọcha na ọlaedo ndị ahụ nʼebe e wulitụrụ elu, nke e ji nkume mabụl na nkume ndị ọzọ dị oke ọnụahịa, ndị na-acha ezi ọcha, ndị na-acha odo odo na nke na-eji oji wuo ala ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.6",
            "verseOrgIds": [
              "EST.1.6"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 1:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "E jikwa iko ọlaedo ṅụọ ihe ọṅụṅụ. Iko ọlaedo ọbụla e wepụtara nʼụbọchị ahụ dị iche nʼiche. O nweghị nke yiri ibe ya. E mekwara ka mmanya eze baa ụba dịka afọ ọma aka eze si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.7",
            "verseOrgIds": [
              "EST.1.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 1:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "E nyeghịkwa iwu ọbụla banyere iko mmanya ole mmadụ kwesiri ịṅụ kama ndị chọrọ ga-aṅụ dịka o si masị ha. Nʼihi na eze agwalarị ndịisi ozi ya na onye ọbụla kwesiri ịṅụ dịka o si chọọ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.8",
            "verseOrgIds": [
              "EST.1.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 1:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu oge ahụ, eze nwanyị Vashti, kpọkwara oke oriri nye ụmụ nwanyị niile nọ nʼụlọeze, Sekses.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.9",
            "verseOrgIds": [
              "EST.1.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 1:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị nke asaa, mgbe obi dị eze Sekses mma nʼihi mmanya ọ ṅụrụ, ọ nyere ndị onozi asaa ndị a na-ejere ya ozi iwu, ha bụ, Mehuman, na Bizta, na Habona, na Bigta, na Abagta, na Zeta, na Kakas,",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.10",
            "verseOrgIds": [
              "EST.1.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 1:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "sị ha gaa kpọọ Vashti nwunye eze ka ọ bịakwute ya. Eze nyekwara iwu ka Vashti kpuru okpueze nʼisi ya, maka igosi ndị mmadụ niile na ndị a na-asọpụrụ nọ nʼebe ahụ ịma mma ya. Nʼihi na Vashti mara mma.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.11",
            "verseOrgIds": [
              "EST.1.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 1:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma mgbe e mere ka ozi eze ruo ya ntị, eze nwanyị, bụ Vashti jụrụ ịbịa. Nke a mere ka iwe wee eze nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.12",
            "verseOrgIds": [
              "EST.1.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 1:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka eze Sekses na-eme, ọ kpọkwara ndị ọkachamara nʼihe gbasara iwu na ikpe ziri ezi. Eze na ndị a mara ihe, bụ ndị maara ihe ụbọchị nyere kparịtara ụka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.13",
            "verseOrgIds": [
              "EST.1.13"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 1:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha bụkwa ndị na-anọkarị eze nso. Aha ha bụ Kashena, na Sheta, na Admata, na Tashish, na Meres, na Masena, na Memukan. A maara aha mmadụ asaa ndị a nʼala Midia na Peshịa. Ha bụ ndị na-aga nʼihu eze mgbe ọbụla ha chọrọ, bụrụkwa ndị dịkarịsịrị elu nʼalaeze ahụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.14",
            "verseOrgIds": [
              "EST.1.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 1:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ sị, \"Dịka iwu si dị, gịnị ka a ga-eme Vashti bụ nwunye eze nʼihi na o nupuru isi nʼiwu eze Sekses nyere nke o zigaara ya site nʼọnụ ndị onozi ya?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.15",
            "verseOrgIds": [
              "EST.1.15"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 1:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Memukan kwuchitere ọnụ ndị ọzọ sị, \"Ihe Vashti nwunye eze mere jọrọ njọ. O mehiela eze, mehiekwa ndị ọchịchị niile, na ndị niile bi nʼakụkụ niile nke alaeze Sekses.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.16",
            "verseOrgIds": [
              "EST.1.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 1:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ndị inyom niile ga-amata ihe eze nwanyị mere, malite ilelị ndị di ha anya, ma na-ekwu sị, 'Eze Sekses nyere Vashti nwunye ya iwu ka ọ bịa nʼihu ya, ma ọ jụrụ ịbịa.'",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.17",
            "verseOrgIds": [
              "EST.1.17"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "18",
            "style": "v",
            "sid": "EST 1:18"
          },
          "items": [
            {
              "text": "18",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼụbọchị taa ka ndị inyom ndịisi nke Peshịa na Midia, bụ ndị nụrụ banyere omume nwunye eze mere, ga-azakwa ndịisi ọchịchị alaeze gị nʼụzọ dị otu a. A ga-enwe nleda anya na esemokwu nʼala a mgbe niile.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.18",
            "verseOrgIds": [
              "EST.1.18"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "19",
            "style": "v",
            "sid": "EST 1:19"
          },
          "items": [
            {
              "text": "19",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Ya mere, ọ bụrụ na ọ masị eze, ya nye iwu, nke a ga-edepụta, ka ọ bụrụ iwu nʼala Peshịa na Midia, nke na-agaghị agbanwe, na Vashti agaghị abatakwa nʼihu eze Sekses ọzọ. Ka eze werekwa ọnọdụ eze nwanyị ahụ nye onye ọzọ ka ya mma.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.19",
            "verseOrgIds": [
              "EST.1.19"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "20",
            "style": "v",
            "sid": "EST 1:20"
          },
          "items": [
            {
              "text": "20",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ ga-erukwa na mgbe a gụpụtara iwu a eze nyere nʼakụkụ alaeze a niile, ndị inyom niile ga-asọpụrụ ndị di ha site nʼonye dịkarịsịrị nta nʼetiti ha ruo nʼonye dị ukwuu.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.20",
            "verseOrgIds": [
              "EST.1.20"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "21",
            "style": "v",
            "sid": "EST 1:21"
          },
          "items": [
            {
              "text": "21",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze na ndịisi ọchịchị ya nabatara ndụmọdụ a, nʼihi ya, eze mere ihe Memukan kwuru.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.21",
            "verseOrgIds": [
              "EST.1.21"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "22",
            "style": "v",
            "sid": "EST 1:22"
          },
          "items": [
            {
              "text": "22",
              "type": "text"
            }
          ]
        },
        {
          "text": "O zipụrụ akwụkwọ ozi a nye akụkụ niile a na-achị achị nke alaeze ahụ. E dekwara akwụkwọ ozi ahụ nʼasụsụ dị iche iche, na-ekwupụta nʼasụsụ ọbụla na nwoke ọbụla kwesiri ịbụ onye na-achị ezinaụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.1.22",
            "verseOrgIds": [
              "EST.1.22"
            ]
          }
        }
      ]
    }
  ],
