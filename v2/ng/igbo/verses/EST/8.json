  "verseCount": 17,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "8",
        "style": "c",
        "sid": "EST 8"
      },
      "items": [
        {
          "text": "8",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwu banyere ndị Juu",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 8:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼotu ụbọchị ahụ, Ahasuerọs bụ eze, nyefere Esta nwunye eze akụnụba niile",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.1",
            "verseOrgIds": [
              "EST.8.1"
            ]
          }
        },
        {
          "text": "Heman onye iro ndị Juu nwere. E mekwara ka Mọdekai bịa nʼihu eze, nʼihi na Esta agwala eze na ọ bụ nwanne nna ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.1",
            "verseOrgIds": [
              "EST.8.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 8:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze wepụtara ọlaaka ikike ya, nke a gbapụtara site nʼaka Heman nye ya Mọdekai. Esta mekwara Mọdekai onye nlekọta akụnụba Heman.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.2",
            "verseOrgIds": [
              "EST.8.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 8:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọzọkwa, Esta bịara nʼihu eze daa nʼala nʼụkwụ eze rịọ ya arịrịọ nʼanya mmiri ka ọ kwụsị echiche ọjọọ ahụ Heman onye Agag, chere megide ndị Juu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.3",
            "verseOrgIds": [
              "EST.8.3"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 8:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze setịpụrụ mkpara ọlaedo ya nye Esta. Esta biliri, guzo nʼihu eze,",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.4",
            "verseOrgIds": [
              "EST.8.4"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 8:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ sịrị, \"Ọ bụrụ na ọ dị eze mma, ọ bụrụkwa na m hụtara amara nʼihu ya, bụrụkwa ihe ziri ezi nʼanya eze, ọ bụrụkwa na ihe m masịrị ya, ka ede iwu nʼakwụkwọ ịkagbu ozi Heman nwa Hamedata, onye Agag, nke o chepụtara dee ime ka a laa ndị Juu nʼiyi nʼala niile eze na-achị.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.5",
            "verseOrgIds": [
              "EST.8.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 8:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na m ga-esi aṅaa nagide ya, ịhụ ka a na-egbu ndị m, na-alakwa ụmụnna m nʼiyi?\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.6",
            "verseOrgIds": [
              "EST.8.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 8:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, eze bụ Ahasuerọs gwara Esta nwunye eze na Mọdekai onye Juu okwu sị ha, \"Enyela m Esta akụnụba Heman, ha akwụgbukwaala Heman nʼosisi, nʼihi na ọ chọrọ ịla ndị Juu nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.7",
            "verseOrgIds": [
              "EST.8.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 8:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ugbu a, deenụ akwụkwọ ozi banyere ndị Juu niile, dee ihe ọbụla dị mma nʼanya unu nʼaha eze. Werekwa ọlaaka ikike eze kaa ya akara, nʼihi na ọ dịghị akwụkwọ ọbụla e dere nʼaha eze, kaakwa ya akara mgbaaka eze nke a pụrụ imegharị.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.8",
            "verseOrgIds": [
              "EST.8.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 8:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Otu mgbe ahụ, akpọrọ ndị ode akwụkwọ eze. Ọ bụ nʼiri abalị na atọ nke ọnwa atọ nʼafọ nke bụ ọnwa Sivan ka ihe ndị a mere. Ha dere iwu niile Mọdekai nyere banyere ndị Juu, ndịisi ọchịchị niile na ndị ọchịchị",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.9",
            "verseOrgIds": [
              "EST.8.9"
            ]
          }
        },
        {
          "text": "niile na-elekọta mpaghara alaeze niile site nʼIndia ruo Kush.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.9",
            "verseOrgIds": [
              "EST.8.9"
            ]
          }
        },
        {
          "text": "Ọnụọgụgụ ha niile dị otu narị na iri abụọ na asaa (127). E depụtasịrị iwu ahụ nʼodide akwụkwọ nke ala ọbụla a na-achị achị si dị, na dịka asụsụ ndị ọbụla si dị, ma nyekwa ndị Juu dịka odide akwụkwọ na asụsụ ha si dị.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.9",
            "verseOrgIds": [
              "EST.8.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 8:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mọdekai dere akwụkwọ ahụ nʼaha eze, bụ Ahasuerọs, werekwa ọlaaka ikike eze kaa ya akara, zipụ akwụkwọ ndị a site nʼaka",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.10",
            "verseOrgIds": [
              "EST.8.10"
            ]
          }
        },
        {
          "text": "ndị ọgba ọsọ ndị ịnyịnya na-ebu, bụ ndị na-agba ịnyịnya ụkwụ ọsọ nke e leziri anya nke ọma zụọ maka ije ozi dịrị eze.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.10",
            "verseOrgIds": [
              "EST.8.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 8:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akwụkwọ nke iwu eze a, nyere ndị Juu niile nọ nʼobodo ọbụla ike izukọta nʼotu maka ịzọ ndụ ha, nyekwa ha ikike ibibi, gbuo ma laa nʼiyi ndị agha nke mba ọbụla, maọbụ ala ndị ahụ a na-achị achị bụ ndị nwere ike ịla ha, ndị inyom ha na ụmụntakịrị ha nʼiyi, na ịpụnara ha akụnụba ha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.11",
            "verseOrgIds": [
              "EST.8.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 8:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụbọchị a akara aka maka ndị Juu ime ihe ndị a nʼobodo niile nʼalaeze eze Ahasuerọs bụ nʼabalị iri na atọ nke ọnwa Ada.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.12",
            "verseOrgIds": [
              "EST.8.12"
            ]
          }
        },
        {
          "text": "",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.12",
            "verseOrgIds": [
              "EST.8.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 8:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "E kwukwara nʼakwụkwọ iwu ahụ na a ghaghị ịnabata iwu eze ahụ nʼobodo ọbụla dị nʼalaeze ya. E kwukwara na a ga-agụpụtara ya mmadụ niile, kọwazie ya ime ka ndị Juu niile nọdụ na njikere imeri ndị iro ha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.13",
            "verseOrgIds": [
              "EST.8.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 8:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị ahụ na-agba ọsọ, bụ ndị na-ebu akwụkwọ ozi, nọkwasịrị nʼelu ịnyịnya eze mee ngwangwa pụọ, ebe iwu eze kwaliri ha. E nyekwara iwu a na Susa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.14",
            "verseOrgIds": [
              "EST.8.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Mmeri ndị Juu meriri",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "15",
            "style": "v",
            "sid": "EST 8:15"
          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe Mọdekai si nʼihu eze pụọ, o yi uwe ndị eze nke na-acha ọcha, na nke na-achakwa anụnụ anụnụ, kpurukwa okpueze ọlaedo dị ukwuu, na uwe mwụda e ji ezi akwa nke na-acha odo odo dụọ nʼahụ ya. Obodo Susa tiri mkpu ṅụrịakwa ọṅụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.15",
            "verseOrgIds": [
              "EST.8.15"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "16",
            "style": "v",
            "sid": "EST 8:16"
          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nye ndị Juu nʼonwe ha, ọ bụ oge ịṅụrị ọnụ, obi ụtọ na nsọpụrụ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.16",
            "verseOrgIds": [
              "EST.8.16"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "17",
            "style": "v",
            "sid": "EST 8:17"
          },
          "items": [
            {
              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Na mpaghara alaeze ahụ niile, na nʼobodo ọbụla nke iwu eze ahụ bịaruru, e nwere ọṅụ na obi ụtọ nʼetiti ndị Juu niile, nweekwa oke oriri na ọṅụṅụ. Ọtụtụ mmadụ nʼime ndị si mba dị iche iche ghọrọ ndị Juu, nʼihi egwu ndị Juu dakwasịrị ha.",
          "type": "text",
          "attrs": {
            "verseId": "EST.8.17",
            "verseOrgIds": [
              "EST.8.17"
            ]
          }
        }
      ]
    }
  ],
  "next": {
    "id": "EST.9",
    "number": "9",
    "bookId": "EST"
  },
