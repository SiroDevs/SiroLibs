  "verseCount": 14,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "5",
        "style": "c",
        "sid": "EST 5"
      },
      "items": [
        {
          "text": "5",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Arịrịọ Esta rịọrọ eze",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "EST 5:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼabalị nke atọ ya, Esta yiri uwe eze nwanyị ya, guzo nʼime ime ogige ụlọeze, nke chere ihu nʼụlọ nzukọ ukwu dị nʼụlọeze, ebe eze nọdụ nʼocheeze ya chee ihu nʼọnụ ụzọ.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.1",
            "verseOrgIds": [
              "EST.5.1"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "EST 5:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ọ hụrụ Esta bụ nwunye eze ka o na-eguzo nʼogige ahụ, ihe ya masịrị ya, ọ nabatakwara ya site na ị setịpụrụ ya mkpara ọlaedo nke dị nʼaka ya. Ya mere, Esta bịaruru nso metụkwa isi mkpara ọlaedo ahụ aka.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.2",
            "verseOrgIds": [
              "EST.5.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "EST 5:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze jụrụ ya sị, \"Gịnị ka ị chọrọ, eze nwanyị Esta? Gịnị bụ mkpa gị? Aga m emere gị ya, ọ bụladị ma ọ bụrụ inye gị otu ọkara alaeze m.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.3",
            "verseOrgIds": [
              "EST.5.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "EST 5:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esta zara sị, \"Ọ bụrụ na ọ masịrị eze, achọrọ m ka gị na Heman bịa rie oriri m kwadooro unu taa.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.4",
            "verseOrgIds": [
              "EST.5.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "EST 5:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Eze tụgharịrị gwa ndị ozi ya sị, \"Gwanụ Heman ka o mee ngwangwa bịa ka anyị gaa mee ihe Esta rịọrọ.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.5",
            "verseOrgIds": [
              "EST.5.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 5:5"
      },
      "items": [
        {
          "text": "Emesịa, eze na Heman bịara nʼoriri Esta.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.5",
            "verseOrgIds": [
              "EST.5.5"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "EST 5:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ha na-aṅụ mmanya, eze sịrị Esta, \"Ugbu a, gwa m ihe ị chọrọ, aga m enye gị ya, ọ bụladị ma ọ bụrụ otu ọkara alaeze m.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.6",
            "verseOrgIds": [
              "EST.5.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "EST 5:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Esta zara sị, \"Arịrịọ m na mkpa m bụ nke a,",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.7",
            "verseOrgIds": [
              "EST.5.7"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "EST 5:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụrụ na m ahụtala amara nʼihu eze nʼezie, ọ bụrụkwa na ọ masịrị eze imere m ihe m na-arịọ, na ime ihe m na-achọ, ka ya na Heman sorokwa bịa echi nʼoriri ọzọ m ga-akwado. Echi ka m ga-akọkwara gị ihe niile.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.8",
            "verseOrgIds": [
              "EST.5.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iwe ọkụ Heman megide Mọdekai",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "EST 5:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heman hapụrụ ebe oriri ahụ nʼoke obi ụtọ. Ma mgbe ọ hụrụ Mọdekai nʼọnụ ụzọ ama eze, hụkwa na o bilighị maọbụ maa jijiji nʼihu ya, iwe were ya nke ukwuu.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.9",
            "verseOrgIds": [
              "EST.5.9"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "EST 5:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼagbanyeghị nke a, Heman jisiri onwe ya ike, laa nʼụlọ ya.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p",
        "vid": "EST 5:10"
      },
      "items": [
        {
          "text": "Ọ kpọkọtara ndị enyi",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        },
        {
          "text": "ya niile na Zeresh, nwunye ya,",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.10",
            "verseOrgIds": [
              "EST.5.10"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "EST 5:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ nyara ha isi nʼihi oke akụnụba ya, na ọtụtụ ụmụ ndị ikom ya, nʼụzọ niile nke eze si nye ya nsọpụrụ ma bulikwaa ya elu karịa ndị ọzọ ọkwa ha dị elu na ndị ọrụ eze niile.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.11",
            "verseOrgIds": [
              "EST.5.11"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "EST 5:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "Heman kwukwara sị, \"Nke a abụghị dị okwu, ọ bụ naanị mụ ka Esta nwunye eze, kpọrọ ka m soro eze bịa nʼoriri nke ọ kwadooro. Echi ka ọ kpọrọ m ka m soro eze bịa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.12",
            "verseOrgIds": [
              "EST.5.12"
            ]
          }
        },
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "EST 5:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma ihe ndị a niile bụ ihe efu mgbe ọbụla m na-ahụ Mọdekai onye Juu ahụ ka ọ na-anọdụ ala nʼọnụ ụzọ ama ụlọeze.\"",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.13",
            "verseOrgIds": [
              "EST.5.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "p"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "14",
            "style": "v",
            "sid": "EST 5:14"
          },
          "items": [
            {
              "text": "14",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mgbe ahụ, Zeresh nwunye ya na ndị enyi ya niile, dụrụ ya ọdụ sị ya, \"Ihe ị ga-eme bụ nke a: Kwadoo osisi e ji akwụgbu mmadụ, nke ịdị elu ya ga-adị iri mita abụọ na atọ. Nʼụtụtụ echi, rịọ eze ka o nye gị ike ịkwụgbu Mọdekai nʼelu ya. Mgbe e mere nke a, ọṅụ gị ga-ezukwa oke, mgbe ị ga-esorokwa eze gaa rie oriri a kpọrọ unu.\" Okwu a masịrị Heman nke ukwuu. O nyere iwu ka a kwadoo osisi ahụ ngwangwa.",
          "type": "text",
          "attrs": {
            "verseId": "EST.5.14",
            "verseOrgIds": [
              "EST.5.14"
            ]
          }
        }
      ]
    }
  ],
