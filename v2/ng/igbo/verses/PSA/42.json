  "verseCount": 11,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "42",
        "style": "c",
        "sid": "PSA 42"
      },
      "items": [
        {
          "text": "42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "ms"
      },
      "items": [
        {
          "text": "Nchịkọta Akwụkwọ nke Abụọ",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "mr"
      },
      "items": [
        {
          "name": "ref",
          "type": "tag",
          "attrs": {
            "id": "PSA.42-PSA.72"
          },
          "items": [
            {
              "text": "Abụ Ọma 42–72",
              "type": "text"
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 42",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma nke dịrị onyeisi abụ. Abụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke ụmụ Kora.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Iru ụjụ na nkasiobi onye ezi omume",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 42:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka agụụ ịṅụ mmiri si na-agụ nne ele,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:1"
      },
      "items": [
        {
          "text": "otu a ka agụụ ihe banyere gị si na-agụ m, O Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.1",
            "verseOrgIds": [
              "PSA.42.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 42:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Akpịrị nke ihe banyere Chineke, bụ Chineke ahụ dị ndụ, na-akpọ m nkụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:2"
      },
      "items": [
        {
          "text": "Olee mgbe m pụrụ ịga zute Chineke?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.2",
            "verseOrgIds": [
              "PSA.42.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 42:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Anya mmiri m aghọọlara m ihe oriri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "nʼehihie ma nʼabalị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "mgbe ndị mmadụ na-asị m ogologo ụbọchị niile,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:3"
      },
      "items": [
        {
          "text": "\"Olee ebe Chineke gị nọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.3",
            "verseOrgIds": [
              "PSA.42.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 42:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe ndị a ka m na-echeta",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "mgbe m na-ekwupụta ihe mgbu nke obi m:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "ma m cheta mgbe mụ na igwe mmadụ so aga,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "mgbe m ji iti mkpu ọṅụ na ekele na-edu ha",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "nʼetiti ọha kachasị ibe ya, ndị ọṅụ juru obi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:4"
      },
      "items": [
        {
          "text": "na-aga nʼụlọ Chineke.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.4",
            "verseOrgIds": [
              "PSA.42.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 42:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "O mkpụrụobi m, gịnị mere i ji daa mba?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Gịnị mere i ji na-asụ ude nʼime m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Nwee olileanya na Chineke,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "nʼihi na m ka ga-eto ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:5"
      },
      "items": [
        {
          "text": "Onye nzọpụta m na Chineke m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.5",
            "verseOrgIds": [
              "PSA.42.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 42:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Mkpụrụobi m na-ada mba nʼime m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "ya mere, aga m echeta gị",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "site nʼala Jọdan,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:6"
      },
      "items": [
        {
          "text": "na ebe dị elu nke Hemon,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        },
        {
          "text": "na sitekwa nʼugwu Miza.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.6",
            "verseOrgIds": [
              "PSA.42.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 42:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ogbu mmiri na-akpọku ogbu mmiri",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "mgbe olu ha na-ada ụda nʼetiti nruda mmiri gị niile;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "ebili mmiri gị niile na mmali mmiri gị niile",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:7"
      },
      "items": [
        {
          "text": "ekpuchiela isi m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.7",
            "verseOrgIds": [
              "PSA.42.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 42:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼehihie,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.42.8",
                "verseOrgIds": [
                  "PSA.42.9"
                ]
              }
            }
          ]
        },
        {
          "text": "na-awụkwasị m ịhụnanya ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "nʼabalị abụ ya dị m nʼobi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:8"
      },
      "items": [
        {
          "text": "ekpere nye Chineke nke ndụ m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.8",
            "verseOrgIds": [
              "PSA.42.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 42:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ana m asị Chineke, oke nkume m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "\"Gịnị mere i ji chefuo m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "Gịnị mere m ga-eji na-ejegharị nʼiru ụjụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:9"
      },
      "items": [
        {
          "text": "nʼihi mmegbu nke onye iro?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.9",
            "verseOrgIds": [
              "PSA.42.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 42:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọkpụkpụ m na-agabiga oke ihe mgbu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.42.10",
            "verseOrgIds": [
              "PSA.42.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 42:10"
      },
