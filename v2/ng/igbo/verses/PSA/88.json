          },
          "items": [
            {
              "text": "16",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke iwe gị agabigala nʼahụ m;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.16",
            "verseOrgIds": [
              "PSA.88.17"
