              "text": "17",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha na-agba m gburugburu ụbọchị niile dịka idee mmiri;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.17",
            "verseOrgIds": [
              "PSA.88.18"
