  "verseCount": 18,
  "content": [
    {
      "name": "chapter",
      "type": "tag",
      "attrs": {
        "number": "88",
        "style": "c",
        "sid": "PSA 88"
      },
      "items": [
        {
          "text": "88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 88",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ, bụ Abụ Ọma ụmụ Kora, nke dịrị onyeisi Abụ. Nʼusoro olu abụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Mahalat leannot.",
              "type": "text"
            }
          ]
        },
        {
          "text": "Abụ",
          "type": "text"
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "tl"
          },
          "items": [
            {
              "text": "Maskil",
              "type": "text"
            }
          ]
        },
        {
          "text": "nke Heman onye Ezra.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Akwa maka enyemaka",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 88:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.1",
                "verseOrgIds": [
                  "PSA.88.2"
                ]
              }
            }
          ]
        },
        {
          "text": ", Chineke onye na-azọpụta m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:1"
      },
      "items": [
        {
          "text": "nʼehihie na abalị ka m na-eti mkpu akwa nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.1",
            "verseOrgIds": [
              "PSA.88.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 88:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ka ekpere m bịa nʼihu gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:2"
      },
      "items": [
        {
          "text": "Chee ntị gị nụrụ akwa m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.2",
            "verseOrgIds": [
              "PSA.88.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 88:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼihi na ọtụtụ nsogbu ejupụtala mkpụrụobi m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:3"
      },
      "items": [
        {
          "text": "anọ m nso nʼọnụ ụzọ ọnwụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.3",
            "verseOrgIds": [
              "PSA.88.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 88:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Agụnyela m nʼetiti ndị na-arịda nʼolulu.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:4"
      },
      "items": [
        {
          "text": "Adị m dịka onye na-enweghị ike.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.4",
            "verseOrgIds": [
              "PSA.88.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 88:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "A họpụtara mụ na ndị nwụrụ anwụ iche,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "dịka ndị e gburu egbu na-edina nʼili,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "ndị ị nakwaghị echeta ọzọ,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:5"
      },
      "items": [
        {
          "text": "ndị e kewapụrụ site na nlekọta gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.5",
            "verseOrgIds": [
              "PSA.88.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 88:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị tụbanyela m nʼime olulu dịkarịrị omimi,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:6"
      },
      "items": [
        {
          "text": "olulu nke ọchịchịrị jupụtara nʼime ya.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.6",
            "verseOrgIds": [
              "PSA.88.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 88:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Oke iwe gị na-anyịgide m nke ukwuu;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:7"
      },
      "items": [
        {
          "text": "i jirila ebili mmiri gị niile kpuchigide m.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.7",
            "verseOrgIds": [
              "PSA.88.8"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.7",
                "verseOrgIds": [
                  "PSA.88.8"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 88:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ị napụla m ndị enyi m, ndị m hụrụ nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:8"
      },
      "items": [
        {
          "text": "mee ka m bụrụ ihe a na-asọ oyi nʼebe ha nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:8"
      },
      "items": [
        {
          "text": "Abụ m onye emechibidoro ụzọ; nke nʼenweghị ike ịpụ ezi;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.8",
            "verseOrgIds": [
              "PSA.88.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "9",
            "style": "v",
            "sid": "PSA 88:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "anya m adịghị ahụkwa ụzọ nʼihi iru ụjụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b",
        "vid": "PSA 88:9"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 88:9"
      },
      "items": [
        {
          "text": "O",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.9",
                "verseOrgIds": [
                  "PSA.88.10"
                ]
              }
            }
          ]
        },
        {
          "text": ", ụbọchị niile ka m na-akpọku gị;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:9"
      },
      "items": [
        {
          "text": "ana m agbasa aka m abụọ nʼihu gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.9",
            "verseOrgIds": [
              "PSA.88.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "10",
            "style": "v",
            "sid": "PSA 88:10"
          },
          "items": [
            {
              "text": "10",
              "type": "text"
            }
          ]
        },
        {
          "text": "ọ bụ ndị nwụrụ anwụ ka ị na-egosi ọrụ ebube gị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:10"
      },
      "items": [
        {
          "text": "Ndị nwụrụ anwụ, ha na-ebili too gị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.10",
            "verseOrgIds": [
              "PSA.88.11"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.10",
                "verseOrgIds": [
                  "PSA.88.11"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "11",
            "style": "v",
            "sid": "PSA 88:11"
          },
          "items": [
            {
              "text": "11",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụ nʼime ili ka a na-ekwupụta ịhụnanya gị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:11"
      },
      "items": [
        {
          "text": "A na-ekwupụta ikwesi ntụkwasị obi gị nʼebe ịla nʼiyi?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.11",
            "verseOrgIds": [
              "PSA.88.12"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "12",
            "style": "v",
            "sid": "PSA 88:12"
          },
          "items": [
            {
              "text": "12",
              "type": "text"
            }
          ]
        },
        {
          "text": "A na-amata banyere ọrụ ebube gị nʼebe ọchịchịrị dị?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:12"
      },
      "items": [
        {
          "text": "Ma ọ bụ ọrụ ezi omume gị, na ịdị mma gị niile nʼala ndị e chezọrọ echezọ?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.12",
            "verseOrgIds": [
              "PSA.88.13"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "13",
            "style": "v",
            "sid": "PSA 88:13"
          },
          "items": [
            {
              "text": "13",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ma",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.13",
                "verseOrgIds": [
                  "PSA.88.14"
                ]
              }
            }
          ]
        },
        {
          "text": "m, ọ bụ gị ka m na-akpọku.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 88:13"
      },
      "items": [
        {
          "text": "Ụtụtụ niile ka ekpere m ga na-abịa nʼebe ị nọ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.13",
            "verseOrgIds": [
              "PSA.88.14"
