        "style": "q2",
        "vid": "PSA 88:16"
      },
      "items": [
        {
          "text": "ihe egwu gị alaala m nʼiyi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.16",
            "verseOrgIds": [
              "PSA.88.17"
