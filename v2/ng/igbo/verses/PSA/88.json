      "attrs": {
        "style": "q2",
        "vid": "PSA 88:15"
      },
      "items": [
        {
          "text": "ataala m ahụhụ oke ụjọ gị, anọ m nʼọnọdụ ịda mba.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
