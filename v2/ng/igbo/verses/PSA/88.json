          },
          "items": [
            {
              "text": "15",
              "type": "text"
            }
          ]
        },
        {
          "text": "Site na mgbe okorobịa m, abụ m onye a na-esogbu, onye nọkwa ọnwụ nso;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.15",
            "verseOrgIds": [
              "PSA.88.16"
            ]
          }
        }
