        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.88.14",
                "verseOrgIds": [
                  "PSA.88.15"
                ]
              }
            }
          ]
        },
        {
          "text": ", gịnị mere i jiri jụ m?",
          "type": "text",
          "attrs": {
            "verseId": "PSA.88.14",
            "verseOrgIds": [
              "PSA.88.15"
            ]
          }
        }
