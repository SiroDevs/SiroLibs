      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Nyenụ Chineke otuto",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 115:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ọ bụghị anyị ka ọ dịrị, o",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.1",
                "verseOrgIds": [
                  "PSA.115.1"
                ]
              }
            }
          ]
        },
        {
          "text": ", ọ bụghị anyị ka ọ dịrị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "kama ọ bụ aha gị ka ebube na-adịrị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:1"
      },
      "items": [
        {
          "text": "nʼihi ịhụnanya gị na ikwesi ntụkwasị obi gị.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.1",
            "verseOrgIds": [
              "PSA.115.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 115:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "text": "Gịnị mere ọtụtụ mba niile nke ụwa ji na-ajụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:2"
      },
      "items": [
        {
          "text": "\"Olee ebe Chineke ha nọ?\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.2",
            "verseOrgIds": [
              "PSA.115.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 115:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke anyị bi nʼeluigwe.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:3"
      },
      "items": [
        {
          "text": "Ọ bụkwa ihe tọrọ ya ụtọ nʼobi ka ọ na-eme.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.3",
            "verseOrgIds": [
              "PSA.115.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 115:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "Arụsị ha niile bụ ọlaọcha na ọlaedo ka e ji kpụọ ha,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.4",
            "verseOrgIds": [
              "PSA.115.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:4"
      },
      "items": [
        {
          "text": "ha bụ ọrụ aka mmadụ.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.4",
            "verseOrgIds": [
              "PSA.115.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 115:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ha nwere ọnụ ma ha adịghị ekwu okwu,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:5"
      },
      "items": [
        {
          "text": "ha nwere anya abụọ ma ha adịghị ahụ ụzọ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.5",
            "verseOrgIds": [
              "PSA.115.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 115:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha nwere ntị ma ha adịghị anụ ihe,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.6",
            "verseOrgIds": [
              "PSA.115.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:6"
      },
      "items": [
        {
          "text": "ha nwekwara imi ma ha adịghị anụ isisi ọbụla;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.6",
            "verseOrgIds": [
              "PSA.115.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 115:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "ha nwere aka, ma ha adịghị emetụ ihe ọbụla aka,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:7"
      },
      "items": [
        {
          "text": "ha nwere ụkwụ, ma ha adịghị eje ije;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:7"
      },
      "items": [
        {
          "text": "ha enweghị ike iji akpịrị ha mee mkpọtụ ọbụla.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.7",
            "verseOrgIds": [
              "PSA.115.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "8",
            "style": "v",
            "sid": "PSA 115:8"
          },
          "items": [
            {
              "text": "8",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ndị na-eme ha ga-adịkwa ka ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.8",
            "verseOrgIds": [
              "PSA.115.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:8"
      },
      "items": [
        {
          "text": "Ndị na-atụkwasị ha obi ga-adịkwa ka ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.8",
            "verseOrgIds": [
              "PSA.115.8"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
