      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:12"
      },
      "items": [
        {
          "text": "ọ ga-agọzi ndị ya bụ Izrel,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
