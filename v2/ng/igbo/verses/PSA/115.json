                "verseOrgIds": [
                  "PSA.115.12"
                ]
              }
            }
          ]
        },
        {
          "text": "na-echeta anyị, ọ ga-agọzikwa anyị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.12",
            "verseOrgIds": [
              "PSA.115.12"
            ]
          }
        }
      ]
    },
