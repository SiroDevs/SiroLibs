            "number": "9",
            "style": "v",
            "sid": "PSA 115:9"
          },
          "items": [
            {
              "text": "9",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ụmụ Izrel, tụkwasịnụ",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.9",
            "verseOrgIds": [
              "PSA.115.9"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.9",
                "verseOrgIds": [
                  "PSA.115.9"
                ]
              }
            }
          ]
        },
        {
          "text": "obi",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.9",
            "verseOrgIds": [
              "PSA.115.9"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:9"
      },
      "items": [
        {
          "text": "ọ bụ onye inyeaka ha na ọta ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.9",
            "verseOrgIds": [
              "PSA.115.9"
            ]
          }
