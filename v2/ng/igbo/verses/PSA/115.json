            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.115.10",
                "verseOrgIds": [
                  "PSA.115.10"
                ]
              }
            }
          ]
        },
        {
          "text": "obi.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.10",
            "verseOrgIds": [
              "PSA.115.10"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 115:10"
      },
      "items": [
        {
          "text": "Ọ bụ ya bụ onye inyeaka ha na ọta ha.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.115.10",
            "verseOrgIds": [
              "PSA.115.10"
            ]
          }
        }
      ]
    },
    {
