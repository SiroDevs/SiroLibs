    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "cl"
      },
      "items": [
        {
          "text": "Abụ Ọma 87",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "d"
      },
      "items": [
        {
          "text": "Abụ Ọma ụmụ Kora. Otu Abụ.",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "s1"
      },
      "items": [
        {
          "text": "Abụ maka Zayọn",
          "type": "text"
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "1",
            "style": "v",
            "sid": "PSA 87:1"
          },
          "items": [
            {
              "text": "1",
              "type": "text"
            }
          ]
        },
        {
          "text": "Chineke atọọla ntọala ya nʼelu ugwu nsọ ahụ;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.1",
            "verseOrgIds": [
              "PSA.87.1"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "2",
            "style": "v",
            "sid": "PSA 87:2"
          },
          "items": [
            {
              "text": "2",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.2",
                "verseOrgIds": [
                  "PSA.87.2"
                ]
              }
            }
          ]
        },
        {
          "text": "hụrụ ọnụ ụzọ ama Zayọn nʼanya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:2"
      },
      "items": [
        {
          "text": "karịa ebe obibi niile nke Jekọb.",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.2",
            "verseOrgIds": [
              "PSA.87.2"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "3",
            "style": "v",
            "sid": "PSA 87:3"
          },
          "items": [
            {
              "text": "3",
              "type": "text"
            }
          ]
        },
        {
          "text": "Ihe dị iche iche nke dị ebube ka a na-ekwu banyere gị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:3"
      },
      "items": [
        {
          "text": "O obodo Chineke;",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.3",
            "verseOrgIds": [
              "PSA.87.3"
            ]
          }
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "qs"
          },
          "items": [
            {
              "text": "Sela",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.3",
                "verseOrgIds": [
                  "PSA.87.3"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "4",
            "style": "v",
            "sid": "PSA 87:4"
          },
          "items": [
            {
              "text": "4",
              "type": "text"
            }
          ]
        },
        {
          "text": "\"Aga m agụnye Rehab na Babilọn,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "dịka ndị na-asọpụrụ m,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "aga m agụnyekwa ndị Filistia, na ndị Taịa, na ndị Kush,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:4"
      },
      "items": [
        {
          "text": "aga m asị, 'A mụrụ nke a na Zayọn.' \"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.4",
            "verseOrgIds": [
              "PSA.87.4"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "5",
            "style": "v",
            "sid": "PSA 87:5"
          },
          "items": [
            {
              "text": "5",
              "type": "text"
            }
          ]
        },
        {
          "text": "Nʼezie, a ga-ekwu okwu banyere Zayọn sị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "\"A mụrụ nke a na nke ọzọ nʼime ya,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:5"
      },
      "items": [
        {
          "text": "ya onwe ya, bụ Onye kachasị ihe niile elu, ga-eme ka o guzosie ike.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.5",
            "verseOrgIds": [
              "PSA.87.5"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "6",
            "style": "v",
            "sid": "PSA 87:6"
          },
          "items": [
            {
              "text": "6",
              "type": "text"
            }
          ]
        },
        {
          "name": "char",
          "type": "tag",
          "attrs": {
            "style": "nd"
          },
          "items": [
            {
              "text": "Onyenwe anyị",
              "type": "text",
              "attrs": {
                "verseId": "PSA.87.6",
                "verseOrgIds": [
                  "PSA.87.6"
                ]
              }
            }
          ]
        },
        {
          "text": "ga-ede nʼime akwụkwọ usoro nke ndị mmadụ:",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:6"
      },
      "items": [
        {
          "text": "\"A mụrụ onye a na Zayọn.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.6",
            "verseOrgIds": [
              "PSA.87.6"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "b"
      },
      "items": []
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q1"
      },
      "items": [
        {
          "name": "verse",
          "type": "tag",
          "attrs": {
            "number": "7",
            "style": "v",
            "sid": "PSA 87:7"
          },
          "items": [
            {
              "text": "7",
              "type": "text"
            }
          ]
        },
        {
          "text": "Dịka ha na-eti egwu, ha ga-abụ abụ sị,",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    },
    {
      "name": "para",
      "type": "tag",
      "attrs": {
        "style": "q2",
        "vid": "PSA 87:7"
      },
      "items": [
        {
          "text": "\"Isi iyi m niile dị na gị.\"",
          "type": "text",
          "attrs": {
            "verseId": "PSA.87.7",
            "verseOrgIds": [
              "PSA.87.7"
            ]
          }
        }
      ]
    }
  ],
